[157.895257, "i", "set -e\nprintf 'PWD=%s\\n' \"$PWD\"\nprintf '\\n== /app ==\\n'; ls -la /app 2>&1 || true\nprintf '\\n== eval ==\\n'; sed -n '1,220p' /app/eval.py 2>&1 || true\nprintf '\\n== mailman cfg ==\\n'; sed -n '1,220p' /etc/mailman3/mailman.cfg 2>&1 || true\nprintf '\\n== postfix main ==\\n'; postconf -n 2>&1 || true\nprintf '\\n== mailman dirs ==\\n'; ls -la /etc/mailman3 /var/lib/mailman3 2>&1 || true\nprintf '\\n== mailman command ==\\n'; command -v mailman || true; mailman info 2>&1 || true\ntrue; tmux wait -S done\r"]
[157.895956, "o", "set -e\r\n\u001b[?2004l\r"]
