[184.926177, "i", "set -e\nprintf 'PWD: '; pwd\nprintf '\\n/app:\\n'; ls -la /app || true\nprintf '\\n/etc/mailman3:\\n'; ls -la /etc/mailman3 || true\nprintf '\\n/etc/postfix:\\n'; ls -la /etc/postfix || true\nprintf '\\nmailman/postfix binaries:\\n'; command -v mailman || true; command -v postconf || true; command -v postmap || true; command -v newaliases || true\nprintf '\\nkey files preview:\\n'; for f in /app/eval.py /etc/mailman3/mailman.cfg /etc/postfix/main.cf /etc/postfix/master.cf /etc/postfix/transport /etc/aliases; do echo \"--- $f\"; if [ -f \"$f\" ]; then sed -n '1,220p' \"$f\"; else echo MISSING; fi; done\ntrue; tmux wait -S done\r"]
