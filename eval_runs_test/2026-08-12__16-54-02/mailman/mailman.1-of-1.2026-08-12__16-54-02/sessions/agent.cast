[184.93444, "o", "drwxr-xr-x 5 root root  4096 Aug 12 07:35 \u001b[0m\u001b[01;34m.\u001b[0m\r\ndrwxr-xr-x 1 root root  4096 Aug 12 08:54 \u001b[01;34m..\u001b[0m\r\n-rw-r--r-- 1 root root    60 Aug 12 07:35 dynamicmaps.cf\r\ndrwxr-xr-x 2 root root  4096 May  5 15:47 \u001b[01;34mdynamicmaps.cf.d\u001b[0m\r\n-rw-r--r-- 1 root root  1330 Aug 12 07:35 main.cf\r\n-rw-r--r-- 1 root root 27460 Aug 12 07:35 main.cf.proto\r\nlrwxrwxrwx 1 root root    31 Aug 12 07:35 \u001b[01;36mmakedefs.out\u001b[0m -> /usr/share/postfix/makedefs.out\r\n-rw-r--r-- 1 root root  7048 Aug 12 07:35 master.cf\r\n-rw-r--r-- 1 root root  7048 Aug 12 07:35 master.cf.proto\r\n-rwxr-xr-x 1 root root 29873 May  5 15:47 \u001b[01;32mpost-install\u001b[0m\r\n-rw-r--r-- 1 root root 10283 May  5 15:47 postfix-files\r\ndrwxr-xr-x 2 root root  4096 May  5 15:47 \u001b[01;34mpostfix-files.d\u001b[0m\r\n-rwxr-xr-x 1 root root 11033 May  5 15:47 \u001b[01;32mpostfix-script\u001b[0m\r\ndrwxr-xr-x 2 root root  4096 May  5 15:47 \u001b[01;34msasl\u001b[0m\r\n"]
