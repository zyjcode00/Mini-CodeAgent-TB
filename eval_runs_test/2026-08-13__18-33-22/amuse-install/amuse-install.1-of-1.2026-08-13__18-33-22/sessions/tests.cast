[31.61776, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_virtual_environment_created\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Test that the virtual environment was created in the correct location.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        venv_path = Path(\u001b[33m\"\u001b[39;49;00m\u001b[33m/app/amuse/.venv\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n        venv_python = Path(\u001b[33m\"\u001b[39;49;00m\u001b[33m/app/amuse/.venv/bin/python\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n>       \u001b[94massert\u001b[39;49;00m venv_path.exists(), (\u001b[90m\u001b[39;49;00m\r\n            \u001b[33m\"\u001b[39;49;00m\u001b[33mVirtual environment directory not found at /app/amuse/.venv\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n"]
[31.617961, "o", "        )\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE       AssertionError: Virtual environment directory not found at /app/amuse/.venv\u001b[0m\r\n\u001b[1m\u001b[31mE       assert False\u001b[0m\r\n\u001b[1m\u001b[31mE        +  where False = exists()\u001b[0m\r\n\u001b[1m\u001b[31mE        +    where exists = PosixPath('/app/amuse/.venv').exists\u001b[0m\r\n"]
[31.618082, "o", "\r\n\u001b[1m\u001b[31m/tests/test_outputs.py\u001b[0m:19: AssertionError\r\n"]
