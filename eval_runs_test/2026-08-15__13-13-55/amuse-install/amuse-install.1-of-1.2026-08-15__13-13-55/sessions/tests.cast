[30.624604, "o", "\u001b[31m\u001b[1m_______________________________________________________________ test_virtual_environment_created _______________________________________________________________\u001b[0m\r\n\r\n"]
[30.647283, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_virtual_environment_created\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Test that the virtual environment was created in the correct location.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        venv_path = Path(\u001b[33m\"\u001b[39;49;00m\u001b[33m/app/amuse/.venv\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n        venv_python = Path(\u001b[33m\"\u001b[39;49;00m\u001b[33m/app/amuse/.venv/bin/python\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n>       \u001b[94massert\u001b[39;49;00m venv_path.exists(), (\u001b[90m\u001b[39;49;00m\r\n            \u001b[33m\"\u001b[39;49;00m\u001b[33mVirtual environment directory not found at /app/amuse/.venv\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        )\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE       AssertionError: Virtual environment directory not found at /app/amuse/.venv\u001b[0m\r\n"]
[30.647498, "o", "\u001b[1m\u001b[31mE       assert False\u001b[0m\r\n\u001b[1m\u001b[31mE        +  where False = exists()\u001b[0m\r\n\u001b[1m\u001b[31mE        +    where exists = PosixPath('/app/amuse/.venv').exists\u001b[0m\r\n\r\n\u001b[1m\u001b[31m/tests/test_outputs.py\u001b[0m:19: AssertionError\r\n"]
[30.647665, "o", "\u001b[31m\u001b[1m__________________________________________________________________ test_test_script_executes ___________________________________________________________________\u001b[0m\r\n\r\n"]
[30.649001, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_test_script_executes\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"test_script.py script executes successfully and produces expected output.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n"]
[30.649119, "o", "        script_path = Path(\u001b[33m\"\u001b[39;49;00m\u001b[33m/app/test_script.py\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Ensure the script exists first\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m script_path.exists(), \u001b[33m\"\u001b[39;49;00m\u001b[33mtest_script.py script not found\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n            \u001b[90m# Run the test_script.py script by sourcing the venv and then running python\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            command = \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33msource /app/amuse/.venv/bin/activate && python \u001b[39;49;00m\u001b[33m{\u001b[39;49;00m\u001b[96mstr\u001b[39;49;00m(script_path)\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            result = subprocess.run(\u001b[90m\u001b[39;49;00m\r\n                command,\u001b[90m\u001b[39;49;00m\r\n                cwd=\u001b[33m\"\u001b[39;49;00m\u001b[33m/app\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m"]
