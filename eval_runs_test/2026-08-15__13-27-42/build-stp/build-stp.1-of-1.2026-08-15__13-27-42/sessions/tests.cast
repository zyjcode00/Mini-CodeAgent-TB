[20.691865, "o", "    \u001b[33m    Test STP with an unsatisfiable query - contradictory constraints.\u001b[39;49;00m\r\n    \u001b[33m    Should return \"unsat\".\u001b[39;49;00m\r\n    \u001b[33m    \"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        stp_query = \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m(set-logic QF_BV)\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m(set-info :smt-lib-version 2.0)\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m(declare-fun x () (_ BitVec 32))\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m(assert (= x #x00000005))\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m(assert (= x #x00000007))\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m(check-sat)\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m(exit)\u001b[39;49;00m\u001b[33m\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n>       result = subprocess.run(\u001b[90m\u001b[39;49;00m\r\n            [\u001b[33m\"\u001b[39;49;00m\u001b[33mstp\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m],\u001b[90m\u001b[39;49;00m\r\n            \u001b[96minput\u001b[39;49;00m=stp_query,\u001b[90m\u001b[39;49;00m\r\n            text=\u001b[94mTrue\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            capture_output=\u001b[94mTrue\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            timeout=\u001b[94m30\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            env=os.environ,\u001b[90m\u001b[39;49;00m\r\n        )\u001b[90m\u001b[39;49;00m\r\n\r\n"]
