[17.205573, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_stp_sat_query\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"\u001b[39;49;00m\r\n    \u001b[33m    Test STP with a satisfiable bitvector query, make sure it returns 0\u001b[39;49;00m\r\n    \u001b[33m    and \"sat\" in the output.\u001b[39;49;00m\r\n    \u001b[33m    \"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        stp_query = \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m(set-logic QF_BV)\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n"]
