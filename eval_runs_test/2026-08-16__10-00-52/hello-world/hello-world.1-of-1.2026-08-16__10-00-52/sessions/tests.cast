[12.04135, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_hello_file_exists\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Test that hello.txt file exists in the current directory.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        hello_path = Path(\u001b[33m\"\u001b[39;49;00m\u001b[33m/app/hello.txt\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n>       \u001b[94massert\u001b[39;49;00m hello_path.exists(), \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mFile \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mhello_path\u001b[33m}\u001b[39;49;00m\u001b[33m does not exist\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE       AssertionError: File /app/hello.txt does not exist\u001b[0m\r\n\u001b[1m\u001b[31mE       assert False\u001b[0m\r\n\u001b[1m\u001b[31mE        +  where False = exists()\u001b[0m\r\n\u001b[1m\u001b[31mE        +    where exists = PosixPath('/app/hello.txt').exists\u001b[0m\r\n\r\n\u001b[1m\u001b[31m/tests/test_outputs.py\u001b[0m:10: AssertionError\r\n"]
[12.041581, "o", "\u001b[31m\u001b[1m___________________________________________________________________ test_hello_file_content ____________________________________________________________________\u001b[0m\r\n\r\n"]
[12.042099, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_hello_file_content\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Test that hello.txt contains exactly 'Hello, world!' followed by a newline.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        hello_path = Path(\u001b[33m\"\u001b[39;49;00m\u001b[33m/app/hello.txt\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n>       \u001b[94massert\u001b[39;49;00m hello_path.read_text().strip() == \u001b[33m\"\u001b[39;49;00m\u001b[33mHello, world!\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, (\u001b[90m\u001b[39;49;00m\r\n               ^^^^^^^^^^^^^^^^^^^^^^\u001b[90m\u001b[39;49;00m\r\n"]
[12.042132, "o", "            \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mExpected \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33mHello, world!\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m but got \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mhello_path.read_text().strip()\u001b[33m}\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        )\u001b[90m\u001b[39;49;00m\r\n\r\n"]
