[17.114571, "o", "    \u001b[33m    Test STP with multiple variables and complex constraints.\u001b[39;49;00m\r\n    \u001b[33m    Find values where x < y and x + y = 15 and both are 8-bit values.\u001b[39;49;00m\r\n    \u001b[33m    \"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        stp_query = \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m(set-logic QF_BV)\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m(set-info :smt-lib-version 2.0)\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m(declare-fun x () (_ BitVec 8))\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m(declare-fun y () (_ BitVec 8))\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m(assert (bvult x y))\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m(assert (= (bvadd x y) #x0F))\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m(assert (bvuge x #x01))\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m(check-sat)\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m(exit)\u001b[39;49;00m\u001b[33m\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m"]
[17.114836, "o", "\r\n>       result = subprocess.run(\u001b[90m\u001b[39;49;00m\r\n            [\u001b[33m\"\u001b[39;49;00m\u001b[33mstp\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m],\u001b[90m\u001b[39;49;00m\r\n            \u001b[96minput\u001b[39;49;00m=stp_query,\u001b[90m\u001b[39;49;00m\r\n            text=\u001b[94mTrue\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            capture_output=\u001b[94mTrue\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            timeout=\u001b[94m30\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            env=os.environ,\u001b[90m\u001b[39;49;00m\r\n        )\u001b[90m\u001b[39;49;00m\r\n\r\n"]
