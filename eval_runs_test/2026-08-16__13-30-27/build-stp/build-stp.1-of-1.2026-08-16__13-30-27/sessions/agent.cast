[102.188306, "i", "set -e\ncd /app/stp\nrm -f /tmp/stp_build.log /tmp/stp_build_status\nbuild_system=unknown\nif [ -f CMakeLists.txt ]; then build_system=cmake; \nelif [ -f Makefile ] || [ -f makefile ] || [ -f GNUmakefile ]; then build_system=make; \nelif [ -f meson.build ]; then build_system=meson; \nelif [ -f Cargo.toml ]; then build_system=cargo; \nelif [ -f setup.py ] || [ -f pyproject.toml ]; then build_system=python; fi\necho \"$build_system\" > /tmp/stp_build_system\ncase \"$build_system\" in\n  cmake)\n    mkdir -p build\n    cd build\n    cmake .. >>/tmp/stp_build.log 2>&1\n    cmake --build . -j\"$(nproc)\" >>/tmp/stp_build.log 2>&1\n    ;;\n  make)\n    make -j\"$(nproc)\" >>/tmp/stp_build.log 2>&1\n    ;;\n  meson)\n    meson setup build >>/tmp/stp_build.log 2>&1 || true\n    meson compile -C build >>/tmp/stp_build.log 2>&1\n    ;;\n  cargo)\n    cargo build --release >>/tmp/stp_build.log 2>&1\n    ;;\n  python)\n    python3 -m pip install . >>/tmp/stp_build.log 2>&1\n    ;;\n  *)\n    # Fallback: compile simple C/C++ single or multi-file projects.\n    if find . -maxdepth 2 -name '*.c' | grep -q .; then\n      gcc -O2 -Wall -Wextra $(find . -maxdepth 2 -name '*.c' | sort) -o stp >>/tmp/stp_build.log 2>&1\n    elif find . -maxdepth 2 \\( -name '*.cc' -o -name '*.cpp' -o -name '*.cxx' \\) | grep -q .; then\n      g++ -O2 -std=c++17 -Wall -Wextra $(find . -maxdepth 2 \\( -name '*.cc' -o -name '*.cpp' -o -name '*.cxx' \\) | sort) -o stp >>/tmp/stp_build.log 2>&1\n    elif [ -f stp.py ]; then\n      chmod +x stp.py\n    elif [ -f stp ]; then\n      chmod +x stp\n    else\n      echo \"Could not determine how to build /app/stp\" >>/tmp/stp_build.log\n      exit 1\n    fi\n    ;;\nesac\necho ok > /tmp/stp_build_status\ntrue; tmux wait -S done\r"]
