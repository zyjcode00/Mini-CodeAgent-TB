[22.120407, "o", "self = <Popen: returncode: 255 args: ['stp']>, args = ['stp'], executable = b'stp', preexec_fn = None, close_fds = True, pass_fds = (), cwd = None\r\nenv = environ({'ASCIINEMA_REC': '1', 'HOME': '/root', 'HOSTNAME': '3c845a560443', 'LC_CTYPE': 'C.UTF-8', 'LESSCLOSE': '/usr/...l/bin/uv', 'PYTEST_VERSION': '8.4.1', 'PYTEST_CURRENT_TEST': 'test_outputs.py::test_stp_unsat_bit_constraints (call)'})\r\nstartupinfo = None, creationflags = 0, shell = False, p2cread = 11, p2cwrite = 12, c2pread = 13, c2pwrite = 14, errread = 15, errwrite = 16\r\nrestore_signals = True, gid = None, gids = None, uid = None, umask = -1, start_new_session = False, process_group = -1\r\n\r\n"]
