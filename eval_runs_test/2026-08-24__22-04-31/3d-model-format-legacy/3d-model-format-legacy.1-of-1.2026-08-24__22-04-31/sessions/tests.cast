[43.653279, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_cmakelists_exists\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Test that CMakeLists.txt exists in the /app subtree.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Check common locations where CMakeLists.txt might be\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        possible_locations = [\u001b[90m\u001b[39;49;00m\r\n            BASE_PATH / \u001b[33m\"\u001b[39;49;00m\u001b[33mCMakeLists.txt\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            MDFLIB_PATH / \u001b[33m\"\u001b[39;49;00m\u001b[33mCMakeLists.txt\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n        ]\u001b[90m\u001b[39;49;00m\r\n"]
[43.653537, "o", "    \u001b[90m\u001b[39;49;00m\r\n        found_cmake = [loc \u001b[94mfor\u001b[39;49;00m loc \u001b[95min\u001b[39;49;00m possible_locations \u001b[94mif\u001b[39;49;00m loc.exists()]\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n>       \u001b[94massert\u001b[39;49;00m \u001b[96mlen\u001b[39;49;00m(found_cmake) > \u001b[94m0\u001b[39;49;00m, (\u001b[90m\u001b[39;49;00m\r\n            \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mNo CMakeLists.txt found in expected locations. \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mChecked: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00m[\u001b[96mstr\u001b[39;49;00m(loc)\u001b[90m \u001b[39;49;00m\u001b[94mfor\u001b[39;49;00m\u001b[90m \u001b[39;49;00mloc\u001b[90m \u001b[39;49;00m\u001b[95min\u001b[39;49;00m\u001b[90m \u001b[39;49;00mpossible_locations]\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        )\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE       AssertionError: No CMakeLists.txt found in expected locations. Checked: ['CMakeLists.txt', 'MdfLib/CMakeLists.txt']\u001b[0m\r\n\u001b[1m\u001b[31mE       assert 0 > 0\u001b[0m\r\n\u001b[1m\u001b[31mE        +  where 0 = len([])\u001b[0m\r\n\r\n\u001b[1m\u001b[31m/tests/test_cmake.py\u001b[0m:32: AssertionError\r\n\u001b[31m\u001b[1m______________________________________________________________ test_cmakelists_contains_mdfformat ______________________________________________________________\u001b[0m\r\n"]
[43.653823, "o", "\r\n"]
[43.654075, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_cmakelists_contains_mdfformat\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Test that CMakeLists.txt references the MdfFormat.cpp source file.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Find all CMakeLists.txt files in /app subtree\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        cmake_files = \u001b[96mlist\u001b[39;49;00m(BASE_PATH.rglob(\u001b[33m\"\u001b[39;49;00m\u001b[33mCMakeLists.txt\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m))\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n>       \u001b[94massert\u001b[39;49;00m \u001b[96mlen\u001b[39;49;00m(cmake_files) > \u001b[94m0\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mNo CMakeLists.txt files found in /app\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n"]
[43.654329, "o", "\u001b[1m\u001b[31mE       AssertionError: No CMakeLists.txt files found in /app\u001b[0m\r\n\u001b[1m\u001b[31mE       assert 0 > 0\u001b[0m\r\n\u001b[1m\u001b[31mE        +  where 0 = len([])\u001b[0m\r\n\r\n\u001b[1m\u001b[31m/tests/test_cmake.py\u001b[0m:43: AssertionError\r\n\u001b[31m\u001b[1m________________________________________________________________ test_cmake_configuration_works ________________________________________________________________\u001b[0m\r\n\r\n"]
[43.65448, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_cmake_configuration_works\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n"]
[43.654749, "o", "    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Test that CMake can successfully configure the project.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Find CMakeLists.txt files\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        cmake_files = \u001b[96mlist\u001b[39;49;00m(BASE_PATH.rglob(\u001b[33m\"\u001b[39;49;00m\u001b[33mCMakeLists.txt\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m))\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n>       \u001b[94massert\u001b[39;49;00m \u001b[96mlen\u001b[39;49;00m(cmake_files) > \u001b[94m0\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mNo CMakeLists.txt found to test\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE       AssertionError: No CMakeLists.txt found to test\u001b[0m\r\n\u001b[1m\u001b[31mE       assert 0 > 0\u001b[0m\r\n\u001b[1m\u001b[31mE        +  where 0 = len([])\u001b[0m\r\n\r\n\u001b[1m\u001b[31m/tests/test_cmake.py\u001b[0m:71: AssertionError\r\n\u001b[31m\u001b[1m_____________________________________________________________ test_cmake_can_generate_build_files ______________________________________________________________\u001b[0m\r\n\r\n"]
[43.654894, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_cmake_can_generate_build_files\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Test that CMake generates build files (Makefiles or build.ninja).\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        cmake_files = \u001b[96mlist\u001b[39;49;00m(BASE_PATH.rglob(\u001b[33m\"\u001b[39;49;00m\u001b[33mCMakeLists.txt\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m))\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n>       \u001b[94massert\u001b[39;49;00m \u001b[96mlen\u001b[39;49;00m(cmake_files) > \u001b[94m0\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mNo CMakeLists.txt found\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n"]
[43.655025, "o", "\u001b[1m\u001b[31mE       AssertionError: No CMakeLists.txt found\u001b[0m\r\n\u001b[1m\u001b[31mE       assert 0 > 0\u001b[0m\r\n\u001b[1m\u001b[31mE        +  where 0 = len([])\u001b[0m\r\n\r\n\u001b[1m\u001b[31m/tests/test_cmake.py\u001b[0m:121: AssertionError\r\n"]
