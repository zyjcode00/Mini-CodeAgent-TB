[43.655368, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_cmake_build_and_run\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Test that CMake can build the project and the executable runs successfully.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n"]
