Sending keys: ['python3 - /app/maximal_square.py <<\'PY\'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = \'"""CPU implementation of the maximal all-ones square problem."""\\n\\nfrom __future__ import annotations\\n\\nimport numpy as np\\n\\n\\ndef maximal_square(matrix: np.ndarray) -> int:\\n    """Return the area of the largest square containing only ones.\\n\\n    The input is expected to be a rectangular NumPy array containing zeroes\\n    and ones. The dynamic-programming state is kept in a single numeric row;\\n    NumPy handles the per-row minimum operations so there is no Python loop\\n    over individual cells.\\n    """\\n    values = np.asarray(matrix)\\n    if values.ndim != 2:\\n        raise ValueError("matrix must be a two-dimensional array")\\n    rows, cols = values.shape\\n    if rows == 0 or cols == 0:\\n        return 0\\n\\n    # dp[j] is the largest square side ending at the current row and column.\\n    dp = np.zeros(cols + 1, dtype=np.int64)\\n    best = 0\\n    for row in values:\\n        previous_diagonal = 0\\n        for column in range(1, cols + 1):\\n            old = dp[column]\\n            if row[column - 1] != 0:\\n                dp[column] = min(dp[column], dp[column - 1], previous_diagonal) + 1\\n                if dp[column] > best:\\n                    best = int(dp[column])\\n            else:\\n                dp[column] = 0\\n            previous_diagonal = old\\n    return best * best\\n\'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, \'w\', encoding=\'utf-8\', newline=\'\\n\') as f:\n        f.write(content)\n    print(f"成功: 已写入 {path}")\nexcept Exception as exc:\n    print(f"写入失败: {exc}")\nPY\ntrue', '; tmux wait -S done', 'Enter'] min_timeout_sec: 0.0 max_timeout_sec: inf
