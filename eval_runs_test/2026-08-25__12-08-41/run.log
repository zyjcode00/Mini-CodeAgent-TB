Sending keys: ['python3 - /app/maximal_square.py <<\'PY\'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = \'"""NumPy implementation of the maximal all-ones square problem."""\\n\\nfrom __future__ import annotations\\n\\nimport numpy as np\\n\\n\\ndef maximal_square(matrix: np.ndarray) -> int:\\n    """Return the area of the largest square containing only ones.\\n\\n    A two-dimensional prefix sum lets each candidate square be checked in\\n    constant work per position. Binary search over the side length then\\n    keeps the expensive work in NumPy rather than in a Python cell loop.\\n    """\\n    values = np.asarray(matrix)\\n    if values.ndim != 2:\\n        raise ValueError("matrix must be a two-dimensional array")\\n    rows, cols = values.shape\\n    if rows == 0 or cols == 0:\\n        return 0\\n\\n    binary = (values != 0).astype(np.int64, copy=False)\\n    prefix = np.pad(binary, ((1, 0), (1, 0)), mode="constant")\\n    prefix = prefix.cumsum(axis=0, dtype=np.int64).cumsum(axis=1, dtype=np.int64)\\n\\n    def exists(side: int) -> bool:\\n        sums = (\\n            prefix[side:, side:]\\n            - prefix[:-side, side:]\\n            - prefix[side:, :-side]\\n            + prefix[:-side, :-side]\\n        )\\n        return bool(np.any(sums == side * side))\\n\\n    low, high = 0, min(rows, cols)\\n    while low < high:\\n        middle = (low + high + 1) // 2\\n        if exists(middle):\\n            low = middle\\n        else:\\n            high = middle - 1\\n    return low * low\\n\'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, \'w\', encoding=\'utf-8\', newline=\'\\n\') as f:\n        f.write(content)\n    print(f"成功: 已写入 {path}")\nexcept Exception as exc:\n    print(f"写入失败: {exc}")\nPY\ntrue', '; tmux wait -S done', 'Enter'] min_timeout_sec: 0.0 max_timeout_sec: inf
