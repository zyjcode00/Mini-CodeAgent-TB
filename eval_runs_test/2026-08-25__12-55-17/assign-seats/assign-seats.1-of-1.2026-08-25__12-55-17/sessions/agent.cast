[861.361961, "i", "python - <<'PY'\nimport base64,pickle\nout=[]\nfor p in ['/app/deps/clue.txt','/app/deps/frankie_preferences.txt','/app/deps/random_fact.txt']:\n    out.append(f'## {p}\\n'+open(p).read().strip())\nfor p in ['/app/deps/ask_alice.pkl','/app/deps/ask_bob.pkl']:\n    out.append(f'## {p}\\n'+repr(pickle.load(open(p,'rb'))))\np='/app/deps/ask_charlie.b64'\nout.append(f'## {p}\\n'+base64.b64decode(open(p).read()).decode())\nopen('/tmp/decoded_constraints.txt','w').write('\\n\\n'.join(out))\nPY\ntrue; tmux wait -S done\r"]
