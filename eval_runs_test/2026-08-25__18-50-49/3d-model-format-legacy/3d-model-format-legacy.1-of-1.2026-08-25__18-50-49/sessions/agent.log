>>>  446 | 	
>>>  447 | 	MdfHandle hMeshId;
>>>  448 | 	float fTimeLength;
>>>  449 | 
>>>  450 | 	FullTimelineList vTimelines;
>>>  451 | 
>>>  452 | 	void Clear(void) {
>>>  453 | 		hMeshId = 0;
>>>  454 | 		fTimeLength = 0;
>>>  455 | 		vTimelines.clear();
>>>  456 | 	}
>>>  457 | 
>>>  458 | 
>>>  459 | };
