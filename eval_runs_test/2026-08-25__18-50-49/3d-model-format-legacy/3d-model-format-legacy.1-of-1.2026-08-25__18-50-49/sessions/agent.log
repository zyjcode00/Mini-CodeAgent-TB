>>>  113 | //////////////////////////////////////////////////////////////////////////
>>>  114 | /// \brief Generic 4x4 matrix
>>>  115 | /// \author Ivgeni Segal
>>>  116 | /// \date January 20, 2007
>>>  117 | ///
>>>  118 | /// Generic matrix used in the MDF format
>>>  119 | ///
>>>  120 | /// \remarks MDF uses row-major matrices, if you need to use MDF in a
>>>  121 | ///			 column-major environment such as OpenGL don't forget to
>>>  122 | ///			 transpose them.
>>>  123 | ///
>>>  124 | //////////////////////////////////////////////////////////////////////////
>>>  125 | struct TMdfMatrix4
>>>  126 | {
>>>  127 | 	float	e[16];
>>>  128 | };
>>>  129 | 
>>>  130 | //////////////////////////////////////////////////////////////////////////
>>>  131 | /// \brief Skinned vertex for animation
>>>  132 | /// \author Ivgeni Segal
>>>  133 | /// \date January 20, 2007
>>>  134 | ///
>>>  135 | /// \remarks Skinned vertex is present in animated meshes and supports
>>>  136 | ///	up to four bones per vertex
>>>  137 | ///
>>>  138 | //////////////////////////////////////////////////////////////////////////
>>>  139 | struct TMdfVertSkn
>>>  140 | {
>>>  141 | 	Float3 pos;
>>>  142 | 	float weights[3];
>>>  143 | 	unsigned char bones[4];
>>>  144 | 
>>>  145 | 	Float3 normal;
>>>  146 | 	Float2 texcoord;
>>>  147 | };
>>>  148 | 
>>>  149 | //////////////////////////////////////////////////////////////////////////
>>>  150 | /// \brief Vertex for static meshes
>>>  151 | /// \author Ivgeni Segal
>>>  152 | /// \date January 20, 2007
>>>  153 | ///
>>>  154 | /// \remarks All static geometry in MDF uses this vertex format,
>>>  155 | ///			 he UV coordinates are in DirectX form
>>>  156 | ///
>>>  157 | //////////////////////////////////////////////////////////////////////////
>>>  158 | struct TMdfVertSta
>>>  159 | {
>>>  160 | 	Float3 pos;			///< Vertex position in model space
>>>  161 | 
>>>  162 | 	Float3 normal;		///< Vertex normal
>>>  163 | 	Float2 texcoord;	///< UV Texture coordinate
>>>  164 | 
>>>  165 | 	TMdfVertSta & operator=(const TMdfVertSkn &rhs) {
>>>  166 | 		pos.x = rhs.pos.x;
>>>  167 | 		pos.y = rhs.pos.y;
>>>  168 | 		pos.z = rhs.pos.z;
>>>  169 | 
>>>  170 | 		normal.x = rhs.normal.x;
>>>  171 | 		normal.y = rhs.normal.y;
>>>  172 | 		normal.z = rhs.normal.z;
>>>  173 | 
>>>  174 | 		texcoord.u = rhs.texcoord.u;
>>>  175 | 		texcoord.v = rhs.texcoord.v;
>>>  176 | 		return *this;
>>>  177 | 	}
>>>  178 | };
>>>  179 | 
>>>  180 | 
>>>  181 | 
>>>  182 | //////////////////////////////////////////////////////////////////////////
>>>  183 | /// \brief A single Mesh Object
>>>  184 | /// \author Ivgeni Segal
>>>  185 | /// \date January 20, 2007
>>>  186 | ///
>>>  187 | /// \remarks The nDataOffset elements are the positions
>>>  188 | /// relative to the beginning of the MDF file.
>>>  189 | /// once the file is loaded they are converted into memory locations.
>>>  190 | /// \par
>>>  191 | /// The TMdfMesh Object contains all the information needed to display a mesh
>>>  192 | /// In addition to vertex information, the Mesh Object stores optional
>>>  193 | /// bind-pose matrix array for animation as well as parenting information
>>>  194 | /// for the joints. All joints are stored in depth-first order of the joint hierarchy.
>>>  195 | /// \par
>>>  196 | /// Both of the arrays are parallel to the joint-keyframe
>>>  197 | /// arrays in the the TMdfAnimation Object that corresponds to this mesh.
>>>  198 | ///
>>>  199 | ///
>>>  200 | //////////////////////////////////////////////////////////////////////////
>>>  201 | struct TMdfMesh
>>>  202 | {
>>>  203 | 	unsigned int	nNumVerts;		///< Number of vertices in this mesh
>>>  204 | 	unsigned int	nNumIndices;	///< Number of vertex indexes
>>>  205 | 	unsigned int	nNumJoints;		///< Number of joints in stored bind
>>>  206 | 									///< pose and parenting arrays
>>>  207 | 	MdfHandle		hTexture;		///< Index of the texture name
>>>  208 | 	int meshType;					///< Mesh type (See MeshType enum)
>>>  209 | 
>>>  210 | 	///
>>>  211 | 	/// Mesh vertex array
>>>  212 | 	///
>>>  213 | 	union UVerts_t {	// reference to the vertices
>>>  214 | 		void *pVertices;			///< Vertexes when in memory
>>>  215 | 		int nDataOffset;			///< Offset to vertexes when in file
>>>  216 | 	} uVtxs;
>>>  217 | 
>>>  218 | 	///
>>>  219 | 	/// Mesh index array
>>>  220 | 	///
>>>  221 | 	union UIdxs_t {
>>>  222 | 		unsigned short *pIndices;	///< Index array in memory
>>>  223 | 		int nDataOffset;			///< Offset to index array in file
>>>  224 | 	} uIdxs;
>>>  225 | 
>>>  226 | 	///
>>>  227 | 	/// Mesh bind-pose matrices (Animated Meshes only)
>>>  228 | 	///
>>>  229 | 	union UBind_t {
>>>  230 | 		TMdfMatrix4 *pBindMats;		///< Bind matrix array in memory
>>>  231 | 									///< will be NULL if no bind information
>>>  232 | 
>>>  233 | 		int nDataOffset;			///< Offset to bind matrix array in file
>>>  234 | 	} uBnd;
>>>  235 | 
>>>  236 | 	///
>>>  237 | 	/// Parent index map (Animated Meshes only)
>>>  238 | 	///
>>>  239 | 	union UPrnt_t {		// reference to the (optional) hierarchy (parent info)
>>>  240 | 		int *pParentInfo;			///< Parent index array in memory
>>>  241 | 									///< this array is parallel to the joint
>>>  242 | 									///< arrays of this mesh. The index values
>>>  243 | 									///< correspond to all of the joint arrays:
>>>  244 | 									///< pParentInfo[jointIndex] = parentIndex
>>>  245 | 									///< If a joint has no parent, it's
>>>  246 | 									///< index value is -1
>>>  247 | 
>>>  248 | 		int nDataOffset;			///< Offset to parent index array in file
>>>  249 | 	} uPrnt;
>>>  250 | 
>>>  251 | 	///
>>>  252 | 	/// Mesh Type used by TMdfMesh::meshType value
>>>  253 | 	///
>>>  254 | 	enum MeshType {
>>>  255 | 		MESH_STATIC = 0,	/// Static meshes use TMdfVertSta vertices
>>>  256 | 		MESH_SKINNED,		/// Skinned meshes use TMdfVertSkn vertices
>>>  257 | 		NUM_TYPES
>>>  258 | 	};
>>>  259 | 
>>>  260 | 	unsigned int VertexSize() const {
>>>  261 | 		switch(meshType) {
>>>  262 | 			case MESH_STATIC:
>>>  263 | 				return sizeof(TMdfVertSta);
>>>  264 | 				break;
>>>  265 | 			case MESH_SKINNED:
>>>  266 | 				return sizeof(TMdfVertSkn);
>>>  267 | 				break;
>>>  268 | 
>>>  269 | 			default:
>>>  270 | 				return 0;
>>>  271 | 		}
>>>  272 | 	}
>>>  273 | 
>>>  274 | };
>>>  275 | 
>>>  276 | //////////////////////////////////////////////////////////////////////////
>>>  277 | /// \brief A single joint keyframe
>>>  278 | /// \author Ivgeni Segal
>>>  279 | /// \date January 20, 2007
>>>  280 | ///
>>>  281 | /// Stores information about a single key-frame of a joint
>>>  282 | ///
>>>  283 | /// \remarks All transformation values are relative to their parent.
>>>  284 | ///			 In other words, if joint A is parent of joint B, B's
>>>  285 | ///			 transformation values represent the values that take
>>>  286 | ///			 the joint from location/orientation/scale of A to B
>>>  287 | //////////////////////////////////////////////////////////////////////////
>>>  288 | struct TMdfKeyframe
>>>  289 | {
>>>  290 | 	float fKeyTime;			///< Time of start of this keyframe
>>>  291 | 	Float3 vecTranslation;	///< Relative translation at this keyframe
>>>  292 | 	Float4 qRotation;		///< Relative rotation at this keyframe
>>>  293 | 	Float3 vecScale;			///< Relative joint scale at this keyframe
>>>  294 | };
>>>  295 | 
>>>  296 | //////////////////////////////////////////////////////////////////////////
>>>  297 | /// \brief A collection of keyframes for a single joint
>>>  298 | /// \author Ivgeni Segal
>>>  299 | /// \date January 20, 2007
>>>  300 | ///
>>>  301 | /// \remarks The timeline is the animation channel for a single joint.
>>>  302 | /// Timelines store the collection of keyframes for a single joint.
>>>  303 | /// An array of timelines is stored in the TMdfAnimation object. The array
>>>  304 | /// corresponds to the depth-first sequence of joints. This array is 
>>>  305 | /// parallel to the bind and parenting arrays in the corresponding TMdfMesh
>>>  306 | /// object.
>>>  307 | ///
>>>  308 | //////////////////////////////////////////////////////////////////////////
>>>  309 | struct TMdfTimeline
>>>  310 | {
>>>  311 | 	int nKeyFrames;
>>>  312 | 
>>>  313 | 	union UKfs_t {
>>>  314 | 		TMdfKeyframe *pKeyframes;
>>>  315 | 		int nDataOffset;
>>>  316 | 	} uKfs;
>>>  317 | };
>>>  318 | 
>>>  319 | //////////////////////////////////////////////////////////////////////////
>>>  320 | /// \brief MDF Animation Object for a single mesh
>>>  321 | /// \author Ivgeni Segal
>>>  322 | /// \date January 20, 2007
>>>  323 | ///
>>>  324 | /// MDF Animation object stores an array of joint timeline channels
>>>  325 | /// which in term contain the keyframes for each joint
>>>  326 | ///
>>>  327 | /// \remarks All joint keyframe transformations are relative to their
>>>  328 | ///			 parent joints. The parent joint information can be obtained
>>>  329 | ///			 from the TMdfMesh::uPrnt.pParentInfo array.
>>>  330 | ///
>>>  331 | ///	\par	 The order at which the timelines are stored in the pTimeline
>>>  332 | ///			 array corresponds to the same order as in the TMdfMesh's
>>>  333 | ///			 bind-post joints and parent array
>>>  334 | ///
>>>  335 | //////////////////////////////////////////////////////////////////////////
>>>  336 | struct TMdfAnimation
>>>  337 | {
>>>  338 | 	MdfHandle hMeshId;	///< Index of the mesh that this animation belongs to
>>>  339 | 	int nNumTimelines;	///< Number of timelines stored (corresponds to number
>>>  340 | 						///< of joints)
>>>  341 | 	float fTimeLength;	///< Total play-time of this animation
>>>  342 | 
>>>  343 | 	union UTls_t {
>>>  344 | 		TMdfTimeline *pTimeline;	///< Array of timeline (channel) objects
>>>  345 | 									///< this corresponds to the joints
>>>  346 | 									///< and is stored in depth-first
>>>  347 | 									///< order of the joint hierarchy
>>>  348 | 
>>>  349 | 		int nDataOffset;			///< Offset of the array in file
>>>  350 | 	} uTls;
>>>  351 | 
>>>  352 | };
