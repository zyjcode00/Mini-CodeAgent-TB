>>>  371 | 
>>>  372 | typedef std::vector<MdfFullVertex> FullVertList;
>>>  373 | typedef std::vector<unsigned short> FullIndexList;
>>>  374 | 
>>>  375 | struct MdfFullMesh {
>>>  376 | 	MdfFullMesh() : 
>>>  377 | 		vertices(0), 
>>>  378 | 		numVertices(0), 
>>>  379 | 		finalBindPose(0), 
>>>  380 | 		parentInfo(0),
>>>  381 | 		numBindPoseElements(0)
>>>  382 | 		{}
>>>  383 | 
>>>  384 | 	// temporary verts
>>>  385 | 	MdfFullVertex *vertices;
>>>  386 | 	unsigned int numVertices;
>>>  387 | 
>>>  388 | 	// mesh info
>>>  389 | 	FullVertList finalVerts;
>>>  390 | 	FullIndexList finalIndices;
>>>  391 | 
>>>  392 | 	// hierarchy info
>>>  393 | 	TMdfMatrix4 *finalBindPose;
>>>  394 | 	unsigned int numBindPoseElements;
>>>  395 | 	int *parentInfo;
>>>  396 | 
>>>  397 | 	std::string textureFilename;
>>>  398 | 
>>>  399 | 	void addVertex(const MdfFullVertex &v) {
>>>  400 | 		unsigned short tmpSize = (unsigned short)finalVerts.size();
>>>  401 | 		
>>>  402 | 		for(unsigned short i = 0; i < tmpSize; i++) {
>>>  403 | 			if(finalVerts[i] == v) {
>>>  404 | 				finalIndices.push_back(i);
>>>  405 | 				return;
>>>  406 | 			}
>>>  407 | 		}
>>>  408 | 		
>>>  409 | 		finalVerts.push_back(v);
>>>  410 | 		finalIndices.push_back(tmpSize);
>>>  411 | 	}
>>>  412 | 
>>>  413 | 	void Clear(void) {
>>>  414 | 		delete[] vertices;
>>>  415 | 		vertices = 0;
>>>  416 | 		numVertices = 0;
>>>  417 | 		delete[] finalBindPose;
>>>  418 | 		finalBindPose = 0;
>>>  419 | 		numBindPoseElements = 0;
>>>  420 | 
>>>  421 | 		delete[] parentInfo;
>>>  422 | 		parentInfo = 0;
>>>  423 | 
>>>  424 | 		finalVerts.clear();
>>>  425 | 		finalIndices.clear();
>>>  426 | 
>>>  427 | 		textureFilename.clear();
>>>  428 | 	}
>>>  429 | 
>>>  430 | };
>>>  431 | 
