[36.041314, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_cmakelists_exists\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Test that CMakeLists.txt exists in the /app subtree.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Check common locations where CMakeLists.txt might be\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        possible_locations = [\u001b[90m\u001b[39;49;00m\r\n            BASE_PATH / \u001b[33m\"\u001b[39;49;00m\u001b[33mCMakeLists.txt\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            MDFLIB_PATH / \u001b[33m\"\u001b[39;49;00m\u001b[33mCMakeLists.txt\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n        ]\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        found_cmake = [loc \u001b[94mfor\u001b[39;49;00m loc \u001b[95min\u001b[39;49;00m possible_locations \u001b[94mif\u001b[39;49;00m loc.exists()]\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n>       \u001b[94massert\u001b[39;49;00m \u001b[96mlen\u001b[39;49;00m(found_cmake) > \u001b[94m0\u001b[39;49;00m, (\u001b[90m\u001b[39;49;00m\r\n"]
[36.041565, "o", "            \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mNo CMakeLists.txt found in expected locations. \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mChecked: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00m[\u001b[96mstr\u001b[39;49;00m(loc)\u001b[90m \u001b[39;49;00m\u001b[94mfor\u001b[39;49;00m\u001b[90m \u001b[39;49;00mloc\u001b[90m \u001b[39;49;00m\u001b[95min\u001b[39;49;00m\u001b[90m \u001b[39;49;00mpossible_locations]\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        )\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE       AssertionError: No CMakeLists.txt found in expected locations. Checked: ['CMakeLists.txt', 'MdfLib/CMakeLists.txt']\u001b[0m\r\n\u001b[1m\u001b[31mE       assert 0 > 0\u001b[0m\r\n\u001b[1m\u001b[31mE        +  where 0 = len([])\u001b[0m\r\n\r\n\u001b[1m\u001b[31m/tests/test_cmake.py\u001b[0m:32: AssertionError\r\n"]
