[12.89072, "o", "    \u001b[33m    Open the file pointed to by this path and return a file object, as\u001b[39;49;00m\r\n    \u001b[33m    the built-in open() function does.\u001b[39;49;00m\r\n    \u001b[33m    \"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mif\u001b[39;49;00m \u001b[33m\"\u001b[39;49;00m\u001b[33mb\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m \u001b[95min\u001b[39;49;00m mode:\u001b[90m\u001b[39;49;00m\r\n            encoding = io.text_encoding(encoding)\u001b[90m\u001b[39;49;00m\r\n"]
