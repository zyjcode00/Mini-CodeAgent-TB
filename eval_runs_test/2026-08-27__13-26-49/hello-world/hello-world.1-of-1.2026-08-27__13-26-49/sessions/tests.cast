[11.076348, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_hello_file_content\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Test that hello.txt contains exactly 'Hello, world!' followed by a newline.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        hello_path = Path(\u001b[33m\"\u001b[39;49;00m\u001b[33m/app/hello.txt\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n>       \u001b[94massert\u001b[39;49;00m hello_path.read_text().strip() == \u001b[33m\"\u001b[39;49;00m\u001b[33mHello, world!\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, (\u001b[90m\u001b[39;49;00m\r\n               ^^^^^^^^^^^^^^^^^^^^^^\u001b[90m\u001b[39;49;00m\r\n            \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mExpected \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33mHello, world!\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m but got \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mhello_path.read_text().strip()\u001b[33m}\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        )\u001b[90m\u001b[39;49;00m\r\n"]
