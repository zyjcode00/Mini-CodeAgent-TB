[316.232984, "o", "path = sys.argv[1]\r\n\u001b[?2004l\r"]
[316.233063, "o", "\u001b[?2004h> "]
[316.235777, "o", "old_str = '<<<<<<< HEAD\\nI am a sixth PhD candidate at the [Paul G. Allen School of Computer Science & Engineering](https://www.cs.washington.edu/) at The University of Washington, where I am advised by [Tim Althoff](http://www.timalthoff.com/). I am affiliated with [UW NLP](https://twitter.com/uwnlp).\\n\\n Previously, I was a Student Researcher at [Google Research](https://research.google/), an ML Research Intern at [Apple Health AI](https://machinelearning.apple.com/work-with-us) and a data scientist and the second full-time employee at [HealthRhythms](https://www.healthrhythms.com).\\n=======\\nI am a Postdoctoral Researcher at Stanford CS.\\n\\nPreviously, I was a Student Researcher at [Google Research](https://research.google/), an ML Research Intern at [Apple Health AI](https://machinelearning.apple.com/work-with-us) and a data scientist and the second full-time employee at [HealthRhythms](https://www.healthrhythms.com).\\n>>>>>>> dc5cf1b (Move to Stanford)'\r\n\u001b[?2004l\r\u001b[?2004h"]
[316.235908, "o", "> "]
[316.236825, "o", "new_str = 'I am a Postdoctoral Researcher at Stanford CS.\\n\\nPreviously, I was a Student Researcher at [Google Research](https://research.google/), an ML Research Intern at [Apple Health AI](https://machinelearning.apple.com/work-with-us) and a data scientist and the second full-time employee at [HealthRhythms](https://www.healthrhythms.com).'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.236967, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.237053, "o", "def normalize_text(text: str) -> str:\r\n\u001b[?2004l\r\u001b[?2004h"]
[316.237092, "o", "> "]
[316.237348, "o", "    text = text.replace('\\r\\n', '\\n').replace('\\r', '\\n')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.237602, "o", "    return '\\n'.join(line.rstrip() for line in text.split('\\n'))\r\n\u001b[?2004l\r"]
[316.237758, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.237793, "o", "try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[316.237852, "o", "> "]
[316.238039, "o", "    with open(path, 'r', encoding='utf-8', errors='replace') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[316.238092, "o", "> "]
[316.238215, "o", "        content = f.read()\r\n\u001b[?2004l\r"]
[316.23829, "o", "\u001b[?2004h> "]
[316.238375, "o", "except FileNotFoundError:\r\n\u001b[?2004l\r"]
[316.23842, "o", "\u001b[?2004h> "]
[316.238575, "o", "    print(f\"错误: 找不到文件 {path}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[316.238629, "o", "> "]
[316.238725, "o", "    raise SystemExit(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[316.238811, "o", "> "]
[316.238971, "o", "except Exception as exc:\r\n\u001b[?2004l\r\u001b[?2004h"]
[316.239095, "o", ">     print(f\"修改失败: {exc}\")\r\n\u001b[?2004l\r"]
[316.239136, "o", "\u001b[?2004h>     raise SystemExit(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[316.239162, "o", "> "]
[316.239242, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.239314, "o", "content = normalize_text(content)\r\n\u001b[?2004l\r"]
[316.23939, "o", "\u001b[?2004h> "]
[316.239518, "o", "old_str = normalize_text(old_str)\r\n\u001b[?2004l\r\u001b[?2004h"]
[316.239606, "o", "> "]
[316.239711, "o", "new_str = normalize_text(new_str)\r\n\u001b[?2004l\r"]
[316.239759, "o", "\u001b[?2004h"]
[316.239845, "o", "> "]
[316.239917, "o", "count = content.count(old_str)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.239993, "o", "if count == 0:\r\n\u001b[?2004l\r"]
[316.240069, "o", "\u001b[?2004h> "]
[316.240633, "o", "    print(\"错误: 在文件中找不到 old_str。\\n建议：\\n1. 使用 read_file(raw_mode=True) 获取原始内容\\n2. 检查是否有多余的空格或换行符\\n3. 如果文件较大，考虑使用 write_full_file 全量覆盖\")\r\n\u001b[?2004l\r"]
[316.240665, "o", "\u001b[?2004h> "]
[316.240774, "o", "    raise SystemExit(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[316.240897, "o", "> "]
[316.240934, "o", "if count > 1:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.241276, "o", "    print(f\"错误: 匹配到 {count} 处相同的代码，请提供更具体的 old_str 以确保唯一性。\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.241415, "o", "    raise SystemExit(0)\r\n\u001b[?2004l\r"]
[316.241479, "o", "\u001b[?2004h> "]
[316.24169, "o", "with open(path, 'w', encoding='utf-8', newline='\\n') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.241892, "o", "    f.write(content.replace(old_str, new_str))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.24211, "o", "print(f\"成功: 已更新 {path}。修改已持久化。\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
