[177.350274, "o", "total_lines = len(lines)\r\n\u001b[?2004l\r\u001b[?2004h"]
[177.350317, "o", "> "]
[177.35042, "o", "s_idx = max(0, start_line - 1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[177.350506, "o", "> "]
[177.350651, "o", "e_idx = end_line if end_line is not None else total_lines\r\n\u001b[?2004l\r\u001b[?2004h"]
[177.350702, "o", "> "]
[177.350829, "o", "selected_lines = lines[s_idx:e_idx]\r\n\u001b[?2004l\r\u001b[?2004h"]
[177.35092, "o", "> "]
[177.351003, "o", "if raw_mode:\r\n\u001b[?2004l\r"]
[177.351055, "o", "\u001b[?2004h> "]
[177.351194, "o", "    sys.stdout.write(''.join(selected_lines))\r\n\u001b[?2004l\r\u001b[?2004h"]
[177.351229, "o", "> else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[177.351278, "o", "> "]
[177.351362, "o", "    output = []\r\n\u001b[?2004l\r"]
[177.351452, "o", "\u001b[?2004h> "]
[177.351597, "o", "    for i, line in enumerate(selected_lines):\r\n\u001b[?2004l\r"]
[177.351653, "o", "\u001b[?2004h> "]
[177.351877, "o", "        output.append(f\"{s_idx + i + 1:4d} | {line.rstrip()}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[177.351973, "o", "> "]
[177.35228, "o", "    header = f\"--- 文件: {path} (第 {start_line} 至 {min(e_idx, total_lines)} 行，共 {total_lines} 行) ---\\n\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[177.352401, "o", "> "]
[177.352672, "o", "    sys.stdout.write(header + \"\\n\".join(output) + \"\\n--- 读取完毕 ---\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
