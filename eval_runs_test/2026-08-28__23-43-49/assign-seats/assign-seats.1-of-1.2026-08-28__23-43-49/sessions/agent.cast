[101.549115, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - <<'PY'\nfrom itertools import permutations\nfrom pathlib import Path\nimport base64, pickle\n\n# Confirm all source formats remain readable.\nassert 'Frankie' in Path('/app/deps/frankie_preferences.txt').read_text()\nassert base64.b64decode(Path('/app/deps/ask_charlie.b64').read_bytes()).startswith(b'print(')\nfor name in ('ask_alice.pkl', 'ask_bob.pkl'):\n    with open('/app/deps/' + name, 'rb') as f:\n        assert isinstance(pickle.load(f), str)\n\npeople = ['Alice', 'Bob', 'Charlie', 'David', 'Ethan', 'Frankie']\nvalid = []\nfor rest in permutations([p for p in people if p != 'Alice']):\n    seats = ('Alice',) + rest\n    pos = {person: seats.index(person) for person in seats}\n    n = len(seats)\n    if pos['Bob'] != (pos['Alice'] - 2) % n:\n        continue\n    if (pos['Bob'] - pos['Ethan']) % n in (1, n - 1):\n        continue\n    if (pos['Alice'] - pos['Frankie']) % n in (1, n - 1):\n        continue\n    frankie_neighbors = {seats[(pos['Frankie'] - 1) % n], s"]
[101.549325, "i", "eats[(pos['Frankie'] + 1) % n]}\n    if not frankie_neighbors.intersection({'David', 'Ethan'}):\n        continue\n    if (pos['Ethan'] - pos['Bob']) % n == 3 and pos['David'] != (pos['Alice'] + 2) % n:\n        continue\n    valid.append(seats)\n\npairs = sorted({tuple(sorted((s[(s.index('Charlie') - 1) % 6], s[(s.index('Charlie') + 1) % 6]))) for s in valid})\nexpected = ''.join(f'{a}, {b}\\n' for a, b in pairs)\nactual = Path('/app/results.txt').read_text()\nassert actual == expected, (actual, expected)\nassert len(valid) == 3\nassert pairs == [('Alice', 'Bob'), ('Alice', 'Ethan')]\nprint(f'PASS: {len(valid)} valid arrangements; {len(pairs)} Charlie neighbor pairs; output matches.')\nPY\ntrue; tmux wait -S done\r"]
