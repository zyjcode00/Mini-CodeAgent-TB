[39.57898, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - <<'PY'\nimport base64, pickle\nfor path in ['/app/deps/ask_alice.pkl','/app/deps/ask_bob.pkl']:\n    print(path)\n    with open(path,'rb') as f:\n        print(repr(pickle.load(f)))\npath='/app/deps/ask_charlie.b64'\nprint(path)\nraw=open(path,'rb').read()\nprint(base64.b64decode(raw).decode('utf-8'))\nPY\ntrue; tmux wait -S done\r"]
