Sending keys: ["export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - <<'PY'\nfrom itertools import permutations\npeople=['Alice','Bob','Charlie','David','Ethan','Frankie']\n# Fix Alice at 0 to remove circular rotations. right = increasing index.\nvalid=[]\nfor p in permutations([x for x in people if x!='Alice']):\n    seats=('Alice',)+p\n    pos={x:seats.index(x) for x in seats}\n    n=6\n    # Bob two seats left of Alice: left = decreasing, hence -2\n    if pos['Bob'] != (pos['Alice']-2)%n: continue\n    # Bob not next to Ethan\n    if (pos['Bob']-pos['Ethan'])%n in (1,n-1): continue\n    # Alice/Frankie rivals: not adjacent\n    if (pos['Alice']-pos['Frankie'])%n in (1,n-1): continue\n    # Frankie next to David or Ethan\n    f=pos['Frankie']\n    neigh={seats[(f-1)%n],seats[(f+1)%n]}\n    if not ({'David','Ethan'} & neigh): continue\n    # conditional: if Ethan across Bob, David two right of Alice\n    if (pos['Ethan']-pos['Bob'])%n == 3:\n        if pos['David'] != (pos['Alice']+2)%n: continue\n    valid.append(seats)\nprint('valid count',len(valid))\npairs=sorted({tuple(sorted((s[(s.index('Charlie')-1)%6],s[(s.index('Charlie')+1)%6]))) for s in valid})\nprint('pairs',len(pairs))\nfor p in pairs: print(p[0]+', '+p[1])\nfor s in valid: print(' | '.join(s))\nPY\ntrue", '; tmux wait -S done', 'Enter'] min_timeout_sec: 0.0 max_timeout_sec: inf
