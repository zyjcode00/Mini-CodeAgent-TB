[73.621638, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython - <<'PY'\nimport itertools\npeople = ['Alice','Bob','Charlie','David','Ethan','Frankie']\nothers = [p for p in people if p!='Alice']\n# Fix Alice at seat 0 to remove rotation.\n# For each orientation choice for left/right and seat numbering direction.\n# seats 0..5 clockwise.\n# left_dir = +1 means left is increasing seat index relative to Alice; Bob at seat 2.\n# right_dir = -1 means right is decreasing seat index.\n\nfor left_dir in [1,-1]:\n    print('LEFT_DIR', left_dir)\n    sols=[]\n    seats = [None]*6\n    seats[0]='Alice'\n    seats[(0+2*left_dir)%6]='Bob'\n    remaining = [p for p in people if p not in {'Alice','Bob'}]\n    for perm in itertools.permutations(remaining):\n        arr = seats[:]\n        idxs = [i for i,v in enumerate(arr) if v is None]\n        for i,p in zip(idxs, perm):\n            arr[i]=p\n        pos = {p:i for i,p in enumerate(arr)}\n        def adj(a,b):\n            return (pos[a]-pos[b])%6 in (1,5)\n        def across(a,b):\n            ret"]
[73.622306, "i", "urn (pos[a]-pos[b])%6==3\n        # constraints\n        if adj('Alice','Frankie'): continue  # rival companies cannot sit next to each other\n        if adj('Bob','Ethan'): continue\n        if not (adj('Frankie','David') or adj('Frankie','Ethan')): continue\n        # conditional clue\n        if across('Ethan','Bob'):\n            # David two seats to the right of Alice. right = -left_dir?\n            right_dir = -left_dir\n            if pos['David'] != (0 + 2*right_dir) % 6:\n                continue\n        sols.append(arr)\n    print('solutions', len(sols))\n    pairs=set()\n    for arr in sols:\n        i=arr.index('Charlie')\n        pair=tuple(sorted([arr[(i-1)%6], arr[(i+1)%6]]))\n        pairs.add(pair)\n    print('pairs', pairs)\n    for s in sols[:10]:\n        print(s)\n    print()\nPY\ntrue; tmux wait -S done\r"]
