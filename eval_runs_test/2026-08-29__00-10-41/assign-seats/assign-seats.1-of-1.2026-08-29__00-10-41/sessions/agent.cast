[50.17976, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython - <<'PY'\nimport base64, pickle, pathlib\nfor name in ['deps/ask_alice.pkl','deps/ask_bob.pkl']:\n    obj = pickle.loads(pathlib.Path(name).read_bytes())\n    print('FILE', name)\n    print(repr(obj))\n    print()\nprint('FILE deps/ask_charlie.b64')\nprint(base64.b64decode(pathlib.Path('deps/ask_charlie.b64').read_bytes()).decode())\nPY\ntrue; tmux wait -S done\r"]
