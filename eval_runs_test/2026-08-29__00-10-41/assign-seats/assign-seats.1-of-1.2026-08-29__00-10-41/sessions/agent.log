[?2004l[?2004h> # Fix Alice at seat 0 to remove rotation.
[?2004l[?2004h> # For each orientation choice for left/right and seat numbering direction.
[?2004l[?2004h> # seats 0..5 clockwise.
[?2004l[?2004h> # left_dir = +1 means left is increasing seat index relative to Alice; Bob at seat 2.
[?2004l[?2004h> # right_dir = -1 means right is decreasing seat index.
[?2004l[?2004h> 
[?2004l[?2004h> for left_dir in [1,-1]:
[?2004l[?2004h>     print('LEFT_DIR', left_dir)
[?2004l[?2004h>     sols=[]
[?2004l[?2004h>     seats = [None]*6
[?2004l[?2004h>     seats[0]='Alice'
[?2004l[?2004h>     seats[(0+2*left_dir)%6]='Bob'
[?2004l[?2004h>     remaining = [p for p in people if p not in {'Alice','Bob'}]
[?2004l[?2004h>     for perm in itertools.permutations(remaining):
[?2004l[?2004h>         arr = seats[:]
[?2004l[?2004h>         idxs = [i for i,v in enumerate(arr) if v is None]
[?2004l[?2004h>         for i,p in zip(idxs, perm):
[?2004l[?2004h>             arr[i]=p
[?2004l[?2004h>         pos = {p:i for i,p in enumerate(arr)}
[?2004l[?2004h>         def adj(a,b):
[?2004l[?2004h>             return (pos[a]-pos[b])%6 in (1,5)
[?2004l[?2004h>         def across(a,b):
[?2004l[?2004h>             return (pos[a]-pos[b])%6==3
[?2004l[?2004h>         # constraints
[?2004l[?2004h>         if adj('Alice','Frankie'): continue  # rival companies cannot sit next to each other
[?2004l[?2004h>         if adj('Bob','Ethan'): continue
[?2004l[?2004h>         if not (adj('Frankie','David') or adj('Frankie','Ethan')): continue
[?2004l[?2004h>         # conditional clue
[?2004l[?2004h>         if across('Ethan','Bob'):
[?2004l[?2004h>             # David two seats to the right of Alice. right = -left_dir?
[?2004l[?2004h>             right_dir = -left_dir
[?2004l[?2004h>             if pos['David'] != (0 + 2*right_dir) % 6:
[?2004l[?2004h>                 continue
[?2004l[?2004h>         sols.append(arr)
[?2004l[?2004h>     print('solutions', len(sols))
[?2004l[?2004h>     pairs=set()
[?2004l[?2004h>     for arr in sols:
