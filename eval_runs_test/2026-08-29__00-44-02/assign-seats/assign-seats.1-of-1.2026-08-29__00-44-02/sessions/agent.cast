[66.556129, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython - <<'PY'\nimport itertools\npeople = ['Alice','Bob','Charlie','David','Ethan','Frankie']\nidx = {p:i for i,p in enumerate(people)}\n\n# We will consider circular arrangements as seat order tuples around the table.\n# Fix Alice at seat 0 to remove rotational symmetry.\nothers = [p for p in people if p != 'Alice']\n\nfor left in [1,-1]:\n    sols = []\n    for perm in itertools.permutations(others):\n        seats = ['Alice'] + list(perm)\n        pos = {p:i for i,p in enumerate(seats)}\n        def adj(a,b):\n            d = (pos[a]-pos[b]) % 6\n            return d in (1,5)\n        def two_left(a,b):\n            # b is two seats to the left of a\n            return (pos[b]-pos[a]) % 6 == (2*left) % 6\n        ok = True\n        if not two_left('Alice','Bob'):\n            ok = False\n        if ok and adj('Bob','Ethan'):\n            ok = False\n        if ok and adj('Alice','Frankie'):\n            ok = False\n        if ok and not (adj('Frankie','David') or adj('Frankie','"]
[66.556196, "i", "Ethan')):\n            ok = False\n        if ok:\n            sols.append(seats)\n    pairs = set()\n    for seats in sols:\n        pos = {p:i for i,p in enumerate(seats)}\n        neigh = tuple(sorted([seats[(pos['Charlie']-1)%6], seats[(pos['Charlie']+1)%6]]))\n        pairs.add(neigh)\n    print('left', left, 'solutions', len(sols), 'pairs', sorted(pairs))\n    for s in sols[:10]:\n        print(s)\n    print()\nPY\ntrue; tmux wait -S done\r"]
