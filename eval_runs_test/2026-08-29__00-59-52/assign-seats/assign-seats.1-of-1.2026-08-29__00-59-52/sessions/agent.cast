[74.051075, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython - <<'PY'\nimport pickle, base64, pathlib\nfor p in ['deps/ask_alice.pkl','deps/ask_bob.pkl','deps/ask_charlie.b64']:\n    data = pathlib.Path(p).read_bytes()\n    print('FILE', p)\n    if p.endswith('.pkl'):\n        try:\n            obj = pickle.loads(data)\n            print(repr(obj))\n        except Exception as e:\n            print('pickle error', e)\n    else:\n        try:\n            decoded = base64.b64decode(data)\n            print(decoded)\n            try:\n                print(decoded.decode())\n            except Exception:\n                pass\n        except Exception as e:\n            print('b64 error', e)\nPY\ntrue; tmux wait -S done\r"]
[74.05143, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
