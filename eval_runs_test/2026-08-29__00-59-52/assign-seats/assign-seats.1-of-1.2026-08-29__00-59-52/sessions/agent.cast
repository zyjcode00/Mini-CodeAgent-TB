[202.2193, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython - <<'PY'\nimport itertools\npeople=('Alice','Bob','Charlie','David','Ethan','Frankie')\nvalid=[]\nfor rest in itertools.permutations([p for p in people if p!='Alice']):\n    seat=('Alice',)+rest\n    pos={p:i for i,p in enumerate(seat)}\n    # Bob two seats left of Alice; use left=-2 around circle\n    if pos['Bob'] != (pos['Alice']-2)%6: continue\n    def adjacent(a,b): return (pos[a]-pos[b])%6 in (1,5)\n    if adjacent('Bob','Ethan'): continue\n    if not (adjacent('Frankie','David') or adjacent('Frankie','Ethan')): continue\n    if adjacent('Alice','Frankie'): continue\n    # conditional clue\n    if pos['Ethan'] == (pos['Bob']+3)%6 and pos['David'] != (pos['Alice']+2)%6: continue\n    valid.append(seat)\npairs=sorted({tuple(sorted((s[(s.index('Charlie')-1)%6],s[(s.index('Charlie')+1)%6]))) for s in valid})\nprint('valid arrangements:', len(valid))\nfor s in valid: print(s)\nprint('pairs:', pairs)\nPY\ntrue; tmux wait -S done\r"]
[202.219921, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
