[48.061541, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython - <<'PY'\nimport pickle, base64, pathlib, pprint\nfor path in ['deps/ask_alice.pkl','deps/ask_bob.pkl']:\n    with open(path,'rb') as f:\n        obj = pickle.load(f)\n    print(path)\n    pprint.pp(obj)\n    print('---')\nwith open('deps/ask_charlie.b64','r') as f:\n    data = f.read().strip()\nprint('deps/ask_charlie.b64 decoded:')\nprint(base64.b64decode(data).decode())\nPY\ntrue; tmux wait -S done\r"]
[48.061842, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
