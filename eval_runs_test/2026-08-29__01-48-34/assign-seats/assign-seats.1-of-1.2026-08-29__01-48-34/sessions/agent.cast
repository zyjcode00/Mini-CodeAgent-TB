[48.442677, "o", "\u001b[?2004hroot@e25676d80083:/app# "]
[76.00347, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython - <<'PY'\nimport itertools\npeople = ['Alice','Bob','Charlie','David','Ethan','Frankie']\nfor left_dir in [1,-1]:\n    print('LEFT_DIR', left_dir)\n    sols=[]\n    # fix Alice at seat 0\n    for perm in itertools.permutations([p for p in people if p!='Alice']):\n        seats = { 'Alice':0 }\n        for i,p in enumerate(perm, start=1):\n            seats[p]=i\n        # adjacency helpers\n        def adj(a,b):\n            da=(seats[a]-seats[b])%6\n            return da in (1,5)\n        def opposite(a,b):\n            return (seats[a]-seats[b])%6==3\n        def left_of(a,k=1):\n            return (seats[a]+left_dir*k)%6\n        # Bob two seats to the left of Alice\n        if seats['Bob'] != left_of('Alice',2):\n            continue\n        # Alice and Frankie not adjacent\n        if adj('Alice','Frankie'):\n            continue\n        # Bob not next to Ethan\n        if adj('Bob','Ethan'):\n            continue\n        # Frankie next to at least one of David/Ethan\n  "]
[76.003635, "i", "      if not (adj('Frankie','David') or adj('Frankie','Ethan')):\n            continue\n        # If Ethan opposite Bob then David two seats to the right of Alice.\n        # right is opposite direction of left_dir\n        if opposite('Ethan','Bob'):\n            if seats['David'] != (seats['Alice'] - left_dir*2)%6:\n                continue\n        sols.append(tuple(p for p,_ in sorted(seats.items(), key=lambda kv: kv[1])))\n    print('solutions', len(sols))\n    neigh=set()\n    for s in sols:\n        idx=s.index('Charlie')\n        neigh.add(tuple(sorted((s[(idx-1)%6], s[(idx+1)%6]))))\n    print('neighbor pairs', sorted(neigh))\n    print('example sols', sols[:5])\nPY\ntrue; tmux wait -S done\r"]
[76.004211, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
