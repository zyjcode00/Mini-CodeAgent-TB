[48.392971, "o", "deps/ask_alice.pkl\r\n"]
[48.393214, "o", "('print(\"I\\'m Alice! You should know that Frankie and I work at rival '\r\n 'companies.\")')\r\n---\r\n"]
[48.431603, "o", "deps/ask_bob.pkl\r\n"]
[48.431776, "o", "('print(\"I\\'m Bob! My preference is that I sit two seats to the left of Alice. '\r\n 'Also, I don\\'t like Ethan, so I refuse to sit next to him.\")')\r\n---\r\n"]
[48.431903, "o", "deps/ask_charlie.b64 decoded:\r\nprint(\"So... who are the two people I'm sitting between?\")\r\n"]
