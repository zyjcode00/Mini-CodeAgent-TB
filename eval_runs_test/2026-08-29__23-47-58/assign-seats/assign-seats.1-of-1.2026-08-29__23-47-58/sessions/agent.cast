[62.101346, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython - <<'PY'\nimport pickle, base64, pathlib\nfor path in ['deps/ask_alice.pkl','deps/ask_bob.pkl']:\n    data = pathlib.Path(path).read_bytes()\n    obj = pickle.loads(data)\n    print(path, type(obj), obj)\nprint('deps/ask_charlie.b64')\nraw = pathlib.Path('deps/ask_charlie.b64').read_text().strip()\nprint(base64.b64decode(raw).decode())\nPY\ntrue; tmux wait -S done\r"]
