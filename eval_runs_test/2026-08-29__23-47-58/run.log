Sending keys: ["export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython - <<'PY'\nfrom itertools import permutations\npeople = ['Alice','Bob','Charlie','David','Ethan','Frankie']\n\n# circular positions 0..5 clockwise\n# adjacency pairs (i,(i+1)%6)\n\ndef valid(arr, left_is_clockwise):\n    pos = {p:i for i,p in enumerate(arr)}\n    def left_of(a, k=1):\n        return (pos[a] + (k if left_is_clockwise else -k)) % 6\n    def right_of(a, k=1):\n        return (pos[a] - (k if left_is_clockwise else -k)) % 6\n    def next_to(a,b):\n        return (pos[a]-pos[b])%6 in (1,5)\n    def across(a,b):\n        return (pos[a]-pos[b])%6 == 3\n\n    # Alice and Frankie not next to each other\n    if next_to('Alice','Frankie'):\n        return False\n    # Bob sits two seats to the left of Alice\n    if pos['Bob'] != left_of('Alice',2):\n        return False\n    # Bob and Ethan not next to each other\n    if next_to('Bob','Ethan'):\n        return False\n    # conditional\n    if across('Ethan','Bob') and pos['David'] != right_of('Alice',2):\n        return False\n    # Frankie next to at least one of David and Ethan\n    if not (next_to('Frankie','David') or next_to('Frankie','Ethan')):\n        return False\n    return True\n\nfor left_is_clockwise in [True, False]:\n    pairs = set()\n    sols = []\n    for arr in permutations(people):\n        if valid(arr, left_is_clockwise):\n            pos = {p:i for i,p in enumerate(arr)}\n            # canonical via rotation? just collect neighbors of Charlie\n            neigh = [arr[(pos['Charlie']-1)%6], arr[(pos['Charlie']+1)%6]]\n            pairs.add(tuple(sorted(neigh)))\n            sols.append(arr)\n    print('left_is_clockwise', left_is_clockwise, 'solutions', len(sols), 'pairs', sorted(pairs))\nPY\ntrue", '; tmux wait -S done', 'Enter'] min_timeout_sec: 0.0 max_timeout_sec: inf
