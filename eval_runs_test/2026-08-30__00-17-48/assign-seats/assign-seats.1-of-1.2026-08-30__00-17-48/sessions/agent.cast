[46.876706, "o", "--- deps/ask_alice.pkl ---\r\n"]
[46.876953, "o", "'print(\"I\\'m Alice! You should know that Frankie and I work at rival companies.\")'\r\n--- deps/ask_bob.pkl ---\r\n'print(\"I\\'m Bob! My preference is that I sit two seats to the left of Alice. Also, I don\\'t like Ethan, so I refuse to sit next to him.\")'\r\n--- deps/ask_charlie.b64 ---\r\nprint(\"So... who are the two people I'm sitting between?\")\r\n"]
[46.882137, "o", "\u001b[?2004hroot@9cc77d554a08:/app# "]
[46.882342, "o", "true; tmux wait -S done\r\n\u001b[?2004l\r"]
[46.885238, "o", "\u001b[?2004hroot@9cc77d554a08:/app# "]
[85.832718, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython - <<'PY'\nimport itertools\npeople=['Alice','Bob','Charlie','David','Ethan','Frankie']\nothers=['Bob','Charlie','David','Ethan','Frankie']\n# fix Alice at 0. positions 0..5 clockwise.\n# left options: +2 or -2 from Alice for Bob\n# right options for David: +2 or -2 from Alice\nfor left in [2,4]:\n  for right in [2,4]:\n    valid=[]\n    for perm in itertools.permutations(others):\n      pos={'Alice':0}\n      for i,p in enumerate(perm,1):\n        pos[p]=i\n      # Bob two seats left of Alice\n      if pos['Bob']!=left: continue\n      # Frankie next to at least one of David/Ethan\n      neigh=lambda a,b: (pos[a]-pos[b])%6 in (1,5)\n      if not (neigh('Frankie','David') or neigh('Frankie','Ethan')):\n        continue\n      # Alice and Frankie not adjacent (rival companies)\n      if neigh('Alice','Frankie'): continue\n      # Bob not next to Ethan\n      if neigh('Bob','Ethan'): continue\n      # conditional: if Ethan across from Bob, then David two seats right of Alice\n "]
[85.832804, "i", "     if (pos['Ethan']-pos['Bob'])%6==3 and pos['David']!=right:\n        continue\n      valid.append(pos)\n    pairs=set()\n    for pos in valid:\n      # Charlie's neighbors (unordered alphabetic pair)\n      n=[]\n      for p,q in itertools.combinations(people,2):\n        pass\n      # find adjacent to Charlie\n      for x in people:\n        if x=='Charlie': continue\n        if (pos[x]-pos['Charlie'])%6 in (1,5):\n          n.append(x)\n      if len(n)==2:\n        pairs.add(tuple(sorted(n)))\n    print('left',left,'right',right,'count',len(valid),'pairs',sorted(pairs))\nPY\ntrue; tmux wait -S done\r"]
[85.833211, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
