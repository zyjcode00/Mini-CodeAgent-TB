[140.623266, "o", "from pathlib import Path\r\n\r\n\r\ndef test_charlie_neighbor_pairs():\r\n    result = Path('/app/results.txt').read_text()\r\n    assert result == 'Alice, Bob\\nAlice, Ethan\\n'\r\n    pairs = [tuple(line.split(', ')) for line in result.splitlines()]\r\n    assert pairs == sorted(pairs)\r\n    assert all(left < right for left, right in pairs)\r\n"]
