Sending keys: ["export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython - <<'PY'\nimport itertools\npeople=['Alice','Bob','Charlie','David','Ethan','Frankie']\nothers=['Bob','Charlie','David','Ethan','Frankie']\n# fix Alice at 0. positions 0..5 clockwise.\n# left options: +2 or -2 from Alice for Bob\n# right options for David: +2 or -2 from Alice\nfor left in [2,4]:\n  for right in [2,4]:\n    valid=[]\n    for perm in itertools.permutations(others):\n      pos={'Alice':0}\n      for i,p in enumerate(perm,1):\n        pos[p]=i\n      # Bob two seats left of Alice\n      if pos['Bob']!=left: continue\n      # Frankie next to at least one of David/Ethan\n      neigh=lambda a,b: (pos[a]-pos[b])%6 in (1,5)\n      if not (neigh('Frankie','David') or neigh('Frankie','Ethan')):\n        continue\n      # Alice and Frankie not adjacent (rival companies)\n      if neigh('Alice','Frankie'): continue\n      # Bob not next to Ethan\n      if neigh('Bob','Ethan'): continue\n      # conditional: if Ethan across from Bob, then David two seats right of Alice\n      if (pos['Ethan']-pos['Bob'])%6==3 and pos['David']!=right:\n        continue\n      valid.append(pos)\n    pairs=set()\n    for pos in valid:\n      # Charlie's neighbors (unordered alphabetic pair)\n      n=[]\n      for p,q in itertools.combinations(people,2):\n        pass\n      # find adjacent to Charlie\n      for x in people:\n        if x=='Charlie': continue\n        if (pos[x]-pos['Charlie'])%6 in (1,5):\n          n.append(x)\n      if len(n)==2:\n        pairs.add(tuple(sorted(n)))\n    print('left',left,'right',right,'count',len(valid),'pairs',sorted(pairs))\nPY\ntrue", '; tmux wait -S done', 'Enter'] min_timeout_sec: 0.0 max_timeout_sec: inf
