[93.311456, "o", "path = sys.argv[1]\r\n\u001b[?2004l\r"]
[93.311527, "o", "\u001b[?2004h> "]
[93.315996, "o", "old_str = '<<<<<<< HEAD\\nI am a sixth PhD candidate at the [Paul G. Allen School of Computer Science & Engineering](https://www.cs.washington.edu/) at The University of Washington, where I am advised by [Tim Althoff](http://www.timalthoff.com/). I am affiliated with [UW NLP](https://twitter.com/uwnlp).\\n\\n Previously, I was a Student Researcher at [Google Research](https://research.google/), an ML Research Intern at [Apple Health AI](https://machinelearning.apple.com/work-with-us) and a data scientist and the second full-time employee at [HealthRhythms](https://www.healthrhythms.com).\\n=======\\nI am a Postdoctoral Researcher at Stanford CS.\\n\\nPreviously, I was a Student Researcher at [Google Research](https://research.google/), an ML Research Intern at [Apple Health AI](https://machinelearning.apple.com/work-with-us) and a data scientist and the second full-time employee at [HealthRhythms](https://www.healthrhythms.com).\\n>>>>>>> dc5cf1b (Move to Stanford)\\n'\r\n\u001b[?2004l\r"]
[93.3162, "o", "\u001b[?2004h> "]
[93.317306, "o", "new_str = 'I am a Postdoctoral Researcher at Stanford CS.\\n\\nPreviously, I was a Student Researcher at [Google Research](https://research.google/), an ML Research Intern at [Apple Health AI](https://machinelearning.apple.com/work-with-us) and a data scientist and the second full-time employee at [HealthRhythms](https://www.healthrhythms.com).\\n'\r\n\u001b[?2004l\r"]
[93.318171, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def normalize_text(text: str) -> str:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.318524, "o", "    text = text.replace('\\r\\n', '\\n').replace('\\r', '\\n')\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.318811, "o", "> "]
[93.319146, "o", "    return '\\n'.join(line.rstrip() for line in text.split('\\n'))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> try:\r\n\u001b[?2004l\r"]
[93.319257, "o", "\u001b[?2004h> "]
[93.319573, "o", "    with open(path, 'r', encoding='utf-8', errors='replace') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.319755, "o", "> "]
[93.319921, "o", "        content = f.read()\r\n\u001b[?2004l\r"]
[93.31997, "o", "\u001b[?2004h> "]
[93.320105, "o", "except FileNotFoundError:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.320434, "o", "    print(f\"错误: 找不到文件 {path}\")\r\n\u001b[?2004l\r"]
[93.320584, "o", "\u001b[?2004h> "]
[93.320756, "o", "    raise SystemExit(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.320859, "o", "except Exception as exc:\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.320932, "o", "> "]
[93.321079, "o", "    print(f\"修改失败: {exc}\")\r\n\u001b[?2004l\r"]
[93.321166, "o", "\u001b[?2004h> "]
[93.321287, "o", "    raise SystemExit(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.321378, "o", "> \r\n\u001b[?2004l\r"]
[93.321475, "o", "\u001b[?2004h> "]
[93.321599, "o", "content = normalize_text(content)\r\n\u001b[?2004l\r"]
[93.32166, "o", "\u001b[?2004h> "]
[93.32187, "o", "old_str = normalize_text(old_str)\r\n\u001b[?2004l\r"]
[93.321972, "o", "\u001b[?2004h> "]
[93.322136, "o", "new_str = normalize_text(new_str)\r\n\u001b[?2004l\r"]
[93.322211, "o", "\u001b[?2004h> "]
[93.322356, "o", "count = content.count(old_str)\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.322393, "o", "> "]
[93.322491, "o", "if count == 0:\r\n\u001b[?2004l\r"]
[93.322594, "o", "\u001b[?2004h> "]
[93.323465, "o", "    print(\"错误: 在文件中找不到 old_str。\\n建议：\\n1. 使用 read_file(raw_mode=True) 获取原始内容\\n2. 检查是否有多余的空格或换行符\\n3. 如果文件较大，考虑使用 write_full_file 全量覆盖\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.3236, "o", "> "]
[93.323712, "o", "    raise SystemExit(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.323875, "o", "if count > 1:\r\n\u001b[?2004l\r"]
[93.32395, "o", "\u001b[?2004h> "]
[93.325416, "o", "    print(f\"错误: 匹配到 {count} 处相同的代码，请提供更具体的 old_str 以确保唯一性。\")\r\n\u001b[?2004l\r"]
[93.325689, "o", "\u001b[?2004h> "]
[93.325895, "o", "    raise SystemExit(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.326104, "o", "with open(path, 'w', encoding='utf-8', newline='\\n') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.326355, "o", "    f.write(content.replace(old_str, new_str))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.326705, "o", "print(f\"成功: 已更新 {path}。修改已持久化。\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.326882, "o", "> "]
