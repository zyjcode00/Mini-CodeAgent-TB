[1081.208597, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/MdfLib/CMakeLists.txt <<'PY'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = 'cmake_minimum_required(VERSION 3.16)\\nproject(MdfLib LANGUAGES CXX)\\n\\nset(CMAKE_CXX_STANDARD 11)\\nset(CMAKE_CXX_STANDARD_REQUIRED ON)\\n\\nadd_library(mdflib STATIC\\n    MdfFormat.cpp\\n    stdafx.cpp\\n)\\ntarget_include_directories(mdflib PUBLIC ${CMAKE_CURRENT_SOURCE_DIR})\\ntarget_compile_definitions(mdflib PRIVATE _CRT_SECURE_NO_WARNINGS)\\n\\nadd_executable(mdf_converter converter.cpp)\\ntarget_link_libraries(mdf_converter PRIVATE mdflib)\\n\\ninclude(CTest)\\nif(BUILD_TESTING)\\n  add_test(NAME converter_smoke\\n    COMMAND mdf_converter\\n      ${CMAKE_CURRENT_SOURCE_DIR}/test_models/bunbun.mdf\\n      ${CMAKE_CURRENT_BINARY_DIR}/bunbun.json)\\nendif()\\n'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, 'w', encoding='utf-8', newline='\\n') as f:\n        f.write(content)\n    print(f\"成功: 已写入 {path}\")\nexcept Exception as exc:\n    print(f\"写入失败: {exc}\")\nPY\ntrue; tmux wait -S done\r"]
