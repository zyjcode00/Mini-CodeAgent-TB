[650.2243, "o", "\u001b[32m\u001b[K92\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t/// \u001b[01;31m\u001b[KSave\u001b[m\u001b[K MDF data to a file\r\n\u001b[32m\u001b[K97\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tbool \u001b[01;31m\u001b[KSave\u001b[m\u001b[KToFile(const char *szFilename) const;\r\n\u001b[32m\u001b[K209\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t/// \u001b[01;31m\u001b[KLoad\u001b[m\u001b[Ks an MDF from a given stream\r\n\u001b[32m\u001b[K214\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tbool \u001b[01;31m\u001b[KLoad\u001b[m\u001b[KFromStream(MdfStream &stream);\r\n"]
