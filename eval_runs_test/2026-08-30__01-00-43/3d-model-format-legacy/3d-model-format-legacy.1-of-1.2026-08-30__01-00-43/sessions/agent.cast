[664.480485, "o", "cd /app/MdfLib && grep -n \"GetMesh\\|GetAnimation\\|GetTexture\\|HasAnimations\\|HasMeshes\\|GetHeader\" MdfFormat.h\r\n\u001b[?2004l\r"]
[664.482359, "o", "\u001b[32m\u001b[K137\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tconst TMdfMesh & \u001b[01;31m\u001b[KGetMesh\u001b[m\u001b[K(MdfHandle hMeshId) const { return m_vpMeshes[hMeshId]; }\r\n\u001b[32m\u001b[K155\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tconst TMdfAnimation & \u001b[01;31m\u001b[KGetAnimation\u001b[m\u001b[K(MdfHandle hAnimId) const { return m_vpAnimations[hAnimId]; }\r\n"]
[664.482555, "o", "\u001b[32m\u001b[K163\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tMdfHandle \u001b[01;31m\u001b[KGetTexture\u001b[m\u001b[KId(MdfHandle hMeshId) const {\r\n\u001b[32m\u001b[K186\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tconst char * \u001b[01;31m\u001b[KGetTexture\u001b[m\u001b[KName(MdfHandle hTextureId) const { return m_vpTextures[hTextureId]; }\r\n\u001b[32m\u001b[K193\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tconst MdfHeader & \u001b[01;31m\u001b[KGetHeader\u001b[m\u001b[K() const { return m_tMdfHeader; }\r\n"]
[664.482722, "o", "\u001b[32m\u001b[K195\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tbool \u001b[01;31m\u001b[KHasAnimations\u001b[m\u001b[K() const {\r\n\u001b[32m\u001b[K199\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tbool \u001b[01;31m\u001b[KHasMeshes\u001b[m\u001b[K() const {\r\n"]
