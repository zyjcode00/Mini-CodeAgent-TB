[289.569557, "o", "nl -ba /app/MdfLib/MdfFormat.cpp | sed -n '520,640p'\r\n\u001b[?2004l\r"]
[289.571246, "o", "   520\t\r\n   521\t\t// check for textures and set their pointer\r\n   522\t\tif(m_tMdfHeader.nTextureCount > 0) {\r\n   523\t\t\tm_vpTextures = (char**)&m_pData[dataPos];\r\n   524\t\t\tdataPos += m_tMdfHeader.nTextureCount * sizeof(int);\r\n   525\t\t}\r\n   526\t\r\n   527\t\t// check for meshes and set their pointer\r\n   528\t\tif(m_tMdfHeader.nMeshCount > 0) {\r\n   529\t\t\tm_vpMeshes = (TMdfMesh*)&m_pData[dataPos];\r\n   530\t\t\tdataPos += m_tMdfHeader.nMeshCount * sizeof(TMdfMesh);\r\n   531\t\t}\r\n   532\t\r\n   533\t\t// check for animations and set their pointer\r\n   534\t\tif(m_tMdfHeader.nAnimCount > 0) {\r\n   535\t\t\tm_vpAnimations = (TMdfAnimation*)&m_pData[dataPos];\r\n   536\t\t}\r\n   537"]
[289.571424, "o", "\t\r\n   538\t\t//\r\n   539\t\t// for each texture, fix up the pointers\r\n   540\t\t//\r\n   541\t\tfor(size_t i = 0; i < m_tMdfHeader.nTextureCount; i++) {\r\n   542\t\t\tm_vpTextures[i] = (char*)(m_pData  + ((int)m_vpTextures[i]) - nHeaderLength);\r\n   543\t\t}\r\n   544\t\r\n   545\t\t//\r\n   546\t\t// for each mesh fix up the pointers\r\n   547\t\t"]
[289.571543, "o", "//\r\n   548\t\tfor(size_t i = 0; i < m_tMdfHeader.nMeshCount; i++) {\r\n   549\t\t\tm_vpMeshes[i].uVtxs.pVertices = m_pData + m_vpMeshes[i].uVtxs.nDataOffset - nHeaderLength;\r\n   550\t\t\tm_vpMeshes[i].uIdxs.pIndices = (unsigned short*)(m_pData + m_vpMeshes[i].uIdxs.nDataOffset - nHeaderLength);\r\n   551\t\t\t\r\n   552\t\t\tif(m_vpMeshes[i].nNumJoints > 0) {\r\n   553\t\t\t\tm_vpMeshes[i].uBnd.pBindMats = (TMdfMatrix4*)(m_pData + m_vpMeshes[i].uBnd.nDataOffset - nHeaderLength);\r\n   554\t\t\t\tm_vpMeshes[i].uPrnt.pParentInfo = (int*)(m_pData + m_vpMeshes[i].uPrnt.nDataOffset - nHeaderLength);\r\n   555\t\t\t} else {\r\n   556\t\t\t\tm_vpMeshes[i].uBnd.pBindMats = 0;\r\n   557\t\t\t\tm_vpMeshes[i].uPrnt.pParentInfo = 0;\r\n   558\t\t\t}\r\n   559\t\t\tdataPos += sizeof(TMdfMesh);\r\n   560\t\t}\r\n   561\t\r\n   562\t\t//\r\n   563\t\t// for each animation, fix up the pointers\r\n   564\t\t//\r\n   565\t\tfor(size_t i = 0; i < m_tMdfHeader.nAnimCount; i++) {\r\n   566\t\t\tm_vpAnimations[i].uTls.pTimeline = (TMdfTimeline*)(m_pData + m_vpAnimations[i].uTls.nDataOffset - nHeaderLength);\r\n   567\t\r\n   568\t\t\t// fix up the time-line pointers\r\n   569\t\t\tfor(int t = 0; t < m_vpAnimations[i].nNumTimelines; t++) {\r\n"]
[289.571679, "o", "   570\t\t\t\tm_vpAnimations[i].uTls.pTimeline[t].uKfs.pKeyframes = (TMdfKeyframe*)(m_pData + m_vpAnimations[i].uTls.pTimeline[t].uKfs.nDataOffset - nHeaderLength);\r\n   571\t\t\t}\r\n   572\t\t}\r\n   573\t\r\n   574\t\treturn true;\r\n   575\t}\r\n   576\t\r\n   577\tvoid MdfFormat::Destroy()\r\n   578\t{\r\n   579\t\t// clean up any additional memory and\r\n   580\t\t// reset all the internal state to default\r\n   581\t\r\n   582\t\tif(m_pData) {\r\n   583\t\t\tfree(m_pData);\r\n"]
