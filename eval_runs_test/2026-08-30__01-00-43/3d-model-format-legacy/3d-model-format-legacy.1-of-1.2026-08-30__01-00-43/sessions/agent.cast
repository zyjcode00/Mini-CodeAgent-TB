[364.846675, "o", "   659\t\tif(remainder) {\r\n   660\t\t\tremainder = m_tMdfHeader.nByteAlignment - remainder;\r\n   661\t\r\n   662\t\t\tint dummy = 0;\r\n   663\t\r\n   664\t\t\tfor(size_t i = 0; i < remainder; i++) {\r\n   665\t\t\t\tfwrite(&dummy, 1, 1, fp);\r\n   666\t\t\t}\r\n   667\t\t}\r\n   668\t}\r\n"]
