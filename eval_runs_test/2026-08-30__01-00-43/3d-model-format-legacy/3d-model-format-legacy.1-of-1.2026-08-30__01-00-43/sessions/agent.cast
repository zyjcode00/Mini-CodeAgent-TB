[352.813969, "o", "   270\t\t// copy index data\r\n   271\t\t//\r\n   272\t\tFullIndexList::const_iterator liIdx = newMesh.finalIndices.begin();\r\n   273\t\r\n   274\t\tint dstIdx = 0;\r\n   275\t\twhile(liIdx != newMesh.finalIndices.end()) {\r\n   276\t\t\tpMesh->uIdxs.pIndices[dstIdx] = *liIdx;\r\n   277\t\t\tdstIdx++;\r\n   278\t\t\tliIdx++;\r\n   279\t\t}\r\n   280\t\r\n   281\t\t//\r\n   282\t\t// copy bind-pose and hierarchy data if needed\r\n   283\t\t//\r\n"]
