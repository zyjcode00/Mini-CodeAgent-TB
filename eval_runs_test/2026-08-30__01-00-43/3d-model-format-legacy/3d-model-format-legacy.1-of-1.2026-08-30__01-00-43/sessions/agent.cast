[273.126738, "o", "   520\t\r\n   521\t\t// check for textures and set their pointer\r\n   522\t\tif(m_tMdfHeader.nTextureCount > 0) {\r\n   523\t\t\tm_vpTextures = (char**)&m_pData[dataPos];\r\n   524\t\t\tdataPos += m_tMdfHeader.nTextureCount * sizeof(int);\r\n"]
[273.126884, "o", "   525\t\t}\r\n   526\t\r\n   527\t\t// check for meshes and set their pointer\r\n   528\t\tif(m_tMdfHeader.nMeshCount > 0) {\r\n   529\t\t\tm_vpMeshes = (TMdfMesh*)&m_pData[dataPos];\r\n"]
[273.127004, "o", "   530\t\t\tdataPos += m_tMdfHeader.nMeshCount * sizeof(TMdfMesh);\r\n   531\t\t}\r\n   532\t\r\n   533\t\t// check for animations and set their pointer\r\n   534\t\tif(m_tMdfHeader.nAnimCount > 0) {\r\n   535\t\t\tm_vpAnimations = (TMdfAnimation*)&m_pData[dataPos];\r\n   536\t\t}\r\n   537\t\r\n   538\t\t//\r\n   539\t\t// for each texture, fix up the pointers\r\n   540\t\t//\r\n   541\t\tfor(size_t i = 0; i < m_tMdfHeader.nTextureCount; i++) {\r\n   542\t\t\tm_vpTextures[i] = (char*)(m_pData  + ((int)m_vpTextures[i]) - nHeaderLength);\r\n   543\t\t}\r\n   544\t\r\n   545\t\t//\r\n   546\t\t// for each mesh fix up the pointers\r\n   547\t\t//\r\n"]
[273.127172, "o", "   548\t\tfor(size_t i = 0; i < m_tMdfHeader.nMeshCount; i++) {\r\n   549\t\t\tm_vpMeshes[i].uVtxs.pVertices = m_pData + m_vpMeshes[i].uVtxs.nDataOffset - nHeaderLength;\r\n   550\t\t\tm_vpMeshes[i].uIdxs.pIndices = (unsigned short*)(m_pData + m_vpMeshes[i].uIdxs.nDataOffset - nHeaderLength);\r\n   551\t\t\t\r\n   552\t\t\tif(m_vpMeshes[i].nNumJoints > 0) {\r\n   553\t\t\t\tm_vpMeshes[i].uBnd.pBindMats = (TMdfMatrix4*)(m_pData + m_vpMeshes[i].uBnd.nDataOffset - nHeaderLength);\r\n   554\t\t\t\tm_vpMeshes[i].uPrnt.pParentInfo = (int*)(m_pData + m_vpMeshes[i].uPrnt.nDataOffset - nHeaderLength);\r\n   555\t\t\t} else {\r\n   556\t\t\t\tm_vpMeshes[i].uBnd.pBindMats = 0;\r\n   557\t\t\t\tm_vpMeshes[i].uPrnt.pParentInfo = 0;\r\n   558\t\t\t}\r\n   559\t\t\tdataPos += sizeof(TMdfMesh);\r\n   560\t\t}\r\n   561\t\r\n   562"]
[273.127296, "o", "\t\t//\r\n   563\t\t// for each animation, fix up the pointers\r\n   564\t\t//\r\n   565\t\tfor(size_t i = 0; i < m_tMdfHeader.nAnimCount; i++) {\r\n   566\t\t\tm_vpAnimations[i].uTls.pTimeline = (TMdfTimeline*)(m_pData + m_vpAnimations[i].uTls.nDataOffset - nHeaderLength);\r\n   567\t\r\n   568\t\t\t// fix up the time-line pointers\r\n   569\t\t\tfor(int t = 0; t < m_vpAnimations[i].nNumTimelines; t++) {\r\n   570\t\t\t\tm_vpAnimations[i].uTls.pTimeline[t].uKfs.pKeyframes = (TMdfKeyframe*)(m_pData + m_vpAnimations[i].uTls.pTimeline[t].uKfs.nDataOffset - nHeaderLength);\r\n   571\t\t\t}\r\n   572\t\t}\r\n   573"]
[273.127459, "o", "\t\r\n   574\t\treturn true;\r\n   575\t}\r\n   576\t\r\n   577\tvoid MdfFormat::Destroy()\r\n   578\t{\r\n   579\t\t// clean up any additional memory and\r\n   580\t\t// reset all the internal state to default\r\n   581\t\r\n   582\t\tif(m_pData) {\r\n   583\t\t\tfree(m_pData);\r\n   584\t\r\n   585\t\t} else {\r\n   586\t\t\t// release meshes\r\n   587\t\t\tfor(unsigned int i = 0; i < m_nMeshArrayLength; i++) {\r\n   588\t\t\t\tfree(m_vpMeshes[i].uVtxs.pVertices);\r\n   589\t\t\t\tfree(m_vpMeshes[i].uIdxs.pIndices);\r\n   590\t\t\t\tfree(m_vpMeshes[i].uBnd.pBindMats);\r\n   591\t\t\t\tfree(m_vpMeshes[i].uPrnt.pParentInfo);\r\n   592\t\t\t}\r\n   593\t\r\n   594\t\t\t// release animations\r\n   595\t\t\tfor(unsigned int i = 0; i < m_nAnimArrayLength; i++) {\r\n   596\t\r\n   597\t\t\t\t// release timelines\r\n   598\t\t\t\tfor(int t = 0; t < m_vpAnimations[i].nNumTimelines; t++) {\r\n   599\t\t\t\t\t// release keyframes\r\n   600\t\t\t\t\tfree(m_vpAnimations[i].uTls.pTimeline[t].uKfs.pKeyframes);\r\n   601\t\t\t\t}\r\n   602\t\t\t\tfree(m_vpAnimations[i].uTls.pTimeline);\r\n   603\t\r\n   604\t"]
[273.127629, "o", "\t\t}\r\n   605\t\r\n   606\t\t\tfree(m_vpMeshes);\r\n   607\t\t\tfree(m_vpAnimations);\r\n   608\t\r\n   609\t\t\t// release textures\r\n   610\t\t\tfor(unsigned i = 0; i < m_tMdfHeader.nTextureCount; i++) {\r\n   611\t\t\t\tfree(m_vpTextures[i]);\r\n   612\t\t\t}\r\n   613\t\t\tfree(m_vpTextures);\r\n   614\t\r\n   615\t\t} // if(m_pData)\r\n   616\t\r\n   617\t\tm_pData = 0;\r\n   618\t\tm_vpMeshes = 0;\r\n   619\t\tm_vpAnimations = 0;\r\n   620\t\r\n   621\t\tm_vpTextures = 0;\r\n   622\t\tm_tMdfHeader.nTextureCount = 0;\r\n   623\t\r\n   624\t\tm_nMeshArrayLength = 0;\r\n   625\t\tm_nAnimArrayLength = 0;\r\n   626\t\tZeroMemory(&m_tMdfHeader, sizeof(m_tMdfHeader));\r\n   627\t}\r\n   628\t\r\n   629\tMdfHandle MdfFormat::AddTexture(const char *szName)\r\n   630\t{\r\n   631\t\tsize_t nameLen = strlen(szName);\r\n   632\t\tsize_t insertIdx = 0;\r\n   633\t\r\n   634\t\r\n   635\t\tfor(insertIdx = 0; insertIdx < m_tMdfHeader.nTextureCount; insertIdx++) {\r\n   636\t\t\tif(!strcmp(m_vpTextures[insertIdx], szName)) {\r\n   637\t\t\t\treturn (MdfHandle)insertIdx;\r\n   638\t\t\t}\r\n   639\t\t}\r\n   640\t\r\n   641\t\tm_vpTextures = (char**)realloc(m_vpTextures, (insertIdx+1)*sizeof(char*) );\r\n   642\t\r\n   643\t\tm_vpTextures[insertIdx] = (char*)malloc(nameLen+1 * sizeof(char));\r\n   644\t\tstrcpy(m_vpTextures[insertIdx], szName);\r\n   645\t\tm_vpTextures[insertIdx][nameLen] = 0;\r\n   646\t\r\n   647\t\tm_tMdfHeader.nTextureCount++;\r\n   648\t\r\n   649\t\treturn (MdfHandle)insertIdx;\r\n   650\t}\r\n   651\t\r\n   652\tvoid MdfFormat::ByteAlignFile(FILE *fp) const\r\n   653\t{\r\n   654\t\tif(!m_tMdfHeader.nByteAlignment) {\r\n   655\t\t\treturn;\r\n   656\t\t}\r\n   657\t"]
[273.12779, "o", "\r\n   658\t\tsize_t remainder = ftell(fp) % m_tMdfHeader.nByteAlignment;\r\n   659\t\tif(remainder) {\r\n   660\t\t\tremainder = m_tMdfHeader.nByteAlignment - remainder;\r\n   661\t\r\n   662\t\t\tint dummy = 0;\r\n   663\t\r\n   664\t\t\tfor(size_t i = 0; i < remainder; i++) {\r\n   665\t\t\t\tfwrite(&dummy, 1, 1, fp);\r\n   666\t\t\t}\r\n   667\t\t}\r\n   668\t}\r\n"]
