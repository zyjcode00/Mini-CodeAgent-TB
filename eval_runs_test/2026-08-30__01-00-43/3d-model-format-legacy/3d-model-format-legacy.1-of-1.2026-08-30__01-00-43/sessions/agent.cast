[289.572088, "o", "free(m_vpAnimations[i].uTls.pTimeline[t].uKfs.pKeyframes);\r\n   601\t\t\t\t}\r\n   602\t\t\t\tfree(m_vpAnimations[i].uTls.pTimeline);\r\n   603\t\r\n   604\t\t\t}\r\n   605\t\r\n   606\t\t\tfree(m_vpMeshes);\r\n   607\t\t\tfree(m_vpAnimations);\r\n   608\t\r\n   609\t\t\t// release textures\r\n   610\t\t\tfor(unsigned i = 0; i < m_tMdfHeader.nTextureCount; i++) {\r\n   611\t\t\t\tfree(m_vpTextures[i]);\r\n   612\t\t\t}\r\n   613\t\t\tfree(m_vpTextures);\r\n   614\t\r\n   615\t\t} // if(m_pData)\r\n   616\t\r\n   617\t\tm_pData = 0;\r\n   618\t\tm_vpMeshes = 0;\r\n   619\t\tm_vpAnimations = 0;\r\n   620\t\r\n   621\t\tm_vpTextures = 0;\r\n   622\t\tm_tMdfHeader.nTextureCount = 0;\r\n   623\t\r\n   624\t\tm_nMeshArrayLength = 0;\r\n   625\t\tm_nAnimArrayLength = 0;\r\n   626\t\tZeroMemory(&m_tMdfHeader, sizeof(m_tMdfHeader));\r\n   627\t}\r\n   628\t\r\n   629\tMdfHandle MdfFormat::AddTexture(const char *szName)\r\n"]
