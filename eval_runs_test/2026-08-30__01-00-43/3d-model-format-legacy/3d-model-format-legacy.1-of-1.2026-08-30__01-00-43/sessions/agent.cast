[364.846241, "o", "   629\tMdfHandle MdfFormat::AddTexture(const char *szName)\r\n   630\t{\r\n   631\t\tsize_t nameLen = strlen(szName);\r\n   632\t\tsize_t insertIdx = 0;\r\n   633\t\r\n   634\t\r\n   635\t\tfor(insertIdx = 0; insertIdx < m_tMdfHeader.nTextureCount; insertIdx++) {\r\n   636\t\t\tif(!strcmp(m_vpTextures[insertIdx], szName)) {\r\n   637\t\t\t\treturn (MdfHandle)insertIdx;\r\n   638\t\t\t}\r\n   639\t\t}\r\n   640\t\r\n   641\t\tm_vpTextures = (char**)realloc(m_vpTextures, (insertIdx+1)*sizeof(char*) );\r\n   642\t\r\n   643\t\tm_vpTextures[insertIdx] = (char*)malloc(nameLen+1 * sizeof(char));\r\n   644\t\tstrcpy(m_vpTextures[insertIdx], szName);\r\n   645\t\tm_vpTextures[insertIdx][nameLen] = 0;\r\n   646\t\r\n"]
