[352.813241, "o", "   177\t\tTMdfMesh *pMesh = 0;\r\n   178\t\tunsigned int nMesh = 0;\r\n   179\t\r\n   180\t\t// reallocate mesh pointer array if needed\r\n   181\t\tif((m_tMdfHeader.nMeshCount + 1) > m_nMeshArrayLength) {\r\n   182\t\r\n   183\t\t\tm_vpMeshes = (TMdfMesh*)realloc(m_vpMeshes, (m_tMdfHeader.nMeshCount+1)*sizeof(TMdfMesh));\r\n   184\t\t\tm_nMeshArrayLength++;\r\n   185\t\t}\r\n   186\t\r\n   187\t\t// allocate new mesh, set up variables\r\n   188\t\tnMesh = m_tMdfHeader.nMeshCount;\r\n   189\t\tpMesh = &m_vpMeshes[nMesh];\r\n   190\t\tm_tMdfHeader.nMeshCount++;\r\n   191\t\tZeroMemory(pMesh, sizeof(TMdfMesh));\r\n   192\t\r\n   193\t\tif(newMesh.numBindPoseElements > 0 && newMesh.parentInfo) {\r\n   194\t\t\tpMesh->meshType = TMdfMesh::MESH_SKINNED;\r\n   195\t\t} else {\r\n   196\t\t\tpMesh->meshType = TMdfMesh::MESH_STATIC;\r\n   197\t\t}\r\n   198\t\r\n   199\t\tsize_t numVerts = newMesh.finalVerts.size();\r\n   200\t\tsize_t numInds = newMesh.finalIndices.size();\r\n   201\t\r\n   202\t\t// set up the mesh structure\r\n   203\t\tpMesh->nNumVerts = (unsigned int)newMesh.finalVerts.size();\r\n   204\t\tpMesh->nNumIndices = (unsigned int)newMesh.finalIndices.size();\r\n   205\t\r\n   206\t\t// allocate vertices and indices\r\n   207\t\t\r\n   208\t\tif(pMesh->meshType == TMdfMesh::MESH_SKINNED) {\r\n   209\t\t\tpMesh->uVtxs.pVertices = malloc(sizeof(TMdfVertSkn) * pMesh->nNumVerts);\r\n   210\t\t} else {\r\n   211\t\t\tpMesh->uVtxs.pVertices = malloc(sizeof(TMdfVertSta) * pMesh->nNumVerts);\r\n   212\t\t}\r\n   213\t\r\n"]
[352.81339, "o", "   214\t\r\n   215\t\tpMesh->uIdxs.pIndices = (unsigned short*)malloc(sizeof(unsigned short) * pMesh->nNumIndices);\r\n   216\t\r\n   217\t\t//\r\n   218\t\t// copy vertex data\r\n   219\t\t//\r\n   220\t\tFullVertList::const_iterator li = newMesh.finalVerts.begin();\r\n   221\t\tint i = 0;\r\n   222\t\tif(pMesh->meshType == TMdfMesh::MESH_SKINNED) {\r\n   223\t\t\tTMdfVertSkn *v;\r\n   224\t\t\twhile (li != newMesh.finalVerts.end()) {\r\n   225\t\t\t\t v = &((TMdfVertSkn*)pMesh->uVtxs.pVertices)[i];\r\n   226\t\r\n   227\t\t\t\tv->pos.x = li->pos[0];\r\n   228\t\t\t\tv->pos.y = li->pos[1];\r\n   229\t\t\t\tv->pos.z = li->pos[2];\r\n   230\t\r\n   231\t\t\t\tv->weights[0] = li->weights[0];\r\n   232\t\t\t\tv->weights[1] = li->weights[1];\r\n   233\t\t\t\tv->weights[2] = li->weights[2];\r\n   234\t\r\n   235\t\t\t\tv->bones[0] = li->bones[0];\r\n   236\t\t\t\tv->bones[1] = li->bones[1];\r\n   237\t\t\t\tv->bones[2] = li->bones[2];\r\n   238\t\t\t\tv->bones[3] = li->bones[3];\r\n   239\t\t\t\t\r\n   240\t\t\t\tv->normal.x = li->normal[0];\r\n"]
