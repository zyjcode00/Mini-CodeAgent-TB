[727.482957, "o", "#pragma once\r\n\r\nunion Float2 {\r\n\tstruct {\r\n\t\tfloat x, y;\r\n\t};\r\n\r\n\tstruct {\r\n"]
[727.483125, "o", "\t\tfloat u, v;\r\n\t};\r\n\r\n\tfloat & operator[] (int idx) { return element[idx]; }\r\n\r\nprivate:\r\n\tfloat element[2];\r\n};\r\n\r\nunion Float3 {\r\n\tstruct {\r\n\t\tfloat x, y, z;\r\n\t};\r\n\r\n\tstruct {\r\n\t\tfloat r, g, b;\r\n\t};\r\n\r\n\tfloat & operator[] (int idx) { return element[idx]; }\r\n\r\nprivate:\r\n\tfloat element[3];\r\n};\r\n\r\nunion Float4 {\r\n\tstruct {\r\n\t\tfloat x, y, z, w;\r\n\t};\r\n\r\n\tstruct {\r\n\t\tfloat r, g, b, a;\r\n\t};\r\n\r\n\tfloat & operator[] (int idx) { return element[idx]; }\r\n\r\n"]
[727.483265, "o", "private:\r\n\tfloat element[4];\r\n};\r\n\r\ntypedef unsigned char Byte;"]
