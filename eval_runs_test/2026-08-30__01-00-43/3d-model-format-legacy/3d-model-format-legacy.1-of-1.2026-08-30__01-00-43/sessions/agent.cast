[289.425894, "o", "nl -ba /app/MdfLib/MdfFormat.h | sed -n '1,220p'\r\n\u001b[?2004l\r"]
[289.427338, "o", "     1\t\r\n     2\t#pragma once\r\n     3\t\r\n     4\t#include \"mdftypes.h\"\r\n     5\t\r\n     6\t#define MDF_BYTE_ALIGNMENT 16\r\n     7\t\r\n     8\tclass MdfStream;\r\n     9\t\r\n    10\tclass MdfFormat\r\n    11\t{\r\n    12\t\tenum MdfElements {\r\n    13\t\t\tMDF_NONE\t\t=\t0,\r\n    14\t\t\tMDF_MESHES\t\t=\t1,\r\n    15\t\t\tMDF_TEXTURES\t=\t2,\r\n    16\t\t\tMDF_BINDMATS\t=\t4,\r\n    17\t\t\tMDF_PARENTINFO\t=\t8,\r\n    18\t\t\tMDF_ANIMATIONS\t=\t16,\r\n    19\t\t\tMDF_TRANSFORMS\t=\t32,\r\n    20\t\t\tMDF_ALL\t\t\t= (MDF_MESHES|MDF_TEXTURES|MDF_BINDMATS|MDF_PARENTINFO|MDF_ANIMATIONS|MDF_TRANSFORMS)\r\n    21\t\t};\r\n    22\t\r\n    23\t\t/************************************************************************/\r\n    24\t\t/* DATA MEMBERS                                                         */\r\n    25\t\t/************************************************************************/\r\n    26\tprotected:\r\n    27\t\tsize_t m_nDataSize;\t\t\t\t\t"]
[289.427505, "o", "///< Size of the memory pool\r\n    28\t\tByte *m_pData;\t\t\t\t\t\t///< Memory pool for this MDF\r\n    29\t\r\n    30\t\r\n    31\t\tTMdfMesh *m_vpMeshes;\t\t\t\t///< All the meshes in the file\r\n    32\t\tunsigned int m_nMeshArrayLength;\t///< Length of the meshes array\r\n    33\t\r\n    34\t\tTMdfAnimation *m_vpAnimations;\t\t///< All the animations in the file\r\n    35\t\tunsigned int m_nAnimArrayLength;\t///< Size of the animations array\r\n    36\t\r\n    37\t\tchar **m_vpTextures;\t\t\t\t///< Array of texture strings\r\n    38"]
[289.427644, "o", "\t\r\n    39\t\tmutable MdfHeader m_tMdfHeader;\t\t\t\t///< Master MDF header\r\n    40\t\r\n    41\t\r\n    42\t\t/************************************************************************/\r\n    43\t\t/* CONSTRUCTION                                                         */\r\n    44\t\t/************************************************************************/\r\n    45\tpublic:\r\n    46\t\tMdfFormat(void);\r\n    47\tpublic:\r\n    48\t\tvirtual ~MdfFormat(void);\r\n    49\t\r\n    50\t\t/************************************************************************/\r\n    51\t\t/* CLASS METHODS                                                        */\r\n    52\t\t/************************************************************************/\r\n    53\tpublic:\r\n    54\t\t//////////////////////////////////////////////////////////////////////////\r\n    55\t\t/// Create a new MDF file\r\n"]
[289.427837, "o", "    56\t\t///\r\n    57\t\t/// \\param nNumMeshesHint - number of meshes this file might store\r\n    58\t\t/// \\return true if successful\r\n    59\t\t///\r\n    60\t\t/// \\remarks To recreate a new MDF on the same object, Destroy() must\r\n    61\t\t///\t\t\t be called first\r\n    62\t\t//////////////////////////////////////////////////////////////////////////\r\n    63\t\tbool Create(unsigned int nNumMeshesHint=0);\r\n"]
[289.428038, "o", "    64\t\r\n    65\t\t//////////////////////////////////////////////////////////////////////////\r\n    66\t\t/// Create a new MDF by loading its data from a file\r\n    67\t\t///\r\n    68\t\t/// \\param szFilename - the path of the file to load\r\n    69\t\t/// \\return true if successful\r\n    70\t\t//////////////////////////////////////////////////////////////////////////\r\n    71\t\tbool CreateFromFile(const char *szFilename);\r\n    72\t\r\n    73\t\t//////////////////////////////////////////////////////////////////////////\r\n    74\t\t/// Create a new MDF from raw MDF data in memory\r\n    75\t\t///\r\n    76\t\t/// \\param pData - location of the raw MDF data to load\r\n    77\t"]
[289.428154, "o", "\t/// \\param nDataSize - size of the data buffer in bytes\r\n    78\t\t/// \\return true if successful\r\n    79\t\t//////////////////////////////////////////////////////////////////////////\r\n    80\t\tbool CreateFromFileInMemory(Byte *pData, size_t nDataSize);\r\n    81\t\t\r\n    82\t\t//////////////////////////////////////////////////////////////////////////\r\n    83\t\t/// Destroy the MDF and free all the memory\r\n    84\t\t///\r\n    85\t\t/// \\remarks Once destroyed, this object is available for any of the\r\n    86\t\t///\t\t\t Create* calls to create a new MDF\r\n    87\t\t///\r\n    88\t\t//////////////////////////////////////////////////////////////////////////\r\n    89\t\tvoid Destroy();\r\n    90\t\r\n    91\t\t//////////////////////////////////////////////////////////////////////////\r\n    92\t\t/// Save MDF data to a file\r\n    93\t\t///\r\n    94\t\t/// \\param szFilename - path of the file to save to\r\n    95\t\t/// \\return true if successful\r\n    96\t\t//////////////////////////////////////////////////////////////////////////\r\n    97\t\tbool SaveToFile(const char *szFilename) const;\r\n    98\t\r\n    99\t\r\n"]
[289.428303, "o", "   100\t\t//////////////////////////////////////////////////////////////////////////\r\n   101\t\t/// Add a new mesh to this MDF\r\n   102\t\t///\r\n   103\t\t/// \\param newMesh - mesh information to add\r\n   104\t\t/// \\return index of the newly-added mesh\r\n   105\t\t//////////////////////////////////////////////////////////////////////////\r\n"]
[289.4284, "o", "   106\t\tMdfHandle AddMesh(const MdfFullMesh &newMesh);\r\n   107\t\r\n   108\t\t//////////////////////////////////////////////////////////////////////////\r\n   109\t\t/// Add a new animation to this MDF\r\n   110\t\t///\r\n   111\t\t/// \\param newAnimation - animation information to add\r\n"]
[289.428598, "o", "   112\t\t/// \\return index of the newly-added animation\r\n   113\t\t//////////////////////////////////////////////////////////////////////////\r\n   114\t\tMdfHandle AddAnimation(const MdfFullAnimation &newAnimation);\r\n   115\t\r\n   116\t\t/************************************************************************/\r\n   117\t\t/* ACCESSORS                                                            */\r\n   118\t\t/************************************************************************/\r\n"]
[289.428749, "o", "   119\tpublic:\r\n   120\t\r\n   121\t\t//////////////////////////////////////////////////////////////////////////\r\n   122\t\t/// Get the number of meshes that are stored in this MDF\r\n   123\t\t///\r\n   124\t\t/// \\return total number of meshes\r\n   125\t\t//////////////////////////////////////////////////////////////////////////\r\n   126\t\tunsigned int GetNumMeshes() const { return m_tMdfHeader.nMeshCount; }\r\n   127\t\t\r\n   128\t\t//////////////////////////////////////////////////////////////////////////\r\n   129\t\t/// Obtain a read-only mesh object given by the index\r\n   130\t\t///\r\n   131\t\t/// \\param hMeshId index of the mesh object to obtain\r\n   132\t\t/// \\return Mesh object of the given index\r\n   133\t\t///\r\n   134\t\t/// \\warning Invalid indexes are not checked, use GetNumMeshes() to find\r\n   135"]
[289.428874, "o", "\t\t///\t\t\t the maximum index\r\n   136\t\t//////////////////////////////////////////////////////////////////////////\r\n   137\t\tconst TMdfMesh & GetMesh(MdfHandle hMeshId) const { return m_vpMeshes[hMeshId]; }\r\n   138\t\r\n   139\t\t//////////////////////////////////////////////////////////////////////////\r\n   140\t\t/// Get number of animations that are stored in this MDF\r\n   141\t\t///\r\n   142\t\t/// \\return number of animations in this MDF\r\n   143\t\t//////////////////////////////////////////////////////////////////////////\r\n   144\t\tunsigned int GetNumAnimations() const { return m_tMdfHeader.nAnimCount; }\r\n   145\t\r\n   146\t"]
[289.428997, "o", "\t//////////////////////////////////////////////////////////////////////////\r\n   147\t\t/// Obtain a read-only animation object given by the index\r\n   148\t\t///\r\n   149\t\t/// \\param hAnimId - animation index\r\n   150\t\t/// \\return Mesh animation of the given index\r\n   151\t\t///\r\n   152\t\t/// \\warning Invalid indexes are not checked, use GetNumAnimations() to find\r\n"]
[289.429202, "o", "   153\t\t///\t\t\t the maximum index\r\n   154\t\t//////////////////////////////////////////////////////////////////////////\r\n   155\t\tconst TMdfAnimation & GetAnimation(MdfHandle hAnimId) const { return m_vpAnimations[hAnimId]; }\r\n   156\t\r\n   157\t\t//////////////////////////////////////////////////////////////////////////\r\n   158\t\t/// Get texture that is assigned to the given mesh\r\n   159\t\t///\r\n   160\t\t/// \\param hMeshId - index of the mesh\r\n   161\t\t/// \\return index of the texture\r\n   162\t\t//////////////////////////////////////////////////////////////////////////\r\n   163\t\tMdfHandle GetTextureId(MdfHandle hMeshId) const {\r\n   164\t\t\treturn m_vpMeshes[hMeshId].hTexture;\r\n   165\t\t}\r\n   166\t\r\n   167\t\t//////////////////////////////////////////////////////////////////////////\r\n   168\t\t/// Get the number of texture names that are stored in this MDF\r\n   169"]
[289.429351, "o", "\t\t///\r\n   170\t\t/// \\return total number of texture names\r\n   171\t\t//////////////////////////////////////////////////////////////////////////\r\n   172\t\tunsigned int GetNumTextures() const { return m_tMdfHeader.nTextureCount; }\r\n   173\t\r\n   174\t\t//////////////////////////////////////////////////////////////////////////\r\n   175\t\t/// Get texture name from the specified texture index value\r\n   176\t\t///\r\n   177\t\t/// \\param hTextureId - texture index\r\n   178\t\t/// \\return name of the texture\r\n   179\t\t///\r\n   180\t\t/// \\warning The string memory is maintained by the MDF object.\r\n   181\t\t///\t\t\t Always use deep-copying if you want to store the \r\n   182\t\t///\t\t\t string elsewhere.\r\n   183\t\t///\t\t\t The string is destroyed when this MDF is destroyed.\r\n   184\t\t///\r\n   185\t\t//////////////////////////////////////////////////////////////////////////\r\n   186\t\tconst char * GetTextureName(MdfHandle hTextureId) const { return m_vpTextures[hTextureId]; }\r\n   187\t\t\r\n   188\t\t//////////////////////////////////////////////////////////////////////////\r\n   189\t\t/// Get the header of this MDF\r\n   190"]
[289.429466, "o", "\t\t///\r\n   191\t\t/// \\return the header of this MDF\r\n   192\t\t//////////////////////////////////////////////////////////////////////////\r\n   193\t\tconst MdfHeader & GetHeader() const { return m_tMdfHeader; }\r\n   194\t\r\n   195\t\tbool HasAnimations() const {\r\n   196\t\t\treturn(m_vpAnimations != 0);\r\n   197\t\t}\r\n   198\t\r\n   199\t\tbool HasMeshes() const {\r\n   200\t\t\treturn(m_vpMeshes != 0);\r\n   201\t\t}\r\n   202\t\r\n   203\t\t/************************************************************************/\r\n   204\t\t/* PRIVATE METHODS                                                      */\r\n   205\t\t/************************************************************************/\r\n   206\tprotected:\r\n   207\t\r\n   208\t\t//////////////////////////////////////////////////////////////////////////\r\n   209\t\t/// Loads an MDF from a given stream\r\n   210\t\t///\r\n   211\t\t/// \\param stream - the stream to load from\r\n   212\t\t/// \\return true if successful\r\n   213\t\t//////////////////////////////////////////////////////////////////////////\r\n   214\t\tbool LoadFromStream(MdfStream &stream);\r\n   215\t\r\n   216\t\t//////////////////////////////////////////////////////////////////////////\r\n"]
[289.429634, "o", "   217\t\t/// Add a texture name to this MDF\r\n   218\t\t///\r\n   219\t\t/// \\remarks Adding duplicate names will waste memory. It is up to the\r\n   220\t\t///\t\t\t caller to ensure that no duplicate texture names are added.\r\n"]
