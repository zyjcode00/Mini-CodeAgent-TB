[57.473465, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\nif [ -f /app/MdfLib/mdftypes.h ]; then cat -- /app/MdfLib/mdftypes.h; else echo '错误: 找不到文件 /app/MdfLib/mdftypes.h'; fi\ntrue; tmux wait -S done\r"]
