[1189.162231, "o", "cmake_minimum_required(VERSION 3.16)\r\nproject(MdfLib LANGUAGES CXX)\r\n\r\nset(CMAKE_CXX_STANDARD 11)\r\nset(CMAKE_CXX_STANDARD_REQUIRED ON)\r\n\r\nadd_library(mdflib STATIC\r\n    MdfFormat.cpp\r\n    stdafx.cpp\r\n)\r\ntarget_include_directories(mdflib PUBLIC ${CMAKE_CURRENT_SOURCE_DIR})\r\ntarget_compile_definitions(mdflib PRIVATE _CRT_SECURE_NO_WARNINGS)\r\n\r\nadd_executable(mdf_converter converter.cpp)\r\ntarget_link_libraries(mdf_converter PRIVATE mdflib)\r\n\r\ninclude(CTest)\r\nif(BUILD_TESTING)\r\n  add_test(NAME converter_smoke\r\n    COMMAND mdf_converter\r\n      ${CMAKE_CURRENT_SOURCE_DIR}/test_models/bunbun.md\r\n      ${CMAKE_CURRENT_BINARY_DIR}/bunbun.json)\r\nendif()\r\n"]
