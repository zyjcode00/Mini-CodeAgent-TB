[339.04291, "o", "\u001b[01;31m\u001b[KZeroMemory\u001b[m\u001b[K(pMesh, sizeof(TMdfMesh));\r\n\u001b[35m\u001b[K/app/MdfLib/MdfFormat.cpp\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K209\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tpMesh->uVtxs.pVertices = \u001b[01;31m\u001b[Kmalloc\u001b[m\u001b[K(sizeof(TMdfVertSkn) * pMesh->nNumVerts);\r\n\u001b[35m\u001b[K/app/MdfLib/MdfFormat.cpp\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K211\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tpMesh->uVtxs.pVertices = \u001b[01;31m\u001b[Kmalloc\u001b[m\u001b[K(sizeof(TMdfVertSta) * pMesh->nNumVerts);\r\n\u001b[35m\u001b[K/app/MdfLib/MdfFormat.cpp\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K215\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tpMesh->uIdxs.pIndices = (unsigned short*)\u001b[01;31m\u001b[Kmalloc\u001b[m\u001b[K(sizeof(unsigned short) * pMesh->nNumIndices);\r\n\u001b[35m\u001b[K/app/MdfLib/MdfFormat.cpp\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K285\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tpMesh->uBnd.pBindMats = (TMdfMatrix4 *)\u001b[01;31m\u001b[Kmalloc\u001b[m\u001b[K(newMesh.numBindPoseElements * sizeof(TMdfMatrix4));\r\n\u001b[35m\u001b[K/app/MdfLib/MdfFormat.cpp\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K293\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tpMesh->uPrnt.pParentInfo = (int *)\u001b[01;31m\u001b[Kmalloc\u001b[m\u001b[K(newMesh.numBindPoseElements * sizeof(int));\r\n"]
[339.043104, "o", "\u001b[35m\u001b[K/app/MdfLib/MdfFormat.cpp\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K325\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KZeroMemory\u001b[m\u001b[K(pAnim, sizeof(TMdfAnimation));\r\n\u001b[35m\u001b[K/app/MdfLib/MdfFormat.cpp\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K334\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tpAnim->uTls.pTimeline = (TMdfTimeline*)\u001b[01;31m\u001b[Kmalloc\u001b[m\u001b[K(pAnim->nNumTimelines * sizeof(TMdfTimeline));\r\n\u001b[35m\u001b[K/app/MdfLib/MdfFormat.cpp\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K336\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KZeroMemory\u001b[m\u001b[K(pAnim->uTls.pTimeline, pAnim->nNumTimelines * sizeof(TMdfTimeline));\r\n\u001b[35m\u001b[K/app/MdfLib/MdfFormat.cpp\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K343\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tpTimeline->uKfs.pKeyframes = (TMdfKeyframe*)\u001b[01;31m\u001b[Kmalloc\u001b[m\u001b[K(pTimeline->nKeyFrames * sizeof(TMdfKeyframe));\r\n\u001b[35m\u001b[K/app/MdfLib/MdfFormat.cpp\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K390\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tTMdfMesh *pHeaderMeshes = (TMdfMesh*)\u001b[01;31m\u001b[Kmalloc\u001b[m\u001b[K(sizeof(TMdfMesh) * m_tMdfHeader.nMeshCount);\r\n\u001b[35m\u001b[K/app/MdfLib/MdfFormat.cpp\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K391\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tTMdfAnimation *pHeaderAnims = (TMdfAnimation*)\u001b[01;31m\u001b[Kmalloc\u001b[m\u001b[K(sizeof(TMdfAnimation) * m_tMdfHeader.nAnimCount);\r\n\u001b[35m\u001b[K/app/MdfLib/MdfFormat.cpp\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K402\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tint *pHeaderTextures = (int*)\u001b[01;31m\u001b[Kmalloc\u001b[m\u001b[K(m_tMdfHeader.nTextureCount * sizeof(int));\r\n\u001b[35m\u001b[K/app/MdfLib/MdfFormat.cpp\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K456\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\tTMdfTimeline *pHeaderTimelines = (TMdfTimeline *)\u001b[01;31m\u001b[Kmalloc\u001b[m\u001b[K(pAnim->nNumTimelines * sizeof(TMdfTimeline));\r\n\u001b[35m\u001b[K/app/MdfLib/MdfFormat.cpp\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K474\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kfree\u001b[m\u001b[K(pHeaderTimelines);\r\n\u001b[35m\u001b[K/app/MdfLib/MdfFormat.cpp\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K498\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kfree\u001b[m\u001b[K(pHeaderMeshes);\r\n\u001b[35m\u001b[K/app/MdfLib/MdfFormat.cpp\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K499\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kfree\u001b[m\u001b[K(pHeaderAnims);\r\n\u001b[35m\u001b[K/app/MdfLib/MdfFormat.cpp\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K500\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kfree\u001b[m\u001b[K(pHeaderTextures);\r\n\u001b[35m\u001b[K/app/MdfLib/MdfFormat.cpp\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K516\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tm_pData = (Byte*)\u001b[01;31m\u001b[Kmalloc\u001b[m\u001b[K(m_nDataSize);\r\n\u001b[35m\u001b[K/app/MdfLib/MdfFormat.cpp\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K583\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kfree\u001b[m\u001b[K(m_pData);\r\n\u001b[35m\u001b[K/app/MdfLib/MdfFormat.cpp\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K588\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[Kfree\u001b[m\u001b[K(m_vpMeshes[i].uVtxs.pVertices);\r\n\u001b[35m\u001b[K/app/MdfLib/MdfFormat.cpp\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K589\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[Kfree\u001b[m\u001b[K(m_vpMeshes[i].uIdxs.pIndices);\r\n\u001b[35m\u001b[K/app/MdfLib/MdfFormat.cpp\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K590\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[Kfree\u001b[m\u001b[K(m_vpMeshes[i].uBnd.pBindMats);\r\n\u001b[35m\u001b[K/app/MdfLib/MdfFormat.cpp\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K591\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[Kfree\u001b[m\u001b[K(m_vpMeshes[i].uPrnt.pParentInfo);\r\n\u001b[35m\u001b[K/app/MdfLib/MdfFormat.cpp\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K600\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\t\u001b[01;31m\u001b[Kfree\u001b[m\u001b[K(m_vpAnimations[i].uTls.pTimeline[t].uKfs.pKeyframes);\r\n\u001b[35m\u001b[K/app/MdfLib/MdfFormat.cpp\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K602\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[Kfree\u001b[m\u001b[K(m_vpAnimations[i].uTls.pTimeline);\r\n\u001b[35m\u001b[K/app/MdfLib/MdfFormat.cpp\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K606\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kfree\u001b[m\u001b[K(m_vpMeshes);\r\n\u001b[35m\u001b[K/app/MdfLib/MdfFormat.cpp\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K607\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\u001b[01;31m\u001b[Kfree\u001b[m\u001b[K(m_vpAnimations);\r\n\u001b[35m\u001b[K/app/MdfLib/MdfFormat.cpp\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K611\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\u001b[01;31m\u001b[Kfree\u001b[m\u001b[K(m_vpTextures[i]);\r\n\u001b[35m\u001b[K/app/MdfLib/MdfFormat.cpp\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K613\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K"]
[339.043304, "o", "\t\t\u001b[01;31m\u001b[Kfree\u001b[m\u001b[K(m_vpTextures);\r\n\u001b[35m\u001b[K/app/MdfLib/MdfFormat.cpp\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K626\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KZeroMemory\u001b[m\u001b[K(&m_tMdfHeader, sizeof(m_tMdfHeader));\r\n\u001b[35m\u001b[K/app/MdfLib/MdfFormat.cpp\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K643\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tm_vpTextures[insertIdx] = (char*)\u001b[01;31m\u001b[Kmalloc\u001b[m\u001b[K(nameLen+1 * sizeof(char));\r\n\u001b[35m\u001b[K/app/MdfLib/MdfFormat.cpp\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K644\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kstrcpy\u001b[m\u001b[K(m_vpTextures[insertIdx], szName);\r\n\u001b[35m\u001b[K/app/MdfLib/MdfFormat.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K83\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t/// Destroy the MDF and \u001b[01;31m\u001b[Kfree\u001b[m\u001b[K all the memory\r\n"]
[339.043459, "o", "\u001b[35m\u001b[K/app/MdfLib/MdfLib_2005.vcproj\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K159\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tRelativePath=\".\\\u001b[01;31m\u001b[Kstdafx\u001b[m\u001b[K.cpp\"\r\r\n\u001b[35m\u001b[K/app/MdfLib/MdfLib_2005.vcproj\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K193\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tRelativePath=\".\\\u001b[01;31m\u001b[Kstdafx\u001b[m\u001b[K.h\"\r\r\n"]
[339.04354, "o", "\u001b[35m\u001b[K/app/MdfLib/stdafx.cpp\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K1\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K// \u001b[01;31m\u001b[Kstdafx\u001b[m\u001b[K.cpp : source file that includes just the standard includes\r\n\u001b[35m\u001b[K/app/MdfLib/stdafx.cpp\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K3\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K// \u001b[01;31m\u001b[Kstdafx\u001b[m\u001b[K.obj will contain the pre-compiled type information\r\n\u001b[35m\u001b[K/app/MdfLib/stdafx.cpp\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K5\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K#include \"\u001b[01;31m\u001b[Kstdafx\u001b[m\u001b[K.h\"\r\n\u001b[35m\u001b[K/app/MdfLib/MdfLib.vcproj\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K106\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tRelativePath=\".\\\u001b[01;31m\u001b[Kstdafx\u001b[m\u001b[K.cpp\">\r\r\n\u001b[35m\u001b[K/app/MdfLib/MdfLib.vcproj\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K132\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\t\t\tRelativePath=\".\\\u001b[01;31m\u001b[Kstdafx\u001b[m\u001b[K.h\">\r\r\n"]
