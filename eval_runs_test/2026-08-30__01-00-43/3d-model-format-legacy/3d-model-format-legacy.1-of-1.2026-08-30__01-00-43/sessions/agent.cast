[664.744185, "o", "\u001b[32m\u001b[K201\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kstruct TMdfMesh\u001b[m\u001b[K\r\n\u001b[32m\u001b[K288\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kstruct TMdfKeyframe\u001b[m\u001b[K\r\n\u001b[32m\u001b[K309\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kstruct TMdfTimeline\u001b[m\u001b[K\r\n\u001b[32m\u001b[K336\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kstruct TMdfAnimation\u001b[m\u001b[K\r\n"]
