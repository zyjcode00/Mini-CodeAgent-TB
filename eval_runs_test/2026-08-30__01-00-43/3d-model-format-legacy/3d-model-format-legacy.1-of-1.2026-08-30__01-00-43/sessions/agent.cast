[261.570673, "o", "   200\t//////////////////////////////////////////////////////////////////////////\r\n   201\tstruct TMdfMesh\r\n   202\t{\r\n   203\t\tunsigned int\tnNumVerts;\t\t///< Number of vertices in this mesh\r\n   204\t\tunsigned int\tnNumIndices;\t///< Number of vertex indexes\r\n   205\t\tunsigned int\tnNumJoints;\t\t///< Number of joints in stored bind\r\n   206\t\t\t\t\t\t\t\t\t\t///< pose and parenting arrays\r\n   207\t\tMdfHandle\t\thTexture;\t\t///< Index of the texture name\r\n   208\t\tint meshType;\t\t\t\t\t///< Mesh type (See MeshType enum)\r\n   209\t\r\n   210\t\t///\r\n   211\t\t/// Mesh vertex array\r\n   212\t\t///\r\n   213\t\tunion UVerts_t {\t// reference to the vertices\r\n"]
