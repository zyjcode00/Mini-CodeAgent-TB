[272.837432, "o", "\t\t//\r\n   218\t\t// copy vertex data\r\n   219\t\t//\r\n   220\t\tFullVertList::const_iterator li = newMesh.finalVerts.begin();\r\n   221\t\tint i = 0;\r\n   222\t\tif(pMesh->meshType == TMdfMesh::MESH_SKINNED) {\r\n   223\t\t\tTMdfVertSkn *v;\r\n   224\t\t\twhile (li != newMesh.finalVerts.end()) {\r\n   225\t\t\t\t v = &((TMdfVertSkn*)pMesh->uVtxs.pVertices)[i];\r\n   226\t\r\n   227\t\t\t\tv->pos.x = li->pos[0];\r\n   228\t\t\t\tv->pos.y = li->pos[1];\r\n   229\t\t\t\tv->pos.z = li->pos[2];\r\n   230\t\r\n   231\t\t\t\tv->weights[0] = li->weights[0];\r\n   232\t\t\t\tv->weights[1] = li->weights[1];\r\n"]
