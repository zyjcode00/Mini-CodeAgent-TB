[364.699342, "o", "\t\t/************************************************************************/\r\n    26\tprotected:\r\n    27\t\tsize_t m_nDataSize;\t\t\t\t\t///< Size of the memory pool\r\n    28\t\tByte *m_pData;\t\t\t\t\t\t///< Memory pool for this MDF\r\n    29\t\r\n    30\t\r\n    31\t\tTMdfMesh *m_vpMeshes;\t\t\t\t///< All the meshes in the file\r\n    32\t\tunsigned int m_nMeshArrayLength;\t///< Length of the meshes array\r\n    33\t\r\n    34\t\tTMdfAnimation *m_vpAnimations;\t\t///< All the animations in the file\r\n    35\t\tunsigned int m_nAnimArrayLength;\t///< Size of the animations array\r\n    36\t\r\n    37\t\tchar **m_vpTextures;\t\t\t\t///< Array of texture strings\r\n    38\t\r\n    39\t\tmutable MdfHeader m_tMdfHeader;\t\t\t\t///< Master MDF header\r\n    40\t\r\n    41\t\r\n    42\t\t/************************************************************************/\r\n    43\t\t/* CONSTRUCTION                                                         */\r\n    44\t\t/************************************************************************/\r\n    45\tpublic:\r\n    46\t\tMdfFormat(void);\r\n    47\tpublic:\r\n    48\t\tvirtual ~MdfFormat(void);\r\n    49\t\r\n    50\t\t/************************************************************************/\r\n    51\t\t/* CLASS METHODS                                                        */\r\n    52\t\t/************************************************************************/\r\n    53\tpublic:\r\n    54\t\t//////////////////////////////////////////////////////////////////////////\r\n    55\t\t/// Create a new MDF file\r\n"]
[364.699442, "o", "    56\t\t///\r\n    57\t\t/// \\param nNumMeshesHint - number of meshes this file might store\r\n    58\t\t/// \\return true if successful\r\n    59\t\t///\r\n    60\t\t/// \\remarks To recreate a new MDF on the same object, Destroy() must\r\n    61\t\t///\t\t\t be called first\r\n    62\t\t//////////////////////////////////////////////////////////////////////////\r\n    63\t\tbool Create(unsigned int nNumMeshesHint=0);\r\n    64\t\r\n    65\t\t//////////////////////////////////////////////////////////////////////////\r\n    66\t\t/// Create a new MDF by loading its data from a file\r\n    67"]
