[289.17507, "o", "     1\t#pragma once\r\n     2\t#include \"types.h\"\r\n     3\t#include <math.h>\r\n     4\t#include <vector>\r\n     5\t#include <string>\r\n     6\t\r\n"]
[289.175169, "o", "     7\t#define MFDVERT_EPSILON 0.0001f\r\n     8\t\r\n     9\t\r\n    10\ttypedef int MdfHandle;\r\n    11\t\r\n    12\t//////////////////////////////////////////////////////////////////////////\r\n    13\t/// \\brief MDF File Header\r\n    14"]
[289.175311, "o", "\t/// \\author Ivgeni Segal\r\n    15\t/// \\date January 20, 2007\r\n    16\t///\r\n    17\t/// MDF File header is the structure stored at the beginning\r\n    18\t/// of the file and identifies its version and contents\r\n    19\t///\r\n    20\t//////////////////////////////////////////////////////////////////////////\r\n    21\tstruct MdfHeader \r\n    22\t{ \r\n    23\t\tchar cId[8]; // 'MDF v1.0'\r\n    24\t\r\n"]
[289.17544, "o", "    25\t\tunsigned int nMeshCount;\t\t///< Number of meshes in this file\r\n    26\t\tunsigned int nAnimCount;\t\t///< Number of animations in this file\r\n    27\t\tunsigned int nTextureCount;\t\t///< Total number of texture names\r\n    28\t\tunsigned int nByteAlignment;\t///< Current byte alignment of the file\r\n    29\t\tunsigned int nNumHierarchies;\t///< Unused\r\n    30\t\r\n    31\t\tunsigned int nTotalDataSize;\t///< Total size of the data excluding\r\n    32\t\t\t\t\t\t\t\t\t\t///< the header\r\n    33\t};\r\n    34\t\r\n    35\t//////////////////////////////////////////////////////////////////////////\r\n    36\t\r\n    37\t//\r\n    38\t\r\n    39\t//\r\n    40\t\r\n"]
[289.175649, "o", "    41\t//////////////////////////////////////////////////////////////////////////\r\n    42\t/// \\brief Transitional vertex format\r\n    43\t/// \\author Ivgeni Segal\r\n    44\t/// \\date January 20, 2007\r\n    45\t///\r\n    46\t/// transitional vertex format for use with exporters.\r\n    47\t/// This structure is used by the mesh-building functions of the MDF \r\n    48\t/// format object. do not use for loading.\r\n    49\t///\r\n    50\t///\r\n    51\t//////////////////////////////////////////////////////////////////////////\r\n    52\tstruct MdfFullVertex {\r\n    53\t\tfloat pos[3];\r\n    54\t\r\n    55\t\tfloat weights[3];\r\n    56\t\tunsigned char bones[4];\r\n    57\t\r\n    58\t\tfloat normal[3];\r\n    59\t\tfloat u, v;\r\n    60\t\r\n    61\t\tbool operator==(const MdfFullVertex &b) const {\r\n    62\t\t\tif(bones[0] != b.bones[0]){\r\n    63\t\t\t\treturn false;\r\n    64\t\t\t}\r\n    65\t\t\tif(bones[1] != b.bones[1]){\r\n    66\t\t\t\treturn false;\r\n    67\t\t\t}\r\n    68\t\t\tif(bones[2] != b.bones[2]){\r\n    69\t\t\t\treturn false;\r\n    70\t\t\t}\r\n    71\t\t\tif(bones[3] != b.bones[3]){\r\n    72\t\t\t\treturn false;\r\n    73"]
[289.175803, "o", "\t\t\t}\r\n    74\t\t\tif(fabs(pos[0] - b.pos[0]) > MFDVERT_EPSILON) {\r\n    75\t\t\t\treturn false;\r\n    76\t\t\t}\r\n    77\t\t\tif(fabs(pos[1] - b.pos[1]) > MFDVERT_EPSILON) {\r\n    78\t\t\t\treturn false;\r\n    79\t\t\t}\r\n    80\t\t\tif(fabs(pos[2] - b.pos[2]) > MFDVERT_EPSILON) {\r\n    81\t\t\t\treturn false;\r\n    82\t\t\t}\r\n    83\t\t\tif(fabs(weights[0] - b.weights[0]) > MFDVERT_EPSILON) {\r\n    84\t\t\t\treturn false;\r\n    85\t\t\t}\r\n    86\t\t\tif(fabs(weights[1] - b.weights[1]) > MFDVERT_EPSILON) {\r\n    87\t\t\t\treturn false;\r\n    88\t\t\t}\r\n    89\t\t\tif(fabs(weights[2] - b.weights[2]) > MFDVERT_EPSILON) {\r\n    90\t"]
[289.175959, "o", "\t\t\treturn false;\r\n    91\t\t\t}\r\n    92\t\t\tif(fabs(normal[0] - b.normal[0]) > MFDVERT_EPSILON) {\r\n    93\t\t\t\treturn false;\r\n    94\t\t\t}\r\n    95\t\t\tif(fabs(normal[1] - b.normal[1]) > MFDVERT_EPSILON) {\r\n    96\t\t\t\treturn false;\r\n    97\t\t\t}\r\n    98\t\t\tif(fabs(normal[2] - b.normal[2]) > MFDVERT_EPSILON) {\r\n    99\t\t\t\treturn false;\r\n   100\t\t\t}\r\n   101\t\t\tif(fabs(u - b.u) > MFDVERT_EPSILON) {\r\n   102\t\t\t\treturn false;\r\n   103\t\t\t}\r\n   104\t\t\tif(fabs(v - b.v) > MFDVERT_EPSILON) {\r\n   105\t\t\t\treturn false;\r\n   106\t\t\t}\r\n   107\t\r\n   108\t\t\treturn true;\r\n   109\t\t}\r\n   110\t\r\n   111\t};\r\n   112"]
[289.176073, "o", "\t\r\n   113\t//////////////////////////////////////////////////////////////////////////\r\n   114\t/// \\brief Generic 4x4 matrix\r\n   115\t/// \\author Ivgeni Segal\r\n   116\t/// \\date January 20, 2007\r\n   117\t///\r\n   118\t/// Generic matrix used in the MDF format\r\n   119"]
[289.176329, "o", "\t///\r\n   120\t/// \\remarks MDF uses row-major matrices, if you need to use MDF in a\r\n   121\t///\t\t\t column-major environment such as OpenGL don't forget to\r\n   122\t///\t\t\t transpose them.\r\n   123\t///\r\n   124\t//////////////////////////////////////////////////////////////////////////\r\n   125\tstruct TMdfMatrix4\r\n   126\t{\r\n   127\t\tfloat\te[16];\r\n   128\t};\r\n   129\t\r\n   130\t//////////////////////////////////////////////////////////////////////////\r\n   131\t/// \\brief Skinned vertex for animation\r\n   132\t/// \\author Ivgeni Segal\r\n   133\t/// \\date January 20, 2007\r\n   134\t///\r\n   135\t/// \\remarks Skinned vertex is present in animated meshes and supports\r\n   136\t///\tup to four bones per vertex\r\n   137\t///\r\n   138\t//////////////////////////////////////////////////////////////////////////\r\n   139\tstruct TMdfVertSkn\r\n   140\t{\r\n"]
[289.176675, "o", "\u001b[?2004hroot@573d1b2b6701:/app# "]
[289.17685, "o", "true; tmux wait -S done\r\n"]
