[352.672314, "o", "   260\t\tunsigned int VertexSize() const {\r\n   261\t\t\tswitch(meshType) {\r\n   262\t\t\t\tcase MESH_STATIC:\r\n   263\t\t\t\t\treturn sizeof(TMdfVertSta);\r\n   264\t\t\t\t\tbreak;\r\n   265\t\t\t\tcase MESH_SKINNED:\r\n   266\t\t\t\t\treturn sizeof(TMdfVertSkn);\r\n   267\t\t\t\t\tbreak;\r\n"]
[352.672387, "o", "   268\t\r\n   269\t\t\t\tdefault:\r\n   270\t\t\t\t\treturn 0;\r\n   271\t\t\t}\r\n   272\t\t}\r\n   273\t\r\n   274\t};\r\n   275\t\r\n   276\t//////////////////////////////////////////////////////////////////////////\r\n   277\t/// \\brief A single joint keyframe\r\n   278\t/// \\author Ivgeni Segal\r\n   279\t/// \\date January 20, 2007\r\n"]
[352.672439, "o", "   280\t///\r\n   281\t/// Stores information about a single key-frame of a joint\r\n   282\t///\r\n   283\t/// \\remarks All transformation values are relative to their parent.\r\n   284\t///\t\t\t In other words, if joint A is parent of joint B, B's\r\n   285\t///\t\t\t transformation values represent the values that take\r\n   286\t///\t\t\t the joint from location/orientation/scale of A to B\r\n   287\t//////////////////////////////////////////////////////////////////////////\r\n   288\tstruct TMdfKeyframe\r\n   289\t{\r\n   290\t\tfloat fKeyTime;\t\t\t///< Time of start of this keyframe\r\n   291\t\tFloat3 vecTranslation;\t///< Relative translation at this keyframe\r\n   292\t\tFloat4 qRotation;\t\t///< Relative rotation at this keyframe"]
[352.672678, "o", "\r\n   293\t\tFloat3 vecScale;\t\t\t///< Relative joint scale at this keyframe\r\n   294\t};\r\n   295\t\r\n   296\t//////////////////////////////////////////////////////////////////////////\r\n   297\t/// \\brief A collection of keyframes for a single joint\r\n   298\t/// \\author Ivgeni Segal\r\n   299\t/// \\date January 20, 2007\r\n   300\t///\r\n   301\t/// \\remarks The timeline is the animation channel for a single joint.\r\n   302\t/// Timelines store the collection of keyframes for a single joint.\r\n   303\t/// An array of timelines is stored in the TMdfAnimation object. The array\r\n   304\t/// corresponds to the depth-first sequence of joints. This array is \r\n   305\t/// parallel to the bind and parenting arrays in the corresponding TMdfMesh\r\n   306\t/// object.\r\n   307\t///\r\n   308\t//////////////////////////////////////////////////////////////////////////\r\n   309\tstruct TMdfTimeline\r\n   310\t{\r\n   311\t\tint nKeyFrames;\r\n   312\t\r\n   313\t\tunion UKfs_t {\r\n   314\t\t\tTMdfKeyframe *pKeyframes;\r\n   315\t\t\tint nDataOffset;\r\n   316\t\t} uKfs;\r\n   317\t};\r\n   318\t\r\n   319\t//////////////////////////////////////////////////////////////////////////\r\n   320\t/// \\brief MDF Animation Object for a single mesh\r\n   321\t/// \\author Ivgeni Segal\r\n   322\t/// \\date January 20, 2007\r\n"]
[352.672884, "o", "   323\t///\r\n   324\t/// MDF Animation object stores an array of joint timeline channels\r\n   325\t/// which in term contain the keyframes for each joint\r\n   326\t///\r\n   327\t/// \\remarks All joint keyframe transformations are relative to their\r\n   328\t///\t\t\t parent joints. The parent joint information can be obtained\r\n   329\t///\t\t\t from the TMdfMesh::uPrnt.pParentInfo array.\r\n   330\t///\r\n   331\t///\t\\par\t The order at which the timelines are stored in the pTimeline\r\n   332\t///\t\t\t array corresponds to the same order as in the TMdfMesh's\r\n   333\t///\t\t\t bind-post joints and parent array\r\n   334\t///\r\n   335\t//////////////////////////////////////////////////////////////////////////\r\n   336\tstruct TMdfAnimation\r\n   337\t{\r\n   338\t\tMdfHandle hMeshId;\t///< Index of the mesh that this animation belongs to\r\n   339\t\tint nNumTimelines;\t///< Number of timelines stored (corresponds to number\r\n   340\t\t\t\t\t\t\t///< of joints)\r\n   341\t\tfloat fTimeLength;\t///< Total play-time of this animation\r\n   342\t\r\n   343\t\tunion UTls_t {\r\n   344\t\t\tTMdfTimeline *pTimeline;\t///< Array of timeline (channel) objects\r\n   345\t\t\t\t\t\t\t\t\t\t///< this corresponds to the joints\r\n   346\t\t\t\t\t\t\t\t\t\t///< and is stored in depth-first\r\n   347\t\t\t\t\t\t\t\t\t\t///< order of the joint hierarchy\r\n   348\t\r\n   349\t\t\tint nDataOffset;\t\t\t///< Offset of the array in file\r\n   350\t\t} uTls;\r\n   351\t\r\n   352\t};\r\n   353\t\r\n   354\t// Not used.\r\n   355\t//struct TMdfMaterial\r\n   356\t//{\r\n"]
[352.673178, "o", "   357\t//\tFloat3\t\t\tdiffuse;\r\n   358\t//\tFloat3\t\t\tambient;\r\n   359\t//\tFloat3\t\t\tspecular;\r\n   360\t//\tFloat3\t\t\temissive;\r\n   361\t//\tfloat\t\t\tpower;\r\n   362\t//};\r\n   363\t//\r\n   364\t//struct TMdfTransform\r\n   365\t//{\r\n   366\t//\r\n   367\t//};\r\n   368\t\r\n   369\t\r\n   370\t//////////////////////////////////////////////////////////////////////////\r\n   371\t\r\n   372\ttypedef std::vector<MdfFullVertex> FullVertList;\r\n   373\ttypedef std::vector<unsigned short> FullIndexList;\r\n   374\t\r\n   375\tstruct MdfFullMesh {\r\n   376\t\tMdfFullMesh() : \r\n   377\t\t\tvertices(0), \r\n   378\t\t\tnumVertices(0), \r\n   379\t\t\tfinalBindPose(0), \r\n   380\t\t\tparentInfo(0),\r\n   381\t\t\tnumBindPoseElements(0)\r\n"]
[352.673422, "o", "   382\t\t\t{}\r\n   383\t\r\n   384\t\t// temporary verts\r\n   385\t\tMdfFullVertex *vertices;\r\n   386\t\tunsigned int numVertices;\r\n   387\t\r\n   388\t\t// mesh info\r\n   389\t\tFullVertList finalVerts;\r\n   390\t\tFullIndexList finalIndices;\r\n   391\t\r\n   392\t\t// hierarchy info\r\n   393\t\tTMdfMatrix4 *finalBindPose;\r\n   394\t\tunsigned int numBindPoseElements;\r\n   395\t\tint *parentInfo;\r\n   396\t\r\n   397\t\tstd::string textureFilename;\r\n   398\t\r\n   399\t\tvoid addVertex(const MdfFullVertex &v) {\r\n   400\t\t\t"]
[352.673502, "o", "unsigned short tmpSize = (unsigned short)finalVerts.size();\r\n   401\t\t\t\r\n   402\t\t\tfor(unsigned short i = 0; i < tmpSize; i++) {\r\n   403\t\t\t\tif(finalVerts[i] == v) {\r\n   404\t\t\t\t\tfinalIndices.push_back(i);\r\n   405\t\t\t\t\treturn;\r\n   406\t\t\t\t}\r\n   407\t\t\t}\r\n   408\t\t\t\r\n   409\t\t\tfinalVerts.push_back(v);\r\n   410\t\t\tfinalIndices.push_back(tmpSize);\r\n   411\t\t}\r\n   412\t\r\n   413\t\tvoid Clear(void) {\r\n   414\t\t\tdelete[] vertices;\r\n   415\t\t\tvertices = 0;\r\n   416\t\t\tnumVertices = 0;\r\n   417\t\t\tdelete[] finalBindPose;\r\n   418\t\t\tfinalBindPose = 0;\r\n"]
