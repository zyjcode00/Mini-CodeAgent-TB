[1189.272285, "o", "if [ -f /app/MdfLib/converter.cpp ]; then cat -- /app/MdfLib/converter.cpp; else echo '错误: 找不到文件 /app/MdfLib/converter.cpp'; fi\r\n\u001b[?2004l\r"]
[1189.273677, "o", "#include \"MdfFormat.h\"\r\n\r\n#include <cstdio>\r\n#include <fstream>\r\n#include <iostream>\r\n#include <string>\r\n\r\nclass FileStream final : public MdfStream {\r\npublic:\r\n    explicit FileStream(const char *path) : file_(std::fopen(path, \"rb\")) {}\r\n    ~FileStream() override { if (file_) std::fclose(file_); }\r\n    bool valid() const { return file_ != nullptr; }\r\n    bool Seek(int offset, int origin) override { return file_ && std::fseek(file_, offset, origin) == 0; }\r\n    int Tell() override { return file_ ? static_cast<int>(std::ftell(file_)) : -1; }\r\n    int Read(void *buffer, int size) override { return file_ ? static_cast<int>(std::fread(buffer, 1, size, file_)) : 0; }\r\n    int Length() override {\r\n        if (!file_) return 0;\r\n        long current = std::ftell(file_);\r\n        if (current < 0) return 0;\r\n        if (std::fseek(file_, 0, SEEK_END) != 0) return 0;\r\n        long end = std::ftell(file_);\r\n        std::fseek(file_, current, SEEK_SET);\r\n        return end < 0 ? 0 : static_cast<int>(end);\r\n    }\r\nprivate:\r\n    std::FILE *file_;\r\n};\r\n\r\nstatic std::string json_escape(const std::string &value) {\r\n    std::string result;\r\n    for (char c : value) {\r\n        if (c == '\\\\') result += \"\\\\\\\\\";\r\n        else if (c == '\"') result += \"\\\\\\\"\";\r\n        else if (c == '\\n') result += \"\\\\n\";\r\n        else if (c == '\\r') result += \"\\\\r\";\r\n        else if (c == '\\t') result += \"\\\\t\";\r\n        else result += c;\r\n    }\r\n    return result;\r\n}\r\n\r\nint main(int argc, char **argv) {\r\n    if (argc != 3) {\r\n        std::cerr << \"usage: mdf_converter INPUT.mdf OUTPUT.json\\n\";\r\n        return 2;\r\n    }\r\n\r\n    FileStream input(argv[1]);\r\n    if (!input.valid()) {\r\n        std::cerr << \"cannot open input: \" << argv[1] << '\\n';\r\n        return 1;\r\n    }\r\n    MdfFormat model;\r\n    if (!model.LoadFromStream(input)) {\r\n        std::cerr << \"cannot parse MDF: \" << argv[1] << '\\n';\r\n        return 1;\r\n    }\r\n\r\n    std::ofstream output(argv[2]);\r\n    if (!output) {\r\n        std::cerr << \"cannot open output: \" << argv[2] << '\\n';\r\n        return 1;\r\n    }\r\n    output << \"{\\n\"\r\n           << \"  \\\"format\\\": \\\"MDF\\\",\\n\"\r\n           << \"  \\\"format_version\\\": 1,\\n\"\r\n           << \"  \\\"source\\\": \\\"\" << json_escape(argv[1]) << \"\\\",\\n\"\r\n           << \"  \\\"meshes\\\": {\\\"count\\\": \" << model.GetNumMeshes() << \"},\\n\"\r\n           << \"  \\\"animations\\\": {\\\"count\\\": \" << model.GetNumAnimations() << \"},\\n\"\r\n           << \"  \\\"textures\\\": {\\\"count\\\": \" << model.GetNumTextures() << \"}\\n\"\r\n           << \"}\\n\";\r\n    return output.good() ? 0 : 1;\r\n}\r\n"]
[1189.273878, "o", "\u001b[?2004hroot@573d1b2b6701:/app/MdfLib# "]
