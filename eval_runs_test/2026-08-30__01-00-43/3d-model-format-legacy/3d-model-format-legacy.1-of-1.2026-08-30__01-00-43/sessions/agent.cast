[456.167499, "o", "#include \"StdAfx.h\"\r\n#include \"MdfFormat.h\"\r\n#include <stdlib.h>\r\n\r\nconst char MDF_VER_STR[8] = {\r\n\t'M',\r\n\t'D',\r\n\t'F',\r\n\t' ',\r\n\t'v',\r\n\t'1',\r\n\t'.',\r\n\t'2'\r\n};\r\n\r\nclass MdfMemStream \r\n\t: public MdfStream\r\n{\r\npublic:\r\n\t"]
[456.16761, "o", "MdfMemStream(Byte *pData, int nDataLen) : pData(pData), nDataLen(nDataLen), nPos(0) {}\r\n\tvirtual ~MdfMemStream() {}\r\n\r\n\tvirtual bool Seek(int offset, int origin);\r\n\tvirtual int Tell();\r\n\tvirtual int Read(void *pDest, int nLength);\r\n\tvirtual int Length();\r\n\r\nprivate:\r\n\tByte *pData;\r\n\tint nDataLen;\r\n\tint nPos;\r\n\r\n"]
[456.167798, "o", "};\r\n\r\nbool MdfMemStream::Seek(int offset, int origin)\r\n{\r\n\tswitch(origin) {\r\n\t\tcase SEEK_SET:\r\n\t\t{\r\n\t\t\tif(offset < 0 || offset > nDataLen) {\r\n\t\t\t\treturn false;\r\n\t\t\t}\r\n\t\t\tnPos = offset;\r\n\t\t} break;\r\n\t\tcase SEEK_CUR:\r\n\t\t{\r\n\t\t\tregister int test = nPos += offset;\r\n\t\t\tif(test < 0 || test > nDataLen) {\r\n\t\t\t\treturn false;\r\n"]
[456.168016, "o", "\t\t\t}\r\n\t\t\tnPos += offset;\r\n\t\t} break;\r\n\t\tcase SEEK_END:\r\n\t\t{\r\n\t\t\tregister int test = nPos += offset;\r\n\t\t\tif(test < 0 || test > nDataLen) {\r\n\t\t\t\treturn false;\r\n\t\t\t}\r\n\t\t\tnPos = nDataLen - origin;\r\n\t\t} break;\r\n"]
