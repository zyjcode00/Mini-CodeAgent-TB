[352.813623, "o", "}\r\n   250\t\t} else {\r\n   251\t\t\tTMdfVertSta *v;\r\n   252\t\t\twhile (li != newMesh.finalVerts.end()) {\r\n   253\t\t\t\tv = &((TMdfVertSta*)pMesh->uVtxs.pVertices)[i];\r\n   254\t\r\n   255\t\t\t\tv->pos.x = li->pos[0];\r\n   256\t\t\t\tv->pos.y = li->pos[1];\r\n   257\t\t\t\tv->pos.z = li->pos[2];\r\n   258\t\t\t\tv->normal.x = li->normal[0];\r\n   259\t\t\t\tv->normal.y = li->normal[1];\r\n"]
