[1081.317717, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/MdfLib/converter.cpp <<'PY'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = '#include \"MdfFormat.h\"\\n\\n#include <cstdio>\\n#include <fstream>\\n#include <iostream>\\n#include <string>\\n\\nclass FileStream final : public MdfStream {\\npublic:\\n    explicit FileStream(const char *path) : file_(std::fopen(path, \"rb\")) {}\\n    ~FileStream() override { if (file_) std::fclose(file_); }\\n    bool valid() const { return file_ != nullptr; }\\n    bool Seek(int offset, int origin) override { return file_ && std::fseek(file_, offset, origin) == 0; }\\n    int Tell() override { return file_ ? static_cast<int>(std::ftell(file_)) : -1; }\\n    int Read(void *buffer, int size) override { return file_ ? static_cast<int>(std::fread(buffer, 1, size, file_)) : 0; }\\nprivate:\\n    std::FILE *file_;\\n};\\n\\nstatic std::string json_escape(const std::string &value) {\\n    std::string result;\\n    for (char c : value) {\\n        if (c == \\'\\\\\\\\\\') result += \"\\\\\\\\\\\\\\\\\";\\n        else if (c == \\'\"\\') result += \"\\\\\\\\\\\\\"\";\\n        else if (c == \\'\\\\n\\') result += \"\\\\\\\\n\";\\n        else if (c == \\'\\\\r\\') result += \"\\\\\\\\r\";\\n        else if (c == \\'\\\\t\\') result += \"\\\\\\\\t\";\\n        else result += c;\\n    }\\n    return result;\\n}\\n\\nint main(int argc, char **argv) {\\n    if (argc != 3) {\\n        std::cerr << \"usage: mdf_converter INPUT.mdf OUTPUT.json\\\\n\";\\n        return 2;\\n    }\\n\\n    FileStream input(argv[1]);\\n    if (!input.valid()) {\\n        std::cerr << \"cannot open input: \" << argv[1] << \\'\\\\n\\';\\n        return 1;\\n    }\\n    MdfFormat model;\\n    if (!model.LoadFromStream(input)) {\\n        std::cerr << \"cannot parse MDF: \" << argv[1] << \\'\\\\n\\';\\n        return 1;\\n    }\\n\\n    std::ofstream output(argv[2]);\\n    if (!output) {\\n        std::cerr << \"cannot open output: \" << argv[2] << \\'\\\\n\\';\\n        return 1;\\n    }\\n    output << \"{\\\\n\"\\n           << \"  \\\\\"format\\\\\": \\\\\"MDF\\\\\",\\\\n\"\\n           << \"  \\\\\"format_version\\\\\": 1,\\\\n\"\\n           << \"  \\\\\"source\\\\\": \\\\\"\" << json_escape(argv[1]) << \"\\\\\",\\\\n\"\\n           << \"  \\\\\"meshes\\\\\": {\\\\\"count\\\\\": \" << model.GetNumMeshes() << \"},\\\\n\"\\n           << \"  \\\\\"animations\\\\\": {\\\\\"count\\\\\": \" << model.GetNumAnimations() << \"},\\\\n\"\\n           << \"  \\\\\"textures\\\\\": {\\\\\"count\\\\\": \" << model.GetNumTextures() << \"}\\\\n\"\\n           << \"}\\\\n\";\\n    return output.good() ? 0 : 1;\\n}\\n'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, 'w', encoding='utf-8', newline='\\n') as f:\n        f.write(content)\n    print(f\"成功: 已写入 {path}\")\nexcept Exception as exc:\n    print(f\"写入失败: {exc}\")\nPY\ntrue; tmux wait -S done\r"]
[1081.3184, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
[1081.318578, "o", "\u001b[?2004hroot@573d1b2b6701:/app/MdfLib# "]
[1081.318755, "o", "python3 - /app/MdfLib/converter.cpp <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h"]
[1081.318918, "o", "> import os\r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r"]
[1081.319079, "o", "\u001b[?2004h> path = sys.argv[1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1081.325542, "o", "content = '#include \"MdfFormat.h\"\\n\\n#include <cstdio>\\n#include <fstream>\\n#include <iostream>\\n#include <string>\\n\\nclass FileStream final : public MdfStream {\\npublic:\\n    explicit FileStream(const char *path) : file_(std::fopen(path, \"rb\")) {}\\n    ~FileStream() override { if (file_) std::fclose(file_); }\\n    bool valid() const { return file_ != nullptr; }\\n    bool Seek(int offset, int origin) override { return file_ && std::fseek(file_, offset, origin) == 0; }\\n    int Tell() override { return file_ ? static_cast<int>(std::ftell(file_)) : -1; }\\n    int Read(void *buffer, int size) override { return file_ ? static_cast<int>(std::fread(buffer, 1, size, file_)) : 0; }\\nprivate:\\n    std::FILE *file_;\\n};\\n\\nstatic std::string json_escape(const std::string &value) {\\n    std::string result;\\n    for (char c : value) {\\n        if (c == \\'\\\\\\\\\\') result += \"\\\\\\\\\\\\\\\\\";\\n        else if (c == \\'\"\\') result += \"\\\\\\\\\\\\\"\";\\n        else if (c == \\'\\\\n\\') result += \"\\\\\\\\n\";\\n        else if (c == \\'\\\\r\\') result += \"\\\\\\\\r\";\\n        else if (c == \\'\\\\t\\') result += \"\\\\\\\\t\";\\n        else result += c;\\n    }\\n    return result;\\n}\\n\\nint main(int argc, char **argv) {\\n    if (argc != 3) {\\n        std::cerr << \"usage: mdf_converter INPUT.mdf OUTPUT.json\\\\n\";\\n        return 2;\\n    }\\n\\n    FileStream input(argv[1]);\\n    if (!input.valid()) {\\n        std::cerr << \"cannot open input: \" << argv[1] << \\'\\\\n\\';\\n        return 1;\\n    }\\n    MdfFormat model;\\n    if (!model.LoadFromStream(input)) {\\n        std::cerr << \"cannot parse MDF: \" << argv[1] << \\'\\\\n\\';\\n        return 1;\\n    }\\n\\n    std::ofstream output(argv[2]);\\n    if (!output) {\\n        std::cerr << \"cannot open output: \" << argv[2] << \\'\\\\n\\';\\n        return 1;\\n    }\\n    output << \"{\\\\n\"\\n           << \"  \\\\\"format\\\\\": \\\\\"MDF\\\\\",\\\\n\"\\n           << \"  \\\\\"format_version\\\\\": 1,\\\\n\"\\n           << \"  \\\\\"source\\\\\": \\\\\"\" << json_escape(argv[1]) << \"\\\\\",\\\\n\"\\n           << \"  \\\\\"meshes\\\\\": {\\\\\"count\\\\\": \" << model.GetNumMeshes() << \"},\\\\n\"\\n           << \"  \\\\\"animations\\\\\": {\\\\\"count\\\\\": \" << model.GetNumAnimations() << \"},\\\\n\"\\n           << \"  \\\\\"textures\\\\\": {\\\\\"count\\\\\": \" << model.GetNumTextures() << \"}\\\\n\"\\n           << \"}\\\\n\";\\n    return output.good() ? 0 : 1;\\n}\\n'\r\n\u001b[?2004l\r"]
