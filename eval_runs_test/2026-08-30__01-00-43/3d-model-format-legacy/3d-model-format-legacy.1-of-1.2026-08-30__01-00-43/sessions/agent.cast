[585.839466, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
[585.839771, "o", "\u001b[?2004hroot@573d1b2b6701:/app/MdfLib# "]
[585.840656, "o", "cd /app/MdfLib && sed -n '1,120p' MdfFormat.cpp\r\n\u001b[?2004l\r"]
[585.842291, "o", "#include \"StdAfx.h\"\r\n#include \"MdfFormat.h\"\r\n#include <stdlib.h>\r\n\r\nconst char MDF_VER_STR[8] = {\r\n\t'M',\r\n\t'D',\r\n\t'F',\r\n\t' ',\r\n\t'v',\r\n\t'1',\r\n\t'.',\r\n\t'2'\r\n};\r\n\r\nclass MdfMemStream \r\n\t: public MdfStream\r\n{\r\npublic:\r\n\tMdfMemStream(Byte *pData, int nDataLen) : pData(pData), nDataLen(nDataLen), nPos(0) {}\r\n\tvirtual ~MdfMemStream() {}\r\n\r\n\tvirtual bool Seek(int offset, int origin);\r\n\tvirtual int Tell();\r\n\tvirtual int Read(void *pDest, int nLength);\r\n\tvirtual int Length();\r\n\r\nprivate:\r\n\tByte *pData;\r\n\tint nDataLen;\r\n"]
[585.842557, "o", "\tint nPos;\r\n\r\n};\r\n\r\nbool MdfMemStream::Seek(int offset, int origin)\r\n{\r\n\tswitch(origin) {\r\n\t\tcase SEEK_SET:\r\n\t\t{\r\n\t\t\tif(offset < 0 || offset > nDataLen) {\r\n\t\t\t\treturn false;\r\n\t\t\t}\r\n\t\t\tnPos = offset;\r\n\t\t} break;\r\n\t\tcase SEEK_CUR:\r\n\t\t{\r\n\t\t\tregister int test = nPos += offset;\r\n\t\t\tif(test < 0 || test > nDataLen) {\r\n\t\t\t\treturn false;\r\n\t\t\t}\r\n\t\t\tnPos += offset;\r\n\t\t} break;\r\n\t\tcase SEEK_END:\r\n\t\t{\r\n\t\t\tregister int test = nPos += offset;\r\n\t\t\tif(test < 0 || test > nDataLen) {\r\n\t\t\t\treturn false;\r\n\t\t\t}\r\n\t\t\tnPos = nDataLen - origin;\r\n\t\t} break;\r\n\t}\r\n\t"]
[585.842782, "o", "return true;\r\n}\r\n\r\nint MdfMemStream::Tell()\r\n{\r\n\treturn nPos;\r\n}\r\n\r\nint MdfMemStream::Read(void *pDest, int nLength)\r\n{\r\n\tif(nPos + nLength >= nDataLen) {\r\n\t\tnLength = nDataLen - nPos;\r\n\t}\r\n\tmemcpy(pDest, &pData[nPos], nLength);\r\n\tnPos += nLength;\r\n\treturn nLength;\r\n}\r\n\r\nint MdfMemStream::Length()\r\n{\r\n\treturn nDataLen;\r\n}\r\n\r\n//////////////////////////////////////////////////////////////////////////\r\n\r\nclass MdfFileStream \r\n\t: public MdfStream\r\n{\r\npublic:\r\n\tMdfFileStream() : fp(0), nDataLen(0) {}\r\n\tvirtual ~MdfFileStream() { Close(); }\r\n\r\n\tbool Open(const char *szFilename) {\r\n\t\tfp = fopen(szFilename, \"rb\");\r\n\t\tif(fp) {\r\n\t\t\tfseek(fp, 0, SEEK_END);\r\n\t\t\tnDataLen = (int)ftell(fp);\r\n\t\t\tfseek(fp, 0, SEEK_SET);\r\n\t\t\treturn true;\r\n\t\t} else {\r\n\t\t\treturn false;\r\n\t\t}\r\n\t}\r\n\r\n\tvoid Close() {\r\n\t\tif(fp) {\r\n\t\t\tfclose(fp);\r\n\t\t}\r\n\t\tfp = 0;\r\n\t\tnDataLen = 0;\r\n\t}\r\n\r\n\tvirtual bool Seek(int offset, int origin) {\r\n\t\treturn(fseek(fp, offset, origin) == 0);\r\n\t}\r\n\r\n\tvirtual int Tell() { return (int)ftell(fp); }\r\n\r\n"]
[585.842914, "o", "\tvirtual int Read(void *pDest, int nLength) {\r\n"]
