#define MFDVERT_EPSILON 0.0001f


typedef int MdfHandle;

//////////////////////////////////////////////////////////////////////////
/// \brief MDF File Header
/// \author Ivgeni Segal
/// \date January 20, 2007
///
/// MDF File header is the structure stored at the beginning
/// of the file and identifies its version and contents
///
//////////////////////////////////////////////////////////////////////////
struct MdfHeader 
{ 
