   175	MdfHandle MdfFormat::AddMesh(const MdfFullMesh &newMesh)
   176	{
   177		TMdfMesh *pMesh = 0;
   178		unsigned int nMesh = 0;
   179	
   180		// reallocate mesh pointer array if needed
   181		if((m_tMdfHeader.nMeshCount + 1) > m_nMeshArrayLength) {
   182	
   183			m_vpMeshes = (TMdfMesh*)realloc(m_vpMeshes, (m_tMdfHeader.nMeshCount+1)*sizeof(TMdfMesh));
   184			m_nMeshArrayLength++;
   185		}
   186	
   187		// allocate new mesh, set up variables
   188		nMesh = m_tMdfHeader.nMeshCount;
   189		pMesh = &m_vpMeshes[nMesh];
   190		m_tMdfHeader.nMeshCount++;
   191		ZeroMemory(pMesh, sizeof(TMdfMesh));
   192	
   193		if(newMesh.numBindPoseElements > 0 && newMesh.parentInfo) {
   194			pMesh->meshType = TMdfMesh::MESH_SKINNED;
   195		} else {
   196			pMesh->meshType = TMdfMesh::MESH_STATIC;
   197		}
   198	
   199		size_t numVerts = newMesh.finalVerts.size();
   200		size_t numInds = newMesh.finalIndices.size();
   201	
   202		// set up the mesh structure
   203		pMesh->nNumVerts = (unsigned int)newMesh.finalVerts.size();
   204		pMesh->nNumIndices = (unsigned int)newMesh.finalIndices.size();
   205	
   206		// allocate vertices and indices
   207		
   208		if(pMesh->meshType == TMdfMesh::MESH_SKINNED) {
   209			pMesh->uVtxs.pVertices = malloc(sizeof(TMdfVertSkn) * pMesh->nNumVerts);
   210		} else {
   211			pMesh->uVtxs.pVertices = malloc(sizeof(TMdfVertSta) * pMesh->nNumVerts);
   212		}
   213	
   214	
   215		pMesh->uIdxs.pIndices = (unsigned short*)malloc(sizeof(unsigned short) * pMesh->nNumIndices);
   216	
   217		//
   218		// copy vertex data
   219		//
   220		FullVertList::const_iterator li = newMesh.finalVerts.begin();
   221		int i = 0;
   222		if(pMesh->meshType == TMdfMesh::MESH_SKINNED) {
   223			TMdfVertSkn *v;
   224			while (li != newMesh.finalVerts.end()) {
   225				 v = &((TMdfVertSkn*)pMesh->uVtxs.pVertices)[i];
   226	
   227				v->pos.x = li->pos[0];
   228				v->pos.y = li->pos[1];
   229				v->pos.z = li->pos[2];
   230	
   231				v->weights[0] = li->weights[0];
   232				v->weights[1] = li->weights[1];
   233				v->weights[2] = li->weights[2];
   234	
   235				v->bones[0] = li->bones[0];
   236				v->bones[1] = li->bones[1];
   237				v->bones[2] = li->bones[2];
   238				v->bones[3] = li->bones[3];
   239				
   240				v->normal.x = li->normal[0];
   241				v->normal.y = li->normal[1];
   242				v->normal.z = li->normal[2];
   243	
   244				v->texcoord.u = li->u;
   245				v->texcoord.v = li->v;
   246	
   247				i++;
   248				li++;
   249			}
   250		} else {
   251			TMdfVertSta *v;
   252			while (li != newMesh.finalVerts.end()) {
   253				v = &((TMdfVertSta*)pMesh->uVtxs.pVertices)[i];
   254	
   255				v->pos.x = li->pos[0];
   256				v->pos.y = li->pos[1];
   257				v->pos.z = li->pos[2];
   258				v->normal.x = li->normal[0];
   259				v->normal.y = li->normal[1];
   260				v->normal.z = li->normal[2];
   261				v->texcoord.u = li->u;
   262				v->texcoord.v = li->v;
   263	
   264				i++;
   265				li++;
   266			}
   267		}
   268	
   269		//
   270		// copy index data
   271		//
   272		FullIndexList::const_iterator liIdx = newMesh.finalIndices.begin();
   273	
   274		int dstIdx = 0;
   275		while(liIdx != newMesh.finalIndices.end()) {
   276			pMesh->uIdxs.pIndices[dstIdx] = *liIdx;
   277			dstIdx++;
   278			liIdx++;
   279		}
   280	
   281		//
   282		// copy bind-pose and hierarchy data if needed
   283		//
   284		if(pMesh->meshType == TMdfMesh::MESH_SKINNED) {
   285			pMesh->uBnd.pBindMats = (TMdfMatrix4 *)malloc(newMesh.numBindPoseElements * sizeof(TMdfMatrix4));
   286			pMesh->nNumJoints = newMesh.numBindPoseElements;
   287	
   288			// copy bind-pose data
   289			memcpy(pMesh->uBnd.pBindMats, newMesh.finalBindPose, newMesh.numBindPoseElements * sizeof(TMdfMatrix4));
   290	
   291	
   292			// copy parent info
   293			pMesh->uPrnt.pParentInfo = (int *)malloc(newMesh.numBindPoseElements * sizeof(int));
   294			memcpy(pMesh->uPrnt.pParentInfo, newMesh.parentInfo, newMesh.numBindPoseElements * sizeof(int));
   295		}
   296	
   297		//
   298		// handle texture
   299		//
   300		if(!newMesh.textureFilename.empty()) {
   301			pMesh->hTexture = AddTexture(newMesh.textureFilename.c_str());
   302		} else {
   303			pMesh->hTexture = -1;
   304		}
   305	
   306		return nMesh;
   307	}
