    55		float weights[3];
    56		unsigned char bones[4];
    57	
    58		float normal[3];
    59		float u, v;
    60	
    61		bool operator==(const MdfFullVertex &b) const {
    62			if(bones[0] != b.bones[0]){
    63				return false;
    64			}
    65			if(bones[1] != b.bones[1]){
    66				return false;
    67			}
    68			if(bones[2] != b.bones[2]){
    69				return false;
    70			}
    71			if(bones[3] != b.bones[3]){
    72				return false;
    73			}
    74			if(fabs(pos[0] - b.pos[0]) > MFDVERT_EPSILON) {
    75				return false;
    76			}
    77			if(fabs(pos[1] - b.pos[1]) > MFDVERT_EPSILON) {
    78				return false;
    79			}
    80			if(fabs(pos[2] - b.pos[2]) > MFDVERT_EPSILON) {
    81				return false;
    82			}
    83			if(fabs(weights[0] - b.weights[0]) > MFDVERT_EPSILON) {
    84				return false;
    85			}
    86			if(fabs(weights[1] - b.weights[1]) > MFDVERT_EPSILON) {
    87				return false;
    88			}
    89			if(fabs(weights[2] - b.weights[2]) > MFDVERT_EPSILON) {
    90				return false;
    91			}
    92			if(fabs(normal[0] - b.normal[0]) > MFDVERT_EPSILON) {
    93				return false;
    94			}
    95			if(fabs(normal[1] - b.normal[1]) > MFDVERT_EPSILON) {
    96				return false;
    97			}
    98			if(fabs(normal[2] - b.normal[2]) > MFDVERT_EPSILON) {
    99				return false;
   100			}
   101			if(fabs(u - b.u) > MFDVERT_EPSILON) {
   102				return false;
   103			}
   104			if(fabs(v - b.v) > MFDVERT_EPSILON) {
   105				return false;
   106			}
   107	
   108			return true;
   109		}
