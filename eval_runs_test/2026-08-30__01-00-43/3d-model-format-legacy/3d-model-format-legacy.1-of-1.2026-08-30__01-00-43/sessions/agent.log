    86	
    87	class MdfFileStream 
    88		: public MdfStream
    89	{
    90	public:
    91		MdfFileStream() : fp(0), nDataLen(0) {}
    92		virtual ~MdfFileStream() { Close(); }
    93	
    94		bool Open(const char *szFilename) {
    95			fp = fopen(szFilename, "rb");
    96			if(fp) {
    97				fseek(fp, 0, SEEK_END);
    98				nDataLen = (int)ftell(fp);
    99				fseek(fp, 0, SEEK_SET);
   100				return true;
   101			} else {
   102				return false;
   103			}
   104		}
   105	
   106		void Close() {
   107			if(fp) {
   108				fclose(fp);
   109			}
   110			fp = 0;
   111			nDataLen = 0;
   112		}
   113	
   114		virtual bool Seek(int offset, int origin) {
   115			return(fseek(fp, offset, origin) == 0);
   116		}
   117	
   118		virtual int Tell() { return (int)ftell(fp); }
   119	
   120		virtual int Read(void *pDest, int nLength) {
   121			return (int)fread(pDest, 1, nLength, fp);
   122		}
   123	
   124		virtual int Length() { return nDataLen; }
   125	
   126	private:
   127		FILE *fp;
   128		int nDataLen;
   129	};
