   505	bool MdfFormat::LoadFromStream(MdfStream &stream)
   506	{
   507		if(m_vpMeshes || m_pData) {
   508			return false;
   509		}
   510		int nHeaderLength = sizeof(m_tMdfHeader);
   511	
   512		stream.Read(&m_tMdfHeader, nHeaderLength);
   513	
   514		// read the entire file
   515		m_nDataSize = stream.Length() - nHeaderLength;
   516		m_pData = (Byte*)malloc(m_nDataSize);
   517		stream.Read(m_pData, (int)m_nDataSize);
   518	
   519		int dataPos = 0;
   520	
   521		// check for textures and set their pointer
   522		if(m_tMdfHeader.nTextureCount > 0) {
   523			m_vpTextures = (char**)&m_pData[dataPos];
   524			dataPos += m_tMdfHeader.nTextureCount * sizeof(int);
   525		}
   526	
   527		// check for meshes and set their pointer
   528		if(m_tMdfHeader.nMeshCount > 0) {
   529			m_vpMeshes = (TMdfMesh*)&m_pData[dataPos];
   530			dataPos += m_tMdfHeader.nMeshCount * sizeof(TMdfMesh);
   531		}
   532	
   533		// check for animations and set their pointer
   534		if(m_tMdfHeader.nAnimCount > 0) {
   535			m_vpAnimations = (TMdfAnimation*)&m_pData[dataPos];
   536		}
   537	
   538		//
   539		// for each texture, fix up the pointers
   540		//
   541		for(size_t i = 0; i < m_tMdfHeader.nTextureCount; i++) {
   542			m_vpTextures[i] = (char*)(m_pData  + ((int)m_vpTextures[i]) - nHeaderLength);
   543		}
   544	
   545		//
   546		// for each mesh fix up the pointers
   547		//
   548		for(size_t i = 0; i < m_tMdfHeader.nMeshCount; i++) {
   549			m_vpMeshes[i].uVtxs.pVertices = m_pData + m_vpMeshes[i].uVtxs.nDataOffset - nHeaderLength;
   550			m_vpMeshes[i].uIdxs.pIndices = (unsigned short*)(m_pData + m_vpMeshes[i].uIdxs.nDataOffset - nHeaderLength);
   551			
   552			if(m_vpMeshes[i].nNumJoints > 0) {
   553				m_vpMeshes[i].uBnd.pBindMats = (TMdfMatrix4*)(m_pData + m_vpMeshes[i].uBnd.nDataOffset - nHeaderLength);
   554				m_vpMeshes[i].uPrnt.pParentInfo = (int*)(m_pData + m_vpMeshes[i].uPrnt.nDataOffset - nHeaderLength);
   555			} else {
   556				m_vpMeshes[i].uBnd.pBindMats = 0;
   557				m_vpMeshes[i].uPrnt.pParentInfo = 0;
   558			}
   559			dataPos += sizeof(TMdfMesh);
   560		}
   561	
   562		//
   563		// for each animation, fix up the pointers
   564		//
   565		for(size_t i = 0; i < m_tMdfHeader.nAnimCount; i++) {
   566			m_vpAnimations[i].uTls.pTimeline = (TMdfTimeline*)(m_pData + m_vpAnimations[i].uTls.nDataOffset - nHeaderLength);
   567	
   568			// fix up the time-line pointers
   569			for(int t = 0; t < m_vpAnimations[i].nNumTimelines; t++) {
   570				m_vpAnimations[i].uTls.pTimeline[t].uKfs.pKeyframes = (TMdfKeyframe*)(m_pData + m_vpAnimations[i].uTls.pTimeline[t].uKfs.nDataOffset - nHeaderLength);
   571			}
   572		}
   573	
   574		return true;
   575	}
   576	
   577	void MdfFormat::Destroy()
   578	{
   579		// clean up any additional memory and
   580		// reset all the internal state to default
   581	
   582		if(m_pData) {
   583			free(m_pData);
   584	
   585		} else {
   586			// release meshes
   587			for(unsigned int i = 0; i < m_nMeshArrayLength; i++) {
   588				free(m_vpMeshes[i].uVtxs.pVertices);
   589				free(m_vpMeshes[i].uIdxs.pIndices);
   590				free(m_vpMeshes[i].uBnd.pBindMats);
   591				free(m_vpMeshes[i].uPrnt.pParentInfo);
   592			}
   593	
   594			// release animations
   595			for(unsigned int i = 0; i < m_nAnimArrayLength; i++) {
   596	
   597				// release timelines
   598				for(int t = 0; t < m_vpAnimations[i].nNumTimelines; t++) {
   599					// release keyframes
   600					free(m_vpAnimations[i].uTls.pTimeline[t].uKfs.pKeyframes);
   601				}
   602				free(m_vpAnimations[i].uTls.pTimeline);
   603	
   604			}
   605	
   606			free(m_vpMeshes);
   607			free(m_vpAnimations);
   608	
   609			// release textures
   610			for(unsigned i = 0; i < m_tMdfHeader.nTextureCount; i++) {
   611				free(m_vpTextures[i]);
   612			}
   613			free(m_vpTextures);
   614	
   615		} // if(m_pData)
   616	
   617		m_pData = 0;
   618		m_vpMeshes = 0;
   619		m_vpAnimations = 0;
   620	
   621		m_vpTextures = 0;
   622		m_tMdfHeader.nTextureCount = 0;
   623	
   624		m_nMeshArrayLength = 0;
   625		m_nAnimArrayLength = 0;
   626		ZeroMemory(&m_tMdfHeader, sizeof(m_tMdfHeader));
   627	}
   628	
   629	MdfHandle MdfFormat::AddTexture(const char *szName)
   630	{
   631		size_t nameLen = strlen(szName);
   632		size_t insertIdx = 0;
   633	
   634	
   635		for(insertIdx = 0; insertIdx < m_tMdfHeader.nTextureCount; insertIdx++) {
   636			if(!strcmp(m_vpTextures[insertIdx], szName)) {
   637				return (MdfHandle)insertIdx;
   638			}
   639		}
   640	
   641		m_vpTextures = (char**)realloc(m_vpTextures, (insertIdx+1)*sizeof(char*) );
   642	
   643		m_vpTextures[insertIdx] = (char*)malloc(nameLen+1 * sizeof(char));
   644		strcpy(m_vpTextures[insertIdx], szName);
   645		m_vpTextures[insertIdx][nameLen] = 0;
   646	
   647		m_tMdfHeader.nTextureCount++;
   648	
   649		return (MdfHandle)insertIdx;
   650	}
   651	
   652	void MdfFormat::ByteAlignFile(FILE *fp) const
   653	{
   654		if(!m_tMdfHeader.nByteAlignment) {
   655			return;
   656		}
   657	
   658		size_t remainder = ftell(fp) % m_tMdfHeader.nByteAlignment;
   659		if(remainder) {
   660			remainder = m_tMdfHeader.nByteAlignment - remainder;
   661	
   662			int dummy = 0;
   663	
   664			for(size_t i = 0; i < remainder; i++) {
   665				fwrite(&dummy, 1, 1, fp);
   666			}
   667		}
   668	}
