#pragma once

#include "mdftypes.h"

#define MDF_BYTE_ALIGNMENT 16

class MdfStream;

class MdfFormat
{
	enum MdfElements {
		MDF_NONE		=	0,
		MDF_MESHES		=	1,
		MDF_TEXTURES	=	2,
		MDF_BINDMATS	=	4,
		MDF_PARENTINFO	=	8,
		MDF_ANIMATIONS	=	16,
		MDF_TRANSFORMS	=	32,
		MDF_ALL			= (MDF_MESHES|MDF_TEXTURES|MDF_BINDMATS|MDF_PARENTINFO|MDF_ANIMATIONS|MDF_TRANSFORMS)
