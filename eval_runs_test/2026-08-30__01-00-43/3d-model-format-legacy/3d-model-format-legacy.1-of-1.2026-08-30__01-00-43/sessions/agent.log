   159	
   160		m_tMdfHeader.nByteAlignment = MDF_BYTE_ALIGNMENT;
   161	
   162		if(nNumMeshesHint) {
   163			m_vpMeshes = (TMdfMesh*)malloc(nNumMeshesHint * sizeof(TMdfMesh));
   164			ZeroMemory(m_vpMeshes, nNumMeshesHint * sizeof(TMdfMesh));
   165			m_nMeshArrayLength = nNumMeshesHint;
   166	
   167			m_vpAnimations = (TMdfAnimation*)malloc(nNumMeshesHint * sizeof(TMdfAnimation));
   168			m_nAnimArrayLength = nNumMeshesHint;
   169		}
   170	
