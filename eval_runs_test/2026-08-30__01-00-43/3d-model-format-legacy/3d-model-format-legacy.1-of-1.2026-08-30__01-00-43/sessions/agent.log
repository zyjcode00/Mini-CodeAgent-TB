   554				m_vpMeshes[i].uPrnt.pParentInfo = (int*)(m_pData + m_vpMeshes[i].uPrnt.nDataOffset - nHeaderLength);
   555			} else {
   556				m_vpMeshes[i].uBnd.pBindMats = 0;
   557				m_vpMeshes[i].uPrnt.pParentInfo = 0;
   558			}
   559			dataPos += sizeof(TMdfMesh);
   560		}
   561	
   562		//
   563		// for each animation, fix up the pointers
   564		//
   565		for(size_t i = 0; i < m_tMdfHeader.nAnimCount; i++) {
   566			m_vpAnimations[i].uTls.pTimeline = (TMdfTimeline*)(m_pData + m_vpAnimations[i].uTls.nDataOffset - nHeaderLength);
   567	
   568			// fix up the time-line pointers
   569			for(int t = 0; t < m_vpAnimations[i].nNumTimelines; t++) {
   570				m_vpAnimations[i].uTls.pTimeline[t].uKfs.pKeyframes = (TMdfKeyframe*)(m_pData + m_vpAnimations[i].uTls.pTimeline[t].uKfs.nDataOffset - nHeaderLength);
   571			}
   572		}
   573	
   574		return true;
   575	}
   576	
   577	void MdfFormat::Destroy()
   578	{
   579		// clean up any additional memory and
   580		// reset all the internal state to default
   581	
   582		if(m_pData) {
   583			free(m_pData);
   584	
   585		} else {
   586			// release meshes
   587			for(unsigned int i = 0; i < m_nMeshArrayLength; i++) {
   588				free(m_vpMeshes[i].uVtxs.pVertices);
   589				free(m_vpMeshes[i].uIdxs.pIndices);
   590				free(m_vpMeshes[i].uBnd.pBindMats);
   591				free(m_vpMeshes[i].uPrnt.pParentInfo);
   592			}
   593	
   594			// release animations
   595			for(unsigned int i = 0; i < m_nAnimArrayLength; i++) {
   596	
   597				// release timelines
   598				for(int t = 0; t < m_vpAnimations[i].nNumTimelines; t++) {
   599					// release keyframes
   600					free(m_vpAnimations[i].uTls.pTimeline[t].uKfs.pKeyframes);
   601				}
   602				free(m_vpAnimations[i].uTls.pTimeline);
   603	
   604			}
   605	
   606			free(m_vpMeshes);
   607			free(m_vpAnimations);
   608	
   609			// release textures
   610			for(unsigned i = 0; i < m_tMdfHeader.nTextureCount; i++) {
   611				free(m_vpTextures[i]);
   612			}
   613			free(m_vpTextures);
   614	
   615		} // if(m_pData)
   616	
   617		m_pData = 0;
   618		m_vpMeshes = 0;
   619		m_vpAnimations = 0;
   620	
   621		m_vpTextures = 0;
   622		m_tMdfHeader.nTextureCount = 0;
   623	
   624		m_nMeshArrayLength = 0;
   625		m_nAnimArrayLength = 0;
   626		ZeroMemory(&m_tMdfHeader, sizeof(m_tMdfHeader));
   627	}
