	/// \return the index of the newly added texture name
	//////////////////////////////////////////////////////////////////////////
	MdfHandle AddTexture(const char *szName);

	void ByteAlignFile(FILE *fp) const;

private:
	// disable copy and assignment operator
	MdfFormat(MdfFormat &) {};
	MdfFormat & operator=(MdfFormat &) {}

};

