   150	bool MdfFormat::Create(unsigned int nNumMeshesHint/* =0 */)
   151	{
   152		if(m_vpMeshes != 0) {
   153			return false;
   154		}
   155	
   156		ZeroMemory(&m_tMdfHeader, sizeof(m_tMdfHeader));
   157	
