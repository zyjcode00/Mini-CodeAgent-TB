   374	
   375	bool MdfFormat::SaveToFile(const char *szFilename) const
   376	{
   377		FILE *fp;
   378	
   379		if(m_tMdfHeader.nMeshCount == 0) {
   380			return false;
   381		}
   382	
   383		fp = fopen(szFilename, "wb");
   384		if(!fp) {
   385			return false;
   386		}
   387	
   388	
   389	
   390		TMdfMesh *pHeaderMeshes = (TMdfMesh*)malloc(sizeof(TMdfMesh) * m_tMdfHeader.nMeshCount);
   391		TMdfAnimation *pHeaderAnims = (TMdfAnimation*)malloc(sizeof(TMdfAnimation) * m_tMdfHeader.nAnimCount);
   392	
   393		//
   394		// skip the header info for now, we'll write it later
   395		//
   396		int skipOffset = sizeof(MdfHeader);
   397		skipOffset += sizeof(TMdfMesh) * m_tMdfHeader.nMeshCount; // skip main mesh header
   398		skipOffset += sizeof(TMdfAnimation) * m_tMdfHeader.nAnimCount; // skip the animation headers
   399		skipOffset += sizeof(char *) * m_tMdfHeader.nTextureCount;  // skip the texture headers
   400		fseek(fp, skipOffset, SEEK_CUR);
   401	
   402		int *pHeaderTextures = (int*)malloc(m_tMdfHeader.nTextureCount * sizeof(int));
   403		//
   404		// for each texture, save the name
   405		//
   406		for(unsigned int i = 0; i < m_tMdfHeader.nTextureCount; i++) {
   407			size_t texLen = strlen(m_vpTextures[i]);
   408			pHeaderTextures[i] = (int)ftell(fp);
   409			fwrite(m_vpTextures[i], texLen+1, 1, fp);
   410		}
   411	
   412		//
   413		// for each mesh, save the data
   414		//
   415		for(unsigned int i = 0; i < m_tMdfHeader.nMeshCount; i++) {
   416			const TMdfMesh *pMesh = &m_vpMeshes[i];
   417			pHeaderMeshes[i] = *pMesh;
   418	
   419	
   420			// write out the vertices based on their type
   421			// write the verts
   422			ByteAlignFile(fp);
   423			pHeaderMeshes[i].uVtxs.nDataOffset = ftell(fp);
   424	
   425			if(pMesh->meshType == TMdfMesh::MESH_SKINNED) {
   426				fwrite(pMesh->uVtxs.pVertices, sizeof(TMdfVertSkn), pMesh->nNumVerts, fp);
   427			} else if(pMesh->meshType == TMdfMesh::MESH_STATIC) {
   428				fwrite(pMesh->uVtxs.pVertices, sizeof(TMdfVertSta), pMesh->nNumVerts, fp);
   429			}
   430	
   431			// write the indices
   432			ByteAlignFile(fp);
   433			pHeaderMeshes[i].uIdxs.nDataOffset = ftell(fp);
   434			fwrite(pMesh->uIdxs.pIndices, sizeof(unsigned short), pMesh->nNumIndices, fp);
   435	
   436			if(pMesh->meshType == TMdfMesh::MESH_SKINNED) {
   437				ByteAlignFile(fp);
   438				// write the bind-pose skin data
   439				pHeaderMeshes[i].uBnd.nDataOffset = ftell(fp);
   440				fwrite(pMesh->uBnd.pBindMats, sizeof(TMdfMatrix4), pMesh->nNumJoints, fp);
   441				
   442				ByteAlignFile(fp);
   443				// write out the parenting info
   444				pHeaderMeshes[i].uPrnt.nDataOffset = ftell(fp);
   445				fwrite(pMesh->uPrnt.pParentInfo, sizeof(int), pMesh->nNumJoints, fp);
   446			}
   447		}
   448	
   449		//
   450		// for each animation, save the data
   451		//
   452		for(unsigned int i = 0; i < m_tMdfHeader.nAnimCount; i++) {
   453			const TMdfAnimation *pAnim = &m_vpAnimations[i];
   454			pHeaderAnims[i] = *pAnim;
   455	
   456			TMdfTimeline *pHeaderTimelines = (TMdfTimeline *)malloc(pAnim->nNumTimelines * sizeof(TMdfTimeline));
   457	
   458			// for each time-line
   459			for(int t = 0; t < pAnim->nNumTimelines; t++) {
   460	
   461				const TMdfTimeline *pTimeline = &pAnim->uTls.pTimeline[t];
   462				pHeaderTimelines[t] = *pTimeline;
   463	
   464				// write out the keyframes
   465				ByteAlignFile(fp);
   466				pHeaderTimelines[t].uKfs.nDataOffset = ftell(fp);
   467				fwrite(pTimeline->uKfs.pKeyframes, sizeof(TMdfKeyframe), pTimeline->nKeyFrames, fp);
   468			}
   469	
   470			// write out the timelines
   471			ByteAlignFile(fp);
   472			pHeaderAnims[i].uTls.nDataOffset = ftell(fp);
   473			fwrite(pHeaderTimelines, sizeof(TMdfTimeline), pAnim->nNumTimelines, fp);
   474			free(pHeaderTimelines);
   475		}
   476	
   477		m_tMdfHeader.nTotalDataSize = (unsigned int)ftell(fp) - sizeof(MdfHeader);
   478	
   479		//
   480		// go back and write out the headers
   481		//
   482		fseek(fp, 0, SEEK_SET);
   483	
   484		// write the main header
   485		fwrite(&m_tMdfHeader, sizeof(m_tMdfHeader), 1, fp);
   486	
   487		// used textures header
   488		fwrite(pHeaderTextures, sizeof(int), m_tMdfHeader.nTextureCount, fp);
   489	
   490		// mesh headers
   491		fwrite(pHeaderMeshes, sizeof(TMdfMesh), m_tMdfHeader.nMeshCount, fp);
   492	
   493		// animation headers
   494		fwrite(pHeaderAnims, sizeof(TMdfAnimation), m_tMdfHeader.nAnimCount, fp);
   495	
   496		fclose(fp);
   497	
   498		free(pHeaderMeshes);
   499		free(pHeaderAnims);
   500		free(pHeaderTextures);
   501	
   502		return true;
   503	}
