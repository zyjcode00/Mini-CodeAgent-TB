    16	class MdfMemStream 
    17		: public MdfStream
    18	{
    19	public:
    20		MdfMemStream(Byte *pData, int nDataLen) : pData(pData), nDataLen(nDataLen), nPos(0) {}
    21		virtual ~MdfMemStream() {}
    22	
    23		virtual bool Seek(int offset, int origin);
    24		virtual int Tell();
    25		virtual int Read(void *pDest, int nLength);
    26		virtual int Length();
    27	
    28	private:
    29		Byte *pData;
    30		int nDataLen;
    31		int nPos;
    32	
    33	};
    34	
    35	bool MdfMemStream::Seek(int offset, int origin)
    36	{
    37		switch(origin) {
    38			case SEEK_SET:
    39			{
    40				if(offset < 0 || offset > nDataLen) {
    41					return false;
    42				}
    43				nPos = offset;
    44			} break;
    45			case SEEK_CUR:
    46			{
    47				register int test = nPos += offset;
    48				if(test < 0 || test > nDataLen) {
    49					return false;
    50				}
    51				nPos += offset;
    52			} break;
    53			case SEEK_END:
    54			{
    55				register int test = nPos += offset;
    56				if(test < 0 || test > nDataLen) {
    57					return false;
    58				}
    59				nPos = nDataLen - origin;
    60			} break;
    61		}
    62		return true;
    63	}
    64	
    65	int MdfMemStream::Tell()
    66	{
    67		return nPos;
    68	}
    69	
    70	int MdfMemStream::Read(void *pDest, int nLength)
    71	{
    72		if(nPos + nLength >= nDataLen) {
    73			nLength = nDataLen - nPos;
    74		}
    75		memcpy(pDest, &pData[nPos], nLength);
    76		nPos += nLength;
    77		return nLength;
    78	}
    79	
    80	int MdfMemStream::Length()
    81	{
    82		return nDataLen;
    83	}
