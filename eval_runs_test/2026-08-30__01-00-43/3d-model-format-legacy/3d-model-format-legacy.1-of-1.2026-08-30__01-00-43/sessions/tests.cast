[16.584496, "o", "\u001b[31m\u001b[1m___________________________________________________________________ test_cmake_build_and_run ___________________________________________________________________\u001b[0m\r\n\r\n"]
[16.605436, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_cmake_build_and_run\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Test that CMake can build the project and the executable runs successfully.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        cmake_files = \u001b[96mlist\u001b[39;49;00m(BASE_PATH.rglob(\u001b[33m\"\u001b[39;49;00m\u001b[33mCMakeLists.txt\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m))\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94massert\u001b[39;49;00m \u001b[96mlen\u001b[39;49;00m(cmake_files) > \u001b[94m0\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mNo CMakeLists.txt found\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        success = \u001b[94mFalse\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        errors = []\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94mfor\u001b[39;49;00m cmake_file \u001b[95min\u001b[39;49;00m cmake_files:\u001b[90m\u001b[39;49;00m\r\n            source_dir = cmake_file.parent\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n            \u001b[94mwith\u001b[39;49;00m tempfile.TemporaryDirectory() \u001b[94mas\u001b[39;49;00m build_dir:\u001b[90m\u001b[39;49;00m\r\n                \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n                    \u001b[90m# Step 1: Configure with CMake\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n                    config_result = subprocess.run(\u001b[90m\u001b[39;49;00m\r\n                        [\u001b[33m\"\u001b[39;49;00m\u001b[33mcmake\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33m-S\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[96mstr\u001b[39;49;00m(source_dir), \u001b[33m\"\u001b[39;49;00m\u001b[33m-B\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, build_dir],\u001b[90m\u001b[39;49;00m\r\n                        capture_output=\u001b[94mTrue\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n"]
[16.605762, "o", "                        text=\u001b[94mTrue\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n                        timeout=\u001b[94m30\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n                    )\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n                    \u001b[94mif\u001b[39;49;00m config_result.returncode != \u001b[94m0\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n                        errors.append({\u001b[90m\u001b[39;49;00m\r\n                            \u001b[33m\"\u001b[39;49;00m\u001b[33mcmake_file\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[96mstr\u001b[39;49;00m(cmake_file),\u001b[90m\u001b[39;49;00m\r\n                            \u001b[33m\"\u001b[39;49;00m\u001b[33mstage\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[33m\"\u001b[39;49;00m\u001b[33mconfigure\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n                            \u001b[33m\"\u001b[39;49;00m\u001b[33mstderr\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: config_result.stderr[:\u001b[94m500\u001b[39;49;00m]\u001b[90m\u001b[39;49;00m\r\n                        })\u001b[90m\u001b[39;49;00m\r\n                        \u001b[94mcontinue\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n                    \u001b[90m# Step 2: Build with CMake\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n                    build_result = subprocess.run(\u001b[90m\u001b[39;49;00m\r\n                        [\u001b[33m\"\u001b[39;49;00m\u001b[33mcmake\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33m--build\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, build_dir],\u001b[90m\u001b[39;49;00m\r\n                        capture_output=\u001b[94mTrue\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n                        text=\u001b[94mTrue\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n                        timeout=\u001b[94m120\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n                    )\u001b[90m\u001b[39;49;00m"]
[16.605963, "o", "\r\n    \u001b[90m\u001b[39;49;00m\r\n                    \u001b[94mif\u001b[39;49;00m build_result.returncode != \u001b[94m0\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n                        errors.append({\u001b[90m\u001b[39;49;00m\r\n                            \u001b[33m\"\u001b[39;49;00m\u001b[33mcmake_file\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[96mstr\u001b[39;49;00m(cmake_file),\u001b[90m\u001b[39;49;00m\r\n                            \u001b[33m\"\u001b[39;49;00m\u001b[33mstage\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[33m\"\u001b[39;49;00m\u001b[33mbuild\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n                            \u001b[33m\"\u001b[39;49;00m\u001b[33mstderr\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: build_result.stderr[:\u001b[94m500\u001b[39;49;00m]\u001b[90m\u001b[39;49;00m\r\n                        })\u001b[90m\u001b[39;49;00m\r\n                        \u001b[94mcontinue\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n                    \u001b[90m# Step 3: Find executable(s) in the build directory\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n                    build_path = Path(build_dir)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n                    \u001b[90m# Look for executables (files with execute permission or common names)\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n                    executables = []\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n                    \u001b[90m# Search for common executable patterns\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n                    \u001b[94mfor\u001b[39;49;00m item \u001b[95min\u001b[39;49;00m build_path.rglob(\u001b[33m\"\u001b[39;49;00m\u001b[33m*\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m):\u001b[90m\u001b[39;49;00m\r\n                        \u001b[94mif\u001b[39;49;00m item.is_file():\u001b[90m\u001b[39;49;00m\r\n                     