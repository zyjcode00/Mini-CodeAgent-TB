[338.277766, "o", "   620\t\r\n   621\t\tm_vpTextures = 0;\r\n   622\t\tm_tMdfHeader.nTextureCount = 0;\r\n   623\t\r\n   624\t\tm_nMeshArrayLength = 0;\r\n   625\t\tm_nAnimArrayLength = 0;\r\n   626\t\tZeroMemory(&m_tMdfHeader, sizeof(m_tMdfHeader));\r\n   627\t}\r\n   628\t\r\n   629\tMdfHandle MdfFormat::AddTexture(const char *szName)\r\n   630\t{\r\n   631\t\tsize_t nameLen = strlen(szName);\r\n   632\t\tsize_t insertIdx = 0;\r\n   633\t\r\n   634\t\r\n   635\t\tfor(insertIdx = 0; insertIdx < m_tMdfHeader.nTextureCount; insertIdx++) {\r\n   636\t\t\tif(!strcmp(m_vpTextures[insertIdx], szName)) {\r\n   637\t\t\t\treturn (MdfHandle)insertIdx;\r\n   638\t\t\t}\r\n   639\t\t}\r\n   640\t\r\n   641\t\tm_vpTextures = (char**)realloc(m_vpTextures, (insertIdx+1)*sizeof(char*) );\r\n   642\t\r\n   643\t\tm_vpTextures[insertIdx] = (char*)malloc(nameLen+1 * sizeof(char));\r\n   644\t\t"]
[338.277959, "o", "strcpy(m_vpTextures[insertIdx], szName);\r\n   645\t\tm_vpTextures[insertIdx][nameLen] = 0;\r\n   646\t\r\n   647\t\tm_tMdfHeader.nTextureCount++;\r\n   648\t\r\n   649\t\treturn (MdfHandle)insertIdx;\r\n   650\t}\r\n   651\t\r\n   652\tvoid MdfFormat::ByteAlignFile(FILE *fp) const\r\n   653\t{\r\n   654\t\tif(!m_tMdfHeader.nByteAlignment) {\r\n   655\t\t\treturn;\r\n   656\t\t}\r\n   657\t\r\n   658\t\tsize_t remainder = ftell(fp) % m_tMdfHeader.nByteAlignment;\r\n   659\t\tif(remainder) {\r\n   660\t\t\tremainder = m_tMdfHeader.nByteAlignment - remainder;\r\n   661\t\r\n   662\t\t\tint dummy = 0;\r\n   663\t\r\n   664\t\t\tfor(size_t i = 0; i < remainder; i++) {\r\n   665\t\t\t\tfwrite(&dummy, 1, 1, fp);\r\n   666\t\t\t}\r\n   667\t\t}\r\n   668\t}\r\n"]
