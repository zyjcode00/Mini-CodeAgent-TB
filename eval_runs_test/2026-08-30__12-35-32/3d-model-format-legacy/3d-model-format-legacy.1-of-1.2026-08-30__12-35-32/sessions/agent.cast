[437.185401, "o", "\u001b[32m\u001b[K201\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kstruct TMdfMesh\u001b[m\u001b[K\r\n\u001b[32m\u001b[K288\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kstruct TMdfKeyframe\u001b[m\u001b[K\r\n\u001b[32m\u001b[K309\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kstruct TMdfTimeline\u001b[m\u001b[K\r\n"]
[437.187077, "o", "\u001b[35m\u001b[Kmdftypes.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K10\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktypedef int MdfHandle\u001b[m\u001b[K;\r\n"]
[437.187321, "o", "\u001b[35m\u001b[Kmdftypes.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K125\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kstruct TMdfMatrix4\u001b[m\u001b[K\r\n"]
