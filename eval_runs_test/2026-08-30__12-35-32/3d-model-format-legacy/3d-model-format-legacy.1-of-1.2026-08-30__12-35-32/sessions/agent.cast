[166.107031, "o", "     1\t#include \"StdAfx.h\"\r\n     2\t#include \"MdfFormat.h\"\r\n     3\t#include <stdlib.h>\r\n     4\t\r\n     5\tconst char MDF_VER_STR[8] = {\r\n     6\t\t'M',\r\n     7\t\t'D',\r\n     8\t\t'F',\r\n     9\t\t' ',\r\n    10\t\t'v',\r\n    11\t\t'1',\r\n    12\t\t'.',\r\n    13\t\t'2'\r\n    14\t};\r\n    15\t\r\n    16\tclass MdfMemStream \r\n"]
[166.10724, "o", "    17\t\t: public MdfStream\r\n    18\t{\r\n    19\tpublic:\r\n    20\t\tMdfMemStream(Byte *pData, int nDataLen) : pData(pData), nDataLen(nDataLen), nPos(0) {}\r\n    21\t\tvirtual ~MdfMemStream() {}\r\n    22\t\r\n    23\t\tvirtual bool Seek(int offset, int origin);\r\n    24\t\tvirtual int Tell();\r\n    25\t\tvirtual int Read(void *pDest, int nLength);\r\n    26\t\tvirtual int Length();\r\n    27\t\r\n    28\tprivate:\r\n    29\t\tByte *pData;\r\n    30\t\tint nDataLen;\r\n    31\t\tint nPos;\r\n    32\t\r\n    33\t};\r\n    34\t\r\n    35\tbool MdfMemStream::Seek(int offset, int origin)\r\n    36\t{\r\n    37\t\tswitch(origin) {\r\n    38\t\t\tcase SEEK_SET:\r\n    39\t\t\t{\r\n    40\t\t\t\tif(offset < 0 || offset > nDataLen) {\r\n    41\t\t\t\t\treturn false;\r\n    42\t\t\t\t}\r\n    43\t\t\t\tnPos = offset;\r\n    44\t\t\t} break;\r\n"]
[166.107438, "o", "    45\t\t\tcase SEEK_CUR:\r\n    46\t\t\t{\r\n    47\t\t\t\tregister int test = nPos += offset;\r\n    48\t\t\t\tif(test < 0 || test > nDataLen) {\r\n    49\t\t\t\t\treturn false;\r\n    50\t\t\t\t}\r\n    51\t\t\t\tnPos += offset;\r\n    52\t\t\t} break;\r\n    53\t\t\tcase SEEK_END:\r\n    54\t\t\t{\r\n    55\t\t\t\tregister int test = nPos += offset;\r\n    56\t\t\t\tif(test < 0 || test > nDataLen) {\r\n"]
[166.107594, "o", "    57\t\t\t\t\treturn false;\r\n    58\t\t\t\t}\r\n    59\t\t\t\tnPos = nDataLen - origin;\r\n    60\t\t\t} break;\r\n    61\t\t}\r\n    62\t\treturn true;\r\n    63\t}\r\n    64\t\r\n    65\tint MdfMemStream::Tell()\r\n    66\t{\r\n    67\t\treturn nPos;\r\n    68\t}\r\n    69\t\r\n    70\tint MdfMemStream::Read(void *pDest, int nLength)\r\n    71\t{\r\n    72\t\tif(nPos + nLength >= nDataLen) {\r\n    73\t\t\tnLength = nDataLen - nPos;\r\n    74\t\t}\r\n    75\t\tmemcpy(pDest, &pData[nPos], nLength);\r\n    76\t\tnPos += nLength;\r\n    77\t\treturn nLength;\r\n    78\t}\r\n    79\t\r\n    80\tint MdfMemStream::Length()\r\n    81\t{\r\n    82\t\treturn nDataLen;\r\n    83\t}\r\n    84\t\r\n    85\t//////////////////////////////////////////////////////////////////////////\r\n    86\t\r\n    87\tclass MdfFileStream \r\n"]
