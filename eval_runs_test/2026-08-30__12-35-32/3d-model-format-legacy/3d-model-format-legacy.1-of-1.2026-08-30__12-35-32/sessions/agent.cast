[206.783878, "o", "#pragma once\r\n#include \"types.h\"\r\n#include <math.h>\r\n#include <vector>\r\n#include <string>\r\n\r\n#define MFDVERT_EPSILON 0.0001f\r\n\r\n\r\ntypedef int MdfHandle;\r\n\r\n//////////////////////////////////////////////////////////////////////////"]
[206.784138, "o", "\r\n/// \\brief MDF File Header\r\n/// \\author Ivgeni Segal\r\n/// \\date January 20, 2007\r\n///\r\n/// MDF File header is the structure stored at the beginning\r\n/// of the file and identifies its version and contents\r\n///\r\n//////////////////////////////////////////////////////////////////////////\r\nstruct MdfHeader \r\n{ \r\n\tchar cId[8]; // 'MDF v1.0'\r\n\r\n\tunsigned int nMeshCount;\t\t///< Number of meshes in this file\r\n\tunsigned int nAnimCount;\t\t///< Number of animations in this file\r\n\tunsigned int nTextureCount;\t\t///< Total number of texture names\r\n\tunsigned int nByteAlignment;\t///< Current byte alignment of the file\r\n\tunsigned int nNumHierarchies;\t///< Unused\r\n\r\n\tunsigned int nTotalDataSize;\t///< Total size of the data excluding\r\n\t\t\t\t\t\t\t\t\t///< the header"]
[206.784361, "o", "\r\n};\r\n\r\n//////////////////////////////////////////////////////////////////////////\r\n\r\n//\r\n\r\n//\r\n\r\n//////////////////////////////////////////////////////////////////////////\r\n/// \\brief Transitional vertex format\r\n/// \\author Ivgeni Segal\r\n/// \\date January 20, 2007\r\n///\r\n/// transitional vertex format for use with exporters.\r\n/// This structure is used by the mesh-building functions of the MDF \r\n/// format object. do not use for loading.\r\n///\r\n///\r\n//////////////////////////////////////////////////////////////////////////\r\nstruct MdfFullVertex {\r\n\tfloat pos[3];\r\n\r\n\tfloat weights[3];\r\n\tunsigned char bones[4];\r\n\r\n\tfloat normal[3];\r\n\tfloat u, v;\r\n\r\n\tbool operator==(const MdfFullVertex &b) const {\r\n\t\tif(bones[0] != b.bones[0]){\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\tif(bones[1] != b.bones[1]){\r\n"]
[206.784535, "o", "\t\t\treturn false;\r\n\t\t}\r\n\t\tif(bones[2] != b.bones[2]){\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\tif(bones[3] != b.bones[3]){\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\tif(fabs(pos[0] - b.pos[0]) > MFDVERT_EPSILON) {\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\tif(fabs(pos[1] - b.pos[1]) > MFDVERT_EPSILON) {\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\tif(fabs(pos[2] - b.pos[2]) > MFDVERT_EPSILON) {\r\n\t\t\treturn false;\r\n"]
[206.784706, "o", "\t\t}\r\n\t\tif(fabs(weights[0] - b.weights[0]) > MFDVERT_EPSILON) {\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\tif(fabs(weights[1] - b.weights[1]) > MFDVERT_EPSILON) {\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\tif(fabs(weights[2] - b.weights[2]) > MFDVERT_EPSILON) {\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\tif(fabs(normal[0] - b.normal[0]) > MFDVERT_EPSILON) {\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\tif(fabs(normal[1] - b.normal[1]) > MFDVERT_EPSILON) {\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\tif(fabs(normal[2] - b.normal[2]) > MFDVERT_EPSILON) {\r\n\t\t\treturn false;\r\n\t\t}\r\n\t"]
[206.784871, "o", "\tif(fabs(u - b.u) > MFDVERT_EPSILON) {\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\tif(fabs(v - b.v) > MFDVERT_EPSILON) {\r\n\t\t\treturn false;\r\n\t\t}\r\n\r\n\t\treturn true;\r\n\t}\r\n\r\n};\r\n"]
[206.785073, "o", "\r\n//////////////////////////////////////////////////////////////////////////\r\n/// \\brief Generic 4x4 matrix\r\n/// \\author Ivgeni Segal\r\n/// \\date January 20, 2007\r\n///\r\n/// Generic matrix used in the MDF format\r\n///\r\n/// \\remarks MDF uses row-major matrices, if you need to use MDF in a\r\n///\t\t\t column-major environment such as OpenGL don't forget to\r\n///\t\t\t transpose them.\r\n///\r\n//////////////////////////////////////////////////////////////////////////\r\nstruct TMdfMatrix4\r\n{\r\n\tfloat\te[16];\r\n};\r\n\r\n//////////////////////////////////////////////////////////////////////////\r\n/// \\brief Skinned vertex for animation\r\n/// \\author Ivgeni Segal\r\n/// \\date January 20, 2007\r\n///\r\n/// \\remarks Skinned vertex is present in animated meshes and supports\r\n///\tup to four bones per vertex\r\n///\r\n//////////////////////////////////////////////////////////////////////////\r\nstruct TMdfVertSkn\r\n{\r\n\tFloat3 pos;\r\n\tfloat weights[3];\r\n\tunsigned char bones[4];\r\n\r\n"]
[206.785284, "o", "\tFloat3 normal;\r\n\tFloat2 texcoord;\r\n};\r\n\r\n//////////////////////////////////////////////////////////////////////////\r\n/// \\brief Vertex for static meshes\r\n/// \\author Ivgeni Segal\r\n/// \\date January 20, 2007\r\n///\r\n/// \\remarks All static geometry in MDF uses this vertex format,\r\n///\t\t\t he UV coordinates are in DirectX form\r\n///\r\n//////////////////////////////////////////////////////////////////////////\r\nstruct TMdfVertSta\r\n{\r\n\tFloat3 pos;\t\t\t///< Vertex position in model space\r\n\r\n"]
[206.785473, "o", "\tFloat3 normal;\t\t///< Vertex normal\r\n\tFloat2 texcoord;\t///< UV Texture coordinate\r\n\r\n\tTMdfVertSta & operator=(const TMdfVertSkn &rhs) {\r\n\t\tpos.x = rhs.pos.x;\r\n\t\tpos.y = rhs.pos.y;\r\n\t\tpos.z = rhs.pos.z;\r\n\r\n\t\tnormal.x = rhs.normal.x;\r\n\t\tnormal.y = rhs.normal.y;\r\n\t\tnormal.z = rhs.normal.z;\r\n\r\n\t\ttexcoord.u = rhs.texcoord.u;\r\n\t\ttexcoord.v = rhs.texcoord.v;\r\n\t\treturn *this;\r\n\t}\r\n};\r\n\r\n"]
[206.785655, "o", "\r\n\r\n//////////////////////////////////////////////////////////////////////////\r\n/// \\brief A single Mesh Object\r\n/// \\author Ivgeni Segal\r\n/// \\date January 20, 2007\r\n///\r\n/// \\remarks The nDataOffset elements are the positions\r\n/// relative to the beginning of the MDF file.\r\n/// once the file is loaded they are converted into memory locations.\r\n"]
[206.78577, "o", "/// \\par\r\n/// The TMdfMesh Object contains all the information needed to display a mesh\r\n/// In addition to vertex information, the Mesh Object stores optional\r\n/// bind-pose matrix array for animation as well as parenting information\r\n/// for the joints. All joints are stored in depth-first order of the joint hierarchy.\r\n/// \\par\r\n/// Both of the arrays are parallel to the joint-keyframe\r\n/// arrays in the the TMdfAnimation Object that corresponds to this mesh.\r\n///\r\n///\r\n"]
[206.785972, "o", "//////////////////////////////////////////////////////////////////////////\r\nstruct TMdfMesh\r\n{\r\n\tunsigned int\tnNumVerts;\t\t///< Number of vertices in this mesh\r\n\tunsigned int\tnNumIndices;\t///< Number of vertex indexes\r\n\tunsigned int\tnNumJoints;\t\t///< Number of joints in stored bind\r\n\t\t\t\t\t\t\t\t\t///< pose and parenting arrays\r\n\tMdfHandle\t\thTexture;\t\t///< Index of the texture name\r\n\tint meshType;\t\t\t\t\t///< Mesh type (See MeshType enum)\r\n\r\n\t///\r\n\t/// Mesh vertex array\r\n\t///\r\n"]
[206.786152, "o", "\tunion UVerts_t {\t// reference to the vertices\r\n\t\tvoid *pVertices;\t\t\t///< Vertexes when in memory\r\n\t\tint nDataOffset;\t\t\t///< Offset to vertexes when in file\r\n\t} uVtxs;\r\n\r\n\t///\r\n\t/// Mesh index array\r\n\t///\r\n"]
[206.786506, "o", "\u001b[?2004hroot@09247f3a7949:/app/MdfLib# "]
[206.78675, "o", "true; tmux wait -S done\r\n\u001b[?2004l\r"]
[206.790524, "o", "\u001b[?2004hroot@09247f3a7949:/app/MdfLib# "]
[217.436064, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\ncd /app/MdfLib && sed -n '1,220p' mdftypes.h && sed -n '220,480p' mdftypes.h && sed -n '1,120p' MdfFormat.h && sed -n '120,260p' MdfFormat.h && sed -n '1,260p' MdfFormat.cpp\ntrue; tmux wait -S done\r"]
[217.436694, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
[217.436847, "o", "\u001b[?2004hroot@09247f3a7949:/app/MdfLib# "]
[217.437616, "o", "cd /app/MdfLib && sed -n '1,220p' mdftypes.h && sed -n '220,480p' mdftypes.h && sed -n '1,120p' MdfFormat.h && sed -n '120,260p' MdfFormat.h && sed -n '1,260p' MdfFormat.cpp\r\n\u001b[?2004l\r"]
[217.439044, "o", "#pragma once\r\n#include \"types.h\"\r\n#include <math.h>\r\n#include <vector>\r\n#include <string>\r\n\r\n#define MFDVERT_EPSILON 0.0001f\r\n\r\n\r\ntypedef int MdfHandle;\r\n\r\n//////////////////////////////////////////////////////////////////////////\r\n/// \\brief MDF File Header\r\n/// \\author Ivgeni Segal\r\n/// \\date January 20, 2007\r\n///\r\n/// MDF File header is the structure stored at the beginning\r\n/// of the file and identifies its version and contents\r\n///\r\n//////////////////////////////////////////////////////////////////////////\r\n"]
[217.439286, "o", "struct MdfHeader \r\n{ \r\n\tchar cId[8]; // 'MDF v1.0'\r\n\r\n\tunsigned int nMeshCount;\t\t///< Number of meshes in this file\r\n\tunsigned int nAnimCount;\t\t///< Number of animations in this file\r\n\tunsigned int nTextureCount;\t\t///< Total number of texture names\r\n\tunsigned int nByteAlignment;\t///< Current byte alignment of the file\r\n\tunsigned int nNumHierarchies;\t///< Unused\r\n\r\n\tunsigned int nTotalDataSize;\t///< Total size of the data excluding\r\n\t\t\t\t\t\t\t\t\t///< the header\r\n};\r\n\r\n//////////////////////////////////////////////////////////////////////////\r\n\r\n//\r\n\r\n//\r\n\r\n//////////////////////////////////////////////////////////////////////////\r\n/// \\brief Transitional vertex format\r\n/// \\author Ivgeni Segal\r\n/// \\date January 20, 2007\r\n///\r\n/// transitional vertex format for use with exporters.\r\n"]
[217.439512, "o", "/// This structure is used by the mesh-building functions of the MDF \r\n/// format object. do not use for loading.\r\n///\r\n///\r\n//////////////////////////////////////////////////////////////////////////\r\nstruct MdfFullVertex {\r\n\tfloat pos[3];\r\n\r\n\tfloat weights[3];\r\n\tunsigned char bones[4];\r\n\r\n\tfloat normal[3];\r\n\tfloat u, v;\r\n\r\n\tbool operator==(const MdfFullVertex &b) const {\r\n\t\tif(bones[0] != b.bones[0]){\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\tif(bones[1] != b.bones[1]){\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\tif(bones[2] != b.bones[2]){\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\tif(bones[3] != b.bones[3]){\r\n\t\t\treturn false;\r\n\t\t}\r\n"]
[217.439625, "o", "\t\tif(fabs(pos[0] - b.pos[0]) > MFDVERT_EPSILON) {\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\tif(fabs(pos[1] - b.pos[1]) > MFDVERT_EPSILON) {\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\tif(fabs(pos[2] - b.pos[2]) > MFDVERT_EPSILON) {\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\tif(fabs(weights[0] - b.weights[0]) > MFDVERT_EPSILON) {\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\tif(fabs(weights[1] - b.weights[1]) > MFDVERT_EPSILON) {\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\tif(fabs(weights[2] - b.weights[2]) > MFDVERT_EPSILON) {\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\tif(fabs(normal[0] - b.normal[0]) > MFDVERT_EPSILON) {\r\n\t\t\treturn false;\r\n\t\t}\r\n"]
[217.43989, "o", "\t\tif(fabs(normal[1] - b.normal[1]) > MFDVERT_EPSILON) {\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\tif(fabs(normal[2] - b.normal[2]) > MFDVERT_EPSILON) {\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\tif(fabs(u - b.u) > MFDVERT_EPSILON) {\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\tif(fabs(v - b.v) > MFDVERT_EPSILON) {\r\n\t\t\treturn false;\r\n\t\t}\r\n\r\n\t\treturn true;\r\n\t}\r\n\r\n};\r\n\r\n//////////////////////////////////////////////////////////////////////////\r\n/// \\brief Generic 4x4 matrix\r\n/// \\author Ivgeni Segal\r\n/// \\date January 20, 2007\r\n///\r\n/// Generic matrix used in the MDF format\r\n///\r\n/// \\remarks MDF uses row-major matrices, if you need to use MDF in a\r\n///\t\t\t column-major environment such as OpenGL don't forget to\r\n///\t\t\t transpose them.\r\n///\r\n//////////////////////////////////////////////////////////////////////////\r\n"]
[217.440117, "o", "struct TMdfMatrix4\r\n{\r\n\tfloat\te[16];\r\n};\r\n\r\n//////////////////////////////////////////////////////////////////////////\r\n/// \\brief Skinned vertex for animation\r\n/// \\author Ivgeni Segal\r\n/// \\date January 20, 2007\r\n///\r\n/// \\remarks Skinned vertex is present in animated meshes and supports\r\n///\tup to four bones per vertex\r\n///\r\n//////////////////////////////////////////////////////////////////////////\r\nstruct TMdfVertSkn\r\n{\r\n\tFloat3 pos;\r\n\tfloat weights[3];\r\n\tunsigned char bones[4];\r\n\r\n\tFloat3 normal;\r\n\tFloat2 texcoord;\r\n};\r\n\r\n//////////////////////////////////////////////////////////////////////////\r\n/// \\brief Vertex for static meshes\r\n/// \\author Ivgeni Segal\r\n/// \\date January 20, 2007\r\n///\r\n/// \\remarks All static geometry in MDF uses this vertex format,\r\n///\t\t\t he UV coordinates are in DirectX form\r\n///\r\n//////////////////////////////////////////////////////////////////////////\r\nstruct TMdfVertSta\r\n{\r\n"]
[217.440215, "o", "\tFloat3 pos;\t\t\t///< Vertex position in model space\r\n\r\n\tFloat3 normal;\t\t///< Vertex normal\r\n\tFloat2 texcoord;\t///< UV Texture coordinate\r\n\r\n\tTMdfVertSta & operator=(const TMdfVertSkn &rhs) {\r\n\t\tpos.x = rhs.pos.x;\r\n"]
[217.440431, "o", "\t\tpos.y = rhs.pos.y;\r\n\t\tpos.z = rhs.pos.z;\r\n\r\n\t\tnormal.x = rhs.normal.x;\r\n\t\tnormal.y = rhs.normal.y;\r\n\t\tnormal.z = rhs.normal.z;\r\n\r\n\t\ttexcoord.u = rhs.texcoord.u;\r\n\t\ttexcoord.v = rhs.texcoord.v;\r\n\t\treturn *this;\r\n\t}\r\n};\r\n\r\n\r\n\r\n//////////////////////////////////////////////////////////////////////////\r\n/// \\brief A single Mesh Object\r\n/// \\author Ivgeni Segal\r\n/// \\date January 20, 2007\r\n///\r\n/// \\remarks The nDataOffset elements are the positions\r\n/// relative to the beginning of the MDF file.\r\n/// once the file is loaded they are converted into memory locations.\r\n/// \\par\r\n/// The TMdfMesh Object contains all the information needed to display a mesh\r\n/// In addition to vertex information, the Mesh Object stores optional\r\n/// bind-pose matrix array for animation as well as parenting information\r\n"]
[217.440623, "o", "/// for the joints. All joints are stored in depth-first order of the joint hierarchy.\r\n/// \\par\r\n/// Both of the arrays are parallel to the joint-keyframe\r\n/// arrays in the the TMdfAnimation Object that corresponds to this mesh.\r\n///\r\n///\r\n//////////////////////////////////////////////////////////////////////////\r\nstruct TMdfMesh\r\n{\r\n\tunsigned int\tnNumVerts;\t\t///< Number of vertices in this mesh\r\n\tunsigned int\tnNumIndices;\t///< Number of vertex indexes\r\n\tunsigned int\tnNumJoints;\t\t///< Number of joints in stored bind\r\n\t\t\t\t\t\t\t\t\t///< pose and parenting arrays\r\n\tMdfHandle\t\thTexture;\t\t///< Index of the texture name\r\n\tint meshType;\t\t\t\t\t///< Mesh type (See MeshType enum)\r\n\r\n\t///\r\n\t/// Mesh vertex array\r\n"]
[217.440755, "o", "\t///\r\n\tunion UVerts_t {\t// reference to the vertices\r\n\t\tvoid *pVertices;\t\t\t///< Vertexes when in memory\r\n\t\tint nDataOffset;\t\t\t///< Offset to vertexes when in file\r\n\t} uVtxs;\r\n\r\n\t///\r\n\t/// Mesh index array\r\n\t///\r\n"]
[217.442299, "o", "\t///\r\n\tunion UIdxs_t {\r\n\t\tunsigned short *pIndices;\t///< Index array in memory\r\n\t\tint nDataOffset;\t\t\t///< Offset to index array in file\r\n\t} uIdxs;\r\n\r\n\t///\r\n\t/// Mesh bind-pose matrices (Animated Meshes only)\r\n\t///\r\n\tunion UBind_t {\r\n\t\tTMdfMatrix4 *pBindMats;\t\t///< Bind matrix array in memory\r\n\t\t\t\t\t\t\t\t\t///< will be NULL if no bind information\r\n\r\n\t\tint nDataOffset;\t\t\t///< Offset to bind matrix array in file\r\n\t} uBnd;\r\n\r\n\t///\r\n\t/// Parent index map (Animated Meshes only)\r\n\t///\r\n\tunion UPrnt_t {\t\t// reference to the (optional) hierarchy (parent info)\r\n\t\tint *pParentInfo;\t\t\t///< Parent index array in memory\r\n\t\t\t\t\t\t\t\t\t///< this array is parallel to the joint\r\n\t\t\t\t\t\t\t\t\t///< arrays of this mesh. The index values\r\n\t\t\t\t\t\t\t\t\t///< correspond to all of the joint arrays:\r\n\t\t\t\t\t\t\t\t\t///< pParentInfo[jointIndex] = parentIndex\r\n\t\t\t\t\t\t\t\t\t///< If a joint has no parent, it's\r\n\t\t\t\t\t\t\t\t\t///< index value is -1\r\n"]
[217.442665, "o", "\r\n\t\tint nDataOffset;\t\t\t///< Offset to parent index array in file\r\n\t} uPrnt;\r\n\r\n\t///\r\n\t/// Mesh Type used by TMdfMesh::meshType value\r\n\t///\r\n\tenum MeshType {\r\n\t\tMESH_STATIC = 0,\t/// Static meshes use TMdfVertSta vertices\r\n\t\tMESH_SKINNED,\t\t/// Skinned meshes use TMdfVertSkn vertices\r\n\t\tNUM_TYPES\r\n\t};\r\n\r\n\tunsigned int VertexSize() const {\r\n\t\tswitch(meshType) {\r\n\t\t\tcase MESH_STATIC:\r\n\t\t\t\treturn sizeof(TMdfVertSta);\r\n\t\t\t\tbreak;\r\n\t\t\tcase MESH_SKINNED:\r\n\t\t\t\treturn sizeof(TMdfVertSkn);\r\n\t\t\t\tbreak;\r\n\r\n\t\t\tdefault:\r\n\t\t\t\treturn 0;\r\n\t\t}\r\n\t}\r\n\r\n};\r\n\r\n//////////////////////////////////////////////////////////////////////////\r\n/// \\brief A single joint keyframe\r\n/// \\author Ivgeni Segal\r\n/// \\date January 20, 2007\r\n///\r\n/// Stores information about a single key-frame of a joint\r\n///\r\n/// \\remarks All transformation values are relative to their parent.\r\n///\t\t\t In other words, if joint A is parent of joint B, B's\r\n///\t\t\t transformation values represent the values that take\r\n///\t\t\t the joint from location/orientation/scale of A to B\r\n//////////////////////////////////////////////////////////////////////////\r\nstruct TMdfKeyframe\r\n{\r\n\tfloat fKeyTime;\t\t\t///< Time of start of this keyframe\r\n\tFloat3 vecTranslation;\t///< Relative translation at this keyframe\r\n\tFloat4 qRotation;\t\t///< Relative rotation at this keyframe\r\n\tFloat3 vecScale;\t\t\t///< Relative joint scale at this keyframe\r\n};\r\n\r\n//////////////////////////////////////////////////////////////////////////\r\n/// \\brief A collection of keyframes for a single joint\r\n/// \\author Ivgeni Segal\r\n/// \\date January 20, 2007\r\n///\r\n/// \\remarks The timeline is the animation channel for a single joint.\r\n/// Timelines store the collection of keyframes for a single joint.\r\n/// An array of timelines is stored in the TMdfAnimation object. The array\r\n/// corresponds to the depth-first sequence of joints. This array is \r\n/// parallel to the bind and parenting arrays in the corresponding TMdfMesh\r\n/// object.\r\n///\r\n//////////////////////////////////////////////////////////////////////////\r\nstruct TMdfTimeline\r\n{\r\n\tint nKeyFrames;\r\n\r\n"]
[217.442834, "o", "\tunion UKfs_t {\r\n\t\tTMdfKeyframe *pKeyframes;\r\n\t\tint nDataOffset;\r\n\t} uKfs;\r\n};\r\n\r\n//////////////////////////////////////////////////////////////////////////\r\n/// \\brief MDF Animation Object for a single mesh\r\n/// \\author Ivgeni Segal\r\n/// \\date January 20, 2007\r\n///\r\n/// MDF Animation object stores an array of joint timeline channels\r\n/// which in term contain the keyframes for each joint\r\n///\r\n/// \\remarks All joint keyframe transformations are relative to their\r\n///\t\t\t parent joints. The parent joint information can be obtained\r\n///\t\t\t from the TMdfMesh::uPrnt.pParentInfo array.\r\n///\r\n///\t\\par\t The order at which the timelines are stored in the pTimeline\r\n///\t\t\t array corresponds to the same order as in the TMdfMesh's\r\n///\t\t\t bind-post joints and parent array\r\n///\r\n//////////////////////////////////////////////////////////////////////////\r\nstruct TMdfAnimation\r\n{\r\n\tMdfHandle hMeshId;\t///< Index of the mesh that this animation belongs to\r\n\tint nNumTimelines;\t///< Number of timelines stored (corresponds to number\r\n\t\t\t\t\t\t///< of joints)\r\n\tfloat fTimeLength;\t///< Total play-time of this animation\r\n\r\n\tunion UTls_t {\r\n"]
[217.443228, "o", "\t\tTMdfTimeline *pTimeline;\t///< Array of timeline (channel) objects\r\n\t\t\t\t\t\t\t\t\t///< this corresponds to the joints\r\n\t\t\t\t\t\t\t\t\t///< and is stored in depth-first\r\n\t\t\t\t\t\t\t\t\t///< order of the joint hierarchy\r\n\r\n\t\tint nDataOffset;\t\t\t///< Offset of the array in file\r\n\t} uTls;\r\n\r\n};\r\n\r\n// Not used.\r\n//struct TMdfMaterial\r\n//{\r\n//\tFloat3\t\t\tdiffuse;\r\n//\tFloat3\t\t\tambient;\r\n//\tFloat3\t\t\tspecular;\r\n//\tFloat3\t\t\temissive;\r\n//\tfloat\t\t\tpower;\r\n//};\r\n//\r\n//struct TMdfTransform\r\n//{\r\n//\r\n//};\r\n\r\n\r\n//////////////////////////////////////////////////////////////////////////\r\n\r\ntypedef std::vector<MdfFullVertex> FullVertList;\r\ntypedef std::vector<unsigned short> FullIndexList;\r\n\r\nstruct MdfFullMesh {"]
[217.443538, "o", "\r\n\tMdfFullMesh() : \r\n\t\tvertices(0), \r\n\t\tnumVertices(0), \r\n\t\tfinalBindPose(0), \r\n\t\tparentInfo(0),\r\n\t\tnumBindPoseElements(0)\r\n\t\t{}\r\n\r\n\t// temporary verts\r\n\tMdfFullVertex *vertices;\r\n\tunsigned int numVertices;\r\n\r\n\t// mesh info\r\n\tFullVertList finalVerts;\r\n\tFullIndexList finalIndices;\r\n\r\n\t// hierarchy info\r\n\tTMdfMatrix4 *finalBindPose;\r\n\tunsigned int numBindPoseElements;\r\n\tint *parentInfo;\r\n\r\n\tstd::string textureFilename;\r\n\r\n\tvoid addVertex(const MdfFullVertex &v) {\r\n\t\tunsigned short tmpSize = (unsigned short)finalVerts.size();\r\n\t\t\r\n\t\tfor(unsigned short i = 0; i < tmpSize; i++) {\r\n\t\t\tif(finalVerts[i] == v) {\r\n\t\t\t\tfinalIndices.push_back(i);\r\n\t\t\t\treturn;\r\n\t\t\t}\r\n\t\t}\r\n\t\t\r\n\t\tfinalVerts.push_back(v);\r\n\t\tfinalIndices.push_back(tmpSize);\r\n\t}\r\n\r\n\tvoid Clear(void) {\r\n\t\tdelete[] vertices;\r\n\t\tvertices = 0;\r\n\t\tnumVertices = 0;\r\n\t\tdelete[] finalBindPose;\r\n\t\tfinalBindPose = 0;\r\n\t\tnumBindPoseElements = 0;\r\n\r\n\t\tdelete[] parentInfo;\r\n\t\tparentInfo = 0;\r\n\r\n\t\tfinalVerts.clear();\r\n\t\tfinalIndices.clear();\r\n\r\n\t\ttextureFilename.clear();\r\n\t}\r\n\r\n};\r\n\r\n//////////////////////////////////////////////////////////////////////////\r\n\r\ntypedef std::vector<TMdfKeyframe> FullKeyframeList;\r\n\r\nstruct MdfFullTimeline\r\n{\r\n\tFullKeyframeList vKeyframes;\r\n};\r\n\r\ntypedef std::vector<MdfFullTimeline> FullTimelineList;\r\n\r\nstruct MdfFullAnimation\r\n{\r\n\tMdfFullAnimation() : hMeshId(0), fTimeLength(0) {}\r\n\t\r\n\t"]
[217.443777, "o", "MdfHandle hMeshId;\r\n\tfloat fTimeLength;\r\n\r\n\tFullTimelineList vTimelines;\r\n\r\n\tvoid Clear(void) {\r\n\t\thMeshId = 0;\r\n\t\tfTimeLength = 0;\r\n\t\tvTimelines.clear();\r\n\t}\r\n\r\n\r\n};"]
[217.445706, "o", "\r\n#pragma once\r\n\r\n#include \"mdftypes.h\"\r\n\r\n#define MDF_BYTE_ALIGNMENT 16\r\n\r\nclass MdfStream;\r\n\r\nclass MdfFormat\r\n{\r\n\tenum MdfElements {\r\n\t\tMDF_NONE\t\t=\t0,\r\n"]
[217.44593, "o", "\t\tMDF_MESHES\t\t=\t1,\r\n\t\tMDF_TEXTURES\t=\t2,\r\n\t\tMDF_BINDMATS\t=\t4,\r\n\t\tMDF_PARENTINFO\t=\t8,\r\n\t\tMDF_ANIMATIONS\t=\t16,\r\n\t\tMDF_TRANSFORMS\t=\t32,\r\n\t\t"]
[217.44608, "o", "MDF_ALL\t\t\t= (MDF_MESHES|MDF_TEXTURES|MDF_BINDMATS|MDF_PARENTINFO|MDF_ANIMATIONS|MDF_TRANSFORMS)\r\n\t};\r\n\r\n\t/************************************************************************/\r\n\t/* DATA MEMBERS                                                         */\r\n\t/************************************************************************/\r\nprotected:\r\n\tsize_t m_nDataSize;\t\t\t\t\t///< Size of the memory pool\r\n\tByte *m_pData;\t\t\t\t\t\t///< Memory pool for this MDF\r\n\r\n\r\n\tTMdfMesh *m_vpMeshes;\t\t\t\t///< All the meshes in the file\r\n\tunsigned int m_nMeshArrayLength;\t///< Length of the meshes array\r\n\r\n\tTMdfAnimation *m_vpAnimations;\t\t///< All the animations in the file\r\n\tunsigned int m_nAnimArrayLength;\t///< Size of the animations array\r\n\r\n\tchar **m_vpTextures;\t\t\t\t///< Array of texture strings\r\n\r\n\tmutable MdfHeader m_tMdfHeader;\t\t\t\t///< Master MDF header\r\n\r\n\r\n\t/************************************************************************/\r\n\t/* CONSTRUCTION                                                         */\r\n\t/************************************************************************/\r\npublic:\r\n\tMdfFormat(void);\r\npublic:\r\n\tvirtual ~MdfFormat(void);\r\n\r\n\t/************************************************************************/\r\n\t/* CLASS METHODS                                                        */\r\n\t/************************************************************************/\r\npublic:\r\n\t//////////////////////////////////////////////////////////////////////////\r\n\t/// Create a new MDF file\r\n\t///\r\n\t/// \\param nNumMeshesHint - number of meshes this file might store\r\n\t/// \\return true if successful\r\n\t///\r\n"]
[217.44627, "o", "\t/// \\remarks To recreate a new MDF on the same object, Destroy() must\r\n\t///\t\t\t be called first\r\n\t//////////////////////////////////////////////////////////////////////////\r\n\tbool Create(unsigned int nNumMeshesHint=0);\r\n\r\n\t//////////////////////////////////////////////////////////////////////////\r\n\t/// Create a new MDF by loading its data from a file\r\n\t///\r\n\t/// \\param szFilename - the path of the file to load\r\n\t/// \\return true if successful\r\n\t//////////////////////////////////////////////////////////////////////////\r\n\tbool CreateFromFile(const char *szFilename);\r\n\r\n\t//////////////////////////////////////////////////////////////////////////\r\n\t/// Create a new MDF from raw MDF data in memory\r\n\t///\r\n\t/// \\param pData - location of the raw MDF data to load\r\n\t/// \\param nDataSize - size of the data buffer in bytes\r\n\t/// \\return true if successful\r\n\t//////////////////////////////////////////////////////////////////////////\r\n\tbool CreateFromFileInMemory(Byte *pData, size_t nDataSize);\r\n\t\r\n\t//////////////////////////////////////////////////////////////////////////\r\n\t/// Destroy the MDF and free all the memory\r\n"]
[217.446534, "o", "\t///\r\n\t/// \\remarks Once destroyed, this object is available for any of the\r\n\t///\t\t\t Create* calls to create a new MDF\r\n\t///\r\n\t//////////////////////////////////////////////////////////////////////////\r\n\tvoid Destroy();\r\n\r\n\t//////////////////////////////////////////////////////////////////////////\r\n\t/// Save MDF data to a file\r\n\t///\r\n\t/// \\param szFilename - path of the file to save to\r\n\t/// \\return true if successful\r\n\t//////////////////////////////////////////////////////////////////////////\r\n\tbool SaveToFile(const char *szFilename) const;\r\n\r\n\r\n\t//////////////////////////////////////////////////////////////////////////\r\n\t/// Add a new mesh to this MDF\r\n\t///\r\n\t/// \\param newMesh - mesh information to add\r\n\t/// \\return index of the newly-added mesh\r\n\t//////////////////////////////////////////////////////////////////////////\r\n\tMdfHandle AddMesh(const MdfFullMesh &newMesh);\r\n\r\n\t//////////////////////////////////////////////////////////////////////////\r\n\t/// Add a new animation to this MDF\r\n\t///\r\n\t/// \\param newAnimation - animation information to add\r\n\t/// \\return index of the newly-added animation\r\n\t//////////////////////////////////////////////////////////////////////////\r\n\tMdfHandle AddAnimation(const MdfFullAnimation &newAnimation);\r\n"]
[217.446788, "o", "\r\n\t/************************************************************************/\r\n\t/* ACCESSORS                                                            */\r\n\t/************************************************************************/\r\npublic:\r\n\r\n"]
[217.448312, "o", "\r\n\t//////////////////////////////////////////////////////////////////////////\r\n\t/// Get the number of meshes that are stored in this MDF\r\n\t///\r\n\t/// \\return total number of meshes\r\n\t//////////////////////////////////////////////////////////////////////////\r\n\tunsigned int GetNumMeshes() const { return m_tMdfHeader.nMeshCount; }\r\n\t\r\n\t//////////////////////////////////////////////////////////////////////////\r\n\t/// Obtain a read-only mesh object given by the index\r\n\t///\r\n\t/// \\param hMeshId index of the mesh object to obtain\r\n\t/// \\return Mesh object of the given index\r\n\t///\r\n\t/// \\warning Invalid indexes are not checked, use GetNumMeshes() to find\r\n\t///\t\t\t the maximum index\r\n\t//////////////////////////////////////////////////////////////////////////\r\n\tconst TMdfMesh & GetMesh(MdfHandle hMeshId) const { return m_vpMeshes[hMeshId]; }\r\n\r\n\t//////////////////////////////////////////////////////////////////////////\r\n\t/// Get number of animations that are stored in this MDF\r\n\t///\r\n\t/// \\return number of animations in this MDF\r\n\t//////////////////////////////////////////////////////////////////////////\r\n\tunsigned int GetNumAnimations() const { return m_tMdfHeader.nAnimCount; }\r\n\r\n\t//////////////////////////////////////////////////////////////////////////\r\n\t/// Obtain a read-only animation object given by the index\r\n\t///\r\n"]
[217.448663, "o", "\t/// \\param hAnimId - animation index\r\n\t/// \\return Mesh animation of the given index\r\n\t///\r\n\t/// \\warning Invalid indexes are not checked, use GetNumAnimations() to find\r\n\t///\t\t\t the maximum index\r\n\t//////////////////////////////////////////////////////////////////////////\r\n\tconst TMdfAnimation & GetAnimation(MdfHandle hAnimId) const { return m_vpAnimations[hAnimId]; }\r\n\r\n\t//////////////////////////////////////////////////////////////////////////\r\n\t/// Get texture that is assigned to the given mesh\r\n\t///\r\n\t/// \\param hMeshId - index of the mesh\r\n\t/// \\return index of the texture\r\n\t//////////////////////////////////////////////////////////////////////////\r\n\tMdfHandle GetTextureId(MdfHandle hMeshId) const {\r\n\t\treturn m_vpMeshes[hMeshId].hTexture;\r\n\t}\r\n\r\n\t//////////////////////////////////////////////////////////////////////////\r\n\t/// Get the number of texture names that are stored in this MDF\r\n\t///\r\n\t/// \\return total number of texture names\r\n\t//////////////////////////////////////////////////////////////////////////\r\n\tunsigned int GetNumTextures() const { return m_tMdfHeader.nTextureCount; }\r\n\r\n\t//////////////////////////////////////////////////////////////////////////\r\n\t/// Get texture name from the specified texture index value\r\n\t///\r\n\t/// \\param hTextureId - texture index\r\n\t/// \\return name of the texture\r\n\t///\r\n\t/// \\warning The string memory is maintained by the MDF object.\r\n\t///\t\t\t Always use deep-copying if you want to store the \r\n\t///\t\t\t string elsewhere.\r\n\t///\t\t\t The string is destroyed when this MDF is destroyed.\r\n\t///\r\n\t//////////////////////////////////////////////////////////////////////////\r\n\tconst char * GetTextureName(MdfHandle hTextureId) const { return m_vpTextures[hTextureId]; }\r\n\t\r\n\t//////////////////////////////////////////////////////////////////////////\r\n\t/// Get the header of this MDF\r\n\t///\r\n\t/// \\return the header of this MDF\r\n\t//////////////////////////////////////////////////////////////////////////\r\n\tconst MdfHeader & GetHeader() const { return m_tMdfHeader; }\r\n\r\n\tbool HasAnimations() const {\r\n\t\treturn(m_vpAnimations != 0);\r\n\t}\r\n\r\n\tbool HasMeshes() const {\r\n\t\treturn(m_vpMeshes != 0);\r\n\t}\r\n\r\n\t/************************************************************************/\r\n\t/* PRIVATE METHODS                                                      */\r\n\t/************************************************************************/\r\nprotected:\r\n\r\n\t//////////////////////////////////////////////////////////////////////////\r\n\t/// Loads an MDF from a given stream\r\n\t///\r\n\t/// \\param stream - the stream to load from\r\n\t/// \\return true if successful\r\n\t//////////////////////////////////////////////////////////////////////////\r\n\tbool LoadFromStream(MdfStream &stream);\r\n\r\n\t//////////////////////////////////////////////////////////////////////////\r\n\t/// Add a texture name to this MDF\r\n\t///\r\n\t/// \\remarks Adding duplicate names will waste memory. It is up to the\r\n\t///\t\t\t caller to ensure that no duplicate texture names are added.\r\n\t///\r\n\t/// \\param szName - the name of the texture (usually filename)\r\n\t/// \\return the index of the newly added texture name\r\n"]
[217.44891, "o", "\t//////////////////////////////////////////////////////////////////////////\r\n\tMdfHandle AddTexture(const char *szName);\r\n\r\n\tvoid ByteAlignFile(FILE *fp) const;\r\n\r\nprivate:\r\n\t// disable copy and assignment operator\r\n\tMdfFormat(MdfFormat &) {};\r\n\tMdfFormat & operator=(MdfFormat &) {}\r\n\r\n};\r\n\r\nclass MdfStream {\r\npublic:\r\n\tvirtual ~MdfStream() {};\r\n\tvirtual bool Seek(int offset, int origin) = 0;\r\n\tvirtual int Tell() = 0;\r\n\tvirtual int Read(void *pDest, int nLength) = 0;\r\n\tvirtual int Length() = 0;\r\n};"]
[217.450369, "o", "#include \"StdAfx.h\"\r\n#include \"MdfFormat.h\"\r\n#include <stdlib.h>\r\n\r\nconst char MDF_VER_STR[8] = {\r\n\t'M',\r\n\t'D',\r\n\t'F',\r\n\t' ',\r\n\t'v',\r\n\t'1',\r\n\t'.',\r\n\t'2'\r\n};\r\n\r\nclass MdfMemStream \r\n\t: public MdfStream\r\n{\r\npublic:\r\n\tMdfMemStream(Byte *pData, int nDataLen) : pData(pData), nDataLen(nDataLen), nPos(0) {}\r\n\tvirtual ~MdfMemStream() {}\r\n\r\n\tvirtual bool Seek(int offset, int origin);\r\n\tvirtual int Tell();\r\n\tvirtual int Read(void *pDest, int nLength);\r\n\tvirtual int Length();\r\n\r\n"]
[217.450543, "o", "private:\r\n\tByte *pData;\r\n\tint nDataLen;\r\n\tint nPos;\r\n\r\n};\r\n\r\nbool MdfMemStream::Seek(int offset, int origin)\r\n{\r\n\tswitch(origin) {\r\n\t\tcase SEEK_SET:\r\n\t\t{\r\n\t\t\tif(offset < 0 || offset > nDataLen) {\r\n\t\t\t\treturn false;\r\n\t\t\t}\r\n\t\t\tnPos = offset;\r\n\t\t} break;\r\n\t\tcase SEEK_CUR:\r\n\t\t{\r\n\t\t\tregister int test = nPos += offset;\r\n\t\t\tif(test < 0 || test > nDataLen) {\r\n\t\t\t\treturn false;\r\n\t\t\t}\r\n\t\t\tnPos += offset;\r\n\t\t} break;\r\n\t\tcase SEEK_END:\r\n\t\t{\r\n\t\t\tregister int test = nPos += offset;\r\n\t\t\tif(test < 0 || test > nDataLen) {\r\n\t\t\t\treturn false;\r\n\t\t\t}\r\n\t\t\tnPos = nDataLen - origin;\r\n\t\t} break;\r\n\t}\r\n\treturn true;\r\n}\r\n\r\nint MdfMemStream::Tell()\r\n{\r\n\treturn nPos;\r\n}\r\n"]
[217.450697, "o", "\r\nint MdfMemStream::Read(void *pDest, int nLength)\r\n{\r\n\tif(nPos + nLength >= nDataLen) {\r\n\t\tnLength = nDataLen - nPos;\r\n\t}\r\n\tmemcpy(pDest, &pData[nPos], nLength);\r\n\tnPos += nLength;\r\n\treturn nLength;\r\n}\r\n\r\nint MdfMemStream::Length()\r\n{\r\n\treturn nDataLen;\r\n}\r\n\r\n//////////////////////////////////////////////////////////////////////////\r\n\r\nclass MdfFileStream \r\n\t: public MdfStream\r\n{\r\npublic:\r\n\tMdfFileStream() : fp(0), nDataLen(0) {}\r\n\tvirtual ~MdfFileStream() { Close(); }\r\n\r\n\tbool Open(const char *szFilename) {\r\n\t\tfp = fopen(szFilename, \"rb\");\r\n\t\tif(fp) {\r\n\t\t\tfseek(fp, 0, SEEK_END);\r\n\t\t\tnDataLen = (int)ftell(fp);\r\n\t\t\tfseek(fp, 0, SEEK_SET);\r\n\t\t\treturn true;\r\n\t\t} else {\r\n\t\t\treturn false;\r\n\t\t}\r\n\t}\r\n\r\n"]
[217.450832, "o", "\tvoid Close() {\r\n\t\tif(fp) {\r\n\t\t\tfclose(fp);\r\n\t\t}\r\n\t\tfp = 0;\r\n\t\tnDataLen = 0;\r\n\t}\r\n\r\n\tvirtual bool Seek(int offset, int origin) {\r\n\t\treturn(fseek(fp, offset, origin) == 0);\r\n\t}\r\n\r\n\tvirtual int Tell() { return (int)ftell(fp); }\r\n\r\n\tvirtual int Read(void *pDest, int nLength) {\r\n\t\treturn (int)fread(pDest, 1, nLength, fp);\r\n\t}\r\n\r\n\tvirtual int Length() { return nDataLen; }\r\n\r\nprivate:\r\n\tFILE *fp;\r\n\tint nDataLen;\r\n};\r\n\r\n//////////////////////////////////////////////////////////////////////////\r\n\r\nMdfFormat::MdfFormat(void)\r\n: m_nDataSize(0),\r\n  m_pData(0),\r\n  m_vpMeshes(0),\r\n  m_nMeshArrayLength(0),\r\n  m_vpAnimations(0),\r\n  m_nAnimArrayLength(0),\r\n  m_vpTextures(0)\r\n{\r\n\t"]
[217.451236, "o", "ZeroMemory(&m_tMdfHeader, sizeof(m_tMdfHeader));\r\n}\r\n\r\nMdfFormat::~MdfFormat(void)\r\n{\r\n\tDestroy();\r\n}\r\n\r\nbool MdfFormat::Create(unsigned int nNumMeshesHint/* =0 */)\r\n{\r\n\tif(m_vpMeshes != 0) {\r\n\t\treturn false;\r\n\t}\r\n\r\n\tZeroMemory(&m_tMdfHeader, sizeof(m_tMdfHeader));\r\n\r\n\tmemcpy(m_tMdfHeader.cId, MDF_VER_STR, sizeof(MDF_VER_STR));\r\n\r\n\tm_tMdfHeader.nByteAlignment = MDF_BYTE_ALIGNMENT;\r\n\r\n\tif(nNumMeshesHint) {\r\n\t\tm_vpMeshes = (TMdfMesh*)malloc(nNumMeshesHint * sizeof(TMdfMesh));\r\n\t\tZeroMemory(m_vpMeshes, nNumMeshesHint * sizeof(TMdfMesh));\r\n\t\tm_nMeshArrayLength = nNumMeshesHint;\r\n\r\n\t\tm_vpAnimations = (TMdfAnimation*)malloc(nNumMeshesHint * sizeof(TMdfAnimation));\r\n\t\tm_nAnimArrayLength = nNumMeshesHint;\r\n\t}\r\n\r\n\treturn true;\r\n}\r\n\r\n\r\nMdfHandle MdfFormat::AddMesh(const MdfFullMesh &newMesh)\r\n{\r\n\tTMdfMesh *pMesh = 0;\r\n\tunsigned int nMesh = 0;\r\n\r\n\t// reallocate mesh pointer array if needed\r\n\tif((m_tMdfHeader.nMeshCount + 1) > m_nMeshArrayLength) {\r\n\r\n\t\tm_vpMeshes = (TMdfMesh*)realloc(m_vpMeshes, (m_tMdfHeader.nMeshCount+1)*sizeof(TMdfMesh));\r\n\t\tm_nMeshArrayLength++;\r\n\t}\r\n\r\n\t// allocate new mesh, set up variables\r\n\tnMesh = m_tMdfHeader.nMeshCount;\r\n\tpMesh = &m_vpMeshes[nMesh];\r\n\tm_tMdfHeader.nMeshCount++;\r\n\tZeroMemory(pMesh, sizeof(TMdfMesh));\r\n\r\n\tif(newMesh.numBindPoseElements > 0 && newMesh.parentInfo) {\r\n\t\tpMesh->meshType = TMdfMesh::MESH_SKINNED;\r\n\t} else {\r\n\t\tpMesh->meshType = TMdfMesh::MESH_STATIC;\r\n\t}\r\n\r\n\tsize_t numVerts = newMesh.finalVerts.size();\r\n\tsize_t numInds = newMesh.finalIndices.size();\r\n"]
[217.451715, "o", "\r\n\t// set up the mesh structure\r\n\tpMesh->nNumVerts = (unsigned int)newMesh.finalVerts.size();\r\n\tpMesh->nNumIndices = (unsigned int)newMesh.finalIndices.size();\r\n\r\n\t// allocate vertices and indices\r\n\t\r\n\tif(pMesh->meshType == TMdfMesh::MESH_SKINNED) {\r\n\t\tpMesh->uVtxs.pVertices = malloc(sizeof(TMdfVertSkn) * pMesh->nNumVerts);\r\n\t} else {\r\n\t\tpMesh->uVtxs.pVertices = malloc(sizeof(TMdfVertSta) * pMesh->nNumVerts);\r\n\t}\r\n\r\n\r\n\tpMesh->uIdxs.pIndices = (unsigned short*)malloc(sizeof(unsigned short) * pMesh->nNumIndices);\r\n\r\n\t//\r\n\t// copy vertex data\r\n\t//\r\n\tFullVertList::const_iterator li = newMesh.finalVerts.begin();\r\n\tint i = 0;\r\n\tif(pMesh->meshType == TMdfMesh::MESH_SKINNED) {\r\n\t\tTMdfVertSkn *v;\r\n\t\twhile (li != newMesh.finalVerts.end()) {\r\n\t\t\t v = &((TMdfVertSkn*)pMesh->uVtxs.pVertices)[i];\r\n\r\n\t\t\tv->pos.x = li->pos[0];\r\n\t\t\tv->pos.y = li->pos[1];\r\n\t\t\tv->pos.z = li->pos[2];\r\n\r\n\t\t\tv->weights[0] = li->weights[0];\r\n\t\t\tv->weights[1] = li->weights[1];\r\n\t\t\tv->weights[2] = li->weights[2];\r\n\r\n\t\t\tv->bones[0] = li->bones[0];\r\n\t\t\tv->bones[1] = li->bones[1];\r\n\t\t\tv->bones[2] = li->bones[2];\r\n\t\t\tv->bones[3] = li->bones[3];\r\n\t\t\t\r\n\t\t\tv->normal.x = li->normal[0];\r\n\t\t\tv->normal.y = li->normal[1];\r\n\t\t\tv->normal.z = li->normal[2];\r\n\r\n\t\t\tv->texcoord.u = li->u;\r\n\t\t\tv->texcoord.v = li->v;\r\n\r\n\t\t\ti++;\r\n\t\t\tli++;\r\n\t\t}\r\n\t} else {\r\n\t\tTMdfVertSta *v;\r\n\t\twhile (li != newMesh.finalVerts.end()) {\r\n\t\t\tv = &((TMdfVertSta*)pMesh->uVtxs.pVertices)[i];\r\n\r\n\t\t\tv->pos.x = li->pos[0];\r\n\t\t\tv->pos.y = li->pos[1];\r\n\t\t\tv->pos.z = li->pos[2];\r\n\t\t\tv->normal.x = li->normal[0];\r\n\t\t\tv->normal.y = li->normal[1];\r\n\t\t\tv->normal.z = li->normal[2];\r\n"]
