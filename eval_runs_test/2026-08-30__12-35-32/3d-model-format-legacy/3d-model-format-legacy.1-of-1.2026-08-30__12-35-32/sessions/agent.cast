[860.386312, "o", "\u001b[35m\u001b[Kmdftypes.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K21\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kstruct MdfHeader\u001b[m\u001b[K \r\n\u001b[35m\u001b[Kmdftypes.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K201\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kstruct TMdfMesh\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kmdftypes.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K254\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[Kenum MeshType\u001b[m\u001b[K {\r\n"]
[860.386644, "o", "\u001b[35m\u001b[Kmdftypes.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K288\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kstruct TMdfKeyframe\u001b[m\u001b[K\r\n\u001b[35m\u001b[Kmdftypes.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K309\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kstruct TMdfTimeline\u001b[m\u001b[K\r\n"]
[860.386749, "o", "\u001b[35m\u001b[Kmdftypes.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K336\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kstruct TMdfAnimation\u001b[m\u001b[K\r\n\u001b[35m\u001b[KMdfFormat.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K126\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tunsigned int \u001b[01;31m\u001b[KGetNum\u001b[m\u001b[KMeshes() const { return m_tMdfHeader.nMeshCount; }\r\n\u001b[35m\u001b[KMdfFormat.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K134\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t/// \\warning Invalid indexes are not checked, use \u001b[01;31m\u001b[KGetNum\u001b[m\u001b[KMeshes() to find\r\n\u001b[35m\u001b[KMdfFormat.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K137\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tconst TMdfMesh & \u001b[01;31m\u001b[KGetMesh\u001b[m\u001b[K(MdfHandle hMeshId) const { return m_vpMeshes[hMeshId]; }\r\n\u001b[35m\u001b[KMdfFormat.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K144\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tunsigned int \u001b[01;31m\u001b[KGetNum\u001b[m\u001b[KAnimations() const { return m_tMdfHeader.nAnimCount; }\r\n\u001b[35m\u001b[KMdfFormat.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K152\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t/// \\warning Invalid indexes are not checked, use \u001b[01;31m\u001b[KGetNum\u001b[m\u001b[KAnimations() to find\r\n"]
[860.386908, "o", "\u001b[35m\u001b[KMdfFormat.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K155\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tconst TMdfAnimation & \u001b[01;31m\u001b[KGetAnimation\u001b[m\u001b[K(MdfHandle hAnimId) const { return m_vpAnimations[hAnimId]; }\r\n\u001b[35m\u001b[KMdfFormat.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K172\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tunsigned int \u001b[01;31m\u001b[KGetNum\u001b[m\u001b[KTextures() const { return m_tMdfHeader.nTextureCount; }\r\n"]
