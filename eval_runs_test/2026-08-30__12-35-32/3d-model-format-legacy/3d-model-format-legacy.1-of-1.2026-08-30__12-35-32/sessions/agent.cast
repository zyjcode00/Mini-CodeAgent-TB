[445.670629, "o", "    45\t///\r\n    46\t/// transitional vertex format for use with exporters.\r\n    47\t/// This structure is used by the mesh-building functions of the MDF \r\n    48\t/// format object. do not use for loading.\r\n    49\t///\r\n    50\t///\r\n    51\t//////////////////////////////////////////////////////////////////////////\r\n    52\tstruct MdfFullVertex {\r\n    53\t\tfloat pos[3];\r\n    54\t\r\n"]
[445.670814, "o", "    55\t\tfloat weights[3];\r\n    56\t\tunsigned char bones[4];\r\n    57\t\r\n    58\t\tfloat normal[3];\r\n    59\t\tfloat u, v;\r\n    60\t\r\n    61\t\tbool operator==(const MdfFullVertex &b) const {\r\n    62\t\t\tif(bones[0] != b.bones[0]){\r\n    63\t\t\t\treturn false;\r\n    64\t\t\t}\r\n    65\t\t\tif(bones[1] != b.bones[1]){\r\n    66\t\t\t\treturn false;\r\n    67\t\t\t}\r\n    68\t\t\tif(bones[2] != b.bones[2]){\r\n    69\t\t\t\treturn false;\r\n    70\t\t\t}\r\n    71\t\t\tif(bones[3] != b.bones[3]){\r\n"]
[445.670994, "o", "    72\t\t\t\treturn false;\r\n    73\t\t\t}\r\n    74\t\t\tif(fabs(pos[0] - b.pos[0]) > MFDVERT_EPSILON) {\r\n    75\t\t\t\treturn false;\r\n    76\t\t\t}\r\n    77\t\t\tif(fabs(pos[1] - b.pos[1]) > MFDVERT_EPSILON) {\r\n    78\t\t\t\treturn false;\r\n    79\t\t\t}\r\n"]
[445.671136, "o", "    80\t\t\tif(fabs(pos[2] - b.pos[2]) > MFDVERT_EPSILON) {\r\n    81\t\t\t\treturn false;\r\n    82\t\t\t}\r\n    83\t\t\tif(fabs(weights[0] - b.weights[0]) > MFDVERT_EPSILON) {\r\n    84\t\t\t\treturn false;\r\n    85\t\t\t}\r\n    86\t\t\tif(fabs(weights[1] - b.weights[1]) > MFDVERT_EPSILON) {\r\n    87\t\t\t\treturn false;\r\n    88\t\t\t}\r\n    89\t\t\tif(fabs(weights[2] - b.weights[2]) > MFDVERT_EPSILON) {\r\n    90\t\t\t\treturn false;\r\n   115\t/// \\author Ivgeni Segal\r\n   116\t/// \\date January 20, 2007\r\n   117\t///\r\n   118\t/// Generic matrix used in the MDF format\r\n   119\t///\r\n   120\t/// \\remarks MDF uses row-major matrices, if you need to use MDF in a\r\n   121\t///\t\t\t column-major environment such as OpenGL don't forget to\r\n   122\t///\t\t\t transpose them.\r\n   123\t///\r\n"]
[445.671257, "o", "   124\t//////////////////////////////////////////////////////////////////////////\r\n   125\tstruct TMdfMatrix4\r\n   126\t{\r\n   127\t\tfloat\te[16];\r\n   128\t};\r\n   129\t\r\n   130\t//////////////////////////////////////////////////////////////////////////\r\n   131\t/// \\brief Skinned vertex for animation\r\n   132\t/// \\author Ivgeni Segal\r\n   133\t/// \\date January 20, 2007\r\n   134\t///\r\n   135\t/// \\remarks Skinned vertex is present in animated meshes and supports\r\n   136\t///\tup to four bones per vertex\r\n   137\t///\r\n   138\t//////////////////////////////////////////////////////////////////////////\r\n   139\tstruct TMdfVertSkn\r\n"]
[445.671463, "o", "   140\t{\r\n   141\t\tFloat3 pos;\r\n   142\t\tfloat weights[3];\r\n   143\t\tunsigned char bones[4];\r\n   144\t\r\n   145\t\tFloat3 normal;\r\n   146\t\tFloat2 texcoord;\r\n   147\t};\r\n   148\t\r\n   149\t//////////////////////////////////////////////////////////////////////////\r\n   150\t/// \\brief Vertex for static meshes\r\n   151\t/// \\author Ivgeni Segal\r\n   152\t/// \\date January 20, 2007\r\n   153\t///\r\n   154\t/// \\remarks All static geometry in MDF uses this vertex format,\r\n   155\t///\t\t\t he UV coordinates are in DirectX form\r\n"]
[445.671611, "o", "   156\t///\r\n   157\t//////////////////////////////////////////////////////////////////////////\r\n   158\tstruct TMdfVertSta\r\n   159\t{\r\n   160\t\tFloat3 pos;\t\t\t///< Vertex position in model space\r\n   190\t/// \\par\r\n   191\t/// The TMdfMesh Object contains all the information needed to display a mesh\r\n   192\t/// In addition to vertex information, the Mesh Object stores optional\r\n   193\t/// bind-pose matrix array for animation as well as parenting information\r\n   194\t/// for the joints. All joints are stored in depth-first order of the joint hierarchy.\r\n"]
[445.671793, "o", "   195\t/// \\par\r\n   196\t/// Both of the arrays are parallel to the joint-keyframe\r\n   197\t/// arrays in the the TMdfAnimation Object that corresponds to this mesh.\r\n   198\t///\r\n   199\t///\r\n   200\t//////////////////////////////////////////////////////////////////////////\r\n   201\tstruct TMdfMesh\r\n   202\t{\r\n   203\t\tunsigned int\tnNumVerts;\t\t///< Number of vertices in this mesh\r\n   204\t\tunsigned int\tnNumIndices;\t///< Number of vertex indexes\r\n   205\t\tunsigned int\tnNumJoints;\t\t///< Number of joints in stored bind\r\n   206\t\t\t\t\t\t\t\t\t\t///< pose and parenting arrays\r\n   207\t\tMdfHandle\t\thTexture;\t\t///< Index of the texture name\r\n   208\t\tint meshType;\t\t\t\t\t///< Mesh type (See MeshType enum)\r\n"]
[445.672014, "o", "   209\t\r\n   210\t\t///\r\n   211\t\t/// Mesh vertex array\r\n   212\t\t///\r\n   213\t\tunion UVerts_t {\t// reference to the vertices\r\n   214\t\t\tvoid *pVertices;\t\t\t///< Vertexes when in memory\r\n   215\t\t\tint nDataOffset;\t\t\t///< Offset to vertexes when in file\r\n   216\t\t} uVtxs;\r\n   217\t\r\n   218\t\t///\r\n   219\t\t/// Mesh index array\r\n   220\t\t///\r\n   221\t\tunion UIdxs_t {\r\n   222\t\t\tunsigned short *pIndices;\t///< Index array in memory\r\n   223\t\t\tint nDataOffset;\t\t\t///< Offset to index array in file\r\n   224\t\t} uIdxs;\r\n   225\t\r\n   226\t\t///\r\n   227\t\t/// Mesh bind-pose matrices (Animated Meshes only)\r\n   228\t\t///\r\n   229\t\tunion UBind_t {\r\n   230\t\t\tTMdfMatrix4 *pBindMats;\t\t///< Bind matrix array in memory\r\n   231\t\t\t\t\t\t\t\t\t\t///< will be NULL if no bind information\r\n   232\t\r\n   233\t\t\tint nDataOffset;\t\t\t///< Offset to bind matrix array in file\r\n   234\t\t} uBnd;\r\n   235\t\r\n"]
[445.672131, "o", "   280\t///\r\n   281\t/// Stores information about a single key-frame of a joint\r\n   282\t///\r\n   283\t/// \\remarks All transformation values are relative to their parent.\r\n   284\t///\t\t\t In other words, if joint A is parent of joint B, B's\r\n   285\t///\t\t\t transformation values represent the values that take\r\n   286\t///\t\t\t the joint from location/orientation/scale of A to B\r\n   287\t//////////////////////////////////////////////////////////////////////////\r\n   288\tstruct TMdfKeyframe\r\n   289\t{\r\n   290\t\tfloat fKeyTime;\t\t\t///< Time of start of this keyframe\r\n   291\t\tFloat3 vecTranslation;\t///< Relative translation at this keyframe\r\n   292\t\tFloat4 qRotation;\t\t///< Relative rotation at this keyframe\r\n   293\t\tFloat3 vecScale;\t\t\t///< Relative joint scale at this keyframe\r\n   294\t};\r\n   295\t\r\n   296\t//////////////////////////////////////////////////////////////////////////\r\n   297\t/// \\brief A collection of keyframes for a single joint\r\n   298\t/// \\author Ivgeni Segal\r\n   299\t/// \\date January 20, 2007\r\n   300\t///\r\n   301\t/// \\remarks The timeline is the animation channel for a single joint.\r\n   302\t/// Timelines store the collection of keyframes for a single joint.\r\n   303\t/// An array of timelines is stored in the TMdfAnimation object. The array\r\n   304\t/// corresponds to the depth-first sequence of joints. This array is \r\n   305\t/// parallel to the bind and parenting arrays in the corresponding TMdfMesh\r\n   306\t/// object.\r\n   307\t///\r\n   308\t//////////////////////////////////////////////////////////////////////////\r\n   309\tstruct TMdfTimeline\r\n   310\t{\r\n   311\t\tint nKeyFrames;\r\n   312\t\r\n   313\t\tunion UKfs_t {\r\n   314\t\t\tTMdfKeyframe *pKeyframes;\r\n"]
[445.672244, "o", "   315\t\t\tint nDataOffset;\r\n   316\t\t} uKfs;\r\n   317\t};\r\n   318\t\r\n   319\t//////////////////////////////////////////////////////////////////////////\r\n   320\t/// \\brief MDF Animation Object for a single mesh\r\n   321\t/// \\author Ivgeni Segal\r\n"]
[445.672419, "o", "   322\t/// \\date January 20, 2007\r\n   323\t///\r\n   324\t/// MDF Animation object stores an array of joint timeline channels\r\n   325\t/// which in term contain the keyframes for each joint\r\n   326\t///\r\n   327\t/// \\remarks All joint keyframe transformations are relative to their\r\n   328\t///\t\t\t parent joints. The parent joint information can be obtained\r\n   329\t///\t\t\t from the TMdfMesh::uPrnt.pParentInfo array.\r\n   330\t///\r\n"]
