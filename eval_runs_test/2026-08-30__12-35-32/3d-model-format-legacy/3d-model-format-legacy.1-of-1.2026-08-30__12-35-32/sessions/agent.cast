[1023.650747, "o", "// Cross-platform replacement for the original Visual Studio precompiled header.\r\n#pragma once\r\n\r\n#ifdef _WIN32\r\n#define WIN32_LEAN_AND_MEAN\r\n#include <windows.h>\r\n#else\r\n#include <cstring>\r\n#include <cstdlib>\r\n#include <cstdio>\r\n#include <cstdint>\r\n#ifndef ZeroMemory\r\n#define ZeroMemory(Destination, Length) std::memset((Destination), 0, (Length))\r\n#endif\r\n#endif\r\n"]
[1023.65104, "o", "\r\n---\r\n"]
[1023.653108, "o", "// stdafx.cpp : source file that includes just the standard includes\r\n// MdfLib.pch will be the pre-compiled header\r\n// stdafx.obj will contain the pre-compiled type information\r\n\r\n#include \"stdafx.h\"\r\n\r\n// TODO: reference any additional headers you need in STDAFX.H\r\n// and not in this file\r\n"]
