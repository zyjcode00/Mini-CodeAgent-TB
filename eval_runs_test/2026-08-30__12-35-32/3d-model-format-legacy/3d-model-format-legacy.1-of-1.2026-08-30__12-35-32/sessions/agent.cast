[747.632103, "o", "\t/* DATA MEMBERS                                                         */\r\n25:\t/************************************************************************/\r\n26:protected:\r\n27:\tsize_t m_nDataSize;\t\t\t\t\t///< Size of the memory pool\r\n28:\tByte *m_pData;\t\t\t\t\t\t///< Memory pool for this MDF\r\n29:\r\n30:\r\n31:\tTMdfMesh *m_vpMeshes;\t\t\t\t///< All the meshes in the file\r\n32:\tunsigned int m_nMeshArrayLength;\t///< Length of the meshes array\r\n33:\r\n34:\tTMdfAnimation *m_vpAnimations;\t\t///< All the animations in the file\r\n35:\tunsigned int m_nAnimArrayLength;\t///< Size of the animations array\r\n36:\r\n37:\tchar **m_vpTextures;\t\t\t\t///< Array of texture strings\r\n38:\r\n39:\tmutable MdfHeader m_tMdfHeader;\t\t\t\t///< Master MDF header\r\n40:\r\n41:\r\n42:\t/************************************************************************/\r\n43:\t/* CONSTRUCTION                                                         */\r\n"]
