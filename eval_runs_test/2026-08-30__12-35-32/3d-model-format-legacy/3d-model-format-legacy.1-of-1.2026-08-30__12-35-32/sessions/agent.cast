[516.970574, "o", "\t\tByteAlignFile(fp);\r\n   434\t\t\tpHeaderMeshes[i].uIdxs.nDataOffset = ftell(fp);\r\n   435\t\t\tfwrite(pMesh->uIdxs.pIndices, sizeof(unsigned short), pMesh->nNumIndices, fp);\r\n   436\t\r\n   437\t\t\tif(pMesh->meshType == TMdfMesh::MESH_SKINNED) {\r\n   438\t\t\t\tByteAlignFile(fp);\r\n   439\t\t\t\t// write the bind-pose skin data\r\n   440\t\t\t\tpHeaderMeshes[i].uBnd.nDataOffset = ftell(fp);\r\n   441\t\t\t\tfwrite(pMesh->uBnd.pBindMats, sizeof(TMdfMatrix4), pMesh->nNumJoints, fp);\r\n   442\t\r\n   443\t\t\t\tByteAlignFile(fp);\r\n   444\t\t\t\t// write out the parenting info\r\n   445\t\t\t\tpHeaderMeshes[i].uPrnt.nDataOffset = ftell(fp);\r\n   446\t\t\t\tfwrite(pMesh->uPrnt.pParentInfo, sizeof(int), pMesh->nNumJoints, fp);\r\n   447\t\t\t}\r\n   448\t\t}\r\n   449\t\r\n   450\t\t//\r\n   451\t\t// for each animation, save the data\r\n   452\t\t//\r\n   453\t\tfor(unsigned int i = 0; i < m_tMdfHeader.nAnimCount; i++) {\r\n   454\t\t\tconst TMdfAnimation *pAnim = &m_vpAnimations[i];\r\n   455\t\t\tpHeaderAnims[i] = *pAnim;\r\n   456\t\r\n   457\t\t\tTMdfTimeline *pHeaderTimelines = (TMdfTimeline *)malloc(pAnim->nNumTimelines * sizeof(TMdfTimeline));\r\n   458\t\r\n"]
[516.970742, "o", "   459\t\t\t// for each time-line\r\n   460\t\t\tfor(int t = 0; t < pAnim->nNumTimelines; t++) {\r\n   461\t\r\n   462\t\t\t\tconst TMdfTimeline *pTimeline = &pAnim->uTls.pTimeline[t];\r\n   463\t\t\t\tpHeaderTimelines[t] = *pTimeline;\r\n   464\t\r\n   465\t\t\t\t// write out the keyframes\r\n   466\t\t\t\tByteAlignFile(fp);\r\n   467\t\t\t\tpHeaderTimelines[t].uKfs.nDataOffset = ftell(fp);\r\n   468\t\t\t\tfwrite(pTimeline->uKfs.pKeyframes, sizeof(TMdfKeyframe), pTimeline->nKeyFrames, fp);\r\n   469\t\t\t}\r\n   470\t\r\n   471\t\t\t// write out the timelines\r\n   472\t\t\tByteAlignFile(fp);\r\n   473\t\t\tpHeaderAnims[i].uTls.nDataOffset = ftell(fp);\r\n   474\t\t\tfwrite(pHeaderTimelines, sizeof(TMdfTimeline), pAnim->nNumTimelines, fp);\r\n   475\t\t\tfree(pHeaderTimelines);\r\n   476\t\t}\r\n   477\t\r\n   478\t\tm_tMdfHeader.nTotalDataSize = (unsigned int)ftell(fp) - sizeof(MdfHeader);\r\n   479\t\r\n   480\t\t//\r\n   481\t\t// go back and write out the headers\r\n   482\t\t//\r\n   483\t\tfseek(fp, 0, SEEK_SET);\r\n   484\t\r\n   485\t\t// write the main header\r\n   486\t\tfwrite(&m_tMdfHeader, sizeof(m_tMdfHeader), 1, fp);\r\n   487\t\r\n   488\t\t// used textures header\r\n   489\t\tfwrite(pHeaderTextures, sizeof(int), m_tMdfHeader.nTextureCount, fp);\r\n   490\t\r\n   491\t\t// mesh headers\r\n   492\t\tfwrite(pHeaderMeshes, sizeof(TMdfMesh), m_tMdfHeader.nMeshCount, fp);\r\n   493\t\r\n   494\t\t// animation headers\r\n   495\t\tfwrite(pHeaderAnims, sizeof(TMdfAnimation), m_tMdfHeader.nAnimCount, fp);\r\n   496\t\r\n   497\t\tfclose(fp);\r\n   498\t\r\n   499\t\tfree(pHeaderMeshes);\r\n   500\t\tfree(pHeaderAnims);\r\n   501\t\tfree(pHeaderTextures);\r\n"]
