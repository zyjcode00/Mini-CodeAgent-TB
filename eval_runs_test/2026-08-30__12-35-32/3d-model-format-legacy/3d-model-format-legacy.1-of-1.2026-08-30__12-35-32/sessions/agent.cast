[955.270741, "o", "cd /app/MdfLib && nl -ba mdftypes.h | sed -n '1,120p' && nl -ba mdftypes.h | sed -n '120,220p' && nl -ba mdftypes.h | sed -n '220,320p'\r\n\u001b[?2004l\r"]
[955.273931, "o", "     1\t#pragma once\r\n     2\t#include \"types.h\"\r\n     3\t#include <math.h>\r\n     4\t#include <vector>\r\n     5\t#include <string>\r\n     6\t\r\n     7\t#define MFDVERT_EPSILON 0.0001f\r\n     8\t\r\n     9\t\r\n    10\ttypedef int MdfHandle;\r\n    11\t\r\n    12\t//////////////////////////////////////////////////////////////////////////\r\n    13\t/// \\brief MDF File Header\r\n    14\t/// \\author Ivgeni Segal\r\n    15\t/// \\date January 20, 2007\r\n    16\t///\r\n    17\t/// MDF File header is the structure stored at the beginning\r\n    18\t/// of the file and identifies its version and contents\r\n    19\t///\r\n    20\t//////////////////////////////////////////////////////////////////////////\r\n    21\tstruct MdfHeader \r\n    22\t{ \r\n    23\t\tchar cId[8]; // 'MDF v1.0'\r\n    24\t\r\n    25\t\tunsigned int nMeshCount;\t\t///< Number of meshes in this file\r\n    26\t\tunsigned int nAnimCount;\t\t///< Number of animations in this file\r\n    27\t\tunsigned int nTextureCount;\t\t///< Total number of texture names\r\n    28\t\tunsigned int nByteAlignment;\t///< Current byte alignment of the file\r\n    29\t\tunsigned int nNumHierarchies;\t///< Unused\r\n    30\t\r\n    31\t\tunsigned int nTotalDataSize;\t///< Total size of the data excluding\r\n    32\t\t\t\t\t\t\t\t\t\t///< the header\r\n    33\t};\r\n"]
[955.274207, "o", "    34\t\r\n    35\t//////////////////////////////////////////////////////////////////////////\r\n    36\t\r\n    37\t//\r\n    38\t\r\n    39\t//\r\n    40\t\r\n    41\t//////////////////////////////////////////////////////////////////////////\r\n    42\t/// \\brief Transitional vertex format\r\n    43\t/// \\author Ivgeni Segal\r\n    44\t/// \\date January 20, 2007\r\n    45\t///\r\n    46\t/// transitional vertex format for use with exporters.\r\n    47\t/// This structure is used by the mesh-building functions of the MDF \r\n    48\t/// format object. do not use for loading.\r\n    49\t///\r\n    50\t///\r\n    51\t//////////////////////////////////////////////////////////////////////////\r\n    52\tstruct MdfFullVertex {\r\n    53\t\tfloat pos[3];\r\n    54\t\r\n    55\t\tfloat weights[3];\r\n    56\t\tunsigned char bones[4];\r\n    57\t\r\n    58\t\tfloat normal[3];\r\n    59\t\tfloat u, v;\r\n    60\t\r\n    61"]
[955.274348, "o", "\t\tbool operator==(const MdfFullVertex &b) const {\r\n    62\t\t\tif(bones[0] != b.bones[0]){\r\n    63\t\t\t\treturn false;\r\n    64\t\t\t}\r\n    65\t\t\tif(bones[1] != b.bones[1]){\r\n    66\t\t\t\treturn false;\r\n    67\t\t\t}\r\n    68\t\t\tif(bones[2] != b.bones[2]){\r\n    69\t\t\t\treturn false;\r\n    70\t\t\t}\r\n    71\t\t\tif(bones[3] != b.bones[3]){\r\n    72\t\t\t\treturn false;\r\n    73\t\t\t}\r\n    74\t\t\tif(fabs(pos[0] - b.pos[0]) > MFDVERT_EPSILON) {\r\n    75\t\t\t\treturn false;\r\n    76\t\t\t}\r\n    77\t\t\tif(fabs(pos[1] - b.pos[1]) > MFDVERT_EPSILON) {\r\n    78\t\t\t\treturn false;\r\n    79\t\t\t}\r\n    80\t\t\tif(fabs(pos[2] - b.pos[2]) > MFDVERT_EPSILON) {\r\n    81\t\t\t\treturn false;\r\n    82\t\t\t}\r\n    83\t\t\tif(fabs(weights[0] - b.weights[0]) > MFDVERT_EPSILON) {\r\n    84\t\t\t\treturn false;\r\n    85\t\t\t}\r\n    86\t\t\tif(fabs(weights[1] - b.weights[1]) > MFDVERT_EPSILON) {\r\n    87\t\t\t\treturn false;\r\n    88\t\t\t}\r\n    89\t\t\tif(fabs(weights[2] - b.weights[2]) > MFDVERT_EPSILON) {\r\n    90\t\t\t\treturn false;\r\n    91\t\t\t}\r\n"]
[955.274507, "o", "    92\t\t\tif(fabs(normal[0] - b.normal[0]) > MFDVERT_EPSILON) {\r\n    93\t\t\t\treturn false;\r\n    94\t\t\t}\r\n    95\t\t\tif(fabs(normal[1] - b.normal[1]) > MFDVERT_EPSILON) {\r\n    96\t\t\t\treturn false;\r\n    97\t\t\t}\r\n    98\t\t\tif(fabs(normal[2] - b.normal[2]) > MFDVERT_EPSILON) {\r\n    99\t\t\t\treturn false;\r\n   100\t\t\t}\r\n   101\t\t\tif(fabs(u - b.u) > MFDVERT_EPSILON) {\r\n   102\t\t\t\treturn false;\r\n   103\t\t\t}\r\n   104\t\t\tif(fabs(v - b.v) > MFDVERT_EPSILON) {\r\n   105\t\t\t"]
[955.274698, "o", "\treturn false;\r\n   106\t\t\t}\r\n   107\t\r\n   108\t\t\treturn true;\r\n   109\t\t}\r\n   110\t\r\n   111\t};\r\n   112\t\r\n   113\t//////////////////////////////////////////////////////////////////////////\r\n   114\t/// \\brief Generic 4x4 matrix\r\n   115\t/// \\author Ivgeni Segal\r\n   116\t/// \\date January 20, 2007\r\n   117\t///\r\n   118\t/// Generic matrix used in the MDF format\r\n   119\t///\r\n   120\t/// \\remarks MDF uses row-major matrices, if you need to use MDF in a\r\n"]
[955.277067, "o", "   120\t/// \\remarks MDF uses row-major matrices, if you need to use MDF in a\r\n   121\t///\t\t\t column-major environment such as OpenGL don't forget to\r\n   122\t///\t\t\t transpose them.\r\n   123\t///\r\n   124\t//////////////////////////////////////////////////////////////////////////\r\n   125\tstruct TMdfMatrix4\r\n   126\t{\r\n   127\t\tfloat\te[16];\r\n   128\t};\r\n   129\t\r\n   130\t//////////////////////////////////////////////////////////////////////////\r\n   131\t/// \\brief Skinned vertex for animation\r\n   132\t/// \\author Ivgeni Segal\r\n   133\t/// \\date January 20, 2007\r\n   134\t///\r\n   135\t/// \\remarks Skinned vertex is present in animated meshes and supports\r\n   136\t///\tup to four bones per vertex\r\n   137\t///\r\n   138\t//////////////////////////////////////////////////////////////////////////\r\n   139\tstruct TMdfVertSkn"]
[955.277257, "o", "\r\n   140\t{\r\n   141\t\tFloat3 pos;\r\n   142\t\tfloat weights[3];\r\n   143\t\tunsigned char bones[4];\r\n   144\t\r\n   145\t\tFloat3 normal;\r\n   146\t\tFloat2 texcoord;\r\n   147\t};\r\n   148\t\r\n   149\t//////////////////////////////////////////////////////////////////////////\r\n   150\t/// \\brief Vertex for static meshes\r\n   151\t/// \\author Ivgeni Segal\r\n   152\t/// \\date January 20, 2007\r\n   153\t///\r\n   154\t/// \\remarks All static geometry in MDF uses this vertex format,\r\n   155\t///\t\t\t he UV coordinates are in DirectX form\r\n   156\t///\r\n"]
[955.277483, "o", "   157\t//////////////////////////////////////////////////////////////////////////\r\n   158\tstruct TMdfVertSta\r\n   159\t{\r\n   160\t\tFloat3 pos;\t\t\t///< Vertex position in model space\r\n   161\t\r\n   162\t\tFloat3 normal;\t\t///< Vertex normal\r\n   163\t\tFloat2 texcoord;\t///< UV Texture coordinate\r\n   164\t\r\n   165\t\tTMdfVertSta & operator=(const TMdfVertSkn &rhs) {\r\n   166\t\t\tpos.x = rhs.pos.x;\r\n   167\t\t\tpos.y = rhs.pos.y;\r\n   168\t\t\tpos.z = rhs.pos.z;\r\n   169\t\r\n   170\t\t\tnormal.x = rhs.normal.x;\r\n   171\t\t\tnormal.y = rhs.normal.y;\r\n   172\t\t\tnormal.z = rhs.normal.z;\r\n   173\t\r\n   174\t\t\ttexcoord.u = rhs.texcoord.u;\r\n   175\t\t\ttexcoord.v = rhs.texcoord.v;\r\n   176\t\t\treturn *this;\r\n   177\t\t}\r\n"]
[955.27766, "o", "   178\t};\r\n   179\t\r\n   180\t\r\n   181\t\r\n   182\t//////////////////////////////////////////////////////////////////////////\r\n   183\t/// \\brief A single Mesh Object\r\n   184\t/// \\author Ivgeni Segal\r\n   185\t/// \\date January 20, 2007\r\n   186\t///\r\n   187\t/// \\remarks The nDataOffset elements are the positions\r\n   188\t/// relative to the beginning of the MDF file.\r\n   189\t/// once the file is loaded they are converted into memory locations.\r\n   190\t/// \\par\r\n   191\t/// The TMdfMesh Object contains all the information needed to display a mesh\r\n   192\t/// In addition to vertex information, the Mesh Object stores optional\r\n   193\t/// bind-pose matrix array for animation as well as parenting information\r\n   194\t/// for the joints. All joints are stored in depth-first order of the joint hierarchy.\r\n   195\t/// \\par\r\n   196\t"]
[955.277827, "o", "/// Both of the arrays are parallel to the joint-keyframe\r\n   197\t/// arrays in the the TMdfAnimation Object that corresponds to this mesh.\r\n   198\t///\r\n   199\t///\r\n   200\t//////////////////////////////////////////////////////////////////////////\r\n   201\tstruct TMdfMesh\r\n   202\t{\r\n   203\t\tunsigned int\tnNumVerts;\t\t///< Number of vertices in this mesh\r\n   204\t\tunsigned int\tnNumIndices;\t///< Number of vertex indexes\r\n   205\t\tunsigned int\tnNumJoints;\t\t///< Number of joints in stored bind\r\n   206\t\t\t\t\t\t\t\t\t\t///< pose and parenting arrays\r\n   207\t\tMdfHandle\t\thTexture;\t\t///< Index of the texture name\r\n   208\t\tint meshType;\t\t\t\t\t///< Mesh type (See MeshType enum)\r\n   209\t\r\n   210\t\t///\r\n   211\t\t/// Mesh vertex array\r\n   212\t\t///\r\n   213\t\tunion UVerts_t {\t// reference to the vertices\r\n   214\t\t\tvoid *pVertices;\t\t\t///< Vertexes when in memory\r\n   215\t\t\tint nDataOffset;\t\t\t///< Offset to vertexes when in file\r\n   216\t\t} uVtxs;\r\n   217\t\r\n   218\t\t///\r\n   219\t\t/// Mesh index array\r\n   220\t\t///\r\n"]
[955.279495, "o", "   220\t\t///\r\n   221\t\tunion UIdxs_t {\r\n   222\t\t\tunsigned short *pIndices;\t///< Index array in memory\r\n   223\t\t\tint nDataOffset;\t\t\t///< Offset to index array in file\r\n   224\t\t} uIdxs;\r\n   225\t\r\n   226\t\t///\r\n   227\t\t/// Mesh bind-pose matrices (Animated Meshes only)\r\n   228\t\t///\r\n   229\t\tunion UBind_t {\r\n   230\t\t\tTMdfMatrix4 *pBindMats;\t\t///< Bind matrix array in memory\r\n   231\t\t\t\t\t\t\t\t\t\t///< will be NULL if no bind information\r\n   232\t\r\n   233\t\t\tint nDataOffset;\t\t\t///< Offset to bind matrix array in file\r\n   234\t\t} uBnd;\r\n   235\t\r\n   236\t\t///\r\n   237\t\t/// Parent index map (Animated Meshes only)\r\n   238\t\t///\r\n   239\t\tunion UPrnt_t {\t\t// reference to the (optional) hierarchy (parent info)\r\n   240\t\t\tint *pParentInfo;\t\t\t///< Parent index array in memory\r\n   241\t\t\t\t\t\t\t\t\t\t///< this array is parallel to the joint\r\n"]
[955.279692, "o", "   242\t\t\t\t\t\t\t\t\t\t///< arrays of this mesh. The index values\r\n   243\t\t\t\t\t\t\t\t\t\t///< correspond to all of the joint arrays:\r\n   244\t\t\t\t\t\t\t\t\t\t///< pParentInfo[jointIndex] = parentIndex\r\n   245\t\t\t\t\t\t\t\t\t\t///< If a joint has no parent, it's\r\n   246\t\t\t\t\t\t\t\t\t\t///< index value is -1\r\n   247\t\r\n   248\t\t\tint nDataOffset;\t\t\t///< Offset to parent index array in file\r\n   249\t\t} uPrnt;\r\n   250\t\r\n   251\t\t///\r\n   252\t\t/// Mesh Type used by TMdfMesh::meshType value\r\n   253\t\t///\r\n   254\t\tenum MeshType {\r\n   255\t\t\tMESH_STATIC = 0,\t/// Static meshes use TMdfVertSta vertices\r\n   256\t\t\tMESH_SKINNED,\t\t/// Skinned meshes use TMdfVertSkn vertices\r\n   257\t\t\tNUM_TYPES\r\n   258\t\t};\r\n   259\t\r\n   260\t\tunsigned int VertexSize() const {\r\n   261\t\t\tswitch(meshType) {\r\n   262\t\t\t\tcase MESH_STATIC:\r\n   263\t\t\t\t\treturn sizeof(TMdfVertSta);\r\n   264\t\t\t\t\tbreak;\r\n   265\t\t\t\tcase MESH_SKINNED:\r\n   266\t\t\t\t\treturn sizeof(TMdfVertSkn);\r\n   267\t\t\t\t\tbreak;\r\n   268\t\r\n   269\t\t\t\tdefault:\r\n   270\t\t\t\t\treturn 0;\r\n   271\t\t\t}\r\n   272\t\t}\r\n   273\t\r\n   274\t};\r\n   275\t\r\n   276\t//////////////////////////////////////////////////////////////////////////\r\n   277\t/// \\brief A single joint keyframe\r\n   278\t/// \\author Ivgeni Segal\r\n   279\t/// \\date January 20, 2007\r\n   280\t///\r\n   281\t/// Stores information about a single key-frame of a joint\r\n   282\t///\r\n   283\t/// \\remarks All transformation values are relative to their parent.\r\n   284\t///\t\t\t"]
[955.279871, "o", " In other words, if joint A is parent of joint B, B's\r\n   285\t///\t\t\t transformation values represent the values that take\r\n   286\t///\t\t\t the joint from location/orientation/scale of A to B\r\n   287\t//////////////////////////////////////////////////////////////////////////\r\n   288\tstruct TMdfKeyframe\r\n   289\t{\r\n   290\t\tfloat fKeyTime;\t\t\t///< Time of start of this keyframe\r\n   291\t\tFloat3 vecTranslation;\t///< Relative translation at this keyframe\r\n   292\t\tFloat4 qRotation;\t\t///< Relative rotation at this keyframe\r\n   293\t\tFloat3 vecScale;\t\t\t///< Relative joint scale at this keyframe\r\n   294\t};\r\n   295\t\r\n   296\t//////////////////////////////////////////////////////////////////////////\r\n   297\t/// \\brief A collection of keyframes for a single joint\r\n   298\t/// \\author Ivgeni Segal\r\n   299\t/// \\date January 20, 2007\r\n   300\t///\r\n   301\t/// \\remarks The timeline is the animation channel for a single joint.\r\n   302\t/// Timelines store the collection of keyframes for a single joint.\r\n   303\t/// An array of timelines is stored in the TMdfAnimation object. The array\r\n   304\t/// corresponds to the depth-first sequence of joints. This array is \r\n   305\t/// parallel to the bind and parenting arrays in the corresponding TMdfMesh\r\n   306\t/// object.\r\n   307\t///\r\n   308\t//////////////////////////////////////////////////////////////////////////\r\n   309\tstruct TMdfTimeline\r\n   310\t{\r\n   311\t\tint nKeyFrames;\r\n   312\t\r\n   313\t\tunion UKfs_t {\r\n   314\t\t\tTMdfKeyframe *pKeyframes;\r\n   315\t\t\tint nDataOffset;\r\n   316\t"]
[955.280047, "o", "\t} uKfs;\r\n   317\t};\r\n   318\t\r\n   319\t//////////////////////////////////////////////////////////////////////////\r\n   320\t/// \\brief MDF Animation Object for a single mesh\r\n"]
