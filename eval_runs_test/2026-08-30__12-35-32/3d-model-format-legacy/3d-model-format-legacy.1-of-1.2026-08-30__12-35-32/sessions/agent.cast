 {}\r\nMdfFormat.h:236:class MdfStream {\r\nMdfFormat.h:238:\tvirtual ~MdfStream() {};\r\nMdfFormat.h:239:\tvirtual bool Seek(int offset, int origin) = 0;\r\nMdfFormat.h:240:\tvirtual int Tell() = 0;\r\nMdfFormat.h:241:\tvirtual int Read(void *pDest, int nLength) = 0;\r\nMdfFormat.h:242:\tvirtual int Length() = 0;\r\nmdftypes.h:10:typedef int MdfHandle;\r\nmdftypes.h:21:struct MdfHeader \r\nmdftypes.h:52:struct MdfFullVertex {\r\nmdftypes.h:61:\tbool operator==(const MdfFullVertex &b) const {\r\nmdftypes.h:62:\t\tif(bones[0] != b.bones[0]){\r\nmdftypes.h:65:\t\tif(bones[1] != b.bones[1]){\r\nmdftypes.h:68:\t\tif(bones[2] != b.bones[2]){\r\nmdftypes.h:71:\t\tif(bones[3] != b.bones[3]){\r\nmdftypes.h:74:\t\tif(fabs(pos[0] - b.pos[0]) > MFDVERT_EPSILON) {\r\nmdftypes.h:77:\t\tif(fabs(pos[1] - b.pos[1]) > MFDVERT_EPSILON) {\r\nmdftypes.h:80:\t\tif(fabs(pos[2] - b.pos[2]) > MFDVERT_EPSILON) {\r\nmdftypes.h:83:\t\tif(fabs(weights[0] - b.weights[0]) > MFDVERT_EPSILON) {\r\nmdftypes.h:86:\t\tif(fabs(weights[1] - b.weights[1]) > MFDVERT_EPSILON) {\r\nmdftypes.h:89:\t\tif(fabs(weights[2] - b.weights[2]) > MFDVERT_EPSILON) {\r\nmdftypes.h:92:\t\tif(fabs(normal[0] - b.normal[0]) > MFDVERT_EPSILON) {\r\nmdftypes.h:95:\t\tif(fabs(normal[1] - b.normal[1]) > MFDVERT_EPSILON) {\r\nmdftypes.h:98:\t\tif(fabs(normal[2] - b.normal[2]) > MFDVERT_EPSILON) {\r\nmdftypes.h:101:\t\tif(fabs(u - b.u) > MFDVERT_EPSILON) {\r\nmdftypes.h:104:\t\tif(fabs(v - b.v) > MFDVERT_EPSILON) {\r\nmdftypes.h:125:struct TMdfMatrix4\r\nmdftypes.h:139:struct TMdfVertSkn\r\nmdftypes.h:158:struct TMdfVertSta\r\nmdftypes.h:165:\tTMdfVertSta & operator=(const TMdfVertSkn &rhs) {\r\nmdftypes.h:201:struct TMdfMesh\r\nmdftypes.h:208:\tint meshType;\t\t\t\t\t///< Mesh type (See MeshType enum)\r\nmdftypes.h:239:\tunion UPrnt_t {\t\t// reference to the (optional) hierarchy (parent info)\r\nmdftypes.h:260:\tunsigned int VertexSize() const {\r\nmdftypes.h:261:\t\tswitch(meshType) {\r\nmdftypes.h:263:\t\t\t\treturn sizeof(TMdfVertSta);\r\nmdftypes.h:266:\t\t\t\treturn sizeof(TMdfVertSkn);\r\nmdftypes.h:288:struct TMdfKeyframe\r\nmdftypes.h:309:struct TMdfTimeline\r\nmdftypes.h:336:struct TMdfAnimation\r\nmdftypes.h:339:\tint nNumTimelines;\t///< Number of timelines stored (corresponds to number\r\n"]
[206.458573, "o", "mdftypes.h:344:\t\tTMdfTimeline *pTimeline;\t///< Array of timeline (channel) objects\r\nmdftypes.h:372:typedef std::vector<MdfFullVertex> FullVertList;\r\nmdftypes.h:373:typedef std::vector<unsigned short> FullIndexList;\r\nmdftypes.h:375:struct MdfFullMesh {\r\nmdftypes.h:376:\tMdfFullMesh() : \r\nmdftypes.h:377:\t\tvertices(0), \r\nmdftypes.h:378:\t\tnumVertices(0), \r\nmdftypes.h:379:\t\tfinalBindPose(0), \r\nmdftypes.h:380:\t\tparentInfo(0),\r\nmdftypes.h:381:\t\tnumBindPoseElements(0)\r\nmdftypes.h:399:\tvoid addVertex(const MdfFullVertex &v) {\r\nmdftypes.h:400:\t\tunsigned short tmpSize = (unsigned short)finalVerts.size();\r\nmdftypes.h:402:\t\tfor(unsigned short i = 0; i < tmpSize; i++) {\r\nmdftypes.h:403:\t\t\tif(finalVerts[i] == v) {\r\nmdftypes.h:404:\t\t\t\tfinalIndices.push_back(i);\r\nmdftypes.h:409:\t\tfinalVerts.push_back(v);\r\nmdftypes.h:410:\t\tfinalIndices.push_back(tmpSize);\r\nmdftypes.h:413:\tvoid Clear(void) {\r\nmdftypes.h:424:\t\tfinalVerts.clear();\r\nmdftypes.h:425:\t\tfinalIndices.clear();\r\nmdftypes.h:427:\t\ttextureFilename.clear();\r\nmdftypes.h:434:typedef std::vector<TMdfKeyframe> FullKeyframeList;\r\nmdftypes.h:436:struct MdfFullTimeline\r\nmdftypes.h:441:typedef std::vector<MdfFullTimeline> FullTimelineList;\r\nmdftypes.h:443:struct MdfFullAnimation\r\nmdftypes.h:445:\tMdfFullAnimation() : hMeshId(0), fTimeLength(0) {}\r\nmdftypes.h:452:\tvoid Clear(void) {\r\nmdftypes.h:455:\t\tvTimelines.clear();\r\n"]
