[516.971466, "o", "\t\t\t} else {\r\n   557\t\t\t\tm_vpMeshes[i].uBnd.pBindMats = 0;\r\n   558\t\t\t\tm_vpMeshes[i].uPrnt.pParentInfo = 0;\r\n   559\t\t\t}\r\n   560\t\t\tdataPos += sizeof(TMdfMesh);\r\n   561\t\t}\r\n   562\t\r\n   563\t\t//\r\n   564\t\t// for each animation, fix up the pointers\r\n   565\t\t//\r\n   566\t\tfor(size_t i = 0; i < m_tMdfHeader.nAnimCount; i++) {\r\n   567\t\t\tm_vpAnimations[i].uTls.pTimeline = (TMdfTimeline*)(m_pData + m_vpAnimations[i].uTls.nDataOffset - nHeaderLength);\r\n   568\t\r\n   569\t\t\t// fix up the time-line pointers\r\n   570\t\t\tfor(int t = 0; t < m_vpAnimations[i].nNumTimelines; t++) {\r\n   571\t\t\t\tm_vpAnimations[i].uTls.pTimeline[t].uKfs.pKeyframes = (TMdfKeyframe*)(m_pData + m_vpAnimations[i].uTls.pTimeline[t].uKfs.nDataOffset - nHeaderLength);\r\n   572\t\t\t}\r\n   573\t\t}\r\n   574\t\r\n   575\t\treturn true;\r\n   576\t}\r\n   577"]
