[833.058746, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
[833.058986, "o", "\u001b[?2004hroot@09247f3a7949:/app/MdfLib# "]
[833.059141, "o", "cd /app/MdfLib && echo '--- MdfFormat.cpp head ---' && sed -n '1,140p' MdfFormat.cpp\r\n\u001b[?2004l\r"]
[833.059279, "o", "--- MdfFormat.cpp head ---\r\n"]
[833.060864, "o", "#include \"stdafx.h\"\r\n#include \"MdfFormat.h\"\r\n#include <stdint.h>\r\n#include <stdlib.h>\r\n\r\nconst char MDF_VER_STR[8] = {\r\n\t'M',\r\n\t'D',\r\n\t'F',\r\n\t' ',\r\n\t'v',\r\n\t'1',\r\n\t'.',\r\n\t'2'\r\n};\r\n\r\nclass MdfMemStream\r\n\t: public MdfStream\r\n{\r\npublic:\r\n\tMdfMemStream(Byte *pData, int nDataLen) : pData(pData), nDataLen(nDataLen), nPos(0) {}\r\n\tvirtual ~MdfMemStream() {}\r\n\r\n\tvirtual bool Seek(int offset, int origin);\r\n\tvirtual int Tell();\r\n\tvirtual int Read(void *pDest, int nLength);\r\n\tvirtual int Length();\r\n\r\nprivate:\r\n\tByte *pData;\r\n\tint nDataLen;\r\n\tint nPos;\r\n\r\n};\r\n\r\nbool MdfMemStream::Seek(int offset, int origin)\r\n"]
[833.061097, "o", "{\r\n\tswitch(origin) {\r\n\t\tcase SEEK_SET:\r\n\t\t{\r\n\t\t\tif(offset < 0 || offset > nDataLen) {\r\n\t\t\t\treturn false;\r\n\t\t\t}\r\n\t\t\tnPos = offset;\r\n\t\t} break;\r\n\t\tcase SEEK_CUR:\r\n\t\t{\r\n\t\t\tregister int test = nPos += offset;\r\n\t\t\tif(test < 0 || test > nDataLen) {\r\n\t\t\t\treturn false;\r\n\t\t\t}\r\n\t\t\tnPos += offset;\r\n\t\t} break;\r\n\t\tcase SEEK_END:\r\n\t\t{\r\n\t\t\tregister int test = nPos += offset;\r\n\t\t\tif(test < 0 || test > nDataLen) {\r\n\t\t\t\treturn false;\r\n\t\t\t}\r\n\t\t\tnPos = nDataLen - origin;\r\n\t\t} break;\r\n\t}\r\n\treturn true;\r\n}\r\n\r\nint MdfMemStream::Tell()\r\n{\r\n\treturn nPos;\r\n}\r\n\r\nint MdfMemStream::Read(void *pDest, int nLength)\r\n{\r\n\tif(nPos + nLength >= nDataLen) {\r\n\t\tnLength = nDataLen - nPos;\r\n\t}\r\n\tmemcpy(pDest, &pData[nPos], nLength);\r\n\tnPos += nLength;\r\n\treturn nLength;\r\n}\r\n\r\nint MdfMemStream::Length()\r\n{\r\n\treturn nDataLen;\r\n}\r\n"]
[833.061254, "o", "\r\n//////////////////////////////////////////////////////////////////////////\r\n\r\nclass MdfFileStream\r\n\t: public MdfStream\r\n{\r\npublic:\r\n\tMdfFileStream() : fp(0), nDataLen(0) {}\r\n\tvirtual ~MdfFileStream() { Close(); }\r\n\r\n\tbool Open(const char *szFilename) {\r\n\t\tfp = fopen(szFilename, \"rb\");\r\n\t\tif(fp) {\r\n\t\t\tfseek(fp, 0, SEEK_END);\r\n\t"]
[833.061466, "o", "\t\tnDataLen = (int)ftell(fp);\r\n\t\t\tfseek(fp, 0, SEEK_SET);\r\n\t\t\treturn true;\r\n\t\t} else {\r\n\t\t\treturn false;\r\n\t\t}\r\n\t}\r\n\r\n\tvoid Close() {\r\n\t\tif(fp) {\r\n\t\t\tfclose(fp);\r\n\t\t}\r\n\t\tfp = 0;\r\n\t\tnDataLen = 0;\r\n\t}\r\n\r\n\tvirtual bool Seek(int offset, int origin) {\r\n\t\treturn(fseek(fp, offset, origin) == 0);\r\n\t}\r\n\r\n\tvirtual int Tell() { return (int)ftell(fp); }\r\n\r\n\tvirtual int Read(void *pDest, int nLength) {\r\n\t\treturn (int)fread(pDest, 1, nLength, fp);\r\n\t}\r\n\r\n\tvirtual int Length() { return nDataLen; }\r\n\r\n"]
[833.061681, "o", "private:\r\n\tFILE *fp;\r\n\tint nDataLen;\r\n};\r\n\r\n//////////////////////////////////////////////////////////////////////////\r\n\r\nMdfFormat::MdfFormat(void)\r\n: m_nDataSize(0),\r\n  m_pData(0),\r\n  m_vpMeshes(0),\r\n  m_nMeshArrayLength(0),\r\n  m_vpAnimations(0),\r\n  m_nAnimArrayLength(0),\r\n"]
