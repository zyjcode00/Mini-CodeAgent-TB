[765.675602, "o", "\u001b[32m\u001b[K126\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tunsigned int \u001b[01;31m\u001b[KGetNumMeshes\u001b[m\u001b[K() const { return m_tMdfHeader.nMeshCount; }\r\n\u001b[32m\u001b[K134\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t/// \\warning Invalid indexes are not checked, use \u001b[01;31m\u001b[KGetNumMeshes\u001b[m\u001b[K() to find\r\n\u001b[32m\u001b[K137\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tconst TMdfMesh & \u001b[01;31m\u001b[KGetMesh\u001b[m\u001b[K(MdfHandle hMeshId) const { return m_vpMeshes[hMeshId]; }\r\n"]
[765.6757, "o", "\u001b[32m\u001b[K144\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tunsigned int \u001b[01;31m\u001b[KGetNumAnimations\u001b[m\u001b[K() const { return m_tMdfHeader.nAnimCount; }\r\n\u001b[32m\u001b[K152\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t/// \\warning Invalid indexes are not checked, use \u001b[01;31m\u001b[KGetNumAnimations\u001b[m\u001b[K() to find\r\n\u001b[32m\u001b[K155\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tconst TMdfAnimation & \u001b[01;31m\u001b[KGetAnimation\u001b[m\u001b[K(MdfHandle hAnimId) const { return m_vpAnimations[hAnimId]; }\r\n\u001b[32m\u001b[K186\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tconst char * \u001b[01;31m\u001b[KGetTextureName\u001b[m\u001b[K(MdfHandle hTextureId) const { return m_vpTextures[hTextureId]; }\r\n"]
[765.676007, "o", "\u001b[32m\u001b[K193\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tconst MdfHeader & \u001b[01;31m\u001b[KGetHeader\u001b[m\u001b[K() const { return m_tMdfHeader; }\r\n\u001b[32m\u001b[K209\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t/// \u001b[01;31m\u001b[KLoad\u001b[m\u001b[Ks an MDF from a given stream\r\n\u001b[32m\u001b[K214\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tbool \u001b[01;31m\u001b[KLoad\u001b[m\u001b[KFromStream(MdfStream &stream);\r\n"]
