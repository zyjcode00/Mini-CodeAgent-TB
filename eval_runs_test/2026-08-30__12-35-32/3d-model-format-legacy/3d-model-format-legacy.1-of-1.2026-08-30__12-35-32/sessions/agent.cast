[415.993944, "o", "    28\t\r\n    29\tprivate:\r\n    30\t\tfloat element[3];\r\n    31\t};\r\n    32\t\r\n    33\tunion Float4 {\r\n    34\t\tstruct {\r\n    35\t\t\tfloat x, y, z, w;\r\n    36\t\t};\r\n    37\t\r\n    38\t\tstruct {\r\n    39\t\t\tfloat r, g, b, a;\r\n    40\t\t};\r\n    41\t\r\n    42\t\tfloat & operator[] (int idx) { return element[idx]; }\r\n    43\t\r\n    44\tprivate:\r\n    45\t\tfloat element[4];\r\n    46\t};\r\n    47\t\r\n    48\ttypedef unsigned char Byte;\r\n"]
