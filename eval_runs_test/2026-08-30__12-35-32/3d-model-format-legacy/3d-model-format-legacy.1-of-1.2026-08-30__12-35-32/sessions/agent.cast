[338.001156, "o", "   430\t\r\n   431\t\t\t// write the indices\r\n   432\t\t\tByteAlignFile(fp);\r\n   433\t\t\tpHeaderMeshes[i].uIdxs.nDataOffset = ftell(fp);\r\n   434\t\t\tfwrite(pMesh->uIdxs.pIndices, sizeof(unsigned short), pMesh->nNumIndices, fp);\r\n   435\t\r\n   436\t\t\tif(pMesh->meshType == TMdfMesh::MESH_SKINNED) {\r\n   437\t\t\t\tByteAlignFile(fp);\r\n   438\t\t\t\t// write the bind-pose skin data\r\n   439\t\t\t\tpHeaderMeshes[i].uBnd.nDataOffset = ftell(fp);\r\n   440\t\t\t\tfwrite(pMesh->uBnd.pBindMats, sizeof(TMdfMatrix4), pMesh->nNumJoints, fp);\r\n   441\t\t\t\t\r\n   442\t\t\t\tByteAlignFile(fp);\r\n"]
[338.001392, "o", "   443\t\t\t\t// write out the parenting info\r\n   444\t\t\t\tpHeaderMeshes[i].uPrnt.nDataOffset = ftell(fp);\r\n   445\t\t\t\tfwrite(pMesh->uPrnt.pParentInfo, sizeof(int), pMesh->nNumJoints, fp);\r\n   446\t\t\t}\r\n   447\t\t}\r\n   448\t\r\n   449\t\t//\r\n   450\t\t// for each animation, save the data\r\n   451\t\t//\r\n   452\t\tfor(unsigned int i = 0; i < m_tMdfHeader.nAnimCount; i++) {\r\n   453\t\t\tconst TMdfAnimation *pAnim = &m_vpAnimations[i];\r\n   454\t\t\tpHeaderAnims[i] = *pAnim;\r\n   455\t\r\n   456\t\t\tTMdfTimeline *pHeaderTimelines = (TMdfTimeline *)malloc(pAnim->nNumTimelines * sizeof(TMdfTimeline));\r\n   457\t\r\n   458\t\t\t// for each time-line\r\n   459\t\t\tfor(int t = 0; t < pAnim->nNumTimelines; t++) {\r\n   460\t\r\n   461\t\t\t\tconst TMdfTimeline *pTimeline = &pAnim->uTls.pTimeline[t];\r\n   462\t\t\t\tpHeaderTimelines[t] = *pTimeline;\r\n   463\t\r\n   464\t\t\t\t// write out the keyframes\r\n   465\t\t\t\tByteAlignFile(fp);\r\n   466\t\t\t\tpHeaderTimelines[t].uKfs.nDataOffset = ftell(fp);\r\n   467\t\t\t\tfwrite(pTimeline->uKfs.pKeyframes, sizeof(TMdfKeyframe), pTimeline->nKeyFrames, fp);\r\n   468\t\t\t}\r\n   469\t\r\n   470\t\t\t// write out the timelines\r\n   471\t\t\tByteAlignFile(fp);\r\n   472\t\t\tpHeaderAnims[i].uTls.nDataOffset = ftell(fp);\r\n   473\t\t\tfwrite(pHeaderTimelines, sizeof(TMdfTimeline), pAnim->nNumTimelines, fp);\r\n   474\t\t\tfree(pHeaderTimelines);\r\n   475\t\t}\r\n   476\t\r\n"]
[338.001655, "o", "   477\t\tm_tMdfHeader.nTotalDataSize = (unsigned int)ftell(fp) - sizeof(MdfHeader);\r\n   478\t\r\n   479\t\t//\r\n   480\t\t// go back and write out the headers\r\n   481\t\t//\r\n   482\t\tfseek(fp, 0, SEEK_SET);\r\n   483\t\r\n   484\t\t// write the main header\r\n   485\t\tfwrite(&m_tMdfHeader, sizeof(m_tMdfHeader), 1, fp);\r\n   486\t\r\n   487\t\t// used textures header\r\n   488\t\tfwrite(pHeaderTextures, sizeof(int), m_tMdfHeader.nTextureCount, fp);\r\n   489\t\r\n   490\t\t// mesh headers\r\n   491\t\tfwrite(pHeaderMeshes, sizeof(TMdfMesh), m_tMdfHeader.nMeshCount, fp);\r\n   492\t\r\n   493\t\t// animation headers\r\n   494\t\tfwrite(pHeaderAnims, sizeof(TMdfAnimation), m_tMdfHeader.nAnimCount, fp);\r\n   495\t\r\n   496\t\tfclose(fp);\r\n   497\t\r\n   498\t\tfree(pHeaderMeshes);\r\n   499\t\tfree(pHeaderAnims);\r\n   500\t\tfree(pHeaderTextures);\r\n   501\t\r\n   502\t\treturn true;\r\n   503\t}\r\n   504\t\r\n   505\tbool MdfFormat::LoadFromStream(MdfStream &stream)\r\n   506\t{\r\n   507\t\tif(m_vpMeshes || m_pData) {\r\n   508\t\t\treturn false;\r\n   509\t\t}\r\n   510\t\tint nHeaderLength = sizeof(m_tMdfHeader);\r\n   511\t\r\n   512\t\tstream.Read(&m_tMdfHeader, nHeaderLength);\r\n   513\t\r\n   514\t\t// read the entire file\r\n   515\t\tm_nDataSize = stream.Length() - nHeaderLength;\r\n   516\t\tm_pData = (Byte*)malloc(m_nDataSize);\r\n   517\t\tstream.Read(m_pData, (int)m_nDataSize);\r\n   518\t\r\n   519\t\tint dataPos = 0;\r\n   520\t\r\n   521\t\t// check for textures and set their pointer\r\n   522\t\tif(m_tMdfHeader.nTextureCount > 0) {\r\n   523\t\t\tm_vpTextures = (char**)&m_pData[dataPos];\r\n   524\t\t\tdataPos += m_tMdfHeader.nTextureCount * sizeof(int);\r\n   525\t\t}\r\n   526\t\r\n   527\t\t// check for meshes and set their pointer\r\n   528\t\tif(m_tMdfHeader.nMeshCount > 0) {\r\n   529\t\t\tm_vpMeshes = (TMdfMesh*)&m_pData[dataPos];\r\n   530\t\t\tdataPos += m_tMdfHeader.nMeshCount * sizeof(TMdfMesh);\r\n   531\t\t}\r\n   532\t\r\n   533\t\t// check for animations and set their pointer\r\n   534"]
[338.00186, "o", "\t\tif(m_tMdfHeader.nAnimCount > 0) {\r\n   535\t\t\tm_vpAnimations = (TMdfAnimation*)&m_pData[dataPos];\r\n   536\t\t}\r\n   537\t\r\n   538\t\t//\r\n   539\t\t// for each texture, fix up the pointers\r\n   540\t\t//\r\n   541\t\tfor(size_t i = 0; i < m_tMdfHeader.nTextureCount; i++) {\r\n   542\t\t\tm_vpTextures[i] = (char*)(m_pData  + ((int)m_vpTextures[i]) - nHeaderLength);\r\n   543\t\t}\r\n   544\t\r\n   545\t\t//\r\n   546\t\t// for each mesh fix up the pointers\r\n   547\t\t//\r\n   548\t\tfor(size_t i = 0; i < m_tMdfHeader.nMeshCount; i++) {\r\n   549\t\t\tm_vpMeshes[i].uVtxs.pVertices = m_pData + m_vpMeshes[i].uVtxs.nDataOffset - nHeaderLength;\r\n   550\t\t\tm_vpMeshes[i].uIdxs.pIndices = (unsigned short*)(m_pData + m_vpMeshes[i].uIdxs.nDataOffset - nHeaderLength);\r\n   551\t\t\t\r\n   552\t\t\tif(m_vpMeshes[i].nNumJoints > 0) {\r\n   553\t\t\t\tm_vpMeshes[i].uBnd.pBindMats = (TMdfMatrix4*)(m_pData + m_vpMeshes[i].uBnd.nDataOffset - nHeaderLength);\r\n   554\t\t\t\tm_vpMeshes[i].uPrnt.pParentInfo = (int*)(m_pData + m_vpMeshes[i].uPrnt.nDataOffset - nHeaderLength);\r\n   555\t\t\t} else {\r\n   556\t\t\t\tm_vpMeshes[i].uBnd.pBindMats = 0;\r\n   557\t\t\t\tm_vpMeshes[i].uPrnt.pParentInfo = 0;\r\n   558\t\t\t}\r\n   559\t\t\tdataPos += sizeof(TMdfMesh);\r\n   560\t\t}\r\n   561\t\r\n   562\t\t//\r\n   563\t\t// for each animation, fix up the pointers\r\n   564\t\t//\r\n   565\t\tfor(size_t i = 0; i < m_tMdfHeader.nAnimCount; i++) {\r\n   566\t\t\tm_vpAnimations[i].uTls.pTimeline = (TMdfTimeline*)(m_pData + m_vpAnimations[i].uTls.nDataOffset - nHeaderLength);\r\n   567\t\r\n   568\t\t\t// fix up the time-line pointers\r\n   569\t\t\tfor(int t = 0; t < m_vpAnimations[i].nNumTimelines; t++) {\r\n   570"]
[338.002035, "o", "\t\t\t\tm_vpAnimations[i].uTls.pTimeline[t].uKfs.pKeyframes = (TMdfKeyframe*)(m_pData + m_vpAnimations[i].uTls.pTimeline[t].uKfs.nDataOffset - nHeaderLength);\r\n   571\t\t\t}\r\n   572\t\t}\r\n   573\t\r\n   574\t\treturn true;\r\n   575\t}\r\n   576\t\r\n   577\tvoid MdfFormat::Destroy()\r\n   578\t{\r\n   579\t\t// clean up any additional memory and\r\n   580\t\t// reset all the internal state to default\r\n   581\t\r\n   582\t\tif(m_pData) {\r\n   583\t\t\tfree(m_pData);\r\n   584\t\r\n   585\t\t} else {\r\n   586\t\t\t// release meshes\r\n   587\t\t\tfor(unsigned int i = 0; i < m_nMeshArrayLength; i++) {\r\n   588\t\t\t\tfree(m_vpMeshes[i].uVtxs.pVertices);\r\n   589\t\t\t\tfree(m_vpMeshes[i].uIdxs.pIndices);\r\n   590\t\t\t\tfree(m_vpMeshes[i].uBnd.pBindMats);\r\n   591\t\t\t\tfree(m_vpMeshes[i].uPrnt.pParentInfo);\r\n   592\t\t\t}\r\n   593\t\r\n   594\t\t\t// release animations\r\n   595\t\t\tfor(unsigned int i = 0; i < m_nAnimArrayLength; i++) {\r\n   596\t\r\n   597\t\t\t\t// release timelines\r\n   598\t\t\t\tfor(int t = 0; t < m_vpAnimations[i].nNumTimelines; t++) {\r\n   599\t\t\t\t\t// release keyframes\r\n   600\t\t\t\t\tfree(m_vpAnimations[i].uTls.pTimeline[t].uKfs.pKeyframes);\r\n   601\t\t\t\t}\r\n"]
[338.002433, "o", "   602\t\t\t\tfree(m_vpAnimations[i].uTls.pTimeline);\r\n   603\t\r\n   604\t\t\t}\r\n   605\t\r\n   606\t\t\tfree(m_vpMeshes);\r\n   607\t\t\tfree(m_vpAnimations);\r\n   608\t\r\n   609\t\t\t// release textures\r\n   610\t\t\tfor(unsigned i = 0; i < m_tMdfHeader.nTextureCount; i++) {\r\n   611\t\t\t\tfree(m_vpTextures[i]);\r\n   612\t\t\t}\r\n   613\t\t\tfree(m_vpTextures);\r\n   614\t\r\n   615\t\t} // if(m_pData)\r\n   616\t\r\n   617\t\tm_pData = 0;\r\n   618\t\tm_vpMeshes = 0;\r\n   619\t\tm_vpAnimations = 0;\r\n   620\t\r\n"]
