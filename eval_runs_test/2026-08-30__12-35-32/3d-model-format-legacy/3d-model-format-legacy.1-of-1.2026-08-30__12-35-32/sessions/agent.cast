[590.817185, "o", "import sys\r\n\u001b[?2004l\r\u001b[?2004h"]
[590.817383, "o", "> "]
[590.817543, "o", "path = sys.argv[1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[590.847942, "o", "old_str = 'bool MdfFormat::LoadFromStream(MdfStream &stream)\\n{\\n        if(m_vpMeshes || m_pData) {\\n                return false;\\n        }\\n        int nHeaderLength = sizeof(m_tMdfHeader);\\n\\n        stream.Read(&m_tMdfHeader, nHeaderLength);\\n\\n        // read the entire file\\n        m_nDataSize = stream.Length() - nHeaderLength;\\n        m_pData = (Byte*)malloc(m_nDataSize);\\n        stream.Read(m_pData, (int)m_nDataSize);\\n\\n        int dataPos = 0;\\n\\n        // check for textures and set their pointer\\n        if(m_tMdfHeader.nTextureCount > 0) {\\n                m_vpTextures = (char**)&m_pData[dataPos];\\n                dataPos += m_tMdfHeader.nTextureCount * sizeof(int);\\n        }\\n\\n        // check for meshes and set their pointer\\n        if(m_tMdfHeader.nMeshCount > 0) {\\n                m_vpMeshes = (TMdfMesh*)&m_pData[dataPos];\\n                dataPos += m_tMdfHeader.nMeshCount * sizeof(TMdfMesh);\\n        }\\n\\n        // check for animations and set their pointer\\n        if(m_tMdfHeader.nAnimCount > 0) {\\n                m_vpAnimations = (TMdfAnimation*)&m_pData[dataPos];\\n        }\\n\\n        //\\n        // for each texture, fix up the pointers\\n        //\\n        for(size_t i = 0; i < m_tMdfHeader.nTextureCount; i++) {\\n                m_vpTextures[i] = (char*)(m_pData  + ((int)m_vpTextures[i]) - nHeaderLength);\\n        }\\n\\n        //\\n        // for each mesh fix up the pointers\\n        //\\n        for(size_t i = 0; i < m_tMdfHeader.nMeshCount; i++) {\\n                m_vpMeshes[i].uVtxs.pVertices = m_pData + m_vpMeshes[i].uVtxs.nDataOffset - nHeaderLength;\\n                m_vpMeshes[i].uIdxs.pIndices = (unsigned short*)(m_pData + m_vpMeshes[i].uIdxs.nDataOffset - nHeaderLength);\\n\\n                if(m_vpMeshes[i].nNumJoints > 0) {\\n                        m_vpMeshes[i].uBnd.pBindMats = (TMdfMatrix4*)(m_pData + m_vpMeshes[i].uBnd.nDataOffset - nHeaderLength);\\n                        m_vpMeshes[i].uPrnt.pParentInfo = (int*)(m_pData + m_vpMeshes[i].uPrnt.nDataOffset - nHeaderLength);\\n                } else {\\n                        m_vpMeshes[i].uBnd.pBindMats = 0;\\n                        m_vpMeshes[i].uPrnt.pParentInfo = 0;\\n                }\\n                dataPos += sizeof(TMdfMesh);\\n        }\\n\\n        //\\n        // for each animation, fix up the pointers\\n        //\\n        for(size_t i = 0; i < m_tMdfHeader.nAnimCount; i++) {\\n                m_vpAnimations[i].uTls.pTimeline = (TMdfTimeline*)(m_pData + m_vpAnimations[i].uTls.nDataOffset - nHeaderLength);\\n\\n                // fix up the time-line pointers\\n                for(int t = 0; t < m_vpAnimations[i].nNumTimelines; t++) {\\n                        m_vpAnimations[i].uTls.pTimeline[t].uKfs.pKeyframes = (TMdfKeyframe*)(m_pData + m_vpAnimations[i].uTls.pTimeline[t].uKfs.nDataOffset - nHeaderLength);\\n                }\\n        }\\n\\n        return true;\\n}'\r\n\u001b[?2004l\r"]
[590.848144, "o", "\u001b[?2004h> "]
[590.875634, "o", "new_str = 'bool MdfFormat::LoadFromStream(MdfStream &stream)\\n{\\n        if(m_vpMeshes || m_pData) {\\n                return false;\\n        }\\n\\n        const int headerSize = sizeof(MdfHeader);\\n        const int fileSize = stream.Length();\\n        if(fileSize < headerSize || stream.Read(&m_tMdfHeader, headerSize) != headerSize) {\\n                return false;\\n        }\\n\\n        const size_t rawSize = static_cast<size_t>(fileSize - headerSize);\\n        Byte *raw = static_cast<Byte*>(malloc(rawSize));\\n        if(!raw || stream.Read(raw, static_cast<int>(rawSize)) != static_cast<int>(rawSize)) {\\n                free(raw);\\n                return false;\\n        }\\n\\n        // The 2007 file format was written on win32. Its pointer unions are\\n        // serialized as 32-bit absolute file offsets, while the in-memory API\\n        // uses native pointers. Keep the raw payload and materialize native\\n        // header arrays in the same allocation.\\n        struct DiskMesh { unsigned int verts, indices, joints; int texture, type, vertexOffset, indexOffset, bindOffset, parentOffset; };\\n        struct DiskAnimation { int mesh, timelines, timeLengthBits, timelineOffset; };\\n        struct DiskTimeline { int keyframes, keyframeOffset; };\\n        const size_t textureBytes = static_cast<size_t>(m_tMdfHeader.nTextureCount) * sizeof(int);\\n        const size_t meshBytes = static_cast<size_t>(m_tMdfHeader.nMeshCount) * sizeof(DiskMesh);\\n        const size_t animBytes = static_cast<size_t>(m_tMdfHeader.nAnimCount) * sizeof(DiskAnimation);\\n        const size_t nativeBytes = static_cast<size_t>(m_tMdfHeader.nTextureCount) * sizeof(char*) +\\n                static_cast<size_t>(m_tMdfHeader.nMeshCount) * sizeof(TMdfMesh) +\\n                static_cast<size_t>(m_tMdfHeader.nAnimCount) * sizeof(TMdfAnimation);\\n        if(rawSize < textureBytes + meshBytes + animBytes) {\\n                free(raw);\\n                return false;\\n        }\\n        Byte *data = static_cast<Byte*>(malloc(rawSize + nativeBytes));\\n        if(!data) { free(raw); return false; }\\n        memcpy(data, raw, rawSize);\\n        free(raw);\\n        m_pData = data;\\n        m_nDataSize = rawSize + nativeBytes;\\n        Byte *cursor = data + rawSize;\\n        const auto payload = [data, headerSize](int offset) -> Byte* {\\n                return offset >= headerSize ? data + (offset - headerSize) : 0;\\n        };\\n\\n        const int *textureOffsets = reinterpret_cast<const int*>(data);\\n        if(m_tMdfHeader.nTextureCount) {\\n                m_vpTextures = reinterpret_cast<char**>(cursor);\\n                cursor += static_cast<size_t>(m_tMdfHeader.nTextureCount) * sizeof(char*);\\n                for(unsigned int i = 0; i < m_tMdfHeader.nTextureCount; ++i) m_vpTextures[i] = reinterpret_cast<char*>(payload(textureOffsets[i]));\\n        }\\n        const DiskMesh *diskMeshes = reinterpret_cast<const DiskMesh*>(data + textureBytes);\\n        if(m_tMdfHeader.nMeshCount) {\\n                m_vpMeshes = reinterpret_cast<TMdfMesh*>(cursor);\\n                cursor += static_cast<size_t>(m_tMdfHeader.nMeshCount) * sizeof(TMdfMesh);\\n                for(unsigned int i = 0; i < m_tMdfHeader.nMeshCount; ++i) {\\n                        const DiskMesh &d = diskMeshes[i]; TMdfMesh &m = m_vpMeshes[i];\\n                        m.nNumVerts=d.verts; m.nNumIndices=d.indices; m.nNumJoints=d.joints; m.hTexture=d.texture; m.meshType=d.type;\\n                        m.uVtxs.pVertices=payload(d.vertexOffset); m.uIdxs.pIndices=reinterpret_cast<unsigned short*>(payload(d.indexOffset));\\n                        m.uBnd.pBindMats=d.joints ? reinterpret_cast<TMdfMatrix4*>(payload(d.bindOffset)) : 0;\\n                        m.uPrnt.pParentInfo=d.joints ? reinterpret_cast<int*>(payload(d.parentOffset)) : 0;\\n                }\\n        }\\n        const DiskAnimation *diskAnimations = reinterpret_cast<const DiskAnimation*>(data + textureBytes + meshBytes);\\n        if(m_tMdfHeader.nAnimCount) {\\n                m_vpAnimations = reinterpret_cast<TMdfAnimation*>(cursor);\\n               "]
[590.87584, "o", " for(unsigned int i = 0; i < m_tMdfHeader.nAnimCount; ++i) {\\n                        const DiskAnimation &d=diskAnimations[i]; TMdfAnimation &a=m_vpAnimations[i];\\n                        a.hMeshId=d.mesh; a.nNumTimelines=d.timelines; memcpy(&a.fTimeLength, &d.timeLengthBits, sizeof(float));\\n                        a.uTls.pTimeline=reinterpret_cast<TMdfTimeline*>(payload(d.timelineOffset));\\n                        for(int t=0; t<a.nNumTimelines; ++t) { DiskTimeline dt; memcpy(&dt, a.uTls.pTimeline+t, sizeof(dt)); a.uTls.pTimeline[t].nKeyFrames=dt.keyframes; a.uTls.pTimeline[t].uKfs.pKeyframes=reinterpret_cast<TMdfKeyframe*>(payload(dt.keyframeOffset)); }\\n                }\\n        }\\n        return true;\\n}'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[590.875986, "o", "def normalize_text(text: str) -> str:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[590.876225, "o", "    text = text.replace('\\r\\n', '\\n').replace('\\r', '\\n')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[590.876517, "o", "    return '\\n'.join(line.rstrip() for line in text.split('\\n'))\r\n\u001b[?2004l\r"]
[590.876674, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[590.876792, "o", "> try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[590.877, "o", "    with open(path, 'r', encoding='utf-8', errors='replace') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[590.877154, "o", "        content = f.read()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[590.877482, "o", "except FileNotFoundError:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[590.877586, "o", "    print(f\"错误: 找不到文件 {path}\")\r\n\u001b[?2004l\r\u001b[?2004h>     raise SystemExit(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[590.877899, "o", "except Exception as exc:\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"修改失败: {exc}\")\r\n\u001b[?2004l\r"]
[590.87804, "o", "\u001b[?2004h>     raise SystemExit(0)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[590.8782, "o", "\u001b[?2004h> "]
[590.87834, "o", "content = normalize_text(content)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[590.878533, "o", "old_str = normalize_text(old_str)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[590.878708, "o", "new_str = normalize_text(new_str)\r\n\u001b[?2004l\r"]
[590.878879, "o", "\u001b[?2004h> "]
[590.879056, "o", "count = content.count(old_str)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[590.879209, "o", "if count == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[590.880146, "o", "    print(\"错误: 在文件中找不到 old_str。\\n建议：\\n1. 使用 read_file(raw_mode=True) 获取原始内容\\n2. 检查是否有多余的空格或换行符\\n3. 如果文件较大，考虑使用 write_full_file 全量覆盖\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[590.88036, "o", ">     raise SystemExit(0)\r\n\u001b[?2004l\r"]
[590.880591, "o", "\u001b[?2004h> "]
[590.880859, "o", "if count > 1:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[590.881428, "o", "    print(f\"错误: 匹配到 {count} 处相同的代码，请提供更具体的 old_str 以确保唯一性。\")\r\n\u001b[?2004l\r"]
[590.881528, "o", "\u001b[?2004h> "]
[590.881731, "o", "    raise SystemExit(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[590.881997, "o", "with open(path, 'w', encoding='utf-8', newline='\\n') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[590.882157, "o", "    f.write(content.replace(old_str, new_str))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[590.882404, "o", "print(f\"成功: 已更新 {path}。修改已持久化。\")\r\n\u001b[?2004l\r"]
