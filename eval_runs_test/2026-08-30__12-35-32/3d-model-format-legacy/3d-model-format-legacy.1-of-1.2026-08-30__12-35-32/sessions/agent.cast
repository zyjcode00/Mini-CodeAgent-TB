[895.514144, "o", "cd /app/MdfLib && sed -n '1,120p' types.h; sed -n '1,80p' MdfFormat.h; grep -n \"MdfFormat::Load\\|LoadFromFile\\|MdfFormat(\" MdfFormat.cpp MdfFormat.h\r\n\u001b[?2004l\r"]
[895.515827, "o", "#pragma once\r\n\r\nunion Float2 {\r\n\tstruct {\r\n\t\tfloat x, y;\r\n\t};\r\n\r\n\tstruct {\r\n\t\tfloat u, v;\r\n\t};\r\n\r\n"]
[895.516106, "o", "\tfloat & operator[] (int idx) { return element[idx]; }\r\n\r\nprivate:\r\n\tfloat element[2];\r\n};\r\n\r\nunion Float3 {\r\n\tstruct {\r\n\t\tfloat x, y, z;\r\n\t};\r\n\r\n\tstruct {\r\n\t\tfloat r, g, b;\r\n\t};\r\n\r\n\tfloat & operator[] (int idx) { return element[idx]; }\r\n\r\nprivate:\r\n\tfloat element[3];\r\n};\r\n\r\nunion Float4 {\r\n"]
[895.516321, "o", "\tstruct {\r\n\t\tfloat x, y, z, w;\r\n\t};\r\n\r\n\tstruct {\r\n\t\tfloat r, g, b, a;\r\n\t};\r\n\r\n\tfloat & operator[] (int idx) { return element[idx]; }\r\n\r\nprivate:\r\n\tfloat element[4];\r\n};\r\n\r\ntypedef unsigned char Byte;"]
[895.517621, "o", "\r\n#pragma once\r\n\r\n#include \"mdftypes.h\"\r\n\r\n#define MDF_BYTE_ALIGNMENT 16\r\n\r\nclass MdfStream;\r\n\r\nclass MdfFormat\r\n{\r\n\tenum MdfElements {\r\n\t\tMDF_NONE\t\t=\t0,\r\n\t\tMDF_MESHES\t\t=\t1,\r\n"]
[895.51781, "o", "\t\tMDF_TEXTURES\t=\t2,\r\n\t\tMDF_BINDMATS\t=\t4,\r\n\t\tMDF_PARENTINFO\t=\t8,\r\n\t\tMDF_ANIMATIONS\t=\t16,\r\n\t\tMDF_TRANSFORMS\t=\t32,\r\n\t\tMDF_ALL\t\t\t= (MDF_MESHES|MDF_TEXTURES|MDF_BINDMATS|MDF_PARENTINFO|MDF_ANIMATIONS|MDF_TRANSFORMS)\r\n\t};\r\n\r\n\t/************************************************************************/\r\n\t/* DATA MEMBERS                                                         */\r\n\t/************************************************************************/\r\nprotected:\r\n\tsize_t m_nDataSize;\t\t\t\t\t///< Size of the memory pool\r\n\tByte *m_pData;\t\t\t\t\t\t///< Memory pool for this MDF\r\n\r\n\r\n\tTMdfMesh *m_vpMeshes;\t\t\t\t///< All the meshes in the file\r\n\tunsigned int m_nMeshArrayLength;\t///< Length of the meshes array\r\n\r\n"]
[895.517918, "o", "\tTMdfAnimation *m_vpAnimations;\t\t///< All the animations in the file\r\n\tunsigned int m_nAnimArrayLength;\t///< Size of the animations array\r\n\r\n\tchar **m_vpTextures;\t\t\t\t///< Array of texture strings\r\n\r\n\tmutable MdfHeader m_tMdfHeader;\t\t\t\t///< Master MDF header\r\n\r\n\r\n\t/************************************************************************/\r\n\t/* CONSTRUCTION                                                         */\r\n\t/************************************************************************/\r\npublic:\r\n\tMdfFormat(void);\r\npublic:\r\n\tvirtual ~MdfFormat(void);\r\n\r\n"]
[895.518182, "o", "\t/************************************************************************/\r\n\t/* CLASS METHODS                                                        */\r\n\t/************************************************************************/\r\npublic:\r\n\t//////////////////////////////////////////////////////////////////////////\r\n\t/// Create a new MDF file\r\n\t///\r\n\t/// \\param nNumMeshesHint - number of meshes this file might store\r\n\t/// \\return true if successful\r\n\t///\r\n\t/// \\remarks To recreate a new MDF on the same object, Destroy() must\r\n\t///\t\t\t be called first\r\n\t//////////////////////////////////////////////////////////////////////////\r\n\tbool Create(unsigned int nNumMeshesHint=0);\r\n\r\n\t//////////////////////////////////////////////////////////////////////////\r\n\t/// Create a new MDF by loading its data from a file\r\n\t///\r\n\t/// \\param szFilename - the path of the file to load\r\n\t/// \\return true if successful\r\n\t//////////////////////////////////////////////////////////////////////////\r\n\tbool CreateFromFile(const char *szFilename);\r\n\r\n\t//////////////////////////////////////////////////////////////////////////\r\n\t/// Create a new MDF from raw MDF data in memory\r\n\t///\r\n\t/// \\param pData - location of the raw MDF data to load\r\n\t/// \\param nDataSize - size of the data buffer in bytes\r\n\t/// \\return true if successful\r\n\t//////////////////////////////////////////////////////////////////////////\r\n\tbool CreateFromFileInMemory(Byte *pData, size_t nDataSize);\r\n"]
[895.520776, "o", "\u001b[35m\u001b[KMdfFormat.cpp\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K134\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[KMdfFormat::\u001b[01;31m\u001b[KMdfFormat(\u001b[m\u001b[Kvoid)\r\n\u001b[35m\u001b[KMdfFormat.cpp\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K146\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[KMdfFormat::~\u001b[01;31m\u001b[KMdfFormat(\u001b[m\u001b[Kvoid)\r\n\u001b[35m\u001b[KMdfFormat.cpp\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K506\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kbool \u001b[01;31m\u001b[KMdfFormat::Load\u001b[m\u001b[KFromStream(MdfStream &stream)\r\n"]
[895.52094, "o", "\u001b[35m\u001b[KMdfFormat.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K46\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KMdfFormat(\u001b[m\u001b[Kvoid);\r\n\u001b[35m\u001b[KMdfFormat.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K48\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tvirtual ~\u001b[01;31m\u001b[KMdfFormat(\u001b[m\u001b[Kvoid);\r\n\u001b[35m\u001b[KMdfFormat.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K231\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KMdfFormat(\u001b[m\u001b[KMdfFormat &) {};\r\n"]
