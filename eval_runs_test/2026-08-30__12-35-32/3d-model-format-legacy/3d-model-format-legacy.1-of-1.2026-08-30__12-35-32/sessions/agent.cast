imations() const { return m_t\u001b[01;31m\u001b[KMdfHeader\u001b[m\u001b[K.nAnimCount; }\r\n\u001b[35m\u001b[K./MdfFormat.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K172\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tunsigned int GetNumTextures() const { return m_t\u001b[01;31m\u001b[KMdfHeader\u001b[m\u001b[K.nTextureCount; }\r\n\u001b[35m\u001b[K./MdfFormat.h\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K193\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tconst \u001b[01;31m\u001b[KMdfHeader\u001b[m\u001b[K & GetHeader() const { return m_t\u001b[01;31m\u001b[KMdfHeader\u001b[m\u001b[K; }\r\n"]
