[965.173691, "o", "    14\t\t'2'\r\n    15\t};\r\n    16\t\r\n    17\tclass MdfMemStream\r\n    18\t\t: public MdfStream\r\n    19\t{\r\n    20\tpublic:\r\n    21\t\tMdfMemStream(Byte *pData, int nDataLen) : pData(pData), nDataLen(nDataLen), nPos(0) {}\r\n    22\t\tvirtual ~MdfMemStream() {}\r\n    23\t\r\n    24\t\tvirtual bool Seek(int offset, int origin);\r\n    25\t\tvirtual int Tell();\r\n    26\t\tvirtual int Read(void *pDest, int nLength);\r\n    27\t\tvirtual int Length();\r\n    28\t\r\n    29\tprivate:\r\n    30\t\tByte *pData;\r\n    31\t\tint nDataLen;\r\n"]
[965.173866, "o", "    32\t\tint nPos;\r\n    33\t\r\n    34\t};\r\n    35\t\r\n    36\tbool MdfMemStream::Seek(int offset, int origin)\r\n    37\t{\r\n    38\t\tswitch(origin) {\r\n    39\t\t\tcase SEEK_SET:\r\n    40\t\t\t{\r\n    41\t\t\t\tif(offset < 0 || offset > nDataLen) {\r\n    42\t\t\t\t\treturn false;\r\n    43\t\t\t\t}\r\n    44\t\t\t\tnPos = offset;\r\n    45\t\t\t} break;\r\n    46\t\t\tcase SEEK_CUR:\r\n    47\t\t\t{\r\n    48\t\t\t\tregister int test = nPos += offset;\r\n    49\t\t\t\tif(test < 0 || test > nDataLen) {\r\n    50\t\t\t\t\treturn false;\r\n    51\t\t\t\t}\r\n    52\t\t\t\tnPos += offset;\r\n    53\t\t\t} break;\r\n    54\t\t\tcase SEEK_END:\r\n    55\t\t\t{\r\n    56\t\t\t\tregister int test = nPos += offset;\r\n    57\t\t\t\tif(test < 0 || test > nDataLen) {\r\n    58\t\t\t\t\treturn false;\r\n    59\t\t\t\t}\r\n    60\t\t\t\tnPos = nDataLen - origin;\r\n    61\t\t\t} break;\r\n    62\t\t}\r\n    63\t\treturn true;\r\n    64\t}\r\n    65\t\r\n    66\tint MdfMemStream::Tell()\r\n    67\t{\r\n    68\t\treturn nPos;\r\n    69\t}\r\n    70\t\r\n    71\tint MdfMemStream::Read(void *pDest, int nLength)\r\n    72\t{\r\n    73\t\tif(nPos + nLength >= nDataLen) {\r\n    74\t\t\tnLength = nDataLen - nPos;\r\n    75\t\t}\r\n    76\t\tmemcpy(pDest, &pData[nPos], nLength);\r\n    77\t\tnPos += nLength;\r\n    78\t\treturn nLength;\r\n    79\t}\r\n    80\t\r\n    81\tint MdfMemStream::Length()\r\n    82\t{\r\n    83\t\treturn nDataLen;\r\n    84\t}\r\n"]
[965.173962, "o", "    85\t\r\n    86\t//////////////////////////////////////////////////////////////////////////\r\n    87\t\r\n    88\tclass MdfFileStream\r\n    89\t\t: public MdfStream\r\n    90\t{\r\n    91\tpublic:\r\n    92\t\tMdfFileStream() : fp(0), nDataLen(0) {}\r\n    93\t\tvirtual ~MdfFileStream() { Close(); }\r\n    94\t\r\n    95\t\tbool Open(const char *szFilename) {\r\n    96\t\t\tfp = fopen(szFilename, \"rb\");\r\n    97\t\t\tif(fp) {\r\n    98\t\t\t\tfseek(fp, 0, SEEK_END);\r\n    99\t\t\t\tnDataLen = (int)ftell(fp);\r\n   100\t\t\t\tfseek(fp, 0, SEEK_SET);\r\n   101\t\t\t\treturn true;\r\n   102\t\t\t} else {\r\n   103\t\t"]
[965.174149, "o", "\t\treturn false;\r\n   104\t\t\t}\r\n   105\t\t}\r\n   106\t\r\n   107\t\tvoid Close() {\r\n   108\t\t\tif(fp) {\r\n   109\t\t\t\tfclose(fp);\r\n   110\t\t\t}\r\n   111\t\t\tfp = 0;\r\n   112\t\t\tnDataLen = 0;\r\n   113\t\t}\r\n   114\t\r\n   115\t\tvirtual bool Seek(int offset, int origin) {\r\n   116\t\t\treturn(fseek(fp, offset, origin) == 0);\r\n   117\t\t}\r\n   118\t\r\n   119\t\tvirtual int Tell() { return (int)ftell(fp); }\r\n   120\t\r\n   121\t\tvirtual int Read(void *pDest, int nLength) {\r\n   122\t\t\treturn (int)fread(pDest, 1, nLength, fp);\r\n   123\t\t}\r\n   124\t\r\n   125\t\tvirtual int Length() { return nDataLen; }\r\n   126\t\r\n   127\tprivate:\r\n   128\t\tFILE *fp;\r\n   129\t\tint nDataLen;\r\n   130\t};\r\n   131\t\r\n   132\t//////////////////////////////////////////////////////////////////////////\r\n   133\t\r\n   134\tMdfFormat::MdfFormat(void)\r\n   135\t: m_nDataSize(0),\r\n   136\t  m_pData(0),\r\n   137\t  m_vpMeshes(0),\r\n   138\t  m_nMeshArrayLength(0),\r\n   139\t  m_vpAnimations(0),\r\n"]
[965.174315, "o", "   140\t  m_nAnimArrayLength(0),\r\n   141\t  m_vpTextures(0)\r\n   142\t{\r\n   143\t\tZeroMemory(&m_tMdfHeader, sizeof(m_tMdfHeader));\r\n   144\t}\r\n   145\t\r\n   146\tMdfFormat::~MdfFormat(void)\r\n   147\t{\r\n   148\t\tDestroy();\r\n   149\t}\r\n   150\t\r\n   151\tbool MdfFormat::Create(unsigned int nNumMeshesHint/* =0 */)\r\n   152\t{\r\n   153\t\tif(m_vpMeshes != 0) {\r\n   154\t\t\treturn false;\r\n   155\t\t}\r\n   156\t\r\n   157\t\tZeroMemory(&m_tMdfHeader, sizeof(m_tMdfHeader));\r\n   158\t\r\n   159\t\tmemcpy(m_tMdfHeader.cId, MDF_VER_STR, sizeof(MDF_VER_STR));\r\n   160\t\r\n   161\t\tm_tMdfHeader.nByteAlignment = MDF_BYTE_ALIGNMENT;\r\n   162\t\r\n   163\t\tif(nNumMeshesHint) {\r\n   164\t\t\tm_vpMeshes = (TMdfMesh*)malloc(nNumMeshesHint * sizeof(TMdfMesh));\r\n   165\t\t\tZeroMemory(m_vpMeshes, nNumMeshesHint * sizeof(TMdfMesh));\r\n   166\t\t\tm_nMeshArrayLength = nNumMeshesHint;\r\n   167\t\r\n   168\t\t\tm_vpAnimations = (TMdfAnimation*)malloc(nNumMeshesHint * sizeof(TMdfAnimation));\r\n   169\t\t\tm_nAnimArrayLength = nNumMeshesHint;\r\n   170\t\t}\r\n   171\t\r\n   172\t\treturn true;\r\n   173\t}\r\n   174\t\r\n"]
[965.174471, "o", "   175\t\r\n   176\tMdfHandle MdfFormat::AddMesh(const MdfFullMesh &newMesh)\r\n   177\t{\r\n   178\t\tTMdfMesh *pMesh = 0;\r\n   179\t\tunsigned int nMesh = 0;\r\n   180\t\r\n   181\t\t// reallocate mesh pointer array if needed\r\n   182\t\tif((m_tMdfHeader.nMeshCount + 1) > m_nMeshArrayLength) {\r\n   183\t\r\n   184\t\t\tm_vpMeshes = (TMdfMesh*)realloc(m_vpMeshes, (m_tMdfHeader.nMeshCount+1)*sizeof(TMdfMesh));\r\n   185\t\t\tm_nMeshArrayLength++;\r\n   186\t\t}\r\n   187\t\r\n   188\t\t// allocate new mesh, set up variables\r\n   189\t\tnMesh = m_tMdfHeader.nMeshCount;\r\n   190\t\tpMesh = &m_vpMeshes[nMesh];\r\n   191\t\tm_tMdfHeader.nMeshCount++;\r\n   192\t\tZeroMemory(pMesh, sizeof(TMdfMesh));\r\n   193\t\r\n   194\t\tif(newMesh.numBindPoseElements > 0 && newMesh.parentInfo) {\r\n   195\t\t\tpMesh->meshType = TMdfMesh::MESH_SKINNED;\r\n   196\t\t} else {\r\n   197\t\t\tpMesh->meshType = TMdfMesh::MESH_STATIC;\r\n   198\t\t}\r\n   199\t\r\n   200\t\tsize_t numVerts = newMesh.finalVerts.size();\r\n   201\t\tsize_t numInds = newMesh.finalIndices.size();\r\n   202\t\r\n   203\t\t// set up the mesh structure\r\n   204\t\tpMesh->nNumVerts = (unsigned int)newMesh.finalVerts.size();\r\n   205\t\tpMesh->nNumIndices = (unsigned int)newMesh.finalIndices.size();\r\n   206\t\r\n   207\t\t// allocate vertices and indices\r\n   208\t\r\n   209\t\tif(pMesh->meshType == TMdfMesh::MESH_SKINNED) {\r\n   210\t\t\tpMesh->uVtxs.pVertices = malloc(sizeof(TMdfVertSkn) * pMesh->nNumVerts);\r\n   211\t\t} else {\r\n   212\t\t\tpMesh->uVtxs.pVertices = malloc(sizeof(TMdfVertSta) * pMesh->nNumVerts);\r\n   213\t\t}\r\n   214\t\r\n   215\t\r\n   216\t\tpMesh->uIdxs.pIndices = (unsigned short*)malloc(sizeof(unsigned short) * pMesh->nNumIndices);\r\n   217\t\r\n   218\t\t//\r\n   219\t\t// copy vertex data\r\n   220\t\t//\r\n   221\t\tFullVertList::const_iterator li = newMesh.finalVerts.begin();\r\n   222\t\tint i = 0;\r\n   223\t\tif(pMesh->meshType == TMdfMesh::MESH_SKINNED) {\r\n   224\t\t\tTMdfVertSkn *v;\r\n   225\t\t\twhile (li != newMesh.finalVerts.end()) {\r\n   226\t\t\t\t v = &((TMdfVertSkn*)pMesh->uVtxs.pVertices)[i];\r\n   227\t\r\n   228\t\t\t\tv->pos.x = li->pos[0];\r\n   229\t\t\t\tv->pos.y = li->pos[1];\r\n   230\t\t\t\tv->pos.z = li->pos[2];\r\n   231\t\r\n   232\t\t\t\tv->weights[0] = li->weights[0];\r\n   233\t\t\t\tv->weights[1] = li->weights[1];\r\n   234\t\t\t\tv->weights[2] = li->weights[2];\r\n   235\t\r\n   236\t"]
[965.174619, "o", "\t\t\tv->bones[0] = li->bones[0];\r\n   237\t\t\t\tv->bones[1] = li->bones[1];\r\n   238\t\t\t\tv->bones[2] = li->bones[2];\r\n   239\t\t\t\tv->bones[3] = li->bones[3];\r\n   240\t\r\n   241\t\t\t\tv->normal.x = li->normal[0];\r\n   242\t\t\t\tv->normal.y = li->normal[1];\r\n   243\t\t\t\tv->normal.z = li->normal[2];\r\n   244\t\r\n   245\t\t\t\tv->texcoord.u = li->u;\r\n   246\t\t\t\tv->texcoord.v = li->v;\r\n   247\t\r\n   248\t\t\t\ti++;\r\n   249\t\t\t\tli++;\r\n   250\t\t\t}\r\n   251\t\t} else {\r\n   252\t\t\tTMdfVertSta *v;\r\n   253\t\t\twhile (li != newMesh.finalVerts.end()) {\r\n   254\t\t\t\tv = &((TMdfVertSta*)pMesh->uVtxs.pVertices)[i];\r\n   255\t\r\n   256\t\t\t\tv->pos.x = li->pos[0];\r\n   257\t\t\t\tv->pos.y = li->pos[1];\r\n   258\t\t\t\tv->pos.z = li->pos[2];\r\n   259\t\t\t\tv->normal.x = li->normal[0];\r\n"]
