[747.293912, "o", "1:#pragma once\r\n2:#include \"types.h\"\r\n3:#include <math.h>\r\n4:#include <vector>\r\n5:#include <string>\r\n6:\r\n7:#define MFDVERT_EPSILON 0.0001f\r\n8:\r\n9:\r\n10:typedef int MdfHandle;\r\n11:\r\n12://////////////////////////////////////////////////////////////////////////\r\n13:/// \\brief MDF File Header\r\n14:/// \\author Ivgeni Segal\r\n15:/// \\date January 20, 2007\r\n16:///\r\n17:/// MDF File header is the structure stored at the beginning\r\n18:/// of the file and identifies its version and contents\r\n19:///\r\n20://////////////////////////////////////////////////////////////////////////\r\n21:struct MdfHeader \r\n22:{ \r\n23:\tchar cId[8]; // 'MDF v1.0'\r\n24:\r\n25:\tunsigned int nMeshCount;\t\t///< Number of meshes in this file\r\n26:\tunsigned int nAnimCount;\t\t///< Number of animations in this file\r\n"]
[747.294182, "o", "27:\tunsigned int nTextureCount;\t\t///< Total number of texture names\r\n28:\tunsigned int nByteAlignment;\t///< Current byte alignment of the file\r\n29:\tunsigned int nNumHierarchies;\t///< Unused\r\n30:\r\n31:\tunsigned int nTotalDataSize;\t///< Total size of the data excluding\r\n32:\t\t\t\t\t\t\t\t\t///< the header\r\n33:};\r\n34:\r\n35://////////////////////////////////////////////////////////////////////////\r\n36:\r\n37://\r\n38:\r\n39://\r\n40:\r\n41://////////////////////////////////////////////////////////////////////////\r\n"]
[747.294348, "o", "42:/// \\brief Transitional vertex format\r\n43:/// \\author Ivgeni Segal\r\n44:/// \\date January 20, 2007\r\n45:///\r\n46:/// transitional vertex format for use with exporters.\r\n47:/// This structure is used by the mesh-building functions of the MDF \r\n48:/// format object. do not use for loading.\r\n49:///\r\n50:///\r\n51://////////////////////////////////////////////////////////////////////////\r\n52:struct MdfFullVertex {\r\n53:\tfloat pos[3];\r\n54:\r\n55:\tfloat weights[3];\r\n56:\tunsigned char bones[4];\r\n57:\r\n58:\tfloat normal[3];\r\n59:\t"]
[747.294492, "o", "float u, v;\r\n60:\r\n61:\tbool operator==(const MdfFullVertex &b) const {\r\n62:\t\tif(bones[0] != b.bones[0]){\r\n63:\t\t\treturn false;\r\n64:\t\t}\r\n65:\t\tif(bones[1] != b.bones[1]){\r\n66:\t\t\treturn false;\r\n67:\t\t}\r\n68:\t\tif(bones[2] != b.bones[2]){\r\n69:\t\t\treturn false;\r\n70:\t\t}\r\n71:\t\tif(bones[3] != b.bones[3]){\r\n72:\t"]
[747.294646, "o", "\t\treturn false;\r\n73:\t\t}\r\n74:\t\tif(fabs(pos[0] - b.pos[0]) > MFDVERT_EPSILON) {\r\n75:\t\t\treturn false;\r\n76:\t\t}\r\n77:\t\tif(fabs(pos[1] - b.pos[1]) > MFDVERT_EPSILON) {\r\n78:\t\t\treturn false;\r\n79:\t\t}\r\n80:\t\tif(fabs(pos[2] - b.pos[2]) > MFDVERT_EPSILON) {\r\n81:\t\t\treturn false;\r\n82:\t\t}\r\n"]
[747.294816, "o", "83:\t\tif(fabs(weights[0] - b.weights[0]) > MFDVERT_EPSILON) {\r\n84:\t\t\treturn false;\r\n85:\t\t}\r\n86:\t\tif(fabs(weights[1] - b.weights[1]) > MFDVERT_EPSILON) {\r\n87:\t\t\treturn false;\r\n88:"]
[747.294905, "o", "\t\t}\r\n89:\t\tif(fabs(weights[2] - b.weights[2]) > MFDVERT_EPSILON) {\r\n90:\t\t\treturn false;\r\n91:\t\t}\r\n92:\t\tif(fabs(normal[0] - b.normal[0]) > MFDVERT_EPSILON) {\r\n93:\t\t\treturn false;\r\n94:\t\t}\r\n95:\t\tif(fabs(normal[1] - b.normal[1]) > MFDVERT_EPSILON) {\r\n96:\t\t\treturn false;\r\n97:\t\t}\r\n98:\t\tif(fabs(normal[2] - b.normal[2]) > MFDVERT_EPSILON) {\r\n99:\t\t\treturn false;\r\n100:\t\t}\r\n101:\t\tif(fabs(u - b.u) > MFDVERT_EPSILON) {\r\n102:\t\t\treturn false;\r\n"]
[747.295005, "o", "103:\t\t}\r\n104:\t\tif(fabs(v - b.v) > MFDVERT_EPSILON) {\r\n105:\t\t\treturn false;\r\n106:\t\t}\r\n107:\r\n108:\t\treturn true;\r\n109:\t}\r\n110:\r\n111:};\r\n112:\r\n113://////////////////////////////////////////////////////////////////////////\r\n114:/// \\brief Generic 4x4 matrix\r\n115:/// \\author Ivgeni Segal\r\n116:/// \\date January 20, 2007\r\n117:///\r\n118:/// Generic matrix used in the MDF format\r\n"]
[747.29519, "o", "119:///\r\n120:/// \\remarks MDF uses row-major matrices, if you need to use MDF in a\r\n121:///\t\t\t column-major environment such as OpenGL don't forget to\r\n122:///\t\t\t"]
[747.295328, "o", " transpose them.\r\n123:///\r\n124://////////////////////////////////////////////////////////////////////////\r\n125:struct TMdfMatrix4\r\n126:{\r\n127:\tfloat\te[16];\r\n128:};\r\n129:\r\n130://////////////////////////////////////////////////////////////////////////\r\n131:/// \\brief Skinned vertex for animation\r\n132:/// \\author Ivgeni Segal\r\n133:/// \\date January 20, 2007\r\n134:///\r\n135:/// \\remarks Skinned vertex is present in animated meshes and supports\r\n136:///\tup to four bones per vertex\r\n137:///\r\n138://////////////////////////////////////////////////////////////////////////\r\n139:struct TMdfVertSkn\r\n140:{\r\n141:\tFloat3 pos;\r\n142:\tfloat weights[3];\r\n143:\tunsigned char bones[4];\r\n144:\r\n145:\tFloat3 normal;\r\n146:\tFloat2 texcoord;\r\n147:};\r\n148:\r\n149://////////////////////////////////////////////////////////////////////////\r\n150:/// \\brief Vertex for static meshes\r\n"]
[747.2955, "o", "151:/// \\author Ivgeni Segal\r\n152:/// \\date January 20, 2007\r\n153:///\r\n154:/// \\remarks All static geometry in MDF uses this vertex format,\r\n155:///\t\t\t he UV coordinates are in DirectX form\r\n156:///\r\n157://////////////////////////////////////////////////////////////////////////\r\n158:struct TMdfVertSta\r\n159:{\r\n160:\tFloat3 pos;\t\t\t///< Vertex position in model space\r\n161:\r\n162:\tFloat3 normal;\t\t///< Vertex normal\r\n163:\tFloat2 texcoord;\t///< UV Texture coordinate\r\n164:\r\n165:\tTMdfVertSta & operator=(const TMdfVertSkn &rhs) {\r\n166:\t\tpos.x = rhs.pos.x;\r\n167:\t\tpos.y = rhs.pos.y;\r\n168:\t\tpos.z = rhs.pos.z;\r\n169:\r\n170:\t\tnormal.x = rhs.normal.x;\r\n"]
