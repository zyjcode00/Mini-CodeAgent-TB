[955.268972, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\ncd /app/MdfLib && nl -ba mdftypes.h | sed -n '1,120p' && nl -ba mdftypes.h | sed -n '120,220p' && nl -ba mdftypes.h | sed -n '220,320p'\ntrue; tmux wait -S done\r"]
[955.269699, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
