[166.252614, "o", "\r\n    66\t\t\t\treturn false;\r\n    67\t\t\t}\r\n    68\t\t\tif(bones[2] != b.bones[2]){\r\n    69\t\t\t\treturn false;\r\n    70\t\t\t}\r\n    71\t\t\tif(bones[3] != b.bones[3]){\r\n    72\t\t\t\treturn false;\r\n    73\t\t\t}\r\n    74\t\t\tif(fabs(pos[0] - b.pos[0]) > MFDVERT_EPSILON) {\r\n    75\t\t\t\treturn false;\r\n    76\t\t\t}\r\n    77\t\t\tif(fabs(pos[1] - b.pos[1]) > MFDVERT_EPSILON) {\r\n    78\t\t\t\treturn false;\r\n    79\t\t\t}\r\n    80\t\t\tif(fabs(pos[2] - b.pos[2]) > MFDVERT_EPSILON) {\r\n    81\t\t\t\treturn false;\r\n    82\t\t\t}\r\n    83\t\t\tif(fabs(weights[0] - b.weights[0]) > MFDVERT_EPSILON) {\r\n    84\t\t\t\treturn false;\r\n    85\t\t\t}\r\n    86\t\t\tif(fabs(weights[1] - b.weights[1]) > MFDVERT_EPSILON) {\r\n    87\t\t\t\treturn false;\r\n    88\t\t\t}\r\n    89\t\t\tif(fabs(weights[2] - b.weights[2]) > MFDVERT_EPSILON) {\r\n    90\t\t\t\treturn false;\r\n"]
