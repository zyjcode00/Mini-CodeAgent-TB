[747.798886, "o", "500:\tfree(pHeaderAnims);\r\n501:\tfree(pHeaderTextures);\r\n502:\r\n503:\treturn true;\r\n504:}\r\n505:\r\n506:bool MdfFormat::LoadFromStream(MdfStream &stream)\r\n507:{\r\n508:\tif(m_vpMeshes || m_pData) {\r\n509:\t\treturn false;\r\n510:\t}\r\n511:\tint nHeaderLength = sizeof(m_tMdfHeader);\r\n512:\r\n513:\tstream.Read(&m_tMdfHeader, nHeaderLength);\r\n514:\r\n515:"]
[747.799134, "o", "\t// read the entire file\r\n516:\tm_nDataSize = stream.Length() - nHeaderLength;\r\n517:\tm_pData = (Byte*)malloc(m_nDataSize);\r\n518:\tstream.Read(m_pData, (int)m_nDataSize);\r\n519:\r\n520:\tint dataPos = 0;\r\n521:\r\n522:\t// check for textures and set their pointer\r\n523:\tif(m_tMdfHeader.nTextureCount > 0) {\r\n524:\t\tm_vpTextures = (char**)&m_pData[dataPos];\r\n525:\t\tdataPos += m_tMdfHeader.nTextureCount * sizeof(int);\r\n526:\t}\r\n527:\r\n528:\t// check for meshes and set their pointer\r\n529:\tif(m_tMdfHeader.nMeshCount > 0) {\r\n530:\t\tm_vpMeshes = (TMdfMesh*)&m_pData[dataPos];\r\n531:\t\tdataPos += m_tMdfHeader.nMeshCount * sizeof(TMdfMesh);\r\n532:\t}\r\n533:\r\n534:\t// check for animations and set their pointer\r\n535:\tif(m_tMdfHeader.nAnimCount > 0) {\r\n536:\t\tm_vpAnimations = (TMdfAnimation*)&m_pData[dataPos];\r\n537:\t}\r\n538:\r\n539:\t//\r\n540:\t// for each texture, fix up the pointers\r\n541:\t//\r\n542:\tfor(size_t i = 0; i < m_tMdfHeader.nTextureCount; i++) {\r\n543:\t\tm_vpTextures[i] = (char*)(m_pData  + ((int)m_vpTextures[i]) - nHeaderLength);\r\n544:\t}\r\n545:\r\n546:\t//\r\n547:\t// for each mesh fix up the pointers\r\n548:\t//\r\n549:\tfor(size_t i = 0; i < m_tMdfHeader.nMeshCount; i++) {\r\n550:\t\tm_vpMeshes[i].uVtxs.pVertices = m_pData + m_vpMeshes[i].uVtxs.nDataOffset - nHeaderLength;\r\n551:\t\tm_vpMeshes[i].uIdxs.pIndices = (unsigned short*)(m_pData + m_vpMeshes[i].uIdxs.nDataOffset - nHeaderLength);\r\n552:\r\n553:\t\tif(m_vpMeshes[i].nNumJoints > 0) {\r\n554:\t\t\tm_vpMeshes[i].uBnd.pBindMats = (TMdfMatrix4*)(m_pData + m_vpMeshes[i].uBnd.nDataOffset - nHeaderLength);\r\n555:\t\t\tm_vpMeshes[i].uPrnt.pParentInfo = (int*)(m_pData + m_vpMeshes[i].uPrnt.nDataOffset - nHeaderLength);\r\n556:\t\t} else {\r\n557:\t\t\tm_vpMeshes[i].uBnd.pBindMats = 0;\r\n"]
[747.79927, "o", "558:\t\t\tm_vpMeshes[i].uPrnt.pParentInfo = 0;\r\n559:\t\t}\r\n560:\t\tdataPos += sizeof(TMdfMesh);\r\n561:\t}\r\n562:\r\n563:\t//\r\n564:\t// for each animation, fix up the pointers\r\n565:\t//\r\n566:\tfor(size_t i = 0; i < m_tMdfHeader.nAnimCount; i++) {\r\n567:\t\tm_vpAnimations[i].uTls.pTimeline = (TMdfTimeline*)(m_pData + m_vpAnimations[i].uTls.nDataOffset - nHeaderLength);\r\n568:\r\n569:\t\t// fix up the time-line pointers\r\n570:\t\tfor(int t = 0; t < m_vpAnimations[i].nNumTimelines; t++) {\r\n571:\t\t\tm_vpAnimations[i].uTls.pTimeline[t].uKfs.pKeyframes = (TMdfKeyframe*)(m_pData + m_vpAnimations[i].uTls.pTimeline[t].uKfs.nDataOffset - nHeaderLength);\r\n572:\t\t}\r\n573:\t}\r\n574:\r\n575:\treturn true;\r\n576:}\r\n577:\r\n578:void MdfFormat::Destroy()\r\n579:{\r\n580:\t// clean up any additional memory and\r\n"]
