[337.884166, "o", "cd /app/MdfLib && grep -n \"LoadFromStream\\|LoadFromFile\\|SaveToFile\\|Destroy\\|MdfMemStream::Seek\\|MdfFileStream\" MdfFormat.cpp\r\n\u001b[?2004l\r"]
[337.88563, "o", "\u001b[32m\u001b[K35\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kbool \u001b[01;31m\u001b[KMdfMemStream::Seek\u001b[m\u001b[K(int offset, int origin)\r\n\u001b[32m\u001b[K87\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kclass \u001b[01;31m\u001b[KMdfFileStream\u001b[m\u001b[K \r\n\u001b[32m\u001b[K91\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KMdfFileStream\u001b[m\u001b[K() : fp(0), nDataLen(0) {}\r\n\u001b[32m\u001b[K92\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tvirtual ~\u001b[01;31m\u001b[KMdfFileStream\u001b[m\u001b[K() { Close(); }\r\n"]
[337.88583, "o", "\u001b[32m\u001b[K147\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KDestroy\u001b[m\u001b[K();\r\n\u001b[32m\u001b[K357\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t\u001b[01;31m\u001b[KMdfFileStream\u001b[m\u001b[K stream;\r\n\u001b[32m\u001b[K362\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tbool bResult = \u001b[01;31m\u001b[KLoadFromStream\u001b[m\u001b[K(stream);\r\n\u001b[32m\u001b[K372\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\treturn \u001b[01;31m\u001b[KLoadFromStream\u001b[m\u001b[K(stream);\r\n"]
[337.886003, "o", "\u001b[32m\u001b[K375\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kbool MdfFormat::\u001b[01;31m\u001b[KSaveToFile\u001b[m\u001b[K(const char *szFilename) const\r\n\u001b[32m\u001b[K505\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kbool MdfFormat::\u001b[01;31m\u001b[KLoadFromStream\u001b[m\u001b[K(MdfStream &stream)\r\n\u001b[32m\u001b[K577\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kvoid MdfFormat::\u001b[01;31m\u001b[KDestroy\u001b[m\u001b[K()\r\n"]
