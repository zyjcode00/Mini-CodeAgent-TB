[860.676131, "o", "\u001b[32m\u001b[K92\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t/// \u001b[01;31m\u001b[KSave\u001b[m\u001b[K MDF data to a file\r\n\u001b[32m\u001b[K97\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tbool \u001b[01;31m\u001b[KSave\u001b[m\u001b[KToFile(const char *szFilename) const;\r\n"]
[860.676314, "o", "\u001b[32m\u001b[K126\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tunsigned int \u001b[01;31m\u001b[KGetNumMeshes() const { return m_tMdfHeader.nMesh\u001b[m\u001b[KCount; }\r\n\u001b[32m\u001b[K134\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t/// \\warning Invalid indexes are not checked, use \u001b[01;31m\u001b[KGetNumMesh\u001b[m\u001b[Kes() to find\r\n\u001b[32m\u001b[K137\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t"]
[860.6765, "o", "const TMdfMesh & \u001b[01;31m\u001b[KGetMesh(MdfHandle hMeshId) const { return m_vpMeshes[hMesh\u001b[m\u001b[KId]; }\r\n\u001b[32m\u001b[K144\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tunsigned int \u001b[01;31m\u001b[KGetNumAnimations() const { return m_tMdfHeader.nAnim\u001b[m\u001b[KCount; }\r\n\u001b[32m\u001b[K152\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t/// \\warning Invalid indexes are not checked, use \u001b[01;31m\u001b[KGetNumAnim\u001b[m\u001b[Kations() to find\r\n\u001b[32m\u001b[K155\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tconst TMdfAnimation & \u001b[01;31m\u001b[KGetAnimation(MdfHandle hAnimId) const { return m_vpAnimations[hAnim\u001b[m\u001b[KId]; }\r\n\u001b[32m\u001b[K163\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tMdfHandle \u001b[01;31m\u001b[KGetTextureId(MdfHandle hMesh\u001b[m\u001b[KId) const {\r\n\u001b[32m\u001b[K172\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tunsigned int \u001b[01;31m\u001b[KGetNumTextures() const { return m_tMdfHeader.nTexture\u001b[m\u001b[KCount; }\r\n\u001b[32m\u001b[K186\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tconst char * \u001b[01;31m\u001b[KGetTextureName(MdfHandle hTextureId) const { return m_vpTextures[hTexture\u001b[m\u001b[KId]; }\r\n\u001b[32m\u001b[K209\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\t/// \u001b[01;31m\u001b[KLoad\u001b[m\u001b[Ks an MDF from a given stream\r\n\u001b[32m\u001b[K214\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\tbool \u001b[01;31m\u001b[KLoad\u001b[m\u001b[KFromStream(MdfStream &stream);\r\n"]
