[368.974471, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/MdfLib/stdafx.h <<'PY'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = '// Cross-platform replacement for the original Visual Studio precompiled header.\\n#pragma once\\n\\n#ifdef _WIN32\\n#define WIN32_LEAN_AND_MEAN\\n#include <windows.h>\\n#else\\n#include <cstring>\\n#include <cstdlib>\\n#include <cstdio>\\n#include <cstdint>\\n#ifndef ZeroMemory\\n#define ZeroMemory(Destination, Length) std::memset((Destination), 0, (Length))\\n#endif\\n#endif\\n'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, 'w', encoding='utf-8', newline='\\n') as f:\n        f.write(content)\n    print(f\"成功: 已写入 {path}\")\nexcept Exception as exc:\n    print(f\"写入失败: {exc}\")\nPY\ntrue; tmux wait -S done\r"]
