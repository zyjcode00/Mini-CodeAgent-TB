[965.327086, "o", "\t\t}\r\n   383\t\r\n   384\t\tfp = fopen(szFilename, \"wb\");\r\n   385\t\tif(!fp) {\r\n   386\t\t\treturn false;\r\n   387\t\t}\r\n   388\t\r\n   389\t\r\n   390\t\r\n   391\t\tTMdfMesh *pHeaderMeshes = (TMdfMesh*)malloc(sizeof(TMdfMesh) * m_tMdfHeader.nMeshCount);\r\n   392\t\tTMdfAnimation *pHeaderAnims = (TMdfAnimation*)malloc(sizeof(TMdfAnimation) * m_tMdfHeader.nAnimCount);\r\n   393\t\r\n   394\t\t//\r\n   395\t\t// skip the header info for now, we'll write it later\r\n   396\t\t//\r\n   397\t\tint skipOffset = sizeof(MdfHeader);\r\n"]
[965.327199, "o", "   398\t\tskipOffset += sizeof(TMdfMesh) * m_tMdfHeader.nMeshCount; // skip main mesh header\r\n   399\t\tskipOffset += sizeof(TMdfAnimation) * m_tMdfHeader.nAnimCount; // skip the animation headers\r\n   400\t\tskipOffset += sizeof(char *) * m_tMdfHeader.nTextureCount;  // skip the texture headers\r\n   401\t\tfseek(fp, skipOffset, SEEK_CUR);\r\n   402\t\r\n   403\t\tint *pHeaderTextures = (int*)malloc(m_tMdfHeader.nTextureCount * sizeof(int));\r\n   404\t\t//\r\n   405\t\t// for each texture, save the name\r\n   406\t\t//\r\n   407\t\tfor(unsigned int i = 0; i < m_tMdfHeader.nTextureCount; i++) {\r\n   408\t\t\tsize_t texLen = strlen(m_vpTextures[i]);\r\n   409\t\t\tpHeaderTextures[i] = (int)ftell(fp);\r\n   410\t\t\tfwrite(m_vpTextures[i], texLen+1, 1, fp);\r\n   411\t\t}\r\n"]
[965.327567, "o", "   412\t\r\n   413\t\t//\r\n   414\t\t// for each mesh, save the data\r\n   415\t\t//\r\n   416\t\tfor(unsigned int i = 0; i < m_tMdfHeader.nMeshCount; i++) {\r\n   417\t\t\tconst TMdfMesh *pMesh = &m_vpMeshes[i];\r\n   418\t\t\tpHeaderMeshes[i] = *pMesh;\r\n   419\t\r\n   420\t\r\n   421\t\t\t// write out the vertices based on their type\r\n   422\t\t\t// write the verts\r\n   423\t\t\tByteAlignFile(fp);\r\n   424\t\t\tpHeaderMeshes[i].uVtxs.nDataOffset = ftell(fp);\r\n   425\t\r\n   426\t\t\tif(pMesh->meshType == TMdfMesh::MESH_SKINNED) {\r\n   427\t\t\t\tfwrite(pMesh->uVtxs.pVertices, sizeof(TMdfVertSkn), pMesh->nNumVerts, fp);\r\n   428\t\t\t} else if(pMesh->meshType == TMdfMesh::MESH_STATIC) {\r\n   429\t\t\t\tfwrite(pMesh->uVtxs.pVertices, sizeof(TMdfVertSta), pMesh->nNumVerts, fp);\r\n   430\t\t\t}\r\n   431\t\r\n   432\t\t\t// write the indices\r\n   433\t\t\tByteAlignFile(fp);\r\n   434\t\t\tpHeaderMeshes[i].uIdxs.nDataOffset = ftell(fp);\r\n   435\t\t\tfwrite(pMesh->uIdxs.pIndices, sizeof(unsigned short), pMesh->nNumIndices, fp);\r\n   436\t\r\n   437\t\t\tif(pMesh->meshType == TMdfMesh::MESH_SKINNED) {\r\n   438\t\t\t\tByteAlignFile(fp);\r\n   439\t\t\t\t// write the bind-pose skin data\r\n   440\t\t\t\tpHeaderMeshes[i].uBnd.nDataOffset = ftell(fp);\r\n   441\t\t\t\tfwrite(pMesh->uBnd.pBindMats, sizeof(TMdfMatrix4), pMesh->nNumJoints, fp);\r\n   442\t\r\n   443\t\t\t\tByteAlignFile(fp);"]
[965.327759, "o", "\r\n   444\t\t\t\t// write out the parenting info\r\n   445\t\t\t\tpHeaderMeshes[i].uPrnt.nDataOffset = ftell(fp);\r\n   446\t\t\t\tfwrite(pMesh->uPrnt.pParentInfo, sizeof(int), pMesh->nNumJoints, fp);\r\n   447\t\t\t}\r\n   448\t\t}\r\n   449\t\r\n   450\t\t//\r\n"]
[965.327991, "o", "   451\t\t// for each animation, save the data\r\n   452\t\t//\r\n   453\t\tfor(unsigned int i = 0; i < m_tMdfHeader.nAnimCount; i++) {\r\n   454\t\t\tconst TMdfAnimation *pAnim = &m_vpAnimations[i];\r\n   455\t\t\tpHeaderAnims[i] = *pAnim;\r\n"]
[965.328235, "o", "   456\t\r\n   457\t\t\tTMdfTimeline *pHeaderTimelines = (TMdfTimeline *)malloc(pAnim->nNumTimelines * sizeof(TMdfTimeline));\r\n   458\t\r\n   459\t\t\t// for each time-line\r\n   460\t\t\tfor(int t = 0; t < pAnim->nNumTimelines; t++) {\r\n   461\t\r\n   462\t\t\t\tconst TMdfTimeline *pTimeline = &pAnim->uTls.pTimeline[t];\r\n   463\t\t\t\tpHeaderTimelines[t] = *pTimeline;\r\n   464\t\r\n   465\t\t\t\t// write out the keyframes\r\n   466\t\t\t\tByteAlignFile(fp);\r\n   467\t\t\t\tpHeaderTimelines[t].uKfs.nDataOffset = ftell(fp);\r\n   468\t\t\t\tfwrite(pTimeline->uKfs.pKeyframes, sizeof(TMdfKeyframe), pTimeline->nKeyFrames, fp);\r\n   469\t\t\t}\r\n   470\t\r\n   471\t\t\t// write out the timelines\r\n   472\t\t\tByteAlignFile(fp);\r\n   473\t\t\tpHeaderAnims[i].uTls.nDataOffset = ftell(fp);\r\n   474\t\t\tfwrite(pHeaderTimelines, sizeof(TMdfTimeline), pAnim->nNumTimelines, fp);\r\n   475\t\t\tfree(pHeaderTimelines);\r\n   476\t\t}\r\n   477\t\r\n   478\t\tm_tMdfHeader.nTotalDataSize = (unsigned int)ftell(fp) - sizeof(MdfHeader);\r\n   479\t\r\n   480\t\t//\r\n   481\t\t// go back and write out the headers\r\n   482\t\t//\r\n   483\t\tfseek(fp, 0, SEEK_SET);\r\n   484\t\r\n   485\t\t// write the main header\r\n   486\t\tfwrite(&m_tMdfHeader, sizeof(m_tMdfHeader), 1, fp);\r\n   487\t\r\n   488\t\t// used textures header\r\n   489\t\tfwrite(pHeaderTextures, sizeof(int), m_tMdfHeader.nTextureCount, fp);\r\n   490\t\r\n   491\t\t// mesh headers\r\n   492\t\tfwrite(pHeaderMeshes, sizeof(TMdfMesh), m_tMdfHeader.nMeshCount, fp);\r\n   493\t\r\n   494\t\t// animation headers\r\n   495\t\tfwrite(pHeaderAnims, sizeof(TMdfAnimation), m_tMdfHeader.nAnimCount, fp);\r\n   496\t\r\n   497\t\tfclose(fp);\r\n   498\t\r\n   499\t\tfree(pHeaderMeshes);\r\n   500\t\tfree(pHeaderAnims);\r\n   501\t\tfree(pHeaderTextures);\r\n   502\t\r\n   503\t\treturn true;\r\n   504\t}\r\n   505\t\r\n   506\tbool MdfFormat::LoadFromStream(MdfStream &stream)\r\n   507\t{\r\n   508\t\tif(m_vpMeshes || m_pData) {\r\n   509\t\t\treturn false;\r\n   510\t\t"]
[965.328435, "o", "}\r\n   511\t\tint nHeaderLength = sizeof(m_tMdfHeader);\r\n   512\t\r\n   513\t\tstream.Read(&m_tMdfHeader, nHeaderLength);\r\n   514\t\r\n   515\t\t// read the entire file\r\n   516\t\tm_nDataSize = stream.Length() - nHeaderLength;\r\n   517\t\tm_pData = (Byte*)malloc(m_nDataSize);\r\n   518\t\tstream.Read(m_pData, (int)m_nDataSize);\r\n   519\t\r\n   520\t\tint dataPos = 0;\r\n   521\t\r\n   522\t\t// check for textures and set their pointer\r\n   523\t\tif(m_tMdfHeader.nTextureCount > 0) {\r\n   524\t\t\tm_vpTextures = (char**)&m_pData[dataPos];\r\n   525"]
[965.328646, "o", "\t\t\tdataPos += m_tMdfHeader.nTextureCount * sizeof(int);\r\n   526\t\t}\r\n   527\t\r\n   528\t\t// check for meshes and set their pointer\r\n"]
[965.328806, "o", "   529\t\tif(m_tMdfHeader.nMeshCount > 0) {\r\n   530\t\t\tm_vpMeshes = (TMdfMesh*)&m_pData[dataPos];\r\n   531\t\t\tdataPos += m_tMdfHeader.nMeshCount * sizeof(TMdfMesh);\r\n   532\t\t}\r\n   533\t\r\n   534\t\t// check for animations and set their pointer\r\n   535\t\tif(m_tMdfHeader.nAnimCount > 0) {\r\n   536\t\t\tm_vpAnimations = (TMdfAnimation*)&m_pData[dataPos];\r\n   537\t\t}\r\n   538\t\r\n   539\t\t//\r\n   540\t\t// for each texture, fix up the pointers\r\n   541\t\t//\r\n   542\t\tfor(size_t i = 0; i < m_tMdfHeader.nTextureCount; i++) {\r\n   543\t\t\tm_vpTextures[i] = (char*)(m_pData  + ((int)m_vpTextures[i]) - nHeaderLength);\r\n   544\t\t}\r\n   545\t\r\n   546\t\t//\r\n   547\t\t// for each mesh fix up the pointers\r\n   548\t\t//\r\n   549\t"]
[965.329113, "o", "\tfor(size_t i = 0; i < m_tMdfHeader.nMeshCount; i++) {\r\n   550\t\t\tm_vpMeshes[i].uVtxs.pVertices = m_pData + m_vpMeshes[i].uVtxs.nDataOffset - nHeaderLength;\r\n   551\t\t\tm_vpMeshes[i].uIdxs.pIndices = (unsigned short*)(m_pData + m_vpMeshes[i].uIdxs.nDataOffset - nHeaderLength);\r\n   552\t\r\n   553\t\t\tif(m_vpMeshes[i].nNumJoints > 0) {\r\n   554\t\t\t\tm_vpMeshes[i].uBnd.pBindMats = (TMdfMatrix4*)(m_pData + m_vpMeshes[i].uBnd.nDataOffset - nHeaderLength);\r\n   555\t\t\t\tm_vpMeshes[i].uPrnt.pParentInfo = (int*)(m_pData + m_vpMeshes[i].uPrnt.nDataOffset - nHeaderLength);\r\n   556\t\t\t} else {\r\n   557\t\t\t\tm_vpMeshes[i].uBnd.pBindMats = 0;\r\n   558\t\t\t\tm_vpMeshes[i].uPrnt.pParentInfo = 0;\r\n   559\t\t\t}\r\n   560\t\t\tdataPos += sizeof(TMdfMesh);\r\n   561\t\t}\r\n   562\t\r\n   563\t\t//\r\n   564\t\t// for each animation, fix up the pointers\r\n   565\t\t//\r\n"]
[965.32944, "o", "   566\t\tfor(size_t i = 0; i < m_tMdfHeader.nAnimCount; i++) {\r\n   567\t\t\tm_vpAnimations[i].uTls.pTimeline = (TMdfTimeline*)(m_pData + m_vpAnimations[i].uTls.nDataOffset - nHeaderLength);\r\n   568\t\r\n   569\t\t\t// fix up the time-line pointers\r\n   570\t\t\tfor(int t = 0; t < m_vpAnimations[i].nNumTimelines; t++) {\r\n   571\t\t\t\tm_vpAnimations[i].uTls.pTimeline[t].uKfs.pKeyframes = (TMdfKeyframe*)(m_pData + m_vpAnimations[i].uTls.pTimeline[t].uKfs.nDataOffset - nHeaderLength);\r\n   572\t\t\t}\r\n   573\t\t}\r\n   574\t\r\n   575\t\treturn true;\r\n   576\t}\r\n   577\t\r\n   578\tvoid MdfFormat::Destroy()\r\n   579\t{\r\n"]
[965.329685, "o", "   580\t\t// clean up any additional memory and\r\n   581\t\t// reset all the internal state to default\r\n   582\t\r\n   583\t\tif(m_pData) {\r\n   584\t\t\tfree(m_pData);\r\n   585\t\r\n   586\t\t} else {\r\n   587\t\t\t// release meshes\r\n   588\t\t\tfor(unsigned int i = 0; i < m_nMeshArrayLength; i++) {\r\n   589\t\t\t\tfree(m_vpMeshes[i].uVtxs.pVertices);\r\n   590\t\t\t\tfree(m_vpMeshes[i].uIdxs.pIndices);\r\n   591\t\t\t\tfree(m_vpMeshes[i].uBnd.pBindMats);\r\n   592\t\t\t\tfree(m_vpMeshes[i].uPrnt.pParentInfo);\r\n   593\t\t\t}\r\n   594\t\r\n   595\t\t\t// release animations\r\n   596\t\t\tfor(unsigned int i = 0; i < m_nAnimArrayLength; i++) {\r\n   597\t\r\n   598\t\t\t\t// release timelines\r\n   599\t\t\t\tfor(int t = 0; t < m_vpAnimations[i].nNumTimelines; t++) {\r\n   600\t\t\t\t\t// release keyframes\r\n   601\t\t\t\t\tfree(m_vpAnimations[i].uTls.pTimeline[t].uKfs.pKeyframes);\r\n   602\t\t\t\t}\r\n   603\t\t\t\tfree(m_vpAnimations[i].uTls.pTimeline);\r\n   604\t\r\n   605\t\t\t}\r\n   606\t\r\n   607\t\t\tfree(m_vpMeshes);\r\n   608\t\t\tfree(m_vpAnimations);\r\n   609\t\r\n   610\t\t\t// release textures\r\n   611\t\t\tfor(unsigned i = 0; i < m_tMdfHeader.nTextureCount; i++) {\r\n   612\t\t\t\tfree(m_vpTextures[i]);\r\n   613\t"]
[965.329964, "o", "\t\t}\r\n   614\t\t\tfree(m_vpTextures);\r\n   615\t\r\n   616\t\t} // if(m_pData)\r\n   617\t\r\n   618\t\tm_pData = 0;\r\n   619\t\tm_vpMeshes = 0;\r\n   620\t\tm_vpAnimations = 0;\r\n"]
