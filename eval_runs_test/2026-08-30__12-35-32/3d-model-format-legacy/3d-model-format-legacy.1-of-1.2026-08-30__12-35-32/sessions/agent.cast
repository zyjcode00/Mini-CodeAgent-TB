[466.336743, "o", "     1\t#pragma once\r\n     2\t\r\n     3\tunion Float2 {\r\n     4\t\tstruct {\r\n     5\t\t\tfloat x, y;\r\n     6\t\t};\r\n     7\t\r\n     8\t\tstruct {\r\n     9\t\t\tfloat u, v;\r\n    10\t\t};\r\n    11\t\r\n    12\t\tfloat & operator[] (int idx) { return element[idx]; }\r\n    13\t\r\n    14\tprivate:\r\n    15\t\tfloat element[2];\r\n    16\t};\r\n    17\t\r\n    18\tunion Float3 {\r\n    19\t\tstruct {\r\n"]
