[765.556164, "o", "\u001b[32m\u001b[K10\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktypedef\u001b[m\u001b[K int MdfHandle;\r\n\u001b[32m\u001b[K21\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kstruct MdfHeader\u001b[m\u001b[K \r\n"]
[765.556434, "o", "\u001b[32m\u001b[K201\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kstruct TMdfMesh\u001b[m\u001b[K\r\n\u001b[32m\u001b[K288\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kstruct TMdfKeyframe\u001b[m\u001b[K\r\n\u001b[32m\u001b[K309\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kstruct TMdfTimeline\u001b[m\u001b[K\r\n\u001b[32m\u001b[K372\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktypedef\u001b[m\u001b[K std::vector<MdfFullVertex> FullVertList;\r\n"]
[765.556553, "o", "\u001b[32m\u001b[K373\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktypedef\u001b[m\u001b[K std::vector<unsigned short> FullIndexList;\r\n\u001b[32m\u001b[K434\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktypedef\u001b[m\u001b[K std::vector<TMdfKeyframe> FullKeyframeList;\r\n\u001b[32m\u001b[K441\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Ktypedef\u001b[m\u001b[K std::vector<MdfFullTimeline> FullTimelineList;\r\n"]
