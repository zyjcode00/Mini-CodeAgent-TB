[275.29963, "o", "==> MdfFormat.cpp <==\r\n#include \"StdAfx.h\"\r\n#include \"MdfFormat.h\"\r\n#include <stdlib.h>\r\n\r\nconst char MDF_VER_STR[8] = {\r\n\t'M',\r\n\t'D',\r\n\t'F',\r\n\t' ',\r\n\t'v',\r\n\t'1',\r\n\t'.',\r\n\t'2'\r\n};\r\n\r\nclass MdfMemStream \r\n\t: public MdfStream\r\n{\r\npublic:\r\n\tMdfMemStream(Byte *pData, int nDataLen) : pData(pData), nDataLen(nDataLen), nPos(0) {}\r\n\tvirtual ~MdfMemStream() {}\r\n\r\n\tvirtual bool Seek(int offset, int origin);\r\n\tvirtual int Tell();\r\n\tvirtual int Read(void *pDest, int nLength);\r\n\tvirtual int Length();\r\n\r\nprivate:\r\n\tByte *pData;\r\n\tint nDataLen;\r\n\tint nPos;\r\n\r\n};\r\n\r\nbool MdfMemStream::Seek(int offset, int origin)\r\n{\r\n\tswitch(origin) {\r\n\t\tcase SEEK_SET:\r\n\t\t{\r\n\t\t\tif(offset < 0 || offset > nDataLen) {\r\n"]
[275.299773, "o", "\r\n==> stdafx.h <==\r\n// stdafx.h : include file for standard system include files,\r\n// or project specific include files that are used frequently, but\r\n// are changed infrequently\r\n//\r\n\r\n#pragma once\r\n\r\n\r\n#define WIN32_LEAN_AND_MEAN\t\t// Exclude rarely-used stuff from Windows headers\r\n\r\n#include <windows.h>\r\n\r\n// TODO: reference additional headers your program requires here\r\n\r\n==> types.h <==\r\n#pragma once\r\n\r\nunion Float2 {\r\n\tstruct {\r\n\t\tfloat x, y;\r\n\t};\r\n\r\n\tstruct {\r\n\t\tfloat u, v;\r\n\t};\r\n\r\n\tfloat & operator[] (int idx) { return element[idx]; }\r\n\r\nprivate:\r\n\tfloat element[2];\r\n};\r\n\r\nunion Float3 {\r\n\tstruct {\r\n\t\tfloat x, y, z;\r\n\t};\r\n\r\n"]
[275.299908, "o", "\tstruct {\r\n\t\tfloat r, g, b;\r\n\t};\r\n\r\n\tfloat & operator[] (int idx) { return element[idx]; }\r\n\r\nprivate:\r\n\tfloat element[3];\r\n};\r\n\r\nunion Float4 {\r\n\tstruct {\r\n\t\tfloat x, y, z, w;\r\n\t};\r\n\r\n\tstruct {\r\n\t\tfloat r, g, b, a;\r\n\t};\r\n"]
