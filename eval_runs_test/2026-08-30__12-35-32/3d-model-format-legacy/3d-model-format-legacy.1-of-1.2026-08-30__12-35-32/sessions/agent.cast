[989.189349, "o", "    80\t\tbool CreateFromFileInMemory(Byte *pData, size_t nDataSize);\r\n    81\t\t\r\n    82\t\t//////////////////////////////////////////////////////////////////////////\r\n    83\t\t/// Destroy the MDF and free all the memory\r\n    84\t\t///\r\n    85\t\t/// \\remarks Once destroyed, this object is available for any of the\r\n    86\t\t///\t\t\t Create* calls to create a new MDF\r\n    87\t\t///\r\n    88\t\t//////////////////////////////////////////////////////////////////////////\r\n    89\t\tvoid Destroy();\r\n    90\t\r\n    91\t\t//////////////////////////////////////////////////////////////////////////\r\n    92\t\t/// Save MDF data to a file\r\n    93\t\t///\r\n    94\t\t/// \\param szFilename - path of the file to save to\r\n    95\t\t/// \\return true if successful\r\n    96\t\t//////////////////////////////////////////////////////////////////////////\r\n    97\t\tbool SaveToFile(const char *szFilename) const;\r\n    98\t\r\n    99\t\r\n   100\t\t//////////////////////////////////////////////////////////////////////////\r\n   101\t\t/// Add a new mesh to this MDF\r\n   102\t\t///\r\n   103\t\t/// \\param newMesh - mesh information to add\r\n   104\t\t/// \\return index of the newly-added mesh\r\n   105\t\t//////////////////////////////////////////////////////////////////////////\r\n   106\t\tMdfHandle AddMesh(const MdfFullMesh &newMesh);\r\n   107\t\r\n   108\t\t//////////////////////////////////////////////////////////////////////////\r\n"]
[989.18962, "o", "   109\t\t/// Add a new animation to this MDF\r\n   110\t\t///\r\n   111\t\t/// \\param newAnimation - animation information to add\r\n   112\t\t/// \\return index of the newly-added animation\r\n   113\t\t//////////////////////////////////////////////////////////////////////////\r\n   114\t\tMdfHandle AddAnimation(const MdfFullAnimation &newAnimation);\r\n   115\t\r\n   116\t\t/************************************************************************/\r\n   117\t\t/* ACCESSORS                                                            */\r\n   118\t\t/************************************************************************/\r\n   119\tpublic:\r\n   120\t\r\n   121\t\t//////////////////////////////////////////////////////////////////////////\r\n   122\t\t/// Get the number of meshes that are stored in this MDF\r\n   123\t\t///\r\n   124\t\t/// \\return total number of meshes\r\n   125\t\t//////////////////////////////////////////////////////////////////////////\r\n   126\t\tunsigned int GetNumMeshes() const { return m_tMdfHeader.nMeshCount; }\r\n   127\t\t\r\n   128\t\t//////////////////////////////////////////////////////////////////////////\r\n   129\t\t/// Obtain a read-only mesh object given by the index\r\n   130\t\t///\r\n   131\t\t/// \\param hMeshId index of the mesh object to obtain\r\n   132\t\t/// \\return Mesh object of the given index\r\n   133\t\t///\r\n   134\t\t/// \\warning Invalid indexes are not checked, use GetNumMeshes() to find\r\n   135\t\t///\t\t\t the maximum index\r\n"]
[989.189792, "o", "   136\t\t//////////////////////////////////////////////////////////////////////////\r\n   137\t\tconst TMdfMesh & GetMesh(MdfHandle hMeshId) const { return m_vpMeshes[hMeshId]; }\r\n   138\t\r\n   139\t\t//////////////////////////////////////////////////////////////////////////\r\n   140\t\t/// Get number of animations that are stored in this MDF\r\n   141\t\t///\r\n   142\t\t/// \\return number of animations in this MDF\r\n   143\t\t//////////////////////////////////////////////////////////////////////////\r\n   144\t\tunsigned int GetNumAnimations() const { return m_tMdfHeader.nAnimCount; }\r\n   145\t\r\n   146\t\t//////////////////////////////////////////////////////////////////////////\r\n   147\t\t/// Obtain a read-only animation object given by the index\r\n   148\t\t///\r\n   149\t\t/// \\param hAnimId - animation index\r\n   150\t\t/// \\return Mesh animation of the given index\r\n   151\t\t///\r\n   152\t\t/// \\warning Invalid indexes are not checked, use GetNumAnimations() to find\r\n   153\t\t///\t\t\t the maximum index\r\n   154\t\t//////////////////////////////////////////////////////////////////////////\r\n   155\t\tconst TMdfAnimation & GetAnimation(MdfHandle hAnimId) const { return m_vpAnimations[hAnimId]; }\r\n   156\t\r\n   157\t\t//////////////////////////////////////////////////////////////////////////\r\n   158\t\t/// Get texture that is assigned to the given mesh\r\n   159\t\t///\r\n   160\t\t/// \\param hMeshId - index of the mesh\r\n   161\t\t/// \\return index of the texture\r\n   162\t\t//////////////////////////////////////////////////////////////////////////\r\n   163\t\tMdfHandle GetTextureId(MdfHandle hMeshId) const {\r\n   164\t\t\treturn m_vpMeshes[hMeshId].hTexture;\r\n   165\t\t}\r\n   166\t\r\n   167\t\t//////////////////////////////////////////////////////////////////////////\r\n   168\t\t/// Get the number of texture names that are stored in this MDF\r\n   169\t\t///\r\n   170\t\t/// \\return total number of texture names\r\n   171\t\t//////////////////////////////////////////////////////////////////////////\r\n   172\t\tunsigned int GetNumTextures() const { return m_tMdfHeader.nTextureCount; }\r\n   173\t\r\n   174\t\t//////////////////////////////////////////////////////////////////////////\r\n   175\t\t/// Get texture name from the specified texture index value\r\n   176\t\t///\r\n"]
[989.189922, "o", "   177\t\t/// \\param hTextureId - texture index\r\n   178\t\t/// \\return name of the texture\r\n   179\t\t///\r\n   180\t\t/// \\warning The string memory is maintained by the MDF object.\r\n   181\t\t///\t\t\t Always use deep-copying if you want to store the \r\n   182\t\t///\t\t\t string elsewhere.\r\n   183\t\t///\t\t\t The string is destroyed when this MDF is destroyed.\r\n   184\t\t///\r\n   185\t\t//////////////////////////////////////////////////////////////////////////\r\n   186\t\tconst char * GetTextureName(MdfHandle hTextureId) const { return m_vpTextures[hTextureId]; }\r\n   187\t\t\r\n   188\t\t//////////////////////////////////////////////////////////////////////////\r\n   189\t\t/// Get the header of this MDF\r\n   190\t\t///\r\n   191\t\t/// \\return the header of this MDF\r\n   192\t\t//////////////////////////////////////////////////////////////////////////\r\n   193\t\tconst MdfHeader & GetHeader() const { return m_tMdfHeader; }\r\n   194\t\r\n   195\t\tbool HasAnimations() const {\r\n   196\t\t\treturn(m_vpAnimations != 0);\r\n   197\t\t}\r\n   198\t\r\n   199\t\tbool HasMeshes() const {\r\n   200\t\t\treturn(m_vpMeshes != 0);\r\n   201\t\t}\r\n   202\t\r\n   203"]
[989.190079, "o", "\t\t/************************************************************************/\r\n   204\t\t/* PRIVATE METHODS                                                      */\r\n   205\t\t/************************************************************************/\r\n   206\tprotected:\r\n   207\t\r\n   208\t\t//////////////////////////////////////////////////////////////////////////\r\n   209\t\t/// Loads an MDF from a given stream\r\n   210\t\t///\r\n   211\t\t/// \\param stream - the stream to load from\r\n   212\t\t/// \\return true if successful\r\n   213\t\t//////////////////////////////////////////////////////////////////////////\r\n   214\t\tbool LoadFromStream(MdfStream &stream);\r\n   215\t\r\n   216\t\t//////////////////////////////////////////////////////////////////////////\r\n   217\t\t/// Add a texture name to this MDF\r\n   218\t\t///\r\n   219\t\t/// \\remarks Adding duplicate names will waste memory. It is up to the\r\n   220\t\t///\t\t\t caller to ensure that no duplicate texture names are added.\r\n"]
