[275.289772, "o", "cd /app/MdfLib && printf '%s\\n' '--- types ---' && nl -ba mdftypes.h | sed -n '1,210p' && printf '%s\\n' '--- format ---' && nl -ba MdfFormat.h | sed -n '1,180p' && printf '%s\\n' '--- includes ---' && head -40 MdfFormat.cpp stdafx.h types.h\r\n\u001b[?2004l\r"]
[275.289964, "o", "--- types ---\r\n"]
[275.292415, "o", "     1\t#pragma once\r\n     2\t#include \"types.h\"\r\n     3\t#include <math.h>\r\n     4\t#include <vector>\r\n     5\t#include <string>\r\n     6\t\r\n     7\t#define MFDVERT_EPSILON 0.0001f\r\n     8\t\r\n     9\t\r\n    10\ttypedef int MdfHandle;\r\n    11\t\r\n    12\t//////////////////////////////////////////////////////////////////////////\r\n    13\t/// \\brief MDF File Header\r\n    14\t/// \\author Ivgeni Segal\r\n    15\t/// \\date January 20, 2007\r\n    16\t///\r\n    17\t/// MDF File header is the structure stored at the beginning\r\n    18\t/// of the file and identifies its version and contents\r\n    19\t///\r\n    20\t//////////////////////////////////////////////////////////////////////////\r\n    21\tstruct MdfHeader \r\n    22\t{ \r\n    23\t\tchar cId[8]; // 'MDF v1.0'\r\n    24\t\r\n    25\t\tunsigned int nMeshCount;\t\t///< Number of meshes in this file\r\n    26\t\tunsigned int nAnimCount;\t\t///< Number of animations in this file\r\n    27\t\tunsigned int nTextureCount;\t\t///< Total number of texture names\r\n    28\t\tunsigned int nByteAlignment;\t///< Current byte alignment of the file\r\n    29\t\tunsigned int nNumHierarchies;\t///< Unused\r\n    30\t\r\n    31\t\tunsigned int nTotalDataSize;\t///< Total size of the data excluding\r\n    32\t\t\t\t\t\t\t\t\t\t///< the header\r\n    33\t};\r\n    34\t\r\n    35\t//////////////////////////////////////////////////////////////////////////\r\n    36\t\r\n    37\t//\r\n    38\t\r\n    39\t//\r\n    40\t\r\n    41\t//////////////////////////////////////////////////////////////////////////\r\n"]
[275.292758, "o", "    42\t/// \\brief Transitional vertex format\r\n    43\t/// \\author Ivgeni Segal\r\n    44\t/// \\date January 20, 2007\r\n    45\t///\r\n    46\t/// transitional vertex format for use with exporters.\r\n    47\t/// This structure is used by the mesh-building functions of the MDF \r\n    48\t/// format object. do not use for loading.\r\n    49\t///\r\n    50\t///\r\n    51\t//////////////////////////////////////////////////////////////////////////\r\n    52\tstruct MdfFullVertex {\r\n    53\t\tfloat pos[3];\r\n    54\t\r\n    55\t\tfloat weights[3];\r\n    56\t\tunsigned char bones[4];\r\n    57\t\r\n    58\t\tfloat normal[3];\r\n    59\t\tfloat u, v;\r\n    60\t\r\n    61\t\tbool operator==(const MdfFullVertex &b) const {\r\n    62\t\t\tif(bones[0] != b.bones[0]){\r\n    63\t\t\t\treturn false;\r\n    64\t\t\t}\r\n    65\t\t\tif(bones[1] != b.bones[1]){\r\n    66\t\t\t\treturn false;\r\n    67\t\t\t}\r\n    68\t\t\tif(bones[2] != b.bones[2]){\r\n    69\t\t\t\treturn false;\r\n    70\t\t\t}\r\n    71\t\t\tif(bones[3] != b.bones[3]){\r\n    72\t\t\t\treturn false;\r\n    73\t\t\t}\r\n    74\t\t\tif(fabs(pos[0] - b.pos[0]) > MFDVERT_EPSILON) {\r\n    75\t\t\t\treturn false;\r\n    76\t\t\t}\r\n    77\t\t\tif(fabs(pos[1] - b.pos[1]) > MFDVERT_EPSILON) {\r\n    78\t\t\t\treturn false;\r\n    79\t\t\t}\r\n    80\t\t\tif(fabs(pos[2] - b.pos[2]) > MFDVERT_EPSILON) {\r\n    81\t\t\t\treturn false;\r\n    82\t\t\t}\r\n    83\t\t\t"]
[275.293094, "o", "if(fabs(weights[0] - b.weights[0]) > MFDVERT_EPSILON) {\r\n    84\t\t\t\treturn false;\r\n    85\t\t\t}\r\n    86\t\t\tif(fabs(weights[1] - b.weights[1]) > MFDVERT_EPSILON) {\r\n    87\t\t\t\treturn false;\r\n    88\t\t\t}\r\n    89\t\t\tif(fabs(weights[2] - b.weights[2]) > MFDVERT_EPSILON) {\r\n    90\t\t\t\treturn false;\r\n    91\t\t\t}\r\n    92\t\t\tif(fabs(normal[0] - b.normal[0]) > MFDVERT_EPSILON) {\r\n    93\t\t\t\treturn false;\r\n    94\t\t\t}\r\n"]
[275.293382, "o", "    95\t\t\tif(fabs(normal[1] - b.normal[1]) > MFDVERT_EPSILON) {\r\n    96\t\t\t\treturn false;\r\n    97\t\t\t}\r\n    98\t\t\tif(fabs(normal[2] - b.normal[2]) > MFDVERT_EPSILON) {\r\n    99\t\t\t\treturn false;\r\n   100\t\t\t}\r\n   101\t\t\tif(fabs(u - b.u) > MFDVERT_EPSILON) {\r\n   102\t\t\t\treturn false;\r\n   103\t\t\t}\r\n   104\t\t\tif(fabs(v - b.v) > MFDVERT_EPSILON) {\r\n   105\t\t\t\treturn false;\r\n   106\t\t\t}\r\n   107\t\r\n   108\t\t\treturn true;\r\n   109\t\t}\r\n   110\t\r\n   111\t};\r\n   112\t\r\n   113\t//////////////////////////////////////////////////////////////////////////\r\n   114\t/// \\brief Generic 4x4 matrix\r\n   115\t/// \\author Ivgeni Segal\r\n   116\t/// \\date January 20, 2007\r\n   117\t///\r\n   118\t/// Generic matrix used in the MDF format\r\n   119\t///\r\n   120\t/// \\remarks MDF uses row-major matrices, if you need to use MDF in a\r\n   121\t///\t\t\t column-major environment such as OpenGL don't forget to\r\n   122\t///\t\t\t transpose them.\r\n   123\t///\r\n   124\t//////////////////////////////////////////////////////////////////////////\r\n   125\tstruct TMdfMatrix4\r\n   126\t{\r\n   127\t\tfloat\te[16];\r\n   128\t};\r\n"]
[275.293582, "o", "   129\t\r\n   130\t//////////////////////////////////////////////////////////////////////////\r\n   131\t/// \\brief Skinned vertex for animation\r\n   132\t/// \\author Ivgeni Segal\r\n   133\t/// \\date January 20, 2007\r\n   134\t///\r\n   135\t/// \\remarks Skinned vertex is present in animated meshes and supports\r\n   136\t///\tup to four bones per vertex\r\n   137\t///\r\n   138\t//////////////////////////////////////////////////////////////////////////\r\n   139\tstruct TMdfVertSkn\r\n   140\t{\r\n   141\t\tFloat3 pos;\r\n   142\t\tfloat weights[3];\r\n   143\t\tunsigned char bones[4];\r\n   144\t\r\n   145\t\tFloat3 normal;\r\n   146\t\tFloat2 texcoord;\r\n   147\t};\r\n   148\t\r\n   149\t//////////////////////////////////////////////////////////////////////////\r\n   150\t/// \\brief Vertex for static meshes\r\n   151\t/// \\author Ivgeni Segal\r\n   152\t/// \\date January 20, 2007\r\n   153\t///\r\n   154\t/// \\remarks All static geometry in MDF uses this vertex format,\r\n   155\t///\t\t\t he UV coordinates are in DirectX form\r\n   156\t///\r\n   157\t//////////////////////////////////////////////////////////////////////////\r\n   158\tstruct TMdfVertSta\r\n"]
[275.293859, "o", "   159\t{\r\n   160\t\tFloat3 pos;\t\t\t///< Vertex position in model space\r\n   161\t\r\n   162\t\tFloat3 normal;\t\t///< Vertex normal\r\n   163\t\tFloat2 texcoord;\t///< UV Texture coordinate\r\n   164\t\r\n   165\t\tTMdfVertSta & operator=(const TMdfVertSkn &rhs) {\r\n   166\t\t\tpos.x = rhs.pos.x;\r\n   167\t\t\tpos.y = rhs.pos.y;\r\n   168\t\t\tpos.z = rhs.pos.z;\r\n   169\t\r\n   170\t\t\tnormal.x = rhs.normal.x;\r\n   171\t\t\tnormal.y = rhs.normal.y;\r\n   172\t\t\tnormal.z = rhs.normal.z;\r\n   173\t\r\n   174\t\t\ttexcoord.u = rhs.texcoord.u;\r\n   175\t\t\ttexcoord.v = rhs.texcoord.v;\r\n   176\t\t\treturn *this;\r\n   177\t\t}\r\n   178\t};\r\n   179\t\r\n   180\t\r\n   181\t\r\n   182\t//////////////////////////////////////////////////////////////////////////\r\n   183\t/// \\brief A single Mesh Object\r\n   184\t/// \\author Ivgeni Segal\r\n   185\t/// \\date January 20, 2007\r\n   186\t///\r\n   187\t/// \\remarks The nDataOffset elements are the positions\r\n   188\t/// relative to the beginning of the MDF file.\r\n   189\t/// once the file is loaded they are converted into memory locations.\r\n   190\t/// \\par\r\n   191\t/// The TMdfMesh Object contains all the information needed to display a mesh\r\n   192\t/// In addition to vertex information, the Mesh Object stores optional\r\n   193\t/// bind-pose matrix array for animation as well as parenting information\r\n   194\t/// for the joints. All joints are stored in depth-first order of the joint hierarchy.\r\n"]
[275.294135, "o", "   195\t/// \\par\r\n   196\t/// Both of the arrays are parallel to the joint-keyframe\r\n   197\t/// arrays in the the TMdfAnimation Object that corresponds to this mesh.\r\n   198\t///\r\n   199\t///\r\n   200\t//////////////////////////////////////////////////////////////////////////\r\n   201\tstruct TMdfMesh\r\n   202\t{\r\n   203\t\tunsigned int\tnNumVerts;\t\t///< Number of vertices in this mesh\r\n   204\t\tunsigned int\tnNumIndices;\t///< Number of vertex indexes\r\n   205\t\tunsigned int\tnNumJoints;\t\t///< Number of joints in stored bind\r\n   206\t\t\t\t\t\t\t\t\t\t///< pose and parenting arrays\r\n   207\t\tMdfHandle\t\thTexture;\t\t///< Index of the texture name\r\n   208\t\tint meshType;\t\t\t\t\t///< Mesh type (See MeshType enum)\r\n   209\t\r\n"]
[275.294389, "o", "   210\t\t///\r\n"]
[275.295003, "o", "--- format ---\r\n"]
[275.296853, "o", "     1\t\r\n     2\t#pragma once\r\n     3\t\r\n     4\t#include \"mdftypes.h\"\r\n     5\t\r\n     6\t#define MDF_BYTE_ALIGNMENT 16\r\n     7\t\r\n     8\tclass MdfStream;\r\n"]
[275.297206, "o", "     9\t\r\n    10\tclass MdfFormat\r\n    11\t{\r\n    12\t\tenum MdfElements {\r\n    13\t\t\tMDF_NONE\t\t=\t0,\r\n    14\t\t\tMDF_MESHES\t\t=\t1,\r\n    15\t\t\tMDF_TEXTURES\t=\t2,\r\n    16\t\t\tMDF_BINDMATS\t=\t4,\r\n    17\t\t\tMDF_PARENTINFO\t=\t8,\r\n    18\t\t\tMDF_ANIMATIONS\t=\t16,\r\n    19\t\t\tMDF_TRANSFORMS\t=\t32,\r\n    20\t\t\tMDF_ALL\t\t\t= (MDF_MESHES|MDF_TEXTURES|MDF_BINDMATS|MDF_PARENTINFO|MDF_ANIMATIONS|MDF_TRANSFORMS)\r\n    21\t\t};\r\n    22\t\r\n    23\t\t/************************************************************************/\r\n    24\t\t/* DATA MEMBERS                                                         */\r\n    25\t\t/************************************************************************/\r\n    26\tprotected:\r\n    27\t\tsize_t m_nDataSize;\t\t\t\t\t///< Size of the memory pool\r\n    28\t\tByte *m_pData;\t\t\t\t\t\t///< Memory pool for this MDF\r\n    29\t\r\n    30\t\r\n    31\t\tTMdfMesh *m_vpMeshes;\t\t\t\t///< All the meshes in the file\r\n    32\t\tunsigned int m_nMeshArrayLength;\t///< Length of the meshes array\r\n    33\t\r\n    34\t\tTMdfAnimation *m_vpAnimations;\t\t///< All the animations in the file\r\n    35\t\tunsigned int m_nAnimArrayLength;\t///< Size of the animations array\r\n    36\t\r\n    37\t\tchar **m_vpTextures;\t\t\t\t///< Array of texture strings\r\n    38\t\r\n    39\t\tmutable MdfHeader m_tMdfHeader;\t\t\t\t///< Master MDF header\r\n    40\t\r\n    41\t\r\n    42\t\t/************************************************************************/\r\n    43\t\t/* CONSTRUCTION                                                         */\r\n    44\t\t/************************************************************************/\r\n    45\tpublic:\r\n    46\t\tMdfFormat(void);\r\n    47\tpublic:\r\n    48\t\tvirtual ~MdfFormat(void);\r\n    49\t\r\n    50\t"]
[275.297536, "o", "\t/************************************************************************/\r\n    51\t\t/* CLASS METHODS                                                        */\r\n    52\t\t/************************************************************************/\r\n    53\tpublic:\r\n    54\t\t//////////////////////////////////////////////////////////////////////////\r\n    55\t\t/// Create a new MDF file\r\n    56\t\t///\r\n    57\t\t/// \\param nNumMeshesHint - number of meshes this file might store\r\n    58\t\t/// \\return true if successful\r\n    59\t\t///\r\n    60\t\t/// \\remarks To recreate a new MDF on the same object, Destroy() must\r\n    61\t\t///\t\t\t be called first\r\n    62\t\t//////////////////////////////////////////////////////////////////////////\r\n    63\t\tbool Create(unsigned int nNumMeshesHint=0);\r\n    64\t\r\n    65\t\t//////////////////////////////////////////////////////////////////////////\r\n    66\t\t/// Create a new MDF by loading its data from a file\r\n    67\t\t///\r\n    68\t\t/// \\param szFilename - the path of the file to load\r\n    69\t\t/// \\return true if successful\r\n    70\t\t//////////////////////////////////////////////////////////////////////////\r\n    71\t\tbool CreateFromFile(const char *szFilename);\r\n    72\t\r\n    73\t\t//////////////////////////////////////////////////////////////////////////\r\n    74\t\t/// Create a new MDF from raw MDF data in memory\r\n    75\t\t///\r\n    76\t\t/// \\param pData - location of the raw MDF data to load\r\n    77\t\t/// \\param nDataSize - size of the data buffer in bytes\r\n    78\t\t/// \\return true if successful\r\n    79\t\t//////////////////////////////////////////////////////////////////////////\r\n    80\t\tbool CreateFromFileInMemory(Byte *pData, size_t nDataSize);\r\n    81\t\t\r\n    82\t\t//////////////////////////////////////////////////////////////////////////\r\n    83\t\t/// Destroy the MDF and free all the memory\r\n    84\t\t///\r\n    85\t\t/// \\remarks Once destroyed, this object is available for any of the"]
[275.297708, "o", "\r\n    86\t\t///\t\t\t Create* calls to create a new MDF\r\n    87\t\t///\r\n    88\t\t//////////////////////////////////////////////////////////////////////////\r\n    89\t\tvoid Destroy();\r\n    90\t\r\n    91\t\t//////////////////////////////////////////////////////////////////////////\r\n    92\t\t/// Save MDF data to a file\r\n    93\t\t///\r\n    94\t\t/// \\param szFilename - path of the file to save to\r\n    95\t\t/// \\return true if successful\r\n    96\t\t//////////////////////////////////////////////////////////////////////////\r\n    97\t\tbool SaveToFile(const char *szFilename) const;\r\n    98\t\r\n    99\t\r\n   100\t\t//////////////////////////////////////////////////////////////////////////\r\n   101\t\t/// Add a new mesh to this MDF\r\n   102\t\t///\r\n   103\t\t/// \\param newMesh - mesh information to add\r\n   104\t\t/// \\return index of the newly-added mesh\r\n   105\t\t//////////////////////////////////////////////////////////////////////////\r\n   106\t\tMdfHandle AddMesh(const MdfFullMesh &newMesh);\r\n   107\t\r\n   108\t\t//////////////////////////////////////////////////////////////////////////\r\n   109\t\t/// Add a new animation to this MDF\r\n   110\t\t///\r\n   111\t\t/// \\param newAnimation - animation information to add\r\n   112\t\t/// \\return index of the newly-added animation\r\n   113\t\t//////////////////////////////////////////////////////////////////////////\r\n   114\t\tMdfHandle AddAnimation(const MdfFullAnimation &newAnimation);\r\n   115\t\r\n   116\t\t/************************************************************************/\r\n   117\t\t/* ACCESSORS                                                            */\r\n   118\t\t/************************************************************************/\r\n   119\tpublic:\r\n   120\t\r\n   121\t\t//////////////////////////////////////////////////////////////////////////\r\n"]
[275.29782, "o", "   122\t\t/// Get the number of meshes that are stored in this MDF\r\n   123\t\t///\r\n   124\t\t/// \\return total number of meshes\r\n   125\t\t//////////////////////////////////////////////////////////////////////////\r\n   126\t\tunsigned int GetNumMeshes() const { return m_tMdfHeader.nMeshCount; }\r\n   127\t\t\r\n   128\t\t//////////////////////////////////////////////////////////////////////////\r\n   129\t\t/// Obtain a read-only mesh object given by the index\r\n   130\t\t///\r\n   131\t\t/// \\param hMeshId index of the mesh object to obtain\r\n   132\t\t/// \\return Mesh object of the given index\r\n   133\t\t///\r\n   134\t\t/// \\warning Invalid indexes are not checked, use GetNumMeshes() to find\r\n   135\t\t///\t\t\t the maximum index\r\n   136\t\t//////////////////////////////////////////////////////////////////////////\r\n   137\t\tconst TMdfMesh & GetMesh(MdfHandle hMeshId) const { return m_vpMeshes[hMeshId]; }\r\n   138\t\r\n   139\t\t//////////////////////////////////////////////////////////////////////////\r\n   140\t\t/// Get number of animations that are stored in this MDF\r\n   141\t\t///\r\n   142\t\t/// \\return number of animations in this MDF\r\n   143\t\t//////////////////////////////////////////////////////////////////////////\r\n   144\t\tunsigned int GetNumAnimations() const { return m_tMdfHeader.nAnimCount; }\r\n   145\t\r\n   146\t\t//////////////////////////////////////////////////////////////////////////\r\n   147\t\t/// Obtain a read-only animation object given by the index\r\n   148\t\t///\r\n"]
[275.298281, "o", "   149\t\t/// \\param hAnimId - animation index\r\n   150\t\t/// \\return Mesh animation of the given index\r\n   151\t\t///\r\n   152\t\t/// \\warning Invalid indexes are not checked, use GetNumAnimations() to find\r\n   153\t\t///\t\t\t the maximum index\r\n   154\t\t//////////////////////////////////////////////////////////////////////////\r\n   155\t\tconst TMdfAnimation & GetAnimation(MdfHandle hAnimId) const { return m_vpAnimations[hAnimId]; }\r\n   156\t\r\n   157\t\t//////////////////////////////////////////////////////////////////////////\r\n   158\t\t/// Get texture that is assigned to the given mesh\r\n   159\t\t///\r\n   160\t\t/// \\param hMeshId - index of the mesh\r\n   161\t\t/// \\return index of the texture\r\n   162\t\t//////////////////////////////////////////////////////////////////////////\r\n   163\t\tMdfHandle GetTextureId(MdfHandle hMeshId) const {\r\n   164\t\t\treturn m_vpMeshes[hMeshId].hTexture;\r\n   165\t\t}\r\n   166\t\r\n   167\t\t//////////////////////////////////////////////////////////////////////////\r\n"]
[275.298427, "o", "   168\t\t/// Get the number of texture names that are stored in this MDF\r\n   169\t\t///\r\n   170\t\t/// \\return total number of texture names\r\n   171\t\t//////////////////////////////////////////////////////////////////////////\r\n   172\t\tunsigned int GetNumTextures() const { return m_tMdfHeader.nTextureCount; }\r\n   173\t\r\n   174\t\t//////////////////////////////////////////////////////////////////////////\r\n   175\t\t/// Get texture name from the specified texture index value\r\n   176\t\t///\r\n   177\t\t/// \\param hTextureId - texture index\r\n   178\t\t/// \\return name of the texture\r\n   179\t\t///\r\n   180\t\t/// \\warning The string memory is maintained by the MDF object.\r\n"]
