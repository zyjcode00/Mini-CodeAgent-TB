[228.290507, "o", "./LICENSE\r\n./MdfFormat.cpp\r\n./MdfFormat.h\r\n./MdfLib.vcproj\r\n./MdfLib.vcxproj\r\n./MdfLib.vcxproj.filters\r\n./MdfLib.vcxproj.user\r\n./MdfLib_2005.vcproj\r\n./Readme.md\r\n./mdftypes.h\r\n./stdafx.cpp\r\n./stdafx.h\r\n./test_models/bunbun.mdf\r\n./test_models/dragon.mdf\r\n./types.h\r\n"]
