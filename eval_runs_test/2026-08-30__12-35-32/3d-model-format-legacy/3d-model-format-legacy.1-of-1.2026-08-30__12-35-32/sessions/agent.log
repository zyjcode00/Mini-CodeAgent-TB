   578	void MdfFormat::Destroy()
   579	{
   580		// clean up any additional memory and
   581		// reset all the internal state to default
   582	
   583		if(m_pData) {
   584			free(m_pData);
   585	
   586		} else {
   587			// release meshes
   588			for(unsigned int i = 0; i < m_nMeshArrayLength; i++) {
   589				free(m_vpMeshes[i].uVtxs.pVertices);
   590				free(m_vpMeshes[i].uIdxs.pIndices);
   591				free(m_vpMeshes[i].uBnd.pBindMats);
   592				free(m_vpMeshes[i].uPrnt.pParentInfo);
   593			}
   594	
   595			// release animations
   596			for(unsigned int i = 0; i < m_nAnimArrayLength; i++) {
   597	
   598				// release timelines
   599				for(int t = 0; t < m_vpAnimations[i].nNumTimelines; t++) {
   600					// release keyframes
   601					free(m_vpAnimations[i].uTls.pTimeline[t].uKfs.pKeyframes);
   602				}
   603				free(m_vpAnimations[i].uTls.pTimeline);
   604	
   605			}
   606	
   607			free(m_vpMeshes);
   608			free(m_vpAnimations);
   609	
   610			// release textures
   611			for(unsigned i = 0; i < m_tMdfHeader.nTextureCount; i++) {
   612				free(m_vpTextures[i]);
   613			}
   614			free(m_vpTextures);
   615	
   616		} // if(m_pData)
   617	
   618		m_pData = 0;
   619		m_vpMeshes = 0;
   620		m_vpAnimations = 0;
