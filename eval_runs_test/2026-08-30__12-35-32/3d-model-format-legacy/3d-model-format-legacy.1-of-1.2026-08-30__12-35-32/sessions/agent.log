   309	MdfHandle MdfFormat::AddAnimation(const MdfFullAnimation &newAnimation)
   310	{
   311		TMdfAnimation *pAnim = 0;
   312		unsigned int nAnim = 0;
   313	
   314		// reallocate animation pointer array if needed
   315		if((m_tMdfHeader.nAnimCount + 1) > m_nAnimArrayLength) {
   316	
   317			m_vpAnimations = (TMdfAnimation*)realloc(m_vpAnimations, (m_tMdfHeader.nAnimCount+1)*sizeof(TMdfAnimation));
   318			m_nAnimArrayLength++;
   319		}
   320	
   321		// allocate new animation, set up variables
   322		nAnim = m_tMdfHeader.nAnimCount;
   323		pAnim = &m_vpAnimations[nAnim];
   324		m_tMdfHeader.nAnimCount++;
   325		ZeroMemory(pAnim, sizeof(TMdfAnimation));
   326	
   327		//
   328		// copy animation data
   329		//
   330	
   331		pAnim->hMeshId = newAnimation.hMeshId;
   332		pAnim->fTimeLength = newAnimation.fTimeLength;
   333		pAnim->nNumTimelines = (int) newAnimation.vTimelines.size();
   334		pAnim->uTls.pTimeline = (TMdfTimeline*)malloc(pAnim->nNumTimelines * sizeof(TMdfTimeline));
   335	
   336		ZeroMemory(pAnim->uTls.pTimeline, pAnim->nNumTimelines * sizeof(TMdfTimeline));
   337	
   338		TMdfTimeline *pTimeline;
   339		for(int i = 0; i < pAnim->nNumTimelines; i++) {
   340			pTimeline = &pAnim->uTls.pTimeline[i];
   341			pTimeline->nKeyFrames = (int)newAnimation.vTimelines[i].vKeyframes.size();
   342	
   343			pTimeline->uKfs.pKeyframes = (TMdfKeyframe*)malloc(pTimeline->nKeyFrames * sizeof(TMdfKeyframe));
   344	
   345			for(int k = 0; k < pTimeline->nKeyFrames; k++) {
   346				pTimeline->uKfs.pKeyframes[k] = newAnimation.vTimelines[i].vKeyframes[k];
   347			}
   348	
   349		}
   350	
   351		return nAnim;
   352	}
