[32m[K309[m[K[36m[K:[m[K[01;31m[Kstruct TMdf[m[KTimeline
[32m[K310[m[K[36m[K-[m[K{
[32m[K311[m[K[36m[K-[m[K	int nKeyFrames;
[32m[K312[m[K[36m[K-[m[K
[32m[K313[m[K[36m[K-[m[K	union UKfs_t {
[32m[K314[m[K[36m[K-[m[K		TMdfKeyframe *pKeyframes;
[32m[K315[m[K[36m[K-[m[K		int nDataOffset;
[32m[K316[m[K[36m[K-[m[K	} uKfs;
[32m[K317[m[K[36m[K-[m[K};
