    13	/// \brief MDF File Header
    14	/// \author Ivgeni Segal
    15	/// \date January 20, 2007
    16	///
    17	/// MDF File header is the structure stored at the beginning
    18	/// of the file and identifies its version and contents
    19	///
    20	//////////////////////////////////////////////////////////////////////////
    21	struct MdfHeader 
    22	{ 
    23		char cId[8]; // 'MDF v1.0'
    24	
    25		unsigned int nMeshCount;		///< Number of meshes in this file
    26		unsigned int nAnimCount;		///< Number of animations in this file
    27		unsigned int nTextureCount;		///< Total number of texture names
    28		unsigned int nByteAlignment;	///< Current byte alignment of the file
    29		unsigned int nNumHierarchies;	///< Unused
    30	
    31		unsigned int nTotalDataSize;	///< Total size of the data excluding
    32										///< the header
    33	};
