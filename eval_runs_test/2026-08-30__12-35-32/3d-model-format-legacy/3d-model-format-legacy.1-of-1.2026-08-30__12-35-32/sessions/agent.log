#pragma once

union Float2 {
	struct {
		float x, y;
	};

	struct {
		float u, v;
	};

	float & operator[] (int idx) { return element[idx]; }

private:
	float element[2];
};

union Float3 {
	struct {
		float x, y, z;
	};

	struct {
		float r, g, b;
	};

	float & operator[] (int idx) { return element[idx]; }

private:
	float element[3];
};

union Float4 {
	struct {
		float x, y, z, w;
	};

	struct {
		float r, g, b, a;
	};

	float & operator[] (int idx) { return element[idx]; }

private:
	float element[4];
};

