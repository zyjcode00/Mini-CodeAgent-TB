    88	class MdfFileStream
    89		: public MdfStream
    90	{
    91	public:
    92		MdfFileStream() : fp(0), nDataLen(0) {}
    93		virtual ~MdfFileStream() { Close(); }
    94	
    95		bool Open(const char *szFilename) {
    96			fp = fopen(szFilename, "rb");
    97			if(fp) {
    98				fseek(fp, 0, SEEK_END);
    99				nDataLen = (int)ftell(fp);
   100				fseek(fp, 0, SEEK_SET);
   101				return true;
   102			} else {
   103				return false;
   104			}
   105		}
   106	
   107		void Close() {
   108			if(fp) {
   109				fclose(fp);
   110			}
   111			fp = 0;
   112			nDataLen = 0;
   113		}
   114	
   115		virtual bool Seek(int offset, int origin) {
   116			return(fseek(fp, offset, origin) == 0);
   117		}
   118	
   119		virtual int Tell() { return (int)ftell(fp); }
   120	
   121		virtual int Read(void *pDest, int nLength) {
   122			return (int)fread(pDest, 1, nLength, fp);
   123		}
   124	
   125		virtual int Length() { return nDataLen; }
   126	
   127	private:
   128		FILE *fp;
   129		int nDataLen;
   130	};
