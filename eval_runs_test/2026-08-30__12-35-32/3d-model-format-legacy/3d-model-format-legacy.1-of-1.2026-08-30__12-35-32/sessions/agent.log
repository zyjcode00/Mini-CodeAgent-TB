#pragma once

#include "mdftypes.h"

#define MDF_BYTE_ALIGNMENT 16

class MdfStream;

class MdfFormat
{
	enum MdfElements {
		MDF_NONE		=	0,
		MDF_MESHES		=	1,
		MDF_TEXTURES	=	2,
		MDF_BINDMATS	=	4,
		MDF_PARENTINFO	=	8,
		MDF_ANIMATIONS	=	16,
		MDF_TRANSFORMS	=	32,
		MDF_ALL			= (MDF_MESHES|MDF_TEXTURES|MDF_BINDMATS|MDF_PARENTINFO|MDF_ANIMATIONS|MDF_TRANSFORMS)
	};

	/************************************************************************/
	/* DATA MEMBERS                                                         */
	/************************************************************************/
protected:
	size_t m_nDataSize;					///< Size of the memory pool
	Byte *m_pData;						///< Memory pool for this MDF


	TMdfMesh *m_vpMeshes;				///< All the meshes in the file
	unsigned int m_nMeshArrayLength;	///< Length of the meshes array

	TMdfAnimation *m_vpAnimations;		///< All the animations in the file
	unsigned int m_nAnimArrayLength;	///< Size of the animations array

	char **m_vpTextures;				///< Array of texture strings

	mutable MdfHeader m_tMdfHeader;				///< Master MDF header


	/************************************************************************/
	/* CONSTRUCTION                                                         */
	/************************************************************************/
public:
	MdfFormat(void);
public:
	virtual ~MdfFormat(void);

	/************************************************************************/
	/* CLASS METHODS                                                        */
	/************************************************************************/
public:
	//////////////////////////////////////////////////////////////////////////
	/// Create a new MDF file
	///
	/// \param nNumMeshesHint - number of meshes this file might store
	/// \return true if successful
	///
	/// \remarks To recreate a new MDF on the same object, Destroy() must
	///			 be called first
	//////////////////////////////////////////////////////////////////////////
	bool Create(unsigned int nNumMeshesHint=0);

	//////////////////////////////////////////////////////////////////////////
	/// Create a new MDF by loading its data from a file
	///
	/// \param szFilename - the path of the file to load
	/// \return true if successful
	//////////////////////////////////////////////////////////////////////////
	bool CreateFromFile(const char *szFilename);

	//////////////////////////////////////////////////////////////////////////
	/// Create a new MDF from raw MDF data in memory
	///
	/// \param pData - location of the raw MDF data to load
	/// \param nDataSize - size of the data buffer in bytes
	/// \return true if successful
	//////////////////////////////////////////////////////////////////////////
	bool CreateFromFileInMemory(Byte *pData, size_t nDataSize);
	
	//////////////////////////////////////////////////////////////////////////
	/// Destroy the MDF and free all the memory
	///
	/// \remarks Once destroyed, this object is available for any of the
	///			 Create* calls to create a new MDF
	///
	//////////////////////////////////////////////////////////////////////////
	void Destroy();

	//////////////////////////////////////////////////////////////////////////
	/// Save MDF data to a file
	///
	/// \param szFilename - path of the file to save to
	/// \return true if successful
	//////////////////////////////////////////////////////////////////////////
	bool SaveToFile(const char *szFilename) const;


	//////////////////////////////////////////////////////////////////////////
	/// Add a new mesh to this MDF
	///
	/// \param newMesh - mesh information to add
	/// \return index of the newly-added mesh
	//////////////////////////////////////////////////////////////////////////
	MdfHandle AddMesh(const MdfFullMesh &newMesh);

	//////////////////////////////////////////////////////////////////////////
	/// Add a new animation to this MDF
	///
	/// \param newAnimation - animation information to add
	/// \return index of the newly-added animation
	//////////////////////////////////////////////////////////////////////////
	MdfHandle AddAnimation(const MdfFullAnimation &newAnimation);

	/************************************************************************/
	/* ACCESSORS                                                            */
	/************************************************************************/
public:

	//////////////////////////////////////////////////////////////////////////
	/// Get the number of meshes that are stored in this MDF
	///
	/// \return total number of meshes
	//////////////////////////////////////////////////////////////////////////
	unsigned int GetNumMeshes() const { return m_tMdfHeader.nMeshCount; }
	
	//////////////////////////////////////////////////////////////////////////
	/// Obtain a read-only mesh object given by the index
	///
	/// \param hMeshId index of the mesh object to obtain
	/// \return Mesh object of the given index
	///
	/// \warning Invalid indexes are not checked, use GetNumMeshes() to find
	///			 the maximum index
	//////////////////////////////////////////////////////////////////////////
	const TMdfMesh & GetMesh(MdfHandle hMeshId) const { return m_vpMeshes[hMeshId]; }

	//////////////////////////////////////////////////////////////////////////
	/// Get number of animations that are stored in this MDF
	///
	/// \return number of animations in this MDF
	//////////////////////////////////////////////////////////////////////////
	unsigned int GetNumAnimations() const { return m_tMdfHeader.nAnimCount; }

	//////////////////////////////////////////////////////////////////////////
	/// Obtain a read-only animation object given by the index
	///
	/// \param hAnimId - animation index
	/// \return Mesh animation of the given index
	///
	/// \warning Invalid indexes are not checked, use GetNumAnimations() to find
	///			 the maximum index
	//////////////////////////////////////////////////////////////////////////
	const TMdfAnimation & GetAnimation(MdfHandle hAnimId) const { return m_vpAnimations[hAnimId]; }

	//////////////////////////////////////////////////////////////////////////
	/// Get texture that is assigned to the given mesh
	///
	/// \param hMeshId - index of the mesh
	/// \return index of the texture
	//////////////////////////////////////////////////////////////////////////
	MdfHandle GetTextureId(MdfHandle hMeshId) const {
		return m_vpMeshes[hMeshId].hTexture;
	}

	//////////////////////////////////////////////////////////////////////////
	/// Get the number of texture names that are stored in this MDF
	///
	/// \return total number of texture names
	//////////////////////////////////////////////////////////////////////////
	unsigned int GetNumTextures() const { return m_tMdfHeader.nTextureCount; }

	//////////////////////////////////////////////////////////////////////////
	/// Get texture name from the specified texture index value
	///
	/// \param hTextureId - texture index
	/// \return name of the texture
	///
	/// \warning The string memory is maintained by the MDF object.
	///			 Always use deep-copying if you want to store the 
	///			 string elsewhere.
	///			 The string is destroyed when this MDF is destroyed.
	///
	//////////////////////////////////////////////////////////////////////////
	const char * GetTextureName(MdfHandle hTextureId) const { return m_vpTextures[hTextureId]; }
	
	//////////////////////////////////////////////////////////////////////////
	/// Get the header of this MDF
	///
	/// \return the header of this MDF
	//////////////////////////////////////////////////////////////////////////
	const MdfHeader & GetHeader() const { return m_tMdfHeader; }

	bool HasAnimations() const {
		return(m_vpAnimations != 0);
	}

	bool HasMeshes() const {
		return(m_vpMeshes != 0);
	}

	/************************************************************************/
	/* PRIVATE METHODS                                                      */
	/************************************************************************/
protected:

	//////////////////////////////////////////////////////////////////////////
	/// Loads an MDF from a given stream
	///
	/// \param stream - the stream to load from
	/// \return true if successful
	//////////////////////////////////////////////////////////////////////////
	bool LoadFromStream(MdfStream &stream);

	//////////////////////////////////////////////////////////////////////////
	/// Add a texture name to this MDF
	///
	/// \remarks Adding duplicate names will waste memory. It is up to the
	///			 caller to ensure that no duplicate texture names are added.
	///
	/// \param szName - the name of the texture (usually filename)
	/// \return the index of the newly added texture name
	//////////////////////////////////////////////////////////////////////////
	MdfHandle AddTexture(const char *szName);

	void ByteAlignFile(FILE *fp) const;

private:
	// disable copy and assignment operator
	MdfFormat(MdfFormat &) {};
	MdfFormat & operator=(MdfFormat &) {}

};

class MdfStream {
public:
	virtual ~MdfStream() {};
	virtual bool Seek(int offset, int origin) = 0;
	virtual int Tell() = 0;
#pragma once
#include "types.h"
#include <math.h>
#include <vector>
#include <string>

#define MFDVERT_EPSILON 0.0001f


typedef int MdfHandle;

//////////////////////////////////////////////////////////////////////////
/// \brief MDF File Header
/// \author Ivgeni Segal
/// \date January 20, 2007
///
/// MDF File header is the structure stored at the beginning
/// of the file and identifies its version and contents
///
//////////////////////////////////////////////////////////////////////////
struct MdfHeader 
{ 
	char cId[8]; // 'MDF v1.0'

	unsigned int nMeshCount;		///< Number of meshes in this file
	unsigned int nAnimCount;		///< Number of animations in this file
	unsigned int nTextureCount;		///< Total number of texture names
	unsigned int nByteAlignment;	///< Current byte alignment of the file
	unsigned int nNumHierarchies;	///< Unused

	unsigned int nTotalDataSize;	///< Total size of the data excluding
									///< the header
};

//////////////////////////////////////////////////////////////////////////

//

//

//////////////////////////////////////////////////////////////////////////
/// \brief Transitional vertex format
/// \author Ivgeni Segal
/// \date January 20, 2007
///
/// transitional vertex format for use with exporters.
/// This structure is used by the mesh-building functions of the MDF 
/// format object. do not use for loading.
///
///
//////////////////////////////////////////////////////////////////////////
struct MdfFullVertex {
	float pos[3];

	float weights[3];
	unsigned char bones[4];

	float normal[3];
	float u, v;

	bool operator==(const MdfFullVertex &b) const {
		if(bones[0] != b.bones[0]){
			return false;
		}
		if(bones[1] != b.bones[1]){
			return false;
		}
		if(bones[2] != b.bones[2]){
			return false;
		}
		if(bones[3] != b.bones[3]){
			return false;
		}
		if(fabs(pos[0] - b.pos[0]) > MFDVERT_EPSILON) {
			return false;
		}
		if(fabs(pos[1] - b.pos[1]) > MFDVERT_EPSILON) {
			return false;
		}
		if(fabs(pos[2] - b.pos[2]) > MFDVERT_EPSILON) {
			return false;
		}
		if(fabs(weights[0] - b.weights[0]) > MFDVERT_EPSILON) {
			return false;
		}
		if(fabs(weights[1] - b.weights[1]) > MFDVERT_EPSILON) {
			return false;
		}
		if(fabs(weights[2] - b.weights[2]) > MFDVERT_EPSILON) {
			return false;
		}
		if(fabs(normal[0] - b.normal[0]) > MFDVERT_EPSILON) {
			return false;
		}
		if(fabs(normal[1] - b.normal[1]) > MFDVERT_EPSILON) {
			return false;
		}
		if(fabs(normal[2] - b.normal[2]) > MFDVERT_EPSILON) {
			return false;
		}
		if(fabs(u - b.u) > MFDVERT_EPSILON) {
			return false;
		}
		if(fabs(v - b.v) > MFDVERT_EPSILON) {
			return false;
		}

		return true;
	}

};

//////////////////////////////////////////////////////////////////////////
/// \brief Generic 4x4 matrix
/// \author Ivgeni Segal
/// \date January 20, 2007
///
/// Generic matrix used in the MDF format
///
/// \remarks MDF uses row-major matrices, if you need to use MDF in a
///			 column-major environment such as OpenGL don't forget to
///			 transpose them.
///
//////////////////////////////////////////////////////////////////////////
struct TMdfMatrix4
{
	float	e[16];
};

//////////////////////////////////////////////////////////////////////////
/// \brief Skinned vertex for animation
/// \author Ivgeni Segal
/// \date January 20, 2007
///
/// \remarks Skinned vertex is present in animated meshes and supports
///	up to four bones per vertex
///
//////////////////////////////////////////////////////////////////////////
struct TMdfVertSkn
{
	Float3 pos;
	float weights[3];
	unsigned char bones[4];

	Float3 normal;
	Float2 texcoord;
};

//////////////////////////////////////////////////////////////////////////
/// \brief Vertex for static meshes
/// \author Ivgeni Segal
/// \date January 20, 2007
///
/// \remarks All static geometry in MDF uses this vertex format,
///			 he UV coordinates are in DirectX form
///
//////////////////////////////////////////////////////////////////////////
struct TMdfVertSta
{
	Float3 pos;			///< Vertex position in model space

	Float3 normal;		///< Vertex normal
	Float2 texcoord;	///< UV Texture coordinate

	TMdfVertSta & operator=(const TMdfVertSkn &rhs) {
		pos.x = rhs.pos.x;
		pos.y = rhs.pos.y;
		pos.z = rhs.pos.z;

		normal.x = rhs.normal.x;
		normal.y = rhs.normal.y;
		normal.z = rhs.normal.z;

		texcoord.u = rhs.texcoord.u;
		texcoord.v = rhs.texcoord.v;
		return *this;
	}
};



//////////////////////////////////////////////////////////////////////////
/// \brief A single Mesh Object
/// \author Ivgeni Segal
/// \date January 20, 2007
///
/// \remarks The nDataOffset elements are the positions
/// relative to the beginning of the MDF file.
/// once the file is loaded they are converted into memory locations.
/// \par
/// The TMdfMesh Object contains all the information needed to display a mesh
/// In addition to vertex information, the Mesh Object stores optional
/// bind-pose matrix array for animation as well as parenting information
/// for the joints. All joints are stored in depth-first order of the joint hierarchy.
/// \par
/// Both of the arrays are parallel to the joint-keyframe
/// arrays in the the TMdfAnimation Object that corresponds to this mesh.
///
///
//////////////////////////////////////////////////////////////////////////
struct TMdfMesh
{
	unsigned int	nNumVerts;		///< Number of vertices in this mesh
	unsigned int	nNumIndices;	///< Number of vertex indexes
	unsigned int	nNumJoints;		///< Number of joints in stored bind
									///< pose and parenting arrays
	MdfHandle		hTexture;		///< Index of the texture name
	int meshType;					///< Mesh type (See MeshType enum)

	///
	/// Mesh vertex array
	///
	union UVerts_t {	// reference to the vertices
		void *pVertices;			///< Vertexes when in memory
		int nDataOffset;			///< Offset to vertexes when in file
	} uVtxs;

	///
	/// Mesh index array
	///
