    17	class MdfMemStream
    18		: public MdfStream
    19	{
    20	public:
    21		MdfMemStream(Byte *pData, int nDataLen) : pData(pData), nDataLen(nDataLen), nPos(0) {}
    22		virtual ~MdfMemStream() {}
    23	
    24		virtual bool Seek(int offset, int origin);
    25		virtual int Tell();
    26		virtual int Read(void *pDest, int nLength);
    27		virtual int Length();
