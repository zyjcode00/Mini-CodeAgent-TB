[80.181859, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_formal_testing_with_known_truth\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Test that formal testing outputs correct format as specified.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        app_dir = Path(\u001b[33m\"\u001b[39;49;00m\u001b[33m/app\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n"]
[80.182057, "o", "        \u001b[90m# Run the test function and check output format\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        test_code = \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33msource(\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mars.R\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m)\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m# Run the test function if it exists\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33mif (exists(\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mtest\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m)) \u001b[39;49;00m\u001b[33m{\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    test()\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m} else \u001b[39;49;00m\u001b[33m{\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    cat(\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mERROR: test function not found\u001b[39;49;00m\u001b[33m\\n\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m)\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m}\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        test_file = app_dir / \u001b[33m\"\u001b[39;49;00m\u001b[33mrun_test.R\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        test_file.write_text(test_code)\u001b[90m\u001b[39;49;00m\r\n"]
[80.182199, "o", "        \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n            result = subprocess.run(\u001b[90m\u001b[39;49;00m\r\n                [\u001b[33m\"\u001b[39;49;00m\u001b[33mRscript\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[96mstr\u001b[39;49;00m(test_file)],\u001b[90m\u001b[39;49;00m\r\n                capture_output=\u001b[94mTrue\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n                text=\u001b[94mTrue\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n                cwd=\u001b[96mstr\u001b[39;49;00m(app_dir),\u001b[90m\u001b[39;49;00m\r\n                timeout=\u001b[94m60\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            )\u001b[90m\u001b[39;49;00m\r\n            output = result.stdout + result.stderr\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n            \u001b[90m# Check for required output format: \"TEST_NAME: PASS\" or \"TEST_NAME: FAIL\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n>           \u001b[94massert\u001b[39;49;00m \u001b[33m\"\u001b[39;49;00m\u001b[33m: PASS\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m \u001b[95min\u001b[39;49;00m output \u001b[95mor\u001b[39;49;00m \u001b[33m\"\u001b[39;49;00m\u001b[33m: FAIL\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m \u001b[95min\u001b[39;49;00m output, (\u001b[90m\u001b[39;49;00m\r\n                \u001b[33m\"\u001b[39;49;00m\u001b[33mTest function must output results in format \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n                \u001b[33m\"\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33mTEST_NAME: PASS\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m or \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33mTEST_NAME: FAIL\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            )\u001b[90m\u001b[39;49;00m\r\n"]
[80.182395, "o", "\u001b[1m\u001b[31mE           AssertionError: Test function must output results in format 'TEST_NAME: PASS' or 'TEST_NAME: FAIL'\u001b[0m\r\n\u001b[1m\u001b[31mE           assert (': PASS' in 'Error in file(filename, \"r\", encoding = encoding) : \\n  cannot open the connection\\nCalls: source -> file\\nIn additio...ile(filename, \"r\", encoding = encoding) :\\n  cannot open file \\'ars.R\\': No such file or directory\\nExecution halted\\n' or ': FAIL' in 'Error in file(filename, \"r\", encoding = encoding) : \\n  cannot open the connection\\nCalls: source -> file\\nIn additio...ile(filename, \"r\", encoding = encoding) :\\n  cannot open file \\'ars.R\\': No such file or directory\\nExecution halted\\n')\u001b[0m\r\n\r\n\u001b[1m\u001b[31m/tests/test_outputs.py\u001b[0m:141: AssertionError\r\n"]
