[80.179854, "o", "\u001b[1m\u001b[31mE           assert 'PASS' in 'Error in file(filename, \"r\", encoding = encoding) : \\n  cannot open the connection\\nCalls: source -> file\\nIn additio...ile(filename, \"r\", encoding = encoding) :\\n  cannot open file \\'ars.R\\': No such file or directory\\nExecution halted\\n'\u001b[0m\r\n\r\n\u001b[1m\u001b[31m/tests/test_outputs.py\u001b[0m:81: AssertionError\r\n\u001b[31m\u001b[1m____________________________________________________________________ test_has_test_function ____________________________________________________________________\u001b[0m\r\n\r\n"]
[80.180501, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_has_test_function\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Test that a 'test' function exists as required by the task.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        app_dir = Path(\u001b[33m\"\u001b[39;49;00m\u001b[33m/app\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Check for test function in any R file\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n"]
[80.180596, "o", "        r_files = \u001b[96mlist\u001b[39;49;00m(app_dir.glob(\u001b[33m\"\u001b[39;49;00m\u001b[33m*.R\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m))\u001b[90m\u001b[39;49;00m\r\n        test_found = \u001b[94mFalse\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94mfor\u001b[39;49;00m r_file \u001b[95min\u001b[39;49;00m r_files:\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n                content = r_file.read_text()\u001b[90m\u001b[39;49;00m\r\n                test_pattern = \u001b[33mr\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mtest\u001b[39;49;00m\u001b[33m\\\u001b[39;49;00m\u001b[33ms*<-|test\u001b[39;49;00m\u001b[33m\\\u001b[39;49;00m\u001b[33ms*=\u001b[39;49;00m\u001b[33m\\\u001b[39;49;00m\u001b[33ms*function\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n                \u001b[94mif\u001b[39;49;00m re.search(test_pattern, content):\u001b[90m\u001b[39;49;00m\r\n                    test_found = \u001b[94mTrue\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n                    \u001b[94mbreak\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mexcept\u001b[39;49;00m \u001b[96mException\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n"]
[80.180792, "o", "                \u001b[94mcontinue\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n>       \u001b[94massert\u001b[39;49;00m test_found, (\u001b[90m\u001b[39;49;00m\r\n            \u001b[33m\"\u001b[39;49;00m\u001b[33mNo \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33mtest\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m function found. Task requires a function named \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33mtest\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            \u001b[33m\"\u001b[39;49;00m\u001b[33mthat carries out formal testing of the implementation.\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        )\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE       AssertionError: No 'test' function found. Task requires a function named 'test' that carries out formal testing of the implementation.\u001b[0m\r\n\u001b[1m\u001b[31mE       assert False\u001b[0m\r\n\r\n\u001b[1m\u001b[31m/tests/test_outputs.py\u001b[0m:107: AssertionError\r\n"]
