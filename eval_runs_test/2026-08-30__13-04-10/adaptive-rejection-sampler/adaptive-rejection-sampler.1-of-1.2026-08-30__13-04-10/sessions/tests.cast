[80.183167, "o", "\r\n        exp_file = app_dir / \u001b[33m\"\u001b[39;49;00m\u001b[33mexponential_samples.txt\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n>       \u001b[94massert\u001b[39;49;00m normal_file.exists() \u001b[95mor\u001b[39;49;00m exp_file.exists(), (\u001b[90m\u001b[39;49;00m\r\n            \u001b[33m\"\u001b[39;49;00m\u001b[33mAt least one sample file must be generated. Task requires generating \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33mnormal_samples.txt\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            \u001b[33m\"\u001b[39;49;00m\u001b[33mor \u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33mexponential_samples.txt\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m\u001b[33m containing test samples\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        )\u001b[90m\u001b[39;49;00m\r\n"]
[80.183499, "o", "\u001b[1m\u001b[31mE       AssertionError: At least one sample file must be generated. Task requires generating 'normal_samples.txt' or 'exponential_samples.txt' containing test samples\u001b[0m\r\n\u001b[1m\u001b[31mE       assert (False or False)\u001b[0m\r\n\u001b[1m\u001b[31mE        +  where False = exists()\u001b[0m\r\n\u001b[1m\u001b[31mE        +    where exists = PosixPath('/app/normal_samples.txt').exists\u001b[0m"]
