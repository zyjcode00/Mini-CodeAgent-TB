[80.190862, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_input_validation_functionality\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Test that implementation validates inputs.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        app_dir = Path(\u001b[33m\"\u001b[39;49;00m\u001b[33m/app\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Test invalid inputs\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        test_code = \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33msource(\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mars.R\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m)\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n"]
[80.191034, "o", "    \u001b[33m# Test 1: Negative number of samples\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33mtryCatch(\u001b[39;49;00m\u001b[33m{\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    ars(dnorm, c(-5, 5), n = -10)\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    cat(\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mERROR: Accepted negative sample count\u001b[39;49;00m\u001b[33m\\n\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m)\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m}, error = function(e) \u001b[39;49;00m\u001b[33m{\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    cat(\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mPASS: Rejected negative sample count\u001b[39;49;00m\u001b[33m\\n\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m)\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m})\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m# Test 2: Invalid domain\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33mtryCatch(\u001b[39;49;00m\u001b[33m{\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    ars(dnorm, c(5, -5), n = 100)\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    cat(\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mERROR: Accepted invalid domain\u001b[39;49;00m\u001b[33m\\n\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m)\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m}, error = function(e) \u001b[39;49;00m\u001b[33m{\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    cat(\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mPASS: Rejected invalid domain\u001b[39;49;00m\u001b[33m\\n\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m)\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m})\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        test_file = app_dir / \u001b[33m\"\u001b[39;49;00m\u001b[33mtest_validation.R\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        test_file.write_text(test_code)\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n            result = subprocess.run(\u001b[90m\u001b[39;49;00m\r\n                [\u001b[33m\"\u001b[39;49;00m\u001b[33mRscript\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[96mstr\u001b[39;49;00m(test_file)],\u001b[90m\u001b[39;49;00m\r\n                capture_output=\u001b[94mTrue\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n                text=\u001b[94mTrue\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n                cwd=\u001b[96mstr\u001b[39;49;00m(app_dir),\u001b[90m\u001b[39;49;00m\r\n                timeout=\u001b[94m15\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            )\u001b[90m\u001b[39;49;00m\r\n            output = result.stdout + result.stderr\u001b[90m\u001b[39;49;00m\r\n>           \u001b[94massert\u001b[39;49;00m output.count(\u001b[33m\"\u001b[39;49;00m\u001b[33mPASS\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m) >= \u001b[94m1\u001b[39;49;00m, (\u001b[90m\u001b[39;49;00m\r\n                \u001b[33m\"\u001b[39;49;00m\u001b[33mImplementation must validate inputs (negative samples, invalid domains)\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            )\u001b[90m\u001b[39;49;00m\r\n"]
[80.191318, "o", "\u001b[1m\u001b[31mE           AssertionError: Implementation must validate inputs (negative samples, invalid domains)\u001b[0m\r\n\u001b[1m\u001b[31mE           assert 0 >= 1\u001b[0m\r\n\u001b[1m\u001b[31mE            +  where 0 = <built-in method count of str object at 0x76521dafad50>('PASS')\u001b[0m\r\n\u001b[1m\u001b[31mE            +    where <built-in method count of str object at 0x76521dafad50> = 'Error in file(filename, \"r\", encoding = encoding) : \\n  cannot open the connection\\nCalls: source -> file\\nIn additio...ile(filename, \"r\", encoding = encoding) :\\n  cannot open file \\'ars.R\\': No such file or directory\\nExecution halted\\n'.count\u001b[0m\r\n\r\n\u001b[1m\u001b[31m/tests/test_outputs.py\u001b[0m:260: AssertionError\r\n"]
[80.191558, "o", "\u001b[31m\u001b[1m_______________________________________________________________ test_log_concavity_functionality _______________________________________________________________\u001b[0m\r\n\r\n"]
[80.192266, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_log_concavity_functionality\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Test that implementation checks log-concavity.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        app_dir = Path(\u001b[33m\"\u001b[39;49;00m\u001b[33m/app\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# Test with a non-log-concave distribution\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        test_code = \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n"]
[80.192428, "o", "    \u001b[33msource(\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mars.R\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m)\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m# Bimodal distribution (NOT log-concave)\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33mbimodal_density <- function(x) \u001b[39;49;00m\u001b[33m{\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    0.5 * dnorm(x, mean = -2, sd = 1) + 0.5 * dnorm(x, mean = 2, sd = 1)\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m}\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m\u001b[39;49;00m\r\n    \u001b[33m# Try to use ARS with non-log-concave distribution\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33mtryCatch(\u001b[39;49;00m\u001b[33m{\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    samples <- ars(bimodal_density, c(-10, 10), n = 100)\u001b[39;49;00m\u001b[33m\u001b[39;49;00m"]
[80.192629, "o", "\r\n    \u001b[33m    cat(\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mERROR: Accepted non-log-concave distribution\u001b[39;49;00m\u001b[33m\\n\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m)\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m}, error = function(e) \u001b[39;49;00m\u001b[33m{\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m    cat(\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mPASS: Correctly rejected non-log-concave distribution\u001b[39;49;00m\u001b[33m\\n\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m)\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m})\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\r\n    \u001b[33m\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        test_file = app_dir / \u001b[33m\"\u001b[39;49;00m\u001b[33mtest_logconcave.R\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        test_file.write_text(test_code)\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n            result = subprocess.run(\u001b[90m\u001b[39;49;00m\r\n                [\u001b[33m\"\u001b[39;49;00m\u001b[33mRscript\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[96mstr\u001b[39;49;00m(test_file)],\u001b[90m\u001b[39;49;00m\r\n                capture_output=\u001b[94mTrue\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n                text=\u001b[94mTrue\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n                cwd=\u001b[96mstr\u001b[39;49;00m(app_dir),\u001b[90m\u001b[39;49;00m\r\n                timeout=\u001b[94m15\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\r\n            )\u001b[90m\u001b[39;49;00m\r\n            output = result.stdout + result.stderr\u001b[90m\u001b[39;49;00m\r\n"]
[80.192763, "o", "            \u001b[90m# Implementation should either reject or at least handle non-log-concave\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n>           \u001b[94massert\u001b[39;49;00m \u001b[33m\"\u001b[39;49;00m\u001b[33mPASS\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m \u001b[95min\u001b[39;49;00m output \u001b[95mor\u001b[39;49;00m \u001b[33m\"\u001b[39;49;00m\u001b[33mconcave\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m \u001b[95min\u001b[39;49;00m output.lower(), (\u001b[90m\u001b[39;49;00m\r\n                \u001b[33m\"\u001b[39;49;00m\u001b[33mImplementation should check for log-concavity\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            )\u001b[90m\u001b[39;49;00m\r\n\u001b[1m\u001b[31mE           AssertionError: Implementation should check for log-concavity\u001b[0m\r\n\u001b[1m\u001b[31mE           assert ('PASS' in 'Error in file(filename, \"r\", encoding = encoding) : \\n  cannot open the connection\\nCalls: source -> file\\nIn additio...ile(filename, \"r\", encoding = encoding) :\\n  cannot open file \\'ars.R\\': No such file or directory\\nExecution halted\\n' or 'concave' in 'error in file(filename, \"r\", encoding = encoding) : \\n  cannot open the connection\\ncalls: source -> file\\nin additio...ile(filename, \"r\", encoding = encoding) :\\n  cannot open file \\'ars.r\\': no such file or directory\\nexecution halted\\n')\u001b[0m\r\n\u001b[1m\u001b[31mE            +  where 'error in file(filename, \"r\", encoding = encoding) : \\n  cannot open the connection\\ncalls: source -> file\\nin additio...ile(filename, \"r\", encoding = encoding) :\\n  cannot open file \\'ars.r\\': no such file or directory\\nexecution halted\\n' = <built-in method lower of str object at 0x76521ad93930>()\u001b[0m\r\n\u001b[1m\u001b[31mE            +    where <built-in method lower of str object at 0x76521ad93930> = 'Error in file(filename, \"r\", encoding = encoding) : \\n  cannot open the connection\\nCalls: source -> file\\nIn additio...ile(filename, \"r\", encoding = encoding) :\\n  cannot open file \\'ars.R\\': No such file or directory\\nExecution halted\\n'.lower\u001b[0m\r\n"]
