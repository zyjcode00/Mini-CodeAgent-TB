[244.989669, "o", "if [ -f /app/generate_bn.R ]; then cat -- /app/generate_bn.R; else echo '错误: 找不到文件 /app/generate_bn.R'; fi\r\n\u001b[?2004l\r"]
[244.991631, "o", "set.seed(20260830)\r\ndata <- read.csv('/app/bn_sample_10k.csv', check.names=FALSE)\r\nvars <- names(data)\r\nif (!identical(vars, c('U','Y','R','D','M'))) stop('Unexpected input columns')\r\n\r\n# Maximum-likelihood Gaussian conditional regressions for the recovered DAG.\r\nfit <- function(child, parents) {\r\n  formula <- if (length(parents)) reformulate(parents, response=child) else as.formula(paste(child, '~ 1'))\r\n  lm(formula, data=data)\r\n}\r\nmodels <- list(\r\n  U=fit('U', character()),\r\n  Y=fit('Y', 'U'),\r\n  R=fit('R', 'U'),\r\n  D=fit('D', c('U','Y')),\r\n  M=fit('M', c('U','R'))\r\n)\r\npredict_node <- function(model, newdata) as.numeric(predict(model, newdata=newdata)) + rnorm(nrow(newdata), 0, sigma(model))\r\n\r\nedges <- data.frame(to=c('Y','R','D','M','D','M'), from=c('U','U','U','U','Y','R'))\r\nwrite.csv(edges, '/app/learned_dag.csv', row.names=FALSE, quote=FALSE)\r\nintervened_edges <- edges[edges$to != 'Y', , drop=FALSE]\r\nwrite.csv(intervened_edges, '/app/intervened_dag.csv', row.names=FALSE, quote=FALSE)\r\n\r\n# Truncated factorization under do(Y=0): Y is fixed, so its incoming edge is removed.\r\nout <- data.frame(\r\n  U=predict_node(models$U, data.frame()),\r\n  Y=0.0\r\n)\r\nout$R <- predict_node(models$R, out)\r\nout$D <- predict_node(models$D, out)\r\nout$M <- predict_node(models$M, out)\r\nout <- out[, vars]\r\nwrite.csv(out, '/app/final_bn_sample.csv', row.names=FALSE, quote=FALSE)\r\nRS\r\nRscript /app/generate_bn.R\r\nls -l /app/learned_dag.csv /app/intervened_dag.csv /app/final_bn_sample.csv"]
[244.991875, "o", "\u001b[?2004hroot@920f79a41845:/app# "]
[244.991964, "o", "true; tmux wait -S done\r\n\u001b[?2004l\r"]
[244.996318, "o", "\u001b[?2004hroot@920f79a41845:/app# "]
[263.248393, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/generate_bn.R <<'PY'\nimport sys\npath = sys.argv[1]\nold_str = \"predict_node <- function(model, newdata) as.numeric(predict(model, newdata=newdata)) + rnorm(nrow(newdata), 0, sigma(model))\\n\\nedges <- data.frame(to=c('Y','R','D','M','D','M'), from=c('U','U','U','U','Y','R'))\"\nnew_str = \"n_samples <- 10000\\npredict_node <- function(model, newdata) {\\n  values <- as.numeric(predict(model, newdata=newdata))\\n  values + rnorm(nrow(newdata), 0, sigma(model))\\n}\\n\\nedges <- data.frame(to=c('Y','R','D','M','D','M'), from=c('U','U','U','U','Y','R'))\"\n\ndef normalize_text(text: str) -> str:\n    text = text.replace('\\r\\n', '\\n').replace('\\r', '\\n')\n    return '\\n'.join(line.rstrip() for line in text.split('\\n'))\n\ntry:\n    with open(path, 'r', encoding='utf-8', errors='replace') as f:\n        content = f.read()\nexcept FileNotFoundError:\n    print(f\"错误: 找不到文件 {path}\")\n    raise SystemExit(0)\nexcept Exception as exc:\n    print(f\"修改失败: {exc}\")\n    raise SystemExit(0)\n\ncontent = normalize_text(content)\nold_str = normalize_text(old_str)\nnew_str = normalize_text(new_str)\ncount = content.count(old_str)\nif count == 0:\n    print(\"错误: 在文件中找不到 old_str。\\n建议：\\n1. 使用 read_file(raw_mode=True) 获取原始内容\\n2. 检查是否有多余的空格或换行符\\n3. 如果文件较大，考虑使用 write_full_file 全量覆盖\")\n    raise SystemExit(0)\nif count > 1:\n    print(f\"错误: 匹配到 {count} 处相同的代码，请提供更具体的 old_str 以确保唯一性。\")\n    raise SystemExit(0)\nwith open(path, 'w', encoding='utf-8', newline='\\n') as f:\n    f.write(content.replace(old_str, new_str))\nprint(f\"成功: 已更新 {path}。修改已持久化。\")\nPY\ntrue; tmux wait -S done\r"]
[263.248866, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
[263.249194, "o", "\u001b[?2004hroot@920f79a41845:/app# "]
[263.249466, "o", "python3 - /app/generate_bn.R <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r"]
