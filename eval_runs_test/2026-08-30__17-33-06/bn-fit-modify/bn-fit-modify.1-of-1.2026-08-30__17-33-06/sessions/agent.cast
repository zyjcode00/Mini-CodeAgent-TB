[263.251769, "o", "new_str = \"n_samples <- 10000\\npredict_node <- function(model, newdata) {\\n  values <- as.numeric(predict(model, newdata=newdata))\\n  values + rnorm(nrow(newdata), 0, sigma(model))\\n}\\n\\nedges <- data.frame(to=c('Y','R','D','M','D','M'), from=c('U','U','U','U','Y','R'))\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.252259, "o", "def normalize_text(text: str) -> str:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.252634, "o", "    text = text.replace('\\r\\n', '\\n').replace('\\r', '\\n')\r\n\u001b[?2004l\r\u001b[?2004h> "]
