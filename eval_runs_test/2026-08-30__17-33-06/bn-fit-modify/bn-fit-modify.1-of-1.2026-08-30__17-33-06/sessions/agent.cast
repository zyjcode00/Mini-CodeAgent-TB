[180.061467, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\ncat > /tmp/infer_bn.R <<'RS'\nx <- read.csv('/app/bn_sample_10k.csv'); vars <- names(x); n <- nrow(x); p <- length(vars)\n# Allowed directed edges: U cannot have parents.\npairs <- list();\nfor (i in 1:p) for (j in 1:p) if (i != j && j != 1) pairs[[length(pairs)+1]] <- c(i,j) # from i to j\nm <- length(pairs); best <- list(score=-Inf); count <- 0\nacyclic <- function(edges) {\n  adj <- matrix(FALSE,p,p)\n  if (length(edges)) for (e in edges) adj[e[1],e[2]] <- TRUE\n  state <- integer(p)\n  dfs <- function(v) { state[v] <<- 1; z <- which(adj[v,]); for (w in z) { if(state[w]==1) return(FALSE); if(state[w]==0 && !dfs(w)) return(FALSE) }; state[v] <<- 2; TRUE }\n  for(v in 1:p) if(state[v]==0 && !dfs(v)) return(FALSE); TRUE\n}\nlocal <- function(child, pars) {\n  y <- x[[child]]\n  if (!length(pars)) rss <- sum((y-mean(y))^2) else rss <- sum(lm(y ~ ., data=x[c(pars)])$residuals^2)\n  k <- length(pars)+2\n  -n/2*(log(2*pi)+1+log(rss/n)) - .5*k*log(n)\n}\n# recurse combinations of 6 edges\nchoose6 <- function(start, picked) {\n  left <- 6-length(picked); if (left==0) {\n    if(!acyclic(picked)) return()\n    count <<- count+1; pars <- vector('list',p); for(i in 1:p) pars[[i]] <- integer()\n    for(e in picked) pars[[e[2]]] <- c(pars[[e[2]]],e[1])\n    sc <- sum(sapply(1:p,function(j)local(j,pars[[j]])))\n    if(sc > best$score) best <<- list(score=sc, edges=picked, pars=pars)\n    return()\n  }\n  if(m-start+1 < left) return()\n  for(i in start:(m-left+1)) choose6(i+1,c(picked,list(pairs[[i]])))\n}\nchoose6(1,list()); cat('candidates',count,'best',best$score,'\\n')\nfor(e in best$edges) cat(vars[e[2]],',',vars[e[1]],'\\n',sep='')\ncat('parents\\n'); for(j in 1:p) cat(vars[j],':',paste(vars[best$pars[[j]]],collapse=','),'\\n')\nRS\nRscript /tmp/infer_bn.R\ntrue; tmux wait -S done\r"]
