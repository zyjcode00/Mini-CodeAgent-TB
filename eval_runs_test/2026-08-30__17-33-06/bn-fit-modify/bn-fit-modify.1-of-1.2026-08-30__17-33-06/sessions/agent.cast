[283.112512, "o", "content = \"set.seed(20260830)\\ndata <- read.csv('/app/bn_sample_10k.csv', check.names=FALSE)\\nvars <- names(data)\\nif (!identical(vars, c('U','Y','R','D','M'))) stop('Unexpected input columns')\\nn_samples <- 10000\\n\\n# Fit one Gaussian conditional distribution for each node in the recovered DAG.\\nfit <- function(child, parents) {\\n  formula <- if (length(parents)) reformulate(parents, response=child) else as.formula(paste(child, '~ 1'))\\n  lm(formula, data=data)\\n}\\nmodels <- list(\\n  U=fit('U', character()),\\n  Y=fit('Y', 'U'),\\n  R=fit('R', 'U'),\\n  D=fit('D', c('U','Y')),\\n  M=fit('M', c('U','R'))\\n)\\npredict_node <- function(model, newdata) {\\n  as.numeric(predict(model, newdata=newdata)) + rnorm(nrow(newdata), 0, sigma(model))\\n}\\n\\nedges <- data.frame(\\n  to=c('Y','R','D','M','D','M'),\\n  from=c('U','U','U','U','Y','R')\\n)\\nwrite.csv(edges, '/app/learned_dag.csv', row.names=FALSE, quote=FALSE)\\n\\n# Under do(Y=0), remove the incoming edge to Y and retain all other factors.\\nintervened_edges <- edges[edges$to != 'Y', , drop=FALSE]\\nwrite.csv(intervened_edges, '/app/intervened_dag.csv', row.names=FALSE, quote=FALSE)\\n\\n# Generate in topological order using the truncated factorization.\\nout <- data.frame(U=rnorm(n_samples, coef(models$U)[1], sigma(models$U)))\\nout$Y <- 0.0\\nout$R <- predict_node(models$R, out)\\nout$D <- predict_node(models$D, out)\\nout$M <- predict_node(models$M, out)\\nout <- out[, vars]\\nwrite.csv(out, '/app/final_bn_sample.csv', row.names=FALSE, quote=FALSE)\\n\"\r\n\u001b[?2004l\r"]
