[117.905415, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\nawk -F, 'NR==1{next} NR==2{for(i=1;i<=NF;i++){gsub(/\"/,\"\",$i); x[i]=$i}; next} {for(i=1;i<=NF;i++){gsub(/\"/,\"\",$i); s[i]+=$i; ss[i]+=$i*$i}; for(i=1;i<=NF;i++)for(j=i+1;j<=NF;j++){c[i,j]+=$i*$j}} END{n=NR-1; for(i=1;i<=5;i++)m[i]=s[i]/n; for(i=1;i<=5;i++){printf \"%s mean %.5f sd %.5f\\n\", \"UYRDM\"\\,i,m[i],sqrt((ss[i]-n*m[i]*m[i])/(n-1))}; print \"CORR\"; for(i=1;i<=5;i++){for(j=i+1;j<=5;j++){cov=(c[i,j]-n*m[i]*m[j])/(n-1); sd1=sqrt((ss[i]-n*m[i]*m[i])/(n-1));sd2=sqrt((ss[j]-n*m[j]*m[j])/(n-1)); printf \"%s-%s %.5f\\n\",substr(\"UYRDM\",i,1),substr(\"UYRDM\",j,1),cov/sd1/sd2}}}' /app/bn_sample_10k.csv\ntrue; tmux wait -S done\r"]
[117.906057, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
[117.906286, "o", "\u001b[?2004hroot@920f79a41845:/app# "]
[117.908706, "o", "awk -F, 'NR==1{next} NR==2{for(i=1;i<=NF;i++){gsub(/\"/,\"\",$i); x[i]=$i}; next} {for(i=1;i<=NF;i++){gsub(/\"/,\"\",$i); s[i]+=$i; ss[i]+=$i*$i}; for(i=1;i<=NF;i++)for(j=i+1;j<=NF;j++){c[i,j]+=$i*$j}} END{n=NR-1; for(i=1;i<=5;i++)m[i]=s[i]/n; for(i=1;i<=5;i++){printf \"%s mean %.5f sd %.5f\\n\", \"UYRDM\"\\,i,m[i],sqrt((ss[i]-n*m[i]*m[i])/(n-1))}; print \"CORR\"; for(i=1;i<=5;i++){for(j=i+1;j<=5;j++){cov=(c[i,j]-n*m[i]*m[j])/(n-1); sd1=sqrt((ss[i]-n*m[i]*m[i])/(n-1));sd2=sqrt((ss[j]-n*m[j]*m[j])/(n-1)); printf \"%s-%s %.5f\\n\",substr(\"UYRDM\",i,1),substr(\"UYRDM\",j,1),cov/sd1/sd2}}}' /app/bn_sample_10k.csv\r\n\u001b[?2004l\r"]
