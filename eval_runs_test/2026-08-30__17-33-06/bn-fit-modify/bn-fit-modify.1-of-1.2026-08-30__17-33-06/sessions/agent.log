[?2004l[?2004h> content = "read_edges <- function(path) read.csv(path, check.names=FALSE, stringsAsFactors=FALSE)\nedge_key <- function(e) paste(e$from, e$to, sep='->')\n\nlearned <- read_edges('/app/learned_dag.csv')\nstopifnot(nrow(learned) == 6, identical(names(learned), c('to','from')))\nstopifnot(!any(learned$to == 'U'))\nstopifnot(length(unique(edge_key(learned))) == 6)\n\n# A small DFS cycle check for the five-node graph.\nvertices <- c('U','Y','R','D','M')\nadj <- lapply(vertices, function(v) learned$to[learned$from == v])\nnames(adj) <- vertices\nstate <- setNames(integer(length(vertices)), vertices)\nvisit <- function(v) {\n  state[v] <<- 1\n  for (w in adj[[v]]) {\n    stopifnot(state[w] != 1)\n    if (state[w] == 0) visit(w)\n  }\n  state[v] <<- 2\n}\nfor (v in vertices) if (state[v] == 0) visit(v)\n\nintervened <- read_edges('/app/intervened_dag.csv')\nstopifnot(nrow(intervened) == 5)\nstopifnot(setequal(edge_key(intervened), setdiff(edge_key(learned), 'U->Y')))\n\nsample <- read.csv('/app/final_bn_sample.csv', check.names=FALSE)\nstopifnot(nrow(sample) == 10000, identical(names(sample), vertices))\nstopifnot(all(sample$Y == 0), all(is.finite(as.matrix(sample))))\nstopifnot(sd(sample$U) > 0, sd(sample$R) > 0, sd(sample$D) > 0, sd(sample$M) > 0)\ncat('All Bayesian Network output checks passed\\n')\n"
