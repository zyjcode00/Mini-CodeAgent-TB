[?2004lset.seed(20260830)
data <- read.csv('/app/bn_sample_10k.csv', check.names=FALSE)
vars <- names(data)
if (!identical(vars, c('U','Y','R','D','M'))) stop('Unexpected input columns')

# Maximum-likelihood Gaussian conditional regressions for the recovered DAG.
fit <- function(child, parents) {
  formula <- if (length(parents)) reformulate(parents, response=child) else as.formula(paste(child, '~ 1'))
  lm(formula, data=data)
}
models <- list(
  U=fit('U', character()),
  Y=fit('Y', 'U'),
  R=fit('R', 'U'),
  D=fit('D', c('U','Y')),
  M=fit('M', c('U','R'))
)
predict_node <- function(model, newdata) as.numeric(predict(model, newdata=newdata)) + rnorm(nrow(newdata), 0, sigma(model))

edges <- data.frame(to=c('Y','R','D','M','D','M'), from=c('U','U','U','U','Y','R'))
write.csv(edges, '/app/learned_dag.csv', row.names=FALSE, quote=FALSE)
intervened_edges <- edges[edges$to != 'Y', , drop=FALSE]
write.csv(intervened_edges, '/app/intervened_dag.csv', row.names=FALSE, quote=FALSE)

# Truncated factorization under do(Y=0): Y is fixed, so its incoming edge is removed.
out <- data.frame(
  U=predict_node(models$U, data.frame()),
  Y=0.0
)
out$R <- predict_node(models$R, out)
out$D <- predict_node(models$D, out)
out$M <- predict_node(models$M, out)
out <- out[, vars]
write.csv(out, '/app/final_bn_sample.csv', row.names=FALSE, quote=FALSE)
RS
Rscript /app/generate_bn.R
