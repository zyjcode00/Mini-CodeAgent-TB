[565.742123, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 -m unittest /app/test_bn_outputs.py && python3 - <<'PY'\nimport csv\nfrom pathlib import Path\nfor name in ['learned_dag.csv','intervened_dag.csv','final_bn_sample.csv']:\n    p=Path('/app')/name\n    with p.open(newline='') as f:\n        rows=list(csv.reader(f))\n    print(name, 'rows including header=', len(rows), 'header=', rows[0])\n    print('first data=', rows[1] if len(rows)>1 else None)\nPY\ntrue; tmux wait -S done\r"]
