[549.650851, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/test_bn_outputs.py <<'PY'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = \"import csv\\nfrom pathlib import Path\\n\\nBASE = Path('/app')\\nEXPECTED_COLS = ['U', 'Y', 'R', 'D', 'M']\\nEXPECTED_EDGES = {\\n    ('Y', 'U'),\\n    ('R', 'U'),\\n    ('D', 'U'),\\n    ('D', 'Y'),\\n    ('M', 'U'),\\n    ('M', 'R'),\\n}\\n\\n\\ndef read_edges(path):\\n    with path.open(newline='') as f:\\n        rows = list(csv.DictReader(f))\\n    assert set(rows[0]) == {'to', 'from'}\\n    return {(row['to'], row['from']) for row in rows}\\n\\n\\ndef test_learned_dag():\\n    edges = read_edges(BASE / 'learned_dag.csv')\\n    assert len(edges) == 6\\n    assert edges == EXPECTED_EDGES\\n\\n    # Every edge must point from an earlier node in this topological order.\\n    order = {'U': 0, 'Y': 1, 'R': 2, 'D': 3, 'M': 4}\\n    assert all(order[parent] < order[child] for child, parent in edges)\\n\\n\\ndef test_intervened_dag():\\n    edges = read_edges(BASE / 'intervened_dag.csv')\\n    assert edges == EXPECTED_EDGES - {('Y', 'U')}\\n    assert all(child != 'Y' for child, _ in edges)\\n\\n\\ndef test_final_sample():\\n    with (BASE / 'final_bn_sample.csv').open(newline='') as f:\\n        reader = csv.DictReader(f)\\n        assert reader.fieldnames == EXPECTED_COLS\\n        rows = list(reader)\\n    assert len(rows) == 10000\\n    assert all(float(row['Y']) == 0.0 for row in rows)\\n    for row in rows:\\n        for col in EXPECTED_COLS:\\n            float(row[col])\\n\"\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, 'w', encoding='utf-8', newline='\\n') as f:\n        f.write(content)\n    print(f\"成功: 已写入 {path}\")\nexcept Exception as exc:\n    print(f\"写入失败: {exc}\")\nPY\ntrue; tmux wait -S done\r"]
[549.651469, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
[549.651685, "o", "\u001b[?2004hroot@687782a4c840:/app# "]
[549.651929, "o", "python3 - /app/test_bn_outputs.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r"]
[549.652078, "o", "\u001b[?2004h> path = sys.argv[1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[549.656074, "o", "content = \"import csv\\nfrom pathlib import Path\\n\\nBASE = Path('/app')\\nEXPECTED_COLS = ['U', 'Y', 'R', 'D', 'M']\\nEXPECTED_EDGES = {\\n    ('Y', 'U'),\\n    ('R', 'U'),\\n    ('D', 'U'),\\n    ('D', 'Y'),\\n    ('M', 'U'),\\n    ('M', 'R'),\\n}\\n\\n\\ndef read_edges(path):\\n    with path.open(newline='') as f:\\n        rows = list(csv.DictReader(f))\\n    assert set(rows[0]) == {'to', 'from'}\\n    return {(row['to'], row['from']) for row in rows}\\n\\n\\ndef test_learned_dag():\\n    edges = read_edges(BASE / 'learned_dag.csv')\\n    assert len(edges) == 6\\n    assert edges == EXPECTED_EDGES\\n\\n    # Every edge must point from an earlier node in this topological order.\\n    order = {'U': 0, 'Y': 1, 'R': 2, 'D': 3, 'M': 4}\\n    assert all(order[parent] < order[child] for child, parent in edges)\\n\\n\\ndef test_intervened_dag():\\n    edges = read_edges(BASE / 'intervened_dag.csv')\\n    assert edges == EXPECTED_EDGES - {('Y', 'U')}\\n    assert all(child != 'Y' for child, _ in edges)\\n\\n\\ndef test_final_sample():\\n    with (BASE / 'final_bn_sample.csv').open(newline='') as f:\\n        reader = csv.DictReader(f)\\n        assert reader.fieldnames == EXPECTED_COLS\\n        rows = list(reader)\\n    assert len(rows) == 10000\\n    assert all(float(row['Y']) == 0.0 for row in rows)\\n    for row in rows:\\n        for col in EXPECTED_COLS:\\n            float(row[col])\\n\"\r\n\u001b[?2004l\r"]
[549.656179, "o", "\u001b[?2004h> dir_path = os.path.dirname(path)\r\n\u001b[?2004l\r"]
[549.6565, "o", "\u001b[?2004h> "]
[549.656801, "o", "if dir_path:\r\n\u001b[?2004l\r\u001b[?2004h>     os.makedirs(dir_path, exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h> try:\r\n\u001b[?2004l\r"]
[549.657026, "o", "\u001b[?2004h>     with open(path, 'w', encoding='utf-8', newline='\\n') as f:\r\n\u001b[?2004l\r"]
[549.657213, "o", "\u001b[?2004h>         f.write(content)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[549.65736, "o", "    print(f\"成功: 已写入 {path}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[549.657492, "o", "> "]
[549.657566, "o", "except Exception as exc:\r\n\u001b[?2004l\r"]
[549.657718, "o", "\u001b[?2004h> "]
[549.657878, "o", "    print(f\"写入失败: {exc}\")\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
