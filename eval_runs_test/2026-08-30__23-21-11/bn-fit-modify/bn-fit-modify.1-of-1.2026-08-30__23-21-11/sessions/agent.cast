[593.870583, "o", "if [ -f /app/test_bn_outputs.py ]; then cat -- /app/test_bn_outputs.py; else echo '错误: 找不到文件 /app/test_bn_outputs.py'; fi\r\n\u001b[?2004l\r"]
[593.873291, "o", "import csv\r\nimport unittest\r\nfrom pathlib import Path\r\n\r\nBASE = Path('/app')\r\nEXPECTED_COLS = ['U', 'Y', 'R', 'D', 'M']\r\nEXPECTED_EDGES = {\r\n    ('Y', 'U'),\r\n    ('R', 'U'),\r\n    ('D', 'U'),\r\n    ('D', 'Y'),\r\n    ('M', 'U'),\r\n    ('M', 'R'),\r\n}\r\n\r\n\r\ndef read_edges(path):\r\n    with path.open(newline='') as f:\r\n        rows = list(csv.DictReader(f))\r\n    assert set(rows[0]) == {'to', 'from'}\r\n    return {(row['to'], row['from']) for row in rows}\r\n\r\n\r\ndef test_learned_dag():\r\n    edges = read_edges(BASE / 'learned_dag.csv')\r\n    assert len(edges) == 6\r\n    assert edges == EXPECTED_EDGES\r\n\r\n    # Every edge must point from an earlier node in this topological order.\r\n    order = {'U': 0, 'Y': 1, 'R': 2, 'D': 3, 'M': 4}\r\n    assert all(order[parent] < order[child] for child, parent in edges)\r\n\r\n\r\ndef test_intervened_dag():\r\n    edges = read_edges(BASE / 'intervened_dag.csv')\r\n    assert edges == EXPECTED_EDGES - {('Y', 'U')}\r\n    assert all(child != 'Y' for child, _ in edges)\r\n\r\n\r\ndef test_final_sample():\r\n    with (BASE / 'final_bn_sample.csv').open(newline='') as f:\r\n        reader = csv.DictReader(f)\r\n        assert reader.fieldnames == EXPECTED_COLS\r\n        rows = list(reader)\r\n    assert len(rows) == 10000\r\n    assert all(float(row['Y']) == 0.0 for row in rows)\r\n    for row in rows:\r\n        for col in EXPECTED_COLS:\r\n            float(row[col])\r\n"]
[593.873626, "o", "\u001b[?2004hroot@687782a4c840:/app# "]
[593.873817, "o", "true; tmux wait -S done\r\n\u001b[?2004l\r"]
[593.881434, "o", "\u001b[?2004hroot@687782a4c840:/app# "]
[617.532279, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/test_bn_outputs.py <<'PY'\nimport sys\npath = sys.argv[1]\nold_str = \"def test_learned_dag():\\n    edges = read_edges(BASE / 'learned_dag.csv')\\n    assert len(edges) == 6\\n    assert edges == EXPECTED_EDGES\\n\\n    # Every edge must point from an earlier node in this topological order.\\n    order = {'U': 0, 'Y': 1, 'R': 2, 'D': 3, 'M': 4}\\n    assert all(order[parent] < order[child] for child, parent in edges)\\n\\n\\ndef test_intervened_dag():\\n    edges = read_edges(BASE / 'intervened_dag.csv')\\n    assert edges == EXPECTED_EDGES - {('Y', 'U')}\\n    assert all(child != 'Y' for child, _ in edges)\\n\\n\\ndef test_final_sample():\\n    with (BASE / 'final_bn_sample.csv').open(newline='') as f:\\n        reader = csv.DictReader(f)\\n        assert reader.fieldnames == EXPECTED_COLS\\n        rows = list(reader)\\n    assert len(rows) == 10000\\n    assert all(float(row['Y']) == 0.0 for row in rows)\\n    for row in rows:\\n        for col in EXPECTED_COLS:\\n            float(row[col])\\n\"\nnew_str = \"class BayesianNetworkOutputTests(unittest.TestCase):\\n    def test_learned_dag(self):\\n        edges = read_edges(BASE / 'learned_dag.csv')\\n        self.assertEqual(len(edges), 6)\\n        self.assertEqual(edges, EXPECTED_EDGES)\\n\\n        # Every edge must point from an earlier node in this topological order.\\n        order = {'U': 0, 'Y': 1, 'R': 2, 'D': 3, 'M': 4}\\n        self.assertTrue(all(order[parent] < order[child] for child, parent in edges))\\n\\n    def test_intervened_dag(self):\\n        edges = read_edges(BASE / 'intervened_dag.csv')\\n        self.assertEqual(edges, EXPECTED_EDGES - {('Y', 'U')})\\n        self.assertTrue(all(child != 'Y' for child, _ in edges))\\n\\n    def test_final_sample(self):\\n        with (BASE / 'final_bn_sample.csv').open(newline='') as f:\\n            reader = csv.DictReader(f)\\n            self.assertEqual(reader.fieldnames, EXPECTED_COLS)\\n            rows = list(reader)\\n        self.assertEqual(len(rows), 10000)\\n        self.assertTrue(all(float(row['Y']) == 0.0 for row in rows))\\n        for row in rows:\\n            for col in EXPECTED_COLS:\\n                float(row[col])\\n\\n\\nif __name__ == '__main__':\\n    unittest.main()\\n\"\n\ndef normalize_text(text: str) -> str:\n    text = text.replace('\\r\\n', '\\n').replace('\\r', '\\n')\n    return '\\n'.join(line.rstrip() for line in text.split('\\n'))\n\ntry:\n    with open(path, 'r', encoding='utf-8', errors='replace') as f:\n        content = f.read()\nexcept FileNotFoundError:\n    print(f\"错误: 找不到文件 {path}\")\n    raise SystemExit(0)\nexcept Exception as exc:\n    print(f\"修改失败: {exc}\")\n    raise SystemExit(0)\n\ncontent = normalize_text(content)\nold_str = normalize_text(old_str)\nnew_str = normalize_text(new_str)\ncount = content.count(old_str)\nif count == 0:\n    print(\"错误: 在文件中找不到 old_str。\\n建议：\\n1. 使用 read_file(raw_mode=True) 获取原始内容\\n2. 检查是否有多余的空格或换行符\\n3. 如果文件较大，考虑使用 write_full_file 全量覆盖\")\n    raise SystemExit(0)\nif count > 1:\n    print(f\"错误: 匹配到 {count} 处相同的代码，请提供更具体的 old_str 以确保唯一性。\")\n    raise SystemExit(0)\nwith open(path, 'w', encoding='utf-8', newline='\\n') as f:\n    f.write(content.replace(old_str, new_str))\nprint(f\"成功: 已更新 {path}。修改已持久化。\")\nPY\ntrue; tmux wait -S done\r"]
