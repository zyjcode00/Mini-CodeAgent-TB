[41.936573, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython - <<'PY'\nimport pandas as pd\nimport itertools, numpy as np\nfrom scipy.stats import pearsonr\n\ndf = pd.read_csv('/app/bn_sample_10k.csv')\nprint(df.head())\nprint(df.describe())\nprint('corr\\n', df.corr())\n# pairwise correlations and maybe linear regressions R2\ncols=df.columns\nfor a,b in itertools.combinations(cols,2):\n    r,_=pearsonr(df[a],df[b])\n    print(a,b,'r=',r)\nPY\ntrue; tmux wait -S done\r"]
