[528.95645, "o", "    s['D']=p['beta'][0] + p['beta'][1]*s['U'] + p['beta'][2]*s['Y'] + random.gauss(0.0, p['sigma'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[528.956537, "o", "> "]
[528.956691, "o", "    # M depends on U, R\r\n\u001b[?2004l\r\u001b[?2004h> "]
[528.956922, "o", "    p=params['M']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[528.957337, "o", "    s['M']=p['beta'][0] + p['beta'][1]*s['U'] + p['beta'][2]*s['R'] + random.gauss(0.0, p['sigma'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[528.957518, "o", "    samples.append(s)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[528.957761, "o", "with open('/app/final_bn_sample.csv','w',newline='') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[528.957961, "o", ">     w=csv.writer(f)\r\n\u001b[?2004l\r\u001b[?2004h"]
[528.958092, "o", ">     w.writerow(cols)\r\n\u001b[?2004l\r\u001b[?2004h>     for s in samples:\r\n\u001b[?2004l\r"]
[528.958197, "o", "\u001b[?2004h> "]
[528.958362, "o", "        w.writerow([s[c] for c in cols])\r\n\u001b[?2004l\r\u001b[?2004h"]
[528.958541, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[528.95861, "o", "> "]
[528.958819, "o", "print('wrote /app/intervened_dag.csv and /app/final_bn_sample.csv')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[528.958955, "o", "for node in order:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[528.959013, "o", "    print(node, params[node])\r\n\u001b[?2004l\r"]
[528.959199, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[529.089801, "o", "wrote /app/intervened_dag.csv and /app/final_bn_sample.csv\r\nU {'parents': [], 'beta': [50.479893648837994], 'sigma': 10.684617568519114}\r\nY {'parents': ['U'], 'beta': [12.428390703341229, 0.7513156603377831], 'sigma': 10.626074181012207}\r\nR {'parents': ['U'], 'beta': [-3.1974118990166147, 0.9827892503989983], 'sigma': 10.580370015450104}\r\nD {'parents': ['U', 'Y'], 'beta': [-12.296513517029922, 0.5495886405654089, 0.4485708624455004], 'sigma': 14.089535389108423}\r\nM {'parents': ['U', 'R'], 'beta': [-11.357020085805033, 0.767516620467708, 0.30286590917200445], 'sigma': 12.480277224738144}\r\n"]
