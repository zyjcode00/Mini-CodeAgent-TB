[105.921945, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - <<'PY'\nimport csv, math, itertools\nfrom collections import defaultdict\n\n# load data\npath='/app/bn_sample_10k.csv'\nwith open(path) as f:\n    rows=list(csv.DictReader(f))\ncols=list(rows[0].keys())\nX={c:[float(r[c]) for r in rows] for c in cols}\nn=len(rows)\n\n# linear algebra helpers\n\ndef transpose(A):\n    return [list(row) for row in zip(*A)]\n\ndef matmul(A,B):\n    # A m x p, B p x n\n    m,p=len(A),len(A[0])\n    if isinstance(B[0], (int,float)):\n        raise TypeError\n    p2=len(B)\n    n2=len(B[0])\n    assert p==p2\n    C=[[0.0]*n2 for _ in range(m)]\n    for i in range(m):\n        Ai=A[i]\n        for k in range(p):\n            aik=Ai[k]\n            if aik==0: continue\n            Bk=B[k]\n            for j in range(n2):\n                C[i][j]+=aik*Bk[j]\n    return C\n\ndef matvec(A,v):\n    return [sum(a*b for a,b in zip(row,v)) for row in A]\n\ndef solve_linear(A,b):\n    # Gaussian elimination on augmented matrix; A square\n    m=len(A)\n    M=[row[:] + [b[i]] for i,row in enumerate(A)]\n    for col in range(m):\n        pivot=max(range(col,m), key=lambda r: abs(M[r][col]))\n        if abs(M[pivot][col]) < 1e-12:\n            return None\n        M[col],M[pivot]=M[pivot],M[col]\n        pv=M[col][col]\n        inv=1.0/pv\n        for j in range(col,m+1):\n            M[col][j]*=inv\n        for r in range(m):\n            if r==col: continue\n            factor=M[r][col]\n            if factor==0: continue\n            for j in range(col,m+1):\n                M[r][j]-=factor*M[col][j]\n    return [M[i][m] for i in range(m)]\n\ndef regress_bic(y, parents):\n    # y, parents are lists of floats\n    k=len(parents)\n    # build design matrix with intercept\n    if k==0:\n        mu=sum(y)/n\n        rss=sum((v-mu)**2 for v in y)\n        sigma2=rss/n\n        ll=-0.5*n*(math.log(2*math.pi*sigma2)+1)\n        bic=ll - 0.5*math.log(n)\n        return bic, mu, [], sigma2\n    Xmat=[[1.0]+[p[i] for p in parents] for i in range(n)]\n    # normal equations\n    p=k+1\n    XtX=[[0.0]*p for _ in range(p)]\n    Xty=[0.0]*p\n    for i in range(n):\n        row=Xmat[i]\n        yi=y[i]\n        for a in range(p):\n            Xty[a]+=row[a]*yi\n            ra=row[a]\n            for b in range(p):\n                XtX[a][b]+=ra*row[b]\n    beta=solve_linear(XtX,Xty)\n    if beta is None:\n        return -1e99, None, None, None\n    rss=0.0\n    for i in range(n):\n        pred=sum(beta[j]*Xmat[i][j] for j in range(p))\n        e=y[i]-pred\n        rss+=e*e\n    sigma2=rss/n\n    if sigma2<=0:\n        sigma2=1e-12\n    ll=-0.5*n*(math.log(2*math.pi*sigma2)+1)\n    bic=ll - 0.5*p*math.log(n)\n    return bic, beta[0], beta[1:], sigma2\n\n# enumerate orders with U first, others permutations\nothers=[c for c in cols if c!='U']\nbest=None\nbest_struct=None\ncount=0\nfor perm in itertools.permutations(others):\n    order=('U',)+perm\n    pos={node:i for i,node in enumerate(order)}\n    # possible parent candidates for each node from predecessors; U must have no parents.\n    cand={node:[p for p in order[:pos[node]] if not (node=='U')] for node in order}\n    # need exactly 6 edges total\n    # enumerate parent sets for each node. With only 4 other nodes, small.\n    parent_options=[]\n    nodes=[]\n    for node in order:\n        if node=='U':\n            opts=[()]\n        else:\n            preds=cand[node]\n            opts=[]\n            for r in range(len(preds)+1):\n                for subset in itertools.combinations(preds,r):\n                    opts.append(subset)\n        parent_options.append(opts)\n        nodes.append(node)\n    # recursive prune by edge count\n    def rec(i, chosen, edgecount):\n        nonlocal best,best_struct,count\n        if edgecount>6:\n            return\n        if i==len(nodes):\n            if edgecount!=6:\n                return\n            # score\n            bic_total=0.0\n            for node,parents in chosen.items():\n                y=X[node]\n                pars=[X[p] for p in parents]\n                bic,_,_,_=regress_bic(y, pars)\n                bic_total+=bic\n            count+=1\n            if best is None or bic_total"]
[105.922039, "i", ">best:\n                best=bic_total\n                best_struct={node:chosen[node] for node in nodes}\n            return\n        node=nodes[i]\n        for parents in parent_options[i]:\n            chosen[node]=parents\n            rec(i+1, chosen, edgecount+len(parents))\n        chosen.pop(node,None)\n    rec(0, {}, 0)\n\nprint('searched structures',count)\nprint('best bic',best)\nprint('best struct order likely')\nfor node,parents in best_struct.items():\n    print(node, '<-', parents)\nPY\ntrue; tmux wait -S done\r"]
[105.92307, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
