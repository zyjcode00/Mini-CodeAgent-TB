[658.414419, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 -m unittest -v /app/test_bn_outputs.py; status=$?; python3 - <<'PY'\nimport csv\nfrom pathlib import Path\nfor name in ['learned_dag.csv','intervened_dag.csv','final_bn_sample.csv']:\n    p=Path('/app')/name\n    with p.open(newline='') as f:\n        rows=list(csv.reader(f))\n    print(f'{name}: data_rows={len(rows)-1}, header={rows[0]}')\n    print(f'  first_data={rows[1] if len(rows)>1 else None}')\nraise SystemExit(status)\nPY\ntrue; tmux wait -S done\r"]
