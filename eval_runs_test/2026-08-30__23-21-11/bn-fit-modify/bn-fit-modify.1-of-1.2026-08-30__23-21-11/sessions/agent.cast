[163.995888, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - <<'PY'\nimport csv, math, itertools\n\npath='/app/bn_sample_10k.csv'\nwith open(path) as f:\n    rows=list(csv.DictReader(f))\ncols=list(rows[0].keys())\nX={c:[float(r[c]) for r in rows] for c in cols}\nn=len(rows)\n\n# basic linear algebra for small systems\n\ndef solve_linear(A, b):\n    m=len(A)\n    M=[A[i][:]+[b[i]] for i in range(m)]\n    for col in range(m):\n        pivot=max(range(col,m), key=lambda r: abs(M[r][col]))\n        if abs(M[pivot][col]) < 1e-12:\n            return None\n        M[col], M[pivot] = M[pivot], M[col]\n        inv=1.0/M[col][col]\n        for j in range(col, m+1):\n            M[col][j] *= inv\n        for r in range(m):\n            if r == col:\n                continue\n            factor=M[r][col]\n            if factor == 0:\n                continue\n            for j in range(col, m+1):\n                M[r][j] -= factor * M[col][j]\n    return [M[i][m] for i in range(m)]\n\n\ndef bic_for_node(y, parents):\n    p=len(parents)\n    if p == 0:\n        mu=sum(y)/n\n        rss=sum((v-mu)**2 for v in y)\n        sigma2=max(rss/n, 1e-12)\n        ll=-0.5*n*(math.log(2*math.pi*sigma2)+1)\n        bic=ll - 0.5*math.log(n)\n        return bic, [mu], sigma2\n    Xmat=[[1.0]+[par[i] for par in parents] for i in range(n)]\n    k=p+1\n    XtX=[[0.0]*k for _ in range(k)]\n    Xty=[0.0]*k\n    for i in range(n):\n        row=Xmat[i]\n        yi=y[i]\n        for a in range(k):\n            Xty[a] += row[a]*yi\n            ra=row[a]\n            for b in range(k):\n                XtX[a][b] += ra*row[b]\n    beta=solve_linear(XtX, Xty)\n    if beta is None:\n        return -1e99, None, None\n    rss=0.0\n    for i in range(n):\n        pred=sum(beta[j]*Xmat[i][j] for j in range(k))\n        e=y[i]-pred\n        rss += e*e\n    sigma2=max(rss/n, 1e-12)\n    ll=-0.5*n*(math.log(2*math.pi*sigma2)+1)\n    bic=ll - 0.5*k*math.log(n)\n    return bic, beta, sigma2\n\nothers=[c for c in cols if c!='U']\nbest=None\nbest_graph=None\ncount=0\n\nfor perm in itertools.permutations(others):\n    order=('U',)+perm\n    preds={node:list(order[:i]) for i,node in enumerate(order)}\n    # enumerate parent sets by recursion, total edges fixed at 6\n    nodes=list(order)\n    def rec(i, chosen, edgecount):\n        global best,best_graph,count\n        nonlocal best, best_graph, count\n        if edgecount > 6:\n            return\n        if i == len(nodes):\n            if edgecount != 6:\n                return\n            score=0.0\n            for node in nodes:\n                parents=chosen[node]\n                bic, _, _ = bic_for_node(X[node], [X[p] for p in parents])\n                score += bic\n            count += 1\n            if best is None or score > best:\n                best=score\n                best_graph={node: tuple(chosen[node]) for node in nodes}\n            return\n        node=nodes[i]\n        if node=='U':\n            chosen[node]=()\n            rec(i+1, chosen, edgecount)\n            del chosen[node]\n            return\n        ps=preds[node]\n        for r in range(len(ps)+1):\n            for subset in itertools.combinations(ps, r):\n                chosen[node]=subset\n                rec(i+1, chosen, edgecount+len(subset))\n        if node in chosen:\n            del chosen[node]\n    rec(0, {}, 0)\n\nprint('candidate structures evaluated:', count)\nprint('best score:', best)\nfor node in nodes:\n    print(node, '<-', best_graph[node])\nprint('edges:', sum(len(v) for v in best_graph.values()))\nPY\ntrue; tmux wait -S done\r"]
[163.997273, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
