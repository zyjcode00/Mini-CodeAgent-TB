[677.481677, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 -m unittest -v /app/test_bn_outputs.py && python3 - <<'PY'\nimport csv\nfrom pathlib import Path\nchecks = []\nfor name, expected_rows in [('learned_dag.csv', 6), ('intervened_dag.csv', 5), ('final_bn_sample.csv', 10000)]:\n    p = Path('/app') / name\n    with p.open(newline='') as f:\n        rows = list(csv.reader(f))\n    checks.append((name, len(rows) - 1, expected_rows, rows[0]))\nfor name, got, exp, header in checks:\n    assert got == exp, (name, got, exp)\n    print(f'{name}: data_rows={got}, header={header}')\nPY\ntrue; tmux wait -S done\r"]
