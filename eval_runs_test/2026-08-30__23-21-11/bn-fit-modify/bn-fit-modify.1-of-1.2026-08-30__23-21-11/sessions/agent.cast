[438.089702, "o", "\u001b[?2004hroot@687782a4c840:/app# "]
[528.935746, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - <<'PY'\nimport csv, math, random\nfrom collections import defaultdict\n\nrandom.seed(0)\n\n# Load data\nwith open('/app/bn_sample_10k.csv') as f:\n    rows=list(csv.DictReader(f))\ncols=list(rows[0].keys())\nX={c:[float(r[c]) for r in rows] for c in cols}\n\n# Learned DAG from file\nwith open('/app/learned_dag.csv') as f:\n    dag=list(csv.DictReader(f))\nparents=defaultdict(list)\nchildren=defaultdict(list)\nfor e in dag:\n    child=e['to']\n    parent=e['from']\n    parents[child].append(parent)\n    children[parent].append(child)\n\n# intervention: cut incoming edges to Y\nintervened_edges=[e for e in dag if e['to']!='Y']\nwith open('/app/intervened_dag.csv','w',newline='') as f:\n    w=csv.writer(f)\n    w.writerow(['to','from'])\n    for e in intervened_edges:\n        w.writerow([e['to'], e['from']])\n\n# Fit linear-Gaussian parameters for each node on original data\n# We keep coefficients in topological order [U, Y, R, D, M] based on learned structure.\norder=['U','Y','R','D','M']\n\ndef solve_linear(A, b):\n    m=len(A)\n    M=[A[i][:]+[b[i]] for i in range(m)]\n    for col in range(m):\n        pivot=max(range(col,m), key=lambda r: abs(M[r][col]))\n        if abs(M[pivot][col]) < 1e-12:\n            return None\n        if pivot != col:\n            M[col], M[pivot] = M[pivot], M[col]\n        inv=1.0/M[col][col]\n        for j in range(col,m+1):\n            M[col][j] *= inv\n        for r in range(m):\n            if r == col:\n                continue\n            factor=M[r][col]\n            if factor == 0:\n                continue\n            for j in range(col,m+1):\n                M[r][j] -= factor*M[col][j]\n    return [M[i][m] for i in range(m)]\n\nparams={}\nfor node in order:\n    ps=parents.get(node, [])\n    y=X[node]\n    n=len(y)\n    if not ps:\n        mu=sum(y)/n\n        rss=sum((v-mu)**2 for v in y)\n        sigma=math.sqrt(max(rss/n, 1e-12))\n        params[node]={'parents':[], 'beta':[mu], 'sigma':sigma}\n    else:\n        Xmat=[[1.0]+[X[p][i] for p in ps] for i in range(n)]\n        k=len(ps)+1\n        XtX=[[0.0]*k for _ in range(k)]\n        Xty=[0.0]*k\n        for i in range(n):\n            row=Xmat[i]\n            yi=y[i]\n            for a in range(k):\n                Xty[a]+=row[a]*yi\n                ra=row[a]\n                for b in range(k):\n                    XtX[a][b]+=ra*row[b]\n        beta=solve_linear(XtX, Xty)\n        if beta is None:\n            raise RuntimeError(f'Could not fit node {node}')\n        rss=0.0\n        for i in range(n):\n            pred=sum(beta[j]*Xmat[i][j] for j in range(k))\n            rss+=(y[i]-pred)**2\n        sigma=math.sqrt(max(rss/n, 1e-12))\n        params[node]={'parents':ps, 'beta':beta, 'sigma':sigma}\n\n# Sample from intervened BN\nN=10000\nsamples=[]\nfor _ in range(N):\n    s={}\n    # U root\n    p=params['U']\n    s['U']=random.gauss(p['beta'][0], p['sigma'])\n    # Y intervened to 0 exactly\n    s['Y']=0.0\n    # R depends on U\n    p=params['R']\n    s['R']=p['beta'][0] + p['beta'][1]*s['U'] + random.gauss(0.0, p['sigma'])\n    # D depends on U, Y\n    p=params['D']\n    s['D']=p['beta'][0] + p['beta'][1]*s['U'] + p['beta'][2]*s['Y'] + random.gauss(0.0, p['sigma'])\n    # M depends on U, R\n    p=params['M']\n    s['M']=p['beta'][0] + p['beta'][1]*s['U'] + p['beta'][2]*s['R'] + random.gauss(0.0, p['sigma'])\n    samples.append(s)\n\nwith open('/app/final_bn_sample.csv','w',newline='') as f:\n    w=csv.writer(f)\n    w.writerow(cols)\n    for s in samples:\n        w.writerow([s[c] for c in cols])\n\nprint('wrote /app/intervened_dag.csv and /app/final_bn_sample.csv')\nfor node in order:\n    print(node, params[node])\nPY\ntrue; tmux wait -S done\r"]
[528.936384, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
