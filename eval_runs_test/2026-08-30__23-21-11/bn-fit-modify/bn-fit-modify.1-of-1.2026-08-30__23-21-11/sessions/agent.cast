[267.956952, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - <<'PY'\nimport csv, math, itertools\n\npath='/app/bn_sample_10k.csv'\nwith open(path) as f:\n    rows=list(csv.DictReader(f))\ncols=list(rows[0].keys())\nX={c:[float(r[c]) for r in rows] for c in cols}\nn=len(rows)\n\n# Solve linear system via Gauss-Jordan\n\ndef solve_linear(A, b):\n    m=len(A)\n    M=[A[i][:]+[b[i]] for i in range(m)]\n    for col in range(m):\n        pivot=max(range(col,m), key=lambda r: abs(M[r][col]))\n        if abs(M[pivot][col]) < 1e-12:\n            return None\n        if pivot != col:\n            M[col], M[pivot] = M[pivot], M[col]\n        inv=1.0/M[col][col]\n        for j in range(col, m+1):\n            M[col][j] *= inv\n        for r in range(m):\n            if r == col:\n                continue\n            factor=M[r][col]\n            if factor == 0:\n                continue\n            for j in range(col, m+1):\n                M[r][j] -= factor * M[col][j]\n    return [M[i][m] for i in range(m)]\n\n\ndef bic_for_node(y, parent_names):\n    p=len(parent_names)\n    if p == 0:\n        mu=sum(y)/n\n        rss=sum((v-mu)**2 for v in y)\n        sigma2=max(rss/n, 1e-12)\n        ll=-0.5*n*(math.log(2*math.pi*sigma2)+1)\n        bic=ll - 0.5*math.log(n)\n        return bic, [mu], sigma2\n    Xmat=[[1.0]+[X[pn][i] for pn in parent_names] for i in range(n)]\n    k=p+1\n    XtX=[[0.0]*k for _ in range(k)]\n    Xty=[0.0]*k\n    for i in range(n):\n        row=Xmat[i]\n        yi=y[i]\n        for a in range(k):\n            Xty[a] += row[a]*yi\n            ra=row[a]\n            for b in range(k):\n                XtX[a][b] += ra*row[b]\n    beta=solve_linear(XtX, Xty)\n    if beta is None:\n        return -1e99, None, None\n    rss=0.0\n    for i in range(n):\n        pred=0.0\n        for j in range(k):\n            pred += beta[j]*Xmat[i][j]\n        e=y[i]-pred\n        rss += e*e\n    sigma2=max(rss/n, 1e-12)\n    ll=-0.5*n*(math.log(2*math.pi*sigma2)+1)\n    bic=ll - 0.5*k*math.log(n)\n    return bic, beta, sigma2\n\nnodes=cols\nbest_score=[None]\nbest_graph=[None]\neval_count=[0]\n\n# Enumerate DAGs consistent with an order, with U first due to no parents. Since direction between remaining nodes may be inferred by alphabet rule when unclear, we enforce an order that respects a DAG and later use that to orient edges.\nothers=[c for c in nodes if c != 'U']\n\nfor perm in itertools.permutations(others):\n    order=('U',)+perm\n    parent_candidates={node:list(order[:i]) for i,node in enumerate(order)}\n\n    def rec(idx, chosen, edgecount):\n        if edgecount > 6:\n            return\n        if idx == len(order):\n            if edgecount != 6:\n                return\n            score=0.0\n            for node in order:\n                parents=chosen[node]\n                bic, _, _ = bic_for_node(X[node], parents)\n                score += bic\n            eval_count[0] += 1\n            if best_score[0] is None or score > best_score[0]:\n                best_score[0] = score\n                best_graph[0] = {node: tuple(chosen[node]) for node in order}\n            return\n        node=order[idx]\n        if node == 'U':\n            chosen[node]=()\n            rec(idx+1, chosen, edgecount)\n            del chosen[node]\n            return\n        preds=parent_candidates[node]\n        for r in range(len(preds)+1):\n            for subset in itertools.combinations(preds, r):\n                chosen[node]=subset\n                rec(idx+1, chosen, edgecount+len(subset))\n        if node in chosen:\n            del chosen[node]\n\n    rec(0, {}, 0)\n\nprint('evaluated', eval_count[0], 'structures')\nprint('best score', best_score[0])\nfor node in order:\n    print(node, '<-', best_graph[0][node])\nprint('edge count', sum(len(v) for v in best_graph[0].values()))\n\n# write learned_dag.csv\nedges=[]\nfor child, parents in best_graph[0].items():\n    for parent in parents:\n        edges.append((child, parent))\nwith open('/app/learned_dag.csv', 'w', newline='') as f:\n    w=csv.writer(f)\n    w.writerow(['to','from'])\n    for child,parent in edges:\n        w.writerow([child,parent])\nprint('wrote /app/learned_dag.csv')\nPY\ntrue; tmux wait"]
[267.957217, "i", " -S done\r"]
