[66.273759, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - <<'PY'\nimport csv, math, itertools\nfrom statistics import mean\npath='/app/bn_sample_10k.csv'\nwith open(path) as f:\n    rows=list(csv.DictReader(f))\ncols=rows[0].keys()\nvals={c:[float(r[c]) for r in rows] for c in cols}\nprint('cols', cols)\n# means and stdevs\nfor c in cols:\n    xs=vals[c]\n    mu=sum(xs)/len(xs)\n    var=sum((x-mu)**2 for x in xs)/len(xs)\n    print(c, mu, var**0.5)\nprint('pairwise corr')\nfor a,b in itertools.combinations(cols,2):\n    xa, xb=vals[a], vals[b]\n    ma, mb = sum(xa)/len(xa), sum(xb)/len(xb)\n    va=sum((x-ma)**2 for x in xa)\n    vb=sum((x-mb)**2 for x in xb)\n    cov=sum((x-ma)*(y-mb) for x,y in zip(xa,xb))\n    r=cov/math.sqrt(va*vb)\n    print(a,b,round(r,4))\nPY\ntrue; tmux wait -S done\r"]
[66.274208, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
[66.274406, "o", "\u001b[?2004hroot@687782a4c840:/app# "]
