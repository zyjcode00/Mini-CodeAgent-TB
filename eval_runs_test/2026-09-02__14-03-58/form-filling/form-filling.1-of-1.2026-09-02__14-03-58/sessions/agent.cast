[166.902144, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.90273, "o", "+def load_documents(documents_dir: Path) -> Dict[str, str]:\r\n\u001b[?2004l\r"]
[166.902828, "o", "\u001b[?2004h> "]
[166.903526, "o", "+    if not documents_dir.exists():\r\n\u001b[?2004l\r"]
[166.903789, "o", "\u001b[?2004h> "]
[166.904797, "o", "+        raise FileNotFoundError(f\"Documents directory not found: {documents_dir}\")\r\n\u001b[?2004l\r"]
[166.904993, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[166.905129, "o", "\":\u001b[?2004h> "]
[166.905246, "o", "+    documents = {}\r\n\u001b[?2004l\r"]
[166.905394, "o", "\u001b[?2004h> "]
[166.905896, "o", "+    for path in sorted(documents_dir.glob(\"*.txt\")):\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.905931, "o", "> "]
[166.90635, "o", "+        text = path.read_text(encoding=\"utf-8\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.906713, "o", "+        if text.strip():\r\n\u001b[?2004l\r \u001b[?2004h"]
[166.906747, "o", "> "]
[166.906959, "o", "+            documents[normalize_source(path)] = text\r\n\u001b[?2004l\r"]
[166.907092, "o", "\u001b[?2004h> "]
[166.907371, "o", "+    if not documents:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.908113, "o", "+        raise ValueError(f\"No text documents found in {documents_dir}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.908334, "o", "> +    return documents\r\n"]
[166.908373, "o", "\u001b[?2004l\r"]
[166.908423, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.908477, "o", "> +\r\n\u001b[?2004l\r"]
[166.90858, "o", "\u001b[?2004h> "]
[166.909398, "o", "+def first_match(patterns: Iterable[str], text: str) -> Optional[str]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.909484, "o", "> "]
[166.909904, "o", "+    for pattern in patterns:\r\n\u001b[?2004l\ro\u001b[?2004h"]
[166.910064, "o", "> "]
[166.910502, "o", "+        match = re.search(pattern, text, flags=re.IGNORECASE | re.MULTILINE)\r\n\u001b[?2004l\rO\u001b[?2004h"]
[166.910536, "o", "> "]
[166.910731, "o", "+        if match:\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.910837, "o", "> "]
[166.911007, "o", "+            return match.group(1).strip(\" .,-\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.911178, "o", "+    return None\r\n\u001b[?2004l\r"]
[166.911319, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\ru\u001b[?2004h"]
[166.911459, "o", "> +\r\n\u001b[?2004l\rx "]
[166.911709, "o", "\u001b[?2004h> "]
[166.912336, "o", "+def extract_candidates(documents: Dict[str, str]) -> List[Candidate]:\r\n\u001b[?2004l\r"]
[166.912539, "o", "\u001b[?2004h> "]
[166.912703, "o", "+    patterns = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.913073, "o", "+        \"full name\": [r\"^Full Name:\\s*(.+)$\", r\"^Name:\\s*(.+)$\", r\"^#\\s+([A-Z][A-Z ]+)$\"],\r\n\u001b[?2004l\r"]
[166.913234, "o", "\u001b[?2004h> "]
[166.913462, "o", "+        \"email contact email email address\": [r\"(?:Email Address|Email):\\s*([\\w.+-]+@[\\w.-]+\\.[A-Za-z]{2,})\"],\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.913529, "o", "> "]
[166.913855, "o", "+        \"address current address mailing address\": [r\"(?:Current Address|Address):\\s*(.+)$\"],\r\n\u001b[?2004l\r"]
[166.913946, "o", "\u001b[?2004h> "]
[166.914269, "o", "+        \"phone phone number mobile home\": [r\"(?:Phone Number|Phone \\(Home\\)|Phone):\\s*(\\(?\\d{3}\\)?[-\\s]\\d{3}[-\\s]\\d{4})\"],\r\n\u001b[?2004l\r"]
[166.91436, "o", "\u001b[?2004h> "]
[166.914575, "o", "+        \"gender sex\": [r\"^Gender:\\s*(Male|Female|Non-binary|Other)\\b\"],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.914808, "o", "+        \"date of birth birth dob\": [r\"Date of Birth:\\s*(.+)$\"],\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.914886, "o", "> "]
[166.915062, "o", "+        \"nationality citizenship\": [r\"Nationality:\\s*(.+)$\"],\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.915187, "o", "> "]
[166.915427, "o", "+        \"job title position applied role\": [r\"Job Title:\\s*(.+)$\", r\"^Position:\\s*(.+)$\"],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.915899, "o", "+        \"employer company current employer\": [r\"Current Employer:\\s*(.+)$\", r\"\\*\\*([^*]+Inc\\.)\\*\\*\"],\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.91602, "o", "> "]
[166.9164, "o", "+        \"education degree university\": [r\"###\\s*(Master of Science in Computer Science)\"],\r\n\u001b[?2004l\r"]
[166.916557, "o", "\u001b[?2004h> "]
[166.916864, "o", "+        \"skills programming languages tools frameworks\": [r\"Programming Languages:\\s*(.+)$\"],\r\n\u001b[?2004l\r"]
[166.917047, "o", "\u001b[?2004h> +    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.917154, "o", "> +"]
[166.917415, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.917556, "o", "+    candidates: List[Candidate] = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.91769, "o", "> "]
[166.91783, "o", "+    for source, text in documents.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.918093, "o", "+        compact_context = re.sub(r\"\\s+\", \" \", text).strip()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.918342, "o", "+        for label, label_patterns in patterns.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.918495, "o", "> "]
[166.91862, "o", "+            value = first_match(label_patterns, text)"]
[166.918735, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.91882, "o", "+            if value:\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.918876, "o", "> "]
[166.919312, "o", "+                candidates.append(Candidate(label=label, value=value, source=source, context=compact_context[:600]))\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.919431, "o", "> "]
[166.919479, "o", "+    return candidates\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[166.919647, "o", "\u001b[?2004h> "]
[166.919799, "o", "+\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.920376, "o", "+def retrieve_best_candidate(field: FormField, candidates: List[Candidate], threshold: float = 0.08) -> Optional[tuple[Candidate, float]]:\r\n\u001b[?2004l\r"]
[166.920594, "o", "\u001b[?2004h> "]
[166.92075, "o", "+    if not candidates:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.920888, "o", "+        return None\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[166.921068, "o", "\u001b[?2004h> "]
[166.921359, "o", "+    query = f\"{field.field_name} {field.field_id.replace('_', ' ')}\"\r\n\u001b[?2004l\r"]
[166.921616, "o", "\u001b[?2004h> "]
[166.921934, "o", "+    candidate_texts = [f\"{candidate.label} {candidate.value} {candidate.context}\" for candidate in candidates]\r\n\u001b[?2004l\r"]
[166.921993, "o", "\u001b[?2004h> "]
[166.922446, "o", "+    vectorizer = TfidfVectorizer(stop_words=\"english\", ngram_range=(1, 2))\r\n\u001b[?2004l\r"]
[166.922544, "o", "\u001b[?2004h> "]
[166.923013, "o", "+    matrix = vectorizer.fit_transform([query] + candidate_texts)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.923465, "o", "+    scores = cosine_similarity(matrix[0:1], matrix[1:]).ravel()\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.923757, "o", "> "]
[166.923844, "o", "+    best_index = int(scores.argmax())\r\n\u001b[?2004l\r"]
[166.924218, "o", "\u001b[?2004h> "]
[166.924387, "o", "+    score = float(scores[best_index])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.924466, "o", "+    if score < threshold:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.924649, "o", "+        return None\r\n\u001b[?2004l\r"]
[166.924727, "o", "\u001b[?2004h> "]
[166.92496, "o", "+    return candidates[best_index], score\r\n\u001b[?2004l\r"]
[166.925103, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[166.925267, "o", "\u001b[?2004h> "]
[166.925631, "o", "+def build_field_mapping(pdf_path: Path = PDF_PATH, documents_dir: Path = DOCUMENTS_DIR) -> Dict[str, object]:\r\n\u001b[?2004l\r"]
[166.926019, "o", "\u001b[?2004h> "]
[166.92625, "o", "+    fields, field_detection_method = analyze_pdf_fields(pdf_path)\r\n\u001b[?2004l\r"]
[166.926381, "o", "\u001b[?2004h> "]
[166.926512, "o", "+    documents = load_documents(documents_dir)\r\n\u001b[?2004l\r"]
[166.926614, "o", "\u001b[?2004h> "]
[166.926793, "o", "+    candidates = extract_candidates(documents)\r\n\u001b[?2004l\r"]
[166.926877, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[166.926914, "o", "\u001b[?2004h"]
[166.926989, "o", "> "]
[166.927209, "o", "+    mapped_fields: Dict[str, Dict[str, str]] = {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.927287, "o", "> "]
[166.927424, "o", "+    unmapped_fields: List[str] = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.927511, "o", "> "]
[166.927628, "o", "+    similarity_scores: Dict[str, float] = {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.927721, "o", "> +\r\n\u001b[?2004l\r"]
[166.927821, "o", "\u001b[?2004h> "]
[166.927851, "o", "+    for field in fields:\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.927884, "o", "> "]
[166.928107, "o", "+        retrieved = retrieve_best_candidate(field, candidates)\r\n\u001b[?2004l\r"]
[166.928199, "o", "\u001b[?2004h> "]
[166.928307, "o", "+        if retrieved is None:\r\n\u001b[?2004l\r"]
[166.9284, "o", "\u001b[?2004h> "]
[166.928622, "o", "+            unmapped_fields.append(field.field_id)\r\n\u001b[?2004l\r"]
[166.928732, "o", "\u001b[?2004h"]
[166.928836, "o", "> +            continue\r\n\u001b[?2004l\r"]
[166.928885, "o", "\u001b[?2004h> "]
[166.928971, "o", "+        candidate, score = retrieved\r\n\u001b[?2004l\r"]
[166.929092, "o", "\u001b[?2004h> "]
[166.929183, "o", "+        mapped_fields[field.field_id] = {\r\n\u001b[?2004l\r"]
[166.929284, "o", "\u001b[?2004h> "]
[166.929413, "o", "+            \"field_name\": field.field_name,\r\n\u001b[?2004l\r"]
[166.929459, "o", "\u001b[?2004h> "]
[166.929591, "o", "+            \"value\": candidate.value,\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.929638, "o", "> "]
[166.929769, "o", "+            \"source\": candidate.source,\r\n\u001b[?2004l\r"]
[166.929841, "o", "\u001b[?2004h> "]
[166.92989, "o", "+        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.930088, "o", "+        similarity_scores[field.field_id] = round(score, 4)\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.930157, "o", "> +\r\n\u001b[?2004l\r"]
[166.930205, "o", "\u001b[?2004h> "]
[166.930431, "o", "+    return {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.930616, "o", "+        \"pdf_file\": pdf_path.name,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.930815, "o", "+        \"mapped_fields\": mapped_fields,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.931038, "o", "+        \"unmapped_fields\": unmapped_fields,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.931355, "o", "+        \"total_mapped\": len(mapped_fields),\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.931583, "o", "> "]
[166.931792, "o", "+        \"total_unmapped\": len(unmapped_fields),\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.931909, "o", "> "]
[166.93206, "o", "+        \"rag_stats\": {\r\n\u001b[?2004l\r"]
[166.932131, "o", "\u001b[?2004h> "]
[166.932317, "o", "+            \"documents_processed\": len(documents),\r\n\u001b[?2004l\r"]
[166.932558, "o", "\u001b[?2004h> "]
[166.932851, "o", "+            \"total_chars_processed\": sum(len(text) for text in documents.values()),\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.933064, "o", "> "]
[166.93373, "o", "+            \"retrieval_method\": \"regex candidate extraction + TF-IDF cosine similarity\",\r\n\u001b[?2004l\r"]
[166.933881, "o", "\u001b[?2004h> "]
[166.934261, "o", "+            \"field_detection_method\": field_detection_method,\r\n\u001b[?2004l\r"]
[166.934359, "o", "\u001b[?2004h> "]
[166.934566, "o", "+            \"candidate_count\": len(candidates),\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.934604, "o", "> "]
[166.934837, "o", "+            \"similarity_scores\": similarity_scores,\r\n\u001b[?2004l\r"]
[166.935001, "o", "\u001b[?2004h> +        },\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.935152, "o", "> +    }\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[166.935255, "o", "\u001b[?2004h"]
[166.935314, "o", "> +\r\n\u001b[?2004l\r"]
[166.935359, "o", "\u001b[?2004h> "]
[166.935495, "o", "+def main() -> None:\r\n\u001b[?2004l\r"]
[166.93564, "o", "\u001b[?2004h> +    report = build_field_mapping()\r\n\u001b[?2004l\r"]
[166.935713, "o", "\u001b[?2004h> "]
[166.935935, "o", "+    OUTPUT_PATH.write_text(json.dumps(report, indent=4), encoding=\"utf-8\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.935994, "o", "> "]
[166.936184, "o", "+    print(f\"Wrote field mapping report to {OUTPUT_PATH}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.936281, "o", "> +\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[166.936373, "o", "\u001b[?2004h> "]
[166.936468, "o", "+if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[166.936674, "o", "\u001b[?2004h> +    main()\r\n\u001b[?2004l\r"]
[166.93677, "o", "\u001b[?2004h> "]
[166.936829, "o", "*** End Patch\r\n\u001b[?2004l\r"]
[166.936861, "o", "\u001b[?2004h> "]
[166.936941, "o", "PATCH\r\n\u001b[?2004l\r"]
[166.937822, "o", "bash: apply_patch: command not found\r\n"]
[166.938349, "o", "\u001b[?2004hroot@eccddd84ce73:/app# "]
[166.938575, "o", "true; tmux wait -S done\r\n\u001b[?2004l\r"]
[166.942802, "o", "\u001b[?2004hroot@eccddd84ce73:/app# "]
[183.933481, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\nls -l /app/form_filler.py /app/field_mapping.json /app/test_form_filler.py 2>/dev/null || true\ntrue; tmux wait -S done\r"]
[183.933872, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n"]
[183.934006, "o", "\u001b[?2004l\r"]
[183.934162, "o", "\u001b[?2004hroot@eccddd84ce73:/app# "]
[183.934537, "o", "ls -l /app/form_filler.py /app/field_mapping.json /app/test_form_filler.py 2>/dev/null || true\r\n\u001b[?2004l\r"]
[184.053161, "o", "\u001b[?2004hroot@eccddd84ce73:/app# "]
[184.053506, "o", "true; tmux wait -S done\r\n\u001b[?2004l\r"]
[184.056746, "o", "\u001b[?2004hroot@eccddd84ce73:/app# "]
[184.151746, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/form_filler.py 1 260 true <<'PY'\nimport sys\npath = sys.argv[1]\nstart_line = int(sys.argv[2])\nend_line = None if sys.argv[3] == 'None' else int(sys.argv[3])\nraw_mode = sys.argv[4].lower() == 'true'\ntry:\n    with open(path, 'r', encoding='utf-8', errors='replace') as f:\n        lines = f.readlines()\nexcept FileNotFoundError:\n    print(f\"错误: 找不到文件 {path}\")\n    raise SystemExit(0)\nexcept Exception as exc:\n    print(f\"读取失败: {exc}\")\n    raise SystemExit(0)\n\ntotal_lines = len(lines)\ns_idx = max(0, start_line - 1)\ne_idx = end_line if end_line is not None else total_lines\nselected_lines = lines[s_idx:e_idx]\nif raw_mode:\n    sys.stdout.write(''.join(selected_lines))\nelse:\n    output = []\n    for i, line in enumerate(selected_lines):\n        output.append(f\"{s_idx + i + 1:4d} | {line.rstrip()}\")\n    header = f\"--- 文件: {path} (第 {start_line} 至 {min(e_idx, total_lines)} 行，共 {total_lines} 行) ---\\n\"\n    sys.stdout.write"]
[184.15187, "i", "(header + \"\\n\".join(output) + \"\\n--- 读取完毕 ---\")\nPY\ntrue; tmux wait -S done\r"]
[184.152201, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n"]
[184.152304, "o", "\u001b[?2004l\r"]
[184.152475, "o", "\u001b[?2004hroot@eccddd84ce73:/app# "]
[184.152609, "o", "python3 - /app/form_filler.py 1 260 true <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.152738, "o", "import sys\r\n\u001b[?2004l\r\u001b[?2004h> path = sys.argv[1]\r\n\u001b[?2004l\r"]
[184.15285, "o", "\u001b[?2004h> "]
[184.15293, "o", "start_line = int(sys.argv[2])\r\n\u001b[?2004l\r\u001b[?2004h"]
[184.153043, "o", "> "]
[184.15325, "o", "end_line = None if sys.argv[3] == 'None' else int(sys.argv[3])\r\n\u001b[?2004l\r"]
[184.153333, "o", "\u001b[?2004h> "]
[184.153598, "o", "raw_mode = sys.argv[4].lower() == 'true'\r\n\u001b[?2004l\r\u001b[?2004h"]
[184.153777, "o", "> try:\r\n\u001b[?2004l\r"]
[184.154037, "o", "\u001b[?2004h> "]
[184.154198, "o", "    with open(path, 'r', encoding='utf-8', errors='replace') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[184.154404, "o", "        lines = f.readlines()\r\n\u001b[?2004l\r\u001b[?2004h"]
[184.154518, "o", "> "]
[184.154638, "o", "except FileNotFoundError:\r\n\u001b[?2004l\r"]
[184.154696, "o", "\u001b[?2004h> "]
[184.15491, "o", "    print(f\"错误: 找不到文件 {path}\")\r\n\u001b[?2004l\r"]
[184.155022, "o", "\u001b[?2004h> "]
[184.155093, "o", "    raise SystemExit(0)\r\n\u001b[?2004l\r"]
