[166.870571, "i", "e(path: Path) -> str:\n+    return path.stem\n+\n+\n+def analyze_pdf_fields(pdf_path: Path) -> tuple[List[FormField], str]:\n+    if not pdf_path.exists():\n+        raise FileNotFoundError(f\"PDF file not found: {pdf_path}\")\n+\n+    reader = PdfReader(str(pdf_path))\n+    fields = reader.get_fields() or {}\n+    if fields:\n+        return [\n+            FormField(field_id=str(field_id), field_name=str(info.get(\"/T\") or field_id), source=\"acroform\")\n+            for field_id, info in fields.items()\n+        ], \"acroform\"\n+\n+    inferred: Dict[str, FormField] = {}\n+    for page in reader.pages:\n+        text = page.extract_text() or \"\"\n+        for line in text.splitlines():\n+            match = FIELD_LABEL_PATTERN.match(line.strip())\n+            if not match:\n+                continue\n+            field_name = match.group(1).strip()\n+            field_id = slugify(field_name)\n+            inferred.setdefault(field_id, FormField(field_id=field_id, field_name=field_name, source=\"pdf_text_label\"))\n+\n+    if not inferred:"]
