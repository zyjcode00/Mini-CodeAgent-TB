[293.530615, "i", "> Dict[str, object]:\\n    fields, field_detection_method = analyze_pdf_fields(pdf_path)\\n    documents = load_documents(documents_dir)\\n    candidates = extract_candidates(documents)\\n\\n    mapped_fields: Dict[str, Dict[str, str]] = {}\\n    unmapped_fields: List[str] = []\\n    similarity_scores: Dict[str, float] = {}\\n\\n    for field in fields:\\n        retrieved = retrieve_best_candidate(field, candidates)\\n        if retrieved is None:\\n            unmapped_fields.append(field.field_id)\\n            continue\\n        candidate, score = retrieved\\n        mapped_fields[field.field_id] = {\\n            \"field_name\": field.field_name,\\n            \"value\": candidate.value,\\n            \"source\": candidate.source,\\n        }\\n        similarity_scores[field.field_id] = round(score, 4)\\n\\n    return {\\n        \"pdf_file\": pdf_path.name,\\n        \"mapped_fields\": mapped_fields,\\n        \"unmapped_fields\": unmapped_fields,\\n        \"total_mapped\": len(mapped_fields),\\n        \"total_unmapped\": len(unmapped_fields)"]
