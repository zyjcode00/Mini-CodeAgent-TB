[381.785353, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\ncd /app && sed -n '1,230p' form_filler.py\ntrue; tmux wait -S done\r"]
[381.785736, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
[381.785898, "o", "\u001b[?2004hroot@eccddd84ce73:/app# "]
[381.786114, "o", "cd /app && sed -n '1,230p' form_filler.py\r\n\u001b[?2004l\r"]
[381.788568, "o", "from __future__ import annotations\r\n\r\nimport json\r\nimport math\r\nimport re\r\nfrom collections import Counter\r\nfrom dataclasses import dataclass\r\nfrom pathlib import Path\r\nfrom typing import Dict, Iterable, List, Optional, Sequence, Tuple\r\n\r\nfrom pypdf import PdfReader\r\n\r\n\r\nAPP_DIR = Path(__file__).resolve().parent\r\nPDF_PATH = APP_DIR / \"fillable_form.pdf\"\r\nDOCUMENTS_DIR = APP_DIR / \"documents\"\r\nOUTPUT_PATH = APP_DIR / \"field_mapping.json\"\r\n\r\n\r\nFIELD_LABEL_PATTERN = re.compile(r\"^([A-Za-z][A-Za-z ]{1,80}):\\s*$\")\r\nWORD_PATTERN = re.compile(r\"[A-Za-z0-9']+\")\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass FormField:\r\n    field_id: str\r\n"]
[381.788837, "o", "    field_name: str\r\n    source: str\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Candidate:\r\n    label: str\r\n    value: str\r\n    source: str\r\n    context: str\r\n\r\n\r\ndef slugify(value: str) -> str:\r\n    slug = re.sub(r\"[^a-z0-9]+\", \"_\", value.lower()).strip(\"_\")\r\n    return slug or \"field\"\r\n\r\n\r\ndef normalize_text(value: str) -> str:\r\n    return \" \".join(value.split()).strip()\r\n\r\n\r\ndef tokenize(value: str) -> Counter:\r\n    tokens = [token.lower() for token in WORD_PATTERN.findall(value)]\r\n    return Counter(tokens)\r\n\r\n\r\ndef cosine_similarity(left: Counter, right: Counter) -> float:\r\n    if not left or not right:\r\n        return 0.0\r\n    shared = set(left) & set(right)\r\n    numerator = sum(left[token] * right[token] for token in shared)\r\n    left_norm = math.sqrt(sum(weight * weight for weight in left.values()))\r\n    right_norm = math.sqrt(sum(weight * weight for weight in right.values()))\r\n    if left_norm == 0.0 or right_norm == 0.0:\r\n        return 0.0\r\n    return numerator / (left_norm * right_norm)\r\n\r\n\r\ndef analyze_"]
[381.788901, "o", "pdf_fields(pdf_path: Path) -> Tuple[List[FormField], str]:\r\n    if not pdf_path.exists():\r\n        raise FileNotFoundError(f\"PDF file not found: {pdf_path}\")\r\n\r\n    reader = PdfReader(str(pdf_path))\r\n    fields = reader.get_fields() or {}\r\n    if fields:\r\n        return [\r\n            FormField(field_id=str(field_id), field_name=str(info.get(\"/T\") or field_id), source=\"acroform\")\r\n            for field_id, info in fields.items()\r\n        ], \"acroform\"\r\n\r\n    inferred: Dict[str, FormField] = {}\r\n    for page in reader.pages:\r\n        text = page.extract_text() or \"\"\r\n        for line in text.splitlines():\r\n            match = FIELD_LABEL_PATTERN.match(line.strip())\r\n            if not match:\r\n                continue\r\n            field_name = match.group(1).strip()\r\n            field_id = slugify(field_name)\r\n            inferred.setdefault(\r\n                field_id,\r\n"]
[381.788927, "o", "                FormField(field_id=field_id, field_name=field_name, source=\"pdf_text_label\"),\r\n            )\r\n\r\n"]
[381.789068, "o", "    if not inferred:\r\n        raise ValueError(\"No fillable fields or form-like labels could be identified in the PDF\")\r\n    return list(inferred.values()), \"pdf_text_label_fallback\"\r\n\r\n\r\ndef load_documents(documents_dir: Path) -> Dict[str, str]:\r\n    if not documents_dir.exists():\r\n        raise FileNotFoundError(f\"Documents directory not found: {documents_dir}\")\r\n\r\n    documents: Dict[str, str] = {}\r\n    for path in sorted(documents_dir.glob(\"*.txt\")):\r\n        text = path.read_text(encoding=\"utf-8\")\r\n        if text.strip():\r\n            documents[path.stem] = text\r\n    if not documents:\r\n        raise ValueError(f\"No text documents found in {documents_dir}\")\r\n    return documents\r\n\r\n\r\ndef first_match(patterns: Sequence[str], text: str) -> Optional[str]:\r\n    for pattern in patterns:\r\n        match = re.search(pattern, text, flags=re.IGNORECASE | re.MULTILINE)\r\n        if match:\r\n            return normalize_text(match.group(1).strip(\" .,-\"))\r\n    return None\r\n\r\n\r\ndef extract_candidates(documents: Dict[str"]
[381.789234, "o", ", str]) -> List[Candidate]:\r\n    patterns = {\r\n        \"full name\": [r\"^Full Name:\\s*(.+)$\", r\"^Name:\\s*(.+)$\", r\"^#\\s+([A-Z][A-Z ]+)$\"],\r\n        \"email address\": [r\"(?:Email Address|Email):\\s*([\\w.+-]+@[\\w.-]+\\.[A-Za-z]{2,})\"],\r\n        \"address\": [r\"(?:Current Address|Address):\\s*(.+)$\"],\r\n        \"phone\": [r\"(?:Phone Number|Phone \\(Home\\)|Phone):\\s*(\\(?\\d{3}\\)?[-\\s]\\d{3}[-\\s]\\d{4})\"],\r\n        \"gender\": [r\"^Gender:\\s*(Male|Female|Non-binary|Other)\\b\"],\r\n        \"date of birth\": [r\"Date of Birth:\\s*(.+)$\"],\r\n        \"nationality\": [r\"Nationality:\\s*(.+)$\"],\r\n        \"job title\": [r\"Job Title:\\s*(.+)$\", r\"^Position:\\s*(.+)$\"],\r\n        \"employer\": [r\"Current Employer:\\s*(.+)$\", r\"\\*\\*([^*]+Inc\\.)\\*\\*\"],\r\n        \"education\": [r\"###\\s*(Master of Science in Computer Science)\"],\r\n        \"skills\": [r\"Programming Languages:\\s*(.+)$\"],\r\n    }\r\n\r\n    candidates: List[Candidate] = []\r\n    for source, text in documents.items():\r\n        compact_context = normalize_text(text)\r\n        for label, label_patterns in pa"]
[381.78929, "o", "tterns.items():\r\n            value = first_match(label_patterns, text)\r\n            if value:\r\n                candidates.append(\r\n                    Candidate(\r\n                        label=label,\r\n                        value=value,\r\n                        source=source,\r\n                        context=compact_context[:600],\r\n                    )\r\n                )\r\n    return candidates\r\n\r\n\r\ndef retrieve_best_candidate(\r\n    field: FormField,\r\n    candidates: Sequence[Candidate],\r\n    threshold: float = 0.08,\r\n) -> Optional[Tuple[Candidate, float]]:\r\n    if not candidates:\r\n        return None\r\n\r\n    query = tokenize(f\"{field.field_name} {field.field_id.replace('_', ' ')}\")"]
[381.789363, "o", "\r\n    scored: List[Tuple[float, Candidate]] = []\r\n    for candidate in candidates:\r\n        candidate_text = f\"{candidate.label} {candidate.value} {candidate.context}\"\r\n        score = cosine_similarity(query, tokenize(candidate_text))\r\n"]
[381.789504, "o", "        scored.append((score, candidate))\r\n\r\n    scored.sort(key=lambda item: item[0], reverse=True)\r\n    best_score, best_candidate = scored[0]\r\n    if best_score < threshold:\r\n        return None\r\n    return best_candidate, best_score\r\n\r\n\r\ndef build_field_mapping(\r\n    pdf_path: Path = PDF_PATH,\r\n    documents_dir: Path = DOCUMENTS_DIR,\r\n) -> Dict[str, object]:\r\n    fields, field_detection_method = analyze_pdf_fields(pdf_path)\r\n    documents = load_documents(documents_dir)\r\n    candidates = extract_candidates(documents)\r\n\r\n    mapped_fields: Dict[str, Dict[str, str]] = {}\r\n    unmapped_fields: List[str] = []"]
[381.789607, "o", "\r\n    similarity_scores: Dict[str, float] = {}\r\n\r\n    for field in fields:\r\n        retrieved = retrieve_best_candidate(field, candidates)\r\n        if retrieved is None:\r\n            unmapped_fields.append(field.field_id)\r\n            continue\r\n        candidate, score = retrieved\r\n        mapped_fields[field.field_id] = {\r\n            \"field_name\": field.field_name,\r\n            \"value\": candidate.value,\r\n            \"source\": candidate.source,\r\n        }\r\n        similarity_scores[field.field_id] = round(score, 4)\r\n\r\n    return {\r\n"]
[381.789711, "o", "        \"pdf_file\": pdf_path.name,\r\n        \"mapped_fields\": mapped_fields,\r\n        \"unmapped_fields\": unmapped_fields,\r\n        \"total_mapped\": len(mapped_fields),\r\n        \"total_unmapped\": len(unmapped_fields),\r\n        \"rag_stats\": {\r\n            \"documents_processed\": len(documents),\r\n            \"total_chars_processed\": sum(len(text) for text in documents.values()),\r\n            \"retrieval_method\": \"regex candidate extraction + cosine similarity\",\r\n            \"field_detection_method\": field_detection_method,\r\n            \"candidate_count\": len(candidates),\r\n            \"similarity_scores\": similarity_scores,\r\n        },\r\n    }\r\n"]
[381.789826, "o", "\r\n\r\ndef main() -> None:\r\n    report = build_field_mapping()\r\n    OUTPUT_PATH.write_text(json.dumps(report, indent=2), encoding=\"utf-8\")\r\n    print(f\"Wrote field mapping report to {OUTPUT_PATH}\")\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()"]
[381.78988, "o", "\r\n"]
