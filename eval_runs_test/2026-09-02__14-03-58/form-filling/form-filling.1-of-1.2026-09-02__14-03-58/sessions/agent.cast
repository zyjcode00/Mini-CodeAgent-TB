[397.535806, "o", "import sys\r\n\u001b[?2004l\r"]
[397.535874, "o", "\u001b[?2004h> "]
[397.535996, "o", "path = sys.argv[1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.537476, "o", "old_str = '    query = tokenize(f\"{field.field_name} {field.field_id.replace(\\'_\\', \\' \\')}\")\\n    scored: List[Tuple[float, Candidate]] = []\\n    for candidate in candidates:\\n        candidate_text = f\"{candidate.label} {candidate.value} {candidate.context}\"\\n        score = cosine_similarity(query, tokenize(candidate_text))\\n        scored.append((score, candidate))\\n'\r\n\u001b[?2004l\r"]
[397.537773, "o", "\u001b[?2004h> "]
[397.539561, "o", "new_str = '    query = tokenize(f\"{field.field_name} {field.field_id.replace(\\'_\\', \\' \\')}\")\\n    scored: List[Tuple[float, Candidate]] = []\\n    for candidate in candidates:\\n        # Give the extracted field label most of the weight. The document\\n        # context remains useful for disambiguation without overpowering it.\\n        label_score = cosine_similarity(query, tokenize(candidate.label))\\n        context_score = cosine_similarity(query, tokenize(candidate.context))\\n        score = (0.85 * label_score) + (0.15 * context_score)\\n        scored.append((score, candidate))\\n'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[397.539718, "o", "\u001b[?2004h> "]
