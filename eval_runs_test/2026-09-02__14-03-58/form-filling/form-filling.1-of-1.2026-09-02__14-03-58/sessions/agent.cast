[423.448225, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\ncd /app && python3 - <<'PY'\nimport json\nfrom pathlib import Path\npath = Path('field_mapping.json')\nreport = json.loads(path.read_text())\nassert report['total_mapped'] == len(report['mapped_fields'])\nassert report['total_unmapped'] == len(report['unmapped_fields'])\nassert report['mapped_fields']['address']['value'] == '123 Tech Lane, San Francisco, CA 94105'\nassert report['mapped_fields']['email']['value'] == 'alex.johnson@example.com'\nprint(json.dumps({\n    'output_exists': path.exists(),\n    'mapped_fields': report['mapped_fields'],\n    'total_mapped': report['total_mapped'],\n    'total_unmapped': report['total_unmapped'],\n}, indent=2))\nPY\ntrue; tmux wait -S done\r"]
[423.448529, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
