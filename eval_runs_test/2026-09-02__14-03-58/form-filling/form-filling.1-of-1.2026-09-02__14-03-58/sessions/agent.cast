[102.457405, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - <<'PY'\nfrom pypdf import PdfReader\nreader = PdfReader('/app/fillable_form.pdf')\nfor i, page in enumerate(reader.pages, 1):\n    annots = page.get('/Annots') or []\n    print('page', i, 'annots', len(annots))\n    for annot in annots:\n        obj = annot.get_object()\n        print('  subtype', obj.get('/Subtype'), 'T', obj.get('/T'), 'TU', obj.get('/TU'), 'FT', obj.get('/FT'))\nPY\ntrue; tmux wait -S done\r"]
[102.458121, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
