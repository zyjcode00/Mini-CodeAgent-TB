[88.875638, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - <<'PY'\nfrom pathlib import Path\nfrom pypdf import PdfReader\npdf = Path('/app/fillable_form.pdf')\nprint('exists', pdf.exists())\nif pdf.exists():\n    reader = PdfReader(str(pdf))\n    fields = reader.get_fields() or {}\n    print('field_count', len(fields))\n    for k, v in fields.items():\n        print(k, '=>', v.get('/T'), v.get('/FT'), v.get('/TU'))\nPY\ntrue; tmux wait -S done\r"]
[88.876055, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
