[283.220182, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\nset -e\nfilter=$(yq -r '.filter' /app/jq_args.yaml)\nargs=$(yq -r '.args[]' /app/jq_args.yaml)\nexpected=$(mktemp)\njq --indent 2 \"$filter\" /app/users.json > \"$expected\"\ncmp -s \"$expected\" /app/active_users_report.json\njq -e 'all(.[]; .status == \"active\")' /app/users.json >/dev/null\njq -e 'type == \"array\" and (map(.username) == (map(.username) | sort)) and all(.[]; (.role_count == (([.[ ]][0:0])|length) or .role_count >= 0))' /app/active_users_report.json >/dev/null\nrm -f \"$expected\"\nprintf 'YAML reconstruction and output equivalence: OK\\n'\nprintf 'Output users: '\njq 'length' /app/active_users_report.json\nprintf 'Pretty indentation sample: '\njq -e '.[0].user_id == 273' /app/active_users_report.json >/dev/null && echo OK\ntrue; tmux wait -S done\r"]
