[324.813587, "o", "content = 'import json\\nfrom pathlib import Path\\n\\nfrom aggregate_records import aggregate_files\\n\\n\\ndef write_records(path: Path, records: list[dict]) -> None:\\n    path.write_text(\"\".join(json.dumps(record) + \"\\\\n\" for record in records), encoding=\"utf-8\")\\n\\n\\ndef test_aggregates_users_tags_and_rounds_amounts(tmp_path: Path) -> None:\\n    first = tmp_path / \"records_1.jsonl\"\\n    second = tmp_path / \"records_2.jsonl\"\\n    write_records(\\n        first,\\n        [\\n            {\"user\": \"bob\", \"amount\": 1.005, \"items\": 2, \"tags\": [\"z\", \"a\"]},\\n            {\"user\": \"alice\", \"amount\": 10.10, \"items\": 3, \"tags\": [\"a\", \"a\"]},\\n        ],\\n    )\\n    write_records(\\n        second,\\n        [\\n            {\"user\": \"bob\", \"amount\": 2.005, \"items\": 4, \"tags\": [\"a\"]},\\n            {\"user\": \"alice\", \"amount\": 1, \"items\": 1, \"tags\": [\"z\"]},\\n        ],\\n    )\\n\\n    result = aggregate_files([first, second])\\n\\n    assert result == {\\n        \"top_5_users_by_amount\": {\\n            \"alice\": {\"total_amount\": 11.10, \"total_items\": 4},\\n            \"bob\": {\"total_amount\": 3.01, \"total_items\": 6},\\n        },\\n        \"top_5_tags_by_count\": {\\n            \"a\": {\"count\": 3},\\n            \"z\": {\"count\": 2},\\n        },\\n    }\\n\\n\\ndef test_limits_results_and_breaks_ties_by_name(tmp_path: Path) -> None:\\n    path = tmp_path / \"records_1.jsonl\"\\n    records = [\\n        {\"user\": name, \"amount\": 1, \"items\": 1, \"tags\": [tag]}\\n        for name, tag in [(\"e\", \"e\"), (\"d\", \"d\"), (\"c\", \"c\"), (\"b\", \"b\"), (\"a\", \"a\"), (\"f\", \"f\")]\\n    ]\\n    write_records(path, records)\\n\\n    result = aggregate_files([path])\\n\\n    assert list(result[\"top_5_users_by_amount\"]) == [\"a\", \"b\", \"c\", \"d\", \"e\"]\\n    assert list(result[\"top_5_tags_by_count\"]) == [\"a\", \"b\", \"c\", \"d\", \"e\"]\\n'\r\n\u001b[?2004l\r"]
