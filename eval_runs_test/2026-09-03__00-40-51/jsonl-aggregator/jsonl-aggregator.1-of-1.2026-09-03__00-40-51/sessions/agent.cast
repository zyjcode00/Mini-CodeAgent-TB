[382.482353, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - <<'PY'\nimport json\nfrom pathlib import Path\np = Path('/app/aggregates.json')\nobj = json.loads(p.read_text(encoding='utf-8'))\nassert set(obj) == {'top_5_users_by_amount', 'top_5_tags_by_count'}\nassert isinstance(obj['top_5_users_by_amount'], dict)\nassert isinstance(obj['top_5_tags_by_count'], dict)\nusers = obj['top_5_users_by_amount']\nprev_amount = None\nprev_name = None\nfor name, payload in users.items():\n    assert isinstance(payload['total_amount'], float)\n    assert isinstance(payload['total_items'], int)\n    if prev_amount is not None:\n        assert payload['total_amount'] <= prev_amount + 1e-9 or (payload['total_amount'] == prev_amount and name >= prev_name)\n    prev_amount = payload['total_amount']\n    prev_name = name\n\ntags = obj['top_5_tags_by_count']\nprev_count = None\nprev_tag = None\nfor tag, payload in tags.items():\n    assert isinstance(payload['count'], int)\n    if prev_count is not None:\n        assert payload['count'] <= prev_count or (payload['count'] == prev_count and tag >= prev_tag)\n    prev_count = payload['count']\n    prev_tag = tag\n\nprint('output validation ok')\nPY\ntrue; tmux wait -S done\r"]
