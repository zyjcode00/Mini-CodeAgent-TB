[493.031655, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - <<'PY'\nimport json\nimport re\nfrom pathlib import Path\n\noutput = Path('/app/aggregates.json')\ndata = json.loads(output.read_text(encoding='utf-8'))\nassert list(data) == ['top_5_users_by_amount', 'top_5_tags_by_count']\nusers = data['top_5_users_by_amount']\ntags = data['top_5_tags_by_count']\nassert len(users) == 5\nassert len(tags) == 5\nraw = output.read_text(encoding='utf-8')\nfor name, value in users.items():\n    assert isinstance(value['total_amount'], float)\n    assert isinstance(value['total_items'], int) and not isinstance(value['total_items'], bool)\n    assert re.search(r'\"total_amount\": -?\\d+\\.\\d{2}', raw)\nuser_rows = [(name, value['total_amount']) for name, value in users.items()]\nassert user_rows == sorted(user_rows, key=lambda row: (-row[1], row[0]))\nfor name, value in tags.items():\n    assert isinstance(value['count'], int) and not isinstance(value['count'], bool)\ntag_rows = [(name, value['count']) for name, value in tags.items()]\nassert tag_rows == sorted(tag_rows, key=lambda row: (-row[1], row[0]))\nprint('validated: 5 users, 5 tags, ordered values, two-decimal amounts, integer counts')\nPY\ntrue; tmux wait -S done\r"]
[493.032359, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
[493.032459, "o", "\u001b[?2004hroot@4c37174160ca:/app# "]
[493.032629, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[493.0328, "o", "\u001b[?2004h> import json\r\n\u001b[?2004l\r"]
[493.032962, "o", "\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r"]
[493.033311, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> output = Path('/app/aggregates.json')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[493.033578, "o", "data = json.loads(output.read_text(encoding='utf-8'))\r\n\u001b[?2004l\r\u001b[?2004h"]
[493.033821, "o", "> "]
[493.033949, "o", "assert list(data) == ['top_5_users_by_amount', 'top_5_tags_by_count']\r\n\u001b[?2004l\r"]
[493.034191, "o", "\u001b[?2004h> "]
[493.034511, "o", "users = data['top_5_users_by_amount']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[493.034769, "o", "tags = data['top_5_tags_by_count']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[493.034898, "o", "assert len(users) == 5\r\n\u001b[?2004l\r\u001b[?2004h> assert len(tags) == 5\r\n\u001b[?2004l\r"]
[493.035129, "o", "\u001b[?2004h> "]
[493.035297, "o", "raw = output.read_text(encoding='utf-8')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[493.035475, "o", "for name, value in users.items():\r\n\u001b[?2004l\r"]
[493.035664, "o", "\u001b[?2004h> "]
[493.035888, "o", "    assert isinstance(value['total_amount'], float)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[493.036225, "o", "    assert isinstance(value['total_items'], int) and not isinstance(value['total_items'], bool)\r\n\u001b[?2004l\r\u001b[?2004h"]
[493.036389, "o", "> "]
[493.036529, "o", "    assert re.search(r'\"total_amount\": -?\\d+\\.\\d{2}', raw)\r\n\u001b[?2004l\r"]
[493.036696, "o", "\u001b[?2004h> "]
[493.037141, "o", "user_rows = [(name, value['total_amount']) for name, value in users.items()]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[493.037461, "o", "assert user_rows == sorted(user_rows, key=lambda row: (-row[1], row[0]))\r\n\u001b[?2004l\r\u001b[?2004h"]
[493.037659, "o", "> "]
