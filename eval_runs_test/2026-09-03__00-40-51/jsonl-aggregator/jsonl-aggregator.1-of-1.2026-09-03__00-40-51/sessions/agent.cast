[249.93562, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\nfind /app -maxdepth 1 -type f -name '*.jsonl' -printf '%f\\n' | sort && printf '\\n--- line counts ---\\n' && wc -l /app/*.jsonl 2>/dev/null && printf '\\n--- samples ---\\n' && for f in $(find /app -maxdepth 1 -type f -name '*.jsonl' | sort); do printf '\\n%s\\n' \"$f\"; sed -n '1,3p' \"$f\"; done\ntrue; tmux wait -S done\r"]
