[423.87879, "o", "\u001b[?2004hroot@4c37174160ca:/app# "]
[446.194579, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\nPYTHONPATH=/app python3 - <<'PY'\nimport json\nimport tempfile\nfrom pathlib import Path\nfrom aggregate_records import aggregate_files\n\n\ndef write_records(path, records):\n    path.write_text(''.join(json.dumps(record) + '\\n' for record in records), encoding='utf-8')\n\nwith tempfile.TemporaryDirectory() as directory:\n    root = Path(directory)\n    first, second = root / 'records_1.jsonl', root / 'records_2.jsonl'\n    write_records(first, [\n        {'user': 'bob', 'amount': 1.005, 'items': 2, 'tags': ['z', 'a']},\n        {'user': 'alice', 'amount': 10.10, 'items': 3, 'tags': ['a', 'a']},\n    ])\n    write_records(second, [\n        {'user': 'bob', 'amount': 2.005, 'items': 4, 'tags': ['a']},\n        {'user': 'alice', 'amount': 1, 'items': 1, 'tags': ['z']},\n    ])\n    assert aggregate_files([first, second]) == {\n        'top_5_users_by_amount': {\n            'alice': {'total_amount': 11.1, 'total_items': 4},\n            'bob': {'total_amount': 3.01, 'total_items': 6},\n        },\n        'top_5_tags_by_count': {'a': {'count': 4}, 'z': {'count': 2}},\n    }\n    tie_file = root / 'records_3.jsonl'\n    write_records(tie_file, [\n        {'user': name, 'amount': 1, 'items': 1, 'tags': [tag]}\n        for name, tag in [('e','e'), ('d','d'), ('c','c'), ('b','b'), ('a','a'), ('f','f')]\n    ])\n    tie_result = aggregate_files([tie_file])\n    assert list(tie_result['top_5_users_by_amount']) == ['a', 'b', 'c', 'd', 'e']\n    assert list(tie_result['top_5_tags_by_count']) == ['a', 'b', 'c', 'd', 'e']\nprint('custom aggregation tests passed')\nPY\ntrue; tmux wait -S done\r"]
[446.195098, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
