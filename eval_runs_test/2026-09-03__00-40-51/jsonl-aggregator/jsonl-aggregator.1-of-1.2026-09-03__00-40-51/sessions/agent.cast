[493.038231, "o", "    assert isinstance(value['count'], int) and not isinstance(value['count'], bool)\r\n\u001b[?2004l\r\u001b[?2004h"]
[493.038418, "o", "> "]
[493.038544, "o", "tag_rows = [(name, value['count']) for name, value in tags.items()]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[493.038864, "o", "assert tag_rows == sorted(tag_rows, key=lambda row: (-row[1], row[0]))\r\n\u001b[?2004l\r\u001b[?2004h> "]
