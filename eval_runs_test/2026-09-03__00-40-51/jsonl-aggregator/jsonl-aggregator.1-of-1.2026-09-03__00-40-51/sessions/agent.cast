[382.304891, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - <<'PY'\nimport json\nimport tempfile\nfrom pathlib import Path\nfrom aggregate_records import aggregate_files\n\n\ndef write_records(path: Path, records):\n    path.write_text(''.join(json.dumps(record) + '\\n' for record in records), encoding='utf-8')\n\nwith tempfile.TemporaryDirectory() as tmp:\n    tmp_path = Path(tmp)\n    first = tmp_path / 'records_1.jsonl'\n    second = tmp_path / 'records_2.jsonl'\n    write_records(first, [\n        {'user': 'bob', 'amount': 1.005, 'items': 2, 'tags': ['z', 'a']},\n        {'user': 'alice', 'amount': 10.10, 'items': 3, 'tags': ['a', 'a']},\n    ])\n    write_records(second, [\n        {'user': 'bob', 'amount': 2.005, 'items': 4, 'tags': ['a']},\n        {'user': 'alice', 'amount': 1, 'items': 1, 'tags': ['z']},\n    ])\n    result = aggregate_files([first, second])\n    assert result == {\n        'top_5_users_by_amount': {\n            'alice': {'total_amount': 11.1, 'total_items': 4},\n            'bob': {'total_amount': 3.01, 'total_items': 6},\n        },\n        'top_5_tags_by_count': {\n            'a': {'count': 3},\n            'z': {'count': 2},\n        },\n    }\n\n    path = tmp_path / 'records_3.jsonl'\n    write_records(path, [\n        {'user': name, 'amount': 1, 'items': 1, 'tags': [tag]}\n        for name, tag in [('e', 'e'), ('d', 'd'), ('c', 'c'), ('b', 'b'), ('a', 'a'), ('f', 'f')]\n    ])\n    result2 = aggregate_files([path])\n    assert list(result2['top_5_users_by_amount']) == ['a', 'b', 'c', 'd', 'e']\n    assert list(result2['top_5_tags_by_count']) == ['a', 'b', 'c', 'd', 'e']\n\nprint('custom tests ok')\nPY\ntrue; tmux wait -S done\r"]
[382.306211, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
[382.306446, "o", "\u001b[?2004hroot@4c37174160ca:/app# "]
[382.306615, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[382.306729, "o", "import json\r\n\u001b[?2004l\r\u001b[?2004h> "]
[382.307014, "o", "import tempfile\r\n\u001b[?2004l\r\u001b[?2004h> "]
[382.307247, "o", "from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> "]
[382.307372, "o", "from aggregate_records import aggregate_files\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
