Sending keys: ['export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/aggregate_records.py <<\'PY\'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = \'#!/usr/bin/env python3\\n"""Aggregate record JSONL files into a compact JSON summary."""\\n\\nfrom __future__ import annotations\\n\\nimport argparse\\nimport json\\nfrom collections import Counter, defaultdict\\nfrom decimal import Decimal, ROUND_HALF_UP\\nfrom pathlib import Path\\nfrom typing import Iterable\\n\\n\\nCENT = Decimal("0.01")\\n\\n\\ndef aggregate_files(input_files: Iterable[Path]) -> dict:\\n    """Return the requested top-five user and tag aggregates."""\\n    user_amounts: defaultdict[str, Decimal] = defaultdict(lambda: Decimal("0"))\\n    user_items: defaultdict[str, int] = defaultdict(int)\\n    tag_counts: Counter[str] = Counter()\\n\\n    for input_file in input_files:\\n        with input_file.open("r", encoding="utf-8") as stream:\\n            for line_number, line in enumerate(stream, 1):\\n                if not line.strip():\\n                    continue\\n                try:\\n                    record = json.loads(line)\\n                except json.JSONDecodeError as exc:\\n                    raise ValueError(f"Invalid JSON in {input_file}:{line_number}") from exc\\n\\n                user = record["user"]\\n                user_amounts[user] += Decimal(str(record["amount"]))\\n                user_items[user] += int(record["items"])\\n                tag_counts.update(record.get("tags", []))\\n\\n    top_users = sorted(\\n        user_amounts,\\n        key=lambda user: (-user_amounts[user], user),\\n    )[:5]\\n    top_tags = sorted(\\n        tag_counts,\\n        key=lambda tag: (-tag_counts[tag], tag),\\n    )[:5]\\n\\n    return {\\n        "top_5_users_by_amount": {\\n            user: {\\n                "total_amount": float(user_amounts[user].quantize(CENT, rounding=ROUND_HALF_UP)),\\n                "total_items": int(user_items[user]),\\n            }\\n            for user in top_users\\n        },\\n        "top_5_tags_by_count": {\\n            tag: {"count": int(tag_counts[tag])}\\n            for tag in top_tags\\n        },\\n    }\\n\\n\\ndef main() -> None:\\n    parser = argparse.ArgumentParser(description=__doc__)\\n    parser.add_argument(\\n        "--input-dir",\\n        type=Path,\\n        default=Path("/app"),\\n        help="Directory containing records_*.jsonl files (default: /app)",\\n    )\\n    parser.add_argument(\\n        "--output",\\n        type=Path,\\n        default=Path("/app/aggregates.json"),\\n        help="Output JSON path (default: /app/aggregates.json)",\\n    )\\n    args = parser.parse_args()\\n\\n    input_files = sorted(args.input_dir.glob("records_*.jsonl"))\\n    if not input_files:\\n        raise SystemExit(f"No records_*.jsonl files found in {args.input_dir}")\\n\\n    result = aggregate_files(input_files)\\n    args.output.write_text(\\n        json.dumps(result, indent=2, ensure_ascii=True) + "\\\\n",\\n        encoding="utf-8",\\n    )\\n\\n\\nif __name__ == "__main__":\\n    main()\\n\'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, \'w\', encoding=\'utf-8\', newline=\'\\n\') as f:\n        f.write(content)\n    print(f"成功: 已写入 {path}")\nexcept Exception as exc:\n    print(f"写入失败: {exc}")\nPY\ntrue', '; tmux wait -S done', 'Enter'] min_timeout_sec: 0.0 max_timeout_sec: inf
