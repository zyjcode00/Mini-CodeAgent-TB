[256.480245, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/test_recover_obfuscated.py <<'PY'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = 'import base64\\nfrom pathlib import Path\\n\\nimport pytest\\n\\nfrom recover_obfuscated import RecoveryError, recover_directory\\n\\n\\ndef encoded_name(name: str) -> str:\\n    return base64.b64encode(name.encode()).decode() + \".b64_content\"\\n\\n\\ndef test_recover_directory_decodes_names_and_contents(tmp_path: Path):\\n    source = tmp_path / \"source\"\\n    output = tmp_path / \"output\"\\n    source.mkdir()\\n    (source / encoded_name(\"credentials.txt\")).write_bytes(\\n        base64.b64encode(b\"user: test\\\\npassword: value\\\\n\")\\n    )\\n    (source / encoded_name(\"events.log\")).write_bytes(\\n        b\"TGluZSAx\\\\nTGluZSAy\\\\n\"\\n    )\\n    (source / \"ignore.me\").write_bytes(b\"ignored\")\\n\\n    recovered = recover_directory(source, output)\\n\\n    assert [path.name for path in recovered] == [\"credentials.txt\", \"events.log\"]\\n    assert (output / \"credentials.txt\").read_bytes() == b\"user: test\\\\npassword: value\\\\n\"\\n    assert (output / \"events.log\").read_bytes() == b\"Line 1Line 2\"\\n\\n\\ndef test_recovery_is_repeatable(tmp_path: Path):\\n    source = tmp_path / \"source\"\\n    output = tmp_path / \"output\"\\n    source.mkdir()\\n    (source / encoded_name(\"note.txt\")).write_bytes(base64.b64encode(b\"same content\"))\\n\\n    recover_directory(source, output)\\n    recover_directory(source, output)\\n\\n    assert (output / \"note.txt\").read_bytes() == b\"same content\"\\n    assert list(output.glob(\".*\")) == []\\n\\n\\ndef test_unsafe_decoded_filename_is_rejected(tmp_path: Path):\\n    source = tmp_path / \"source\"\\n    output = tmp_path / \"output\"\\n    source.mkdir()\\n    (source / encoded_name(\"../outside.txt\")).write_bytes(base64.b64encode(b\"nope\"))\\n\\n    with pytest.raises(RecoveryError, match=\"unsafe decoded filename\"):\\n        recover_directory(source, output)\\n    assert not (tmp_path / \"outside.txt\").exists()\\n'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, 'w', encoding='utf-8', newline='\\n') as f:\n        f.write(content)\n    print(f\"成功: 已写入 {path}\")\nexcept Exception as exc:\n    print(f\"写入失败: {exc}\")\nPY\ntrue; tmux wait -S done\r"]
