[165.270728, "o", "content = '#!/usr/bin/env python3\\n\"\"\"Recover files whose names and contents were encoded with Base64.\"\"\"\\n\\nfrom __future__ import annotations\\n\\nimport argparse\\nimport base64\\nimport binascii\\nimport os\\nimport tempfile\\nfrom pathlib import Path\\n\\nSUFFIX = \".b64_content\"\\n\\n\\nclass RecoveryError(ValueError):\\n    \"\"\"Raised when an obfuscated file does not have a safe valid format.\"\"\"\\n\\n\\ndef decode_base64(value: bytes, *, label: str, allow_whitespace: bool = False) -> bytes:\\n    if allow_whitespace:\\n        value = b\"\".join(value.split())\\n    try:\\n        return base64.b64decode(value, validate=True)\\n    except (binascii.Error, ValueError) as exc:\\n        raise RecoveryError(f\"invalid Base64 {label}\") from exc\\n\\n\\ndef decode_filename(encoded: str) -> str:\\n    decoded = decode_base64(encoded.encode(\"ascii\"), label=\"filename\")\\n    try:\\n        filename = decoded.decode(\"utf-8\")\\n    except UnicodeDecodeError as exc:\\n        raise RecoveryError(\"decoded filename is not UTF-8\") from exc\\n\\n    # Only a plain filename is allowed; decoded paths must never escape output_dir.\\n    if not filename or filename in {\".\", \"..\"} or \"/\" in filename or \"\\\\\\\\\" in filename or \"\\\\x00\" in filename:\\n        raise RecoveryError(f\"unsafe decoded filename: {filename!r}\")\\n    return filename\\n\\n\\ndef recover_file(source: Path, output_dir: Path) -> Path:\\n    if not source.name.endswith(SUFFIX):\\n        raise RecoveryError(f\"unsupported source file: {source.name}\")\\n    encoded_name = source.name[: -len(SUFFIX)]\\n    filename = decode_filename(encoded_name)\\n    content = decode_base64(source.read_bytes(), label=f\"content of {source.name}\", allow_whitespace=True)\\n\\n    output_dir.mkdir(parents=True, exist_ok=True)\\n    destination = output_dir / filename\\n    # Replace only a regular output path; a symlink could redirect writes elsewhere.\\n    if destination.exists() and destination.is_symlink():\\n        raise RecoveryError(f\"refusing to overwrite symlink: {destination}\")\\n    with tempfile.NamedTemporaryFile(dir=output_dir, prefix=f\".{filename}.\", delete=False) as handle:\\n        temporary = Path(handle.name)\\n        handle.write(content)\\n        handle.flush()\\n        os.fsync(handle.fileno())\\n    try:\\n        os.replace(temporary, destination)\\n    except Exception:\\n        temporary.unlink(missing_ok=True)\\n        raise\\n    return destination\\n\\n\\ndef recover_directory(input_dir: Path, output_dir: Path) -> list[Path]:\\n    if not input_dir.is_dir():\\n        raise RecoveryError(f\"input directory does not exist: {input_dir}\")\\n    sources = sorted(path for path in input_dir.iterdir() if path.is_file() and path.name.endswith(SUFFIX))\\n    recovered = []\\n    for source in sources:\\n        recovered.append(recover_file(source, output_dir))\\n    return recovered\\n\\n\\ndef main() -> int:\\n    parser = argparse.ArgumentParser(description=__doc__)\\n    parser.add_argument(\"input_dir\", nargs=\"?\", type=Path, default=Path(\"/app/sensitive_data\"))\\n    parser.add_argument(\"output_dir\", nargs=\"?\", type=Path, default=Path(\"/app/recovered\"))\\n    args = parser.parse_args()\\n    try:\\n        recovered = recover_directory(args.input_dir, args.output_dir)\\n    except (OSError, RecoveryError) as exc:\\n        parser.error(str(exc))\\n    for path in recovered:\\n        print(path)\\n    print(f\"Recovered {len(recovered)} file(s).\")\\n    return 0\\n\\n\\nif __name__ == \"__main__\":\\n    raise SystemExit(main())\\n'\r\n"]
