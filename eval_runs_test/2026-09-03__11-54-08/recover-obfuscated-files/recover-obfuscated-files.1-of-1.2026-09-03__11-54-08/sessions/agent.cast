[360.476397, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 -m unittest -v /app/test_recover_obfuscated.py && python3 - <<'PY'\nimport base64\nfrom pathlib import Path\n\nsource = Path('/app/sensitive_data')\noutput = Path('/app/recovered')\ninputs = sorted(p for p in source.iterdir() if p.is_file() and p.name.endswith('.b64_content'))\nexpected = sorted(base64.b64decode(p.name[:-len('.b64_content')]).decode('utf-8') for p in inputs)\nactual = sorted(p.name for p in output.iterdir() if p.is_file())\nassert len(inputs) == 2, (len(inputs), inputs)\nassert actual == expected, (actual, expected)\nfor path in inputs:\n    name = base64.b64decode(path.name[:-len('.b64_content')]).decode('utf-8')\n    encoded = b''.join(path.read_bytes().split())\n    assert (output / name).read_bytes() == base64.b64decode(encoded, validate=True)\nassert not list(output.glob('.*'))\nprint(f'Validated {len(inputs)} recovered files: {\", \".join(actual)}')\nPY\ntrue; tmux wait -S done\r"]
