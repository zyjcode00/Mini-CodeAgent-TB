[328.710309, "o", "python3 - /app/test_recover_obfuscated.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.710478, "o", "import sys\r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.710662, "o", "path = sys.argv[1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.717641, "o", "content = 'import base64\\nimport tempfile\\nimport unittest\\nfrom pathlib import Path\\n\\nfrom recover_obfuscated import RecoveryError, recover_directory\\n\\n\\ndef encoded_name(name: str) -> str:\\n    return base64.b64encode(name.encode()).decode() + \".b64_content\"\\n\\n\\nclass RecoveryTests(unittest.TestCase):\\n    def test_recover_directory_decodes_names_and_contents(self):\\n        with tempfile.TemporaryDirectory() as directory:\\n            root = Path(directory)\\n            source = root / \"source\"\\n            output = root / \"output\"\\n            source.mkdir()\\n            (source / encoded_name(\"credentials.txt\")).write_bytes(\\n                base64.b64encode(b\"user: test\\\\npassword: value\\\\n\")\\n            )\\n            (source / encoded_name(\"events.log\")).write_bytes(b\"TGluZSAx\\\\nTGluZSAy\\\\n\")\\n            (source / \"ignore.me\").write_bytes(b\"ignored\")\\n\\n            recovered = recover_directory(source, output)\\n\\n            self.assertEqual([path.name for path in recovered], [\"credentials.txt\", \"events.log\"])\\n            self.assertEqual((output / \"credentials.txt\").read_bytes(), b\"user: test\\\\npassword: value\\\\n\")\\n            self.assertEqual((output / \"events.log\").read_bytes(), b\"Line 1Line 2\")\\n\\n    def test_recovery_is_repeatable(self):\\n        with tempfile.TemporaryDirectory() as directory:\\n            root = Path(directory)\\n            source = root / \"source\"\\n            output = root / \"output\"\\n            source.mkdir()\\n            (source / encoded_name(\"note.txt\")).write_bytes(base64.b64encode(b\"same content\"))\\n\\n            recover_directory(source, output)\\n            recover_directory(source, output)\\n\\n            self.assertEqual((output / \"note.txt\").read_bytes(), b\"same content\")\\n            self.assertEqual(list(output.glob(\".*\")), [])\\n\\n    def test_unsafe_decoded_filename_is_rejected(self):\\n        with tempfile.TemporaryDirectory() as directory:\\n            root = Path(directory)\\n            source = root / \"source\"\\n            output = root / \"output\"\\n            source.mkdir()\\n            (source / encoded_name(\"../outside.txt\")).write_bytes(base64.b64encode(b\"nope\"))\\n\\n            with self.assertRaisesRegex(RecoveryError, \"unsafe decoded filename\"):\\n                recover_directory(source, output)\\n            self.assertFalse((root / \"outside.txt\").exists())\\n\\n\\nif __name__ == \"__main__\":\\n    unittest.main()\\n'\r\n\u001b[?2004l\r"]
