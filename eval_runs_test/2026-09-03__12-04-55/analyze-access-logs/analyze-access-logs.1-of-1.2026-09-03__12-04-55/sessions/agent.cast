[118.740521, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\nawk 'NF < 9 {bad++} {req++; ip[$1]++; url[$7]++; if ($9 == 404) e404++} END {print \"Total requests:\", req; print \"Unique IP addresses:\", length(ip); print \"404 errors:\", e404+0; for (u in url) print url[u], u}' /app/access_log | sort -k1,1nr -k2,2 | head -n 12\ntrue; tmux wait -S done\r"]
