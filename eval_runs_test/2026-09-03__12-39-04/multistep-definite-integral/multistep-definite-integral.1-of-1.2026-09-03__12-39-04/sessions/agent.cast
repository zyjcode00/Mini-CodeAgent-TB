[75.482304, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython - <<'PY'\nimport sympy as sp\nx = sp.symbols('x')\nresult = sp.simplify(sp.integrate(x**2 * sp.exp(x), (x, 0, 1)))\nwith open('/app/output.txt', 'w') as f:\n    f.write(str(result))\nprint(result)\nPY\ntrue; tmux wait -S done\r"]
