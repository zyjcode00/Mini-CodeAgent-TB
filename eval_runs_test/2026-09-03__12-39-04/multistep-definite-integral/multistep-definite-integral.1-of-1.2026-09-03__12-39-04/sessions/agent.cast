[100.771846, "o", "import sympy as sp\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.772176, "o", "content = Path('/app/output.txt').read_text().strip()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.772384, "o", "expected = sp.E - 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.772589, "o", "actual = sp.sympify(content)\r\n\u001b[?2004l\r\u001b[?2004h"]
[100.7727, "o", "> "]
[100.77292, "o", "assert sp.simplify(actual - expected) == 0, (content, expected)\r\n\u001b[?2004l\r"]
[100.773029, "o", "\u001b[?2004h> "]
[100.773157, "o", "print(content)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[100.77327, "o", "PY\r\n\u001b[?2004l\r"]
[101.039912, "o", "-2 + E\r\n"]
[101.121853, "o", "\u001b[?2004hroot@80602f3af173:/app# "]
[101.122033, "o", "true; tmux wait -S done\r\n"]
[101.122136, "o", "\u001b[?2004l\r"]
[101.125647, "o", "\u001b[?2004hroot@80602f3af173:/app# "]
