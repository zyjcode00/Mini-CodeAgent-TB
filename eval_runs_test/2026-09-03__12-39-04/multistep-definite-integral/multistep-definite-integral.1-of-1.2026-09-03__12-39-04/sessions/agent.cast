[100.770888, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython - <<'PY'\nfrom pathlib import Path\nimport sympy as sp\ncontent = Path('/app/output.txt').read_text().strip()\nexpected = sp.E - 2\nactual = sp.sympify(content)\nassert sp.simplify(actual - expected) == 0, (content, expected)\nprint(content)\nPY\ntrue; tmux wait -S done\r"]
