[212.482795, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - <<'PY'\nimport csv, json\nfrom pathlib import Path\ncsv_path=Path('/app/data/bank_transactions.csv')\njson_path=Path('/app/data/output.json')\nallowed_accounts={'BUS-30001','BUS-30999','BUS-35001'}\nallowed_names={'North West Capital Group Incorporated','North West Capital Group Incoporated','NWCG Inc. Pty. Ltd.'}\nwith csv_path.open(newline='', encoding='utf-8') as f:\n    rows=list(csv.DictReader(f))\nexpected=[]\nfor n,r in enumerate(rows,2):\n    if r['Account Number'] in allowed_accounts or r['Company Name'] in allowed_names:\n        expected.append((n,r))\nwith json_path.open(encoding='utf-8') as f:\n    data=json.load(f)\nactual={(tuple(o.items())) for o in data}\nprint('expected count',len(expected))\nfor n,r in sorted(expected, key=lambda x:x[1]['Date']):\n    marker='OK' if tuple(r.items()) in actual else 'MISSING'\n    print(marker,n,r)\nPY\ntrue; tmux wait -S done\r"]
