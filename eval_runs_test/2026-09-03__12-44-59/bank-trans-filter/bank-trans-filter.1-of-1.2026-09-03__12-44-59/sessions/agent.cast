[66.149758, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - <<'PY'\nimport csv\nfrom collections import Counter, defaultdict\np='/app/data/bank_transactions.csv'\nwith open(p,newline='',encoding='utf-8') as f:\n    rows=list(csv.DictReader(f))\nprint('rows',len(rows),'fields',list(rows[0]))\nfor i,r in enumerate(rows,2):\n    text=' '.join(r.values()).lower()\n    if any(x in text for x in ('north','west','capital')):\n        print(i,repr(r))\nprint('candidate account counts')\naccounts=Counter(r['Account Number'] for r in rows if any(x in ' '.join(r.values()).lower() for x in ('north','west','capital')))\nprint(accounts)\nPY\ntrue; tmux wait -S done\r"]
