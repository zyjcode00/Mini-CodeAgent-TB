[191.394886, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - <<'PY'\nimport csv, json, sys\nfrom pathlib import Path\ncsv_path = Path('/app/data/bank_transactions.csv')\njson_path = Path('/app/data/output.json')\nexpected_keys = [\"Company Name\", \"Account Number\", \"Date\", \"Amount\", \"Transaction Type\", \"Description\"]\nallowed_accounts = {'BUS-30001','BUS-30999','BUS-35001'}\nallowed_names = {\n    'North West Capital Group Incorporated',\n    'North West Capital Group Incoporated',\n    'NWCG Inc. Pty. Ltd.',\n}\nwith csv_path.open(newline='', encoding='utf-8') as f:\n    rows = list(csv.DictReader(f))\nexpected = [r for r in rows if r['Account Number'] in allowed_accounts or r['Company Name'] in allowed_names]\nexpected = sorted(expected, key=lambda r: r['Date'])\nwith json_path.open(encoding='utf-8') as f:\n    data = json.load(f)\nassert isinstance(data, list), type(data)\nassert len(data) == len(expected), (len(data), len(expected))\nfor idx, obj in enumerate(data):\n    assert list(obj.keys()) == expected_keys, (idx, list(ob"]
[191.395014, "i", "j.keys()))\n    assert all(isinstance(v, str) for v in obj.values()), (idx, obj)\n    src = expected[idx]\n    for k in expected_keys:\n        assert obj[k] == src[k], (idx, k, obj[k], src[k])\nassert [x['Date'] for x in data] == sorted(x['Date'] for x in data), [x['Date'] for x in data]\nprint('Validation passed:', len(data), 'rows')\nfor row in data:\n    print(row)\nPY\ntrue; tmux wait -S done\r"]
