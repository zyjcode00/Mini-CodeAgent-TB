[233.177982, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - <<'PY'\nimport csv, json\nfrom pathlib import Path\ncsv_path = Path('/app/data/bank_transactions.csv')\nout_path = Path('/app/data/output.json')\nallowed_accounts = {'BUS-30001','BUS-30999','BUS-35001'}\nallowed_names = {'North West Capital Group Incorporated','North West Capital Group Incoporated','NWCG Inc. Pty. Ltd.'}\nkeys = ['Company Name','Account Number','Date','Amount','Transaction Type','Description']\nwith csv_path.open(newline='', encoding='utf-8') as f:\n    rows = list(csv.DictReader(f))\nfiltered = [ {k:r[k] for k in keys} for r in rows if r['Account Number'] in allowed_accounts or r['Company Name'] in allowed_names ]\nfiltered.sort(key=lambda r: r['Date'])\nout_path.write_text(json.dumps(filtered, indent=2, ensure_ascii=False) + '\\n', encoding='utf-8')\nprint('wrote', len(filtered), 'rows')\nPY\ntrue; tmux wait -S done\r"]
