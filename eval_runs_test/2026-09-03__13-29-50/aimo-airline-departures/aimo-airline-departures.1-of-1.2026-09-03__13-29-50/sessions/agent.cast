[670.848268, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 -m py_compile /app/airline_analysis.py /app/test_airline_analysis.py && python3 - <<'PY'\nimport importlib.util\nimport tempfile\nfrom pathlib import Path\n\nspec = importlib.util.spec_from_file_location('airline_analysis', '/app/airline_analysis.py')\nmodule = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(module)\nassert module.longest_no_flight_streak((0, 0, 0)) == 99\nassert module.solve() == 79\nwith tempfile.TemporaryDirectory() as directory:\n    original = module.RESULT_PATH\n    module.RESULT_PATH = Path(directory) / 'results.txt'\n    module.main()\n    assert module.RESULT_PATH.read_text(encoding='utf-8') == '79\\n'\n    module.RESULT_PATH = original\nprint('standard-library tests passed')\nPY\npython3 /app/airline_analysis.py\npython3 - <<'PY'\nfrom pathlib import Path\ncontent = Path('/app/results.txt').read_text(encoding='utf-8')\nassert content == '79\\n', repr(content)\nprint(content, end='')\nPY\ntrue; tmux wait -S done\r"]
