[648.970402, "o", "old_str = \"        assert module.RESULT_PATH.read_text(encoding='utf-8') == '83\\\\n'\\n\"\r\n\u001b[?2004l\r"]
[648.970535, "o", "\u001b[?2004h> "]
[648.970825, "o", "new_str = \"        assert module.RESULT_PATH.read_text(encoding='utf-8') == '79\\\\n'\\n\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[648.971039, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[648.971201, "o", "def normalize_text(text: str) -> str:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[648.971434, "o", "    text = text.replace('\\r\\n', '\\n').replace('\\r', '\\n')\r\n\u001b[?2004l\r\u001b[?2004h"]
[648.97154, "o", "> "]
[648.971792, "o", "    return '\\n'.join(line.rstrip() for line in text.split('\\n'))\r\n\u001b[?2004l\r\u001b[?2004h"]
[648.971918, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> try:\r\n\u001b[?2004l\r"]
[648.972012, "o", "\u001b[?2004h> "]
[648.972304, "o", "    with open(path, 'r', encoding='utf-8', errors='replace') as f:\r\n\u001b[?2004l\r"]
[648.972391, "o", "\u001b[?2004h> "]
[648.972477, "o", "        content = f.read()\r\n\u001b[?2004l\r"]
[648.972577, "o", "\u001b[?2004h> "]
[648.972681, "o", "except FileNotFoundError:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[648.972878, "o", "    print(f\"错误: 找不到文件 {path}\")\r\n\u001b[?2004l\r"]
[648.97308, "o", "\u001b[?2004h> "]
[648.973181, "o", "    raise SystemExit(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[648.97329, "o", "except Exception as exc:\r\n\u001b[?2004l\r"]
[648.973539, "o", "\u001b[?2004h> "]
[648.973726, "o", "    print(f\"修改失败: {exc}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[648.973841, "o", "> "]
[648.973957, "o", "    raise SystemExit(0)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[648.974267, "o", "\u001b[?2004l\r"]
[648.974438, "o", "\u001b[?2004h> content = normalize_text(content)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[648.97457, "o", "old_str = normalize_text(old_str)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[648.974773, "o", "new_str = normalize_text(new_str)\r\n\u001b[?2004l\r"]
[648.97488, "o", "\u001b[?2004h> "]
[648.974982, "o", "count = content.count(old_str)\r\n\u001b[?2004l\r"]
[648.975018, "o", "\u001b[?2004h> "]
[648.975122, "o", "if count == 0:\r\n\u001b[?2004l\r"]
[648.975223, "o", "\u001b[?2004h> "]
[648.976097, "o", "    print(\"错误: 在文件中找不到 old_str。\\n建议：\\n1. 使用 read_file(raw_mode=True) 获取原始内容\\n2. 检查是否有多余的空格或换行符\\n3. 如果文件较大，考虑使用 write_full_file 全量覆盖\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[648.976266, "o", "    raise SystemExit(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[648.976446, "o", "> if count > 1:\r\n\u001b[?2004l\r"]
[648.976516, "o", "\u001b[?2004h> "]
[648.976865, "o", "    print(f\"错误: 匹配到 {count} 处相同的代码，请提供更具体的 old_str 以确保唯一性。\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[648.976964, "o", "> "]
[648.977044, "o", "    raise SystemExit(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[648.977192, "o", "> "]
[648.977391, "o", "with open(path, 'w', encoding='utf-8', newline='\\n') as f:\r\n\u001b[?2004l\r"]
[648.977505, "o", "\u001b[?2004h> "]
[648.977737, "o", "    f.write(content.replace(old_str, new_str))\r\n\u001b[?2004l\r\u001b[?2004h"]
[648.977852, "o", "> "]
[648.978076, "o", "print(f\"成功: 已更新 {path}。修改已持久化。\")\r\n\u001b[?2004l\r"]
[648.978209, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[648.990335, "o", "成功: 已更新 /app/test_airline_analysis.py。修改已持久化。\r\n"]
[648.992949, "o", "\u001b[?2004hroot@b5c317e33085:/app# "]
