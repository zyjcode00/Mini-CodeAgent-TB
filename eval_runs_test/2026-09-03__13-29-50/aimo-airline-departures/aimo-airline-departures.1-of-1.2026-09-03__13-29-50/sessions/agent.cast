[624.869195, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 -m py_compile /app/airline_analysis.py /app/test_airline_analysis.py && python3 - <<'PY'\nimport importlib.util\nimport tempfile\nfrom pathlib import Path\n\npath = Path('/app/airline_analysis.py')\nspec = importlib.util.spec_from_file_location('airline_analysis', path)\nmodule = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(module)\nassert module.longest_no_flight_streak((0, 0, 0)) == 99\nassert module.solve() == 79\nwith tempfile.TemporaryDirectory() as directory:\n    output = Path(directory) / 'results.txt'\n    original = module.RESULT_PATH\n    module.RESULT_PATH = output\n    module.main()\n    assert output.read_text(encoding='utf-8') == '79\\n'\n    module.RESULT_PATH = original\nprint('all standard-library tests passed')\nPY\ntrue; tmux wait -S done\r"]
