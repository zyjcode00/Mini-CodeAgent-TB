[635.195256, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\nif [ -f /app/test_airline_analysis.py ]; then cat -- /app/test_airline_analysis.py; else echo '错误: 找不到文件 /app/test_airline_analysis.py'; fi\ntrue; tmux wait -S done\r"]
