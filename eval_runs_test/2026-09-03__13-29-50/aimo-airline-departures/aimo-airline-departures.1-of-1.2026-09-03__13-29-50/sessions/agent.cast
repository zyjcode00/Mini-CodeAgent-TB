[467.476752, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/airline_analysis.py <<'PY'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = 'from math import lcm\\nfrom pathlib import Path\\n\\n\\nPERIODS = (100, 120, 150)\\nRESULT_PATH = Path(\\'/app/results.txt\\')\\n\\n\\ndef longest_no_flight_streak(offsets):\\n    \"\"\"Return the longest circular run of no-flight days in one full period.\"\"\"\\n    cycle = lcm(*PERIODS)\\n    flight_days = sorted(\\n        day\\n        for day in range(cycle)\\n        if any((day - offset) % period == 0 for period, offset in zip(PERIODS, offsets))\\n    )\\n\\n    longest = 0\\n    for current_day, next_day in zip(flight_days, flight_days[1:] + [flight_days[0] + cycle]):\\n        longest = max(longest, next_day - current_day - 1)\\n    return longest\\n\\n\\ndef solve():\\n    \"\"\"Find the greatest guaranteed number of consecutive no-flight days.\"\"\"\\n    cycle = lcm(*PERIODS)\\n    best_guaranteed = cycle\\n\\n    # A common shift of all departures does not change gap lengths, so fix the\\n    # "]
