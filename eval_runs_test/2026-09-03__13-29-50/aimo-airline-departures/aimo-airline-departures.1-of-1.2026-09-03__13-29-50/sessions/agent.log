[?2004l[?2004h> content = 'from math import lcm\nfrom pathlib import Path\n\n\nPERIODS = (100, 120, 150)\nRESULT_PATH = Path(\'/app/results.txt\')\n\n\ndef longest_no_flight_streak(offsets):\n    """Return the longest circular run of no-flight days in one full period."""\n    cycle = lcm(*PERIODS)\n    flight_days = sorted(\n        day\n        for day in range(cycle)\n        if any((day - offset) % period == 0 for period, offset in zip(PERIODS, offsets))\n    )\n\n    longest = 0\n    for current_day, next_day in zip(flight_days, flight_days[1:] + [flight_days[0] + cycle]):\n        longest = max(longest, next_day - current_day - 1)\n    return longest\n\n\ndef solve():\n    """Find the greatest guaranteed number of consecutive no-flight days."""\n    cycle = lcm(*PERIODS)\n    best_guaranteed = cycle\n\n    # A common shift of all departures does not change gap lengths, so fix the\n    # first airline\'s offset at 0 and enumerate only the relative offsets.\n    for second_offset in range(PERIODS[1]):\n        for third_offset in range(PERIODS[2]):\n            longest = longest_no_flight_streak((0, second_offset, third_offset))\n            best_guaranteed = min(best_guaranteed, longest)\n\n    return best_guaranteed\n\n\ndef main():\n    RESULT_PATH.write_text(f\'{solve()}\\n\', encoding=\'utf-8\')\n\n\nif __name__ == \'__main__\':\n    main()\n'
