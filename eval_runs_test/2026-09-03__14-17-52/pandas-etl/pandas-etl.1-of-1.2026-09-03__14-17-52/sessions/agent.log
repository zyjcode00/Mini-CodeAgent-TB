[?2004l[?2004h> content = 'import csv\nimport re\nfrom datetime import datetime\n\n\nINPUT_PATH = "/app/data.csv"\nOUTPUT_PATH = "/app/result.csv"\n\nEXPECTED_COLUMNS = [\n    "participant_id",\n    "first_name",\n    "last_name",\n    "birth_date",\n    "address",\n    "phone_number",\n    "country",\n    "institute",\n    "occupation",\n    "register_time",\n    "postal_code",\n    "city",\n    "team_name",\n]\n\n\ndef read_rows(path):\n    with open(path, newline="", encoding="utf-8") as handle:\n        return list(csv.DictReader(handle))\n\n\ndef postal_code(address):\n    return re.search(r"(\\d+)\\s*$", address).group(1)\n\n\ndef city(address):\n    return address.splitlines()[1].split(",", 1)[0].strip()\n\n\ndef institute_initials(institute):\n    return "".join(word[0].upper() for word in re.findall(r"[A-Za-z0-9]+", institute))\n\n\ndef team_name(row):\n    return (\n        f"{row[\'first_name\'][0].upper()}{row[\'last_name\'][0].upper()}-"\n        f"{row[\'country\']}-{institute_initials(row[\'institute\'])}"\n    )\n\n\ndef main():\n    original = read_rows(INPUT_PATH)\n    result = read_rows(OUTPUT_PATH)\n\n    with open(OUTPUT_PATH, newline="", encoding="utf-8") as handle:\n        header = next(csv.reader(handle))\n    assert header == EXPECTED_COLUMNS, header\n    assert len(result) == len(original), (len(result), len(original))\n\n    for source, transformed in zip(original, result):\n        for column in EXPECTED_COLUMNS[:10]:\n            expected = source[column]\n            if column == "birth_date":\n                expected = datetime.strptime(expected, "%d %b %Y").strftime("%Y-%m-%d")\n            assert transformed[column] == expected, (column, transformed[column], expected)\n\n        assert transformed["postal_code"] == postal_code(source["address"])\n        assert transformed["city"] == city(source["address"])\n        assert transformed["team_name"] == team_name(source)\n\n    print(f"validated {len(result)} rows")\n\n\nif __name__ == "__main__":\n    main()\n'
