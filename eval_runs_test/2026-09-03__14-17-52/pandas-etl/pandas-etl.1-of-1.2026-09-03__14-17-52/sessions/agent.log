[?2004l[?2004h> content = 'import csv\nimport re\nfrom datetime import datetime\n\n\nINPUT_PATH = "/app/data.csv"\nOUTPUT_PATH = "/app/result.csv"\n\nFINAL_COLUMNS = [\n    "participant_id",\n    "first_name",\n    "last_name",\n    "birth_date",\n    "address",\n    "phone_number",\n    "country",\n    "institute",\n    "occupation",\n    "register_time",\n    "postal_code",\n    "city",\n    "team_name",\n]\n\n\ndef extract_postal_code(address):\n    match = re.search(r"(\\d+)\\s*$", address or "")\n    return match.group(1) if match else ""\n\n\ndef extract_city(address):\n    lines = (address or "").splitlines()\n    if len(lines) < 2:\n        return ""\n    return lines[1].split(",", 1)[0].strip()\n\n\ndef institute_initials(institute):\n    return "".join(\n        word[0].upper() for word in re.findall(r"[A-Za-z0-9]+", institute or "")\n    )\n\n\ndef team_name(row):\n    first_initial = (row.get("first_name") or "")[:1].upper()\n    last_initial = (row.get("last_name") or "")[:1].upper()\n    return (\n        f"{first_initial}{last_initial}-{row.get(\'country\', \'\')}-"\n        f"{institute_initials(row.get(\'institute\', \'\'))}"\n    )\n\n\ndef format_birth_date(value):\n    return datetime.strptime(value, "%d %b %Y").strftime("%Y-%m-%d")\n\n\ndef transform():\n    with open(INPUT_PATH, newline="", encoding="utf-8") as source:\n        rows = list(csv.DictReader(source))\n\n    output_rows = []\n    for row in rows:\n        row["postal_code"] = extract_postal_code(row.get("address", ""))\n        row["city"] = extract_city(row.get("address", ""))\n        row["team_name"] = team_name(row)\n        row["birth_date"] = format_birth_date(row["birth_date"])\n        output_rows.append({column: row.get(column, "") for column in FINAL_COLUMNS})\n\n    with open(OUTPUT_PATH, "w", newline="", encoding="utf-8") as target:\n        writer = csv.DictWriter(target, fieldnames=FINAL_COLUMNS)\n        writer.writeheader()\n        writer.writerows(output_rows)\n\n\nif __name__ == "__main__":\n    transform()\n'
