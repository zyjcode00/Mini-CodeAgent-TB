[367.4135, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - <<'PY'\nimport csv\nimport json\nfrom pathlib import Path\n\nsummary_path = Path('/app/flood_summary.json')\nsummary = json.loads(summary_path.read_text())\nexpected_stations = {'station_A', 'station_B', 'station_C'}\nassert set(summary) == expected_stations\nassert all(isinstance(value, int) and value >= 0 for value in summary.values())\nfor path in sorted(Path('/data').glob('station_*.csv')):\n    with path.open(newline='') as handle:\n        rows = list(csv.DictReader(handle))\n    assert len(rows) == 48, (path, len(rows))\n    assert all(row['water_level_m'].strip() for row in rows), path\n    levels = [float(row['water_level_m']) for row in rows]\n    events = 0\n    run = 0\n    for level in levels + [0.0]:\n        if level >= 3.5:\n            run += 1\n        else:\n            events += run >= 3\n            run = 0\n    assert summary[path.stem] == events, (path, summary[path.stem], events)\nprint('validation passed')\nprint(json.dumps(summary, indent=2))\nPY\ntrue; tmux wait -S done\r"]
