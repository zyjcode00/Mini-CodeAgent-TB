[?2004l[?2004h> content = '#!/usr/bin/env python3\n"""Fill station water-level CSVs and summarize flood events."""\n\nimport csv\nimport json\nfrom pathlib import Path\nfrom typing import List, Optional, Tuple\n\nDATA_DIR = Path("/data")\nOUTPUT_PATH = Path("/app/flood_summary.json")\nTHRESHOLD = 3.5\nMIN_EVENT_HOURS = 3\n\n\ndef interpolate(values: List[Optional[float]]) -> List[float]:\n    """Fill missing values using endpoint carry-forward/backward and linear interpolation."""\n    available = [i for i, value in enumerate(values) if value is not None]\n    if not available:\n        raise ValueError("cannot interpolate a series with no available values")\n\n    result = [0.0] * len(values)\n    first, last = available[0], available[-1]\n    for i in range(0, first):\n        result[i] = values[first]  # type: ignore[assignment]\n    for i in range(last + 1, len(values)):\n        result[i] = values[last]  # type: ignore[assignment]\n\n    for left, right in zip(available, available[1:]):\n        left_value = values[left]\n        right_value = values[right]\n        result[left] = left_value  # type: ignore[assignment]\n        step = (right_value - left_value) / (right - left)  # type: ignore[operator]\n        for i in range(left + 1, right):\n            result[i] = left_value + step * (i - left)  # type: ignore[operator]\n    result[last] = values[last]  # type: ignore[assignment]\n    return result\n\n\ndef flood_event_count(levels: List[float]) -> int:\n    """Count separate runs of at least three consecutive levels at or above 3.5m."""\n    events = 0\n    run_length = 0\n    for level in levels + [0.0]:\n        if level >= THRESHOLD:\n            run_length += 1\n        else:\n            if run_length >= MIN_EVENT_HOURS:\n                events += 1\n            run_length = 0\n    return events\n\n\ndef process_station(path: Path) -> int:\n    with path.open(newline="") as handle:\n        rows = list(csv.DictReader(handle))\n    if not rows or any("timestamp" not in row or "water_level_m" not in row for row in rows):\n        raise ValueError(f"invalid CSV schema: {path}")\n\n    values = [float(row["water_level_m"]) if row["water_level_m"].strip() else None for row in rows]\n    completed = interpolate(values)\n    for row, value in zip(rows, completed):\n        row["water_level_m"] = format(value, ".10g")\n\n    with path.open("w", newline="") as handle:\n        writer = csv.DictWriter(handle, fieldnames=["timestamp", "water_level_m"])\n        writer.writeheader()\n        writer.writerows(rows)\n    return flood_event_count(completed)\n\n\ndef main() -> None:\n    summary = {}\n    for path in sorted(DATA_DIR.glob("station_*.csv")):\n        summary[path.stem] = process_station(path)\n    OUTPUT_PATH.write_text(json.dumps(summary, indent=2) + "\\n")\n\n\nif __name__ == "__main__":\n    main()\n'
