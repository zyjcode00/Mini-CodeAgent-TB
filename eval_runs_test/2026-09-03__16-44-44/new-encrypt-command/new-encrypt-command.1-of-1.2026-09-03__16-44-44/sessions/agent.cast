[50.734331, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\nset -euo pipefail\nmkdir -p /app/encrypted_data\nfind /app/data -maxdepth 1 -type f -print0 | while IFS= read -r -d '' src; do\n  base=$(basename \"$src\")\n  rencrypt -p rev -o \"/app/encrypted_data/$base\" \"$src\"\ndone\ntrue; tmux wait -S done\r"]
