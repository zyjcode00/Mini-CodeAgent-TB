[58.382242, "o", "\u001b[?2004hroot@53d4e627184f:/app# "]
[58.382341, "o", "src_list=$(mktemp)\r\n\u001b[?2004l\r"]
[58.384668, "o", "\u001b[?2004hroot@53d4e627184f:/app# "]
[58.38491, "o", "out_list=$(mktemp)\r\n\u001b[?2004l\r"]
[58.386415, "o", "\u001b[?2004hroot@53d4e627184f:/app# "]
[58.386646, "o", "find /app/data -maxdepth 1 -type f -printf '%f\\n' | sort > \"$src_list\"\r\n\u001b[?2004l\r"]
[58.389368, "o", "\u001b[?2004hroot@53d4e627184f:/app# "]
[58.389788, "o", "find /app/encrypted_data -maxdepth 1 -type f -printf '%f\\n' | sort > \"$out_list\"\r\n\u001b[?2004l\r"]
[58.39326, "o", "\u001b[?2004hroot@53d4e627184f:/app# "]
[58.393416, "o", "echo 'Source files:'\r\n\u001b[?2004l\rSource files:\r\n"]
[58.393499, "o", "\u001b[?2004hroot@53d4e627184f:/app# "]
[58.393571, "o", "cat \"$src_list\"\r\n\u001b[?2004l\r"]
[58.394812, "o", "sample1.txt\r\nsample2.txt\r\n"]
[58.395201, "o", "\u001b[?2004hroot@53d4e627184f:/app# "]
[58.395473, "o", "echo 'Encrypted output files:'\r\n\u001b[?2004l\rEncrypted output files:\r\n\u001b[?2004hroot@53d4e627184f:/app# "]
[58.395705, "o", "cat \"$out_list\"\r\n\u001b[?2004l\r"]
[58.397263, "o", "sample1.txt\r\nsample2.txt\r\n"]
[58.397561, "o", "\u001b[?2004hroot@53d4e627184f:/app# "]
[58.397781, "o", "if diff -u \"$src_list\" \"$out_list\"; then\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.397943, "o", "> "]
[58.398199, "o", "  echo 'VERIFY_OK: encrypted outputs exist for every source file with matching basenames.'\r\n\u001b[?2004l\r"]
[58.398228, "o", "\u001b[?2004h> "]
[58.398471, "o", "else\r\n\u001b[?2004l\r"]
[58.398582, "o", "\u001b[?2004h> "]
[58.398706, "o", "  echo 'VERIFY_FAILED: source/output basename mismatch.' >&2\r\n\u001b[?2004l\r"]
[58.398892, "o", "\u001b[?2004h> "]
[58.398993, "o", "  exit 1\r\n\u001b[?2004l\r\u001b[?2004h> fi\r\n\u001b[?2004l\r"]
[58.40208, "o", "VERIFY_OK: encrypted outputs exist for every source file with matching basenames.\r\n"]
[58.402222, "o", "\u001b[?2004hroot@53d4e627184f:/app# "]
[58.402323, "o", "rm -f \"$src_list\" \"$out_list\"\r\n\u001b[?2004l\r"]
[58.403608, "o", "\u001b[?2004hroot@53d4e627184f:/app# "]
[58.403748, "o", "true; tmux wait -S done\r\n\u001b[?2004l\r"]
[58.407182, "o", "\u001b[?2004hroot@53d4e627184f:/app# "]
[98.933716, "i", "\u0004"]
[98.9339, "o", "\u001b[?2004l\r\r\nexit\r\n"]
