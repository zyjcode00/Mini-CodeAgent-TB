[58.381269, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\nset -euo pipefail\nsrc_list=$(mktemp)\nout_list=$(mktemp)\nfind /app/data -maxdepth 1 -type f -printf '%f\\n' | sort > \"$src_list\"\nfind /app/encrypted_data -maxdepth 1 -type f -printf '%f\\n' | sort > \"$out_list\"\necho 'Source files:'\ncat \"$src_list\"\necho 'Encrypted output files:'\ncat \"$out_list\"\nif diff -u \"$src_list\" \"$out_list\"; then\n  echo 'VERIFY_OK: encrypted outputs exist for every source file with matching basenames.'\nelse\n  echo 'VERIFY_FAILED: source/output basename mismatch.' >&2\n  exit 1\nfi\nrm -f \"$src_list\" \"$out_list\"\ntrue; tmux wait -S done\r"]
[58.381599, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
