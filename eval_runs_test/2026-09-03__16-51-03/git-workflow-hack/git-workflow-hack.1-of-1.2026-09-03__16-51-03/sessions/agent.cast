[381.002743, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\ncat >> test_static_site.py <<'PY'\n\nif __name__ == \"__main__\":\n    failures = 0\n    for name, func in sorted(globals().items()):\n        if name.startswith(\"test_\") and callable(func):\n            try:\n                func()\n                print(f\"PASS {name}\")\n            except Exception as exc:\n                failures += 1\n                print(f\"FAIL {name}: {exc}\")\n    if failures:\n        raise SystemExit(f\"{failures} validation(s) failed\")\n    print(\"All static site validations passed\")\nPY\npython3 test_static_site.py\ntrue; tmux wait -S done\r"]
