[470.345299, "o", "\u001b[35m\u001b[Ktest_static_site.py\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K11\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    r\"\u001b[01;31m\u001b[Kcurl\u001b[m\u001b[K\\s+[^|\\n]+\\|\\s*(?:sh|bash)\",\r\n\u001b[35m\u001b[Ktest_static_site.py\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K12\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    r\"\u001b[01;31m\u001b[Kwget\u001b[m\u001b[K\\s+[^|\\n]+\\|\\s*(?:sh|bash)\",\r\n\u001b[35m\u001b[Ktest_static_site.py\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K13\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    r\"\u001b[01;31m\u001b[Kcurl\u001b[m\u001b[K\\b.*(?:-F|--form|--data|--data-binary|--upload-file)\",\r\n\u001b[35m\u001b[Ktest_static_site.py\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K14\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    r\"\u001b[01;31m\u001b[Kwget\u001b[m\u001b[K\\b.*(?:--post-file|--post-data)\",\r\n"]
[470.345636, "o", "\u001b[35m\u001b[Ktest_static_site.py\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K16\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    r\"\u001b[01;31m\u001b[Khackerx\u001b[m\u001b[K\\.com\",\r\n\u001b[35m\u001b[Ktest_static_site.py\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K19\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    r\"\u001b[01;31m\u001b[K/dev/tcp\u001b[m\u001b[K/\",\r\n"]
