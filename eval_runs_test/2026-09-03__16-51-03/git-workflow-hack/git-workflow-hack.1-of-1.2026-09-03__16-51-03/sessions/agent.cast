[442.181496, "o", "\u001b[32m\u001b[K6\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K7\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[KROOT = Path(__file__).resolve().parent\r\n\u001b[32m\u001b[K8\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[KHTML_FILES = [\"index.html\", \"blog.html\", \"publications.html\"]\r\n\u001b[32m\u001b[K9\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[KREQUIRED_FILES = HTML_FILES + [\"styles.css\", \"script.js\", \"info.md\"]\r\n"]
[442.181798, "o", "\u001b[32m\u001b[K10\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[KSUSPICIOUS_WORKFLOW_PATTERNS\u001b[m\u001b[K = [\r\n\u001b[32m\u001b[K11\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    r\"\u001b[01;31m\u001b[Kcurl\u001b[m\u001b[K\\s+[^|\\n]+\\|\\s*(?:sh|bash)\",\r\n\u001b[32m\u001b[K12\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    r\"wget\\s+[^|\\n]+\\|\\s*(?:sh|bash)\",\r\n\u001b[32m\u001b[K13\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    r\"nc\\s+-e\",\r\n\u001b[32m\u001b[K14\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    r\"bash\\s+-i\",\r\n\u001b[32m\u001b[K15\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    r\"/dev/tcp/\",\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K62\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    return parser\r\n\u001b[32m\u001b[K63\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K64\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K65\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kdef is_external_or_special_link(href: str) -> bool:\r\n\u001b[32m\u001b[K66\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    return href.startswith((\"\u001b[01;31m\u001b[Khttp\u001b[m\u001b[K://\", \"\u001b[01;31m\u001b[Khttp\u001b[m\u001b[Ks://\", \"mailto:\", \"tel:\"))\r\n"]
[442.182012, "o", "\u001b[32m\u001b[K67\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K68\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K69\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kdef test_required_files_exist_and_are_not_empty():\r\n\u001b[32m\u001b[K70\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    for name in REQUIRED_FILES:\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K113\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    for expected in [\"Dr. Lydia Moreno\", \"computational neuroscience\", \"machine learning\", \"Publications\", \"Blog\"]:\r\n\u001b[32m\u001b[K114\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        assert expected.lower() in combined.lower(), f\"Expected site content to mention: {expected}\"\r\n\u001b[32m\u001b[K115\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K116\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K117\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kdef \u001b[01;31m\u001b[Ktest_workflows\u001b[m\u001b[K_do_not_contain_obvious_suspicious_commands():\r\n\u001b[32m\u001b[K118\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    workflow_dir = ROOT / \".github\" / \"workflows\"\r\n\u001b[32m\u001b[K119\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if not workflow_dir.exists():\r\n\u001b[32m\u001b[K120\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        return\r\n\u001b[32m\u001b[K121\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    for workflow in workflow_dir.glob(\"*.yml\"):\r\n\u001b[32m\u001b[K122\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        text = workflow.read_text(encoding=\"utf-8\")\r\n\u001b[32m\u001b[K123\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        for pattern in \u001b[01;31m\u001b[KSUSPICIOUS_WORKFLOW_PATTERNS\u001b[m\u001b[K:\r\n"]
[442.182175, "o", "\u001b[32m\u001b[K124\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            assert not re.search(pattern, text, re.IGNORECASE), (\r\n\u001b[32m\u001b[K125\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                f\"Workflow {workflow.name} contains suspicious pattern: {pattern}\"\r\n\u001b[32m\u001b[K126\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            )\r\n\u001b[32m\u001b[K127\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
