[293.840213, "o", "content = ':root {\\n  --bg: #f6f7fb;\\n  --surface: #ffffff;\\n  --surface-soft: #eef3ff;\\n  --text: #162033;\\n  --muted: #64708a;\\n  --primary: #2457c5;\\n  --primary-dark: #163b88;\\n  --accent: #13a89e;\\n  --border: #dce3f0;\\n  --shadow: 0 20px 60px rgba(22, 32, 51, 0.12);\\n  --radius: 22px;\\n}\\n\\n* {\\n  box-sizing: border-box;\\n}\\n\\nhtml {\\n  scroll-behavior: smooth;\\n}\\n\\nbody {\\n  margin: 0;\\n  font-family: \"Inter\", system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\\n  color: var(--text);\\n  background: radial-gradient(circle at top left, #e8f0ff 0, transparent 36rem), var(--bg);\\n  line-height: 1.65;\\n}\\n\\na {\\n  color: var(--primary);\\n  text-decoration: none;\\n}\\n\\na:hover,\\na:focus {\\n  color: var(--primary-dark);\\n  text-decoration: underline;\\n}\\n\\n.site-header {\\n  position: sticky;\\n  top: 0;\\n  z-index: 10;\\n  background: rgba(246, 247, 251, 0.9);\\n  border-bottom: 1px solid rgba(220, 227, 240, 0.8);\\n  backdrop-filter: blur(16px);\\n}\\n\\n.navbar {\\n  width: min(1120px, calc(100% - 32px));\\n  margin: 0 auto;\\n  min-height: 74px;\\n  display: flex;\\n  align-items: center;\\n  justify-content: space-between;\\n  gap: 24px;\\n}\\n\\n.brand {\\n  font-weight: 800;\\n  letter-spacing: -0.04em;\\n  font-size: 1.35rem;\\n  color: var(--text);\\n}\\n\\n.brand:hover,\\n.brand:focus {\\n  color: var(--primary);\\n  text-decoration: none;\\n}\\n\\n.nav-links {\\n  margin: 0;\\n  padding: 0;\\n  list-style: none;\\n  display: flex;\\n  align-items: center;\\n  gap: 10px;\\n}\\n\\n.nav-links a {\\n  display: inline-flex;\\n  padding: 10px 14px;\\n  border-radius: 999px;\\n  color: var(--muted);\\n  font-weight: 700;\\n  font-size: 0.95rem;\\n}\\n\\n.nav-links a:hover,\\n.nav-links a:focus,\\n.nav-links a.active {\\n  color: var(--primary-dark);\\n  background: var(--surface-soft);\\n  text-decoration: none;\\n}\\n\\n.nav-toggle {\\n  display: none;\\n  border: 1px solid var(--border);\\n  background: var(--surface);\\n  color: var(--text);\\n  border-radius: 999px;\\n  padding: 9px 14px;\\n  font-weight: 800;\\n}\\n\\nmain {\\n  width: min(1120px, calc(100% - 32px));\\n  margin: 0 auto;\\n}\\n\\n.hero,\\n.page-hero {\\n  padding: 92px 0 58px;\\n}\\n\\n.hero {\\n  display: grid;\\n  grid-template-columns: minmax(0, 1fr) 360px;\\n  align-items: center;\\n  gap: 42px;\\n}\\n\\n.eyebrow,\\n.section-kicker,\\n.post-date {\\n  margin: 0 0 10px;\\n  color: var(--accent);\\n  text-transform: uppercase;\\n  letter-spacing: 0.12em;\\n  font-weight: 800;\\n  font-size: 0.78rem;\\n}\\n\\nh1,\\nh2,\\nh3 {\\n  margin-top: 0;\\n  line-height: 1.12;\\n  letter-spacing: -0.045em;\\n}\\n\\nh1,\\nh2 {\\n  font-family: \"Source Serif 4\", Georgia, serif;\\n}\\n\\nh1 {\\n  margin-bottom: 18px;\\n  font-size: clamp(3rem, 8vw, 6.6rem);\\n}\\n\\nh2 {\\n  font-size: clamp(2rem, 4vw, 3.25rem);\\n}\\n\\nh3 {\\n  font-size: 1.2rem;\\n}\\n\\n.hero-lede,\\n.page-hero p {\\n  color: var(--muted);\\n  font-size: clamp(1.1rem, 2vw, 1.35rem);\\n  max-width: 760px;\\n}\\n\\n.hero-actions {\\n  display: flex;\\n  gap: 14px;\\n  flex-wrap: wrap;\\n  margin-top: 30px;\\n}\\n\\n.button {\\n  display: inline-flex;\\n  align-items: center;\\n  justify-content: center;\\n  min-height: 48px;\\n  padding: 0 20px;\\n  border-radius: 999px;\\n  font-weight: 800;\\n  border: 1px solid transparent;\\n}\\n\\n.button:hover,\\n.button:focus {\\n  text-decoration: none;\\n}\\n\\n.button.primary {\\n  background: var(--primary);\\n  color: white;\\n  box-shadow: 0 14px 30px rgba(36, 87, 197, 0.22);\\n}\\n\\n.button.secondary {\\n  background: var(--surface);\\n  color: var(--primary-dark);\\n  border-color: var(--border);\\n}\\n\\n.profile-card,\\n.card,\\n.panel,\\n.publication,\\n.blog-card {\\n  background: rgba(255, 255, 255, 0.92);\\n  border: 1px solid var(--border);\\n  border-radius: var(--radius);\\n  box-shadow: var(--shadow);\\n}\\n\\n.profile-card {\\n  padding: 30px;\\n}\\n\\n.avatar {\\n  width: 86px;\\n  height: 86px;\\n  display: grid;\\n  place-items: center;\\n  margin-bottom: 20px;\\n  border-radius: 26px;\\n  background: linear-gradient(135deg, var(--primary), var(--accent));\\n  color: white;\\n  font-size: 1.75rem;\\n  font-weight: 900;\\n  letter-spacing: -0.06em;\\n}\\n\\n.profile-card h2 {\\n  margin-bottom: 8px;\\n  font-size: 1.6rem;\\n}\\n\\n.profile-card p,\\n.profile-card dd,\\n.card p,\\n.panel p,\\n.publication p,\\n.blog-card p,\\n.rich-text p,\\n.timeline p {\\n  color: var(--muted);\\n}\\n\\n.profile-card dl {\\n  margin: 20px 0 0;\\n}\\n\\n.profile-card dl div {\\n  padding: 14px 0;\\n  border-top: 1px solid var(--border);\\n}\\n\\n.profile-card dt {\\n  color: var(--text);\\n  font-weight: 800;\\n}\\n\\n.profile-card dd {\\n  margin: 2px 0 0;\\n  overflow-wrap: anywhere;\\n}\\n\\n.section {\\n  padding: 54px 0;\\n}\\n\\n.two-column {\\n  display: grid;\\n  grid-template-columns: 0.85fr 1.15fr;\\n  gap: 44px;\\n  align-items: start;\\n}\\n\\n.section-heading {\\n  max-width: 720px;\\n  margin-bottom: 26px;\\n}\\n\\n.card-grid {\\n  display: grid;\\n  grid-template-columns: repeat(4, minmax(0, 1fr));\\n  gap: 18px;\\n}\\n\\n.card,\\n.panel,\\n.blog-card {\\n  padding: 24px;\\n}\\n\\n.card h3,\\n.panel h2,\\n.blog-card h2 {\\n  margin-bottom: 10px;\\n}\\n\\n.highlighted {\\n  margin: 34px 0;\\n  padding: 42px;\\n  background: linear-gradient(135deg, rgba(36, 87, 197, 0.09), rgba(19, 168, 158, 0.11));\\n  border: 1px solid var(--border);\\n  border-radius: calc(var(--radius) + 8px);\\n}\\n\\n.timeline {\\n  display: grid;\\n  gap: 18px;\\n}\\n\\n.timeline article {\\n  position: relative;\\n  padding-left: 24px;\\n  border-left: 3px solid var(--accent);\\n}\\n\\n.timeline span {\\n  color: var(--primary);\\n  font-weight: 800;\\n  font-size: 0.88rem;\\n}\\n\\n.split-cards {\\n  display: grid;\\n  grid-template-columns: 1fr 1fr;\\n  gap: 22px;\\n}\\n\\n.dark-panel {\\n  background: #172033;\\n  color: white;\\n}\\n\\n.dark-panel p,\\n.dark-panel .section-kicker {\\n  color: #b8c8e8;\\n}\\n\\n.check-list {\\n  padding-left: 0;\\n  list-style: none;\\n}\\n\\n.check-list li {\\n  margin: 12px 0;\\n  padding-left: 30px;\\n  position: relative;\\n  color: var(--muted);\\n}\\n\\n.check-list li::before {\\n  content: \"✓\";\\n  position: absolute;\\n  left: 0;\\n  color: var(--accent);\\n  font-weight: 900;\\n}\\n\\n.page-hero.compact {\\n  max-width: 860px;\\n  padding-bottom: 28px;\\n}\\n\\n.publication-list,\\n.blog-list {\\n  display: grid;\\n  gap: 18px;\\n}\\n\\n.publication {\\n  display: grid;\\n  grid-template-columns: 96px 1fr;\\n  gap: 22px;\\n  padding: 26px;\\n  box-shadow: none;\\n}\\n\\n.pub-year {\\n  color: var(--primary);\\n  font-size: 1.4rem;\\n  font-weight: 900;\\n}\\n\\n.publication h2,\\n.blog-card h2 {\\n  font-family: \"Inter\", system-ui, sans-serif;\\n  font-size: 1.25rem;\\n  letter-spacing: -0.025em;\\n}\\n\\n.tag {\\n  display: inline-flex;\\n  margin: 8px 8px 0 0;\\n  padding: 5px 10px;\\n  border-radius: 999px;\\n  background: var(--surface-soft);\\n  color: var(--primary-dark);\\n  font-weight: 800;\\n  font-size: 0.78rem;\\n}\\n\\n.blog-card {\\n  box-shadow: none;\\n}\\n\\n.blog-card h2 a {\\n  color: var(--text);\\n}\\n\\n.site-footer {\\n  width: min(1120px, calc(100% - 32px));\\n  margin: 30px auto 0;\\n  padding: 36px 0 46px;\\n  color: var(--muted);\\n  border-top: 1px solid var(--border);\\n  display: flex;\\n  justify-content: space-between;\\n  gap: 24px;\\n  flex-wrap: wrap;\\n}\\n\\n.site-footer p {\\n  margin: 0;\\n}\\n\\n@media (max-width: 900px) {\\n  .hero,\\n  .two-column,\\n  .split-cards {\\n    grid-template-columns: 1fr;\\n  }\\n\\n  .profile-card {\\n    max-width: 560px;\\n  }\\n\\n  .card-grid {\\n    grid-template-columns: repeat(2, minmax(0, 1fr));\\n  }\\n}\\n\\n@media (max-width: 680px) {\\n  .navbar {\\n    min-height: 66px;\\n  }\\n\\n  .nav-toggle {\\n    display: inline-flex;\\n  }\\n\\n  .nav-links {\\n    display: none;\\n    position: absolute;\\n    top: 66px;\\n    left: 16px;\\n    right: 16px;\\n    padding: 12px;\\n    flex-direction: column;\\n    align-items: stretch;\\n    background: var(--surface);\\n    border: 1px solid var(--border);\\n    border-radius: 18px;\\n    box-shadow: var(--shadow);\\n  }\\n\\n  .nav-links.open {\\n    display: flex;\\n  }\\n\\n  .nav-links a {\\n    width: 100%;\\n  }\\n\\n  .hero,\\n  .page-hero {\\n    padding-top: 58px;\\n  }\\n\\n  .card-grid,\\n  .publication {\\n    grid-template-columns: 1fr;\\n  }\\n\\n  .highlighted {\\n    padding: 26px;\\n  }\\n}\\n'\r\n"]
