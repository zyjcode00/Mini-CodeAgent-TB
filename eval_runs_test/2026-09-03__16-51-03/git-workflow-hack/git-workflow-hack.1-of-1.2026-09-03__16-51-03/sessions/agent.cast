[85.290088, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - my_website/index.html <<'PY'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = '<!DOCTYPE html>\\n<html lang=\"en\">\\n<head>\\n  <meta charset=\"UTF-8\" />\\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\\n  <meta name=\"description\" content=\"Research profile of Dr. Lydia Moreno, computational neuroscience researcher at Riverbend University.\" />\\n  <title>Dr. Lydia Moreno | Computational Neuroscience</title>\\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Source+Serif+4:wght@600;700&display=swap\" rel=\"stylesheet\" />\\n  <link rel=\"stylesheet\" href=\"styles.css\" />\\n</head>\\n<body>\\n  <header class=\"site-header\">\\n    <nav class=\"navbar\" aria-label=\"Main navigation\">\\n      <a class=\"brand\" href=\"index.html\" aria-label=\"Dr. Lydia Moreno home\">Lydia Moreno</a>\\n      <button class=\"nav-toggle\" type=\"button\" aria-expanded=\"false\" aria-controls=\"site-menu\">Menu</button>\\n      <ul class=\"nav-links\" id=\"site-menu\">\\n        <li><a class=\"active\" href=\"index.html\">About Me</a></li>\\n        <li><a href=\"publications.html\">Publications</a></li>\\n        <li><a href=\"blog.html\">Blog</a></li>\\n      </ul>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\"hero\">\\n      <div class=\"hero-content\">\\n        <p class=\"eyebrow\">Computational Neuroscience · Machine Learning · Bioinformatics</p>\\n        <h1>Dr. Lydia Moreno</h1>\\n        <p class=\"hero-lede\">Associate Professor at Riverbend University studying how neural circuits encode and process complex sensory information.</p>\\n        <div class=\"hero-actions\">\\n          <a class=\"button primary\" href=\"publications.html\">View Publications</a>\\n          <a class=\"button secondary\" href=\"mailto:lydia.moreno@riverbend.edu\">Contact Me</a>\\n        </div>\\n      </div>\\n      <aside class=\"profile-card\" aria-label=\"Profile summary\">\\n        <div class=\"avatar\" aria-hidden=\"true\">LM</div>\\n        <h2>Research Profile</h2>\\n        <p>School of Biological Sciences<br />Riverbend University</p>\\n        <dl>\\n          <div><dt>Office</dt><dd>Blakely Hall, Room 312</dd></div>\\n          <div><dt>Email</dt><dd><a href=\"mailto:lydia.moreno@riverbend.edu\">lydia.moreno@riverbend.edu</a></dd></div>\\n          <div><dt>GitHub</dt><dd><a href=\"https://github.com/lydia-moreno\" rel=\"noopener noreferrer\">github.com/lydia-moreno</a></dd></div>\\n        </dl>\\n      </aside>\\n    </section>\\n\\n    <section class=\"section two-column\" id=\"about\">\\n      <div>\\n        <p class=\"section-kicker\">About Me</p>\\n        <h2>Building interpretable tools for modern neuroscience.</h2>\\n      </div>\\n      <div class=\"rich-text\">\\n        <p>Dr. Lydia Moreno is an associate professor of Computational Neuroscience at Riverbend University’s School of Biological Sciences. Her work sits at the intersection of machine learning, systems neuroscience, and bioinformatics.</p>\\n        <p>She received her Ph.D. in Computational Biology from Baywood Institute of Technology and completed postdoctoral training in high-throughput imaging analysis at Northborough Research Center.</p>\\n      </div>\\n    </section>\\n\\n    <section class=\"section\">\\n      <div class=\"section-heading\">\\n        <p class=\"section-kicker\">Research Interests</p>\\n        <h2>Focus areas</h2>\\n      </div>\\n      <div class=\"card-grid\">\\n        <article class=\"card\">\\n          <h3>Neural Encoding & Decoding</h3>\\n          <p>Developing interpretable models that translate spike-train data into behavioral predictions.</p>\\n        </article>\\n        <article class=\"card\">\\n          <h3>Biomedical Imaging</h3>\\n          <p>Applying convolutional and graph neural networks to MRI and two-photon microscopy data.</p>\\n        </article>\\n        <article class=\"card\">\\n          <h3>Single-Cell Omics</h3>\\n          <p>Designing scalable pipelines for multi-modal single-cel"]
[85.290442, "i", "l genomics and spatial transcriptomics.</p>\\n        </article>\\n        <article class=\"card\">\\n          <h3>Explainable AI</h3>\\n          <p>Building frameworks to probe decision boundaries and feature attributions in black-box models.</p>\\n        </article>\\n      </div>\\n    </section>\\n\\n    <section class=\"section highlighted\">\\n      <div class=\"section-heading\">\\n        <p class=\"section-kicker\">Selected Projects</p>\\n        <h2>Recent work</h2>\\n      </div>\\n      <div class=\"timeline\">\\n        <article>\\n          <span>Lead Developer & Project Coordinator</span>\\n          <h3>DeepVision: High-Resolution Neural Activity Mapping</h3>\\n          <p>A PyTorch-based pipeline for segmenting two-photon images and decoding stimulus orientation from calcium-imaging traces.</p>\\n        </article>\\n        <article>\\n          <span>Principal Investigator</span>\\n          <h3>NeuroGraph: Graph Neural Networks for Circuit Analysis</h3>\\n          <p>Graph representations of reconstructed neuron meshes to classify synapse types and infer connectivity motifs.</p>\\n        </article>\\n        <article>\\n          <span>Co-Principal Investigator</span>\\n          <h3>CellMap: Multi-Modal Single-Cell Atlas</h3>\\n          <p>A Nextflow workflow integrating scRNA-Seq, ATAC-Seq, and spatial FISH data for cortical organoid analysis.</p>\\n        </article>\\n      </div>\\n    </section>\\n\\n    <section class=\"section split-cards\">\\n      <article class=\"panel\">\\n        <p class=\"section-kicker\">Teaching & Mentorship</p>\\n        <h2>Training the next generation of computational biologists.</h2>\\n        <ul class=\"check-list\">\\n          <li>Introduction to Computational Neuroscience (Spring 2025)</li>\\n          <li>Advanced Machine Learning Methods in Biology (Fall 2024)</li>\\n          <li>Supervised 8 Ph.D. students and 12 Master’s theses</li>\\n        </ul>\\n      </article>\\n      <article class=\"panel dark-panel\">\\n        <p class=\"section-kicker\">Skills & Tools</p>\\n        <h2>Technical toolkit</h2>\\n        <p>Python, R, C++, PyTorch, TensorFlow, scikit-learn, NetworkX, Nextflow, Snakemake, Docker, Kubernetes, MATLAB, Jupyter, Seurat, Scanpy, D3.js, Plotly, and Matplotlib.</p>\\n      </article>\\n    </section>\\n  </main>\\n\\n  <footer class=\"site-footer\">\\n    <p>&copy; 2025 Dr. Lydia Moreno. Built as a static research profile website.</p>\\n    <p><a href=\"mailto:lydia.moreno@riverbend.edu\">lydia.moreno@riverbend.edu</a> · <a href=\"https://twitter.com/LydiaNeuroLab\" rel=\"noopener noreferrer\">@LydiaNeuroLab</a></p>\\n  </footer>\\n  <script src=\"script.js\"></script>\\n</body>\\n</html>\\n'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, 'w', encoding='utf-8', newline='\\n') as f:\n        f.write(content)\n    print(f\"成功: 已写入 {path}\")\nexcept Exception as exc:\n    print(f\"写入失败: {exc}\")\nPY\ntrue; tmux wait -S done\r"]
