[193.382171, "o", "        </article>\r\n      </div>\r\n    </section>\r\n\r\n    <section class=\"section highlighted\">\r\n      <div class=\"section-heading\">\r\n        <p class=\"section-kicker\">Selected Projects</p>\r\n        <h2>Recent work</h2>\r\n      </div>\r\n      <div class=\"timeline\">\r\n        <article>\r\n          <span>Lead Developer & Project Coordinator</span>\r\n          <h3>DeepVision: High-Resolution Neural Activity Mapping</h3>\r\n          <p>A PyTorch-based pipeline for segmenting two-photon images and decoding stimulus orientation from calcium-imaging traces.</p>\r\n        </article>\r\n        <article>\r\n          <span>Principal Investigator</span>\r\n          <h3>NeuroGraph: Graph Neural Networks for Circuit Analysis</h3>\r\n          <p>Graph representations of reconstructed neuron meshes to classify synapse types and infer connectivity motifs.</p>\r\n        </article>\r\n        <article>\r\n          <span>Co-Principal Investigator</span>\r\n          <h3>CellMap: Multi-Modal Single-Cell Atlas</h3>\r\n          <p>A Nextflow workflow integrating scRNA-Seq, ATAC-Seq, and spatial FISH data for cortical organoid analysis.</p>\r\n        </article>\r\n      </div>\r\n    </section>\r\n\r\n    <section class=\"section split-cards\">\r\n      <article class=\"panel\">\r\n        <p class=\"section-kicker\">Teaching & Mentorship</p>\r\n        <h2>Training the next generation of computational biologists.</h2>\r\n        <ul class=\"check-list\">\r\n          <li>Introduction to Computational Neuroscience (Spring 2025)</li>\r\n          <li>Advanced Machine Learning Methods in Biology (Fall 2024)</li>\r\n          <li>Supervised 8 Ph.D. students and 12 Master’s theses</li>\r\n        </ul>\r\n      </article>\r\n      <article class=\"panel dark-panel\">\r\n        <p class=\"section-kicker\">Skills & Tools</p>\r\n        <h2>Technical toolkit</h2>\r\n        <p>Python, R, C++, PyTorch, TensorFlow, scikit-learn, NetworkX, Nextflow, Snakemake, Docker, Kubernetes, MATLAB, Jupyter, Seurat, Scanpy, D3.js, Plotly, and Matplotlib.</p>\r\n      </article>\r\n    </section>\r\n  </main>\r\n\r\n  <footer class=\"site-footer\">\r\n    <p>&copy; 2025 Dr. Lydia Moreno. Built as a static research profile website.</p>\r\n    <p><a href=\"mailto:lydia.moreno@riverbend.edu\">lydia.moreno@riverbend.edu</a> · <a href=\"https://twitter.com/LydiaNeuroLab\" rel=\"noopener noreferrer\">@LydiaNeuroLab</a></p>\r\n  </footer>\r\n  <script src=\"script.js\"></script>\r\n</body>\r\n</html>\r\n"]
