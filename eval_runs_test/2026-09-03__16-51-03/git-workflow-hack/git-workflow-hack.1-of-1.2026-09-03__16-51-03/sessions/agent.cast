[480.122598, "o", "--- final files ---\r\n\u001b[?2004hroot@5d621599e68f:/app/my_website# "]
[480.122792, "o", "find . -maxdepth 3 -type f | sort\r\n\u001b[?2004l\r"]
[480.125434, "o", "./.github/workflows/deploy.yml\r\n./.gitignore\r\n./blog.html\r\n./index.html\r\n./info.md\r\n./publications.html\r\n./script.js\r\n./styles.css\r\n./test_static_site.py\r\n"]
[480.125732, "o", "\u001b[?2004hroot@5d621599e68f:/app/my_website# "]
[480.125982, "o", "echo '--- safe workflow ---'\r\n\u001b[?2004l\r--- safe workflow ---\r\n\u001b[?2004h"]
[480.126054, "o", "root@5d621599e68f:/app/my_website# "]
[480.126219, "o", "sed -n '1,220p' .github/workflows/deploy.yml\r\n\u001b[?2004l\r"]
[480.1287, "o", "name: Deploy Site\r\n\r\non:\r\n  push:\r\n    branches:\r\n      - main\r\n  workflow_dispatch:\r\n\r\npermissions:\r\n  contents: read\r\n  pages: write\r\n  id-token: write\r\n\r\nconcurrency:\r\n  group: pages\r\n  cancel-in-progress: false"]
[480.128915, "o", "\r\n\r\njobs:\r\n  deploy:\r\n    environment:\r\n      name: github-pages\r\n      url: ${{ steps.deployment.outputs.page_url }}\r\n    runs-on: ubuntu-latest\r\n    steps:\r\n      - name: Check out repository\r\n        uses: actions/checkout@v4\r\n\r\n      - name: Configure GitHub Pages\r\n        uses: actions/configure-pages@v5\r\n\r\n      - name: Upload static site artifact\r\n        uses: actions/upload-pages-artifact@v3\r\n        with:\r\n          path: .\r\n\r\n      - name: Deploy to GitHub Pages\r\n"]
[480.129054, "o", "        id: deployment\r\n        uses: actions/deploy-pages@v4\r\n"]
[480.129358, "o", "\u001b[?2004hroot@5d621599e68f:/app/my_website# "]
[480.12963, "o", "echo '--- suspicious workflow grep (workflow files only) ---'\r\n\u001b[?2004l\r--- suspicious workflow grep (workflow files only) ---\r\n"]
[480.129903, "o", "\u001b[?2004hroot@5d621599e68f:/app/my_website# "]
