[480.119672, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\nrm -rf __pycache__ .pytest_cache\necho '--- final files ---'\nfind . -maxdepth 3 -type f | sort\necho '--- safe workflow ---'\nsed -n '1,220p' .github/workflows/deploy.yml\necho '--- suspicious workflow grep (workflow files only) ---'\nif grep -RInE 'hackerX|hackerx|curl|wget|zip -r|/dev/tcp|bash -i|nc -e|base64[[:space:]]+-d' .github/workflows; then\n  echo 'Potential suspicious workflow text found'\n  exit 1\nelse\n  echo 'No suspicious workflow text found'\nfi\necho '--- git status ---'\nif git rev-parse --is-inside-work-tree >/dev/null 2>&1; then git status --short; else echo 'Not a git repository yet'; fi\ntrue; tmux wait -S done\r"]
[480.120281, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
