[184.685457, "o", "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n  <meta charset=\"UTF-8\" />\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\r\n  <meta name=\"description\" content=\"Research profile of Dr. Lydia Moreno, computational neuroscience researcher at Riverbend University.\" />\r\n  <title>Dr. Lydia Moreno | Computational Neuroscience</title>\r\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\r\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\r\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Source+Serif+4:wght@600;700&display=swap\" rel=\"stylesheet\" />\r\n  <link rel=\"stylesheet\" href=\"styles.css\" />\r\n</head>\r\n<body>\r\n  <header class=\"site-header\">\r\n    <nav class=\"navbar\" aria-label=\"Main navigation\">\r\n      <a class=\"brand\" href=\"index.html\" aria-label=\"Dr. Lydia Moreno home\">Lydia Moreno</a>\r\n      <button class=\"nav-toggle\" type=\"button\" aria-expanded=\"false\" aria-controls=\"site-menu\">Menu</button>\r\n      <ul class=\"nav-links\" id=\"site-menu\">\r\n        <li><a class=\"active\" href=\"index.html\">About Me</a></li>\r\n        <li><a href=\"publications.html\">Publications</a></li>\r\n        <li><a href=\"blog.html\">Blog</a></li>\r\n      </ul>\r\n    </nav>\r\n  </header>\r\n\r\n  <main>\r\n    <section class=\"hero\">\r\n      <div class=\"hero-content\">\r\n        <p class=\"eyebrow\">Computational Neuroscience · Machine Learning · Bioinformatics</p>\r\n        <h1>Dr. Lydia Moreno</h1>\r\n        <p class=\"hero-lede\">Associate Professor at Riverbend University studying how neural circuits encode and process complex sensory information.</p>\r\n        <div class=\"hero-actions\">\r\n          <a class=\"button primary\" href=\"publications.html\">View Publications</a>\r\n          <a class=\"button secondary\" href=\"mailto:lydia.moreno@riverbend.edu\">Contact Me</a>\r\n        </div>\r\n      </div>\r\n      <aside class=\"profile-card\" aria-label=\"Profile summary\">\r\n        <div class=\"avatar\" aria-hidden=\"true\">LM</div>\r\n        <h2>Research Profile</h2>\r\n        <p>School of Biological Sciences<br />Riverbend University</p>\r\n        <dl>\r\n          <div><dt>Office</dt><dd>Blakely Hall, Room 312</dd></div>\r\n          <div><dt>Email</dt><dd><a href=\"mailto:lydia.moreno@riverbend.edu\">lydia.moreno@riverbend.edu</a></dd></div>\r\n          <div><dt>GitHub</dt><dd><a href=\"https://github.com/lydia-moreno\" rel=\"noopener noreferrer\">github.com/lydia-moreno</a></dd></div>\r\n        </dl>\r\n      </aside>\r\n    </section>\r\n\r\n    <section class=\"section two-column\" id=\"about\">\r\n      <div>\r\n        <p class=\"section-kicker\">About Me</p>\r\n        <h2>Building interpretable tools for modern neuroscience.</h2>\r\n      </div>\r\n      <div class=\"rich-text\">\r\n        <p>Dr. Lydia Moreno is an associate professor of Computational Neuroscience at Riverbend University’s School of Biological Sciences. Her work sits at the intersection of machine learning, systems neuroscience, and bioinformatics.</p>\r\n        <p>She received her Ph.D. in Computational Biology from Baywood Institute of Technology and completed postdoctoral training in high-throughput imaging analysis at Northborough Research Center.</p>\r\n      </div>\r\n    </section>\r\n\r\n    <section class=\"section\">\r\n      <div class=\"section-heading\">\r\n        <p class=\"section-kicker\">Research Interests</p>\r\n        <h2>Focus areas</h2>\r\n      </div>\r\n      <div class=\"card-grid\">\r\n        <article class=\"card\">\r\n          <h3>Neural Encoding & Decoding</h3>\r\n          <p>Developing interpretable models that translate spike-train data into behavioral predictions.</p>\r\n        </article>\r\n        <article class=\"card\">\r\n          <h3>Biomedical Imaging</h3>\r\n          <p>Applying convolutional and graph neural networks to MRI and two-photon microscopy data.</p>\r\n        </article>\r\n        <article class=\"card\">\r\n          <h3>Single-Cell Omics</h3>\r\n          <p>Designing scalable pipelines for multi-modal single-cell genomics and spatial transcriptomics.</p>\r\n        </article>\r\n        <article class=\"card\">\r\n          <h3>Explainable AI</h3>\r\n          <"]
[184.685758, "o", "p>Building frameworks to probe decision boundaries and feature attributions in black-box models.</p>\r\n"]
