[355.412316, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - <<'PY'\nimport inspect\nimport test_static_site\n\nfailed = 0\nfor name, func in sorted(vars(test_static_site).items()):\n    if name.startswith('test_') and callable(func):\n        try:\n            func()\n            print(f'PASS {name}')\n        except Exception as exc:\n            failed += 1\n            print(f'FAIL {name}: {exc}')\nif failed:\n    raise SystemExit(f'{failed} validation(s) failed')\nprint('All static site validations passed')\nPY\ntrue; tmux wait -S done\r"]
