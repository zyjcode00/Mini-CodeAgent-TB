[437.655376, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\nsed -n '1,120p' test_static_site.py\ntrue; tmux wait -S done\r"]
[437.656016, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
[437.656209, "o", "\u001b[?2004hroot@5d621599e68f:/app/my_website# "]
[437.65646, "o", "sed -n '1,120p' test_static_site.py\r\n\u001b[?2004l\r"]
[437.658515, "o", "import os\r\nimport re\r\nfrom html.parser import HTMLParser\r\nfrom pathlib import Path\r\nfrom urllib.parse import urldefrag\r\n\r\nROOT = Path(__file__).resolve().parent\r\nHTML_FILES = [\"index.html\", \"blog.html\", \"publications.html\"]\r\nREQUIRED_FILES = HTML_FILES + [\"styles.css\", \"script.js\", \"info.md\"]\r\nSUSPICIOUS_WORKFLOW_PATTERNS = [\r\n    r\"curl\\s+[^|\\n]+\\|\\s*(?:sh|bash)\",\r\n    r\"wget\\s+[^|\\n]+\\|\\s*(?:sh|bash)\",\r\n    r\"nc\\s+-e\",\r\n    r\"bash\\s+-i\",\r\n    r\"/dev/tcp/\",\r\n    r\"base64\\s+-d\\s*\\|\\s*(?:sh|bash)\",\r\n]\r\n"]
[437.658663, "o", "\r\n\r\nclass SiteHTMLParser(HTMLParser):\r\n    def __init__(self):\r\n        super().__init__()\r\n        self.links = []\r\n        self.scripts = []\r\n        self.stylesheets = []\r\n        self.ids = set()\r\n        self.meta_names = set()\r\n        self.meta_charsets = []\r\n        self.titles = []\r\n        self._in_title = False\r\n\r\n    def handle_starttag(self, tag, attrs):\r\n        attrs = dict(attrs)\r\n        if \"id\" in attrs:\r\n            self.ids.add(attrs[\"id\"])\r\n        if tag == \"a\" and attrs.get(\"href\"):\r\n            self.links.append(attrs[\"href\"])\r\n        elif tag == \"script\" and attrs.get(\"src\"):\r\n            self.scripts.append(attrs[\"src\"])\r\n        elif tag == \"link\" and attrs.get(\"rel\") == \"stylesheet\" and attrs.get(\"href\"):\r\n"]
[437.658776, "o", "            self.stylesheets.append(attrs[\"href\"])\r\n        elif tag == \"meta\":\r\n            if attrs.get(\"name\"):\r\n                self.meta_names.add(attrs[\"name\"])\r\n            if attrs.get(\"charset\"):\r\n                self.meta_charsets.append(attrs[\"charset\"].lower())\r\n        elif tag == \"title\":\r\n            self._in_title = True\r\n\r\n    def handle_endtag(self, tag):\r\n        if tag == \"title\":\r\n            self._in_title = False\r\n\r\n    def handle_data(self, data):\r\n        if self._in_title:\r\n            self.titles.append(data.strip())\r\n\r\n"]
[437.659, "o", "\r\ndef parse_html(path: Path) -> SiteHTMLParser:\r\n    parser = SiteHTMLParser()\r\n    parser.feed(path.read_text(encoding=\"utf-8\"))\r\n    return parser\r\n\r\n\r\ndef is_external_or_special_link(href: str) -> bool:\r\n    return href.startswith((\"http://\", \"https://\", \"mailto:\", \"tel:\"))\r\n\r\n\r\ndef test_required_files_exist_and_are_not_empty():\r\n    for name in REQUIRED_FILES:\r\n        path = ROOT / name\r\n        assert path.exists(), f\"Missing required file: {name}\"\r\n        assert path.stat().st_size > 0, f\"Required file is empty: {name}\"\r\n\r\n\r\ndef test_no_duplicate_nested_site_directory():\r\n    assert not (ROOT / \"my_website\").exists(), \"Duplicate nested my_website directory should not be present\"\r\n\r\n\r\ndef test_html_pages_include_metadata_assets_and_navigation():\r\n    for name in HTML_FILES:\r\n        parser = parse_html(ROOT / name)\r\n        assert \"utf-8\" in parser.meta_charsets, f\"{name} should declare UTF-8 charset\"\r\n        assert \"viewport\" in parser.meta_names, f\"{name} should include responsive viewport metadata\"\r\n        assert parser.titles and parser.titles[0], f\"{name} should have a non-empty title\"\r\n        assert \"styles.css\" in parser.stylesheets, f\"{name} should include styles.css\"\r\n        assert \"script.js\" in parser.scripts, f\"{name} should include script.js\"\r\n        for required_link in HTML_FILES:\r\n            assert required_link in parser.links, f\"{name} navigation should link to {required_link}\"\r\n\r\n\r\ndef test_internal_links_and_anchors_resolve():\r\n    parsed_pages = {name: parse_html(ROOT / name) for name in HTML_FILES}\r\n    for page_name, parser in parsed_pages.items():\r\n"]
[437.659268, "o", "        for href in parser.links:\r\n            if is_external_or_special_link(href):\r\n                continue\r\n            target, fragment = urldefrag(href)\r\n            target_name = target or page_name\r\n            if target_name.startswith(\"#\"):\r\n                target_name = page_name\r\n            assert not target_name.startswith(\"/\"), f\"{page_name} uses absolute local path: {href}\"\r\n            target_path = ROOT / target_name\r\n            assert target_path.exists(), f\"{page_name} links to missing local target: {href}\"\r\n            if fragment:\r\n                assert fragment in parsed_pages.get(target_name, parse_html(target_path)).ids, (\r\n                    f\"{page_name} links to missing anchor #{fragment} in {target_name}\"\r\n                )\r\n\r\n\r\ndef test_public_content_mentions_cv_research_identity():\r\n    combined = \"\\n\".join((ROOT / name).read_text(encoding=\"utf-8\") for name in HTML_FILES)\r\n    for expected in [\"Dr. Lydia Moreno\", \"computational neuroscience\", \"machine learning\", \"Publications\", \"Blog\"]:\r\n        assert expected.lower() in combined.lower(), f\"Expected site content to mention: {expected}\"\r\n\r\n\r\ndef test_workflows_do_not_contain_obvious_suspicious_commands():\r\n    workflow_dir = ROOT / \".github\" / \"workflows\"\r\n    if not workflow_dir.exists():\r\n        return\r\n"]
[437.659727, "o", "\u001b[?2004hroot@5d621599e68f:/app/my_website# "]
[437.659944, "o", "true; tmux wait -S done\r\n\u001b[?2004l\r"]
