[159.494364, "o", "content = '<!DOCTYPE html>\\n<html lang=\"en\">\\n<head>\\n  <meta charset=\"UTF-8\" />\\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\\n  <meta name=\"description\" content=\"Research blog by Dr. Lydia Moreno.\" />\\n  <title>Blog | Dr. Lydia Moreno</title>\\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Source+Serif+4:wght@600;700&display=swap\" rel=\"stylesheet\" />\\n  <link rel=\"stylesheet\" href=\"styles.css\" />\\n</head>\\n<body>\\n  <header class=\"site-header\">\\n    <nav class=\"navbar\" aria-label=\"Main navigation\">\\n      <a class=\"brand\" href=\"index.html\">Lydia Moreno</a>\\n      <button class=\"nav-toggle\" type=\"button\" aria-expanded=\"false\" aria-controls=\"site-menu\">Menu</button>\\n      <ul class=\"nav-links\" id=\"site-menu\">\\n        <li><a href=\"index.html\">About Me</a></li>\\n        <li><a href=\"publications.html\">Publications</a></li>\\n        <li><a class=\"active\" href=\"blog.html\">Blog</a></li>\\n      </ul>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\"page-hero compact\">\\n      <p class=\"eyebrow\">Research Notes</p>\\n      <h1>Blog</h1>\\n      <p>Short articles on interpretable deep learning, biological data integration, and scalable neuroscience workflows.</p>\\n    </section>\\n\\n    <section class=\"section blog-list\" aria-label=\"Blog posts\">\\n      <article class=\"blog-card\">\\n        <p class=\"post-date\">March 2025</p>\\n        <h2><a href=\"#interpretable-deep-learning\">Building Interpretable Deep Learning Models for Neuroscience</a></h2>\\n        <p>Notes on translating model explanations into hypotheses neuroscientists can test experimentally.</p>\\n      </article>\\n      <article class=\"blog-card\">\\n        <p class=\"post-date\">January 2025</p>\\n        <h2><a href=\"#ml-single-cell-genomics\">Bridging Machine Learning and Single-Cell Genomics</a></h2>\\n        <p>A practical overview of how machine learning can help integrate single-cell RNA, ATAC, and spatial data.</p>\\n      </article>\\n      <article class=\"blog-card\">\\n        <p class=\"post-date\">November 2024</p>\\n        <h2><a href=\"#gnn-connectomics\">Scaling Graph Neural Networks for Connectomics</a></h2>\\n        <p>Lessons from modeling neuron meshes, synapses, and large-scale circuit motifs with graph methods.</p>\\n      </article>\\n    </section>\\n\\n    <section class=\"section highlighted\" id=\"interpretable-deep-learning\">\\n      <p class=\"section-kicker\">Featured note</p>\\n      <h2>Building Interpretable Deep Learning Models for Neuroscience</h2>\\n      <p>Interpretability is most useful when it supports a concrete experimental loop: identify features, generate hypotheses, validate with perturbation or imaging, and refine the model. My group focuses on making that loop practical for calcium imaging, spike-train analysis, and multi-modal biological datasets.</p>\\n    </section>\\n  </main>\\n\\n  <footer class=\"site-footer\">\\n    <p>&copy; 2025 Dr. Lydia Moreno. <a href=\"index.html\">About</a> · <a href=\"publications.html\">Publications</a></p>\\n  </footer>\\n  <script src=\"script.js\"></script>\\n</body>\\n</html>\\n'\r\n\u001b[?2004l\r"]
