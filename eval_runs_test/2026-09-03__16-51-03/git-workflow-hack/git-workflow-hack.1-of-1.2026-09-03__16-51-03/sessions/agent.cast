[448.526062, "o", "nl -ba test_static_site.py | sed -n '1,35p'\r\n\u001b[?2004l\r"]
[448.529776, "o", "     1\timport os\r\n     2\timport re\r\n     3\tfrom html.parser import HTMLParser\r\n     4\tfrom pathlib import Path\r\n     5\tfrom urllib.parse import urldefrag\r\n     6\t\r\n     7\tROOT = Path(__file__).resolve().parent\r\n     8\tHTML_FILES = [\"index.html\", \"blog.html\", \"publications.html\"]\r\n     9\tREQUIRED_FILES = HTML_FILES + [\"styles.css\", \"script.js\", \"info.md\"]\r\n    10\tSUSPICIOUS_WORKFLOW_PATTERNS = [\r\n"]
[448.53005, "o", "    11\t    r\"curl\\s+[^|\\n]+\\|\\s*(?:sh|bash)\",\r\n    12\t    r\"wget\\s+[^|\\n]+\\|\\s*(?:sh|bash)\",\r\n    13\t    r\"nc\\s+-e\",\r\n    14\t    r\"bash\\s+-i\",\r\n    15\t    r\"/dev/tcp/\",\r\n    16\t    r\"base64\\s+-d\\s*\\|\\s*(?:sh|bash)\",\r\n    17\t]\r\n    18\t\r\n    19\t\r\n    20\tclass SiteHTMLParser(HTMLParser):\r\n    21\t    def __init__(self):\r\n    22\t        super().__init__()\r\n    23\t        self.links = []\r\n    24\t"]
[448.530206, "o", "        self.scripts = []\r\n    25\t        self.stylesheets = []\r\n    26\t        self.ids = set()\r\n    27\t        self.meta_names = set()\r\n    28\t        self.meta_charsets = []\r\n    29\t        self.titles = []\r\n    30\t        self._in_title = False\r\n    31\t\r\n    32\t    def handle_starttag(self, tag, attrs):\r\n    33\t        attrs = dict(attrs)\r\n    34\t        if \"id\" in attrs:\r\n    35\t            self.ids.add(attrs[\"id\"])\r\n"]
