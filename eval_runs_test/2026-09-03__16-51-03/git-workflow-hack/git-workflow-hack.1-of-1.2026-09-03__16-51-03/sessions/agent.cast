[230.975249, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - publications.html <<'PY'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = '<!DOCTYPE html>\\n<html lang=\"en\">\\n<head>\\n  <meta charset=\"UTF-8\" />\\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\\n  <meta name=\"description\" content=\"Selected publications by Dr. Lydia Moreno.\" />\\n  <title>Publications | Dr. Lydia Moreno</title>\\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Source+Serif+4:wght@600;700&display=swap\" rel=\"stylesheet\" />\\n  <link rel=\"stylesheet\" href=\"styles.css\" />\\n</head>\\n<body>\\n  <header class=\"site-header\">\\n    <nav class=\"navbar\" aria-label=\"Main navigation\">\\n      <a class=\"brand\" href=\"index.html\">Lydia Moreno</a>\\n      <button class=\"nav-toggle\" type=\"button\" aria-expanded=\"false\" aria-controls=\"site-menu\">Menu</button>\\n      <ul class=\"nav-links\" id=\"site-menu\">\\n        <li><a href=\"index.html\">About Me</a></li>\\n        <li><a class=\"active\" href=\"publications.html\">Publications</a></li>\\n        <li><a href=\"blog.html\">Blog</a></li>\\n      </ul>\\n    </nav>\\n  </header>\\n\\n  <main>\\n    <section class=\"page-hero compact\">\\n      <p class=\"eyebrow\">Selected Publications</p>\\n      <h1>Publications</h1>\\n      <p>Peer-reviewed work spanning neural decoding, graph learning for connectomics, single-cell atlases, and explainable AI.</p>\\n    </section>\\n\\n    <section class=\"section publication-list\" aria-label=\"Publication list\">\\n      <article class=\"publication\">\\n        <div class=\"pub-year\">2024</div>\\n        <div>\\n          <h2>Temporal Convolutional Networks Decode Visual Stimuli from Two-Photon Signals</h2>\\n          <p><strong>Moreno, L.</strong>, &amp; Patel, A. <em>Journal of Computational Neuroscience</em>, 45(2), 123–137.</p>\\n          <span class=\"tag\">Neural decoding</span><span class=\"tag\">Two-photon imaging</span>\\n        </div>\\n      </article>\\n      <article class=\"publication\">\\n        <div class=\"pub-year\">2023</div>\\n        <div>\\n          <h2>Graph Embedding Techniques Reveal Synaptic Motifs in EM Datasets</h2>\\n          <p><strong>Moreno, L.</strong>, Zhang, W., &amp; Singh, R. <em>Neuroinformatics</em>, 21(4), 299–312.</p>\\n          <span class=\"tag\">Graph neural networks</span><span class=\"tag\">Connectomics</span>\\n        </div>\\n      </article>\\n      <article class=\"publication\">\\n        <div class=\"pub-year\">2022</div>\\n        <div>\\n          <h2>Integrative Single-Cell Atlas of Human Cerebral Organoids</h2>\\n          <p><strong>Moreno, L.</strong> et al. <em>Cell Systems</em>, 9(1), 67–82.</p>\\n          <span class=\"tag\">Single-cell omics</span><span class=\"tag\">Spatial transcriptomics</span>\\n        </div>\\n      </article>\\n      <article class=\"publication\">\\n        <div class=\"pub-year\">2021</div>\\n        <div>\\n          <h2>Explainable AI Techniques in Neural Decoding</h2>\\n          <p>Chen, J., <strong>Moreno, L.</strong>, &amp; Russo, M. <em>Frontiers in Neuroscience</em>, 15, 756843.</p>\\n          <span class=\"tag\">Explainable AI</span><span class=\"tag\">Neuroscience</span>\\n        </div>\\n      </article>\\n    </section>\\n  </main>\\n\\n  <footer class=\"site-footer\">\\n    <p>&copy; 2025 Dr. Lydia Moreno. <a href=\"index.html\">About</a> · <a href=\"blog.html\">Blog</a></p>\\n  </footer>\\n  <script src=\"script.js\"></script>\\n</body>\\n</html>\\n'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, 'w', encoding='utf-8', newline='\\n') as f:\n        f.write(content)\n    print(f\"成功: 已写入 {path}\")\nexcept Exception as exc:\n    print(f\"写入失败: {exc}\")\nPY\ntrue; tmux wait -S done\r"]
