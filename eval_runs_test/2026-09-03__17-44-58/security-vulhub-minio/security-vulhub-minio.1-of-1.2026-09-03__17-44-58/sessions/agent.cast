[53.787128, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - <<'PY'\nimport http.client, json\nhost='node1'; port=9000\nchecks=[\n    ('GET','/minio/bootstrap/v1/verify',None,{}),\n    ('POST','/minio/bootstrap/v1/verify',b'',{}),\n    ('POST','/minio/bootstrap/v1/verify',b'{}',{'Content-Type':'application/json'}),\n    ('GET','/minio/bootstrap/v1/health',None,{}),\n    ('POST','/minio/bootstrap/v1/health',b'',{}),\n    ('GET','/minio/server/health/live',None,{}),\n    ('GET','/minio/v2/metrics/cluster',None,{}),\n    ('GET','/minio/v2/metrics/node',None,{}),\n]\nfor method,path,body,headers in checks:\n    print('\\n###', method, path)\n    try:\n        conn=http.client.HTTPConnection(host,port,timeout=5)\n        conn.request(method,path,body=body,headers=headers)\n        r=conn.getresponse()\n        data=r.read(8000)\n        print(r.status, r.reason)\n        for k,v in r.getheaders(): print(f'{k}: {v}')\n        print(data.decode('utf-8','replace')[:4000])\n        conn.close()\n    except Exception as e:\n        print('ERR',repr(e))\nPY\ntrue; tmux wait -S done\r"]
