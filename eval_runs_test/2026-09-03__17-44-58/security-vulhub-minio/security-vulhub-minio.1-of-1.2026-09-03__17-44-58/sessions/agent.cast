[42.150468, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - <<'PY'\nimport http.client\nhost='node1'; port=9000\npaths=['/','/minio/health/live','/minio/health/ready','/minio/config/v1','/minio/config/v1/config','/minio/admin/v3/info','/minio/admin/v3/config','/debug/vars','/.env','/config.json']\nfor p in paths:\n    print('\\n###',p)\n    try:\n        conn=http.client.HTTPConnection(host,port,timeout=5)\n        conn.request('GET',p)\n        r=conn.getresponse()\n        data=r.read(2000)\n        print(r.status, r.reason)\n        for k,v in r.getheaders(): print(f'{k}: {v}')\n        print(data[:1000].decode('utf-8','replace'))\n        conn.close()\n    except Exception as e:\n        print('ERR',repr(e))\nPY\ntrue; tmux wait -S done\r"]
