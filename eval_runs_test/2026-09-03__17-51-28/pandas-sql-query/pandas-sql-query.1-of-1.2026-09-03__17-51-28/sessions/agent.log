[?2004l[?2004h> content = 'from pathlib import Path\n\nimport duckdb\nimport pandas as pd\n\n\ndef test_answer_sql_top3_q4_2024():\n    products = pd.read_csv("/app/products.csv")\n    orders = pd.read_csv("/app/orders.csv", parse_dates=["order_date"])\n\n    con = duckdb.connect()\n    con.register("products", products)\n    con.register("orders", orders)\n\n    query = Path("/app/answer.sql").read_text()\n    actual_df = con.execute(query).df()\n\n    assert set(actual_df.columns) >= {"category", "product_id"}\n\n    q4_orders = orders[\n        (orders["order_date"] >= pd.Timestamp("2024-10-01"))\n        & (orders["order_date"] < pd.Timestamp("2025-01-01"))\n    ].copy()\n    q4_orders["sales"] = q4_orders["quantity"] * q4_orders["unit_price"]\n\n    expected_df = (\n        q4_orders.merge(products[["product_id", "category"]], on="product_id", how="inner")\n        .groupby(["category", "product_id"], as_index=False)["sales"]\n        .sum()\n        .sort_values(["category", "sales", "product_id"], ascending=[True, False, True])\n    )\n    expected_df["rn"] = expected_df.groupby("category").cumcount() + 1\n    expected_sets = {\n        category: set(group["product_id"].tolist())\n        for category, group in expected_df[expected_df["rn"] <= 3].groupby("category")\n    }\n\n    actual_sets = {\n        category: set(group["product_id"].tolist())\n        for category, group in actual_df.groupby("category")\n    }\n\n    assert actual_sets == expected_sets\n    assert all(len(products) == 3 for products in actual_sets.values())\n\n\nif __name__ == "__main__":\n    test_answer_sql_top3_q4_2024()\n    print("/app/answer.sql passed validation")\n'
