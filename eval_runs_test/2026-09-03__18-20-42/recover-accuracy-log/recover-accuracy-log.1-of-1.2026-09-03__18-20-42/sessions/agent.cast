[58.530122, "i", ", 3: []}\\n    for question_id, group in grouped.items():\\n        if len(group) != 3:\\n            raise ValueError(f'{question_id} has {len(group)} records, expected 3')\\n        for idx, record in enumerate(sorted(group, key=lambda r: r['timestamp']), start=1):\\n            runs[idx].append(record)\\n\\n    for run_index in runs:\\n        runs[run_index].sort(key=lambda r: r['timestamp'])\\n        if len(runs[run_index]) != 10:\\n            raise ValueError(f'run {run_index} has {len(runs[run_index])} records, expected 10')\\n    return runs\\n\\n\\ndef ordered_record(record, value_field):\\n    return {\\n        'timestamp': record['timestamp'],\\n        'question_id': record['question_id'],\\n        value_field: record[value_field],\\n    }\\n\\n\\ndef write_run_files(generator_runs, judge_runs):\\n    OUT_DIR.mkdir(parents=True, exist_ok=True)\\n    for run_index in (1, 2, 3):\\n        gen_path = OUT_DIR / f'run_{run_index}_generator.jsonl'\\n        judge_path = OUT_DIR / f'run_{run_index}_judge.jsonl'\\n        with "]
