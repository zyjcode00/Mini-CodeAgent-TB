[?2004l[?2004h> content = '#!/usr/bin/env python3\nimport json\nimport re\nimport unittest\nfrom collections import defaultdict\nfrom decimal import Decimal, ROUND_HALF_UP\nfrom pathlib import Path\n\nRAW_DIR = Path(\'/app/raw_logs\')\nOUT_DIR = Path(\'/app/recovered_logs\')\nERROR_MARKERS = (\'quota exceeds\', \'api error\', \'timeout\')\n\n\ndef load_jsonl(path):\n    with path.open(\'r\', encoding=\'utf-8\') as f:\n        return [json.loads(line) for line in f if line.strip()]\n\n\ndef is_error(value):\n    text = str(value).lower()\n    return any(marker in text for marker in ERROR_MARKERS)\n\n\ndef expected_runs(role):\n    field = \'prediction\' if role == \'generator\' else \'target\'\n    records = load_jsonl(RAW_DIR / f\'{role}.log\')\n    groups = defaultdict(list)\n    for record in records:\n        groups[record[\'question_id\']].append(record)\n    assert len(groups) == 10\n    runs = {1: [], 2: [], 3: []}\n    for qid, group in groups.items():\n        assert len(group) == 3, qid\n        for run_index, record in enumerate(sorted(group, key=lambda r: r[\'timestamp\']), 1):\n            runs[run_index].append({\n                \'timestamp\': record[\'timestamp\'],\n                \'question_id\': record[\'question_id\'],\n                field: record[field],\n            })\n    for run_index in runs:\n        runs[run_index].sort(key=lambda r: r[\'timestamp\'])\n    return runs\n\n\ndef round_half_up_accuracy(correct, total):\n    if total == 0:\n        return None\n    return float((Decimal(correct) / Decimal(total)).quantize(Decimal(\'0.01\'), rounding=ROUND_HALF_UP))\n\n\nclass RecoveredLogsTest(unittest.TestCase):\n    @classmethod\n    def setUpClass(cls):\n        cls.expected_generator = expected_runs(\'generator\')\n        cls.expected_judge = expected_runs(\'judge\')\n\n    def test_exact_output_files_exist(self):\n        expected = {\n            \'run_1_generator.jsonl\', \'run_1_judge.jsonl\',\n            \'run_2_generator.jsonl\', \'run_2_judge.jsonl\',\n            \'run_3_generator.jsonl\', \'run_3_judge.jsonl\',\n            \'results.json\',\n        }\n        actual = {p.name for p in OUT_DIR.iterdir() if p.is_file()}\n        self.assertEqual(expected, actual)\n\n    def test_jsonl_format_assignment_order_and_sorting(self):\n        key_pattern = {\n            \'generator\': re.compile(r\'^\\{"timestamp":"[^"]+","question_id":"[^"]+","prediction":"[^"]*"\\}\\n$\'),\n            \'judge\': re.compile(r\'^\\{"timestamp":"[^"]+","question_id":"[^"]+","target":"[^"]*"\\}\\n$\'),\n        }\n        expected_by_role = {\n            \'generator\': self.expected_generator,\n            \'judge\': self.expected_judge,\n        }\n        for role in (\'generator\', \'judge\'):\n            for run_index in (1, 2, 3):\n                path = OUT_DIR / f\'run_{run_index}_{role}.jsonl\'\n                raw_lines = path.read_text(encoding=\'utf-8\').splitlines(keepends=True)\n                self.assertEqual(10, len(raw_lines), path)\n                for line in raw_lines:\n                    self.assertRegex(line, key_pattern[role], path)\n                    self.assertEqual(line, json.dumps(json.loads(line), separators=(\',\', \':\')) + \'\\n\')\n                records = [json.loads(line) for line in raw_lines]\n                self.assertEqual(sorted(records, key=lambda r: r[\'timestamp\']), records, path)\n                self.assertEqual(expected_by_role[role][run_index], records, path)\n                self.assertEqual(10, len({r[\'question_id\'] for r in records}), path)\n\n    def test_results_are_recomputed_after_excluding_errors(self):\n        expected_runs = []\n        for run_index in (1, 2, 3):\n            gen_by_qid = {r[\'question_id\']: r for r in self.expected_generator[run_index]}\n            judge_by_qid = {r[\'question_id\']: r for r in self.expected_judge[run_index]}\n            correct = 0\n            total = 0\n            for qid, gen_record in gen_by_qid.items():\n                judge_record = judge_by_qid.get(qid)\n                if judge_record is None:\n                    continue\n                pred = gen_record[\'prediction\']\n                target = judge_record[\'target\']\n                if is_error(pred) or is_error(target):\n                    continue\n                total += 1\n                correct += int(pred) == int(target)\n            expected_runs.append({\n                \'run_index\': run_index,\n                \'correct\': correct,\n                \'total\': total,\n                \'accuracy\': round_half_up_accuracy(correct, total),\n            })\n        actual = json.loads((OUT_DIR / \'results.json\').read_text(encoding=\'utf-8\'))\n        self.assertEqual({\'runs\': expected_runs}, actual)\n\n\nif __name__ == \'__main__\':\n    unittest.main()\n'
