[?2004l[?2004h> import os
[?2004l[?2004h> import sys
[?2004l[?2004h> path = sys.argv[1]
[?2004l[?2004h> content = "#!/usr/bin/env python3\nimport json\nfrom collections import defaultdict\nfrom decimal import Decimal, ROUND_HALF_UP\nfrom pathlib import Path\n\nRAW_DIR = Path('/app/raw_logs')\nOUT_DIR = Path('/app/recovered_logs')\nERROR_MARKERS = ('quota exceeds', 'api error', 'timeout')\n\n\ndef load_jsonl(path):\n    records = []\n    with path.open('r', encoding='utf-8') as f:\n        for line_no, line in enumerate(f, 1):\n            line = line.strip()\n            if not line:\n                continue\n            obj = json.loads(line)\n            records.append(obj)\n    return records\n\n\ndef is_error(value):\n    text = str(value).lower()\n    return any(marker in text for marker in ERROR_MARKERS)\n\n\ndef assign_runs(records):\n    grouped = defaultdict(list)\n    for record in records:\n        grouped[record['question_id']].append(record)\n\n    runs = {1: [], 2: [], 3: []}\n    for question_id, group in grouped.items():\n        if len(group) != 3:\n            raise ValueError(f'{question_id} has {len(group)} records, expected 3')\n        for idx, record in enumerate(sorted(group, key=lambda r: r['timestamp']), start=1):\n            runs[idx].append(record)\n\n    for run_index in runs:\n        runs[run_index].sort(key=lambda r: r['timestamp'])\n        if len(runs[run_index]) != 10:\n            raise ValueError(f'run {run_index} has {len(runs[run_index])} records, expected 10')\n    return runs\n\n\ndef ordered_record(record, value_field):\n    return {\n        'timestamp': record['timestamp'],\n        'question_id': record['question_id'],\n        value_field: record[value_field],\n    }\n\n\ndef write_run_files(generator_runs, judge_runs):\n    OUT_DIR.mkdir(parents=True, exist_ok=True)\n    for run_index in (1, 2, 3):\n        gen_path = OUT_DIR / f'run_{run_index}_generator.jsonl'\n        judge_path = OUT_DIR / f'run_{run_index}_judge.jsonl'\n        with gen_path.open('w', encoding='utf-8', newline='\\n') as f:\n            for record in generator_runs[run_index]:\n                f.write(json.dumps(ordered_record(record, 'prediction'), separators=(',', ':')) + '\\n')\n        with judge_path.open('w', encoding='utf-8', newline='\\n') as f:\n            for record in judge_runs[run_index]:\n                f.write(json.dumps(ordered_record(record, 'target'), separators=(',', ':')) + '\\n')\n\n\ndef rounded_accuracy(correct, total):\n    if total == 0:\n        return None\n    value = (Decimal(correct) / Decimal(total)).quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)\n    return float(value)\n\n\ndef compute_results(generator_runs, judge_runs):\n    results = []\n    for run_index in (1, 2, 3):\n        gen_by_qid = {r['question_id']: r for r in generator_runs[run_index]}\n        judge_by_qid = {r['question_id']: r for r in judge_runs[run_index]}\n        correct = 0\n        total = 0\n        for question_id, gen_record in gen_by_qid.items():\n            judge_record = judge_by_qid.get(question_id)\n            if judge_record is None:\n                continue\n            prediction = gen_record['prediction']\n            target = judge_record['target']\n            if is_error(prediction) or is_error(target):\n                continue\n            total += 1\n            if int(prediction) == int(target):\n                correct += 1\n        results.append({\n            'run_index': run_index,\n            'correct': correct,\n            'total': total,\n            'accuracy': rounded_accuracy(correct, total),\n        })\n    return {'runs': results}\n\n\ndef main():\n    generator_records = load_jsonl(RAW_DIR / 'generator.log')\n    judge_records = load_jsonl(RAW_DIR / 'judge.log')\n    generator_runs = assign_runs(generator_records)\n    judge_runs = assign_runs(judge_records)\n    write_run_files(generator_runs, judge_runs)\n    results = compute_results(generator_runs, judge_runs)\n    with (OUT_DIR / 'results.json').open('w', encoding='utf-8') as f:\n        json.dump(results, f, separators=(',', ':'))\n        f.write('\\n')\n\n\nif __name__ == '__main__':\n    main()\n"
