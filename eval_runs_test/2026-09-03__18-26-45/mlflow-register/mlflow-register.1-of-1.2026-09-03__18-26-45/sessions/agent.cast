[33.703403, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\nset -e\npwd\npython - <<'PY'\nimport importlib.util\nfor pkg in ['mlflow','sklearn','numpy']:\n    spec = importlib.util.find_spec(pkg)\n    print(f'{pkg}: {\"FOUND\" if spec else \"MISSING\"}')\nPY\n( ss -ltnp 2>/dev/null || netstat -ltnp 2>/dev/null || true ) | grep ':8080' || true\ncurl -sS -o /tmp/mlflow_8080_probe.txt -w 'HTTP_STATUS=%{http_code}\\n' http://127.0.0.1:8080/ 2>/tmp/mlflow_8080_curl.err || true\ncat /tmp/mlflow_8080_curl.err || true\ncat /tmp/mlflow_8080_probe.txt 2>/dev/null | head -c 200 || true\ntrue; tmux wait -S done\r"]
