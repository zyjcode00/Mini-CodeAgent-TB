[90.332453, "o", "import time\r\n\r\nimport mlflow\r\nimport mlflow.sklearn\r\nimport numpy as np\r\nfrom mlflow.models import infer_signature\r\nfrom mlflow.tracking import MlflowClient\r\nfrom sklearn.linear_model import LinearRegression\r\nfrom sklearn.metrics import mean_squared_error, r2_score\r\nfrom sklearn.model_selection import train_test_split\r\n\r\n\r\nTRACKING_URI = \"http://127.0.0.1:8080\"\r\nREGISTERED_MODEL_NAME = \"gpt-5\"\r\nEXPERIMENT_NAME = \"gpt-5-random-linear-regression\"\r\nRANDOM_SEED = None  # None intentionally randomizes each run.\r\n\r\n\r\ndef main() -> None:\r\n    rng = np.random.default_rng(RANDOM_SEED)\r\n\r\n    # Random dataset with exactly 3 features.\r\n    n_samples = 200\r\n    n_features = 3\r\n    x = rng.normal(size=(n_samples, n_features))\r\n\r\n    # Random underlying linear relationship plus random noise.\r\n    true_coef = rng.normal(size=n_features)\r\n    true_intercept = float(rng.normal())\r\n    noise = rng.normal(scale=0.15, size=n_samples)\r\n    y = x @ true_coef + true_intercept + noise\r\n\r\n    x_train, x_test, y_train, y_test = train_"]
[90.332745, "o", "test_split(\r\n        x, y, test_size=0.25, random_state=int(rng.integers(0, 2**31 - 1))\r\n    )\r\n\r\n    # sklearn LinearRegression itself has no random_state parameter; randomness here comes\r\n    # from the random training data and random train/test split above.\r\n    model = LinearRegression()\r\n    model.fit(x_train, y_train)\r\n\r\n    preds = model.predict(x_test)\r\n    mse = mean_squared_error(y_test, preds)\r\n    r2 = r2_score(y_test, preds)\r\n\r\n    mlflow.set_tracking_uri(TRACKING_URI)\r\n    mlflow.set_experiment(EXPERIMENT_NAME)\r\n\r\n    signature = infer_signature(x_train, model.predict(x_train))\r\n    input_example = x_train[:5]\r\n\r\n    with mlflow.start_run(run_name=\"random-3-feature-linear-regression\") as run:\r\n        mlflow.log_param(\"n_samples\", n_samples)\r\n        mlflow.log_param(\"n_features\", n_features)\r\n        mlflow.log_param(\"model_type\", \"sklearn.linear_model.LinearRegression\")\r\n        mlflow.log_param(\"true_coef\", true_coef.tolist())\r\n        mlflow.log_param(\"true_intercept\", true_intercept)\r\n     "]
[90.332851, "o", "   mlflow.log_metric(\"mse\", float(mse))\r\n        mlflow.log_metric(\"r2\", float(r2))\r\n\r\n        mlflow.sklearn.log_model(\r\n            sk_model=model,\r\n            artifact_path=\"model\",\r\n            signature=signature,\r\n            input_example=input_example,\r\n            registered_model_name=REGISTERED_MODEL_NAME,\r\n        )\r\n\r\n        print(f\"run_id={run.info.run_id}\")\r\n        print(f\"registered_model_name={REGISTERED_MODEL_NAME}\")\r\n        print(f\"coef={model.coef_.tolist()}\")\r\n        print(f\"intercept={float(model.intercept_)}\")\r\n        print(f\"mse={float(mse)}\")\r\n        print(f\"r2={float(r2)}\")\r\n\r\n    client = MlflowClient(tracking_uri=TRACKING_URI)\r\n    deadline = time.time() + 60\r\n    while time.time() < deadline:\r\n        versions = client.search_model_versions(f\"name = '{REGISTERED_MODEL_NAME}'\")\r\n        if versions:\r\n            newest = max(versions, key=lambda v: int(v.version))\r\n            print(f\"latest_model_version={newest.version}\")\r\n            print(f\"latest_model_status={newest.st"]
[90.33297, "o", "atus}\")\r\n            return\r\n        time.sleep(1)\r\n\r\n    raise RuntimeError(f\"Model {REGISTERED_MODEL_NAME!r} was not registered within timeout\")\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
