[82.699069, "i", ")\\n    noise = rng.normal(scale=0.15, size=n_samples)\\n    y = x @ true_coef + true_intercept + noise\\n\\n    x_train, x_test, y_train, y_test = train_test_split(\\n        x, y, test_size=0.25, random_state=int(rng.integers(0, 2**31 - 1))\\n    )\\n\\n    # sklearn LinearRegression itself has no random_state parameter; randomness here comes\\n    # from the random training data and random train/test split above.\\n    model = LinearRegression()\\n    model.fit(x_train, y_train)\\n\\n    preds = model.predict(x_test)\\n    mse = mean_squared_error(y_test, preds)\\n    r2 = r2_score(y_test, preds)\\n\\n    mlflow.set_tracking_uri(TRACKING_URI)\\n    mlflow.set_experiment(EXPERIMENT_NAME)\\n\\n    signature = infer_signature(x_train, model.predict(x_train))\\n    input_example = x_train[:5]\\n\\n    with mlflow.start_run(run_name=\"random-3-feature-linear-regression\") as run:\\n        mlflow.log_param(\"n_samples\", n_samples)\\n        mlflow.log_param(\"n_features\", n_features)\\n        mlflow.log_param(\"model_type\", \"sklearn.linear_"]
