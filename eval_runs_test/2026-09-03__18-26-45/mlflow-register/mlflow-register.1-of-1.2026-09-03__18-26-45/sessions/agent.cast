[120.327176, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\nset -e\npython - <<'PY'\nfrom mlflow.tracking import MlflowClient\n\ntracking_uri = 'http://127.0.0.1:8080'\nmodel_name = 'gpt-5'\nclient = MlflowClient(tracking_uri=tracking_uri)\n\nmodel = client.get_registered_model(model_name)\nversions = client.search_model_versions(f\"name = '{model_name}'\")\n\nprint(f'tracking_uri={tracking_uri}')\nprint(f'registered_model_name={model.name}')\nprint(f'latest_versions_count={len(model.latest_versions)}')\nprint(f'all_versions_count={len(versions)}')\nfor v in sorted(versions, key=lambda x: int(x.version)):\n    print(f'version={v.version}, status={v.status}, run_id={v.run_id}, source={v.source}')\n\nassert model.name == model_name\nassert versions, f'No versions found for registered model {model_name!r}'\nassert any(v.status == 'READY' for v in versions), 'No READY model version found'\nprint('VALIDATION_OK')\nPY\ntrue; tmux wait -S done\r"]
