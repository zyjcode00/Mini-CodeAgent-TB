Sending keys: ['export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/create_availability.py <<\'PY\'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = \'#!/usr/bin/env python3\\n"""Parse raw friend schedules into all_availability.json."""\\n\\nimport json\\nimport re\\nfrom datetime import date, datetime, timedelta\\nfrom pathlib import Path\\n\\nBASE = Path(\\\'/app\\\')\\nYEAR_START = date(2025, 1, 1)\\nYEAR_END = date(2025, 12, 31)\\n\\nMONTHS = {\\n    \\\'January\\\': 1, \\\'February\\\': 2, \\\'March\\\': 3, \\\'April\\\': 4,\\n    \\\'May\\\': 5, \\\'June\\\': 6, \\\'July\\\': 7, \\\'August\\\': 8,\\n    \\\'September\\\': 9, \\\'October\\\': 10, \\\'November\\\': 11, \\\'December\\\': 12,\\n}\\n\\n\\ndef parse_iso(s: str) -> date:\\n    return datetime.strptime(s, \\\'%Y-%m-%d\\\').date()\\n\\n\\ndef fmt(d: date) -> str:\\n    return d.strftime(\\\'%Y-%m-%d\\\')\\n\\n\\ndef complement(busy_ranges, start=YEAR_START, end=YEAR_END):\\n    busy = sorted(busy_ranges)\\n    free = []\\n    cursor = start\\n    for b_start, b_end in busy:\\n        if b_end < cursor:\\n            continue\\n        if b_start > cursor:\\n            free.append((cursor, b_start - timedelta(days=1)))\\n        cursor = max(cursor, b_end + timedelta(days=1))\\n    if cursor <= end:\\n        free.append((cursor, end))\\n    return free\\n\\n\\ndef ranges_to_json(ranges):\\n    return [{\\\'start\\\': fmt(s), \\\'end\\\': fmt(e)} for s, e in ranges if s <= e]\\n\\n\\ndef parse_alice():\\n    text = (BASE / \\\'alice_schedule.txt\\\').read_text()\\n    busy = []\\n    for start, end in re.findall(r\\\'UNAVAILABLE:\\\\s*(\\\\d{4}-\\\\d{2}-\\\\d{2}) to (\\\\d{4}-\\\\d{2}-\\\\d{2})\\\', text):\\n        busy.append((parse_iso(start), parse_iso(end)))\\n    return complement(busy)\\n\\n\\ndef parse_bob():\\n    text = (BASE / \\\'bob_schedule.txt\\\').read_text()\\n    off_dates = []\\n    for line in text.splitlines():\\n        m = re.match(r\\\'SHIFT:\\\\s*(\\\\d{4}-\\\\d{2}-\\\\d{2}),off,\\\', line)\\n        if m:\\n            off_dates.append(parse_iso(m.group(1)))\\n    off_dates = sorted(off_dates)\\n    ranges = []\\n    if off_dates:\\n        start = prev = off_dates[0]\\n        for d in off_dates[1:]:\\n            if d == prev + timedelta(days=1):\\n                prev = d\\n            else:\\n                ranges.append((start, prev))\\n                start = prev = d\\n        ranges.append((start, prev))\\n    return ranges\\n\\n\\ndef parse_charlie():\\n    text = (BASE / \\\'charlie_schedule.txt\\\').read_text()\\n    busy = []\\n    # January 2025 - May 2025 means full inclusive months.\\n    busy.append((date(2025, 1, 1), date(2025, 5, 31)))\\n    for month, start_day, end_day, year in re.findall(r\\\'(June|July|August)\\\\s+(\\\\d{1,2})-(\\\\d{1,2}),\\\\s*(\\\\d{4})\\\', text):\\n        y = int(year)\\n        m = MONTHS[month]\\n        busy.append((date(y, m, int(start_day)), date(y, m, int(end_day))))\\n    return complement(busy)\\n\\n\\ndef parse_dana():\\n    text = (BASE / \\\'dana_schedule.txt\\\').read_text()\\n    busy = []\\n    for start, end in re.findall(r\\\'BUSY:\\\\s*(\\\\d{4}-\\\\d{2}-\\\\d{2}) to (\\\\d{4}-\\\\d{2}-\\\\d{2})\\\', text):\\n        busy.append((parse_iso(start), parse_iso(end)))\\n    return complement(busy)\\n\\n\\ndef main():\\n    data = {\\n        \\\'alice\\\': ranges_to_json(parse_alice()),\\n        \\\'bob\\\': ranges_to_json(parse_bob()),\\n        \\\'charlie\\\': ranges_to_json(parse_charlie()),\\n        \\\'dana\\\': ranges_to_json(parse_dana()),\\n    }\\n    (BASE / \\\'all_availability.json\\\').write_text(json.dumps(data, indent=2) + \\\'\\\\n\\\')\\n    print(json.dumps(data, indent=2))\\n\\n\\nif __name__ == \\\'__main__\\\':\\n    main()\\n\'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, \'w\', encoding=\'utf-8\', newline=\'\\n\') as f:\n        f.write(content)\n    print(f"成功: 已写入 {path}")\nexcept Exception as exc:\n    print(f"写入失败: {exc}")\nPY\ntrue', '; tmux wait -S done', 'Enter'] min_timeout_sec: 0.0 max_timeout_sec: inf
