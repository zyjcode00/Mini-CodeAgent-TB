[66.856568, "i", "_start > cursor:\\n            free.append((cursor, b_start - timedelta(days=1)))\\n        cursor = max(cursor, b_end + timedelta(days=1))\\n    if cursor <= end:\\n        free.append((cursor, end))\\n    return free\\n\\n\\ndef ranges_to_json(ranges):\\n    return [{\\'start\\': fmt(s), \\'end\\': fmt(e)} for s, e in ranges if s <= e]\\n\\n\\ndef parse_alice():\\n    text = (BASE / \\'alice_schedule.txt\\').read_text()\\n    busy = []\\n    for start, end in re.findall(r\\'UNAVAILABLE:\\\\s*(\\\\d{4}-\\\\d{2}-\\\\d{2}) to (\\\\d{4}-\\\\d{2}-\\\\d{2})\\', text):\\n        busy.append((parse_iso(start), parse_iso(end)))\\n    return complement(busy)\\n\\n\\ndef parse_bob():\\n    text = (BASE / \\'bob_schedule.txt\\').read_text()\\n    off_dates = []\\n    for line in text.splitlines():\\n        m = re.match(r\\'SHIFT:\\\\s*(\\\\d{4}-\\\\d{2}-\\\\d{2}),off,\\', line)\\n        if m:\\n            off_dates.append(parse_iso(m.group(1)))\\n    off_dates = sorted(off_dates)\\n    ranges = []\\n    if off_dates:\\n        start = prev = off_dates[0]\\n        for d in off_da"]
[66.856657, "i", "tes[1:]:\\n            if d == prev + timedelta(days=1):\\n                prev = d\\n            else:\\n                ranges.append((start, prev))\\n                start = prev = d\\n        ranges.append((start, prev))\\n    return ranges\\n\\n\\ndef parse_charlie():\\n    text = (BASE / \\'charlie_schedule.txt\\').read_text()\\n    busy = []\\n    # January 2025 - May 2025 means full inclusive months.\\n    busy.append((date(2025, 1, 1), date(2025, 5, 31)))\\n    for month, start_day, end_day, year in re.findall(r\\'(June|July|August)\\\\s+(\\\\d{1,2})-(\\\\d{1,2}),\\\\s*(\\\\d{4})\\', text):\\n        y = int(year)\\n        m = MONTHS[month]\\n        busy.append((date(y, m, int(start_day)), date(y, m, int(end_day))))\\n    return complement(busy)\\n\\n\\ndef parse_dana():\\n    text = (BASE / \\'dana_schedule.txt\\').read_text()\\n    busy = []\\n    for start, end in re.findall(r\\'BUSY:\\\\s*(\\\\d{4}-\\\\d{2}-\\\\d{2}) to (\\\\d{4}-\\\\d{2}-\\\\d{2})\\', text):\\n        busy.append((parse_iso(start), parse_iso(end)))\\n    return complement(busy)\\n\\n\\nd"]
