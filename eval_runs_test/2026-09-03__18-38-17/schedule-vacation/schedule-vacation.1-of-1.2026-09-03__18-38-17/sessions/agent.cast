[89.321284, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\ncd /app && python3 find_overlap.py 7 /app/all_availability.json && python3 - <<'PY'\nimport json\nfrom pathlib import Path\np = Path('/app/overlap_results.json')\ndata = json.loads(p.read_text())\nprint(json.dumps(data, indent=2))\nall_four = [w for w in data['overlapping_windows'] if w['friend_count'] == 4]\nprint('ALL_FOUR_WINDOWS=', all_four)\nassert data['vacation_duration'] == 7\nassert all_four, 'No 7-day window with all four friends available'\nassert {'alice','bob','charlie','dana'} == set(all_four[0]['available_friends'])\nPY\ntrue; tmux wait -S done\r"]
