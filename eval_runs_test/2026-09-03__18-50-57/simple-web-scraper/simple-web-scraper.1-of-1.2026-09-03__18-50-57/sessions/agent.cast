[142.152034, "o", "> "]
[142.152118, "o", "    mock_response.raise_for_status = Mock()\r\n\u001b[?2004l\r"]
[142.152148, "o", "\u001b[?2004h> "]
[142.152464, "o", "    with patch('scrape_books.requests.get', return_value=mock_response) as mock_get:\r\n\u001b[?2004l\r"]
[142.152493, "o", "\u001b[?2004h> "]
