[142.148202, "o", "    Book('The First Book', 'Alice Writer', 1999, 4.7, 12.5),\r\n\u001b[?2004l\r"]
[142.148233, "o", "\u001b[?2004h> "]
[142.148437, "o", "    Book('Second Story', 'Bob Author', 2005, 4.9, 20.0),\r\n\u001b[?2004l\r\u001b[?2004h"]
[142.14848, "o", "> ]\r\n"]
[142.148531, "o", "\u001b[?2004l\r\u001b[?2004h"]
[142.148627, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.14879, "o", "with tempfile.TemporaryDirectory() as tmp:\r\n\u001b[?2004l\r\u001b[?2004h"]
[142.148825, "o", "> "]
[142.148945, "o", "    tmp = Path(tmp)\r\n\u001b[?2004l\r\u001b[?2004h"]
[142.149047, "o", "> "]
[142.149156, "o", "    csv_path = tmp / 'books.csv'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.149271, "o", "    report_path = tmp / 'report.txt'\r\n\u001b[?2004l\r\u001b[?2004h"]
[142.149359, "o", "> "]
[142.149519, "o", "    df = scrape_books.write_books_csv(books, csv_path)\r\n\u001b[?2004l\r"]
[142.149601, "o", "\u001b[?2004h> "]
[142.149699, "o", "    loaded = pd.read_csv(csv_path)\r\n\u001b[?2004l\r\u001b[?2004h"]
[142.149775, "o", "> "]
[142.149995, "o", "    assert list(loaded.columns) == ['title', 'author', 'year', 'rating', 'price']\r\n\u001b[?2004l\r"]
[142.150102, "o", "\u001b[?2004h> "]
[142.150188, "o", "    assert loaded.shape == (2, 5)\r\n\u001b[?2004l\r"]
[142.150287, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.150471, "o", "    report = scrape_books.write_report(df, report_path)\r\n\u001b[?2004l\r\u001b[?2004h"]
[142.15054, "o", "> "]
[142.150708, "o", "    assert 'Total number of books scraped: 2' in report\r\n\u001b[?2004l\r\u001b[?2004h"]
[142.1508, "o", "> "]
[142.15095, "o", "    assert 'Average book price: $16.25' in report\r\n\u001b[?2004l\r\u001b[?2004h"]
[142.151031, "o", "> "]
[142.151282, "o", "    assert 'Highest rated book: Second Story by Bob Author (Rating: 4.9/5)' in report\r\n\u001b[?2004l\r"]
[142.151371, "o", "\u001b[?2004h> "]
[142.151516, "o", "    assert report_path.read_text(encoding='utf-8') == report\r\n\u001b[?2004l\r"]
[142.151599, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[142.15167, "o", "> "]
