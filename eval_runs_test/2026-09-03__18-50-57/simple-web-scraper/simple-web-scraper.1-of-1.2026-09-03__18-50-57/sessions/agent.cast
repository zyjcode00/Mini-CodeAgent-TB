[102.245092, "i", "\\n  </body>\\n</html>\\n\"\"\"\\n\\n\\ndef test_parse_books_extracts_required_fields():\\n    books = scrape_books.parse_books(SAMPLE_HTML)\\n\\n    assert books == [\\n        Book(\"The First Book\", \"Alice Writer\", 1999, 4.7, 12.50),\\n        Book(\"Second Story\", \"Bob Author\", 2005, 4.9, 20.00),\\n    ]\\n\\n\\ndef test_write_books_csv_has_required_columns(tmp_path):\\n    csv_path = tmp_path / \"books.csv\"\\n    books = [\\n        Book(\"The First Book\", \"Alice Writer\", 1999, 4.7, 12.50),\\n        Book(\"Second Story\", \"Bob Author\", 2005, 4.9, 20.00),\\n    ]\\n\\n    df = scrape_books.write_books_csv(books, csv_path)\\n    loaded = pd.read_csv(csv_path)\\n\\n    assert list(df.columns) == [\"title\", \"author\", \"year\", \"rating\", \"price\"]\\n    assert list(loaded.columns) == [\"title\", \"author\", \"year\", \"rating\", \"price\"]\\n    assert loaded.to_dict(\"records\") == [\\n        {\"title\": \"The First Book\", \"author\": \"Alice Writer\", \"year\": 1999, \"rating\": 4.7, \"price\": 12.5},\\n        {\"title\": \"Second Story\", \"author\": \"Bob Author\", \"year\": 20"]
[102.245299, "i", "05, \"rating\": 4.9, \"price\": 20.0},\\n    ]\\n\\n\\ndef test_build_report_includes_summary_values():\\n    df = scrape_books.books_to_dataframe([\\n        Book(\"The First Book\", \"Alice Writer\", 1999, 4.7, 12.50),\\n        Book(\"Second Story\", \"Bob Author\", 2005, 4.9, 20.00),\\n    ])\\n\\n    report = scrape_books.build_report(df)\\n\\n    assert \"Total number of books scraped: 2\" in report\\n    assert \"Average book price: $16.25\" in report\\n    assert \"Highest rated book: Second Story by Bob Author (Rating: 4.9/5)\" in report\\n\\n\\ndef test_scrape_fetches_html_and_writes_outputs(tmp_path):\\n    csv_path = tmp_path / \"books.csv\"\\n    report_path = tmp_path / \"report.txt\"\\n    mock_response = Mock()\\n    mock_response.text = SAMPLE_HTML\\n    mock_response.raise_for_status = Mock()\\n\\n    with patch(\"scrape_books.requests.get\", return_value=mock_response) as mock_get:\\n        df = scrape_books.scrape(\"http://example.test\", csv_path, report_path)\\n\\n    mock_get.assert_called_once_with(\"http://example.test\", timeout=10)\\n  "]
