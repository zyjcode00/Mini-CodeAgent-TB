[71.751009, "o", "content = '#!/usr/bin/env python3\\n\"\"\"Scrape book information from the local bookstore website.\\n\\nThe scraper fetches http://server:8000, extracts book title, author, year,\\nrating, and price from the documented HTML structure, then writes:\\n  - /app/books.csv\\n  - /app/report.txt\\n\"\"\"\\n\\nfrom __future__ import annotations\\n\\nimport re\\nfrom dataclasses import dataclass\\nfrom pathlib import Path\\nfrom typing import Iterable, Optional\\n\\nimport pandas as pd\\nimport requests\\nfrom bs4 import BeautifulSoup\\n\\nURL = \"http://server:8000\"\\nCSV_PATH = Path(\"/app/books.csv\")\\nREPORT_PATH = Path(\"/app/report.txt\")\\nCSV_COLUMNS = [\"title\", \"author\", \"year\", \"rating\", \"price\"]\\n\\n\\n@dataclass(frozen=True)\\nclass Book:\\n    title: str\\n    author: str\\n    year: int\\n    rating: float\\n    price: float\\n\\n\\ndef _required_text(parent, selector: str) -> str:\\n    \"\"\"Return stripped text for a required selector or raise ValueError.\"\"\"\\n    element = parent.select_one(selector)\\n    if element is None:\\n        raise ValueE"]
[71.751271, "o", "rror(f\"Missing required element: {selector}\")\\n    return element.get_text(strip=True)\\n\\n\\ndef _first_number(text: str, *, as_float: bool = False):\\n    \"\"\"Extract the first integer/decimal number from text.\"\"\"\\n    match = re.search(r\"\\\\d+(?:\\\\.\\\\d+)?\", text)\\n    if not match:\\n        raise ValueError(f\"No numeric value found in: {text!r}\")\\n    value = match.group(0)\\n    return float(value) if as_float else int(float(value))\\n\\n\\ndef clean_author(text: str) -> str:\\n    \"\"\"Normalize author text such as \\'by Jane Austen\\' to \\'Jane Austen\\'.\"\"\"\\n    return re.sub(r\"^\\\\s*by\\\\s+\", \"\", text, flags=re.IGNORECASE).strip()\\n\\n\\ndef parse_book(book_element) -> Book:\\n    \"\"\"Parse a single <div class=\\'book\\'> element into a Book.\"\"\"\\n    title = _required_text(book_element, \".book-title\")\\n    author = clean_author(_required_text(book_element, \".book-author\"))\\n    year = _first_number(_required_text(book_element, \".book-year\"))\\n    rating = _first_number(_required_text(book_element, \".book-rating\"), as_float="]
[71.751383, "o", "True)\\n    price = _first_number(_required_text(book_element, \".book-price\"), as_float=True)\\n    return Book(title=title, author=author, year=year, rating=rating, price=price)\\n\\n\\ndef parse_books(html: str) -> list[Book]:\\n    \"\"\"Parse all books from the bookstore HTML.\"\"\"\\n    soup = BeautifulSoup(html, \"html.parser\")\\n    return [parse_book(book_div) for book_div in soup.select(\"div.book\")]\\n\\n\\ndef fetch_html(url: str = URL, timeout: int = 10) -> str:\\n    \"\"\"Fetch bookstore HTML and raise for HTTP/network failures.\"\"\"\\n    response = requests.get(url, timeout=timeout)\\n    response.raise_for_status()\\n    return response.text\\n\\n\\ndef books_to_dataframe(books: Iterable[Book]) -> pd.DataFrame:\\n    \"\"\"Convert parsed books to a DataFrame with the required CSV columns.\"\"\"\\n    rows = [book.__dict__ for book in books]\\n    return pd.DataFrame(rows, columns=CSV_COLUMNS)\\n\\n\\ndef write_books_csv(books: Iterable[Book], csv_path: Path = CSV_PATH) -> pd.DataFrame:\\n    \"\"\"Write books to CSV and return the DataFr"]
[71.751457, "o", "ame that was written.\"\"\"\\n    df = books_to_dataframe(books)\\n    csv_path.parent.mkdir(parents=True, exist_ok=True)\\n    df.to_csv(csv_path, index=False)\\n    return df\\n\\n\\ndef highest_rated_book(df: pd.DataFrame) -> Optional[pd.Series]:\\n    \"\"\"Return the row for the highest rated book, or None when empty.\"\"\"\\n    if df.empty:\\n        return None\\n    return df.loc[df[\"rating\"].idxmax()]\\n\\n\\ndef build_report(df: pd.DataFrame) -> str:\\n    \"\"\"Build the requested summary report text.\"\"\"\\n    total_books = len(df)\\n    average_price = 0.0 if df.empty else float(df[\"price\"].mean())\\n    highest = highest_rated_book(df)\\n\\n    lines = [\\n        f\"Total number of books scraped: {total_books}\",\\n        f\"Average book price: ${average_price:.2f}\",\\n    ]\\n\\n    if highest is None:\\n        lines.append(\"Highest rated book: N/A\")\\n    else:\\n        lines.append(\\n            \"Highest rated book: \"\\n            f\"{highest[\\'title\\']} by {highest[\\'author\\']} \"\\n            f\"(Rating: {float(highest[\\'rating\\'])"]
[71.751572, "o", ":.1f}/5)\"\\n        )\\n\\n    return \"\\\\n\".join(lines) + \"\\\\n\"\\n\\n\\ndef write_report(df: pd.DataFrame, report_path: Path = REPORT_PATH) -> str:\\n    \"\"\"Write the summary report and return its content.\"\"\"\\n    report = build_report(df)\\n    report_path.parent.mkdir(parents=True, exist_ok=True)\\n    report_path.write_text(report, encoding=\"utf-8\")\\n    return report\\n\\n\\ndef scrape(url: str = URL, csv_path: Path = CSV_PATH, report_path: Path = REPORT_PATH) -> pd.DataFrame:\\n    \"\"\"Fetch, parse, save CSV, and save report.\"\"\"\\n    html = fetch_html(url)\\n    books = parse_books(html)\\n    df = write_books_csv(books, csv_path)\\n    write_report(df, report_path)\\n    return df\\n\\n\\ndef main() -> None:\\n    df = scrape()\\n    print(f\"Scraped {len(df)} books\")\\n    print(f\"Wrote {CSV_PATH}\")\\n    print(f\"Wrote {REPORT_PATH}\")\\n\\n\\nif __name__ == \"__main__\":\\n    main()\\n'\r\n\u001b[?2004l\r\u001b[?2004h> dir_path = os.path.dirname(path)\r\n\u001b[?2004l\r\u001b[?2004h> if dir_path:\r\n\u001b[?2004l\r\u001b[?2004h> "]
