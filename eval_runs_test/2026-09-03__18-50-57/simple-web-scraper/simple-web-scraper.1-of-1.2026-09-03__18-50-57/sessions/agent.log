[?2004lfrom pathlib import Path
from unittest.mock import Mock, patch

import pandas as pd

import scrape_books
from scrape_books import Book


SAMPLE_HTML = """
<html>
  <body>
    <div class="book">
      <div class="book-title">The First Book</div>
      <div class="book-author">by Alice Writer</div>
      <div class="book-details">
        <span class="book-year">Published: 1999</span>
        <span class="book-rating">Rating: 4.7/5</span>
        <span class="book-price">$12.50</span>
      </div>
    </div>
    <div class="book">
      <div class="book-title">Second Story</div>
      <div class="book-author">by Bob Author</div>
      <div class="book-details">
        <span class="book-year">Published: 2005</span>
        <span class="book-rating">Rating: 4.9/5</span>
        <span class="book-price">$20.00</span>
      </div>
    </div>
  </body>
</html>
"""


def test_parse_books_extracts_required_fields():
    books = scrape_books.parse_books(SAMPLE_HTML)

    assert books == [
        Book("The First Book", "Alice Writer", 1999, 4.7, 12.50),
        Book("Second Story", "Bob Author", 2005, 4.9, 20.00),
    ]


def test_write_books_csv_has_required_columns(tmp_path):
    csv_path = tmp_path / "books.csv"
    books = [
        Book("The First Book", "Alice Writer", 1999, 4.7, 12.50),
        Book("Second Story", "Bob Author", 2005, 4.9, 20.00),
    ]

    df = scrape_books.write_books_csv(books, csv_path)
    loaded = pd.read_csv(csv_path)

    assert list(df.columns) == ["title", "author", "year", "rating", "price"]
    assert list(loaded.columns) == ["title", "author", "year", "rating", "price"]
    assert loaded.to_dict("records") == [
        {"title": "The First Book", "author": "Alice Writer", "year": 1999, "rating": 4.7, "price": 12.5},
        {"title": "Second Story", "author": "Bob Author", "year": 2005, "rating": 4.9, "price": 20.0},
    ]


def test_build_report_includes_summary_values():
    df = scrape_books.books_to_dataframe([
        Book("The First Book", "Alice Writer", 1999, 4.7, 12.50),
        Book("Second Story", "Bob Author", 2005, 4.9, 20.00),
    ])

    report = scrape_books.build_report(df)

    assert "Total number of books scraped: 2" in report
    assert "Average book price: $16.25" in report
    assert "Highest rated book: Second Story by Bob Author (Rating: 4.9/5)" in report


def test_scrape_fetches_html_and_writes_outputs(tmp_path):
    csv_path = tmp_path / "books.csv"
    report_path = tmp_path / "report.txt"
    mock_response = Mock()
    mock_response.text = SAMPLE_HTML
    mock_response.raise_for_status = Mock()

    with patch("scrape_books.requests.get", return_value=mock_response) as mock_get:
        df = scrape_books.scrape("http://example.test", csv_path, report_path)

    mock_get.assert_called_once_with("http://example.test", timeout=10)
    assert len(df) == 2
    assert csv_path.exists()
    assert report_path.exists()
    assert pd.read_csv(csv_path).shape == (2, 5)
    assert "Highest rated book: Second Story by Bob Author" in report_path.read_text(encoding="utf-8")
