[96.357274, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - <<'PY'\nN=15\nB={(5,6),(6,6),(6,7),(8,7),(8,8),(9,7)}\nW={(5,5),(7,6),(7,7),(7,8),(9,9),(10,8)}\nboard=[['.' for _ in range(N)] for __ in range(N)]\nfor r,c in B: board[r][c]='B'\nfor r,c in W: board[r][c]='W'\nfor r in range(N): print(f'{r:2d}', ''.join(board[r]))\nDIRS=[(0,1),(1,0),(1,1),(1,-1)]\n\ndef max_run_after(color, move):\n    r,c=move\n    best=0; details=[]\n    stones=B if color=='B' else W\n    occ=stones|{move}\n    for dr,dc in DIRS:\n        cnt=1\n        rr,cc=r+dr,c+dc\n        while (rr,cc) in occ:\n            cnt+=1; rr+=dr; cc+=dc\n        rr,cc=r-dr,c-dc\n        while (rr,cc) in occ:\n            cnt+=1; rr-=dr; cc-=dc\n        details.append(((dr,dc),cnt))\n        best=max(best,cnt)\n    return best, details\n\nempties=[(r,c) for r in range(N) for c in range(N) if board[r][c]=='.']\nprint('\\nImmediate winning moves:')\nfor color in 'BW':\n    wins=[]\n    for m in empties:\n        if max_run_after(color,m)[0]>=5:\n            wins.append((m,max_run_after(color,m)[1]))\n    print(color, wins)\n\n# windows with 4 or 3 white and rest empty, no black\nprint('\\nWhite windows with 4/3 and empty completions:')\nfor k in [4,3]:\n    print('k=',k)\n    seen=set()\n    for r in range(N):\n      for c in range(N):\n       for dr,dc in DIRS:\n        cells=[(r+i*dr,c+i*dc) for i in range(5)]\n        if all(0<=rr<N and 0<=cc<N for rr,cc in cells):\n          vals=[board[rr][cc] for rr,cc in cells]\n          if vals.count('W')==k and vals.count('B')==0:\n            empt=[cells[i] for i,v in enumerate(vals) if v=='.']\n            key=tuple(cells)\n            if key not in seen:\n              seen.add(key); print(cells, vals, 'empties', empt)\n\n# rank empty moves by making black runs and blocking white runs\nprint('\\nTop candidate moves')\nfor m in [(7,5),(7,9),(6,5),(8,9),(9,8),(10,10)]:\n    print(m, 'B after', max_run_after('B',m), 'W after', max_run_after('W',m))\nPY\ntrue; tmux wait -S done\r"]
