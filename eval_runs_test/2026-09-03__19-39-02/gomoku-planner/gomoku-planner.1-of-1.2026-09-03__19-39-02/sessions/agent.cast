[63.380299, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - <<'PY'\nfrom PIL import Image\nimg=Image.open('/app/gomoku_board.png').convert('RGB')\nw,h=img.size\npix=img.load()\nrow=[]; col=[]\nfor y in range(h):\n    c=0\n    for x in range(w):\n        r,g,b=pix[x,y]\n        if (r+g+b)/3 < 100:\n            c+=1\n    row.append(c)\nfor x in range(w):\n    c=0\n    for y in range(h):\n        r,g,b=pix[x,y]\n        if (r+g+b)/3 < 100:\n            c+=1\n    col.append(c)\nfor name,arr in [('rows',row),('cols',col)]:\n    peaks=[]; in_peak=False; start=0\n    for i,v in enumerate(arr):\n        if v>50 and not in_peak:\n            start=i; in_peak=True\n        if in_peak and (v<=50 or i==len(arr)-1):\n            end=i-1 if v<=50 else i\n            peaks.append((start,end,max(arr[start:end+1]),sum(arr[start:end+1])//(end-start+1)))\n            in_peak=False\n    print(name, peaks, 'n=',len(peaks))\n    # top 30 lines\n    tops=sorted([(v,i) for i,v in enumerate(arr)], reverse=True)[:30]\n    print('top', name, tops)\nPY\ntrue; tmux wait -S done\r"]
