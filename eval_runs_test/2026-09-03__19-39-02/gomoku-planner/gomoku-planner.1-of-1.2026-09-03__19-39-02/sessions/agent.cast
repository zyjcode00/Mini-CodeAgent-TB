[72.876512, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - <<'PY'\nfrom PIL import Image\nimg=Image.open('/app/gomoku_board.png').convert('RGB')\npix=img.load()\ncenters=[20+40*i for i in range(15)]\nfor r,y in enumerate(centers):\n    row=[]\n    for c,x in enumerate(centers):\n        dark=white=total=0; lum_sum=0\n        for yy in range(y-14,y+15):\n            for xx in range(x-14,x+15):\n                if 0<=xx<img.width and 0<=yy<img.height:\n                    dx=xx-x; dy=yy-y\n                    if dx*dx+dy*dy<=14*14:\n                        R,G,B=pix[xx,yy]; lum=(R+G+B)/3\n                        lum_sum+=lum; total+=1\n                        if lum<80: dark+=1\n                        if lum>200: white+=1\n        avg=lum_sum/total\n        # print all features if significant\n        if dark>80 or white>150 or avg<160 or avg>200:\n            row.append(f'{r},{c}:d{dark} w{white} a{avg:.0f}')\n    if row:\n        print(' | '.join(row))\nPY\ntrue; tmux wait -S done\r"]
