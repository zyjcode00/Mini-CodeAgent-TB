[46.776337, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - <<'PY'\nfrom PIL import Image\nimport numpy as np\nimg=np.array(Image.open('/app/gomoku_board.png').convert('RGB'))\n# threshold dark pixels (grid+stones) but stones large\nlum=img.mean(axis=2)\nmask=lum<100\n# count dark per row/col\nrow=mask.sum(axis=1); col=mask.sum(axis=0)\n# print peaks rows/cols with count > 50 maybe grid/stones\nfor name,arr in [('rows',row),('cols',col)]:\n    peaks=[]\n    in_peak=False; start=0\n    for i,v in enumerate(arr):\n        if v>50 and not in_peak:\n            start=i; in_peak=True\n        if in_peak and (v<=50 or i==len(arr)-1):\n            end=i-1 if v<=50 else i\n            peaks.append((start,end,int(arr[start:end+1].max()), int(arr[start:end+1].mean())))\n            in_peak=False\n    print(name, peaks[:100], 'n=',len(peaks))\nPY\ntrue; tmux wait -S done\r"]
