[128.75619, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - <<'PY'\nimport re\npath='/app/move.txt'\ns=open(path, encoding='utf-8').read()\nprint(repr(s))\nif not re.fullmatch(r'(?:[0-9]|1[0-4]),(?:[0-9]|1[0-4])\\n?', s):\n    raise SystemExit('Invalid format')\nr,c=map(int,s.strip().split(','))\noccupied={(5,6),(6,6),(6,7),(8,7),(8,8),(9,7),(5,5),(7,6),(7,7),(7,8),(9,9),(10,8)}\nif (r,c) in occupied:\n    raise SystemExit('Move is already occupied')\n# White has horizontal W at row 7 col 6-8; (7,9) blocks one open end and creates black diagonal continuation.\nassert (r,c)==(7,9)\nprint('OK: format valid, in range, unoccupied, and matches chosen blocking move')\nPY\ntrue; tmux wait -S done\r"]
