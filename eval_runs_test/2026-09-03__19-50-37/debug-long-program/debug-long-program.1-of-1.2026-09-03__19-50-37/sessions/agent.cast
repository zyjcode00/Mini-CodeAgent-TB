[60.537184, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - <<'PY'\nimport json, urllib.request\nURL='http://program:8008/checkpoint'\n\ndef checkpoint(line):\n    data=json.dumps({'line':line}).encode()\n    req=urllib.request.Request(URL,data=data,headers={'Content-Type':'application/json'},method='POST')\n    with urllib.request.urlopen(req, timeout=10) as r:\n        return json.loads(r.read().decode())\n\ndef in_range(resp):\n    return 'out of range' not in resp.get('message','').lower()\n\nlo, hi = 1, 1\ncalls=0\nwhile True:\n    resp=checkpoint(hi); calls+=1\n    print('probe', hi, resp)\n    if in_range(resp):\n        lo=hi\n        hi*=2\n        if hi>1000000:\n            hi=1000001\n    else:\n        break\n    if hi==1000001:\n        resp=checkpoint(hi); calls+=1\n        print('probe', hi, resp)\n        break\n# total N in [lo, hi-1] if hi out of range. If 1000001 out of range, max 1e6.\nlow=lo; high=hi-1\nwhile low<high:\n    mid=(low+high+1)//2\n    resp=checkpoint(mid); calls+=1\n    print('bin', mid, resp)\n    if in_"]
[60.537587, "i", "range(resp):\n        low=mid\n    else:\n        high=mid-1\nprint('TOTAL', low, 'checkpoint_calls_this_script', calls)\nPY\ntrue; tmux wait -S done\r"]
