[121.006606, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - <<'PY'\nimport json, urllib.request, urllib.error, sys, time\nBASE='http://program:8008'\nN=4325\nck=0\nfx=0\n\ndef post(path, payload):\n    data=json.dumps(payload).encode()\n    req=urllib.request.Request(BASE+path,data=data,headers={'Content-Type':'application/json'},method='POST')\n    with urllib.request.urlopen(req, timeout=10) as r:\n        return json.loads(r.read().decode())\n\ndef checkpoint(line):\n    global ck\n    ck += 1\n    resp=post('/checkpoint', {'line': line})\n    print(f'CHECK {ck}: line {line}: {resp}', flush=True)\n    return resp\n\ndef fix(line):\n    global fx\n    fx += 1\n    resp=post('/fix', {'line': line})\n    print(f'FIX {fx}: line {line}: {resp}', flush=True)\n    return resp\n\ndef is_success(resp):\n    return resp.get('status') == 'success' and 'as expected' in resp.get('message','').lower()\n\ndef is_oor(resp):\n    return 'out of range' in resp.get('message','').lower()\n\nlow = 0  # logical clean prefix length; do not checkpoint 0\nfixed"]
[121.00678, "i", "=[]\n# Establish a known clean low as high as possible cheaply? binary search below handles low=0.\nwhile True:\n    full=checkpoint(N)\n    if is_success(full):\n        print('DONE all clean. fixed_lines=', fixed, 'checkpoint_calls=', ck, 'fix_calls=', fx)\n        break\n    if is_oor(full):\n        raise RuntimeError('Known total line count unexpectedly out of range')\n    if fx >= 50:\n        raise RuntimeError('Fix API limit would be exceeded')\n    # Find minimal failing line in (low, N], assuming checkpoint(low) is clean.\n    hi=N\n    # If low not zero, verify/advance invariant at low after last fix only when needed.\n    # Full failed, so some bug exists > low if low is clean.\n    while low + 1 < hi:\n        mid=(low+hi)//2\n        resp=checkpoint(mid)\n        if is_oor(resp):\n            raise RuntimeError(f'Unexpected out of range at {mid}')\n        if is_success(resp):\n            low=mid\n        else:\n            hi=mid\n    bug=hi\n    fix(bug)\n    fixed.append(bug)\n    # After fixing earliest bug, lines <="]
[121.006913, "i", " bug should now be clean; use logical invariant.\n    low=bug\nPY\ntrue; tmux wait -S done\r"]
