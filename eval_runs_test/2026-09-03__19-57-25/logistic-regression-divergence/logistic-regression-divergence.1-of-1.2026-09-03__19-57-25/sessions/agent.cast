[147.991988, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /tmp/test_logreg_convergence.py <<'PY'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = 'import os\\nimport sys\\nimport numpy as np\\n\\nsys.path.insert(0, \"/app\")\\nos.chdir(\"/app\")\\n\\nfrom logreg import LogisticRegression\\n\\n\\ndef main():\\n    model = LogisticRegression()\\n    assert model.get_conv() == 1e-15, \"convergence criterion must not be changed\"\\n    assert model.get_limit() == 100000, \"iteration limit must not be changed\"\\n\\n    X, Y = model.load_csv(\"dataset.csv\")\\n    theta = model.logistic_regression(X, Y)\\n\\n    assert np.all(np.isfinite(theta)), f\"theta contains non-finite values: {theta}\"\\n    assert model.get_iters() <= model.get_limit(), (\\n        f\"training exceeded iteration limit: {model.get_iters()} > {model.get_limit()}\"\\n    )\\n    assert model.get_diff() < model.get_conv(), (\\n        f\"model did not meet convergence criterion: diff={model.get_diff()} criterion={model.get_conv()}\"\\n    )\\n    assert np.linalg.norm(theta) < "]
[147.992327, "i", "10.0, f\"theta still appears divergent: {theta}\"\\n\\n    accuracy = model.accuracy(Y, model.predict(X))\\n    assert accuracy >= 0.95, f\"accuracy regressed unexpectedly: {accuracy}\"\\n\\n    print(\"PASS\")\\n    print(f\"iters={model.get_iters()} diff={model.get_diff()} theta_norm={np.linalg.norm(theta)} accuracy={accuracy}\")\\n\\n\\nif __name__ == \"__main__\":\\n    main()\\n'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, 'w', encoding='utf-8', newline='\\n') as f:\n        f.write(content)\n    print(f\"成功: 已写入 {path}\")\nexcept Exception as exc:\n    print(f\"写入失败: {exc}\")\nPY\ntrue; tmux wait -S done\r"]
