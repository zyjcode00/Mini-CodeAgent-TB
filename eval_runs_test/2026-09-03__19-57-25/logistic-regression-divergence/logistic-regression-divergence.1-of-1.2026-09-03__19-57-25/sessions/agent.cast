[101.239013, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - logreg.py <<'PY'\nimport sys\npath = sys.argv[1]\nold_str = '    def calc_grad(self, X, Y, theta):\\n        \"\"\"Compute the gradient of the loss with respect to theta.\"\"\"\\n\\n        count, m = X.shape\\n\\n        probs = 1.0 / (1 + np.exp(-X.dot(theta)))\\n        grad = X.T.dot(Y - probs)\\n\\n        return grad\\n'\nnew_str = '    def calc_grad(self, X, Y, theta):\\n        \"\"\"Compute the gradient of the regularized log-likelihood.\\n\\n        The original implementation used the un-averaged likelihood gradient.\\n        On linearly separable data, the unregularized logistic-regression\\n        maximum-likelihood solution is at infinity, so the parameters keep\\n        growing and the parameter update never reaches the very small existing\\n        convergence threshold.  Averaging the gradient makes the fixed learning\\n        rate independent of dataset size, and a small L2 penalty gives the\\n        objective a finite optimum without changing the converg"]
[101.239608, "i", "ence criterion or\\n        the maximum number of training iterations.\\n        \"\"\"\\n\\n        count, m = X.shape\\n\\n        logits = X.dot(theta)\\n        probs = np.empty_like(logits, dtype=float)\\n        positive = logits >= 0\\n        probs[positive] = 1.0 / (1.0 + np.exp(-logits[positive]))\\n        exp_logits = np.exp(logits[~positive])\\n        probs[~positive] = exp_logits / (1.0 + exp_logits)\\n\\n        grad = X.T.dot(Y - probs) / count\\n\\n        # L2 regularization prevents the weights from diverging on separable\\n        # data.  If the first column is an added intercept column of ones, do\\n        # not regularize it; otherwise regularize all model coefficients.\\n        l2_strength = 0.1\\n        penalty = theta.copy()\\n        if X.shape[1] > 0 and np.all(X[:, 0] == 1):\\n            penalty[0] = 0.0\\n        grad -= l2_strength * penalty\\n\\n        return grad\\n'\n\ndef normalize_text(text: str) -> str:\n    text = text.replace('\\r\\n', '\\n').replace('\\r', '\\n')\n    return '\\n'.join(line.rstrip() f"]
[101.239907, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
[101.240038, "i", "or line in text.split('\\n'))\n\ntry:\n    with open(path, 'r', encoding='utf-8', errors='replace') as f:\n        content = f.read()\nexcept FileNotFoundError:\n    print(f\"错误: 找不到文件 {path}\")\n    raise SystemExit(0)\nexcept Exception as exc:\n    print(f\"修改失败: {exc}\")\n    raise SystemExit(0)\n\ncontent = normalize_text(content)\nold_str = normalize_text(old_str)\nnew_str = normalize_text(new_str)\ncount = content.count(old_str)\nif count == 0:\n    print(\"错误: 在文件中找不到 old_str。\\n建议：\\n1. 使用 read_file(raw_mode=True) 获取原始内容\\n2. 检查是否有多余的空格或换行符\\n3. 如果文件较大，考虑使用 write_full_file 全量覆盖\")\n    raise SystemExit(0)\nif count > 1:\n    print(f\"错误: 匹配到 {count} 处相同的代码，请提供更具体的 old_str 以确保唯一性。\")\n    raise SystemExit(0)\nwith open(path, 'w', encoding='utf-8', newline='\\n') as f:\n    f.write(content.replace(old_str, new_str))\nprint(f\"成功: 已更新 {path}。修改已持久化"]
