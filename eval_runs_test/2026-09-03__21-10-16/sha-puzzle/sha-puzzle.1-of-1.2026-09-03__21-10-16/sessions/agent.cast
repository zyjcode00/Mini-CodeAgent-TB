[42.301048, "i", "yare','yugen'],\n'z':['zesty','zero','zonal','zealous','zenithal','zippy','zany','zestful','zigzag','zymotic'],\n}\n\ndef letter_count(s):\n    h=hashlib.sha1(s.encode()).hexdigest()\n    return sum(c in 'abcdef' for c in h), h\n\n# Try deterministic/random combinations. Use optional punctuation/capitalization? keep simple lowercase words.\nrandom.seed()\ntries=0\nfor _ in range(2000000):\n    # focus on plausible SHA counts near mean, but any target works\n    n=random.choice(list(range(6,27)))\n    ac=nums[n]\n    words=[]\n    for ch in ac:\n        base=random.choice(bank[ch])\n        # occasionally add harmless suffix preserving initial (creates many variations, word still one token)\n        if random.random()<0.35:\n            base = base + random.choice(['ness','ly','ful','wise','like','ward','s'])\n        words.append(base)\n    s=' '.join(words)\n    c,h=letter_count(s)\n    tries+=1\n    if c==n:\n        print('FOUND', tries, n, nums[n])\n        print(s)\n        print(h, c)\n        open('/app/solution.txt','w').write(s)"]
