def letter_count(s):
    h=hashlib.sha1(s.encode()).hexdigest()
    return sum(c in 'abcdef' for c in h), h

# Try deterministic/random combinations. Use optional punctuation/capitalization? keep simple lowercase words.
random.seed()
tries=0
for _ in range(2000000):
    # focus on plausible SHA counts near mean, but any target works
    n=random.choice(list(range(6,27)))
    ac=nums[n]
    words=[]
    for ch in ac:
        base=random.choice(bank[ch])
        # occasionally add harmless suffix preserving initial (creates many variations, word still one token)
        if random.random()<0.35:
            base = base + random.choice(['ness','ly','ful','wise','like','ward','s'])
        words.append(base)
    s=' '.join(words)
    c,h=letter_count(s)
    tries+=1
    if c==n:
        print('FOUND', tries, n, nums[n])
        print(s)
        print(h, c)
        open('/app/solution.txt','w').write(s)
        raise SystemExit
print('not found', tries)
PY
