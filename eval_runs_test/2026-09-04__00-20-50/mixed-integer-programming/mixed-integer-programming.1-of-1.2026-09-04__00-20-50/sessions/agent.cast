[37.526571, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython - <<'PY'\nfrom collections import Counter\np='/app/question.mps'\nsec=None\ncnt=Counter(); lines=0\nmarkers=0\nwith open(p) as f:\n    for line in f:\n        lines+=1\n        s=line.strip()\n        if not s or s.startswith('*'): continue\n        key=s.split()[0]\n        if key in ['NAME','ROWS','COLUMNS','RHS','RANGES','BOUNDS','ENDATA']:\n            sec=key; cnt[sec]+=1\n        else:\n            cnt[sec]+=1\n            if 'MARKER' in line: markers+=1\nprint('lines',lines,'counts',cnt,'markers',markers)\n# collect row types, vars, bounds types\nrows={}; vars=set(); bound_types=Counter(); intvars=set(); inint=False\nwith open(p) as f:\n    sec=None\n    for line in f:\n        s=line.strip()\n        if not s or s.startswith('*'): continue\n        tok=s.split()\n        if tok[0] in ['NAME','ROWS','COLUMNS','RHS','RANGES','BOUNDS','ENDATA']:\n            sec=tok[0]; continue\n        if sec=='ROWS': rows[tok[1]]=tok[0]\n        elif sec=='COLUMNS':\n            if len(to"]
[37.526942, "i", "k)>=3 and tok[1]=='MARKER':\n                if 'INTORG' in line: inint=True\n                if 'INTEND' in line: inint=False\n                continue\n            v=tok[0]; vars.add(v)\n            if inint: intvars.add(v)\n        elif sec=='BOUNDS':\n            bound_types[tok[0]]+=1\n            if tok[0] in ('BV','LI','UI') and len(tok)>=3: intvars.add(tok[2])\nprint('rows',len(rows),Counter(rows.values()))\nprint('vars',len(vars),'intvars',len(intvars),'bound_types',bound_types)\n# tail bounds\nimport itertools\nprint('\\nBOUNDS excerpt')\ninb=False; n=0\nfor line in open(p):\n    if line.startswith('BOUNDS'): inb=True; print(line,end=''); continue\n    if inb:\n        print(line,end=''); n+=1\n        if n>40: break\nPY\ntrue; tmux wait -S done\r"]
