[115.036366, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython - <<'PY'\nfrom highspy import Highs\nh=Highs()\nh.setOptionValue('output_flag', True)\nh.setOptionValue('time_limit', 300.0)\nstatus=h.readModel('/app/question.mps')\nprint('read status', status)\nh.run()\nprint('model status', h.getModelStatus(), h.modelStatusToString(h.getModelStatus()))\ninfo=h.getInfo()\nprint('objective', info.objective_function_value)\nsol=h.getSolution()\nprint('num col', len(sol.col_value), 'sum', sum(sol.col_value))\nprint('values', sol.col_value[:70])\nPY\ntrue; tmux wait -S done\r"]
