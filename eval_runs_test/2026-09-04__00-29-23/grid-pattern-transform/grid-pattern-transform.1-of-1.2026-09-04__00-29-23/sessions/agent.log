[?2004l[?2004h> content = '"""Grid transformation solver.\n\nThis module exposes ``solve`` for transforming a 2x2 input grid into a 6x6\noutput grid following the demonstrated repeating / mirrored pattern.\n"""\n\nfrom typing import List\n\n\ndef solve(input_grid: List[List[int]]) -> List[List[int]]:\n    """\n    Transform a 2x2 grid into a 6x6 grid.\n\n    The output is made from three 2-row bands.  The first and third bands are\n    the original 2x2 input repeated three times horizontally.  The middle band\n    is the horizontally mirrored input repeated three times horizontally.\n\n    Args:\n        input_grid: 2D list of integers representing the input grid.\n\n    Returns:\n        A transformed 6x6 grid as a list of lists.\n    """\n    if not input_grid or not input_grid[0]:\n        return []\n\n    original_band = [row * 3 for row in input_grid]\n    mirrored_band = [list(reversed(row)) * 3 for row in input_grid]\n\n    return original_band + mirrored_band + original_band\n'
