[163.314888, "o", "\u001b[?2004h> "]
[163.315122, "o", "print('user_ids=', df['user_id'].astype(int).tolist())\r\n\u001b[?2004l\r\u001b[?2004h"]
[163.315268, "o", "> "]
[163.315444, "o", "print('dtypes=', {k: str(v) for k, v in df.dtypes.items()})\r\n\u001b[?2004l\r\u001b[?2004h"]
[163.315513, "o", "> "]
[163.315675, "o", "with conflicts.open(encoding='utf-8') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[163.315715, "o", "> "]
[163.315864, "o", "    report = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h> "]
