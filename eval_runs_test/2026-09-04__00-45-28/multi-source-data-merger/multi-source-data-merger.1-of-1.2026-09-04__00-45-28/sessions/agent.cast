[79.40337, "o", "return records\r\n\r\n\r\ndef select_by_priority(user_sources: dict[str, dict[str, Any]], field: str) -> Any:\r\n    \"\"\"Select the first non-null field value according to source priority.\"\"\"\r\n    for config in SOURCE_CONFIG:\r\n        source_name = config[\"name\"]\r\n        if source_name in user_sources and field in user_sources[source_name]:\r\n            return user_sources[source_name][field]\r\n    return None\r\n\r\n\r\ndef detect_conflicts(records: dict[int, dict[str, dict[str, Any]]]) -> list[dict[str, Any]]:\r\n    \"\"\"Detect fields whose non-null values differ across sources for the same user.\"\"\"\r\n    conflicts: list[dict[str, Any]] = []\r\n    for user_id in sorted(records):\r\n        user_sources = records[user_id]\r\n        if len(user_sources) < 2:\r\n            continue\r\n        for field in [\"name\", \"email\", \"created_date\", \"status\"]:\r\n            values = {\r\n                source_name: source_values[field]\r\n                for source_name, source_values in user_sources.items()\r\n                if field in source_values"]
[79.403477, "o", " and source_values[field] is not None\r\n            }\r\n            distinct_values = {str(value) for value in values.values()}\r\n            if len(distinct_values) > 1:\r\n                conflicts.append(\r\n                    {\r\n                        \"user_id\": user_id,\r\n                        \"field\": field,\r\n                        \"values\": values,\r\n                        \"selected\": select_by_priority(user_sources, field),\r\n                    }\r\n                )\r\n    return conflicts\r\n\r\n\r\ndef merge_users() -> tuple[pd.DataFrame, dict[str, Any]]:\r\n    \"\"\"Merge all sources and write Parquet and conflict report outputs.\"\"\"\r\n    source_frames = [read_source(config) for config in SOURCE_CONFIG]\r\n    records = build_source_records(source_frames)\r\n\r\n    merged_rows: list[dict[str, Any]] = []\r\n    for user_id in sorted(records):\r\n        user_sources = records[user_id]\r\n        row = {field: select_by_priority(user_sources, field) for field in OUTPUT_COLUMNS}\r\n        row[\"user_id\"] = int(user_id)\r\n        me"]
[79.403625, "o", "rged_rows.append(row)\r\n\r\n    merged_df = pd.DataFrame(merged_rows, columns=OUTPUT_COLUMNS)\r\n    merged_df[\"user_id\"] = merged_df[\"user_id\"].astype(\"int64\")\r\n    for col in [\"name\", \"email\", \"created_date\", \"status\"]:\r\n        merged_df[col] = merged_df[col].astype(\"string\")\r\n\r\n    conflicts = detect_conflicts(records)\r\n    conflict_report = {\r\n        \"total_conflicts\": len(conflicts),\r\n        \"conflicts\": conflicts,\r\n    }\r\n\r\n    MERGED_OUTPUT.parent.mkdir(parents=True, exist_ok=True)\r\n    merged_df.to_parquet(MERGED_OUTPUT, index=False)\r\n    with CONFLICT_OUTPUT.open(\"w\", encoding=\"utf-8\") as f:\r\n        json.dump(conflict_report, f, indent=2, ensure_ascii=False)\r\n        f.write(\"\\n\")\r\n\r\n    return merged_df, conflict_report\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    df, report = merge_users()\r\n    print(f\"Wrote {MERGED_OUTPUT} with {len(df)} rows\")\r\n    print(f\"Wrote {CONFLICT_OUTPUT} with {report['total_conflicts']} conflicts\")\r\n\u001b[?2004hroot@929fb9fdf275:/app# true; tmux wait -S done\r\n\u001b[?2004l\r"]
