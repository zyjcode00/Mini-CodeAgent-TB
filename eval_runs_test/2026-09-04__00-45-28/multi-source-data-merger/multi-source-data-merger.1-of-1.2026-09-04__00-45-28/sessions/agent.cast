[120.219652, "o", "import json\r\nimport re\r\nfrom pathlib import Path\r\n\r\nimport pandas as pd\r\n\r\nfrom merge_users import CONFLICT_OUTPUT, MERGED_OUTPUT, merge_users, read_source, SOURCE_CONFIG\r\n\r\n\r\ndef setup_module(module):\r\n    # Regenerate outputs so tests validate the current implementation and files.\r\n    merge_users()\r\n\r\n\r\ndef test_output_files_exist_and_have_expected_schema():\r\n    assert MERGED_OUTPUT.exists(), f\"Missing {MERGED_OUTPUT}\"\r\n    assert CONFLICT_OUTPUT.exists(), f\"Missing {CONFLICT_OUTPUT}\"\r\n\r\n    df = pd.read_parquet(MERGED_OUTPUT)\r\n    assert list(df.columns) == [\"user_id\", \"name\", \"email\", \"created_date\", \"status\"]\r\n    assert pd.api.types.is_integer_dtype(df[\"user_id\"]), df.dtypes\r\n\r\n\r\ndef test_all_unique_users_are_included_once():\r\n    source_ids = set()\r\n    for config in SOURCE_CONFIG:\r\n        normalized = read_source(config)\r\n        source_ids.update(normalized[\"user_id\"].astype(int).tolist())\r\n\r\n    df = pd.read_parquet(MERGED_OUTPUT)\r\n    output_ids = df[\"user_id\"].astype(int).tolist()\r\n\r\n    assert"]
[120.21992, "o", " set(output_ids) == source_ids\r\n    assert len(output_ids) == len(set(output_ids))\r\n    assert len(output_ids) == 4\r\n\r\n\r\ndef test_field_mappings_and_priority_resolution():\r\n    df = pd.read_parquet(MERGED_OUTPUT).set_index(\"user_id\")\r\n\r\n    # user 101 appears in all sources. All selected values should come from source_a.\r\n    assert df.loc[101, \"name\"] == \"John Doe\"\r\n    assert df.loc[101, \"email\"] == \"john@a.com\"\r\n    assert df.loc[101, \"created_date\"] == \"2024-01-15\"\r\n    assert df.loc[101, \"status\"] == \"active\"\r\n\r\n    # source_b-only user validates user_id/name/email_address/created_at mapping.\r\n    assert df.loc[103, \"name\"] == \"Bob Wilson\"\r\n    assert df.loc[103, \"email\"] == \"bob@b.com\"\r\n    assert df.loc[103, \"created_date\"] == \"2024-03-01\"\r\n\r\n    # source_c-only user validates userId/userName/email/joined mapping.\r\n    assert df.loc[104, \"name\"] == \"Alice Brown\"\r\n    assert df.loc[104, \"email\"] == \"alice@c.com\"\r\n    assert df.loc[104, \"created_date\"] == \"2024-04-01\"\r\n\r\n\r\ndef test_created_date_format_is"]
[120.220081, "o", "_yyyy_mm_dd():\r\n    df = pd.read_parquet(MERGED_OUTPUT)\r\n    pattern = re.compile(r\"^\\d{4}-\\d{2}-\\d{2}$\")\r\n    assert df[\"created_date\"].notna().all()\r\n    assert df[\"created_date\"].map(lambda value: bool(pattern.match(str(value)))).all()\r\n\r\n\r\ndef test_conflict_report_structure_count_and_selected_values():\r\n    with open(CONFLICT_OUTPUT, encoding=\"utf-8\") as f:\r\n        report = json.load(f)\r\n\r\n    assert set(report) == {\"total_conflicts\", \"conflicts\"}\r\n    assert report[\"total_conflicts\"] == len(report[\"conflicts\"])\r\n    assert report[\"total_conflicts\"] == 3\r\n\r\n    conflicts_by_field = {(item[\"user_id\"], item[\"field\"]): item for item in report[\"conflicts\"]}\r\n    assert set(conflicts_by_field) == {\r\n        (101, \"name\"),\r\n        (101, \"email\"),\r\n        (101, \"created_date\"),\r\n    }\r\n\r\n    assert conflicts_by_field[(101, \"name\")] == {\r\n        \"user_id\": 101,\r\n        \"field\": \"name\",\r\n        \"values\": {\r\n            \"source_a\": \"John Doe\",\r\n            \"source_b\": \"John Doe\",\r\n            \"source_c\": \"Joh"]
[120.220192, "o", "n D.\",\r\n        },\r\n        \"selected\": \"John Doe\",\r\n    }\r\n    assert conflicts_by_field[(101, \"email\")][\"selected\"] == \"john@a.com\"\r\n    assert conflicts_by_field[(101, \"created_date\")][\"selected\"] == \"2024-01-15\"\r\n\r\n\r\ndef test_conflict_report_values_are_actual_differing_source_values():\r\n    with open(CONFLICT_OUTPUT, encoding=\"utf-8\") as f:\r\n        report = json.load(f)\r\n\r\n    for conflict in report[\"conflicts\"]:\r\n        values = conflict[\"values\"]\r\n        assert len(values) >= 2\r\n        assert len({str(value) for value in values.values()}) > 1\r\n        # The selected value must be present in the highest-priority available source.\r\n        for source_name in [\"source_a\", \"source_b\", \"source_c\"]:\r\n            if source_name in values:\r\n                assert conflict[\"selected\"] == values[source_name]\r\n                break\r\n\u001b[?2004h"]
