[71.241261, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/merge_users.py <<'PY'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = '#!/usr/bin/env python3\\n\"\"\"Merge user data from JSON, CSV, and Parquet sources.\\n\\nOutputs:\\n- /app/merged_users.parquet\\n- /app/conflicts.json\\n\"\"\"\\n\\nfrom __future__ import annotations\\n\\nimport json\\nfrom pathlib import Path\\nfrom typing import Any\\n\\nimport pandas as pd\\n\\nSOURCE_CONFIG = [\\n    {\\n        \"name\": \"source_a\",\\n        \"path\": Path(\"/data/source_a/users.json\"),\\n        \"format\": \"json\",\\n        \"mapping\": {\\n            \"id\": \"user_id\",\\n            \"full_name\": \"name\",\\n            \"email\": \"email\",\\n            \"registration_date\": \"created_date\",\\n            \"status\": \"status\",\\n        },\\n    },\\n    {\\n        \"name\": \"source_b\",\\n        \"path\": Path(\"/data/source_b/users.csv\"),\\n        \"format\": \"csv\",\\n        \"mapping\": {\\n            \"user_id\": \"user_id\",\\n            \"name\": \"name\",\\n            \"email_address\": \"email\",\\n            \""]
[71.241565, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n"]
