Sending keys: ['export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/merge_users.py <<\'PY\'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = \'#!/usr/bin/env python3\\n"""Merge user data from JSON, CSV, and Parquet sources.\\n\\nOutputs:\\n- /app/merged_users.parquet\\n- /app/conflicts.json\\n"""\\n\\nfrom __future__ import annotations\\n\\nimport json\\nfrom pathlib import Path\\nfrom typing import Any\\n\\nimport pandas as pd\\n\\nSOURCE_CONFIG = [\\n    {\\n        "name": "source_a",\\n        "path": Path("/data/source_a/users.json"),\\n        "format": "json",\\n        "mapping": {\\n            "id": "user_id",\\n            "full_name": "name",\\n            "email": "email",\\n            "registration_date": "created_date",\\n            "status": "status",\\n        },\\n    },\\n    {\\n        "name": "source_b",\\n        "path": Path("/data/source_b/users.csv"),\\n        "format": "csv",\\n        "mapping": {\\n            "user_id": "user_id",\\n            "name": "name",\\n            "email_address": "email",\\n            "created_at": "created_date",\\n        },\\n    },\\n    {\\n        "name": "source_c",\\n        "path": Path("/data/source_c/users.parquet"),\\n        "format": "parquet",\\n        "mapping": {\\n            "userId": "user_id",\\n            "userName": "name",\\n            "email": "email",\\n            "joined": "created_date",\\n        },\\n    },\\n]\\n\\nOUTPUT_COLUMNS = ["user_id", "name", "email", "created_date", "status"]\\nMERGED_OUTPUT = Path("/app/merged_users.parquet")\\nCONFLICT_OUTPUT = Path("/app/conflicts.json")\\n\\n\\ndef normalize_scalar(value: Any) -> Any:\\n    """Convert pandas/numpy missing values to None and scalars to Python values."""\\n    if value is None:\\n        return None\\n    try:\\n        if pd.isna(value):\\n            return None\\n    except (TypeError, ValueError):\\n        pass\\n    if hasattr(value, "item"):\\n        try:\\n            return value.item()\\n        except Exception:\\n            pass\\n    return value\\n\\n\\ndef normalize_date(value: Any) -> str | None:\\n    """Normalize date-like values to YYYY-MM-DD strings."""\\n    value = normalize_scalar(value)\\n    if value in (None, ""):\\n        return None\\n    parsed = pd.to_datetime(value, errors="coerce")\\n    if pd.isna(parsed):\\n        return str(value)\\n    return parsed.strftime("%Y-%m-%d")\\n\\n\\ndef read_source(config: dict[str, Any]) -> pd.DataFrame:\\n    """Read one source and rename fields to the unified schema."""\\n    path = config["path"]\\n    if config["format"] == "json":\\n        df = pd.read_json(path)\\n    elif config["format"] == "csv":\\n        df = pd.read_csv(path)\\n    elif config["format"] == "parquet":\\n        df = pd.read_parquet(path)\\n    else:\\n        raise ValueError(f"Unsupported format: {config[\\\'format\\\']}")\\n\\n    df = df.rename(columns=config["mapping"])\\n    keep_cols = [col for col in OUTPUT_COLUMNS if col in df.columns]\\n    df = df[keep_cols].copy()\\n\\n    if "user_id" not in df.columns:\\n        raise ValueError(f"Source {config[\\\'name\\\']} has no user id column after mapping")\\n\\n    df["user_id"] = df["user_id"].map(normalize_scalar).astype("int64")\\n    if "created_date" in df.columns:\\n        df["created_date"] = df["created_date"].map(normalize_date)\\n    for col in ["name", "email", "status"]:\\n        if col in df.columns:\\n            df[col] = df[col].map(lambda x: None if normalize_scalar(x) is None else str(normalize_scalar(x)))\\n\\n    df["_source"] = config["name"]\\n    return df\\n\\n\\ndef build_source_records(source_frames: list[pd.DataFrame]) -> dict[int, dict[str, dict[str, Any]]]:\\n    """Build nested records: user_id -> source -> field values."""\\n    records: dict[int, dict[str, dict[str, Any]]] = {}\\n    for df in source_frames:\\n        for _, row in df.iterrows():\\n            user_id = int(row["user_id"])\\n            source_name = str(row["_source"])\\n            values: dict[str, Any] = {}\\n            for col in OUTPUT_COLUMNS:\\n                if col in row.index:\\n                    value = normalize_scalar(row[col])\\n                    if value is not None:\\n                        values[col] = int(value) if col == "user_id" else value\\n            records.setdefault(user_id, {})[source_name] = values\\n    return records\\n\\n\\ndef select_by_priority(user_sources: dict[str, dict[str, Any]], field: str) -> Any:\\n    """Select the first non-null field value according to source priority."""\\n    for config in SOURCE_CONFIG:\\n        source_name = config["name"]\\n        if source_name in user_sources and field in user_sources[source_name]:\\n            return user_sources[source_name][field]\\n    return None\\n\\n\\ndef detect_conflicts(records: dict[int, dict[str, dict[str, Any]]]) -> list[dict[str, Any]]:\\n    """Detect fields whose non-null values differ across sources for the same user."""\\n    conflicts: list[dict[str, Any]] = []\\n    for user_id in sorted(records):\\n        user_sources = records[user_id]\\n        if len(user_sources) < 2:\\n            continue\\n        for field in ["name", "email", "created_date", "status"]:\\n            values = {\\n                source_name: source_values[field]\\n                for source_name, source_values in user_sources.items()\\n                if field in source_values and source_values[field] is not None\\n            }\\n            distinct_values = {str(value) for value in values.values()}\\n            if len(distinct_values) > 1:\\n                conflicts.append(\\n                    {\\n                        "user_id": user_id,\\n                        "field": field,\\n                        "values": values,\\n                        "selected": select_by_priority(user_sources, field),\\n                    }\\n                )\\n    return conflicts\\n\\n\\ndef merge_users() -> tuple[pd.DataFrame, dict[str, Any]]:\\n    """Merge all sources and write Parquet and conflict report outputs."""\\n    source_frames = [read_source(config) for config in SOURCE_CONFIG]\\n    records = build_source_records(source_frames)\\n\\n    merged_rows: list[dict[str, Any]] = []\\n    for user_id in sorted(records):\\n        user_sources = records[user_id]\\n        row = {field: select_by_priority(user_sources, field) for field in OUTPUT_COLUMNS}\\n        row["user_id"] = int(user_id)\\n        merged_rows.append(row)\\n\\n    merged_df = pd.DataFrame(merged_rows, columns=OUTPUT_COLUMNS)\\n    merged_df["user_id"] = merged_df["user_id"].astype("int64")\\n    for col in ["name", "email", "created_date", "status"]:\\n        merged_df[col] = merged_df[col].astype("string")\\n\\n    conflicts = detect_conflicts(records)\\n    conflict_report = {\\n        "total_conflicts": len(conflicts),\\n        "conflicts": conflicts,\\n    }\\n\\n    MERGED_OUTPUT.parent.mkdir(parents=True, exist_ok=True)\\n    merged_df.to_parquet(MERGED_OUTPUT, index=False)\\n    with CONFLICT_OUTPUT.open("w", encoding="utf-8") as f:\\n        json.dump(conflict_report, f, indent=2, ensure_ascii=False)\\n        f.write("\\\\n")\\n\\n    return merged_df, conflict_report\\n\\n\\nif __name__ == "__main__":\\n    df, report = merge_users()\\n    print(f"Wrote {MERGED_OUTPUT} with {len(df)} rows")\\n    print(f"Wrote {CONFLICT_OUTPUT} with {report[\\\'total_conflicts\\\']} conflicts")\\n\'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, \'w\', encoding=\'utf-8\', newline=\'\\n\') as f:\n        f.write(content)\n    print(f"成功: 已写入 {path}")\nexcept Exception as exc:\n    print(f"写入失败: {exc}")\nPY\ntrue', '; tmux wait -S done', 'Enter'] min_timeout_sec: 0.0 max_timeout_sec: inf
