[51.082709, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/cmd.sh <<'PY'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = \"#!/usr/bin/env bash\\nset -euo pipefail\\n\\npython3 <<'PY'\\nfrom pathlib import Path\\nimport os\\nimport shutil\\nimport stat\\n\\nTREE_MAP = Path('/app/tree_map.txt')\\nROOT = Path('/app/files_dir')\\n\\nlines = TREE_MAP.read_text(encoding='utf-8').splitlines()\\nif not lines:\\n    raise SystemExit('tree map is empty')\\n\\nroot_line = lines[0]\\nif root_line.endswith('/'):\\n    root_path_text = root_line[:-1]\\nelse:\\n    root_path_text = root_line\\nif root_path_text != str(ROOT):\\n    raise SystemExit(f'unexpected root in tree map: {root_line!r}')\\n\\n# Idempotency: remove previous reconstruction and rebuild from the immutable map.\\nif ROOT.exists() or ROOT.is_symlink():\\n    if ROOT.is_dir() and not ROOT.is_symlink():\\n        # Ensure restrictive trees are removable by the current user.\\n        for dirpath, dirnames, filenames in os.walk(ROOT):\\n            os.chmod(dirpath, 0o700)\\n        shutil.rmtree(ROOT)\\n    else:\\n        ROOT.unlink()\\n\\nROOT.mkdir(mode=0o700, parents=True, exist_ok=True)\\nos.chmod(ROOT, 0o700)\\n\\nstack = [ROOT]\\nfor line in lines[1:]:\\n    if line == '':\\n        break\\n    marker = None\\n    idx = line.find('├── ')\\n    if idx != -1:\\n        marker = '├── '\\n    else:\\n        idx = line.find('└── ')\\n        if idx != -1:\\n            marker = '└── '\\n    if marker is None:\\n        # Ignore only non-entry lines such as summary if no blank separator exists.\\n        continue\\n\\n    level = idx // 4\\n    name = line[idx + len(marker):]\\n    is_dir = name.endswith('/')\\n    is_exec = False\\n    if is_dir:\\n        name = name[:-1]\\n    elif name.endswith('*'):\\n        # tree -F marks executable regular files with a trailing '*'.\\n        is_exec = True\\n        name = name[:-1]\\n\\n    if name in ('', '.', '..') or '/' in name or '\\\\x00' in name:\\n        raise SystemExit(f'unsafe or unsupported path component parsed from line: {line!r}')\\n\\n    if level + 1 > len(stack):\\n        raise SystemExit(f'invalid tree indentation near line: {line!r}')\\n    stack = stack[:level + 1]\\n    parent = stack[-1]\\n    path = parent / name\\n\\n    if is_dir:\\n        path.mkdir(mode=0o700)\\n        os.chmod(path, 0o700)\\n        stack.append(path)\\n    else:\\n        path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)\\n        path.touch(exist_ok=False)\\n        os.chmod(path, 0o700 if is_exec else 0o600)\\n\\n# Ensure every directory in the rebuilt tree has exactly mode 700.\\nfor dirpath, dirnames, filenames in os.walk(ROOT):\\n    os.chmod(dirpath, 0o700)\\nPY\\n\"\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, 'w', encoding='utf-8', newline='\\n') as f:\n        f.write(content)\n    print(f\"成功: 已写入 {path}\")\nexcept Exception as exc:\n    print(f\"写入失败: {exc}\")\nPY\ntrue; tmux wait -S done\r"]
