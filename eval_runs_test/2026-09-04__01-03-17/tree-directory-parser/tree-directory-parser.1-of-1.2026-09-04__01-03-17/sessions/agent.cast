[93.202754, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\nset -e\nrm -f /app/rebuild_tree_map.txt /app/rebuild_tree_map_2.txt\ntree -F /app/files_dir > /app/rebuild_tree_map.txt\nprintf -- '--- diff after first rebuild ---\\n'\ndiff -u /app/tree_map.txt /app/rebuild_tree_map.txt\nprintf -- 'diff ok\\n'\nprintf -- '--- directory permission check ---\\n'\nbad_dirs=$(find /app/files_dir -type d ! -perm 700 -printf '%m %p\\n')\nif [ -n \"$bad_dirs\" ]; then\n  printf '%s\\n' \"$bad_dirs\"\n  exit 1\nfi\nprintf 'all directories are mode 700\\n'\nprintf -- '--- zero-byte file check ---\\n'\nbad_files=$(find /app/files_dir -type f ! -size 0 -printf '%s %p\\n')\nif [ -n \"$bad_files\" ]; then\n  printf '%s\\n' \"$bad_files\"\n  exit 1\nfi\nprintf 'all files are zero-byte\\n'\nprintf -- '--- idempotency check ---\\n'\n/app/cmd.sh\ntree -F /app/files_dir > /app/rebuild_tree_map_2.txt\ndiff -u /app/tree_map.txt /app/rebuild_tree_map_2.txt\nprintf 'idempotency diff ok\\n'\nls -l /app/cmd.sh\ntrue; tmux wait -S done\r"]
