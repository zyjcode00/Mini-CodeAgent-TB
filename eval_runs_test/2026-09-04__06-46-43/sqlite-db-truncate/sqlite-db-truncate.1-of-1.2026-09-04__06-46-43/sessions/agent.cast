[54.537326, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\nls -l /app/trunc.db /app 2>&1 && file /app/trunc.db && python - <<'PY'\nimport os, struct\np='/app/trunc.db'\nprint('size', os.path.getsize(p))\nwith open(p,'rb') as f:\n    h=f.read(100)\nprint('header', h[:16])\nif len(h)>=100:\n    print('page_size', struct.unpack('>H', h[16:18])[0] or 65536)\n    print('write/read versions', h[18], h[19])\n    print('reserved', h[20])\n    print('file change counter', int.from_bytes(h[24:28],'big'))\n    print('db pages header', int.from_bytes(h[28:32],'big'))\n    print('schema cookie', int.from_bytes(h[40:44],'big'))\n    print('schema format', int.from_bytes(h[44:48],'big'))\nPY\ntrue; tmux wait -S done\r"]
