[173.740973, "o", "[\r\n  {\r\n    \"rowid\": 1,\r\n    \"word\": \"testword00\",\r\n    \"value\": 1,\r\n    \"cell_offset\": 4080\r\n  },\r\n  {\r\n    \"rowid\": 2,\r\n    \"word\": \"testword01\",\r\n    \"value\": 2,\r\n    \"cell_offset\": 4063\r\n  },\r\n  {\r\n    \"rowid\": 3,\r\n    \"word\": \"testword02\",\r\n    \"value\": 10,\r\n    \"cell_offset\": 4046\r\n  },\r\n  {\r\n    \"rowid\": 4,\r\n    \"word\": \"testword03\",\r\n    \"value\": 25,\r\n    \"cell_offset\": 4029\r\n  },\r\n  {\r\n    \"rowid\": 5,\r\n    \"word\": \"testword04\",\r\n    \"value\": 42,\r\n    \"cell_offset\": 4012\r\n  },\r\n  {\r\n    \"rowid\": 6,\r\n    \"word\": \"testword05\",\r\n    \"value\": 50,\r\n    \"cell_offset\": 3995\r\n  },\r\n  {\r\n    \"rowid\": 7,\r\n    \"word\": \"testword06\",\r\n    \"value\": 75,\r\n    \"cell_offset\": 3978\r\n  },\r\n  {\r\n    \"rowid\": 8,\r\n    \"word\": \"testword07\",\r\n    \"value\": 99,\r\n    \"cell_offset\": 3961\r\n  },\r\n  {\r\n    \"rowid\": 9,\r\n    \"word\": \"testword08\",\r\n    \"value\": 99.99,\r\n    \"cell_offset\": 3937\r\n  },\r\n  {\r\n    \"rowid\": 10,\r\n    \"word\": \"testword09\",\r\n    \"value\": 0.5,\r\n    \"cell_offset\": 3913\r\n  }\r\n]\r\ndeclared_cells 10 recovered_rows 10\r\nword_scan_count 10 ['testword00', 'testword01', 'testword02', 'testword03', 'testword04', 'testword052', 'testword06K', 'testword07c', 'testword08', 'testword09']\r\n"]
