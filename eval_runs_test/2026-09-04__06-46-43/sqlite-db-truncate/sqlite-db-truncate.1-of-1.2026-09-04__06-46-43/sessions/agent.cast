[54.653113, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython - <<'PY'\nimport sqlite3\np='/app/trunc.db'\ntry:\n    con=sqlite3.connect(p)\n    cur=con.cursor()\n    print('integrity:', cur.execute('pragma integrity_check').fetchall()[:5])\n    print('tables:', cur.execute(\"select type,name,tbl_name,sql from sqlite_master\").fetchall())\n    for row in cur.execute(\"select name from sqlite_master where type='table'\"):\n        print('table',row[0], cur.execute(f'pragma table_info({row[0]})').fetchall())\n        try:\n            print('count', cur.execute(f'select count(*) from {row[0]}').fetchone())\n            print('sample', cur.execute(f'select * from {row[0]} limit 5').fetchall())\n        except Exception as e: print('queryerr', e)\nexcept Exception as e:\n    print('sqlite error:', type(e).__name__, e)\nPY\ntrue; tmux wait -S done\r"]
