[173.7496, "o", "\u001b[?2004hroot@ab3c654a53a4:/app# "]
[211.192424, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - <<'PY'\nfrom pathlib import Path\nimport json, struct\n\nsrc = Path('/app/trunc.db')\nout = Path('/app/recover.json')\nb = src.read_bytes()\n\ndef getvar(buf, off):\n    v = 0\n    for i in range(9):\n        if off + i >= len(buf):\n            raise EOFError('varint beyond EOF')\n        c = buf[off + i]\n        if i == 8:\n            return (v << 8) | c, off + i + 1\n        v = (v << 7) | (c & 0x7f)\n        if not (c & 0x80):\n            return v, off + i + 1\n    raise ValueError('bad varint')\n\ndef serial_len(t):\n    fixed = {0:0, 1:1, 2:2, 3:3, 4:4, 5:6, 6:8, 7:8, 8:0, 9:0}\n    if t in fixed:\n        return fixed[t]\n    if t >= 12:\n        return (t - 12) // 2\n    raise ValueError(f'bad serial type {t}')\n\ndef decode_val(t, data):\n    if t == 0: return None\n    if t == 8: return 0\n    if t == 9: return 1\n    if 1 <= t <= 6: return int.from_bytes(data, 'big', signed=True)\n    if t == 7: return struct.unpack('>d', data)[0]\n    if t >= 13 and t % 2 == 1: return data.decode('utf-8')\n    if t >= 12 and t % 2 == 0: return data\n    raise ValueError(f'bad serial type {t}')\n\ndef parse_cell(buf, off):\n    payload_size, pos = getvar(buf, off)\n    rowid, pos = getvar(buf, pos)\n    payload_start = pos\n    header_size, hpos = getvar(buf, pos)\n    header_end = payload_start + header_size\n    payload_end = payload_start + payload_size\n    if not (0 < header_size <= payload_size and payload_end <= len(buf)):\n        raise ValueError('invalid cell boundaries')\n    serial_types = []\n    while hpos < header_end:\n        st, hpos = getvar(buf, hpos)\n        serial_types.append(st)\n    if hpos != header_end:\n        raise ValueError('record header overrun')\n    dpos = header_end\n    values = []\n    for st in serial_types:\n        n = serial_len(st)\n        values.append(decode_val(st, buf[dpos:dpos+n]))\n        dpos += n\n    if dpos != payload_end:\n        raise ValueError('record payload size mismatch')\n    return rowid, values\n\nif len(b) < 8 or b[0] != 0x0d:\n    raise SystemExit('Input does not look like a raw SQLite table leaf page')\n\nncell = int.from_bytes(b[3:5], 'big')\nptrs = [int.from_bytes(b[8 + 2*i:10 + 2*i], 'big') for i in range(ncell)]\nrows = []\nfor ptr in ptrs:\n    rowid, vals = parse_cell(b, ptr)\n    if len(vals) >= 3 and isinstance(vals[1], str):\n        rows.append({'word': vals[1], 'value': vals[2]})\n\n# Preserve table order by rowid/cell pointer order from the btree cell pointer array.\nout.write_text(json.dumps(rows, ensure_ascii=False), encoding='utf-8')\n\n# Validation\nloaded = json.loads(out.read_text(encoding='utf-8'))\nassert loaded == rows\nassert all(set(r.keys()) == {'word', 'value'} for r in loaded)\nassert len(loaded) == ncell == 10\nprint(f'wrote {out} with {len(loaded)} recovered rows')\nprint(out.read_text(encoding='utf-8'))\nPY\nls -l /app/recover.json\npython3 -m json.tool /app/recover.json >/tmp/recover_json_validated.txt && echo 'json validation ok' && cat /tmp/recover_json_validated.txt\ntrue; tmux wait -S done\r"]
