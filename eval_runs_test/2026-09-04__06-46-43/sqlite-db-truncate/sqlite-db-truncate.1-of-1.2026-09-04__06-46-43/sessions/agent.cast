[110.859243, "o", "\u001b[?2004hroot@ab3c654a53a4:/app# true; tmux wait -S done\r\n\u001b[?2004l\r"]
[110.86344, "o", "\u001b[?2004hroot@ab3c654a53a4:/app# "]
[173.703639, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - <<'PY'\nfrom pathlib import Path\nimport struct, re, json\nb=Path('/app/trunc.db').read_bytes()\n\ndef getvar(buf, off):\n    v=0\n    for i in range(9):\n        if off+i >= len(buf): raise EOFError('varint beyond EOF')\n        c=buf[off+i]\n        if i==8:\n            return (v<<8)|c, off+i+1\n        v=(v<<7)|(c&0x7f)\n        if not (c&0x80):\n            return v, off+i+1\n    raise ValueError('bad varint')\n\ndef serial_len(t):\n    return {0:0,1:1,2:2,3:3,4:4,5:6,6:8,7:8,8:0,9:0}.get(t, (t-12)//2 if t>=12 else None)\n\ndef decode_val(t, data):\n    if t==0: return None\n    if t==8: return 0\n    if t==9: return 1\n    if 1 <= t <= 6: return int.from_bytes(data, 'big', signed=True)\n    if t==7: return struct.unpack('>d', data)[0]\n    if t>=13 and t%2: return data.decode('utf-8','replace')\n    if t>=12 and not (t%2): return data.hex()\n    return data.hex()\n\ndef parse_cell(off):\n    payload, o=getvar(b,off)\n    rowid, o=getvar(b,o)\n    payload_start=o\n    hsz, ho=getvar(b,o)\n    if hsz < 1 or payload_start+payload > len(b):\n        raise ValueError('invalid payload boundaries')\n    types=[]\n    while ho < payload_start+hsz:\n        t, ho=getvar(b,ho)\n        types.append(t)\n    if ho != payload_start+hsz:\n        raise ValueError('header mismatch')\n    dataoff=payload_start+hsz\n    vals=[]\n    for t in types:\n        l=serial_len(t)\n        if l is None: raise ValueError(f'bad serial type {t}')\n        vals.append(decode_val(t, b[dataoff:dataoff+l]))\n        dataoff += l\n    if dataoff != payload_start+payload:\n        raise ValueError('payload length mismatch')\n    return rowid, vals\n\n# Parse declared cells from first page, which is already a table leaf page.\nif b[0] != 13:\n    raise SystemExit(f'Expected raw SQLite table leaf page at offset 0, got {b[0]!r}')\nncell=int.from_bytes(b[3:5],'big')\nptrs=[int.from_bytes(b[8+2*i:10+2*i],'big') for i in range(ncell)]\nrows=[]\nfor off in ptrs:\n    rowid, vals = parse_cell(off)\n    # observed layout: [id/null-placeholder, word, value]\n    if len(vals) >= 3 and isinstance(vals[1], str) and vals[1].startswith('testword'):\n        rows.append({'rowid': rowid, 'word': vals[1], 'value': vals[2], 'cell_offset': off})\nprint(json.dumps(rows, indent=2, ensure_ascii=False))\nprint('declared_cells', ncell, 'recovered_rows', len(rows))\n# independent text scan for possible words not captured by cell pointers\nwords=sorted(set(m.group(0).decode() for m in re.finditer(rb'testword[0-9A-Za-z_\\-]*', b)))\nprint('word_scan_count', len(words), words)\nPY\ntrue; tmux wait -S done\r"]
[173.704697, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
