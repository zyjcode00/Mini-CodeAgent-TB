[74.262029, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\nset -u\nls -l /app/trunc.db /app 2>&1\npython3 - <<'PY'\nimport os, struct, sqlite3, binascii\np='/app/trunc.db'\nprint('size', os.path.getsize(p))\nwith open(p,'rb') as f:\n    h=f.read(256)\nprint('header16', h[:16])\nprint('header_hex_100', binascii.hexlify(h[:100]).decode())\nif len(h)>=100:\n    ps=struct.unpack('>H', h[16:18])[0] or 65536\n    print('page_size', ps)\n    print('write/read versions', h[18], h[19])\n    print('reserved', h[20])\n    print('usable', ps-h[20])\n    print('db_pages_header', int.from_bytes(h[28:32],'big'))\n    print('freelist_trunk', int.from_bytes(h[32:36],'big'))\n    print('freelist_count', int.from_bytes(h[36:40],'big'))\n    print('schema_cookie', int.from_bytes(h[40:44],'big'))\n    print('schema_format', int.from_bytes(h[44:48],'big'))\n    print('text_encoding', int.from_bytes(h[56:60],'big'))\ntry:\n    con=sqlite3.connect('file:/app/trunc.db?mode=ro', uri=True)\n    cur=con.cursor()\n    try: print('integrity', cur.execute('pragma integrity_check').fetchall()[:10])\n    except Exception as e: print('integrity_error', repr(e))\n    try: print('sqlite_master', cur.execute('select type,name,tbl_name,rootpage,sql from sqlite_master').fetchall())\n    except Exception as e: print('master_error', repr(e))\nexcept Exception as e:\n    print('connect_error', type(e).__name__, e)\nPY\ntrue; tmux wait -S done\r"]
