[74.299966, "o", "page_size 4012\r\nwrite/read versions 15 155\r\nreserved 15\r\nusable 3997\r\ndb_pages_header 0\r\nfreelist_trunk 0\r\nfreelist_count 0\r\nschema_cookie 0\r\nschema_format 0\r\ntext_encoding 0\r\n"]
