[110.822291, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - <<'PY'\nfrom pathlib import Path\nimport binascii\nb=Path('/app/trunc.db').read_bytes()\nprint('len', len(b))\nprint('page type', b[0], 'ncell', int.from_bytes(b[3:5],'big'), 'cell_start', int.from_bytes(b[5:7],'big'), 'frag', b[7])\nptrs=[int.from_bytes(b[8+2*i:10+2*i],'big') for i in range(int.from_bytes(b[3:5],'big'))]\nprint('ptrs', ptrs)\nfor p in ptrs:\n    print('\\ncell@',p,'hex',binascii.hexlify(b[p:p+80]).decode())\n    # printable preview\n    print('ascii', ''.join(chr(c) if 32<=c<127 else '.' for c in b[p:p+100]))\n\ndef getvar(buf, off):\n    v=0\n    for i in range(9):\n        c=buf[off+i]\n        if i==8:\n            return (v<<8)|c, off+i+1\n        v=(v<<7)|(c&0x7f)\n        if not (c&0x80):\n            return v, off+i+1\n    raise ValueError\n\ndef serial_len(t):\n    if t==0: return 0\n    if t==1: return 1\n    if t==2: return 2\n    if t==3: return 3\n    if t==4: return 4\n    if t==5: return 6\n    if t==6: return 8\n    if t==7: return 8\n    if t in (8,9): return 0\n    if t>=12: return (t-12)//2\n    raise ValueError(t)\n\ndef decode_val(t, data):\n    if t==0: return None\n    if t==8: return 0\n    if t==9: return 1\n    if 1<=t<=6:\n        return int.from_bytes(data, 'big', signed=True)\n    if t>=13 and t%2==1:\n        return data.decode('utf-8','replace')\n    if t>=12 and t%2==0:\n        return data\n    return data\n\nfor p in ptrs:\n    try:\n        payload, o = getvar(b,p)\n        rowid, o = getvar(b,o)\n        start=o\n        hsz, ho = getvar(b,o)\n        types=[]\n        while ho < start+hsz:\n            t, ho = getvar(b,ho); types.append(t)\n        dataoff=start+hsz\n        vals=[]\n        for t in types:\n            l=serial_len(t); data=b[dataoff:dataoff+l]; dataoff+=l; vals.append(decode_val(t,data))\n        print('PARSED', p, 'payload',payload,'rowid',rowid,'hsz',hsz,'types',types,'vals',vals,'end',dataoff)\n    except Exception as e:\n        print('ERR parse',p,e)\nPY\ntrue; tmux wait -S done\r"]
