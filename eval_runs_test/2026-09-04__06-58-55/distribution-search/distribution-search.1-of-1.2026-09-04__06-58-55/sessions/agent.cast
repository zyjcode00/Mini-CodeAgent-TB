[124.45256, "i", "_from_uniform(p)\\n    assert abs(fwd - TARGET) <= TOL, f\"forward KL {fwd} differs from {TARGET}\"\\n    assert abs(bwd - TARGET) <= TOL, f\"backward KL {bwd} differs from {TARGET}\"\\n    print(f\"forward_kl={fwd:.17g}\")\\n    print(f\"backward_kl={bwd:.17g}\")\\n\\n\\ndef main():\\n    test_distribution_file_exists()\\n    test_distribution_is_valid_probability_vector()\\n    test_distribution_kl_targets()\\n    p = np.load(DIST_PATH)\\n    print(f\"shape={p.shape}, dtype={p.dtype}, sum={p.sum():.17g}, min={p.min():.17g}, max={p.max():.17g}\")\\n    print(\"all validation tests passed\")\\n\\n\\nif __name__ == \"__main__\":\\n    main()\\n'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, 'w', encoding='utf-8', newline='\\n') as f:\n        f.write(content)\n    print(f\"成功: 已写入 {path}\")\nexcept Exception as exc:\n    print(f\"写入失败: {exc}\")\nPY\ntrue; tmux wait -S done\r"]
