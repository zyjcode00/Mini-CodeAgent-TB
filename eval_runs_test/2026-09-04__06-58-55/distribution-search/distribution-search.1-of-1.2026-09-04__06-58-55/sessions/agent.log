[?2004l[?2004h> content = 'import os\n\nimport numpy as np\n\n\nN = 150_000\nTARGET = 10.0\nTOL = 0.001\nDIST_PATH = "/app/dist.npy"\n\n\ndef forward_kl_from_uniform(p: np.ndarray) -> float:\n    return float(np.sum(p * np.log(p * N)))\n\n\ndef backward_kl_from_uniform(p: np.ndarray) -> float:\n    return float(np.mean(np.log((1.0 / N) / p)))\n\n\ndef test_distribution_file_exists():\n    assert os.path.exists(DIST_PATH)\n\n\ndef test_distribution_is_valid_probability_vector():\n    p = np.load(DIST_PATH)\n    assert p.shape == (N,)\n    assert np.issubdtype(p.dtype, np.floating)\n    assert np.all(np.isfinite(p))\n    assert np.all(p >= 0)\n    # Backward KL requires strictly positive probabilities.\n    assert np.all(p > 0)\n    assert abs(float(p.sum()) - 1.0) <= 1e-12\n\n\ndef test_distribution_kl_targets():\n    p = np.load(DIST_PATH)\n    fwd = forward_kl_from_uniform(p)\n    bwd = backward_kl_from_uniform(p)\n    assert abs(fwd - TARGET) <= TOL, f"forward KL {fwd} differs from {TARGET}"\n    assert abs(bwd - TARGET) <= TOL, f"backward KL {bwd} differs from {TARGET}"\n'
