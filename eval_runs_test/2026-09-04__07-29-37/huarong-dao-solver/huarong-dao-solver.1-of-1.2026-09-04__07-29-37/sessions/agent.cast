[29.803268, "o", "\u001b[?2004hroot@07ca2050ac0a:/app# "]
[62.16804, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\ncat > /app/solve_huarong.py <<'PY'\nfrom collections import deque\nimport json\n\nH, W = 5, 4\npiece_order = ['C','A','B','D','E','G','s1','s2','s3','s4']\nsizes = {\n    'C': (2,2),\n    'A': (2,1), 'B': (2,1), 'D': (2,1), 'E': (2,1),\n    'G': (1,2),\n    's1': (1,1), 's2': (1,1), 's3': (1,1), 's4': (1,1),\n}\n# top-left positions, 0-based. Soldiers are distinguished internally only.\nstart_pos = {\n    'A': (0,0), 'C': (0,1), 'B': (0,3),\n    'D': (2,0), 'G': (2,1), 'E': (2,3),\n    's1': (3,1), 's2': (3,2), 's3': (4,0), 's4': (4,3),\n}\nstart = tuple(start_pos[p] for p in piece_order)\ngoal_c = (3,1)\n\ndef occ(state):\n    grid = [[None]*W for _ in range(H)]\n    for p, (r,c) in zip(piece_order, state):\n        h,w = sizes[p]\n        for rr in range(r, r+h):\n            for cc in range(c, c+w):\n                if not (0 <= rr < H and 0 <= cc < W):\n                    return None\n                if grid[rr][cc] is not None:\n                    return None\n                grid[rr][cc] = p\n    return grid\n\ndef board(state):\n    grid = [['.']*W for _ in range(H)]\n    for p, (r,c) in zip(piece_order, state):\n        h,w = sizes[p]\n        ch = 'S' if p.startswith('s') else p\n        for rr in range(r, r+h):\n            for cc in range(c, c+w):\n                grid[rr][cc] = ch\n    return [''.join(row) for row in grid]\n\ndef neighbors(state):\n    grid = occ(state)\n    for i, p in enumerate(piece_order):\n        r,c = state[i]\n        h,w = sizes[p]\n        for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n            nr,nc = r+dr, c+dc\n            if nr < 0 or nc < 0 or nr+h > H or nc+w > W:\n                continue\n            ok = True\n            # only need check newly covered rectangle cells, simple check whole target against occupancy by others\n            for rr in range(nr, nr+h):\n                for cc in range(nc, nc+w):\n                    owner = grid[rr][cc]\n                    if owner is not None and owner != p:\n                        ok = False\n                        break\n                if not ok:\n                    break\n            if ok:\n                lst = list(state)\n                lst[i] = (nr,nc)\n                yield tuple(lst)\n\ndef solve():\n    q = deque([start])\n    parent = {start: None}\n    while q:\n        s = q.popleft()\n        if s[piece_order.index('C')] == goal_c:\n            path = []\n            while s is not None:\n                path.append(s)\n                s = parent[s]\n            return list(reversed(path))\n        for ns in neighbors(s):\n            if ns not in parent:\n                parent[ns] = s\n                q.append(ns)\n    return None\n\npath = solve()\nif path is None:\n    raise SystemExit('No solution')\nboards = [board(s) for s in path]\nprint('states', len(boards), 'moves', len(boards)-1)\nprint('first', boards[0])\nprint('last', boards[-1])\nwith open('/app/solution.json', 'w') as f:\n    json.dump({'boards': boards}, f, indent=2)\nPY\npython /app/solve_huarong.py\npython - <<'PY'\nimport json\nx=json.load(open('/app/solution.json'))\nprint(len(x['boards']))\nPY\ntrue; tmux wait -S done\r"]
