[?2004l[?2004h> content = 'import json\n\nH, W = 5, 4\nINITIAL = ["ACCB", "ACCB", "DGGE", "DSSE", "S..S"]\nUNIQUE_PIECES = set("ABCDEG")\nALL_CHARS = set("ABCDEGS.")\nCOUNTS = {\n    "A": 2,\n    "B": 2,\n    "C": 4,\n    "D": 2,\n    "E": 2,\n    "G": 2,\n    "S": 4,\n    ".": 2,\n}\nEXPECTED_SHAPES = {\n    "A": (2, 1),\n    "B": (2, 1),\n    "C": (2, 2),\n    "D": (2, 1),\n    "E": (2, 1),\n    "G": (1, 2),\n}\n\n\ndef cells(board, ch):\n    return {(r, c) for r, row in enumerate(board) for c, val in enumerate(row) if val == ch}\n\n\ndef assert_valid_board(board):\n    assert isinstance(board, list)\n    assert len(board) == H\n    assert all(isinstance(row, str) and len(row) == W for row in board)\n    flat = "".join(board)\n    assert set(flat) <= ALL_CHARS\n    for ch, count in COUNTS.items():\n        assert flat.count(ch) == count, (ch, flat.count(ch), board)\n\n    for ch, (height, width) in EXPECTED_SHAPES.items():\n        coords = cells(board, ch)\n        rows = [r for r, _ in coords]\n        cols = [c for _, c in coords]\n        assert max(rows) - min(rows) + 1 == height, (ch, board)\n        assert max(cols) - min(cols) + 1 == width, (ch, board)\n        assert len(coords) == height * width, (ch, board)\n        expected = {\n            (r, c)\n            for r in range(min(rows), min(rows) + height)\n            for c in range(min(cols), min(cols) + width)\n        }\n        assert coords == expected, (ch, board)\n\n\ndef translated_by_one(old_cells, new_cells):\n    if old_cells == new_cells:\n        return False\n    old_sorted = sorted(old_cells)\n    new_sorted = sorted(new_cells)\n    dr = new_sorted[0][0] - old_sorted[0][0]\n    dc = new_sorted[0][1] - old_sorted[0][1]\n    if abs(dr) + abs(dc) != 1:\n        return False\n    return {(r + dr, c + dc) for r, c in old_cells} == new_cells\n\n\ndef unique_piece_move_is_legal(prev, cur, mover):\n    for ch in UNIQUE_PIECES - {mover}:\n        if cells(prev, ch) != cells(cur, ch):\n            return False\n    if cells(prev, "S") != cells(cur, "S"):\n        return False\n\n    old = cells(prev, mover)\n    new = cells(cur, mover)\n    if not translated_by_one(old, new):\n        return False\n\n    entered = new - old\n    vacated = old - new\n    return all(prev[r][c] == "." for r, c in entered) and all(cur[r][c] == "." for r, c in vacated)\n\n\ndef soldier_move_is_legal(prev, cur):\n    for ch in UNIQUE_PIECES:\n        if cells(prev, ch) != cells(cur, ch):\n            return False\n    old_s = cells(prev, "S")\n    new_s = cells(cur, "S")\n    removed = old_s - new_s\n    added = new_s - old_s\n    if len(removed) != 1 or len(added) != 1:\n        return False\n    (r1, c1), = removed\n    (r2, c2), = added\n    return abs(r1 - r2) + abs(c1 - c2) == 1 and prev[r2][c2] == "." and cur[r1][c1] == "."\n\n\ndef transition_is_legal(prev, cur):\n    if prev == cur:\n        return False\n    return soldier_move_is_legal(prev, cur) or any(\n        unique_piece_move_is_legal(prev, cur, mover) for mover in UNIQUE_PIECES\n    )\n\n\ndef test_solution_json_contains_legal_solution():\n    with open("/app/solution.json") as f:\n        data = json.load(f)\n\n    assert sorted(data.keys()) == ["boards"]\n    boards = data["boards"]\n    assert isinstance(boards, list)\n    assert len(boards) > 1\n    assert boards[0] == INITIAL\n\n    for board in boards:\n        assert_valid_board(board)\n\n    for i, (prev, cur) in enumerate(zip(boards, boards[1:]), start=1):\n        assert transition_is_legal(prev, cur), f"illegal transition at move {i}: {prev} -> {cur}"\n\n    final_c = cells(boards[-1], "C")\n    assert final_c == {(3, 1), (3, 2), (4, 1), (4, 2)}\n\n\nif __name__ == "__main__":\n    test_solution_json_contains_legal_solution()\n    print("solution.json is valid")\n'
