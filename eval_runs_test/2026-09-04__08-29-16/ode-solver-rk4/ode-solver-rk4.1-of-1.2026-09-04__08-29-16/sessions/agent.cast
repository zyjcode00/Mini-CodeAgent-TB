[275.717791, "o", "\u001b[?2004hroot@6495324dea9b:/app# "]
[357.89234, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/test_ode_solver_extra.py <<'PY'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = 'import csv\\nimport math\\nimport os\\nimport subprocess\\nimport sys\\n\\nAPP = \"/app\"\\nPROBLEM = os.path.join(APP, \"ode_problem.py\")\\nCALLS = os.path.join(APP, \"rhs_calls.csv\")\\nSOLUTION = os.path.join(APP, \"output\", \"solution.csv\")\\n\\n\\ndef run_case(t0, t1, y0, eval_ts, rhs_expr, rhs_func):\\n    with open(PROBLEM, \"w\", encoding=\"utf-8\") as f:\\n        f.write(\\n            \"import math\\\\n\"\\n            f\"t0 = {t0!r}\\\\n\"\\n            f\"t1 = {t1!r}\\\\n\"\\n            f\"y0 = {y0!r}\\\\n\"\\n            f\"eval_ts = {eval_ts!r}\\\\n\"\\n            \"_log_path = \\'/app/rhs_calls.csv\\'\\\\n\"\\n            \"open(_log_path, \\'w\\').close()\\\\n\"\\n            \"def rhs(t, y):\\\\n\"\\n            \"    with open(_log_path, \\'a\\') as fh:\\\\n\"\\n            \"        fh.write(repr(float(t)) + \\',\\' + repr(float(y)) + \\'\\\\\\\\n\\')\\\\n\"\\n            f\"    return {rhs_expr}\\\\n\"\\n        )\\n    if os.path.exists(SOLUTION):\\n        os.remove(SOLUTION)\\n    result = subprocess.run([sys.executable, os.path.join(APP, \"ode_solve.py\")], cwd=APP, text=True, capture_output=True)\\n    assert result.returncode == 0, result.stderr + result.stdout\\n    with open(SOLUTION, newline=\"\") as f:\\n        out = list(csv.reader(f))\\n    assert out[0] == [\"t\", \"y\"]\\n    rows = [(float(a), float(b)) for a, b in out[1:]]\\n    assert [r[0] for r in rows] == eval_ts\\n    calls = []\\n    with open(CALLS, newline=\"\") as f:\\n        for row in csv.reader(f):\\n            if row:\\n                calls.append(float(row[0]))\\n    if calls:\\n        h_max = (t1 - t0) / 200.0\\n        assert all(calls[i] <= calls[i+1] + 1e-15 for i in range(len(calls)-1))\\n        assert max([0.0] + [calls[i+1] - calls[i] for i in range(len(calls)-1)]) <= h_max/2 + 1e-14\\n        for et in eval_ts:\\n            if et > t0:\\n                assert any(abs(c - et) <= 1e-12 for c in calls), (et, calls[-5:])\\n    # Fine RK4 reference.\\n    for t, y in rows:\\n        tr = t0\\n        yr = y0\\n        while tr < t - 1e-15:\\n            h = min((t1-t0)/200000.0, t-tr)\\n            k1 = rhs_func(tr, yr)\\n            k2 = rhs_func(tr+h/2, yr+h*k1/2)\\n            k3 = rhs_func(tr+h/2, yr+h*k2/2)\\n            k4 = rhs_func(tr+h, yr+h*k3)\\n            yr += h*(k1+2*k2+2*k3+k4)/6\\n            tr += h\\n        assert abs(y - yr) <= 1e-5, (t, y, yr, abs(y-yr))\\n\\n\\ndef main():\\n    run_case(0.0, 1.0, 1.0, [0.0], \"-y\", lambda t, y: -y)\\n    run_case(-1.0, 1.5, -0.3, [-0.99, -0.2, 0.0, 0.001, 0.9, 1.5],\\n             \"0.2*y + math.cos(2*t) - 0.1*t\", lambda t, y: 0.2*y + math.cos(2*t) - 0.1*t)\\n    run_case(0.0, 0.2, 0.7, [i/1000 for i in range(0, 201, 7)],\\n             \"math.sin(20*t) - 2*y\", lambda t, y: math.sin(20*t) - 2*y)\\n    print(\"extra ode solver tests passed\")\\n\\n\\nif __name__ == \"__main__\":\\n    main()\\n'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, 'w', encoding='utf-8', newline='\\n') as f:\n        f.write(content)\n    print(f\"成功: 已写入 {path}\")\nexcept Exception as exc:\n    print(f\"写入失败: {exc}\")\nPY\ntrue; tmux wait -S done\r"]
[357.893104, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n"]
[357.893441, "o", "\u001b[?2004l\r\u001b[?2004h"]
[357.893662, "o", "root@6495324dea9b:/app# "]
[357.893851, "o", "python3 - /app/test_ode_solver_extra.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[357.89399, "o", "import os\r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r\u001b[?2004h> "]
[357.894138, "o", "path = sys.argv[1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[357.894301, "o", "> "]
[357.902127, "o", "content = 'import csv\\nimport math\\nimport os\\nimport subprocess\\nimport sys\\n\\nAPP = \"/app\"\\nPROBLEM = os.path.join(APP, \"ode_problem.py\")\\nCALLS = os.path.join(APP, \"rhs_calls.csv\")\\nSOLUTION = os.path.join(APP, \"output\", \"solution.csv\")\\n\\n\\ndef run_case(t0, t1, y0, eval_ts, rhs_expr, rhs_func):\\n    with open(PROBLEM, \"w\", encoding=\"utf-8\") as f:\\n        f.write(\\n            \"import math\\\\n\"\\n            f\"t0 = {t0!r}\\\\n\"\\n            f\"t1 = {t1!r}\\\\n\"\\n            f\"y0 = {y0!r}\\\\n\"\\n            f\"eval_ts = {eval_ts!r}\\\\n\"\\n            \"_log_path = \\'/app/rhs_calls.csv\\'\\\\n\"\\n            \"open(_log_path, \\'w\\').close()\\\\n\"\\n            \"def rhs(t, y):\\\\n\"\\n            \"    with open(_log_path, \\'a\\') as fh:\\\\n\"\\n            \"        fh.write(repr(float(t)) + \\',\\' + repr(float(y)) + \\'\\\\\\\\n\\')\\\\n\"\\n            f\"    return {rhs_expr}\\\\n\"\\n        )\\n    if os.path.exists(SOLUTION):\\n        os.remove(SOLUTION)\\n    result = subprocess.run([sys.executable, os.path.join(APP, \"ode_solve.py\")], cwd=APP, text=True, capture_output=True)\\n    assert result.returncode == 0, result.stderr + result.stdout\\n    with open(SOLUTION, newline=\"\") as f:\\n        out = list(csv.reader(f))\\n    assert out[0] == [\"t\", \"y\"]\\n    rows = [(float(a), float(b)) for a, b in out[1:]]\\n    assert [r[0] for r in rows] == eval_ts\\n    calls = []\\n    with open(CALLS, newline=\"\") as f:\\n        for row in csv.reader(f):\\n            if row:\\n                calls.append(float(row[0]))\\n    if calls:\\n        h_max = (t1 - t0) / 200.0\\n        assert all(calls[i] <= calls[i+1] + 1e-15 for i in range(len(calls)-1))\\n        assert max([0.0] + [calls[i+1] - calls[i] for i in range(len(calls)-1)]) <= h_max/2 + 1e-14\\n        for et in eval_ts:\\n            if et > t0:\\n                assert any(abs(c - et) <= 1e-12 for c in calls), (et, calls[-5:])\\n    # Fine RK4 reference.\\n    for t, y in rows:\\n        tr = t0\\n        yr = y0\\n        while tr < t - 1e-15:\\n            h = min((t1-t0)/200000.0, t-tr)\\n            k1 = rhs_func(tr, yr)\\n            k2 = rhs_func(tr+h/2, yr+h*k1/2)\\n            k3 = rhs_func(tr+h/2, yr+h*k2/2)\\n            k4 = rhs_func(tr+h, yr+h*k3)\\n            yr += h*(k1+2*k2+2*k3+k4)/6\\n            tr += h\\n        assert abs(y - yr) <= 1e-5, (t, y, yr, abs(y-yr))\\n\\n\\ndef main():\\n    run_case(0.0, 1.0, 1.0, [0.0], \"-y\", lambda t, y: -y)\\n    run_case(-1.0, 1.5, -0.3, [-0.99, -0.2, 0.0, 0.001, 0.9, 1.5],\\n             \"0.2*y + math.cos(2*t) - 0.1*t\", lambda t, y: 0.2*y + math.cos(2*t) - 0.1*t)\\n    run_case(0.0, 0.2, 0.7, [i/1000 for i in range(0, 201, 7)],\\n             \"math.sin(20*t) - 2*y\", lambda t, y: math.sin(20*t) - 2*y)\\n    print(\"extra ode solver tests passed\")\\n\\n\\nif __name__ == \"__main__\":\\n    main()\\n'\r\n\u001b[?2004l\r"]
