ve() -> List[Tuple[float, float]]:\n    """Integrate the problem and return (eval_t, y(eval_t)) rows."""\n    t0 = float(ode_problem.t0)\n    t1 = float(ode_problem.t1)\n    y = float(ode_problem.y0)\n    eval_ts = [float(t) for t in ode_problem.eval_ts]\n\n    if not (t0 < t1):\n        raise ValueError("ode_problem must satisfy t0 < t1")\n\n    h_max = (t1 - t0) / 200.0\n    t = t0\n    rows: List[Tuple[float, float]] = []\n\n    # A small tolerance is used only to avoid zero-length cleanup steps from\n    # roundoff.  Step endpoints written to CSV are the original eval_ts values.\n    tol = max(1e-15, abs(t1 - t0) * 1e-14)\n\n    for target in eval_ts:\n        if target < t0 - tol or target > t1 + tol:\n            raise ValueError("eval_ts entries must lie in [t0, t1]")\n        if target < t - tol:\n            raise ValueError("eval_ts must be increasing")\n\n        # March to this requested time.  Each final substep is exactly clamped\n        # to target, and _rk_dp5_step evaluates rhs at t+h == target.\n        while t < target - tol:\n            h = min(h_max, target - t)\n            # If floating-point subtraction nudges us past the target, clamp.\n            if t + h > target:\n                h = target - t\n            y = _rk_dp5_step(t, y, h)\n            t = t + h\n            if abs(t - target) <= tol:\n                t = target\n                break\n\n        # If target == t0, no advancement/RHS call is needed; the initial value\n        # is already the exact numerical state requested.\n        rows.append((target, y))\n\n    return rows\n\n\ndef write_solution(rows: Iterable[Tuple[float, float]]) -> None:\n    """Write rows to /app/output/solution.csv with header t,y."""\n    out_dir = "/app/output"\n    os.makedirs(out_dir, exist_ok=True)\n    out_path = os.path.join(out_dir, "solution.csv")\n    with open(out_path, "w", newline="") as fh:\n        writer = csv.writer(fh)\n        writer.writerow(["t", "y"])\n        for t, y in rows:\n            writer.writerow([repr(float(t)), repr(float(y))])\n\n\ndef main() -> None:\n    write_solution(solve())\n\n\nif __name__ == "__main__":\n    main()\n'
