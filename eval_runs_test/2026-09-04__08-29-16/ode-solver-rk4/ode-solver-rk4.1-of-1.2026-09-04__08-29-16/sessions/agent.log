[?2004l[?2004h> content = 'import csv\nimport importlib\nimport math\nimport os\nimport subprocess\nimport sys\n\nAPP = "/app"\nPROBLEM = os.path.join(APP, "ode_problem.py")\nCALLS = os.path.join(APP, "rhs_calls.csv")\nSOLUTION = os.path.join(APP, "output", "solution.csv")\n\n\ndef write_problem():\n    with open(PROBLEM, "w", encoding="utf-8") as f:\n        f.write(\n            "import math\\n"\n            "t0 = 0.0\\n"\n            "t1 = 2.0\\n"\n            "y0 = 0.25\\n"\n            "eval_ts = [0.0, 0.013, 0.1, 0.333, 0.75, 1.234, 2.0]\\n"\n            "_log_path = \'/app/rhs_calls.csv\'\\n"\n            "open(_log_path, \'w\').close()\\n"\n            "def rhs(t, y):\\n"\n            "    with open(_log_path, \'a\') as fh:\\n"\n            "        fh.write(repr(float(t)) + \',\' + repr(float(y)) + \'\\\\n\')\\n"\n            "    return -0.7*y + math.sin(3.0*t) + 0.05*t*t\\n"\n        )\n\n\ndef rhs_ref(t, y):\n    return -0.7 * y + math.sin(3.0 * t) + 0.05 * t * t\n\n\ndef rk4_ref(t0, y0, target, h=1e-5):\n    t = t0\n    y = y0\n    while t < target - 1e-15:\n        step = min(h, target - t)\n        k1 = rhs_ref(t, y)\n        k2 = rhs_ref(t + 0.5 * step, y + 0.5 * step * k1)\n        k3 = rhs_ref(t + 0.5 * step, y + 0.5 * step * k2)\n        k4 = rhs_ref(t + step, y + step * k3)\n        y += (step / 6.0) * (k1 + 2*k2 + 2*k3 + k4)\n        t += step\n    return y\n\n\ndef load_csv_rows():\n    with open(SOLUTION, newline="") as f:\n        rows = list(csv.reader(f))\n    assert rows[0] == ["t", "y"]\n    return [(float(t), float(y)) for t, y in rows[1:]]\n\n\ndef test_solver_contract():\n    write_problem()\n    if os.path.exists(SOLUTION):\n        os.remove(SOLUTION)\n\n    result = subprocess.run([sys.executable, os.path.join(APP, "ode_solve.py")], cwd=APP, text=True, capture_output=True)\n    assert result.returncode == 0, result.stderr + result.stdout\n    assert os.path.exists(SOLUTION)\n\n    spec = importlib.util.spec_from_file_location("ode_problem_local", PROBLEM)\n    problem = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(problem)\n\n    rows = load_csv_rows()\n    assert len(rows) == len(problem.eval_ts)\n    for (got_t, _), exp_t in zip(rows, problem.eval_ts):\n        assert abs(got_t - exp_t) <= 1e-12\n\n    calls = []\n    with open(CALLS, newline="") as f:\n        for row in csv.reader(f):\n            if row:\n                calls.append((float(row[0]), float(row[1])))\n\n    h_max = (problem.t1 - problem.t0) / 200.0\n    assert calls, "rhs was never called"\n    assert all(calls[i][0] <= calls[i + 1][0] + 1e-15 for i in range(len(calls) - 1))\n    assert max(calls[i + 1][0] - calls[i][0] for i in range(len(calls) - 1)) <= h_max / 2 + 1e-14\n\n    # Every eval_t after t0 must be an actual RHS call time (clamped final stage), no interpolation.\n    call_times = [t for t, _ in calls]\n    for exp_t in problem.eval_ts:\n        if exp_t > problem.t0:\n            assert any(abs(t - exp_t) <= 1e-12 for t in call_times), exp_t\n\n    # Efficiency: 6 RHS evaluations per DP5 step, with extra steps only from eval_t clamping.\n    min_steps = math.ceil((problem.t1 - problem.t0) / h_max)\n    assert len(calls) <= 6 * (min_steps + len(problem.eval_ts) + 5)\n\n    max_err = 0.0\n    for t, y in rows:\n        ref = rk4_ref(problem.t0, problem.y0, t, h=2e-6)\n        max_err = max(max_err, abs(y - ref))\n    assert max_err <= 1e-5, max_err\n\n\nif __name__ == "__main__":\n    test_solver_contract()\n    print("local ode solver tests passed")\n'
