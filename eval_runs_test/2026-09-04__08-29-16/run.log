ys.executable, os.path.join(APP, "ode_solve.py")], cwd=APP, text=True, capture_output=True)\\n    assert result.returncode == 0, result.stderr + result.stdout\\n    assert os.path.exists(SOLUTION)\\n\\n    spec = importlib.util.spec_from_file_location("ode_problem_local", PROBLEM)\\n    problem = importlib.util.module_from_spec(spec)\\n    spec.loader.exec_module(problem)\\n\\n    rows = load_csv_rows()\\n    assert len(rows) == len(problem.eval_ts)\\n    for (got_t, _), exp_t in zip(rows, problem.eval_ts):\\n        assert abs(got_t - exp_t) <= 1e-12\\n\\n    calls = []\\n    with open(CALLS, newline="") as f:\\n        for row in csv.reader(f):\\n            if row:\\n                calls.append((float(row[0]), float(row[1])))\\n\\n    h_max = (problem.t1 - problem.t0) / 200.0\\n    assert calls, "rhs was never called"\\n    assert all(calls[i][0] <= calls[i + 1][0] + 1e-15 for i in range(len(calls) - 1))\\n    assert max(calls[i + 1][0] - calls[i][0] for i in range(len(calls) - 1)) <= h_max / 2 + 1e-14\\n\\n    # Every eval_t after t0 must be an actual RHS call time (clamped final stage), no interpolation.\\n    call_times = [t for t, _ in calls]\\n    for exp_t in problem.eval_ts:\\n        if exp_t > problem.t0:\\n            assert any(abs(t - exp_t) <= 1e-12 for t in call_times), exp_t\\n\\n    # Efficiency: 6 RHS evaluations per DP5 step, with extra steps only from eval_t clamping.\\n    min_steps = math.ceil((problem.t1 - problem.t0) / h_max)\\n    assert len(calls) <= 6 * (min_steps + len(problem.eval_ts) + 5)\\n\\n    max_err = 0.0\\n    for t, y in rows:\\n        ref = rk4_ref(problem.t0, problem.y0, t, h=2e-6)\\n        max_err = max(max_err, abs(y - ref))\\n    assert max_err <= 1e-5, max_err\\n\\n\\nif __name__ == "__main__":\\n    test_solver_contract()\\n    print("local ode solver tests passed")\\n\'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, \'w\', encoding=\'utf-8\', newline=\'\\n\') as f:\n        f.write(content)\n    print(f"成功: 已写入 {path}")\nexcept Exception as exc:\n    print(f"写入失败: {exc}")\nPY\ntrue', '; tmux wait -S done', 'Enter'] min_timeout_sec: 0.0 max_timeout_sec: inf
