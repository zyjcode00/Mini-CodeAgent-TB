[112.342521, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/test_compute_parallel.py <<'PY'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = 'from __future__ import annotations\\n\\nimport hashlib\\nimport importlib\\nimport json\\nimport shutil\\nfrom concurrent.futures import Future\\nfrom pathlib import Path\\n\\nimport compute_seq\\n\\nAPP = Path(\"/app\")\\nINPUT_DIR = APP / \"input\"\\nDATA_DIR = APP / \"data\" / \"blobs\"\\nOUT = APP / \"output\" / \"results.json\"\\n\\n\\ndef _reset_fixture() -> tuple[str, dict[str, bytes]]:\\n    shutil.rmtree(APP / \"input\", ignore_errors=True)\\n    shutil.rmtree(APP / \"data\", ignore_errors=True)\\n    shutil.rmtree(APP / \"output\", ignore_errors=True)\\n\\n    INPUT_DIR.mkdir(parents=True, exist_ok=True)\\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\\n    (DATA_DIR / \"nested\" / \"deeper\").mkdir(parents=True, exist_ok=True)\\n    (DATA_DIR / \"empty_dir\").mkdir(parents=True, exist_ok=True)\\n\\n    salt_hex = \"00112233445566778899aabbccddeeff\"\\n    (INPUT_DIR / \"salt.txt\").write_text(salt_hex + \"\\\\n\")\\n\\n    files = {\\n        \"alpha.bin\": b\"alpha data\",\\n        \"nested/beta.txt\": b\"beta data\" * 3,\\n        \"nested/deeper/gamma.dat\": b\"\\\\x00\\\\x01\\\\x02gamma\",\\n    }\\n    for rel, data in files.items():\\n        path = DATA_DIR / rel\\n        path.parent.mkdir(parents=True, exist_ok=True)\\n        path.write_bytes(data)\\n    return salt_hex, files\\n\\n\\ndef test_parallel_output_matches_reference_schema_and_values(monkeypatch):\\n    salt_hex, files = _reset_fixture()\\n    salt = bytes.fromhex(salt_hex)\\n    submitted: list[tuple[object, tuple[object, ...], dict[str, object]]] = []\\n\\n    class FakeExecutor:\\n        def __enter__(self):\\n            return self\\n\\n        def __exit__(self, exc_type, exc, tb):\\n            return False\\n\\n        def submit(self, fn, *args, **kwargs):\\n            submitted.append((fn, args, kwargs))\\n            future = Future()\\n            future.set_result(fn(*args, **kwargs))\\n            return future\\n\\n    compute_parallel = importlib.import_module(\"compute_parallel\")\\n    monkeypatch.setattr(compute_parallel, \"ProcessPoolExecutor\", FakeExecutor)\\n\\n    compute_parallel.main()\\n\\n    result = json.loads(OUT.read_text())\\n    assert set(result) == {\"salt_hex\", \"iterations\", \"files\"}\\n    assert result[\"salt_hex\"] == salt_hex\\n    assert result[\"iterations\"] == compute_seq.ITERATIONS\\n    assert len(submitted) == len(files)\\n    assert len(result[\"files\"]) == len(files)\\n\\n    expected_rows = []\\n    for rel, data in files.items():\\n        digest = hashlib.pbkdf2_hmac(\\n            \"sha256\", data, salt, compute_seq.ITERATIONS, dklen=32\\n        ).hex()\\n        expected_rows.append({\"path\": rel, \"pbkdf2\": digest})\\n    expected_rows.sort(key=lambda row: row[\"path\"])\\n\\n    assert result[\"files\"] == expected_rows\\n    assert [row[\"path\"] for row in result[\"files\"]] == sorted(files)\\n    assert all(len(row[\"pbkdf2\"]) == 64 for row in result[\"files\"])\\n\\n\\ndef test_source_uses_process_pool_and_imported_iterations():\\n    source = (APP / \"compute_parallel.py\").read_text()\\n    assert \"ProcessPoolExecutor\" in source\\n    assert \".submit(\" in source\\n    assert \"ThreadPoolExecutor\" not in source\\n    assert \"from compute_seq import\" in source and \"ITERATIONS\" in source\\n    assert \"ITERATIONS = 120_000\" not in source\\n    assert \"results.json\" not in source or \"compute_seq\" in source\\n'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, 'w', encoding='utf-8', newline='\\n') as f:\n        f.write(content)\n    print(f\"成功: 已写入 {path}\")\nexcept Exception as exc:\n    print(f\"写入失败: {exc}\")\nPY\ntrue; tmux wait -S done\r"]
