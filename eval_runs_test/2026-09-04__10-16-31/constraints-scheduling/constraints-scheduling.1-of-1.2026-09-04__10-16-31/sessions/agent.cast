[216.991535, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - <<'PY'\nfrom datetime import datetime, timedelta, time\nfrom pathlib import Path\nimport re\n\nfiles = {'alice': Path('/app/alice_calendar.ics'), 'bob': Path('/app/bob_calendar.ics'), 'carol': Path('/app/carol_calendar.ics')}\ncal = {}\nfor name, p in files.items():\n    text = p.read_text()\n    events = []\n    for block in re.findall(r'BEGIN:VEVENT\\n(.*?)\\nEND:VEVENT', text, flags=re.S):\n        s = re.search(r'DTSTART:(\\d{8}T\\d{6}Z)', block).group(1)\n        e = re.search(r'DTEND:(\\d{8}T\\d{6}Z)', block).group(1)\n        events.append((datetime.strptime(s, '%Y%m%dT%H%M%SZ'), datetime.strptime(e, '%Y%m%dT%H%M%SZ')))\n    cal[name] = events\n\ndef overlaps(a_start, a_end, b_start, b_end):\n    return a_start < b_end and b_start < a_end\n\ndef at(day, h, m=0):\n    return datetime.combine(day.date(), time(h, m))\n\ndef valid(start):\n    end = start + timedelta(hours=1)\n    if start.weekday() >= 5:\n        return False\n    # Business hours, Alice, Bob, Carol same-day windows\n    if not (at(start, 9) <= start and end <= at(start, 18)):\n        return False\n    if not (at(start, 9) <= start and end <= at(start, 14)):  # Alice hard constraint\n        return False\n    if start < at(start, 10):  # Bob hard constraint\n        return False\n    if start.weekday() in (1, 3) and end > at(start, 16, 30):\n        return False\n    if not (at(start, 9) <= start and end <= at(start, 17)):  # Carol hard constraint\n        return False\n    if overlaps(start, end, at(start, 12), at(start, 12, 30)):  # Carol lunch\n        return False\n    for evs in cal.values():\n        for s, e in evs:\n            if overlaps(start, end, s, e):\n                return False\n    return True\n\ncandidates = []\nt = datetime(2024, 1, 15, 9)\nend_scan = datetime(2024, 1, 19, 17)\nwhile t <= end_scan:\n    if valid(t):\n        candidates.append(t)\n    t += timedelta(minutes=1)\n\nif not candidates:\n    raise SystemExit('No valid candidates found')\nnon_monday = [c for c in candidates if c.weekday() != 0]\nmorning = [c for c in non_monday if time(9,0) <= c.time() and (c + timedelta(hours=1)).time() <= time(12,0)]\n# Carol's Monday avoidance first; Alice morning preference next among otherwise valid slots.\nchosen = morning[0] if morning else (non_monday[0] if non_monday else candidates[0])\nprint('Earliest chronological valid:', candidates[0].strftime('%Y-%m-%d %H:%M'), '-', (candidates[0] + timedelta(hours=1)).strftime('%H:%M'), candidates[0].strftime('%A'))\nprint('Earliest non-Monday valid:', non_monday[0].strftime('%Y-%m-%d %H:%M'), '-', (non_monday[0] + timedelta(hours=1)).strftime('%H:%M'), non_monday[0].strftime('%A'))\nprint('Earliest non-Monday morning valid:', morning[0].strftime('%Y-%m-%d %H:%M'), '-', (morning[0] + timedelta(hours=1)).strftime('%H:%M'), morning[0].strftime('%A'))\nprint('Chosen:', chosen.strftime('%Y%m%dT%H%M%SZ'), (chosen + timedelta(hours=1)).strftime('%Y%m%dT%H%M%SZ'))\nprint('First 20 candidates:')\nfor c in candidates[:20]:\n    print(c.strftime('%Y-%m-%d %H:%M'), c.strftime('%A'))\nPY\ntrue; tmux wait -S done\r"]
