[136.994749, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython - <<'PY'\nfrom datetime import datetime, timedelta\nfrom pathlib import Path\nimport re\n\nfiles = {\n    'alice': Path('/app/alice_calendar.ics'),\n    'bob': Path('/app/bob_calendar.ics'),\n    'carol': Path('/app/carol_calendar.ics'),\n}\ncal = {}\nfor name, p in files.items():\n    text=p.read_text()\n    ev=[]\n    for block in re.findall(r'BEGIN:VEVENT\\n(.*?)\\nEND:VEVENT', text, flags=re.S):\n        s=re.search(r'DTSTART:(\\d{8}T\\d{6}Z)', block).group(1)\n        e=re.search(r'DTEND:(\\d{8}T\\d{6}Z)', block).group(1)\n        ev.append((datetime.strptime(s,'%Y%m%dT%H%M%SZ'), datetime.strptime(e,'%Y%m%dT%H%M%SZ')))\n    cal[name]=ev\n\ndef overlaps(a,b,c,d): return a < d and c < b\n\ndef valid(start):\n    end=start+timedelta(hours=1)\n    # business hours and requested weekdays/range\n    if not (datetime(2024,1,15,9) <= start and end <= datetime(2024,1,19,18)):\n        return False\n    if start.weekday()>=5: return False\n    # Alice: no before 9, no after 2pm (meeting must end <=14:00)\n    if start.time() < datetime(2024,1,1,9).time() or end.time() > datetime(2024,1,1,14).time(): return False\n    # Bob: no before 10, Tue/Thu must leave by 16:30 (meeting end <=16:30)\n    if start.time() < datetime(2024,1,1,10).time(): return False\n    if start.weekday() in (1,3) and end.time() > datetime(2024,1,1,16,30).time(): return False\n    # Carol: available 9-5, lunch 12:00-12:30 unavailable, buffer after meetings ending >=16:45 irrelevant for 1h ending <=17 but enforce end <=17\n    if start.time() < datetime(2024,1,1,9).time() or end.time() > datetime(2024,1,1,17).time(): return False\n    lunch_s=start.replace(hour=12,minute=0,second=0)\n    lunch_e=start.replace(hour=12,minute=30,second=0)\n    if overlaps(start,end,lunch_s,lunch_e): return False\n    # existing conflicts\n    for evs in cal.values():\n        for s,e in evs:\n            if overlaps(start,end,s,e): return False\n    return True\n\ncandidates=[]\nt=datetime(2024,1,15,9)\nlast=datetime(2024,1,19,17)\nwhile t<=last:\n    if valid(t):\n        candidates.append(t)\n    t+=timedelta(minutes=1)\n\nprint('First chronological candidates:')\nfor c in candidates[:20]:\n    print(c.strftime('%Y-%m-%d %H:%M'), 'Monday' if c.weekday()==0 else c.strftime('%A'))\n\nnon_monday=[c for c in candidates if c.weekday()!=0]\nprint('Earliest chronological:', candidates[0], candidates[0]+timedelta(hours=1))\nprint('Earliest avoiding Monday:', non_monday[0], non_monday[0]+timedelta(hours=1))\nprint('Chosen per preference avoiding Monday among valid options:', non_monday[0].strftime('%Y%m%dT%H%M%SZ'), (non_monday[0]+timedelta(hours=1)).strftime('%Y%m%dT%H%M%SZ'))\nPY\ntrue; tmux wait -S done\r"]
