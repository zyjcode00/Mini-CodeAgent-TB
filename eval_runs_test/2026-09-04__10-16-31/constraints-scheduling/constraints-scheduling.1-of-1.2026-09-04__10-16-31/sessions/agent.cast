[161.903426, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - <<'PY'\nfrom datetime import datetime, timedelta\nfrom pathlib import Path\nimport re\n\nfiles = {\n    'alice': Path('/app/alice_calendar.ics'),\n    'bob': Path('/app/bob_calendar.ics'),\n    'carol': Path('/app/carol_calendar.ics'),\n}\ncal = {}\nfor name, p in files.items():\n    text=p.read_text()\n    ev=[]\n    for block in re.findall(r'BEGIN:VEVENT\\n(.*?)\\nEND:VEVENT', text, flags=re.S):\n        s=re.search(r'DTSTART:(\\d{8}T\\d{6}Z)', block).group(1)\n        e=re.search(r'DTEND:(\\d{8}T\\d{6}Z)', block).group(1)\n        ev.append((datetime.strptime(s,'%Y%m%dT%H%M%SZ'), datetime.strptime(e,'%Y%m%dT%H%M%SZ')))\n    cal[name]=ev\n\ndef overlaps(a,b,c,d):\n    return a < d and c < b\n\ndef valid(start):\n    end=start+timedelta(hours=1)\n    if not (datetime(2024,1,15,9) <= start and end <= datetime(2024,1,19,18)):\n        return False\n    if start.weekday()>=5:\n        return False\n    # Hard availability constraints\n    if start.hour < 9 or (end.hour, end.minute) > (14, 0): # Alice: no after 2 PM, no before 9 AM\n        return False\n    if start.hour < 10: # Bob: no meetings before 10 AM\n        return False\n    if start.weekday() in (1,3) and (end.hour, end.minute) > (16,30):\n        return False\n    if start.hour < 9 or (end.hour, end.minute) > (17,0): # Carol available 9-5\n        return False\n    lunch_s=start.replace(hour=12, minute=0, second=0, microsecond=0)\n    lunch_e=start.replace(hour=12, minute=30, second=0, microsecond=0)\n    if overlaps(start,end,lunch_s,lunch_e):\n        return False\n    for evs in cal.values():\n        for s,e in evs:\n            if overlaps(start,end,s,e):\n                return False\n    return True\n\ncandidates=[]\nt=datetime(2024,1,15,9)\nlast=datetime(2024,1,19,17)\nwhile t<=last:\n    if valid(t):\n        candidates.append(t)\n    t += timedelta(minutes=1)\n\nif not candidates:\n    raise SystemExit('No valid candidates found')\nnon_monday=[c for c in candidates if c.weekday()!=0]\nchosen = non_monday[0] if non_monday else candidates[0]\nprint('Earliest chronological:', candidates[0].strftime('%Y-%m-%d %H:%M'), '-', (candidates[0]+timedelta(hours=1)).strftime('%H:%M'), candidates[0].strftime('%A'))\nprint('Earliest avoiding Monday:', non_monday[0].strftime('%Y-%m-%d %H:%M'), '-', (non_monday[0]+timedelta(hours=1)).strftime('%H:%M'), non_monday[0].strftime('%A'))\nprint('Chosen:', chosen.strftime('%Y%m%dT%H%M%SZ'), (chosen+timedelta(hours=1)).strftime('%Y%m%dT%H%M%SZ'))\nprint('First few candidates:')\nfor c in candidates[:10]:\n    print(c.strftime('%Y-%m-%d %H:%M'), c.strftime('%A'))\nPY\ntrue; tmux wait -S done\r"]
