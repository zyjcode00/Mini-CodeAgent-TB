[234.058889, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/meeting_scheduled.ics <<'PY'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = 'BEGIN:VCALENDAR\\nVERSION:2.0\\nPRODID:-//Claude Code Lite//Team Planning Meeting//EN\\nCALSCALE:GREGORIAN\\nMETHOD:PUBLISH\\nBEGIN:VEVENT\\nUID:team-planning-20240117T110000Z@example.com\\nDTSTAMP:20240101T000000Z\\nDTSTART:20240117T110000Z\\nDTEND:20240117T120000Z\\nSUMMARY:Team Planning Meeting\\nDESCRIPTION:Scheduled team planning meeting for Alice, Bob, and Carol.\\nATTENDEE;CN=Alice;ROLE=REQ-PARTICIPANT:mailto:alice@example.com\\nATTENDEE;CN=Bob;ROLE=REQ-PARTICIPANT:mailto:bob@example.com\\nATTENDEE;CN=Carol;ROLE=REQ-PARTICIPANT:mailto:carol@example.com\\nEND:VEVENT\\nEND:VCALENDAR\\n'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, 'w', encoding='utf-8', newline='\\n') as f:\n        f.write(content)\n    print(f\"成功: 已写入 {path}\")\nexcept Exception as exc:\n    print(f\"写入失败: {exc}\")\nPY\ntrue; tmux wait -S done\r"]
[234.059332, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
