THOD:PUBLISH\n\nBEGIN:VEVENT\nUID:bob-001@example.com\nDTSTART:20240115T110000Z\nDTEND:20240115T120000Z\nSUMMARY:Late Morning Sync\nDESCRIPTION:Team synchronization\nLOCATION:Office\nEND:VEVENT\n\nBEGIN:VEVENT\nUID:bob-002@example.com\nDTSTART:20240115T130000Z\nDTEND:20240115T150000Z\nSUMMARY:Architecture Planning\nDESCRIPTION:System architecture review\nLOCATION:Dev Room\nEND:VEVENT\n\nBEGIN:VEVENT\nUID:bob-003@example.com\nDTSTART:20240116T130000Z\nDTEND:20240116T140000Z\nSUMMARY:Code Review\nDESCRIPTION:Weekly code review session\nLOCATION:Conference Room C\nEND:VEVENT\n\nBEGIN:VEVENT\nUID:bob-004@example.com\nDTSTART:20240117T120000Z\nDTEND:20240117T130000Z\nSUMMARY:Lunch Meeting\nDESCRIPTION:Business lunch with stakeholders\nLOCATION:Restaurant\nEND:VEVENT\n\nBEGIN:VEVENT\nUID:bob-005@example.com\nDTSTART:20240118T130000Z\nDTEND:20240118T140000Z\nSUMMARY:Sprint Planning\nDESCRIPTION:Agile sprint planning meeting\nLOCATION:Dev Room\nEND:VEVENT\n\nBEGIN:VEVENT\nUID:bob-006@example.com\nDTSTART:20240119T120000Z\nDTEND:20240119T130000Z\nSUMMARY:Client Demo\nDESCRIPTION:Demo new features to client\nLOCATION:Conference Room A\nEND:VEVENT\n\nEND:VCALENDAR\n"""\n\nCAROL_EXPECTED = """BEGIN:VCALENDAR\nVERSION:2.0\nPRODID:-//Terminal-Bench//Test Calendar//EN\nCALSCALE:GREGORIAN\nMETHOD:PUBLISH\n\nBEGIN:VEVENT\nUID:carol-001@example.com\nDTSTART:20240115T110000Z\nDTEND:20240115T120000Z\nSUMMARY:Marketing Review\nDESCRIPTION:Monthly marketing performance review\nLOCATION:Marketing Office\nEND:VEVENT\n\nBEGIN:VEVENT\nUID:carol-002@example.com\nDTSTART:20240116T110000Z\nDTEND:20240116T120000Z\nSUMMARY:Vendor Meeting\nDESCRIPTION:Meeting with new vendor proposals\nLOCATION:Conference Room D\nEND:VEVENT\n\nBEGIN:VEVENT\nUID:carol-003@example.com\nDTSTART:20240116T130000Z\nDTEND:20240116T140000Z\nSUMMARY:Budget Planning\nDESCRIPTION:Q1 budget planning session\nLOCATION:Finance Room\nEND:VEVENT\n\nBEGIN:VEVENT\nUID:carol-004@example.com\nDTSTART:20240117T120000Z\nDTEND:20240117T130000Z\nSUMMARY:Team 1:1s\nDESCRIPTION:Individual team member check-ins\nLOCATION:Office\nEND:VEVENT\n\nBEGIN:VEVENT\nUID:carol-005@example.com\nDTSTART:20240118T120000Z\nDTEND:20240118T130000Z\nSUMMARY:Strategy Session\nDESCRIPTION:Long-term strategy planning\nLOCATION:Executive Conference Room\nEND:VEVENT\n\nBEGIN:VEVENT\nUID:carol-006@example.com\nDTSTART:20240119T110000Z\nDTEND:20240119T120000Z\nSUMMARY:Performance Review\nDESCRIPTION:Quarterly performance reviews\nLOCATION:HR Office\nEND:VEVENT\n\nEND:VCALENDAR\n"""\n\nINPUTS = {\n    "/app/alice_calendar.ics": ALICE_EXPECTED,\n    "/app/bob_calendar.ics": BOB_EXPECTED,\n    "/app/carol_calendar.ics": CAROL_EXPECTED,\n}\n\n\ndef parse_events(text):\n    events = []\n    for block in re.findall(r"BEGIN:VEVENT\\n(.*?)\\nEND:VEVENT", text, flags=re.S):\n        start = re.search(r"DTSTART:(\\d{8}T\\d{6}Z)", block).group(1)\n        end = re.search(r"DTEND:(\\d{8}T\\d{6}Z)", block).group(1)\n        summary_match = re.search(r"SUMMARY:(.*)", block)\n        events.append({\n            "block": block,\n            "start": datetime.strptime(start, "%Y%m%dT%H%M%SZ"),\n            "end": datetime.strptime(end, "%Y%m%dT%H%M%SZ"),\n            "summary": summary_match.group(1).strip() if summary_match else "",\n        })\n    return events\n\n\ndef overlaps(a_start, a_end, b_start, b_end):\n    return a_start < b_end and b_start < a_end\n\n\ndef at(day, h, m=0):\n    return datetime.combine(day.date(), time(h, m))\n\n\ndef valid_slot(start, existing_events):\n    end = start + timedelta(hours=1)\n    if not (datetime(2024, 1, 15, 9) <= start and end <= datetime(2024, 1, 19, 18)):\n        return False\n    if start.weekday() >= 5:\n        return False\n    if not (at(start, 9) <= start and end <= at(start, 18)):\n        return False\n    if not (at(start, 9) <= start and end <= at(start, 14)):\n        return False  # Alice hard constraint\n    if start < at(start, 10):\n        return False  # Bob hard constraint\n    if start.weekday() in (1, 3) and end > at(start, 16, 30):\n        return False\n    if not (at(start, 9) <= start and end <= at(start, 17)):\n        return False  # Carol availability\n    if overlaps(start, end, at(start, 12), at(start, 12, 30)):\n        return False  # Carol lunch\n    return all(not overlaps(start, end, ev[0], ev[1]) for ev in existing_events)\n\n\ndef test_input_integrity():\n    for path, expected in INPUTS.items():\n        actual = Path(path).read_text()\n        assert actual == expected, f"Input calendar modified: {path}"\n\n\ndef test_output_ics_and_schedule():\n    out_path = Path("/app/meeting_scheduled.ics")\n    assert out_path.exists(), "meeting_scheduled.ics was not created"\n    text = out_path.read_text()\n    assert text.startswith("BEGIN:VCALENDAR\\n")\n    assert text.rstrip().endswith("END:VCALENDAR")\n    assert "VERSION:2.0" in text\n    assert "PRODID:" in text\n    assert text.count("BEGIN:VEVENT") == 1\n    assert text.count("END:VEVENT") == 1\n    assert "SUMMARY:Team Planning Meeting" in text\n    for attendee in ("alice@example.com", "bob@example.com", "carol@example.com"):\n        assert f"mailto:{attendee}" in text\n\n    meeting = parse_events(text)[0]\n    assert meeting["start"] == datetime(2024, 1, 17, 11, 0)\n    assert meeting["end"] == datetime(2024, 1, 17, 12, 0)\n    assert meeting["end"] - meeting["start"] == timedelta(hours=1)\n\n    existing = []\n    for expected in INPUTS.values():\n        existing.extend((ev["start"], ev["end"]) for ev in parse_events(expected))\n    assert valid_slot(meeting["start"], existing)\n\n    candidates = []\n    t = datetime(2024, 1, 15, 9)\n    while t <= datetime(2024, 1, 19, 17):\n        if valid_slot(t, existing):\n            candidates.append(t)\n        t += timedelta(minutes=1)\n    assert candidates, "Expected at least one valid slot"\n    assert candidates[0] == meeting["start"], f"Meeting is not earliest valid slot; earliest is {candidates[0]}"\n    assert meeting["start"].weekday() != 0, "Chosen meeting should avoid Monday when possible"\n\n\nif __name__ == "__main__":\n    test_input_integrity()\n    test_output_ics_and_schedule()\n    print("All meeting scheduling validation tests passed")\n'
