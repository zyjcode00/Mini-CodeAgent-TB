[47.032278, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\nset -euo pipefail\ncd /app/repo\nprintf 'PWD=%s\\n' \"$PWD\"\nprintf '\\n== git status ==\\n'\ngit status --short --branch\nprintf '\\n== refs ==\\n'\ngit show-ref || true\nprintf '\\n== reflog (all) ==\\n'\ngit reflog --all --date=iso || true\nprintf '\\n== reachable grep ==\\n'\ngit grep -n -E 'secret\\[[^]]+\\]' $(git rev-list --all) || true\nprintf '\\n== fsck unreachable ==\\n'\ngit fsck --full --unreachable --no-reflogs 2>/dev/null || true\nprintf '\\n== all object grep via cat-file batch ==\\n'\n# Search all loose/packed object contents for the secret pattern.\ngit cat-file --batch-all-objects --batch-check='%(objectname) %(objecttype)' | while read oid type; do\n  case \"$type\" in\n    blob|commit|tag|tree)\n      if git cat-file -p \"$oid\" 2>/dev/null | grep -aEo 'secret\\[[^]]+\\]' >/tmp/git_secret_match.$$ 2>/dev/null; then\n        printf '%s %s ' \"$oid\" \"$type\"\n        sort -u /tmp/git_secret_match.$$\n      fi\n      ;;\n  esac\ndone\nrm -f /tmp/git_secret_match.$$\ntrue; tmux wait -S done\r"]
