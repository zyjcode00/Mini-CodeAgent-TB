[71.455069, "o", "\u001b[?2004hroot@3e7e3595c1a0:/app/repo# "]
[147.030773, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\nset -euo pipefail\ncd /app/repo\nbefore=/tmp/repo_state_before.$$\nafter=/tmp/repo_state_after.$$\ntrap 'rm -f \"$before\" \"$after\"' EXIT\n{\n  printf 'HEAD=%s\\n' \"$(git rev-parse HEAD)\"\n  printf '\\n== log ==\\n'\n  git log --format='%H%x00%P%x00%an%x00%ae%x00%ad%x00%s' --date=iso --all\n  printf '\\n== tree ==\\n'\n  git ls-tree -r HEAD\n  printf '\\n== status ==\\n'\n  git status --short --branch\n} > \"$before\"\n\nprintf '== before secret search ==\\n'\ngit cat-file --batch-all-objects --batch-check='%(objectname) %(objecttype)' | while read oid type; do\n  if git cat-file -p \"$oid\" 2>/dev/null | grep -aE 'secret\\[[^]]+\\]' >/dev/null 2>&1; then\n    printf '%s %s\\n' \"$oid\" \"$type\"\n  fi\ndone || true\n\n# Remove reflog entries that keep rewritten-history commits discoverable, then\n# prune now-unreachable objects from the object database. This does not rewrite\n# reachable commits or change current working-tree content/commit messages.\ngit reflog expire --expire=now --expire-unreachable=now --all\ngit gc --prune=now --aggressive\n\n{\n  printf 'HEAD=%s\\n' \"$(git rev-parse HEAD)\"\n  printf '\\n== log ==\\n'\n  git log --format='%H%x00%P%x00%an%x00%ae%x00%ad%x00%s' --date=iso --all\n  printf '\\n== tree ==\\n'\n  git ls-tree -r HEAD\n  printf '\\n== status ==\\n'\n  git status --short --branch\n} > \"$after\"\n\nprintf '\\n== state comparison ==\\n'\nif cmp -s \"$before\" \"$after\"; then\n  printf 'OK: reachable HEAD/log/tree/status unchanged\\n'\nelse\n  printf 'ERROR: reachable repo state changed\\n' >&2\n  diff -u \"$before\" \"$after\" >&2 || true\n  exit 1\nfi\n\nprintf '\\n== object database secret verification ==\\n'\nfound=0\ngit cat-file --batch-all-objects --batch-check='%(objectname) %(objecttype)' | while read oid type; do\n  if git cat-file -p \"$oid\" 2>/dev/null | grep -aE 'secret\\[[^]]+\\]' >/dev/null 2>&1; then\n    printf 'FOUND %s %s\\n' \"$oid\" \"$type\"\n    found=1\n  fi\ndone > /tmp/repo_secret_object_scan.$$\ncat /tmp/repo_secret_object_scan.$$\nif [ -s /tmp/repo_secret_object_scan.$$ ]; then\n  rm -f /tmp/repo_secret_object_scan.$$\n  exit 1\nfi\nrm -f /tmp/repo_secret_object_scan.$$\nprintf 'OK: no secret pattern in any git object\\n'\n\nprintf '\\n== full repository secret verification ==\\n'\nif grep -R -a -n -E 'secret\\[[^]]+\\]' .; then\n  printf 'ERROR: secret pattern still found in /app/repo\\n' >&2\n  exit 1\nelse\n  printf 'OK: no secret pattern found anywhere under /app/repo\\n'\nfi\n\nprintf '\\n== fsck unreachable after cleanup ==\\n'\ngit fsck --full --unreachable --no-reflogs 2>/dev/null || true\ntrue; tmux wait -S done\r"]
