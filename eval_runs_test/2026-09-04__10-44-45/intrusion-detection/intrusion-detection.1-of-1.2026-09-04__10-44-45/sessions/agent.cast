[357.607724, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/response.sh <<'PY'\nimport sys\npath = sys.argv[1]\nold_str = 'block_rule=\"$RULE_DIR/block_${ip}.rule\"\\nreport=\"$REPORT_DIR/incident_${ip}_${timestamp}.txt\"\\nroot_report=\"$APP_DIR/incident_${ip}_${timestamp}.txt\"\\n\\ncat > \"$block_rule\" <<EOF_RULE\\n# Auto-generated incident response block rule\\n# IP: $ip\\n# Created: $timestamp\\niptables -A INPUT -s $ip -j DROP\\nEOF_RULE\\n\\npython3 - \"$ip\" \"$LOG_DIR/auth.log\" \"$LOG_DIR/http.log\" \"$block_rule\" \"$report\" <<\\'PY\\''\nnew_str = 'block_rule=\"$RULE_DIR/block_${ip}.rule\"\\nroot_block_rule=\"$APP_DIR/block_${ip}.rule\"\\nreport=\"$REPORT_DIR/incident_${ip}_${timestamp}.txt\"\\nroot_report=\"$APP_DIR/incident_${ip}_${timestamp}.txt\"\\n\\ncat > \"$block_rule\" <<EOF_RULE\\n# Auto-generated incident response block rule\\n# IP: $ip\\n# Created: $timestamp\\niptables -A INPUT -s $ip -j DROP\\nEOF_RULE\\ncp \"$block_rule\" \"$root_block_rule\"\\n\\npython3 - \"$ip\" \"$LOG_DIR/auth.log\" \"$LOG_DIR/http.log\" \"$block_rule\" \"$report\" <<\\'PY\\''"]
[357.607785, "i", "\n\ndef normalize_text(text: str) -> str:\n    text = text.replace('\\r\\n', '\\n').replace('\\r', '\\n')\n    return '\\n'.join(line.rstrip() for line in text.split('\\n'))\n\ntry:\n    with open(path, 'r', encoding='utf-8', errors='replace') as f:\n        content = f.read()\nexcept FileNotFoundError:\n    print(f\"错误: 找不到文件 {path}\")\n    raise SystemExit(0)\nexcept Exception as exc:\n    print(f\"修改失败: {exc}\")\n    raise SystemExit(0)\n\ncontent = normalize_text(content)\nold_str = normalize_text(old_str)\nnew_str = normalize_text(new_str)\ncount = content.count(old_str)\nif count == 0:\n    print(\"错误: 在文件中找不到 old_str。\\n建议：\\n1. 使用 read_file(raw_mode=True) 获取原始内容\\n2. 检查是否有多余的空格或换行符\\n3. 如果文件较大，考虑使用 write_full_file 全量覆盖\")\n    raise SystemExit(0)\nif count > 1:\n    print(f\"错误: 匹配到 {count} 处相同的代码，请提供更具体的 old_str 以确保唯一性。\")\n    raise SystemExit(0)\nwith open(path, 'w', enco"]
[357.607931, "i", "ding='utf-8', newline='\\n') as f:\n    f.write(content.replace(old_str, new_str))\nprint(f\"成功: 已更新 {path}。修改已持久化。\")\nPY\ntrue; tmux wait -S done\r"]
