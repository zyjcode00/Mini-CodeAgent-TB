[293.110058, "o", " test_response_generates_block_rule_and_incident_report(self):\\n        ip = \"45.32.67.89\"\\n        before = set(glob.glob(str(APP / \"reports\" / f\"incident_{ip}_*.txt\")))\\n        proc = subprocess.run(\\n            [str(APP / \"response.sh\"), ip],\\n            cwd=str(APP),\\n            check=True,\\n            text=True,\\n            stdout=subprocess.PIPE,\\n            stderr=subprocess.PIPE,\\n        )\\n        report_path = Path(proc.stdout.strip().splitlines()[-1])\\n        after = set(glob.glob(str(APP / \"reports\" / f\"incident_{ip}_*.txt\")))\\n\\n        self.assertTrue(report_path.exists(), f\"incident report does not exist: {report_path}\")\\n        self.assertIn(str(report_path), after)\\n        self.assertTrue(after - before or str(report_path) in after)\\n        self.assertRegex(report_path.name, rf\"^incident_{re.escape(ip)}_\\\\d{{8}}T\\\\d{{6}}Z\\\\.txt$\")\\n\\n        root_copy = APP / report_path.name\\n        self.assertTrue(root_copy.exists(), \"root-level incident report copy should exist for compatibili"]
[293.11014, "o", "ty\")\\n\\n        block_rule = APP / \"rules\" / f\"block_{ip}.rule\"\\n        self.assertTrue(block_rule.exists(), \"block rule should be generated\")\\n        block_text = block_rule.read_text()\\n        self.assertIn(f\"iptables -A INPUT -s {ip} -j DROP\", block_text)\\n\\n        report_text = report_path.read_text()\\n        self.assertIn(f\"IP: {ip}\", report_text)\\n        self.assertIn(\"Total matching log entries: 12\", report_text)\\n        self.assertIn(\"Failed password for root from 45.32.67.89\", report_text)\\n        self.assertIn(\\'45.32.67.89 - - [10/Apr/2023:08:32:15 +0000] \"GET /admin\\', report_text)\\n        self.assertNotIn(\"198.51.100.23\", report_text)\\n\\n\\nif __name__ == \"__main__\":\\n    unittest.main(verbosity=2)\\n'\r\n\u001b[?2004l\r\u001b[?2004h> dir_path = os.path.dirname(path)\r\n\u001b[?2004l\r\u001b[?2004h> if dir_path:\r\n\u001b[?2004l\r\u001b[?2004h"]
