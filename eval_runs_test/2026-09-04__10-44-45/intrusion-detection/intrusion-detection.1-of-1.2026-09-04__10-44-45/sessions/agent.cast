[3.053455, "i", "R}|g\" \\\n        -e \"s|https://security.debian.org/debian-security|${APT_SECURITY_MIRROR}|g\" \\\n        /etc/apt/sources.list.d/debian.sources\nfi\n\nmkdir -p /root/.config/uv\ncat > /root/.config/uv/uv.toml <<EOF\nindex-url = \"${UV_INDEX_URL}\"\nEOF\n\napt-get update || true\ntrue; tmux wait -S done\r"]
