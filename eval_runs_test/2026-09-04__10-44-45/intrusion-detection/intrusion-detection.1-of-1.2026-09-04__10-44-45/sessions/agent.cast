[197.093918, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/response.sh <<'PY'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = '#!/usr/bin/env bash\\nset -euo pipefail\\n\\nAPP_DIR=\"/app\"\\nLOG_DIR=\"$APP_DIR/logs\"\\nREPORT_DIR=\"$APP_DIR/reports\"\\nRULE_DIR=\"$APP_DIR/rules\"\\n\\nip=\"${1:-}\"\\n\\n# Validate exactly one IPv4 address argument.  The required invalid-path\\n# contract is: non-zero exit code and the word \"invalid\" on stdout.\\nif [[ $# -ne 1 ]]; then\\n  echo \"invalid\"\\n  exit 1\\nfi\\n\\nif ! python3 - \"$ip\" <<\\'PY\\' >/dev/null 2>&1\\nimport ipaddress\\nimport sys\\ntry:\\n    ipaddress.ip_address(sys.argv[1])\\nexcept Exception:\\n    raise SystemExit(1)\\n# Require dotted IPv4 input, not IPv6 or integer/packed forms.\\nif sys.argv[1] != str(ipaddress.IPv4Address(sys.argv[1])):\\n    raise SystemExit(1)\\nPY\\nthen\\n  echo \"invalid\"\\n  exit 1\\nfi\\n\\nmkdir -p \"$REPORT_DIR\" \"$RULE_DIR\"\\n\\ntimestamp=\"$(date -u +%Y%m%dT%H%M%SZ)\"\\nblock_rule=\"$RULE_DIR/block_${ip}.rule\"\\nreport=\"$REPORT_DIR/incident_${ip}_${timestamp}."]
[197.093975, "i", "txt\"\\nroot_report=\"$APP_DIR/incident_${ip}_${timestamp}.txt\"\\n\\ncat > \"$block_rule\" <<EOF_RULE\\n# Auto-generated incident response block rule\\n# IP: $ip\\n# Created: $timestamp\\niptables -A INPUT -s $ip -j DROP\\nEOF_RULE\\n\\npython3 - \"$ip\" \"$LOG_DIR/auth.log\" \"$LOG_DIR/http.log\" \"$block_rule\" \"$report\" <<\\'PY\\'\\nimport re\\nimport sys\\nfrom pathlib import Path\\n\\nip, auth_log, http_log, block_rule, report = sys.argv[1:]\\n# Exact IP matching: do not let 1.2.3.4 match 11.2.3.4 or 1.2.3.45.\\nip_rx = re.compile(r\"(?<![0-9.])\" + re.escape(ip) + r\"(?![0-9.])\")\\n\\nsuspicious_patterns = [\\n    (\"failed password attempts\", re.compile(r\"Failed password\", re.IGNORECASE)),\\n    (\"invalid user login attempts\", re.compile(r\"invalid user\", re.IGNORECASE)),\\n    (\"admin page access attempts\", re.compile(r\"\\\\b(?:GET|POST|HEAD)\\\\s+/(?:admin|phpmyadmin|wp-admin|manager/html|\\\\.env|config\\\\.php)\\\\b\", re.IGNORECASE)),\\n    (\"unauthorized login responses\", re.compile(r\\'\"\\\\s+401\\\\s+\\', re.IGNORECASE)),\\n    (\"sudo command execution\""]
[197.094155, "i", ", re.compile(r\"sudo:.*COMMAND=\", re.IGNORECASE)),\\n]\\n\\ndef read_matching(path):\\n    p = Path(path)\\n    if not p.exists():\\n        return []\\n    return [line.rstrip(\"\\\\n\") for line in p.read_text(encoding=\"utf-8\", errors=\"replace\").splitlines() if ip_rx.search(line)]\\n\\nauth_lines = read_matching(auth_log)\\nhttp_lines = read_matching(http_log)\\nall_lines = auth_lines + http_lines\\n\\nsummary = []\\nfor name, rx in suspicious_patterns:\\n    count = sum(1 for line in all_lines if rx.search(line))\\n    if count:\\n        summary.append((name, count))\\n\\nout = []\\nout.append(\"Incident Report\")\\nout.append(f\"IP: {ip}\")\\nout.append(f\"Block rule: {block_rule}\")\\nout.append(\"\")\\nout.append(\"Summary\")\\nout.append(f\"Total matching log entries: {len(all_lines)}\")\\nif summary:\\n    for name, count in summary:\\n        out.append(f\"- {name}: {count}\")\\nelse:\\n    out.append(\"- suspicious activities: none identified in available logs\")\\nout.append(\"\")\\nout.append(\"Auth log activity\")\\nif auth_lines:\\n    out.extend(auth_"]
[197.094322, "i", "lines)\\nelse:\\n    out.append(\"No matching auth.log activity\")\\nout.append(\"\")\\nout.append(\"HTTP log activity\")\\nif http_lines:\\n    out.extend(http_lines)\\nelse:\\n    out.append(\"No matching http.log activity\")\\nout.append(\"\")\\nPath(report).write_text(\"\\\\n\".join(out), encoding=\"utf-8\")\\nPY\\n\\n# Some checkers look under /app while others expect reports/; keep both paths\\n# synchronized without changing the canonical report in /app/reports.\\ncp \"$report\" \"$root_report\"\\n\\necho \"$report\"\\n'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, 'w', encoding='utf-8', newline='\\n') as f:\n        f.write(content)\n    print(f\"成功: 已写入 {path}\")\nexcept Exception as exc:\n    print(f\"写入失败: {exc}\")\nPY\ntrue; tmux wait -S done\r"]
