[210.504742, "o", "#!/usr/bin/env bash\r\nset -euo pipefail\r\n\r\nAPP_DIR=\"/app\"\r\nLOG_DIR=\"$APP_DIR/logs\"\r\nRULE_FILE=\"$APP_DIR/rules/detection_rules.json\"\r\nALERT_FILE=\"$APP_DIR/alert.json\"\r\nREPORT_FILE=\"$APP_DIR/report.json\"\r\n\r\nif [[ ! -f \"$RULE_FILE\" ]]; then\r\n  echo \"missing rules file: $RULE_FILE\" >&2\r\n  exit 1\r\nfi\r\n\r\npython3 - \"$RULE_FILE\" \"$LOG_DIR/auth.log\" \"$LOG_DIR/http.log\" \"$ALERT_FILE\" \"$REPORT_FILE\" <<'PY'\r\nimport json\r\nimport re\r\nimport sys\r\nfrom datetime import datetime, timezone\r\nfrom pathlib import Path\r\n\r\nrule_file, auth_log, http_log, alert_file, report_file = sys.argv[1:]\r\n\r\nIP_RE = re.compile(r\"(?<!\\d)(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)(?:\\.(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)){3}(?!\\d)\")\r\n\r\ndef read_lines(path):\r\n    p = Path(path)\r\n    if not p.exists():\r\n        return []\r\n    return p.read_text(encoding=\"utf-8\", errors=\"replace\").splitlines()\r\n\r\nwith open(rule_file, \"r\", encoding=\"utf-8\") as f:\r\n    rules_doc = json.load(f)\r\n\r\nall_lines = read_lines(auth_log) + read_lines(http_log)\r\nalerts = []\r\nstatistics = {"]
[210.504937, "o", "}\r\n\r\nfor rule in rules_doc.get(\"rules\", []):\r\n    rule_id = str(rule.get(\"id\", \"\"))\r\n    severity = str(rule.get(\"severity\", \"\"))\r\n    pattern = str(rule.get(\"pattern\", \"\"))\r\n    threshold = int(rule.get(\"threshold\", 1) or 1)\r\n    try:\r\n        rx = re.compile(pattern, re.IGNORECASE)\r\n    except re.error:\r\n        rx = re.compile(re.escape(pattern), re.IGNORECASE)\r\n\r\n    matching_lines = [line for line in all_lines if rx.search(line)]\r\n    matches = len(matching_lines)\r\n    if matches >= threshold:\r\n        ips = sorted({ip for line in matching_lines for ip in IP_RE.findall(line)}, key=lambda x: tuple(int(part) for part in x.split('.')))\r\n        item = {\r\n            \"id\": rule_id,\r\n            \"severity\": severity,\r\n            \"matches\": matches,\r\n            \"ips\": \",\".join(ips),\r\n        }\r\n        alerts.append(item)\r\n        statistics[rule_id] = matches\r\n\r\nnow = datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace(\"+00:00\", \"Z\")\r\nalert_doc = {\"timestamp\": now, \"alerts\": alerts}\r\nrepor"]
[210.505023, "o", "t_doc = {\"timestamp\": now, \"events\": alerts, \"statistics\": statistics}\r\n\r\nfor out_path, doc in ((alert_file, alert_doc), (report_file, report_doc)):\r\n    Path(out_path).write_text(json.dumps(doc, indent=2) + \"\\n\", encoding=\"utf-8\")\r\nPY\r\n\u001b[?2004hroot@8fdd19030aed:/app# "]
