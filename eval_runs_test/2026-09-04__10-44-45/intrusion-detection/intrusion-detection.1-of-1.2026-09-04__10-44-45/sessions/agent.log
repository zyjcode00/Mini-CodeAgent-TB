import json
import re
import sys
from datetime import datetime, timezone
from pathlib import Path

rule_file, auth_log, http_log, alert_file, report_file = sys.argv[1:]

IP_RE = re.compile(r"(?<!\d)(?:25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)(?:\.(?:25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)){3}(?!\d)")

def read_lines(path):
    p = Path(path)
    if not p.exists():
        return []
    return p.read_text(encoding="utf-8", errors="replace").splitlines()

with open(rule_file, "r", encoding="utf-8") as f:
    rules_doc = json.load(f)

all_lines = read_lines(auth_log) + read_lines(http_log)
alerts = []
statistics = {}

for rule in rules_doc.get("rules", []):
    rule_id = str(rule.get("id", ""))
    severity = str(rule.get("severity", ""))
    pattern = str(rule.get("pattern", ""))
    threshold = int(rule.get("threshold", 1) or 1)
    try:
        rx = re.compile(pattern, re.IGNORECASE)
    except re.error:
        rx = re.compile(re.escape(pattern), re.IGNORECASE)

    matching_lines = [line for line in all_lines if rx.search(line)]
    matches = len(matching_lines)
    if matches >= threshold:
        ips = sorted({ip for line in matching_lines for ip in IP_RE.findall(line)}, key=lambda x: tuple(int(part) for part in x.split('.')))
        item = {
            "id": rule_id,
            "severity": severity,
            "matches": matches,
            "ips": ",".join(ips),
        }
        alerts.append(item)
        statistics[rule_id] = matches

now = datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
alert_doc = {"timestamp": now, "alerts": alerts}
report_doc = {"timestamp": now, "events": alerts, "statistics": statistics}

for out_path, doc in ((alert_file, alert_doc), (report_file, report_doc)):
    Path(out_path).write_text(json.dumps(doc, indent=2) + "\n", encoding="utf-8")
PY
