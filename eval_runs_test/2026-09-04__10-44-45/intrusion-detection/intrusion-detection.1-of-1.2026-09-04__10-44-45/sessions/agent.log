[?2004l[?2004h> content = '#!/usr/bin/env python3\nimport glob\nimport json\nimport os\nimport re\nimport subprocess\nimport unittest\nfrom pathlib import Path\n\nAPP = Path("/app")\n\n\nclass IntrusionSystemTests(unittest.TestCase):\n    def test_detector_generates_valid_json_outputs(self):\n        subprocess.run([str(APP / "intrusion_detector.sh")], check=True, cwd=str(APP))\n\n        alert_path = APP / "alert.json"\n        report_path = APP / "report.json"\n        self.assertTrue(alert_path.exists(), "alert.json should be created")\n        self.assertTrue(report_path.exists(), "report.json should be created")\n\n        alert = json.loads(alert_path.read_text())\n        report = json.loads(report_path.read_text())\n\n        self.assertIn("timestamp", alert)\n        self.assertIn("alerts", alert)\n        self.assertIsInstance(alert["alerts"], list)\n        self.assertIn("events", report)\n        self.assertIn("statistics", report)\n\n        by_id = {item["id"]: item for item in alert["alerts"]}\n        for expected in ["SSH-BRUTE-FORCE", "WEB-SCAN", "INVALID-USER", "SUDO-COMMAND"]:\n            self.assertIn(expected, by_id)\n            self.assertIn(expected, report["statistics"])\n            self.assertGreaterEqual(by_id[expected]["matches"], 1)\n            self.assertIn("severity", by_id[expected])\n            self.assertIn("ips", by_id[expected])\n\n        self.assertIn("45.32.67.89", by_id["SSH-BRUTE-FORCE"]["ips"])\n        self.assertIn("45.32.67.89", by_id["WEB-SCAN"]["ips"])\n        self.assertIn("198.51.100.23", by_id["INVALID-USER"]["ips"])\n\n    def test_response_rejects_invalid_ip_with_required_contract(self):\n        proc = subprocess.run(\n            [str(APP / "response.sh"), "999.1.2.3"],\n            cwd=str(APP),\n            text=True,\n            stdout=subprocess.PIPE,\n            stderr=subprocess.PIPE,\n        )\n        self.assertNotEqual(proc.returncode, 0)\n        self.assertEqual(proc.stdout.strip(), "invalid")\n        self.assertNotIn("Traceback", proc.stderr)\n\n    def test_response_generates_block_rule_and_incident_report(self):\n        ip = "45.32.67.89"\n        before = set(glob.glob(str(APP / "reports" / f"incident_{ip}_*.txt")))\n        proc = subprocess.run(\n            [str(APP / "response.sh"), ip],\n            cwd=str(APP),\n            check=True,\n            text=True,\n            stdout=subprocess.PIPE,\n            stderr=subprocess.PIPE,\n        )\n        report_path = Path(proc.stdout.strip().splitlines()[-1])\n        after = set(glob.glob(str(APP / "reports" / f"incident_{ip}_*.txt")))\n\n        self.assertTrue(report_path.exists(), f"incident report does not exist: {report_path}")\n        self.assertIn(str(report_path), after)\n        self.assertTrue(after - before or str(report_path) in after)\n        self.assertRegex(report_path.name, rf"^incident_{re.escape(ip)}_\\d{{8}}T\\d{{6}}Z\\.txt$")\n\n        root_copy = APP / report_path.name\n        self.assertTrue(root_copy.exists(), "root-level incident report copy should exist for compatibility")\n\n        block_rule = APP / "rules" / f"block_{ip}.rule"\n        self.assertTrue(block_rule.exists(), "block rule should be generated")\n        block_text = block_rule.read_text()\n        self.assertIn(f"iptables -A INPUT -s {ip} -j DROP", block_text)\n\n        report_text = report_path.read_text()\n        self.assertIn(f"IP: {ip}", report_text)\n        self.assertIn("Total matching log entries: 12", report_text)\n        self.assertIn("Failed password for root from 45.32.67.89", report_text)\n        self.assertIn(\'45.32.67.89 - - [10/Apr/2023:08:32:15 +0000] "GET /admin\', report_text)\n        self.assertNotIn("198.51.100.23", report_text)\n\n\nif __name__ == "__main__":\n    unittest.main(verbosity=2)\n'
