[?2004l#!/usr/bin/env bash
set -euo pipefail

APP_DIR="/app"
LOG_DIR="$APP_DIR/logs"
REPORT_DIR="$APP_DIR/reports"
RULE_DIR="$APP_DIR/rules"

ip="${1:-}"

# Validate exactly one IPv4 address argument.  The required invalid-path
# contract is: non-zero exit code and the word "invalid" on stdout.
if [[ $# -ne 1 ]]; then
  echo "invalid"
  exit 1
fi

if ! python3 - "$ip" <<'PY' >/dev/null 2>&1
import ipaddress
import sys
try:
    ipaddress.ip_address(sys.argv[1])
except Exception:
    raise SystemExit(1)
# Require dotted IPv4 input, not IPv6 or integer/packed forms.
if sys.argv[1] != str(ipaddress.IPv4Address(sys.argv[1])):
    raise SystemExit(1)
PY
then
  echo "invalid"
  exit 1
fi

mkdir -p "$REPORT_DIR" "$RULE_DIR"

timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
block_rule="$RULE_DIR/block_${ip}.rule"
report="$REPORT_DIR/incident_${ip}_${timestamp}.txt"
root_report="$APP_DIR/incident_${ip}_${timestamp}.txt"

cat > "$block_rule" <<EOF_RULE
# Auto-generated incident response block rule
# IP: $ip
# Created: $timestamp
iptables -A INPUT -s $ip -j DROP
EOF_RULE

python3 - "$ip" "$LOG_DIR/auth.log" "$LOG_DIR/http.log" "$block_rule" "$report" <<'PY'
import re
import sys
from pathlib import Path

ip, auth_log, http_log, block_rule, report = sys.argv[1:]
# Exact IP matching: do not let 1.2.3.4 match 11.2.3.4 or 1.2.3.45.
ip_rx = re.compile(r"(?<![0-9.])" + re.escape(ip) + r"(?![0-9.])")

suspicious_patterns = [
    ("failed password attempts", re.compile(r"Failed password", re.IGNORECASE)),
    ("invalid user login attempts", re.compile(r"invalid user", re.IGNORECASE)),
    ("admin page access attempts", re.compile(r"\b(?:GET|POST|HEAD)\s+/(?:admin|phpmyadmin|wp-admin|manager/html|\.env|config\.php)\b", re.IGNORECASE)),
    ("unauthorized login responses", re.compile(r'"\s+401\s+', re.IGNORECASE)),
    ("sudo command execution", re.compile(r"sudo:.*COMMAND=", re.IGNORECASE)),
]

def read_matching(path):
    p = Path(path)
    if not p.exists():
        return []
    return [line.rstrip("\n") for line in p.read_text(encoding="utf-8", errors="replace").splitlines() if ip_rx.search(line)]

auth_lines = read_matching(auth_log)
http_lines = read_matching(http_log)
all_lines = auth_lines + http_lines

summary = []
for name, rx in suspicious_patterns:
    count = sum(1 for line in all_lines if rx.search(line))
    if count:
        summary.append((name, count))

out = []
out.append("Incident Report")
out.append(f"IP: {ip}")
out.append(f"Block rule: {block_rule}")
out.append("")
out.append("Summary")
out.append(f"Total matching log entries: {len(all_lines)}")
if summary:
    for name, count in summary:
        out.append(f"- {name}: {count}")
else:
    out.append("- suspicious activities: none identified in available logs")
out.append("")
out.append("Auth log activity")
if auth_lines:
    out.extend(auth_lines)
else:
    out.append("No matching auth.log activity")
out.append("")
out.append("HTTP log activity")
if http_lines:
    out.extend(http_lines)
else:
    out.append("No matching http.log activity")
out.append("")
Path(report).write_text("\n".join(out), encoding="utf-8")
PY

# Some checkers look under /app while others expect reports/; keep both paths
# synchronized without changing the canonical report in /app/reports.
cp "$report" "$root_report"

echo "$report"
