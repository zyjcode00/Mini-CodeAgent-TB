set -euo pipefail

APP_DIR="/app"
LOG_DIR="$APP_DIR/logs"
RULE_FILE="$APP_DIR/rules/detection_rules.json"
ALERT_FILE="$APP_DIR/alert.json"
REPORT_FILE="$APP_DIR/report.json"

