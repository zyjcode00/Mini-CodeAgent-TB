"severity": severity,\\n            "matches": matches,\\n            "ips": ",".join(ips),\\n        }\\n        alerts.append(item)\\n        statistics[rule_id] = matches\\n\\nnow = datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")\\nalert_doc = {"timestamp": now, "alerts": alerts}\\nreport_doc = {"timestamp": now, "events": alerts, "statistics": statistics}\\n\\nfor out_path, doc in ((alert_file, alert_doc), (report_file, report_doc)):\\n    Path(out_path).write_text(json.dumps(doc, indent=2) + "\\\\n", encoding="utf-8")\\nPY\\n\'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, \'w\', encoding=\'utf-8\', newline=\'\\n\') as f:\n        f.write(content)\n    print(f"成功: 已写入 {path}")\nexcept Exception as exc:\n    print(f"写入失败: {exc}")\nPY\ntrue', '; tmux wait -S done', 'Enter'] min_timeout_sec: 0.0 max_timeout_sec: inf
