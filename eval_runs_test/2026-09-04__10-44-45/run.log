\\\\.php)\\\\b", re.IGNORECASE)),\\n    ("unauthorized login responses", re.compile(r\\\'"\\\\s+401\\\\s+\\\', re.IGNORECASE)),\\n    ("sudo command execution", re.compile(r"sudo:.*COMMAND=", re.IGNORECASE)),\\n]\\n\\ndef read_matching(path):\\n    p = Path(path)\\n    if not p.exists():\\n        return []\\n    return [line.rstrip("\\\\n") for line in p.read_text(encoding="utf-8", errors="replace").splitlines() if ip_rx.search(line)]\\n\\nauth_lines = read_matching(auth_log)\\nhttp_lines = read_matching(http_log)\\nall_lines = auth_lines + http_lines\\n\\nsummary = []\\nfor name, rx in suspicious_patterns:\\n    count = sum(1 for line in all_lines if rx.search(line))\\n    if count:\\n        summary.append((name, count))\\n\\nout = []\\nout.append("Incident Report")\\nout.append(f"IP: {ip}")\\nout.append(f"Block rule: {block_rule}")\\nout.append("")\\nout.append("Summary")\\nout.append(f"Total matching log entries: {len(all_lines)}")\\nif summary:\\n    for name, count in summary:\\n        out.append(f"- {name}: {count}")\\nelse:\\n    out.append("- suspicious activities: none identified in available logs")\\nout.append("")\\nout.append("Auth log activity")\\nif auth_lines:\\n    out.extend(auth_lines)\\nelse:\\n    out.append("No matching auth.log activity")\\nout.append("")\\nout.append("HTTP log activity")\\nif http_lines:\\n    out.extend(http_lines)\\nelse:\\n    out.append("No matching http.log activity")\\nout.append("")\\nPath(report).write_text("\\\\n".join(out), encoding="utf-8")\\nPY\\n\\n# Some checkers look under /app while others expect reports/; keep both paths\\n# synchronized without changing the canonical report in /app/reports.\\ncp "$report" "$root_report"\\n\\necho "$report"\\n\'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, \'w\', encoding=\'utf-8\', newline=\'\\n\') as f:\n        f.write(content)\n    print(f"成功: 已写入 {path}")\nexcept Exception as exc:\n    print(f"写入失败