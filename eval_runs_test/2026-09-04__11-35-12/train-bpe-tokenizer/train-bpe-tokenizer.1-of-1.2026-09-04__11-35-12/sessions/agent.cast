[224.562674, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/train_bpe.py <<'PY'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = '#!/usr/bin/env python3\\n\"\"\"Deterministic BPE trainer for the provided /app/tokenize.py implementation.\\n\\nTraining constraints implemented here:\\n- reads only document paths listed in /app/eng_docs.txt;\\n- uses tokenize.py-compatible initial word symbols, where the last character of\\n  each whitespace-delimited word is suffixed with <|eow|>;\\n- repeatedly merges the most frequent adjacent pair, breaking ties by\\n  alphabetical order of the pair tuple;\\n- stops when the vocabulary reaches 1000 tokens or no mergeable pairs remain.\\n\"\"\"\\n\\nfrom __future__ import annotations\\n\\nfrom collections import Counter, defaultdict\\nfrom pathlib import Path\\n\\nEND = \"<|eow|>\"\\nVOCAB_LIMIT = 1000\\nAPP = Path(\"/app\")\\nENG_DOCS = APP / \"eng_docs.txt\"\\nTOKENS_OUT = APP / \"tokens.txt\"\\nMERGES_OUT = APP / \"merges.txt\"\\n\\n\\ndef word_to_symbols(word: str) -> tuple[str, ...]:\\n    \"\"\"Match /app/tokenize.py\\'s initial symbolization in BPE.encode_word.\"\"\"\\n    if not word:\\n        return ()\\n    chars = list(word)\\n    chars[-1] = chars[-1] + END\\n    return tuple(chars)\\n\\n\\ndef load_training_words() -> Counter[tuple[str, ...]]:\\n    word_counts: Counter[tuple[str, ...]] = Counter()\\n    for raw_path in ENG_DOCS.read_text(encoding=\"utf-8\").splitlines():\\n        path = raw_path.strip()\\n        if not path:\\n            continue\\n        p = Path(path)\\n        text = p.read_text(encoding=\"utf-8\")\\n        for word in text.strip().split():\\n            symbols = word_to_symbols(word)\\n            if symbols:\\n                word_counts[symbols] += 1\\n    return word_counts\\n\\n\\ndef collect_vocab(word_counts: Counter[tuple[str, ...]]) -> set[str]:\\n    vocab: set[str] = set()\\n    for symbols in word_counts:\\n        vocab.update(symbols)\\n    return vocab\\n\\n\\ndef pair_frequencies(word_counts: Counter[tuple[str, ...]]) -> Counter[tuple[str, str]]:\\n    freqs: Counter[tuple[str, str]] = Counter()\\n    for symbols, count in word_counts.items():\\n        for i in range(len(symbols) - 1):\\n            freqs[(symbols[i], symbols[i + 1])] += count\\n    return freqs\\n\\n\\ndef merge_pair_in_symbols(symbols: tuple[str, ...], pair: tuple[str, str]) -> tuple[str, ...]:\\n    merged: list[str] = []\\n    i = 0\\n    while i < len(symbols):\\n        if i < len(symbols) - 1 and symbols[i] == pair[0] and symbols[i + 1] == pair[1]:\\n            merged.append(pair[0] + pair[1])\\n            i += 2\\n        else:\\n            merged.append(symbols[i])\\n            i += 1\\n    return tuple(merged)\\n\\n\\ndef apply_merge(\\n    word_counts: Counter[tuple[str, ...]], pair: tuple[str, str]\\n) -> Counter[tuple[str, ...]]:\\n    updated: defaultdict[tuple[str, ...], int] = defaultdict(int)\\n    for symbols, count in word_counts.items():\\n        updated[merge_pair_in_symbols(symbols, pair)] += count\\n    return Counter(updated)\\n\\n\\ndef train() -> tuple[list[str], list[tuple[str, str]]]:\\n    word_counts = load_training_words()\\n    vocab = collect_vocab(word_counts)\\n    merges: list[tuple[str, str]] = []\\n    learned_tokens: list[str] = []\\n\\n    while len(vocab) < VOCAB_LIMIT:\\n        freqs = pair_frequencies(word_counts)\\n        if not freqs:\\n            break\\n        max_freq = max(freqs.values())\\n        best_pair = min(pair for pair, freq in freqs.items() if freq == max_freq)\\n        new_token = best_pair[0] + best_pair[1]\\n\\n        merges.append(best_pair)\\n        word_counts = apply_merge(word_counts, best_pair)\\n        if new_token not in vocab:\\n            vocab.add(new_token)\\n            learned_tokens.append(new_token)\\n\\n    # Stable vocabulary file: base symbols alphabetically, then learned merge tokens.\\n    base_tokens = sorted(collect_vocab(load_training_words()))\\n    tokens = base_tokens + [tok for tok in learned_tokens if tok not in set(base_tokens)]\\n    # Defensive trim in the unlikely event of duplicate/collision accounting surprises.\\n    tokens = tokens[:VOCAB_LIMIT]\\n    return tokens, merges\\n\\n\\nd"]
[224.563193, "i", "ef write_outputs(tokens: list[str], merges: list[tuple[str, str]]) -> None:\\n    TOKENS_OUT.write_text(\"\\\\n\".join(tokens) + \"\\\\n\", encoding=\"utf-8\")\\n    MERGES_OUT.write_text(\"\\\\n\".join(f\"{a} {b}\" for a, b in merges) + \"\\\\n\", encoding=\"utf-8\")\\n\\n\\ndef main() -> None:\\n    tokens, merges = train()\\n    write_outputs(tokens, merges)\\n    print(f\"wrote {len(tokens)} tokens to {TOKENS_OUT}\")\\n    print(f\"wrote {len(merges)} merges to {MERGES_OUT}\")\\n\\n\\nif __name__ == \"__main__\":\\n    main()\\n'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, 'w', encoding='utf-8', newline='\\n') as f:\n        f.write(content)\n    print(f\"成功: 已写入 {path}\")\nexcept Exception as exc:\n    print(f\"写入失败: {exc}\")\nPY\ntrue; tmux wait -S done\r"]
