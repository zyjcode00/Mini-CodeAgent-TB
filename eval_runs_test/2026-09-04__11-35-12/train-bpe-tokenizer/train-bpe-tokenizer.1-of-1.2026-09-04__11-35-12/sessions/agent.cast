[43.323735, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\nfor f in /app/eng_docs.txt /app/tokens.txt /app/merges.txt tokens.txt merges.txt; do if [ -f \"$f\" ]; then echo '---' \"$f\"; wc -l \"$f\"; sed -n '1,20p' \"$f\"; fi; done\ntrue; tmux wait -S done\r"]
