[147.726186, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/test_solution.py <<'PY'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = \"from rdflib import Graph\\n\\n\\ndef test_solution_query_returns_professors_and_universities():\\n    graph = Graph()\\n    graph.parse('/app/university_graph.ttl', format='turtle')\\n\\n    with open('/app/solution.sparql', encoding='utf-8') as f:\\n        query = f.read()\\n\\n    rows = {(str(row.professorName), str(row.universityName)) for row in graph.query(query)}\\n\\n    expected = {\\n        ('Orfeas Menis', 'National Technical University of Athens'),\\n        ('Athanasios Voulodimos', 'National Technical University of Athens'),\\n        ('Pepe Attanasio', 'Instituto Superior Técnico'),\\n        ('Aristotle Tympas', 'National and Kapodistrian University of Athens'),\\n        ('John Smith', 'Massachusetts Institute of Technology'),\\n        ('Marie Dubois', 'Sorbonne University'),\\n        ('Stefan Mueller', 'Ludwig Maximilian University of Munich'),\\n    }\\n\\n    assert rows == expected\\n\"\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, 'w', encoding='utf-8', newline='\\n') as f:\n        f.write(content)\n    print(f\"成功: 已写入 {path}\")\nexcept Exception as exc:\n    print(f\"写入失败: {exc}\")\nPY\ntrue; tmux wait -S done\r"]
[147.726638, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
