[185.209638, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - <<'PY'\nfrom pathlib import Path\n\nquery_path = Path('/app/solution.sparql')\nttl_path = Path('/app/university_graph.ttl')\nquery = query_path.read_text(encoding='utf-8')\nttl = ttl_path.read_text(encoding='utf-8')\n\nassert 'SELECT ?professorName ?universityName' in query\nassert 'uni:role ?role' in query\nassert 'Professor' in query\nassert 'uni:worksAt ?department' in query\nassert 'uni:partOfUniversity ?university' in query\nassert 'uni:hasName ?universityName' in query\nassert '?professorName' in query and '?universityName' in query\n\n# Sanity-check the graph structure used by the query exists in the Turtle data.\nassert 'uni:role \"Assistant Professor of Computer Science\"' in ttl\nassert 'uni:role \"Professor of Computer Science\"' in ttl\nassert 'uni:worksAt uni:ComputerScience_NTUA' in ttl\nassert 'uni:ComputerScience_NTUA a uni:Department' in ttl\nassert 'uni:partOfUniversity uni:NTUA' in ttl\nassert 'uni:NTUA a uni:University' in ttl\nassert 'uni:hasName \"National Technical University of Athens\"' in ttl\n\nprint('Static validation passed for /app/solution.sparql')\nprint(query)\nPY\ntrue; tmux wait -S done\r"]
