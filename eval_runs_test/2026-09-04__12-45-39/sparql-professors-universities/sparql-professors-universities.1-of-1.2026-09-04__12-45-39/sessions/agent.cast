[130.970313, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/solution.sparql <<'PY'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = 'PREFIX uni: <http://university.org/ontology#>\\n\\nSELECT ?professorName ?universityName\\nWHERE {\\n  ?professor a uni:Person ;\\n             uni:hasName ?professorName ;\\n             uni:role ?role ;\\n             uni:worksAt ?department .\\n\\n  FILTER(CONTAINS(?role, \"Professor\"))\\n\\n  ?department uni:partOfUniversity ?university .\\n  ?university uni:hasName ?universityName .\\n}\\n'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, 'w', encoding='utf-8', newline='\\n') as f:\n        f.write(content)\n    print(f\"成功: 已写入 {path}\")\nexcept Exception as exc:\n    print(f\"写入失败: {exc}\")\nPY\ntrue; tmux wait -S done\r"]
[130.970995, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
