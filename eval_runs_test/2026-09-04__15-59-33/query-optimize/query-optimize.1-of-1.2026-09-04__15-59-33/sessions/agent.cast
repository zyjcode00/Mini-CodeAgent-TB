[483.13232, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - <<'PY'\nimport sqlite3, time\nfrom pathlib import Path\nDB='/app/oewn.sqlite'\nsol=Path('/app/sol.sql').read_text()\nalt=Path('/tmp/alt.sql').read_text()\nwith sqlite3.connect(DB) as conn:\n    conn.execute('PRAGMA temp_store=MEMORY')\n    t=time.perf_counter(); sol_rows=conn.execute(sol).fetchall(); sol_t=time.perf_counter()-t\n    t=time.perf_counter(); alt_rows=conn.execute(alt).fetchall(); alt_t=time.perf_counter()-t\nprint('sol_rows', len(sol_rows), 'sol_seconds', f'{sol_t:.6f}')\nprint('alt_rows', len(alt_rows), 'alt_seconds', f'{alt_t:.6f}')\nprint('equal', sol_rows == alt_rows)\nif sol_rows != alt_rows:\n    for i,(a,b) in enumerate(zip(sol_rows, alt_rows)):\n        if a != b:\n            print('first_diff', i, a, b)\n            break\nPY\ntrue; tmux wait -S done\r"]
