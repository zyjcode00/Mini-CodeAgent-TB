[149.319914, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
[149.320129, "o", "\u001b[?2004hroot@5ec6d299675a:/app# "]
