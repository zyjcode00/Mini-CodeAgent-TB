[187.393004, "o", "> "]
[187.39757, "o", "content = 'import sqlite3\\nimport time\\nfrom pathlib import Path\\n\\nDB = \"/app/oewn.sqlite\"\\nORIG = Path(\"/app/my-sql-query.sql\")\\nSOL = Path(\"/app/sol.sql\")\\n\\n\\ndef read_sql(path: Path) -> str:\\n    sql = path.read_text(encoding=\"utf-8\")\\n    assert sql.strip().endswith(\";\"), f\"{path} must end with semicolon\"\\n    return sql\\n\\n\\ndef run_query(conn: sqlite3.Connection, sql: str):\\n    start = time.perf_counter()\\n    rows = conn.execute(sql).fetchall()\\n    elapsed = time.perf_counter() - start\\n    return rows, elapsed\\n\\n\\ndef main():\\n    sol_text = read_sql(SOL)\\n    assert sol_text.count(\";\") == 1, \"solution must contain exactly one semicolon\"\\n    assert \"--\" not in sol_text and \"/*\" not in sol_text and \"*/\" not in sol_text, \"solution must contain no comments\"\\n\\n    orig_sql = read_sql(ORIG)\\n    with sqlite3.connect(DB) as conn:\\n        conn.execute(\"PRAGMA temp_store=MEMORY\")\\n        orig_rows, orig_time = run_query(conn, orig_sql)\\n        sol_rows, sol_time = run_query(conn, sol_text)\\n\\n    assert orig_rows == sol_rows, (\\n        f\"outputs differ: original={len(orig_rows)} rows solution={len(sol_rows)} rows\\\\n\"\\n        f\"first original rows={orig_rows[:3]}\\\\nfirst solution rows={sol_rows[:3]}\"\\n    )\\n    print(f\"rows={len(sol_rows)}\")\\n    print(f\"original_seconds={orig_time:.6f}\")\\n    print(f\"solution_seconds={sol_time:.6f}\")\\n    if sol_time:\\n        print(f\"speedup={orig_time / sol_time:.2f}x\")\\n\\n\\nif __name__ == \"__main__\":\\n    main()\\n'\r\n\u001b[?2004l\r\u001b[?2004h> "]
