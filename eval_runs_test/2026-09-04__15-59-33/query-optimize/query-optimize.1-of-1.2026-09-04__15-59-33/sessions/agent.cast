[90.952543, "o", "\u001b[?2004hroot@5ec6d299675a:/app# "]
[123.420539, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/sol.sql <<'PY'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = 'WITH sense_counts AS (\\n  SELECT wordid, synsetid, COUNT(*) AS sense_count\\n  FROM senses\\n  GROUP BY wordid, synsetid\\n),\\nword_stats AS (\\n  SELECT\\n    sc.wordid,\\n    w.word,\\n    COUNT(*) AS total_synsets,\\n    SUM(sc.sense_count) AS total_senses,\\n    COUNT(DISTINCT syn.domainid) AS distinct_domains,\\n    COUNT(DISTINCT syn.posid) AS distinct_posids\\n  FROM sense_counts sc\\n  JOIN words w ON w.wordid = sc.wordid\\n  JOIN synsets syn ON syn.synsetid = sc.synsetid\\n  GROUP BY sc.wordid, w.word\\n  HAVING COUNT(*) >= 2\\n    AND COUNT(DISTINCT syn.domainid) >= 2\\n    AND SUM(sc.sense_count) >= 2\\n),\\nmax_counts AS (\\n  SELECT wordid, MAX(sense_count) AS top_synset_sense_count\\n  FROM sense_counts\\n  GROUP BY wordid\\n),\\ntop_synsets AS (\\n  SELECT\\n    sc.wordid,\\n    MIN(sc.synsetid) AS top_synsetid,\\n    mc.top_synset_sense_count\\n  FROM sense_counts sc\\n  JOIN max_counts mc\\n    ON mc.wordid = sc.wordid\\n   AND mc.top_synset_sense_count = sc.sense_count\\n  GROUP BY sc.wordid\\n)\\nSELECT\\n  ws.wordid AS word_id,\\n  ws.word AS word,\\n  ws.total_synsets,\\n  ws.total_senses,\\n  ws.distinct_domains,\\n  ws.distinct_posids,\\n  ts.top_synsetid,\\n  ts.top_synset_sense_count\\nFROM word_stats ws\\nJOIN top_synsets ts ON ts.wordid = ws.wordid\\nORDER BY\\n  ws.total_senses DESC,\\n  ws.total_synsets DESC,\\n  ws.distinct_domains DESC,\\n  word_id ASC\\nLIMIT 500;\\n'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, 'w', encoding='utf-8', newline='\\n') as f:\n        f.write(content)\n    print(f\"成功: 已写入 {path}\")\nexcept Exception as exc:\n    print(f\"写入失败: {exc}\")\nPY\ntrue; tmux wait -S done\r"]
[123.421565, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
[123.421816, "o", "\u001b[?2004hroot@5ec6d299675a:/app# "]
[123.422002, "o", "python3 - /app/sol.sql <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.422154, "o", "> import os\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.42236, "o", "> import sys\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.422571, "o", "path = sys.argv[1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.427056, "o", "content = 'WITH sense_counts AS (\\n  SELECT wordid, synsetid, COUNT(*) AS sense_count\\n  FROM senses\\n  GROUP BY wordid, synsetid\\n),\\nword_stats AS (\\n  SELECT\\n    sc.wordid,\\n    w.word,\\n    COUNT(*) AS total_synsets,\\n    SUM(sc.sense_count) AS total_senses,\\n    COUNT(DISTINCT syn.domainid) AS distinct_domains,\\n    COUNT(DISTINCT syn.posid) AS distinct_posids\\n  FROM sense_counts sc\\n  JOIN words w ON w.wordid = sc.wordid\\n  JOIN synsets syn ON syn.synsetid = sc.synsetid\\n  GROUP BY sc.wordid, w.word\\n  HAVING COUNT(*) >= 2\\n    AND COUNT(DISTINCT syn.domainid) >= 2\\n    AND SUM(sc.sense_count) >= 2\\n),\\nmax_counts AS (\\n  SELECT wordid, MAX(sense_count) AS top_synset_sense_count\\n  FROM sense_counts\\n  GROUP BY wordid\\n),\\ntop_synsets AS (\\n  SELECT\\n    sc.wordid,\\n    MIN(sc.synsetid) AS top_synsetid,\\n    mc.top_synset_sense_count\\n  FROM sense_counts sc\\n  JOIN max_counts mc\\n    ON mc.wordid = sc.wordid\\n   AND mc.top_synset_sense_count = sc.sense_count\\n  GROUP BY sc.wordid\\n)\\nSELECT\\n  ws.wordid AS word_id,\\n  ws.word AS word,\\n  ws.total_synsets,\\n  ws.total_senses,\\n  ws.distinct_domains,\\n  ws.distinct_posids,\\n  ts.top_synsetid,\\n  ts.top_synset_sense_count\\nFROM word_stats ws\\nJOIN top_synsets ts ON ts.wordid = ws.wordid\\nORDER BY\\n  ws.total_senses DESC,\\n  ws.total_synsets DESC,\\n  ws.distinct_domains DESC,\\n  word_id ASC\\nLIMIT 500;\\n'\r\n\u001b[?2004l\r"]
[123.427311, "o", "\u001b[?2004h> "]
[123.427568, "o", "dir_path = os.path.dirname(path)\r\n\u001b[?2004l\r\u001b[?2004h> if dir_path:\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.427815, "o", ">     os.makedirs(dir_path, exist_ok=True)\r\n\u001b[?2004l\r"]
[123.42806, "o", "\u001b[?2004h> try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.428283, "o", "    with open(path, 'w', encoding='utf-8', newline='\\n') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.428539, "o", "        f.write(content)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.428754, "o", "    print(f\"成功: 已写入 {path}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[123.428966, "o", "> except Exception as exc:\r\n\u001b[?2004l\r"]
[123.429088, "o", "\u001b[?2004h> "]
[123.429267, "o", "    print(f\"写入失败: {exc}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[123.429405, "o", "PY\r\n\u001b[?2004l\r"]
[123.441998, "o", "成功: 已写入 /app/sol.sql\r\n"]
[123.444051, "o", "\u001b[?2004hroot@5ec6d299675a:/app# "]
[123.444349, "o", "true; tmux wait -S done\r\n\u001b[?2004l\r"]
[123.448522, "o", "\u001b[?2004hroot@5ec6d299675a:/app# "]
