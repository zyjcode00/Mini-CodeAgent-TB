[461.433016, "o", "> PY\r\n\u001b[?2004l\r"]
[461.442435, "o", "成功: 已写入 /tmp/alt.sql\r\n"]
[461.444784, "o", "\u001b[?2004hroot@5ec6d299675a:/app# "]
