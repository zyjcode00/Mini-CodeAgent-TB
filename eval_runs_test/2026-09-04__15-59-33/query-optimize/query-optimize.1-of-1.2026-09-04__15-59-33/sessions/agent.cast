[50.322312, "o", "sqlite3 /app/oewn.sqlite <<'SQL'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.322448, "o", "EXPLAIN QUERY PLAN\r\n\u001b[?2004l\r\u001b[?2004h> SELECT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.322576, "o", "  w.wordid AS word_id,\r\n\u001b[?2004l\r"]
[50.322686, "o", "\u001b[?2004h>   w.word AS word,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.322848, "o", "  total_synsets,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.323047, "o", "  total_senses,\r\n\u001b[?2004l\r\u001b[?2004h>   distinct_domains,\r\n\u001b[?2004l\r"]
[50.323192, "o", "\u001b[?2004h>   distinct_posids,\r\n\u001b[?2004l\r"]
[50.323249, "o", "\u001b[?2004h> "]
[50.323495, "o", "  (SELECT s.synsetid FROM senses s\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.323651, "o", "   WHERE s.wordid = w.wordid\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.323889, "o", "   GROUP BY s.synsetid\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.324103, "o", "   ORDER BY COUNT(*) DESC, s.synsetid ASC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.32434, "o", "   LIMIT 1) AS top_synsetid,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.32445, "o", "  (SELECT COUNT(*) FROM senses s\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.325323, "o", "   WHERE s.wordid = w.wordid\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.325501, "o", "   AND s.synsetid = (SELECT s2.synsetid FROM senses s2\r\n\u001b[?2004l\r\u001b[?2004h>                      WHERE s2.wordid = w.wordid\r\n\u001b[?2004l\r\u001b[?2004h>                      GROUP BY s2.synsetid\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.325627, "o", "                     ORDER BY COUNT(*) DESC, s2.synsetid ASC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.325842, "o", "                     LIMIT 1)) AS top_synset_sense_count\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.326006, "o", "FROM (\r\n\u001b[?2004l\r\u001b[?2004h>   SELECT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.326127, "o", "    w.wordid,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.326253, "o", "    w.word,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.32646, "o", "    COUNT(DISTINCT s.synsetid) AS total_synsets,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.326636, "o", "    COUNT(*) AS total_senses,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.326836, "o", "    COUNT(DISTINCT syn.domainid) AS distinct_domains,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.327002, "o", "    COUNT(DISTINCT syn.posid) AS distinct_posids\r\n\u001b[?2004l\r\u001b[?2004h"]
[50.327143, "o", ">   FROM words w\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.327326, "o", "  JOIN senses s ON w.wordid = s.wordid\r\n\u001b[?2004l\r\u001b[?2004h"]
[50.327475, "o", "> "]
[50.327646, "o", "  JOIN synsets syn ON s.synsetid = syn.synsetid\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.327858, "o", "  GROUP BY w.wordid, w.word\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.328054, "o", "  HAVING total_synsets >= 2\r\n\u001b[?2004l\r\u001b[?2004h"]
[50.328157, "o", ">     AND distinct_domains >= 2\r\n\u001b[?2004l\r"]
[50.328364, "o", "\u001b[?2004h> "]
[50.328716, "o", "    AND total_senses >= 2\r\n\u001b[?2004l\r\u001b[?2004h> ) w\r\n\u001b[?2004l\r\u001b[?2004h> ORDER BY\r\n\u001b[?2004l\r\u001b[?2004h"]
[50.328935, "o", ">   total_senses DESC,\r\n\u001b[?2004l\r"]
[50.329133, "o", "\u001b[?2004h> "]
[50.3293, "o", "  total_synsets DESC,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.329428, "o", "  distinct_domains DESC,\r\n\u001b[?2004l\r\u001b[?2004h"]
[50.329507, "o", "> "]
[50.32971, "o", "  word_id ASC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.329823, "o", "LIMIT 500;\r\n\u001b[?2004l\r\u001b[?2004h> SQL\r\n\u001b[?2004l\r"]
[50.331858, "o", "QUERY PLAN\r\n|--CO-ROUTINE w\r\n|  |--SCAN w\r\n|  |--BLOOM FILTER ON s (wordid=?)\r\n|  |--SEARCH s USING AUTOMATIC COVERING INDEX (wordid=?)\r\n|  |--BLOOM FILTER ON syn (synsetid=?)\r\n|  |--SEARCH syn USING AUTOMATIC COVERING INDEX (synsetid=?)\r\n|  |--USE TEMP B-TREE FOR GROUP BY\r\n|  |--USE TEMP B-TREE FOR count(DISTINCT)\r\n|  |--USE TEMP B-TREE FOR count(DISTINCT)\r\n|  `--USE TEMP B-TREE FOR count(DISTINCT)\r\n|--SCAN w\r\n|--CORRELATED SCALAR SUBQUERY 1\r\n|  |--SCAN s\r\n|  |--USE TEMP B-TREE FOR GROUP BY\r\n|  `--USE TEMP B-TREE FOR ORDER BY\r\n|--CORRELATED SCALAR SUBQUERY 3\r\n|  |--SCAN s\r\n|  `--CORRELATED SCALAR SUBQUERY 2\r\n|     |--SCAN s2\r\n|     |--USE TEMP B-TREE FOR GROUP BY\r\n|     `--USE TEMP B-TREE FOR ORDER BY\r\n`--USE TEMP B-TREE FOR ORDER BY\r\n"]
