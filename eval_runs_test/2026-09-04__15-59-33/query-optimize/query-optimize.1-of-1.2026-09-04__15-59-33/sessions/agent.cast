[461.431647, "o", "    os.makedirs(dir_path, exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[461.431834, "o", "> try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[461.432049, "o", "    with open(path, 'w', encoding='utf-8', newline='\\n') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[461.432126, "o", "        f.write(content)\r\n\u001b[?2004l\r\u001b[?2004h"]
[461.432368, "o", "> "]
[461.432539, "o", "    print(f\"成功: 已写入 {path}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
