[29.773612, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\nif [ -f /app/my-sql-query.sql ]; then cat -- /app/my-sql-query.sql; else echo '错误: 找不到文件 /app/my-sql-query.sql'; fi\ntrue; tmux wait -S done\r"]
