[461.426937, "o", "python3 - /tmp/alt.sql <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r"]
[461.427201, "o", "\u001b[?2004h> import sys\r\n\u001b[?2004l\r"]
[461.427361, "o", "\u001b[?2004h> path = sys.argv[1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[461.430883, "o", "content = \"WITH sense_counts AS (\\n  SELECT wordid, synsetid, COUNT(*) AS sense_count\\n  FROM senses\\n  GROUP BY wordid, synsetid\\n),\\nword_stats AS (\\n  SELECT\\n    sc.wordid,\\n    w.word,\\n    COUNT(*) AS total_synsets,\\n    SUM(sc.sense_count) AS total_senses,\\n    COUNT(DISTINCT syn.domainid) AS distinct_domains,\\n    COUNT(DISTINCT syn.posid) AS distinct_posids,\\n    CAST(substr(group_concat(sc.synsetid ORDER BY sc.sense_count DESC, sc.synsetid ASC), 1, instr(group_concat(sc.synsetid ORDER BY sc.sense_count DESC, sc.synsetid ASC) || ',', ',') - 1) AS INT) AS top_synsetid,\\n    MAX(sc.sense_count) AS top_synset_sense_count\\n  FROM sense_counts sc\\n  JOIN words w ON w.wordid = sc.wordid\\n  JOIN synsets syn ON syn.synsetid = sc.synsetid\\n  GROUP BY sc.wordid, w.word\\n  HAVING COUNT(*) >= 2\\n    AND COUNT(DISTINCT syn.domainid) >= 2\\n    AND SUM(sc.sense_count) >= 2\\n)\\nSELECT\\n  wordid AS word_id,\\n  word,\\n  total_synsets,\\n  total_senses,\\n  distinct_domains,\\n  distinct_posids,\\n  top_synsetid,\\n  top_synset_sense_count\\nFROM word_stats\\nORDER BY\\n  total_senses DESC,\\n  total_synsets DESC,\\n  distinct_domains DESC,\\n  word_id ASC\\nLIMIT 500;\\n\"\r\n\u001b[?2004l\r\u001b[?2004h"]
