[30.075085, "o", "-rwxr-xr-x 1 root root 1.2K Aug 10 16:30 \u001b[0m\u001b[01;32m/app/my-sql-query.sql\u001b[0m\r\n-r--r--r-- 1 root root  49M Sep  4 08:00 /app/oewn.sqlite\r\n"]
[30.078156, "o", "adjpositions|table|CREATE TABLE `adjpositions` (\r\n`positionid` CHARACTER (1) CHECK( `positionid` IN ('a','p','ip') ) NOT NULL,\r\n`position` VARCHAR(24) NOT NULL\r\n)\r\ncasedwords|table|CREATE TABLE `casedwords` (\r\n`casedwordid` INT NOT NULL,\r\n`wordid` INT NOT NULL ,\r\n`casedword` VARCHAR(80) NOT NULL\r\n)\r\ndomains|table|CREATE TABLE `domains` (\r\n`domainid` INT NOT NULL,\r\n`domain` VARCHAR(32) NOT NULL,\r\n`domainname` VARCHAR(32) NOT NULL,\r\n`posid` CHARACTER (1) CHECK( `posid` IN ('n','v','a','r','s') ) NOT NULL\r\n)\r\nilis|table|CREATE TABLE `ilis` (\r\n`ili` VARCHAR(7) NOT NULL,\r\n`synsetid` INT NOT NULL\r\n)\r\nlexes|table|CREATE TABLE `lexes` (\r\n`luid` INT NOT NULL,\r\n`posid` CHARACTER (1) CHECK( `posid` IN ('n','v','a','r','s') ) NOT NULL,\r\n`wordid` INT NOT NULL,\r\n`casedwordid` INT DEFAULT NULL\r\n)\r\nlexes_morphs|table|CREATE TABLE `lexes_morphs` (\r\n`luid` INT NOT NULL,\r\n`wordid` INT NOT NULL,\r\n`posid` CHARACTER (1) CHECK( `posid` IN ('n','v','a','r','s') ) NOT NULL,\r\n`morphid` INT NOT NULL\r\n)\r\nlexes_pronunciations|table|CREATE TABLE `lexes_pronunciations` (\r\n`luid` INT NOT NULL,\r\n`wordid` INT NOT NULL,\r\n`posid` CHARACTER (1) CHECK( `posid` IN ('n','v','a','r','s') ) NOT NULL,\r\n`pronunciationid` INT NOT NULL,\r\n`variety` VARCHAR(2) DEFAULT NULL\r\n)\r\nlexrelations|table|CREATE TABLE `lexrelations` (\r\n`synset1id` INT NOT NULL,\r\n`lu1id` INT NOT NULL,\r\n`word1id` INT NOT NULL,\r\n`synset2id` INT NOT NULL,\r\n`lu2id` INT NOT NULL,\r\n`word2id` INT NOT NULL,\r\n`relationid` INT NOT NULL\r\n)\r\n"]
[30.078422, "o", "morphs|table|CREATE TABLE `morphs` (\r\n`morphid` INT NOT NULL,\r\n`morph` VARCHAR(70) NOT NULL\r\n)\r\nposes|table|CREATE TABLE `poses` (\r\n`posid` CHARACTER (1) CHECK( `posid` IN ('n','v','a','r','s') ) NOT NULL,\r\n`pos` VARCHAR(20) NOT NULL\r\n)\r\npronunciations|table|CREATE TABLE `pronunciations` (\r\n`pronunciationid` INT NOT NULL,\r\n`pronunciation` VARCHAR(50) NOT NULL\r\n)\r\nrelations|table|CREATE TABLE `relations` (\r\n`relationid` INT NOT NULL,\r\n`relation` VARCHAR(50) NOT NULL,\r\n`recurses` TINYINT(1) NOT NULL\r\n)\r\nsamples|table|CREATE TABLE `samples` (\r\n`sampleid` INT NOT NULL,\r\n`sample` MEDIUMTEXT NOT NULL,\r\n`source` MEDIUMTEXT NULL,\r\n`synsetid` INT NOT NULL,\r\n`luid` INT DEFAULT NULL,\r\n`wordid` INT DEFAULT NULL\r\n)\r\nsemrelations|table|CREATE TABLE `semrelations` (\r\n`synset1id` INT NOT NULL,\r\n`synset2id` INT NOT NULL,\r\n`relationid` INT NOT NULL\r\n)\r\nsenses|table|CREATE TABLE `senses` (\r\n`senseid` INT NOT NULL,\r\n`sensekey` VARCHAR(100) DEFAULT NULL,\r\n`synsetid` INT NOT NULL,\r\n`luid` INT NOT NULL,\r\n`wordid` INT NOT NULL,\r\n`casedwordid` INT DEFAULT NULL,\r\n`lexid` INT NOT NULL,\r\n`sensenum` INT DEFAULT NULL,\r\n`tagcount` INT DEFAULT NULL\r\n)\r\nsenses_adjpositions|table|CREATE TABLE `senses_adjpositions` (\r\n`synsetid` INT NOT NULL,\r\n`luid` INT NOT NULL,\r\n`wordid` INT NOT NULL,\r\n`positionid` CHARACTER (1) CHECK( `positionid` IN ('a','p','ip') ) NOT NULL\r\n)\r\nsenses_vframes|table|CREATE TABLE `senses_vframes` (\r\n`synsetid` INT NOT NULL,\r\n`luid` INT NOT NULL,\r\n`wordid` INT NOT NULL,\r\n`frameid` INT NOT NULL\r\n)\r\nsenses_vtemplates|table|CREATE TABLE `senses_vtemplates` (\r\n`synsetid` INT NOT NULL,\r\n`luid` INT NOT NULL,\r\n`wordid` INT NOT NULL,\r\n`templateid` INT NOT NULL\r\n)\r\nsynsets|table|CREATE TABLE `synsets` (\r\n`synsetid` INT NOT NULL,\r\n`posid` CHARACTER (1) CHECK( `posid` IN ('n','v','a','r','s') ) NOT NULL,\r\n`domainid` INT NOT NULL,\r\n`definition` MEDIUMTEXT NOT NULL\r\n)\r\nusages|table|CREATE TABLE `usages` (\r\n`usageid` INT NOT NULL,\r\n`usagenote` MEDIUMTEXT NOT NULL,\r\n`synsetid` INT NOT NULL,\r\n`luid` INT DEFAULT NULL,\r\n`wordid` INT DEFAULT NULL\r\n)\r\nvframes|table|CREATE TABLE `vframes` (\r\n`frameid` INT NOT NULL,\r\n`frame` VARCHAR(50) NOT NULL\r\n)\r\nvtemplates|table|CREATE TABLE `vtemplates` (\r\n"]
[30.078624, "o", "`templateid` INT NOT NULL,\r\n`template` MEDIUMTEXT NOT NULL\r\n)\r\nwikidatas|table|CREATE TABLE `wikidatas` (\r\n`wikidata` VARCHAR(12) NOT NULL,\r\n`synsetid` INT NOT NULL\r\n)\r\nwords|table|CREATE TABLE `words` (\r\n`wordid` INT NOT NULL,\r\n`word` VARCHAR(80) NOT NULL\r\n)\r\n"]
