[90.885171, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\nsqlite3 /app/oewn.sqlite <<'SQL'\nSELECT 'duplicate words.wordid', count(*) FROM (SELECT wordid FROM words GROUP BY wordid HAVING count(*)>1);\nSELECT 'duplicate synsets.synsetid', count(*) FROM (SELECT synsetid FROM synsets GROUP BY synsetid HAVING count(*)>1);\nSELECT sqlite_version();\nSQL\ntrue; tmux wait -S done\r"]
