[50.11385, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\nsqlite3 /app/oewn.sqlite <<'SQL'\n.timer on\nSELECT 'words', count(*) FROM words;\nSELECT 'senses', count(*) FROM senses;\nSELECT 'synsets', count(*) FROM synsets;\nSELECT 'distinct sense word/synset', count(*) FROM (SELECT DISTINCT wordid, synsetid FROM senses);\nSELECT 'duplicate word/synset groups', count(*) FROM (SELECT wordid, synsetid, count(*) c FROM senses GROUP BY wordid, synsetid HAVING c>1);\nSQL\ntrue; tmux wait -S done\r"]
