[175.819172, "o", "\r\ndef test_field_mapping_normalization_directly():\r\n    raw = pd.DataFrame(\r\n        [\r\n            {'id': '1', 'full_name': ' Alpha ', 'email_address': 'alpha@example.com', 'registration_date': '2024/05/06'},\r\n            {'userId': 2, 'userName': 'Beta', 'email': ' beta@example.com ', 'joined': '2024-07-08T12:34:56'},\r\n        ]\r\n    )\r\n\r\n    records = merge_users.normalize_frame(raw)\r\n\r\n    assert records == [\r\n        {'user_id': 1, 'name': 'Alpha', 'email': 'alpha@example.com', 'created_date': '2024-05-06'},\r\n        {'user_id': 2, 'name': 'Beta', 'email': 'beta@example.com', 'created_date': '2024-07-08'},\r\n    ]\r\n\r\n\r\ndef test_priority_rules_with_synthetic_source_b_over_source_c_case():\r\n    records_by_source = {\r\n        'source_a': {},\r\n        'source_b': {200: {'user_id': 200, 'name': 'From B', 'email': 'b@example.com', 'created_date': '2024-01-02'}},\r\n"]
[175.821153, "o", "\u001b[?2004hroot@f435e7e68aa2:/app# "]
[175.821287, "o", "true; tmux wait -S done"]
[175.821372, "o", "\r\n\u001b[?2004l\r"]
[175.824077, "o", "\u001b[?2004hroot@f435e7e68aa2:/app# "]
[182.788541, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/merge_users.py 1 180 true <<'PY'\nimport sys\npath = sys.argv[1]\nstart_line = int(sys.argv[2])\nend_line = None if sys.argv[3] == 'None' else int(sys.argv[3])\nraw_mode = sys.argv[4].lower() == 'true'\ntry:\n    with open(path, 'r', encoding='utf-8', errors='replace') as f:\n        lines = f.readlines()\nexcept FileNotFoundError:\n    print(f\"错误: 找不到文件 {path}\")\n    raise SystemExit(0)\nexcept Exception as exc:\n    print(f\"读取失败: {exc}\")\n    raise SystemExit(0)\n\ntotal_lines = len(lines)\ns_idx = max(0, start_line - 1)\ne_idx = end_line if end_line is not None else total_lines\nselected_lines = lines[s_idx:e_idx]\nif raw_mode:\n    sys.stdout.write(''.join(selected_lines))\nelse:\n    output = []\n    for i, line in enumerate(selected_lines):\n        output.append(f\"{s_idx + i + 1:4d} | {line.rstrip()}\")\n    header = f\"--- 文件: {path} (第 {start_line} 至 {min(e_idx, total_lines)} 行，共 {total_lines} 行) ---\\n\"\n    sys.stdout.write"]
[182.78869, "i", "(header + \"\\n\".join(output) + \"\\n--- 读取完毕 ---\")\nPY\ntrue; tmux wait -S done\r"]
