[59.089688, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython - <<'PY'\nimport json, pandas as pd\nfrom pathlib import Path\nprint('JSON exists', Path('/data/source_a/users.json').exists())\nprint('CSV exists', Path('/data/source_b/users.csv').exists())\nprint('Parquet exists', Path('/data/source_c/users.parquet').exists())\nprint('\\nsource_a:')\nwith open('/data/source_a/users.json') as f:\n    data=json.load(f)\nprint(type(data), len(data) if hasattr(data,'__len__') else 'na')\nprint(data[:3] if isinstance(data,list) else str(data)[:500])\nprint('\\nsource_b:')\ndfb=pd.read_csv('/data/source_b/users.csv')\nprint(dfb.dtypes)\nprint(dfb.head().to_string())\nprint('\\nsource_c:')\ndfc=pd.read_parquet('/data/source_c/users.parquet')\nprint(dfc.dtypes)\nprint(dfc.head().to_string())\nPY\ntrue; tmux wait -S done\r"]
