[203.537915, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\ncd /app && python - <<'PY'\nimport importlib, traceback\nimport merge_users\nmerge_users.main()\nmod = importlib.import_module('test_merge_users')\nfailures = []\nfor name in sorted(n for n in dir(mod) if n.startswith('test_')):\n    print(f'RUN {name}')\n    try:\n        getattr(mod, name)()\n    except Exception as exc:\n        failures.append((name, exc, traceback.format_exc()))\n        print(f'FAIL {name}: {exc}')\n    else:\n        print(f'PASS {name}')\nif failures:\n    print('\\nFAILURES:')\n    for name, exc, tb in failures:\n        print(f'--- {name} ---')\n        print(tb)\n    raise SystemExit(1)\nprint('\\nALL TESTS PASSED')\nPY\npython /app/merge_users.py\npython - <<'PY'\nimport json, pandas as pd\nprint(pd.read_parquet('/app/merged_users.parquet').to_string(index=False))\nwith open('/app/conflicts.json', encoding='utf-8') as f:\n    print(json.dumps(json.load(f), indent=2))\nPY\ntrue; tmux wait -S done\r"]
