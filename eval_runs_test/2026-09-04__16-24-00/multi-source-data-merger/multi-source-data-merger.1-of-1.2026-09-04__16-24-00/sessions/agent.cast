[182.804016, "o", "#!/usr/bin/env python3\r\n\"\"\"Merge heterogeneous user data sources with priority-based conflict handling.\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nfrom pathlib import Path\r\nfrom typing import Any, Dict, Iterable, List, Tuple\r\n\r\nimport pandas as pd\r\n\r\nSOURCE_CONFIG = [\r\n    (\"source_a\", Path(\"/data/source_a/users.json\"), \"json\"),\r\n    (\"source_b\", Path(\"/data/source_b/users.csv\"), \"csv\"),\r\n    (\"source_c\", Path(\"/data/source_c/users.parquet\"), \"parquet\"),\r\n]\r\n\r\nOUTPUT_PARQUET = Path(\"/app/merged_users.parquet\")\r\nOUTPUT_CONFLICTS = Path(\"/app/conflicts.json\")\r\n\r\nFIELD_MAP = {\r\n    \"user_id\": \"user_id\",\r\n    \"id\": \"user_id\",\r\n    \"userId\": \"user_id\",\r\n    \"email\": \"email\",\r\n    \"email_address\": \"email\",\r\n    \"full_name\": \"name\",\r\n    \"name\": \"name\",\r\n    \"userName\": \"name\",\r\n    \"registration_date\": \"created_date\",\r\n    \"created_at\": \"created_date\",\r\n    \"joined\": \"created_date\",\r\n    \"status\": \"status\",\r\n}\r\n\r\nOUTPUT_COLUMNS = [\"user_id\", \"name\", \"email\", \"created_date\", \"status\"]\r\nMERGE_FIELDS = [\"n"]
[182.804251, "o", "ame\", \"email\", \"created_date\", \"status\"]\r\n\r\n\r\ndef is_missing(value: Any) -> bool:\r\n    \"\"\"Return True for null/NaN/empty-string values that should not override data.\"\"\"\r\n    if value is None:\r\n        return True\r\n    try:\r\n        if pd.isna(value):\r\n            return True\r\n    except (TypeError, ValueError):\r\n        pass\r\n    if isinstance(value, str) and value.strip() == \"\":\r\n        return True\r\n    return False\r\n\r\n\r\ndef normalize_scalar(field: str, value: Any) -> Any:\r\n    \"\"\"Normalize a scalar value for stable merging and reporting.\"\"\"\r\n    if is_missing(value):\r\n        return None\r\n    if field == \"user_id\":\r\n        return int(value)\r\n    if field == \"created_date\":\r\n        return pd.to_datetime(value).strftime(\"%Y-%m-%d\")\r\n    if isinstance(value, str):\r\n        return value.strip()\r\n    # Convert numpy scalar values to native Python types for JSON serialization.\r\n    if hasattr(value, \"item\"):\r\n        return value.item()\r\n    return value\r\n\r\n\r\ndef read_source(path: Path, source_format: str) -> "]
[182.804385, "o", "pd.DataFrame:\r\n    \"\"\"Read a source file into a pandas DataFrame.\"\"\"\r\n    if source_format == \"json\":\r\n        with path.open(\"r\", encoding=\"utf-8\") as fh:\r\n            data = json.load(fh)\r\n        if isinstance(data, dict):\r\n            # Support either a bare object keyed by users or a wrapper like {\"users\": [...]}.\r\n            for candidate in (\"users\", \"data\", \"records\"):\r\n                if isinstance(data.get(candidate), list):\r\n                    data = data[candidate]\r\n                    break\r\n        return pd.DataFrame(data)\r\n    if source_format == \"csv\":\r\n        return pd.read_csv(path)\r\n    if source_format == \"parquet\":\r\n        return pd.read_parquet(path)\r\n    raise ValueError(f\"Unsupported source format: {source_format}\")\r\n\r\n\r\ndef normalize_frame(df: pd.DataFrame) -> List[Dict[str, Any]]:\r\n    \"\"\"Map source-specific columns to the canonical output schema.\"\"\"\r\n    rows: List[Dict[str, Any]] = []\r\n    for raw_record in df.to_dict(orient=\"records\"):\r\n        normalized: Dict[str, Any] = {}"]
[182.804496, "o", "\r\n        for raw_field, raw_value in raw_record.items():\r\n            canonical_field = FIELD_MAP.get(raw_field)\r\n            if canonical_field is None:\r\n                continue\r\n            normalized[canonical_field] = normalize_scalar(canonical_field, raw_value)\r\n        if \"user_id\" not in normalized or normalized[\"user_id\"] is None:\r\n            continue\r\n        rows.append(normalized)\r\n    return rows\r\n\r\n\r\ndef source_records() -> Dict[str, Dict[int, Dict[str, Any]]]:\r\n    \"\"\"Return records indexed by source name then user_id.\"\"\"\r\n    indexed: Dict[str, Dict[int, Dict[str, Any]]] = {}\r\n    for source_name, path, source_format in SOURCE_CONFIG:\r\n        df = read_source(path, source_format)\r\n        records = normalize_frame(df)\r\n        by_id: Dict[int, Dict[str, Any]] = {}\r\n        for record in records:\r\n            user_id = int(record[\"user_id\"])\r\n            # If a source unexpectedly contains duplicates, keep first non-null values.\r\n            if user_id not in by_id:\r\n                by_id[us"]
[182.804588, "o", "er_id] = {\"user_id\": user_id}\r\n            for field, value in record.items():\r\n                if field == \"user_id\":\r\n                    continue\r\n                if not is_missing(value) and is_missing(by_id[user_id].get(field)):\r\n                    by_id[user_id][field] = value\r\n        indexed[source_name] = by_id\r\n    return indexed\r\n\r\n\r\ndef selected_value(values_by_source: Dict[str, Any]) -> Tuple[Any, str | None]:\r\n    \"\"\"Select the highest-priority non-missing value.\"\"\"\r\n    for source_name, _, _ in SOURCE_CONFIG:\r\n        value = values_by_source.get(source_name)\r\n        if not is_missing(value):\r\n            return value, source_name\r\n    return None, None\r\n\r\n\r\ndef merge_records(records_by_source: Dict[str, Dict[int, Dict[str, Any]]]) -> Tuple[pd.DataFrame, Dict[str, Any]]:\r\n    \"\"\"Merge records and build the conflict report.\"\"\"\r\n    all_user_ids = sorted({uid for source_records_ in records_by_source.values() for uid in source_records_})\r\n    merged_rows: List[Dict[str, Any]] = []\r\n    conflicts"]
[182.804708, "o", ": List[Dict[str, Any]] = []\r\n\r\n    for user_id in all_user_ids:\r\n        merged: Dict[str, Any] = {\"user_id\": int(user_id)}\r\n        for field in MERGE_FIELDS:\r\n            values_by_source = {\r\n                source_name: records_by_source.get(source_name, {}).get(user_id, {}).get(field)\r\n                for source_name, _, _ in SOURCE_CONFIG\r\n                if not is_missing(records_by_source.get(source_name, {}).get(user_id, {}).get(field))\r\n            }\r\n            selected, _ = selected_value(values_by_source)\r\n            merged[field] = selected\r\n\r\n            distinct_values = []\r\n            for value in values_by_source.values():\r\n                if value not in distinct_values:\r\n                    distinct_values.append(value)\r\n            if len(distinct_values) > 1:\r\n                conflicts.append(\r\n                    {\r\n                        \"user_id\": int(user_id),\r\n                        \"field\": field,\r\n                        \"values\": values_by_source,\r\n                        \"s"]
[182.804823, "o", "elected\": selected,\r\n                    }\r\n                )\r\n        merged_rows.append(merged)\r\n\r\n    merged_df = pd.DataFrame(merged_rows, columns=OUTPUT_COLUMNS)\r\n    merged_df[\"user_id\"] = merged_df[\"user_id\"].astype(\"int64\")\r\n    for column in [\"name\", \"email\", \"created_date\", \"status\"]:\r\n        merged_df[column] = merged_df[column].astype(\"string\")\r\n\r\n    conflict_report = {\"total_conflicts\": len(conflicts), \"conflicts\": conflicts}\r\n    return merged_df, conflict_report\r\n\r\n\r\ndef main() -> None:\r\n    records = source_records()\r\n    merged_df, conflict_report = merge_records(records)\r\n    OUTPUT_PARQUET.parent.mkdir(parents=True, exist_ok=True)\r\n    merged_df.to_parquet(OUTPUT_PARQUET, index=False)\r\n    with OUTPUT_CONFLICTS.open(\"w\", encoding=\"utf-8\") as fh:\r\n"]
