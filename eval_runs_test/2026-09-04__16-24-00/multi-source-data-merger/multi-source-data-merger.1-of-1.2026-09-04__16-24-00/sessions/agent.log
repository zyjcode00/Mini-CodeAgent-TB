[?2004l[?2004h> path = sys.argv[1]
[?2004l [?2004h> content = '#!/usr/bin/env python3\n"""Merge heterogeneous user data sources with priority-based conflict handling."""\nfrom __future__ import annotations\n\nimport json\nfrom pathlib import Path\nfrom typing import Any, Dict, Iterable, List, Tuple\n\nimport pandas as pd\n\nSOURCE_CONFIG = [\n    ("source_a", Path("/data/source_a/users.json"), "json"),\n    ("source_b", Path("/data/source_b/users.csv"), "csv"),\n    ("source_c", Path("/data/source_c/users.parquet"), "parquet"),\n]\n\nOUTPUT_PARQUET = Path("/app/merged_users.parquet")\nOUTPUT_CONFLICTS = Path("/app/conflicts.json")\n\nFIELD_MAP = {\n    "user_id": "user_id",\n    "id": "user_id",\n    "userId": "user_id",\n    "email": "email",\n    "email_address": "email",\n    "full_name": "name",\n    "name": "name",\n    "userName": "name",\n    "registration_date": "created_date",\n    "created_at": "created_date",\n    "joined": "created_date",\n    "status": "status",\n}\n\nOUTPUT_COLUMNS = ["user_id", "name", "email", "created_date", "status"]\nMERGE_FIELDS = ["name", "email", "created_date", "status"]\n\n\ndef is_missing(value: Any) -> bool:\n    """Return True for null/NaN/empty-string values that should not override data."""\n    if value is None:\n        return True\n    try:\n        if pd.isna(value):\n            return True\n    except (TypeError, ValueError):\n        pass\n    if isinstance(value, str) and value.strip() == "":\n        return True\n    return False\n\n\ndef normalize_scalar(field: str, value: Any) -> Any:\n    """Normalize a scalar value for stable merging and reporting."""\n    if is_missing(value):\n        return None\n    if field == "user_id":\n        return int(value)\n    if field == "created_date":\n        return pd.to_datetime(value).strftime("%Y-%m-%d")\n    if isinstance(value, str):\n        return value.strip()\n    # Convert numpy scalar values to native Python types for JSON serialization.\n    if hasattr(value, "item"):\n        return value.item()\n    return value\n\n\ndef read_source(path: Path, source_format: str) -> pd.DataFrame:\n    """Read a source file into a pandas DataFrame."""\n    if source_format == "json":\n        with path.open("r", encoding="utf-8") as fh:\n            data = json.load(fh)\n        if isinstance(data, dict):\n            # Support either a bare object keyed by users or a wrapper like {"users": [...]}.\n            for candidate in ("users", "data", "records"):\n                if isinstance(data.get(candidate), list):\n                    data = data[candidate]\n                    break\n        return pd.DataFrame(data)\n    if source_format == "csv":\n        return pd.read_csv(path)\n    if source_format == "parquet":\n        return pd.read_parquet(path)\n    raise ValueError(f"Unsupported source format: {source_format}")\n\n\ndef normalize_frame(df: pd.DataFrame) -> List[Dict[str, Any]]:\n    """Map source-specific columns to the canonical output schema."""\n    rows: List[Dict[str, Any]] = []\n    for raw_record in df.to_dict(orient="records"):\n        normalized: Dict[str, Any] = {}\n        for raw_field, raw_value in raw_record.items():\n            canonical_field = FIELD_MAP.get(raw_field)\n            if canonical_field is None:\n                continue\n            normalized[canonical_field] = normalize_scalar(canonical_field, raw_value)\n        if "user_id" not in normalized or normalized["user_id"] is None:\n            continue\n        rows.append(normalized)\n    return rows\n\n\ndef source_records() -> Dict[str, Dict[int, Dict[str, Any]]]:\n    """Return records indexed by source name then user_id."""\n    indexed: Dict[str, Dict[int, Dict[str, Any]]] = {}\n    for source_name, path, source_format in SOURCE_CONFIG:\n        df = read_source(path, source_format)\n        records = normalize_frame(df)\n        by_id: Dict[int, Dict[str, Any]] = {}\n        for record in records:\n            user_id = int(record["user_id"])\n            # If a source unexpectedly contains duplicates, keep first non-null values.\n            if user_id not in by_id:\n                by_id[user_id] = {"user_id": user_id}\n            for field, value in record.items():\n                if field == "user_id":\n                    continue\n                if not is_missing(value) and is_missing(by_id[user_id].get(field)):\n                    by_id[user_id][field] = value\n        indexed[source_name] = by_id\n    return indexed\n\n\ndef selected_value(values_by_source: Dict[str, Any]) -> Tuple[Any, str | None]:\n    """Select the highest-priority non-missing value."""\n    for source_name, _, _ in SOURCE_CONFIG:\n        value = values_by_source.get(source_name)\n        if not is_missing(value):\n            return value, source_name\n    return None, None\n\n\ndef merge_records(records_by_source: Dict[str, Dict[int, Dict[str, Any]]]) -> Tuple[pd.DataFrame, Dict[str, Any]]:\n    """Merge records and build the conflict report."""\n    all_user_ids = sorted({uid for source_records_ in records_by_source.values() for uid in source_records_})\n    merged_rows: List[Dict[str, Any]] = []\n    conflicts: List[Dict[str, Any]] = []\n\n    for user_id in all_user_ids:\n        merged: Dict[str, Any] = {"user_id": int(user_id)}\n        for field in MERGE_FIELDS:\n            values_by_source = {\n                source_name: records_by_source.get(source_name, {}).get(user_id, {}).get(field)\n                for source_name, _, _ in SOURCE_CONFIG\n                if not is_missing(records_by_source.get(source_name, {}).get(user_id, {}).get(field))\n            }\n            selected, _ = selected_value(values_by_source)\n            merged[field] = selected\n\n            distinct_values = []\n            for value in values_by_source.values():\n                if value not in distinct_values:\n                    distinct_values.append(value)\n            if len(distinct_values) > 1:\n                conflicts.append(\n                    {\n                        "user_id": int(user_id),\n                        "field": field,\n                        "values": values_by_source,\n                        "selected": selected,\n                    }\n                )\n        merged_rows.append(merged)\n\n    merged_df = pd.DataFrame(merged_rows, columns=OUTPUT_COLUMNS)\n    merged_df["user_id"] = merged_df["user_id"].astype("int64")\n    for column in ["name", "email", "created_date", "status"]:\n        merged_df[column] = merged_df[column].astype("string")\n\n    conflict_report = {"total_conflicts": len(conflicts), "conflicts": conflicts}\n    return merged_df, conflict_report\n\n\ndef main() -> None:\n    records = source_records()\n    merged_df, conflict_report = merge_records(records)\n    OUTPUT_PARQUET.parent.mkdir(parents=True, exist_ok=True)\n    merged_df.to_parquet(OUTPUT_PARQUET, index=False)\n    with OUTPUT_CONFLICTS.open("w", encoding="utf-8") as fh:\n        json.dump(conflict_report, fh, indent=2, ensure_ascii=False)\n        fh.write("\\n")\n\n\nif __name__ == "__main__":\n    main()\n'
