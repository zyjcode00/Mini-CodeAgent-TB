[218.650885, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\ncd /app && python3 - <<'PY'\nimport json\nfrom http.client import HTTPConnection\n\nfor label, path in [\n    (\"valid\", \"/fib?n=10\"),\n    (\"missing\", \"/fib\"),\n    (\"non_integer\", \"/fib?n=abc\"),\n    (\"negative\", \"/fib?n=-3\"),\n]:\n    conn = HTTPConnection(\"127.0.0.1\", 3000, timeout=5)\n    conn.request(\"GET\", path)\n    response = conn.getresponse()\n    body = response.read().decode(\"utf-8\")\n    conn.close()\n    print(f\"{label}: status={response.status}, body={body}\")\n    if label == \"valid\":\n        assert response.status == 200\n        assert json.loads(body) == {\"result\": 55}\n    else:\n        assert response.status == 400\n        assert \"error\" in json.loads(body)\nprint(\"manual verification passed\")\nPY\ncat /app/server.pid && ps -p \"$(cat /app/server.pid)\" -o pid,cmd\ntrue; tmux wait -S done\r"]
