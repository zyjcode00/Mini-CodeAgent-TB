[107.101762, "o", "if [ -f /app/server.py ]; then cat -- /app/server.py; else echo '错误: 找不到文件 /app/server.py'; fi\r\n\u001b[?2004l\r"]
[107.171117, "o", "#!/usr/bin/env python3\r\n\"\"\"Simple Fibonacci HTTP server.\r\n\r\nRuns on port 3000 by default and exposes a single GET endpoint:\r\n    /fib?n={non-negative integer}\r\n\"\"\"\r\n\r\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\r\nimport json\r\nfrom urllib.parse import parse_qs, urlparse\r\n\r\nHOST = \"0.0.0.0\"\r\nPORT = 3000\r\n\r\n\r\ndef fibonacci(n: int) -> int:\r\n    \"\"\"Return the nth Fibonacci number, using F(0)=0 and F(1)=1.\"\"\"\r\n    a, b = 0, 1\r\n    for _ in range(n):\r\n        a, b = b, a + b\r\n    return a\r\n\r\n\r\ndef parse_non_negative_integer(raw_value: str) -> int:\r\n    \"\"\"Parse a query string value as a non-negative integer.\r\n\r\n    Raises ValueError if the value is missing, non-integral, or negative.\r\n    \"\"\"\r\n    if raw_value is None or raw_value == \"\":\r\n        raise ValueError(\"n query parameter is required\")\r\n\r\n    if not raw_value.isdecimal():\r\n        raise ValueError(\"n query parameter must be a non-negative integer\")\r\n\r\n    return int(raw_value)\r\n\r\n\r\nclass FibRequestHandler(BaseHTTPRequestHandler):\r\n    \"\"\"HTTP handler exposing GET /fib.\"\"\"\r\n\r\n    def do_GET(self) -> None:\r\n        parsed_url = urlparse(self.path)\r\n\r\n        if parsed_url.path != \"/fib\":\r\n            self.send_json({\"error\": \"Not Found\"}, status=404)\r\n            return\r\n\r\n        query = parse_qs(parsed_url.query, keep_blank_values=True)\r\n        raw_n = query.get(\"n\", [None])[0]\r\n\r\n        try:\r\n            n = parse_non_negative_integer(raw_n)\r\n        except ValueError as exc:\r\n            self.send_json({\"error\": str(exc)}, status=400)\r\n            return\r\n\r\n        self.send_json({\"result\": fibonacci(n)})\r\n\r\n    def send_json(self, payload: dict, status: int = 200) -> None:\r\n        body = json.dumps(payload).encode(\"utf-8\")\r\n        self.send_response(status)\r\n        self.send_header(\"Content-Type\", \"application/json\")\r\n        self.send_header(\"Content-Length\", str(len(body)))\r\n        self.end_headers()\r\n        self.wfile.write(body)\r\n\r\n    def log_message(self, format: str, *args) -> None:\r\n        \"\"\"Keep test/server output concise by suppressing default access logs.\"\"\"\r\n        return\r\n\r\n\r\ndef run_server(host: str = HOST, port: int = PORT) -> None:\r\n    server = ThreadingHTTPServer((host, port), FibRequestHandler)\r\n    print(f\"Serving Fibonacci API on http://{host}:{port}\", flush=True)\r\n    server.serve_forever()\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    run_server()\r\n"]
