[206.014918, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\ncd /app\nif [ -f server.pid ] && kill -0 \"$(cat server.pid)\" 2>/dev/null; then\n  echo \"Server already running with PID $(cat server.pid)\"\nelse\n  nohup python3 server.py > server.log 2>&1 &\n  echo $! > server.pid\n  echo \"Started server with PID $(cat server.pid)\"\nfi\nsleep 1\necho '--- server.log ---'\ncat server.log\necho '--- valid request ---'\ncurl -s -i 'http://127.0.0.1:3000/fib?n=10'\necho '\n--- missing n ---'\ncurl -s -i 'http://127.0.0.1:3000/fib'\necho '\n--- non-integer n ---'\ncurl -s -i 'http://127.0.0.1:3000/fib?n=abc'\necho '\n--- negative n ---'\ncurl -s -i 'http://127.0.0.1:3000/fib?n=-3'\ntrue; tmux wait -S done\r"]
