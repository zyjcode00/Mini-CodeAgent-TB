[?2004l[?2004h> content = 'import json\nimport threading\nimport unittest\nfrom http.client import HTTPConnection\nfrom http.server import ThreadingHTTPServer\n\nfrom server import FibRequestHandler, fibonacci, parse_non_negative_integer\n\n\ndef request(path):\n    server = ThreadingHTTPServer(("127.0.0.1", 0), FibRequestHandler)\n    thread = threading.Thread(target=server.serve_forever, daemon=True)\n    thread.start()\n    try:\n        conn = HTTPConnection("127.0.0.1", server.server_port, timeout=5)\n        conn.request("GET", path)\n        response = conn.getresponse()\n        body = response.read().decode("utf-8")\n        conn.close()\n        return response.status, json.loads(body)\n    finally:\n        server.shutdown()\n        server.server_close()\n        thread.join(timeout=5)\n\n\nclass FibonacciServerTests(unittest.TestCase):\n    def test_fibonacci_values(self):\n        self.assertEqual(fibonacci(0), 0)\n        self.assertEqual(fibonacci(1), 1)\n        self.assertEqual(fibonacci(2), 1)\n        self.assertEqual(fibonacci(7), 13)\n        self.assertEqual(fibonacci(10), 55)\n\n    def test_parse_non_negative_integer_rejects_invalid_values(self):\n        for invalid in (None, "", "abc", "1.5", "-1", "+1"):\n            with self.subTest(invalid=invalid):\n                with self.assertRaises(ValueError):\n                    parse_non_negative_integer(invalid)\n\n    def test_fib_endpoint_returns_result_json(self):\n        status, payload = request("/fib?n=10")\n        self.assertEqual(status, 200)\n        self.assertEqual(payload, {"result": 55})\n\n    def test_fib_endpoint_missing_n_returns_400(self):\n        status, payload = request("/fib")\n        self.assertEqual(status, 400)\n        self.assertIn("error", payload)\n\n    def test_fib_endpoint_blank_n_returns_400(self):\n        status, payload = request("/fib?n=")\n        self.assertEqual(status, 400)\n        self.assertIn("error", payload)\n\n    def test_fib_endpoint_non_integer_n_returns_400(self):\n        status, payload = request("/fib?n=abc")\n        self.assertEqual(status, 400)\n        self.assertIn("error", payload)\n\n    def test_fib_endpoint_negative_n_returns_400(self):\n        status, payload = request("/fib?n=-3")\n        self.assertEqual(status, 400)\n        self.assertIn("error", payload)\n\n\nif __name__ == "__main__":\n    unittest.main(verbosity=2)\n'
