[?2004l[?2004h> content = 'import json\nimport threading\nfrom http.client import HTTPConnection\nfrom http.server import ThreadingHTTPServer\n\nfrom server import FibRequestHandler, fibonacci, parse_non_negative_integer\n\n\ndef test_fibonacci_values():\n    assert fibonacci(0) == 0\n    assert fibonacci(1) == 1\n    assert fibonacci(2) == 1\n    assert fibonacci(7) == 13\n    assert fibonacci(10) == 55\n\n\ndef test_parse_non_negative_integer_rejects_invalid_values():\n    for invalid in (None, "", "abc", "1.5", "-1", "+1"):\n        try:\n            parse_non_negative_integer(invalid)\n        except ValueError:\n            pass\n        else:\n            raise AssertionError(f"Expected ValueError for {invalid!r}")\n\n\ndef request(path):\n    server = ThreadingHTTPServer(("127.0.0.1", 0), FibRequestHandler)\n    thread = threading.Thread(target=server.serve_forever, daemon=True)\n    thread.start()\n    try:\n        conn = HTTPConnection("127.0.0.1", server.server_port, timeout=5)\n        conn.request("GET", path)\n        response = conn.getresponse()\n        body = response.read().decode("utf-8")\n        conn.close()\n        return response.status, json.loads(body)\n    finally:\n        server.shutdown()\n        server.server_close()\n        thread.join(timeout=5)\n\n\ndef test_fib_endpoint_returns_result_json():\n    status, payload = request("/fib?n=10")\n    assert status == 200\n    assert payload == {"result": 55}\n\n\ndef test_fib_endpoint_missing_n_returns_400():\n    status, payload = request("/fib")\n    assert status == 400\n    assert "error" in payload\n\n\ndef test_fib_endpoint_blank_n_returns_400():\n    status, payload = request("/fib?n=")\n    assert status == 400\n    assert "error" in payload\n\n\ndef test_fib_endpoint_non_integer_n_returns_400():\n    status, payload = request("/fib?n=abc")\n    assert status == 400\n    assert "error" in payload\n\n\ndef test_fib_endpoint_negative_n_returns_400():\n    status, payload = request("/fib?n=-3")\n    assert status == 400\n    assert "error" in payload\n'
