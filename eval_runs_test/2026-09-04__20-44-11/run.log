nt_blank_n_returns_400(self):\\n        status, payload = request("/fib?n=")\\n        self.assertEqual(status, 400)\\n        self.assertIn("error", payload)\\n\\n    def test_fib_endpoint_non_integer_n_returns_400(self):\\n        status, payload = request("/fib?n=abc")\\n        self.assertEqual(status, 400)\\n        self.assertIn("error", payload)\\n\\n    def test_fib_endpoint_negative_n_returns_400(self):\\n        status, payload = request("/fib?n=-3")\\n        self.assertEqual(status, 400)\\n        self.assertIn("error", payload)\\n\\n\\nif __name__ == "__main__":\\n    unittest.main(verbosity=2)\\n\'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, \'w\', encoding=\'utf-8\', newline=\'\\n\') as f:\n        f.write(content)\n    print(f"成功: 已写入 {path}")\nexcept Exception as exc:\n    print(f"写入失败: {exc}")\nPY\ntrue', '; tmux wait -S done', 'Enter'] min_timeout_sec: 0.0 max_timeout_sec: inf
