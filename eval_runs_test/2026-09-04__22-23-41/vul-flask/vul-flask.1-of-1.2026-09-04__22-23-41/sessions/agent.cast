[186.908928, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/flask_1.1.1/test_ssti_mitigation_direct.py <<'PY'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = '# -*- coding: utf-8 -*-\\n\"\"\"Direct regression checks for render_template_string SSTI mitigation.\"\"\"\\nimport os\\nimport sys\\n\\nROOT = os.path.dirname(os.path.abspath(__file__))\\nSRC = os.path.join(ROOT, \"src\")\\nsys.path.insert(0, SRC)\\n\\nimport flask  # noqa: E402\\n\\n\\ndef make_app():\\n    app = flask.Flask(\"ssti_mitigation_direct\")\\n    app.testing = True\\n    app.secret_key = \"test key\"\\n    return app\\n\\n\\ndef test_render_template_string_does_not_evaluate_jinja_expression():\\n    app = make_app()\\n    with app.test_request_context():\\n        rv = flask.render_template_string(\"{{233*233}}\")\\n\\n    assert rv == \"{{233*233}}\", rv\\n    assert \"54289\" not in rv, rv\\n\\n\\ndef test_render_template_string_preserves_ordinary_text():\\n    app = make_app()\\n    with app.test_request_context():\\n        rv = flask.render_template_string(\"Hello, plain text!\")\\n\\n    assert rv == \"Hello, plain text!\", rv\\n\\n\\ndef test_render_template_string_escapes_html_without_executing_payload():\\n    app = make_app()\\n    with app.test_request_context():\\n        rv = flask.render_template_string(\"<b>{{233*233}}</b>\")\\n\\n    assert rv == \"&lt;b&gt;{{233*233}}&lt;/b&gt;\", rv\\n    assert \"<b>\" not in rv, rv\\n    assert \"54289\" not in rv, rv\\n\\n\\ndef test_render_template_string_route_treats_query_param_as_plain_text():\\n    app = make_app()\\n\\n    @app.route(\"/\")\\n    def index():\\n        return flask.render_template_string(flask.request.args[\"name\"])\\n\\n    client = app.test_client()\\n    rv = client.get(\"/?name={{233*233}}\")\\n\\n    assert rv.data == b\"{{233*233}}\", rv.data\\n    assert b\"54289\" not in rv.data, rv.data\\n\\n\\ndef main():\\n    tests = [\\n        test_render_template_string_does_not_evaluate_jinja_expression,\\n        test_render_template_string_preserves_ordinary_text,\\n        test_render_template_string_escapes_html_without_executing_payload,\\n        test_render_template_string_route_treats_query_param_as_plain_text,\\n    ]\\n    for test in tests:\\n        test()\\n        print(\"PASS\", test.__name__)\\n    print(\"All direct SSTI mitigation checks passed for\", flask.__file__)\\n\\n\\nif __name__ == \"__main__\":\\n    main()\\n'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, 'w', encoding='utf-8', newline='\\n') as f:\n        f.write(content)\n    print(f\"成功: 已写入 {path}\")\nexcept Exception as exc:\n    print(f\"写入失败: {exc}\")\nPY\ntrue; tmux wait -S done\r"]
