[92.182748, "o", "    text = text.replace('\\r\\n', '\\n').replace('\\r', '\\n')\r\n\u001b[?2004l\r"]
[92.18288, "o", "\u001b[?2004h> "]
[92.183134, "o", "    return '\\n'.join(line.rstrip() for line in text.split('\\n'))\r\n\u001b[?2004l\r\u001b[?2004h> "]
