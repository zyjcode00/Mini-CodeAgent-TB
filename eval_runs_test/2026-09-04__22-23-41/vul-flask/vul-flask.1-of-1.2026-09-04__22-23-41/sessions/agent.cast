[139.648458, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/flask_1.1.1/tests/test_ssti_mitigation.py <<'PY'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = '# -*- coding: utf-8 -*-\\n\"\"\"\\n    tests.test_ssti_mitigation\\n    ~~~~~~~~~~~~~~~~~~~~~~~~~~\\n\\n    Regression tests for treating render_template_string input as plain text.\\n\\n    :copyright: 2010 Pallets\\n    :license: BSD-3-Clause\\n\"\"\"\\nimport flask\\n\\n\\ndef test_render_template_string_does_not_evaluate_jinja_expression(req_ctx):\\n    rv = flask.render_template_string(\"{{233*233}}\")\\n\\n    assert rv == \"{{233*233}}\"\\n    assert \"54289\" not in rv\\n\\n\\ndef test_render_template_string_preserves_ordinary_text(req_ctx):\\n    assert flask.render_template_string(\"Hello, plain text!\") == \"Hello, plain text!\"\\n\\n\\ndef test_render_template_string_escapes_html_without_executing_payload(req_ctx):\\n    rv = flask.render_template_string(\"<b>{{233*233}}</b>\")\\n\\n    assert rv == \"&lt;b&gt;{{233*233}}&lt;/b&gt;\"\\n    assert \"<b>\" not in rv\\n    assert \"54289\" not in rv\\n\\n\\ndef test_render_template_string_route_treats_query_param_as_plain_text(app, client):\\n    @app.route(\"/\")\\n    def index():\\n        return flask.render_template_string(flask.request.args[\"name\"])\\n\\n    rv = client.get(\"/?name={{233*233}}\")\\n\\n    assert rv.data == b\"{{233*233}}\"\\n    assert b\"54289\" not in rv.data\\n'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, 'w', encoding='utf-8', newline='\\n') as f:\n        f.write(content)\n    print(f\"成功: 已写入 {path}\")\nexcept Exception as exc:\n    print(f\"写入失败: {exc}\")\nPY\ntrue; tmux wait -S done\r"]
