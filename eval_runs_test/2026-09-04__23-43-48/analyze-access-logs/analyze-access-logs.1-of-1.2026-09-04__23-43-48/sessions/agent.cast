[94.495542, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - <<'PY'\nimport re\nfrom collections import Counter\npath='/app/access_log'\nline_re=re.compile(r'^(\\S+) \\S+ \\S+ \\[[^\\]]+\\] \"\\S+ (\\S+) [^\"]+\" (\\d{3}) ')\ntotal=0\nips=set()\nurls=Counter()\nerrors404=0\nbad=[]\nwith open(path, encoding='utf-8', errors='replace') as f:\n    for lineno,line in enumerate(f,1):\n        line=line.rstrip('\\n')\n        if not line:\n            continue\n        m=line_re.match(line)\n        if not m:\n            bad.append((lineno,line))\n            continue\n        ip,url,status=m.groups()\n        total += 1\n        ips.add(ip)\n        urls[url] += 1\n        if status == '404':\n            errors404 += 1\nprint('Total requests:', total)\nprint('Unique IP addresses:', len(ips))\nprint('Top 3 URLs:')\nfor url,count in urls.most_common(3):\n    print(f'  {url}: {count}')\nprint('404 errors:', errors404)\nprint('Malformed lines:', len(bad))\nif bad[:5]:\n    print(bad[:5])\nPY\ntrue; tmux wait -S done\r"]
[94.49632, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
