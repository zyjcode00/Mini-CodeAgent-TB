[96.855081, "o", "assert rows[0]==['severity','count']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.855352, "o", "assert [r[0] for r in rows[1:]]==['ERROR','WARNING','INFO']\r\n\u001b[?2004l\r"]
