[83.786957, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/summary.csv <<'PY'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = 'severity,count\\nERROR,4\\nWARNING,3\\nINFO,8\\n'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, 'w', encoding='utf-8', newline='\\n') as f:\n        f.write(content)\n    print(f\"成功: 已写入 {path}\")\nexcept Exception as exc:\n    print(f\"写入失败: {exc}\")\nPY\ntrue; tmux wait -S done\r"]
