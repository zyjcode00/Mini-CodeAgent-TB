[96.848849, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\nprintf '%s\n' '--- /app/summary.csv ---'; cat /app/summary.csv; printf '%s\n' '--- validation ---'; python3 - <<'PY'\nfrom pathlib import Path\nimport csv\npath=Path('/app/summary.csv')\ntext=path.read_text(encoding='utf-8')\nlines=text.splitlines()\nprint('line_count=', len(lines))\nrows=list(csv.reader(lines))\nprint('rows=', rows)\nassert len(lines)==4, f'expected 4 lines, got {len(lines)}'\nassert rows[0]==['severity','count']\nassert [r[0] for r in rows[1:]]==['ERROR','WARNING','INFO']\nassert all(len(r)==2 and r[1].isdigit() for r in rows[1:])\nprint('OK')\nPY\ntrue; tmux wait -S done\r"]
[96.850068, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
[96.850412, "o", "\u001b[?2004hroot@c2646ebe8d34:/app# printf '%s\r\n\u001b[?2004l\r"]
[96.851416, "o", "\u001b[?2004h> "]
[96.852411, "o", "' '--- /app/summary.csv ---'; cat /app/summary.csv; printf '%s\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.852536, "o", "' '--- validation ---'; python3 - <<'PY'\r\n\u001b[?2004l\r"]
[96.853319, "o", "\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> import csv\r\n\u001b[?2004l\r\u001b[?2004h> path=Path('/app/summary.csv')\r\n\u001b[?2004l\r\u001b[?2004h> text=path.read_text(encoding='utf-8')\r\n\u001b[?2004l\r"]
[96.853732, "o", "\u001b[?2004h> lines=text.splitlines()\r\n\u001b[?2004l\r\u001b[?2004h"]
[96.853974, "o", "> print('line_count=', len(lines))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.854089, "o", "rows=list(csv.reader(lines))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[96.854371, "o", "print('rows=', rows)\r\n\u001b[?2004l\r"]
[96.854604, "o", "\u001b[?2004h> "]
