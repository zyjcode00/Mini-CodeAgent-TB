[73.715628, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\nfind /app/logs -type f -name '*.log' -print | sort && echo '---COUNTS---' && awk '\nBEGIN { e=0; w=0; i=0 }\n/ERROR/ { e++ }\n/WARNING/ { w++ }\n/INFO/ { i++ }\nEND { printf \"ERROR,%d\\nWARNING,%d\\nINFO,%d\\n\", e, w, i }\n' $(find /app/logs -type f -name '*.log' -print | sort)\ntrue; tmux wait -S done\r"]
