[?2004l[?2004h> content = "#!/usr/bin/env python3\nimport json\nfrom collections import defaultdict, OrderedDict\nfrom decimal import Decimal, ROUND_HALF_UP\nfrom pathlib import Path\n\nRAW_DIR = Path('/app/raw_logs')\nOUT_DIR = Path('/app/recovered_logs')\nERROR_MARKERS = ('quota exceeds', 'api error', 'timeout')\n\n\ndef load_jsonl(path):\n    records = []\n    with path.open('r', encoding='utf-8') as f:\n        for line_no, line in enumerate(f, 1):\n            line = line.strip()\n            if not line:\n                continue\n            try:\n                records.append(json.loads(line))\n            except json.JSONDecodeError as exc:\n                raise ValueError(f'{path}:{line_no}: invalid JSON: {exc}') from exc\n    return records\n\n\ndef is_error(value):\n    text = str(value).lower()\n    return any(marker in text for marker in ERROR_MARKERS)\n\n\ndef assign_runs(records, value_key):\n    by_qid = defaultdict(list)\n    for rec in records:\n        by_qid[rec['question_id']].append(rec)\n\n    runs = {1: [], 2: [], 3: []}\n    for qid in sorted(by_qid):\n        group = sorted(by_qid[qid], key=lambda r: r['timestamp'])\n        if len(group) != 3:\n            raise ValueError(f'{value_key} question_id {qid} has {len(group)} records, expected 3')\n        for idx, rec in enumerate(group, 1):\n            # Rebuild objects to enforce key order and remove any unexpected fields.\n            runs[idx].append(OrderedDict([\n                ('timestamp', rec['timestamp']),\n                ('question_id', rec['question_id']),\n                (value_key, rec[value_key]),\n            ]))\n\n    for idx in runs:\n        runs[idx].sort(key=lambda r: r['timestamp'])\n    return runs\n\n\ndef write_jsonl(path, records):\n    with path.open('w', encoding='utf-8', newline='\\n') as f:\n        for rec in records:\n            f.write(json.dumps(rec, separators=(',', ':'), ensure_ascii=False))\n            f.write('\\n')\n\n\ndef accuracy_for_run(generator_records, judge_records):\n    gen_by_qid = {r['question_id']: r for r in generator_records}\n    judge_by_qid = {r['question_id']: r for r in judge_records}\n    correct = 0\n    total = 0\n\n    for qid in sorted(set(gen_by_qid) & set(judge_by_qid)):\n        pred = gen_by_qid[qid]['prediction']\n        target = judge_by_qid[qid]['target']\n        if is_error(pred) or is_error(target):\n            continue\n        try:\n            pred_int = int(pred)\n            target_int = int(target)\n        except (TypeError, ValueError):\n            continue\n        total += 1\n        if pred_int == target_int:\n            correct += 1\n\n    if total == 0:\n        accuracy = None\n    else:\n        accuracy = float((Decimal(correct) / Decimal(total)).quantize(Decimal('0.01'), rounding=ROUND_HALF_UP))\n    return correct, total, accuracy\n\n\ndef main():\n    OUT_DIR.mkdir(parents=True, exist_ok=True)\n\n    generator_records = load_jsonl(RAW_DIR / 'generator.log')\n    judge_records = load_jsonl(RAW_DIR / 'judge.log')\n\n    gen_runs = assign_runs(generator_records, 'prediction')\n    judge_runs = assign_runs(judge_records, 'target')\n\n    results = {'runs': []}\n    for run_index in (1, 2, 3):\n        write_jsonl(OUT_DIR / f'run_{run_index}_generator.jsonl', gen_runs[run_index])\n        write_jsonl(OUT_DIR / f'run_{run_index}_judge.jsonl', judge_runs[run_index])\n        correct, total, accuracy = accuracy_for_run(gen_runs[run_index], judge_runs[run_index])\n        results['runs'].append(OrderedDict([\n            ('run_index', run_index),\n            ('correct', correct),\n            ('total', total),\n            ('accuracy', accuracy),\n        ]))\n\n    with (OUT_DIR / 'results.json').open('w', encoding='utf-8', newline='\\n') as f:\n        json.dump(results, f, indent=2, ensure_ascii=False)\n        f.write('\\n')\n\n\nif __name__ == '__main__':\n    main()\n"
