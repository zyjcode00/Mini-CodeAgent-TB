[?2004l[?2004h> content = "#!/usr/bin/env python3\nimport json\nfrom collections import defaultdict, OrderedDict\nfrom decimal import Decimal, ROUND_HALF_UP\nfrom pathlib import Path\n\nRAW_DIR = Path('/app/raw_logs')\nOUT_DIR = Path('/app/recovered_logs')\nERROR_MARKERS = ('quota exceeds', 'api error', 'timeout')\n\n\ndef load_jsonl(path):\n    return [json.loads(line) for line in path.read_text(encoding='utf-8').splitlines() if line]\n\n\ndef is_error(value):\n    text = str(value).lower()\n    return any(marker in text for marker in ERROR_MARKERS)\n\n\ndef expected_runs(raw_path, value_key):\n    by_qid = defaultdict(list)\n    for rec in load_jsonl(raw_path):\n        by_qid[rec['question_id']].append(rec)\n    assert len(by_qid) == 10\n\n    runs = {1: [], 2: [], 3: []}\n    for qid, records in by_qid.items():\n        assert len(records) == 3\n        for run_index, rec in enumerate(sorted(records, key=lambda r: r['timestamp']), 1):\n            runs[run_index].append(OrderedDict([\n                ('timestamp', rec['timestamp']),\n                ('question_id', rec['question_id']),\n                (value_key, rec[value_key]),\n            ]))\n    for run_index in runs:\n        runs[run_index].sort(key=lambda r: r['timestamp'])\n    return runs\n\n\ndef read_strict_jsonl(path, keys):\n    data = path.read_bytes()\n    assert data, f'{path} is empty'\n    assert data.endswith(b'\\n'), f'{path} must end with newline'\n    lines = data.splitlines(keepends=True)\n    assert len(lines) == 10, f'{path} should contain exactly 10 lines'\n\n    records = []\n    for i, raw_line in enumerate(lines, 1):\n        assert raw_line.endswith(b'\\n'), f'{path}:{i} missing newline'\n        assert raw_line.count(b'\\n') == 1, f'{path}:{i} should have one newline terminator'\n        line = raw_line[:-1].decode('utf-8')\n        assert line, f'{path}:{i} blank line'\n        assert ': ' not in line and ', ' not in line, f'{path}:{i} is not compact JSON'\n        rec = json.loads(line, object_pairs_hook=OrderedDict)\n        assert list(rec.keys()) == keys, f'{path}:{i} key order mismatch: {list(rec.keys())}'\n        assert json.dumps(rec, separators=(',', ':'), ensure_ascii=False) == line, f'{path}:{i} not canonical compact JSON'\n        records.append(rec)\n    assert [r['timestamp'] for r in records] == sorted(r['timestamp'] for r in records), f'{path} not sorted by timestamp'\n    assert len({r['question_id'] for r in records}) == 10, f'{path} should have one record per question_id'\n    return records\n\n\ndef compute_expected_results(gen_runs, judge_runs):\n    runs = []\n    for run_index in (1, 2, 3):\n        gen_by_qid = {r['question_id']: r for r in gen_runs[run_index]}\n        judge_by_qid = {r['question_id']: r for r in judge_runs[run_index]}\n        correct = 0\n        total = 0\n        for qid in sorted(set(gen_by_qid) & set(judge_by_qid)):\n            pred = gen_by_qid[qid]['prediction']\n            target = judge_by_qid[qid]['target']\n            if is_error(pred) or is_error(target):\n                continue\n            try:\n                pred_int = int(pred)\n                target_int = int(target)\n            except (TypeError, ValueError):\n                continue\n            total += 1\n            correct += int(pred_int == target_int)\n        accuracy = None if total == 0 else float((Decimal(correct) / Decimal(total)).quantize(Decimal('0.01'), rounding=ROUND_HALF_UP))\n        runs.append({'run_index': run_index, 'correct': correct, 'total': total, 'accuracy': accuracy})\n    return {'runs': runs}\n\n\ndef test_recovered_logs_and_results_are_correct():\n    expected_gen = expected_runs(RAW_DIR / 'generator.log', 'prediction')\n    expected_judge = expected_runs(RAW_DIR / 'judge.log', 'target')\n\n    actual_gen = {}\n    actual_judge = {}\n    for run_index in (1, 2, 3):\n        actual_gen[run_index] = read_strict_jsonl(OUT_DIR / f'run_{run_index}_generator.jsonl', ['timestamp', 'question_id', 'prediction'])\n        actual_judge[run_index] = read_strict_jsonl(OUT_DIR / f'run_{run_index}_judge.jsonl', ['timestamp', 'question_id', 'target'])\n        assert actual_gen[run_index] == expected_gen[run_index]\n        assert actual_judge[run_index] == expected_judge[run_index]\n\n    expected_results = compute_expected_results(expected_gen, expected_judge)\n    actual_results = json.loads((OUT_DIR / 'results.json').read_text(encoding='utf-8'))\n    assert actual_results == expected_results\n"
