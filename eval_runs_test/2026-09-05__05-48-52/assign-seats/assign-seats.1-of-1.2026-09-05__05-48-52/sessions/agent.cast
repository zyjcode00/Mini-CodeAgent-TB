[94.582986, "o", "content = 'from itertools import permutations\\n\\nGUESTS = [\"Alice\", \"Bob\", \"Charlie\", \"David\", \"Ethan\", \"Frankie\"]\\nN = len(GUESTS)\\n\\n\\ndef adjacent(pos, a, b):\\n    return (pos[a] - pos[b]) % N in (1, N - 1)\\n\\n\\ndef across(pos, a, b):\\n    return (pos[a] - pos[b]) % N == N // 2\\n\\n\\ndef two_left_of(pos, guest, reference):\\n    # Convention: seats increase to the left around the circular table.\\n    return pos[guest] == (pos[reference] + 2) % N\\n\\n\\ndef two_right_of(pos, guest, reference):\\n    return pos[guest] == (pos[reference] - 2) % N\\n\\n\\ndef valid(arrangement):\\n    pos = {guest: i for i, guest in enumerate(arrangement)}\\n\\n    # Alice: Alice and Frankie work at rival companies; rivals cannot sit together.\\n    if adjacent(pos, \"Alice\", \"Frankie\"):\\n        return False\\n\\n    # Bob: Bob sits two seats to Alice\\'s left; Bob refuses to sit next to Ethan.\\n    if not two_left_of(pos, \"Bob\", \"Alice\"):\\n        return False\\n    if adjacent(pos, \"Bob\", \"Ethan\"):\\n        return False\\n\\n    # Frankie: mu"]
[94.583145, "o", "st sit next to at least one of David or Ethan.\\n    if not (adjacent(pos, \"Frankie\", \"David\") or adjacent(pos, \"Frankie\", \"Ethan\")):\\n        return False\\n\\n    # Clue: if Ethan is across from Bob, David is two seats to Alice\\'s right.\\n    if across(pos, \"Ethan\", \"Bob\") and not two_right_of(pos, \"David\", \"Alice\"):\\n        return False\\n\\n    return True\\n\\n\\ndef main():\\n    # Fix Alice at seat 0 to remove rotational duplicates.\\n    valid_arrangements = []\\n    for rest in permutations([g for g in GUESTS if g != \"Alice\"]):\\n        arrangement = (\"Alice\",) + rest\\n        if valid(arrangement):\\n            valid_arrangements.append(arrangement)\\n\\n    pairs = set()\\n    for arrangement in valid_arrangements:\\n        idx = arrangement.index(\"Charlie\")\\n        pair = tuple(sorted((arrangement[(idx - 1) % N], arrangement[(idx + 1) % N])))\\n        pairs.add(pair)\\n\\n    print(\"valid arrangements:\", len(valid_arrangements))\\n    for arrangement in valid_arrangements:\\n        print(arrangement)\\n    print("]
[94.583206, "o", "\"Charlie neighbor pairs:\")\\n    for pair in sorted(pairs):\\n        print(f\"{pair[0]}, {pair[1]}\")\\n\\n\\nif __name__ == \"__main__\":\\n    main()\\n'\r\n\u001b[?2004l\r\u001b[?2004h> dir_path = os.path.dirname(path)\r\n\u001b[?2004l\r"]
