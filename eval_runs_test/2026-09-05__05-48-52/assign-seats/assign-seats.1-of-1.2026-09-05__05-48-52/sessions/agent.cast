[47.276513, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython - <<'PY'\nimport pickle, base64, pathlib, pprint\nbase=pathlib.Path('/app/deps')\nfor p in sorted(base.iterdir()):\n    print('\\n###', p.name)\n    data=p.read_bytes()\n    print('bytes', len(data), 'head', data[:40])\n    if p.suffix == '.pkl':\n        try:\n            obj=pickle.loads(data)\n            pprint.pp(obj)\n        except Exception as e:\n            print('pickle error:', repr(e))\n    elif p.suffix == '.b64':\n        try:\n            dec=base64.b64decode(data)\n            print('decoded bytes', len(dec), 'head', dec[:80])\n            try:\n                pprint.pp(pickle.loads(dec))\n            except Exception as e:\n                print('decoded text:', dec.decode('utf-8', errors='replace'))\n        except Exception as e:\n            print('b64 error:', repr(e))\n    else:\n        try:\n            print(data.decode('utf-8'))\n        except Exception as e:\n            print('text error:', repr(e))\nPY\ntrue; tmux wait -S done\r"]
[47.277247, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r\u001b[?2004hroot@625392549b2d:/app# python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h"]
