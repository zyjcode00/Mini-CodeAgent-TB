[47.563245, "o", "\r\n### ask_alice.pkl\r\nbytes 94 head b'\\x80\\x04\\x95S\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x8cOprint(\"I\\'m Alice! You shoul'\r\n"]
[47.563344, "o", "('print(\"I\\'m Alice! You should know that Frankie and I work at rival '\r\n 'companies.\")')\r\n\r\n### ask_bob.pkl\r\nbytes 150 head b'\\x80\\x04\\x95\\x8b\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x8c\\x87print(\"I\\'m Bob! My preferen'\r\n"]
[47.563567, "o", "('print(\"I\\'m Bob! My preference is that I sit two seats to the left of Alice. '\r\n 'Also, I don\\'t like Ethan, so I refuse to sit next to him.\")')\r\n\r\n### ask_charlie.b64\r\nbytes 80 head b'cHJpbnQoIlNvLi4uIHdobyBhcmUgdGhlIHR3byBw'\r\n"]
[47.563707, "o", "decoded bytes 58 head b'print(\"So... who are the two people I\\'m sitting between?\")'\r\ndecoded text: print(\"So... who are the two people I'm sitting between?\")\r\n\r\n### clue.txt\r\nbytes 115 head b\"If it's the case that Ethan ends up sitt\"\r\nIf it's the case that Ethan ends up sitting across from Bob, then David has to sit two seats to the right of Alice.\r\n\r\n### frankie_preferences.txt\r\n"]
[47.563839, "o", "bytes 127 head b\"I'm not really friends with anyone at th\"\r\nI'm not really friends with anyone at this dinner party besides David and Ethan, so I have to sit next to at least one of them.\r\n\r\n### random_fact.txt\r\nbytes 65 head b'People who work at rival companies canno'\r\n"]
[47.563985, "o", "People who work at rival companies cannot sit next to each other.\r\n"]
