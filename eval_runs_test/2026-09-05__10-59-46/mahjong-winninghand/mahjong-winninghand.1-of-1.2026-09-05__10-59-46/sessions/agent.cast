[159.566273, "o", "content = 'import re\\nfrom pathlib import Path\\n\\nimport mahjong_eval as m\\n\\n\\nEXPECTED_LINES = [\\n    \\'hand_001.json: { \"Winning hand - Seven Pairs\", \"Winning hand - Standard\" }\\',\\n    \\'hand_002.json: { \"Winning hand - Thirteen Orphans\" }\\',\\n    \\'hand_003.json: { \"Not a winning hand\" }\\',\\n    \\'hand_004.json: { \"Winning hand - Seven Pairs\" }\\',\\n    \\'hand_005.json: { \"Winning hand - Seven Pairs\", \"Winning hand - Standard\" }\\',\\n    \\'hand_006.json: { \"Winning hand - Standard\" }\\',\\n    \\'hand_007.json: { \"Winning hand - Seven Pairs\", \"Winning hand - Standard\" }\\',\\n    \\'hand_008.json: { \"Winning hand - Seven Pairs\" }\\',\\n]\\n\\n\\ndef test_process_directory_expected_results():\\n    assert m.process_directory(\"/app\") == EXPECTED_LINES\\n\\n\\ndef test_result_txt_matches_generated_output():\\n    m.main()\\n    assert Path(\"/app/result.txt\").read_text(encoding=\"utf-8\").splitlines() == EXPECTED_LINES\\n\\n\\ndef test_output_line_format():\\n    allowed = {\\n        \"Winning hand - Seven Pairs\",\\n        \"Winning hand - Standard\",\\n        \"Winning hand - Thirteen Orphans\",\\n        \"Not a winning hand\",\\n    }\\n    line_re = re.compile(r\"^hand_\\\\d{3}\\\\.json: \\\\{ (.+) \\\\}$\")\\n    for line in EXPECTED_LINES:\\n        match = line_re.match(line)\\n        assert match, line\\n        quoted_items = re.findall(r\\'\"([^\"]+)\"\\', match.group(1))\\n        assert quoted_items\\n        assert set(quoted_items) <= allowed\\n        if \"Not a winning hand\" in quoted_items:\\n            assert quoted_items == [\"Not a winning hand\"]\\n\\n\\ndef test_complete_hand_pattern_detectors():\\n    assert m.winning_patterns_for_14(m.counts_from_tiles([\\n        \"1D\", \"2D\", \"3D\", \"4B\", \"5B\", \"6B\", \"7C\", \"8C\", \"9C\",\\n        \"East\", \"East\", \"East\", \"White\", \"White\",\\n    ])) == {\"Standard\"}\\n\\n    assert m.winning_patterns_for_14(m.counts_from_tiles([\\n        \"1D\", \"1D\", \"2D\", \"2D\", \"3B\", \"3B\", \"4B\", \"4B\",\\n        \"5C\", \"5C\", \"6C\", \"6C\", \"7C\", \"7C\",\\n    ])) == {\"Seven Pairs\"}\\n\\n    assert m.winning_patterns_for_14(m.counts_from_tiles([\\n        \"1D\", \"9D\", \"1B\", \"9B\", \"1C\", \"9C\", \"East\", \"South\",\\n        \"West\", \"North\", \"Red\", \"Green\", \"White\", \"Red\",\\n    ])) == {\"Thirteen Orphans\"}\\n\\n\\ndef test_wait_patterns_include_overlap_and_none():\\n    assert m.possible_patterns_for_13([\\n        \"1D\", \"1D\", \"2D\", \"2D\", \"3D\", \"3D\", \"4B\", \"4B\", \"5B\", \"5B\", \"6B\", \"6B\", \"7C\",\\n    ]) == {\"Seven Pairs\", \"Standard\"}\\n\\n    assert m.possible_patterns_for_13([\\n        \"1D\", \"3D\", \"5D\", \"7D\", \"9D\", \"2B\", \"4B\", \"6B\", \"8B\", \"1C\", \"3C\", \"5C\", \"7C\",\\n    ]) == set()\\n'\r\n\u001b[?2004l\r"]
