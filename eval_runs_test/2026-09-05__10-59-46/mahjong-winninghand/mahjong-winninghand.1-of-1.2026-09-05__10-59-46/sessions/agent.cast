[116.771401, "o", "content = '#!/usr/bin/env python3\\n\"\"\"Evaluate 13-tile Mahjong hands for one-tile winning waits.\\n\\nThe script reads hand_*.json files in /app, determines which winning patterns can be\\nformed by adding one legal tile, and writes result.txt.\\n\"\"\"\\n\\nfrom __future__ import annotations\\n\\nimport glob\\nimport json\\nfrom collections import Counter\\nfrom functools import lru_cache\\nfrom pathlib import Path\\nfrom typing import Iterable\\n\\nSUITS = (\"D\", \"B\", \"C\")\\nSUITED_TILES = [f\"{n}{s}\" for s in SUITS for n in range(1, 10)]\\nHONOR_TILES = [\"East\", \"South\", \"West\", \"North\", \"Red\", \"Green\", \"White\"]\\nALL_TILES = SUITED_TILES + HONOR_TILES\\nTILE_INDEX = {tile: i for i, tile in enumerate(ALL_TILES)}\\n\\nORPHAN_TILES = {\\n    \"1D\", \"9D\", \"1B\", \"9B\", \"1C\", \"9C\",\\n    \"East\", \"South\", \"West\", \"North\", \"Red\", \"Green\", \"White\",\\n}\\n\\nPATTERN_LABELS = {\\n    \"Seven Pairs\": \"Winning hand - Seven Pairs\",\\n    \"Standard\": \"Winning hand - Standard\",\\n    \"Thirteen Orphans\": \"Winning hand - Thirteen Orphans\",\\n}\\nPATTERN_OUTPUT_ORDER = [\"Seven Pairs\", \"Standard\", \"Thirteen Orphans\"]\\n\\n\\ndef counts_from_tiles(tiles: Iterable[str]) -> tuple[int, ...]:\\n    \"\"\"Convert tile strings to a 34-length count tuple, validating tile names.\"\"\"\\n    counts = [0] * len(ALL_TILES)\\n    for tile in tiles:\\n        if tile not in TILE_INDEX:\\n            raise ValueError(f\"Unknown tile: {tile}\")\\n        counts[TILE_INDEX[tile]] += 1\\n        if counts[TILE_INDEX[tile]] > 4:\\n            raise ValueError(f\"Too many copies of tile: {tile}\")\\n    return tuple(counts)\\n\\n\\ndef is_seven_pairs(counts: tuple[int, ...]) -> bool:\\n    \"\"\"Return True if a 14-tile count vector is exactly seven pairs.\"\"\"\\n    return sum(counts) == 14 and sum(1 for count in counts if count == 2) == 7\\n\\n\\ndef is_thirteen_orphans(counts: tuple[int, ...]) -> bool:\\n    \"\"\"Return True if a 14-tile count vector is thirteen orphans.\"\"\"\\n    if sum(counts) != 14:\\n        return False\\n    duplicate_found = False\\n    for tile, idx in TILE_INDEX.items():\\n        count = counts[idx]\\n        if tile in ORPHAN_TILES:\\n            if count == 0:\\n                return False\\n            if count == 2:\\n                if duplicate_found:\\n                    return False\\n                duplicate_found = True\\n            elif count != 1:\\n                return False\\n        elif count != 0:\\n            return False\\n    return duplicate_found\\n\\n\\ndef is_standard(counts: tuple[int, ...]) -> bool:\\n    \"\"\"Return True if counts can be arranged as 4 melds plus 1 pair.\"\"\"\\n    if sum(counts) != 14:\\n        return False\\n\\n    @lru_cache(maxsize=None)\\n    def can_form_melds(state: tuple[int, ...]) -> bool:\\n        try:\\n            first = next(i for i, count in enumerate(state) if count)\\n        except StopIteration:\\n            return True\\n\\n        state_list = list(state)\\n\\n        # Pung: three identical tiles.\\n        if state_list[first] >= 3:\\n            state_list[first] -= 3\\n            if can_form_melds(tuple(state_list)):\\n                return True\\n            state_list[first] += 3\\n\\n        # Chow: three consecutive suited tiles in the same suit.\\n        tile = ALL_TILES[first]\\n        if len(tile) == 2 and tile[0].isdigit():\\n            number = int(tile[0])\\n            suit = tile[1]\\n            if number <= 7:\\n                second = TILE_INDEX.get(f\"{number + 1}{suit}\")\\n                third = TILE_INDEX.get(f\"{number + 2}{suit}\")\\n                if second is not None and third is not None and state_list[second] and state_list[third]:\\n                    state_list[first] -= 1\\n                    state_list[second] -= 1\\n                    state_list[third] -= 1\\n                    if can_form_melds(tuple(state_list)):\\n                        return True\\n        return False\\n\\n    for pair_idx, count in enumerate(counts):\\n        if count >= 2:\\n            remaining = list(counts)\\n            remaining[pair_idx] -= 2\\n            if can_form_melds(tuple(remaining)):\\n                return True\\n    return False\\n\\n\\ndef winning_patterns_for"]
[116.771734, "o", "_14(counts: tuple[int, ...]) -> set[str]:\\n    \"\"\"Return winning pattern names satisfied by a complete 14-tile hand.\"\"\"\\n    patterns: set[str] = set()\\n    if is_seven_pairs(counts):\\n        patterns.add(\"Seven Pairs\")\\n    if is_standard(counts):\\n        patterns.add(\"Standard\")\\n    if is_thirteen_orphans(counts):\\n        patterns.add(\"Thirteen Orphans\")\\n    return patterns\\n\\n\\ndef possible_patterns_for_13(tiles: list[str]) -> set[str]:\\n    \"\"\"Return all winning patterns achievable after adding one legal tile.\"\"\"\\n    if len(tiles) != 13:\\n        raise ValueError(f\"Expected 13 tiles, got {len(tiles)}\")\\n    base_counts = list(counts_from_tiles(tiles))\\n    patterns: set[str] = set()\\n    for idx in range(len(ALL_TILES)):\\n        if base_counts[idx] >= 4:\\n            continue\\n        trial = base_counts.copy()\\n        trial[idx] += 1\\n        patterns.update(winning_patterns_for_14(tuple(trial)))\\n    return patterns\\n\\n\\ndef format_patterns(patterns: set[str]) -> str:\\n    \"\"\"Format pattern names as the required brace-enclosed quoted set.\"\"\"\\n    if not patterns:\\n        return \\'{ \"Not a winning hand\" }\\'\\n    labels = [PATTERN_LABELS[name] for name in PATTERN_OUTPUT_ORDER if name in patterns]\\n    return \"{ \" + \", \".join(f\\'\"{label}\"\\' for label in labels) + \" }\"\\n\\n\\ndef process_directory(directory: str | Path = \"/app\") -> list[str]:\\n    \"\"\"Process all hand_*.json files and return formatted result lines.\"\"\"\\n    directory = Path(directory)\\n    lines: list[str] = []\\n    for path_str in sorted(glob.glob(str(directory / \"hand_*.json\"))):\\n        path = Path(path_str)\\n        with path.open(\"r\", encoding=\"utf-8\") as fh:\\n            tiles = json.load(fh)\\n        if not isinstance(tiles, list) or not all(isinstance(tile, str) for tile in tiles):\\n            raise ValueError(f\"{path.name} must contain a JSON array of tile strings\")\\n        patterns = possible_patterns_for_13(tiles)\\n        lines.append(f\"{path.name}: {format_patterns(patterns)}\")\\n    return lines\\n\\n\\ndef main() -> None:\\n    directory = Path(\"/app\")\\n    lines = process_directory(directory)\\n    (directory / \"result.txt\").write_text(\"\\\\n\".join(lines) + \"\\\\n\", encoding=\"utf-8\")\\n\\n\\nif __name__ == \"__main__\":\\n    main()\\n'\r\n\u001b[?2004l\r\u001b[?2004h> dir_path = os.path.dirname(path)\r\n\u001b[?2004l\r\u001b[?2004h> if dir_path:\r\n\u001b[?2004l\r"]
