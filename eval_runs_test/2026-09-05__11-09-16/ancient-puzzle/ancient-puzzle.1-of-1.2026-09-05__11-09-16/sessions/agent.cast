[87.854266, "o", "\u001b[?2004hroot@b862b856e1ea:/app# "]
[99.024575, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\nset -o pipefail\nprintf '--- DNS ---\\n'\ngetent hosts decryptor || true\nprintf '\\n--- ping/port probes ---\\n'\n(ping -c 1 -W 1 decryptor || true) 2>&1 | sed -n '1,20p'\nfor host in decryptor 172.28.0.2 localhost 127.0.0.1; do\n  for path in / /decrypt /health; do\n    echo \"--- curl http://$host:8090$path ---\"\n    curl -sS --connect-timeout 2 --max-time 5 -i \"http://$host:8090$path\" 2>&1 | sed -n '1,40p' || true\n  done\ndone\nprintf '\\n--- POST retry ---\\n'\nfor i in 1 2 3 4 5; do\n  echo \"attempt $i\"\n  curl -sS --connect-timeout 2 --max-time 10 -i -X POST http://decryptor:8090/decrypt -H 'Content-Type: application/json' -d '{\"incantation\":\"ECHOES-OF-CYPRESS\"}' 2>&1 | tee /tmp/decryptor_response_${i}.txt\n  sleep 1\ndone\ntrue; tmux wait -S done\r"]
