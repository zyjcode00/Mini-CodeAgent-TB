[791.149703, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - test_hydra_configs.py <<'PY'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = 'import subprocess\\nimport sys\\nfrom pathlib import Path\\n\\nimport yaml\\n\\n\\nAPP = Path(__file__).resolve().parent / \"main.py\"\\n\\n\\ndef run_main(*args: str) -> str:\\n    result = subprocess.run(\\n        [sys.executable, str(APP), *args],\\n        check=True,\\n        text=True,\\n        stdout=subprocess.PIPE,\\n        stderr=subprocess.PIPE,\\n    )\\n    return result.stdout\\n\\n\\ndef test_debug_mode_job_config_matches_expected_output():\\n    stdout = run_main(\"+mode=debug\", \"--cfg\", \"job\")\\n    assert stdout == (\\n        \"notes: my-experiment\\\\n\"\\n        \"debug: true\\\\n\"\\n        \"train:\\\\n\"\\n        \"  batch_size: 32\\\\n\"\\n        \"  learning_rate: 1.0e-05\\\\n\"\\n        \"  max_num_epochs: 1\\\\n\"\\n    )\\n\\n\\ndef test_slurm_job_config_matches_base_job_config():\\n    stdout = run_main(\"-cn=slurm\", \"--cfg\", \"job\")\\n    assert stdout == (\\n        \"notes: my-experiment\\\\n\"\\"]
[791.149863, "i", "n        \"debug: false\\\\n\"\\n        \"train:\\\\n\"\\n        \"  batch_size: 32\\\\n\"\\n        \"  learning_rate: 1.0e-05\\\\n\"\\n        \"  max_num_epochs: 100\\\\n\"\\n    )\\n\\n\\ndef test_slurm_hydra_config_uses_submitit_launcher_with_cluster_parameters():\\n    stdout = run_main(\"-cn=slurm\", \"--cfg\", \"hydra\")\\n    cfg = yaml.safe_load(stdout)\\n    launcher = cfg[\"hydra\"][\"launcher\"]\\n\\n    assert launcher[\"_target_\"] == (\\n        \"hydra_plugins.hydra_submitit_launcher.submitit_launcher.SlurmLauncher\"\\n    )\\n    assert launcher[\"additional_parameters\"] == {\"wckey\": \"\"}\\n    assert \"--cpu-bind=none\" in launcher[\"srun_args\"]\\n'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, 'w', encoding='utf-8', newline='\\n') as f:\n        f.write(content)\n    print(f\"成功: 已写入 {path}\")\nexcept Exception as exc:\n    print(f\"写入失败: {exc}\")\nPY\ntrue; tmux wait -S done\r"]
