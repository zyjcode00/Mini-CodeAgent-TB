[85.905364, "o", "content = '#include \"sum_array.h\"\\n\\n#include <array>\\n#include <type_traits>\\n\\nint main()\\n{\\n    constexpr std::array<int, 4> values = {{1, 2, 3, 4}};\\n    static_assert(sum_array(values) == 10, \"sum_array should be constexpr-compatible in C++11\");\\n    static_assert(std::is_same<decltype(sum_array(values)), int>::value,\\n                  \"sum_array public return type should remain T\");\\n\\n    std::array<double, 3> doubles = {{1.5, 2.0, 3.5}};\\n    return sum_array(doubles) == 7.0 ? 0 : 1;\\n}\\n'\r\n\u001b[?2004l\r"]
