[27.957893, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\nif [ -f /app/sum_array.h ]; then cat -- /app/sum_array.h; else echo '错误: 找不到文件 /app/sum_array.h'; fi\ntrue; tmux wait -S done\r"]
