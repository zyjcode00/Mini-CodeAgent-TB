[85.726959, "i", "ytes, record_len: int) -> list[bytes]:\\n    \"\"\"Split data into COBOL-style fixed records, ignoring no full-record logic.\\n\\n    For the .DAT files used by this program, records are exactly concatenated.\\n    If a trailing partial record exists, GnuCOBOL can still read a short line for\\n    line-sequential inputs; padding with spaces best matches fixed PIC X fields\\n    and keeps validation behavior predictable.\\n    \"\"\"\\n    if not data:\\n        return []\\n    records: list[bytes] = []\\n    for start in range(0, len(data), record_len):\\n        rec = data[start : start + record_len]\\n        if len(rec) < record_len:\\n            rec = rec + b\" \" * (record_len - len(rec))\\n        records.append(rec)\\n    return records\\n\\n\\ndef _field(rec: bytes, start: int, length: int) -> str:\\n    return rec[start : start + length].decode(\"ascii\", errors=\"strict\")\\n\\n\\ndef _parse_display_number(raw: bytes) -> int:\\n    \"\"\"Parse unsigned DISPLAY numeric bytes as COBOL numeric text.\\n\\n    Valid data is zero-padded digits."]
[85.72703, "i", "  Spaces can appear only from a short input\\n    record; treating them as zero is sufficient for paths that later perform\\n    arithmetic and mirrors COBOL\\'s display-numeric intent for this challenge.\\n    \"\"\"\\n    text = raw.decode(\"ascii\", errors=\"strict\")\\n    digits = \"\".join(ch if ch.isdigit() else \"0\" for ch in text)\\n    return int(digits or \"0\")\\n\\n\\ndef _format_pic_9_10(value: int) -> bytes:\\n    \"\"\"Format as PIC 9(10) DISPLAY, matching zero-filled positive output.\"\"\"\\n    # COBOL PIC 9(10) in this program is intended for non-negative values.\\n    # Keep the rightmost 10 characters if an overlarge value is ever produced,\\n    # which is the practical fixed-width representation available here.\\n    return f\"{value:010d}\"[-10:].encode(\"ascii\")\\n\\n\\ndef _read_input() -> tuple[str, str, str, int] | None:\\n    data = _read_bytes(INPUT_FILE)\\n    if not data:\\n        return None\\n    rec = data[:INPUT_LEN]\\n    if len(rec) < INPUT_LEN:\\n        rec = rec + b\" \" * (INPUT_LEN - len(rec))\\n    buyer_id = _f"]
