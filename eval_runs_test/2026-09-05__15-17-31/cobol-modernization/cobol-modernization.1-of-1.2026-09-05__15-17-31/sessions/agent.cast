[141.836245, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/test_compare.py <<'PY'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = '#!/usr/bin/env python3\\n\"\"\"Comparison tests for program.cbl vs program.py.\\n\\nThe tests run each implementation in an isolated temporary /app-like directory\\nso the repository data files are not mutated.  They compare the exact bytes of\\nACCOUNTS.DAT, BOOKS.DAT, and TRANSACTIONS.DAT after execution.\\n\"\"\"\\n\\nfrom __future__ import annotations\\n\\nimport shutil\\nimport subprocess\\nfrom pathlib import Path\\n\\nimport pytest\\n\\nROOT = Path(\"/app\")\\nDAT_FILES = (\"ACCOUNTS.DAT\", \"BOOKS.DAT\", \"TRANSACTIONS.DAT\")\\n\\nBASE_ACCOUNTS = (\\n    b\"U001John Doe            0000001180\"\\n    b\"U002Jane Smith          0000001800\"\\n    b\"U003Bob Wilson          0000001520\"\\n)\\nBASE_BOOKS = (\\n    b\"B001Python Basics       U002\"\\n    b\"B002COBOL Guide         U002\"\\n    b\"B003Java Tutorial       U002\"\\n)\\nBASE_TRANSACTIONS = (\\n    b\"B0030000000020U003U001\"\\n    b\"B0030000000050U001U002\"\\n    "]
[141.836567, "i", "b\"B0010000000150U001U002\"\\n)\\n\\n\\n@pytest.fixture(scope=\"session\")\\ndef cobol_executable(tmp_path_factory: pytest.TempPathFactory) -> Path:\\n    if shutil.which(\"cobc\") is None:\\n        pytest.skip(\"GnuCOBOL cobc is not installed\")\\n    exe = tmp_path_factory.mktemp(\"cobol_build\") / \"bookforum\"\\n    subprocess.run(\\n        [\"cobc\", \"-x\", \"-o\", str(exe), str(ROOT / \"src\" / \"program.cbl\")],\\n        check=True,\\n        cwd=ROOT,\\n    )\\n    return exe\\n\\n\\ndef make_app_dir(tmp_path: Path, name: str, input_bytes: bytes) -> Path:\\n    app_dir = tmp_path / name\\n    (app_dir / \"src\").mkdir(parents=True)\\n    (app_dir / \"data\").mkdir()\\n    shutil.copy2(ROOT / \"src\" / \"program.cbl\", app_dir / \"src\" / \"program.cbl\")\\n    shutil.copy2(ROOT / \"program.py\", app_dir / \"program.py\")\\n    (app_dir / \"src\" / \"INPUT.DAT\").write_bytes(input_bytes)\\n    (app_dir / \"data\" / \"ACCOUNTS.DAT\").write_bytes(BASE_ACCOUNTS)\\n    (app_dir / \"data\" / \"BOOKS.DAT\").write_bytes(BASE_BOOKS)\\n    (app_dir / \"data\" / \"TRANSACTIONS.DAT\").wr"]
