Sending keys: ['export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/program.py <<\'PY\'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = \'#!/usr/bin/env python3\\n"""Python reimplementation of src/program.cbl (BOOKFORUM).\\n\\nThe COBOL program uses fixed-width sequential files with no record separators in\\nthis dataset.  This script preserves that layout byte-for-byte for the supported\\nASCII records.\\n"""\\n\\nfrom __future__ import annotations\\n\\nfrom pathlib import Path\\n\\nBASE_DIR = Path(__file__).resolve().parent\\nSRC_DIR = BASE_DIR / "src"\\nDATA_DIR = BASE_DIR / "data"\\n\\nINPUT_FILE = SRC_DIR / "INPUT.DAT"\\nACCOUNTS_FILE = DATA_DIR / "ACCOUNTS.DAT"\\nBOOKS_FILE = DATA_DIR / "BOOKS.DAT"\\nTRANSACTIONS_FILE = DATA_DIR / "TRANSACTIONS.DAT"\\n\\nACCOUNT_LEN = 34  # X(4) + X(20) + 9(10)\\nBOOK_LEN = 28     # X(4) + X(20) + X(4)\\nTRANS_LEN = 22    # X(4) + 9(10) + X(4) + X(4)\\nINPUT_LEN = 22    # X(4) + X(4) + X(4) + 9(10)\\n\\n\\ndef _read_bytes(path: Path) -> bytes:\\n    return path.read_bytes()\\n\\n\\ndef _chunks(data: bytes, record_len: int) -> list[bytes]:\\n    """Split data into COBOL-style fixed records, ignoring no full-record logic.\\n\\n    For the .DAT files used by this program, records are exactly concatenated.\\n    If a trailing partial record exists, GnuCOBOL can still read a short line for\\n    line-sequential inputs; padding with spaces best matches fixed PIC X fields\\n    and keeps validation behavior predictable.\\n    """\\n    if not data:\\n        return []\\n    records: list[bytes] = []\\n    for start in range(0, len(data), record_len):\\n        rec = data[start : start + record_len]\\n        if len(rec) < record_len:\\n            rec = rec + b" " * (record_len - len(rec))\\n        records.append(rec)\\n    return records\\n\\n\\ndef _field(rec: bytes, start: int, length: int) -> str:\\n    return rec[start : start + length].decode("ascii", errors="strict")\\n\\n\\ndef _parse_display_number(raw: bytes) -> int:\\n    """Parse unsigned DISPLAY numeric bytes as COBOL numeric text.\\n\\n    Valid data is zero-padded digits.  Spaces can appear only from a short input\\n    record; treating them as zero is sufficient for paths that later perform\\n    arithmetic and mirrors COBOL\\\'s display-numeric intent for this challenge.\\n    """\\n    text = raw.decode("ascii", errors="strict")\\n    digits = "".join(ch if ch.isdigit() else "0" for ch in text)\\n    return int(digits or "0")\\n\\n\\ndef _format_pic_9_10(value: int) -> bytes:\\n    """Format as PIC 9(10) DISPLAY, matching zero-filled positive output."""\\n    # COBOL PIC 9(10) in this program is intended for non-negative values.\\n    # Keep the rightmost 10 characters if an overlarge value is ever produced,\\n    # which is the practical fixed-width representation available here.\\n    return f"{value:010d}"[-10:].encode("ascii")\\n\\n\\ndef _read_input() -> tuple[str, str, str, int] | None:\\n    data = _read_bytes(INPUT_FILE)\\n    if not data:\\n        return None\\n    rec = data[:INPUT_LEN]\\n    if len(rec) < INPUT_LEN:\\n        rec = rec + b" " * (INPUT_LEN - len(rec))\\n    buyer_id = _field(rec, 0, 4)\\n    seller_id = _field(rec, 4, 4)\\n    book_id = _field(rec, 8, 4)\\n    amount = _parse_display_number(rec[12:22])\\n    return buyer_id, seller_id, book_id, amount\\n\\n\\ndef main() -> None:\\n    input_record = _read_input()\\n    if input_record is None:\\n        print("Error: Input file is empty")\\n        return\\n\\n    buyer_id, seller_id, book_id, amount = input_record\\n\\n    account_records = _chunks(_read_bytes(ACCOUNTS_FILE), ACCOUNT_LEN)\\n    book_records = _chunks(_read_bytes(BOOKS_FILE), BOOK_LEN)\\n\\n    buyer_found = False\\n    seller_found = False\\n    book_found = False\\n    valid_owner = False\\n\\n    for rec in account_records:\\n        account_id = _field(rec, 0, 4)\\n        if account_id == buyer_id:\\n            buyer_found = True\\n        if account_id == seller_id:\\n            seller_found = True\\n\\n    for rec in book_records:\\n        current_book_id = _field(rec, 0, 4)\\n        if current_book_id == book_id:\\n            book_found = True\\n            if _field(rec, 24, 4) == seller_id:\\n                valid_owner = True\\n\\n    # VALIDATE-USERS-AND-BOOK ends with DISPLAY " ".\\n    print(" ")\\n\\n    if buyer_found and seller_found and book_found and valid_owner:\\n        new_account_records: list[bytes] = []\\n        for rec in account_records:\\n            account_id = _field(rec, 0, 4)\\n            balance = _parse_display_number(rec[24:34])\\n            if account_id == buyer_id:\\n                balance -= amount\\n                rec = rec[:24] + _format_pic_9_10(balance)\\n            if account_id == seller_id:\\n                balance = _parse_display_number(rec[24:34])\\n                balance += amount\\n                rec = rec[:24] + _format_pic_9_10(balance)\\n            new_account_records.append(rec)\\n        ACCOUNTS_FILE.write_bytes(b"".join(new_account_records))\\n\\n        new_book_records: list[bytes] = []\\n        for rec in book_records:\\n            if _field(rec, 0, 4) == book_id:\\n                rec = rec[:24] + buyer_id.encode("ascii")\\n            new_book_records.append(rec)\\n        BOOKS_FILE.write_bytes(b"".join(new_book_records))\\n\\n        trans_record = (\\n            book_id.encode("ascii")\\n            + _format_pic_9_10(amount)\\n            + seller_id.encode("ascii")\\n            + buyer_id.encode("ascii")\\n        )\\n        with TRANSACTIONS_FILE.open("ab") as f:\\n            f.write(trans_record)\\n\\n        print("Transaction completed successfully")\\n    else:\\n        print("Transaction failed due to validation errors")\\n\\n\\nif __name__ == "__main__":\\n    main()\\n\'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, \'w\', encoding=\'utf-8\', newline=\'\\n\') as f:\n        f.write(content)\n    print(f"成功: 已写入 {path}")\nexcept Exception as exc:\n    print(f"写入失败: {exc}")\nPY\ntrue', '; tmux wait -S done', 'Enter'] min_timeout_sec: 0.0 max_timeout_sec: inf
