Sending keys: ['export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/test_compare.py <<\'PY\'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = \'#!/usr/bin/env python3\\n"""Standalone comparison test for program.cbl vs program.py.\\n\\nRuns each implementation in isolated temporary /app-like directories and compares\\nexact bytes of ACCOUNTS.DAT, BOOKS.DAT, and TRANSACTIONS.DAT after execution.\\nThis file intentionally uses only the Python standard library because pytest may\\nnot be installed in the execution environment.\\n"""\\n\\nfrom __future__ import annotations\\n\\nimport shutil\\nimport subprocess\\nimport sys\\nimport tempfile\\nfrom pathlib import Path\\n\\nROOT = Path("/app")\\nDAT_FILES = ("ACCOUNTS.DAT", "BOOKS.DAT", "TRANSACTIONS.DAT")\\n\\nBASE_ACCOUNTS = (\\n    b"U001John Doe            0000001180"\\n    b"U002Jane Smith          0000001800"\\n    b"U003Bob Wilson          0000001520"\\n)\\nBASE_BOOKS = (\\n    b"B001Python Basics       U002"\\n    b"B002COBOL Guide         U002"\\n    b"B003Java Tutorial       U002"\\n)\\nBASE_TRANSACTIONS = (\\n    b"B0030000000020U003U001"\\n    b"B0030000000050U001U002"\\n    b"B0010000000150U001U002"\\n)\\n\\nTEST_INPUTS = [\\n    # Current invalid sample shape: book B007 does not exist; no DAT changes.\\n    b"U001U002B007200",\\n    # Valid sale of B001 from U002 to U001 for 200.\\n    b"U001U002B0010000000200",\\n    # Valid sale of B003 from U002 to U003 for 50.\\n    b"U003U002B0030000000050",\\n    # Existing book but wrong seller/owner; no DAT changes.\\n    b"U001U003B0010000000025",\\n    # Unknown buyer; no DAT changes.\\n    b"U999U002B0010000000025",\\n]\\n\\n\\ndef build_cobol_executable(work_dir: Path) -> Path:\\n    if shutil.which("cobc") is None:\\n        raise RuntimeError("GnuCOBOL cobc is not installed")\\n    exe = work_dir / "bookforum"\\n    subprocess.run(\\n        ["cobc", "-x", "-o", str(exe), str(ROOT / "src" / "program.cbl")],\\n        check=True,\\n        cwd=ROOT,\\n    )\\n    return exe\\n\\n\\ndef make_app_dir(parent: Path, name: str, input_bytes: bytes) -> Path:\\n    app_dir = parent / name\\n    (app_dir / "src").mkdir(parents=True)\\n    (app_dir / "data").mkdir()\\n    shutil.copy2(ROOT / "src" / "program.cbl", app_dir / "src" / "program.cbl")\\n    shutil.copy2(ROOT / "program.py", app_dir / "program.py")\\n    (app_dir / "src" / "INPUT.DAT").write_bytes(input_bytes)\\n    (app_dir / "data" / "ACCOUNTS.DAT").write_bytes(BASE_ACCOUNTS)\\n    (app_dir / "data" / "BOOKS.DAT").write_bytes(BASE_BOOKS)\\n    (app_dir / "data" / "TRANSACTIONS.DAT").write_bytes(BASE_TRANSACTIONS)\\n    return app_dir\\n\\n\\ndef run_cobol(cobol_executable: Path, app_dir: Path) -> subprocess.CompletedProcess[str]:\\n    return subprocess.run(\\n        [str(cobol_executable)],\\n        cwd=app_dir,\\n        check=True,\\n        text=True,\\n        stdout=subprocess.PIPE,\\n        stderr=subprocess.PIPE,\\n    )\\n\\n\\ndef run_python(app_dir: Path) -> subprocess.CompletedProcess[str]:\\n    return subprocess.run(\\n        ["python3", "program.py"],\\n        cwd=app_dir,\\n        check=True,\\n        text=True,\\n        stdout=subprocess.PIPE,\\n        stderr=subprocess.PIPE,\\n    )\\n\\n\\ndef read_dat_outputs(app_dir: Path) -> dict[str, bytes]:\\n    return {name: (app_dir / "data" / name).read_bytes() for name in DAT_FILES}\\n\\n\\ndef show_bytes(data: bytes) -> str:\\n    return data.hex(" ")\\n\\n\\ndef compare_case(cobol_executable: Path, parent: Path, index: int, input_bytes: bytes) -> None:\\n    case_dir = parent / f"case_{index}"\\n    cobol_app = make_app_dir(case_dir, "cobol_app", input_bytes)\\n    python_app = make_app_dir(case_dir, "python_app", input_bytes)\\n\\n    cobol_result = run_cobol(cobol_executable, cobol_app)\\n    python_result = run_python(python_app)\\n\\n    if python_result.returncode != cobol_result.returncode:\\n        raise AssertionError(\\n            f"case {index}: return code mismatch: "\\n            f"cobol={cobol_result.returncode}, python={python_result.returncode}"\\n        )\\n\\n    cobol_outputs = read_dat_outputs(cobol_app)\\n    python_outputs = read_dat_outputs(python_app)\\n    if python_outputs != cobol_outputs:\\n        details = [f"case {index}: DAT output mismatch for input {input_bytes!r}"]\\n        for name in DAT_FILES:\\n            if python_outputs[name] != cobol_outputs[name]:\\n                details.append(f"  {name}:")\\n                details.append(f"    COBOL : {show_bytes(cobol_outputs[name])}")\\n                details.append(f"    Python: {show_bytes(python_outputs[name])}")\\n        raise AssertionError("\\\\n".join(details))\\n\\n\\ndef main() -> int:\\n    with tempfile.TemporaryDirectory(prefix="bookforum_compare_") as tmp:\\n        work_dir = Path(tmp)\\n        cobol_executable = build_cobol_executable(work_dir)\\n        for index, input_bytes in enumerate(TEST_INPUTS, start=1):\\n            compare_case(cobol_executable, work_dir, index, input_bytes)\\n            print(f"case {index} ok")\\n    print("all COBOL/Python DAT comparisons passed")\\n    return 0\\n\\n\\nif __name__ == "__main__":\\n    try:\\n        raise SystemExit(main())\\n    except Exception as exc:\\n        print(f"TEST FAILED: {exc}", file=sys.stderr)\\n        raise\\n\'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, \'w\', encoding=\'utf-8\', newline=\'\\n\') as f:\n        f.write(content)\n    print(f"成功: 已写入 {path}")\nexcept Exception as exc:\n    print(f"写入失败: {exc}")\nPY\ntrue', '; tmux wait -S done', 'Enter'] min_timeout_sec: 0.0 max_timeout_sec: inf
