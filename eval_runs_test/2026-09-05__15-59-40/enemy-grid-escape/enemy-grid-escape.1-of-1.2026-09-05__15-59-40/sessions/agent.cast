[131.559084, "o", "for t in range(200,0,-1):\r\n\u001b[?2004l\r\u001b[?2004h>     new={}\r\n\u001b[?2004l\r\u001b[?2004h>     pol={}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.55928, "o", "    for s in states:\r\n\u001b[?2004l\r\u001b[?2004h"]
[131.559391, "o", "> "]
[131.55969, "o", "        opts=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.559874, "o", "        for a in range(4):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.560016, "o", "            ns=step(s,a)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.560259, "o", "            if ns is not None and survive.get(ns,False):\r\n\u001b[?2004l\r\u001b[?2004h"]
[131.560404, "o", "> "]
[131.560535, "o", "                opts.append((a,ns))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.560674, "o", "        new[s]=bool(opts)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.560884, "o", "        if opts: pol[s]=opts[0][0]\r\n\u001b[?2004l\r"]
[131.560986, "o", "\u001b[?2004h> "]
[131.561101, "o", "    survive=new; policy=pol\r\n\u001b[?2004l\r"]
[131.561155, "o", "\u001b[?2004h"]
[131.561165, "o", "> "]
[131.561301, "o", "init=((0,0),(9,9))\r\n\u001b[?2004l\r"]
[131.561343, "o", "\u001b[?2004h> "]
[131.561684, "o", "print('init survivable 200?', survive.get(init), 'action', policy.get(init))\r\n\u001b[?2004l\r\u001b[?2004h"]
[131.561818, "o", "> "]
[131.562171, "o", "# greedily follow recomputing from final policy? Let's compute infinite winning set greatest fixed point.\r\n\u001b[?2004l\r\u001b[?2004h"]
[131.562269, "o", "> "]
[131.562361, "o", "W=set(states)\r\n\u001b[?2004l\r"]
[131.562402, "o", "\u001b[?2004h> changed=True; it=0\r\n\u001b[?2004l\r"]
[131.562511, "o", "\u001b[?2004h> "]
[131.562655, "o", "while changed:\r\n\u001b[?2004l\r\u001b[?2004h"]
[131.562778, "o", ">     it+=1; NW=set(); pol={}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.562905, "o", "    for s in W:\r\n\u001b[?2004l\r"]
[131.562996, "o", "\u001b[?2004h> "]
[131.563339, "o", "        for a in range(4):\r\n\u001b[?2004l\r\u001b[?2004h"]
[131.563408, "o", "> "]
[131.563548, "o", "            ns=step(s,a)\r\n\u001b[?2004l\r"]
[131.564118, "o", "\u001b[?2004h>             if ns in W:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.564196, "o", "                NW.add(s); pol[s]=a; break\r\n\u001b[?2004l\r\u001b[?2004h"]
[131.564228, "o", "> "]
[131.564531, "o", "    changed=(NW!=W); W=NW\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.56473, "o", "    print('iter',it,'W',len(W))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.56493, "o", "print('init in W',init in W,'action',pol.get(init))\r\n\u001b[?2004l\r"]
[131.565031, "o", "\u001b[?2004h> s=init\r\n\u001b[?2004l\r"]
[131.565085, "o", "\u001b[?2004h> "]
[131.565219, "o", "seen={}\r\n\u001b[?2004l\r"]
[131.565294, "o", "\u001b[?2004h> "]
[131.565434, "o", "for t in range(300):\r\n\u001b[?2004l\r\u001b[?2004h"]
[131.565542, "o", "> "]
[131.565601, "o", "    if s in seen:\r\n\u001b[?2004l\r"]
[131.565631, "o", "\u001b[?2004h> "]
[131.56592, "o", "        print('cycle at',t,'from',seen[s], 'state',s); break\r\n\u001b[?2004l\r"]
[131.565965, "o", "\u001b[?2004h> "]
[131.566092, "o", "    seen[s]=t\r\n\u001b[?2004l\r\u001b[?2004h"]
[131.566261, "o", "> "]
[131.566302, "o", "    a=pol.get(s)\r\n\u001b[?2004l\r"]
[131.566345, "o", "\u001b[?2004h> "]
[131.566465, "o", "    if a is None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[131.56653, "o", "> "]
[131.5667, "o", "        print('dead at',t,s); break\r\n\u001b[?2004l\r\u001b[?2004h"]
[131.5668, "o", "> "]
[131.566853, "o", "    ns=step(s,a)\r\n\u001b[?2004l\r"]
[131.566959, "o", "\u001b[?2004h> "]
[131.567187, "o", "    print(t,s,'a',a,'->',ns) if t<20 else None\r\n\u001b[?2004l\r\u001b[?2004h"]
[131.567257, "o", "> "]
[131.567352, "o", "    s=ns\r\n\u001b[?2004l\r"]
[131.567497, "o", "\u001b[?2004h> "]
[131.56767, "o", "else: print('300 ok',s)\r\n\u001b[?2004l\r"]
[131.567782, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[145.979187, "o", "init survivable 200? True action 1\r\n"]
[146.005348, "o", "iter 1 W 9896\r\n"]
[146.035322, "o", "iter 2 W 9896\r\ninit in W True action 1\r\n0 ((0, 0), (9, 9)) a 1 -> ((0, 1), (7, 8))\r\n1 ((0, 1), (7, 8)) a 1 -> ((0, 2), (5, 7))\r\n"]
[146.035558, "o", "2 ((0, 2), (5, 7)) a 1 -> ((0, 3), (3, 6))\r\n3 ((0, 3), (3, 6)) a 1 -> ((0, 4), (1, 5))\r\n4 ((0, 4), (1, 5)) a 1 -> ((0, 5), (0, 3))\r\n5 ((0, 5), (0, 3)) a 1 -> ((0, 6), (1, 5))\r\n"]
[146.035695, "o", "6 ((0, 6), (1, 5)) a 2 -> ((1, 6), (0, 7))\r\n7 ((1, 6), (0, 7)) a 0 -> ((0, 6), (1, 5))\r\ncycle at 8 from 6 state ((0, 6), (1, 5))\r\n"]
