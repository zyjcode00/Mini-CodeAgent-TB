[58.523173, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\ncd /app && python - <<'PY'\nimport marshal, dis, types\nwith open('run_game.cpython-313.pyc','rb') as f:\n    data=f.read()\ncode=marshal.loads(data[16:])\n\ndef walk(c, indent=0):\n    pad='  '*indent\n    print(f'{pad}CODE name={c.co_name!r} file={c.co_filename!r} firstlineno={c.co_firstlineno}')\n    print(f'{pad} argcount={c.co_argcount} locals={c.co_varnames}')\n    print(f'{pad} names={c.co_names}')\n    simple=[]\n    for k in c.co_consts:\n        if isinstance(k, types.CodeType):\n            simple.append(f'<code {k.co_name}>')\n        else:\n            simple.append(repr(k))\n    print(f'{pad} consts={simple}')\n    for k in c.co_consts:\n        if isinstance(k, types.CodeType):\n            walk(k, indent+1)\nwalk(code)\nPY\ntrue; tmux wait -S done\r"]
