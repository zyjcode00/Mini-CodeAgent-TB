[229.943204, "o", "content = '\"\"\"Verification tests for strategy.py.\\n\\nThese tests model the bytecode runner\\'s game rules and call STRATEGY through a\\nfake socket, ensuring each invocation performs exactly one move and survives well\\nbeyond the required 200 turns.\\n\"\"\"\\n\\nimport json\\nimport sys\\n\\nimport strategy\\n\\n\\nGRID_SIZE = 10\\nUSER_MOVES = ((-1, 0), (0, 1), (1, 0), (0, -1))\\nKNIGHT_MOVES = ((-2, -1), (-2, 1), (-1, -2), (-1, 2),\\n                (1, -2), (1, 2), (2, -1), (2, 1))\\n\\n\\ndef valid(pos):\\n    return 0 <= pos[0] < GRID_SIZE and 0 <= pos[1] < GRID_SIZE\\n\\n\\nclass FakeSocket:\\n    def __init__(self):\\n        self.user = (0, 0)\\n        self.enemy = (9, 9)\\n        self.pending_response = None\\n        self.moves_this_call = 0\\n\\n    def _enemy_next(self):\\n        best_pos = None\\n        best_dist = float(\"inf\")\\n        for dr, dc in KNIGHT_MOVES:\\n            candidate = (self.enemy[0] + dr, self.enemy[1] + dc)\\n            if valid(candidate):\\n                dist = abs(candidate[0] - self.user[0]) + abs"]
[229.943479, "o", "(candidate[1] - self.user[1])\\n                if dist < best_dist:\\n                    best_dist = dist\\n                    best_pos = candidate\\n        return best_pos\\n\\n    def send(self, payload):\\n        request = payload.decode(\"utf-8\").strip()\\n        if request == \"get_user_pos\":\\n            self.pending_response = {\"type\": \"user_pos\", \"position\": list(self.user)}\\n        elif request == \"get_enemy_pos\":\\n            self.pending_response = {\"type\": \"enemy_pos\", \"position\": list(self.enemy)}\\n        elif request.startswith(\"move \"):\\n            direction = int(request.split()[1])\\n            assert 0 <= direction <= 3, f\"invalid direction {direction}\"\\n            self.moves_this_call += 1\\n            assert self.moves_this_call == 1, \"STRATEGY moved more than once\"\\n            dr, dc = USER_MOVES[direction]\\n            new_user = (self.user[0] + dr, self.user[1] + dc)\\n            assert valid(new_user), f\"moved out of bounds to {new_user}\"\\n            assert new_user != self.enemy, \"p"]
[229.943581, "o", "layer moved onto enemy\"\\n            old_user = self.user\\n            self.user = new_user\\n            assert abs(old_user[0] - self.user[0]) + abs(old_user[1] - self.user[1]) == 1\\n            self.enemy = self._enemy_next()\\n            assert self.user != self.enemy, f\"collision at {self.user}\"\\n            self.pending_response = {\\n                \"type\": \"move_result\",\\n                \"success\": True,\\n                \"user_pos\": list(self.user),\\n                \"enemy_pos\": list(self.enemy),\\n            }\\n        else:\\n            raise AssertionError(f\"unexpected request: {request!r}\")\\n\\n    def recv(self, _size):\\n        assert self.pending_response is not None, \"recv called before send\"\\n        response = json.dumps(self.pending_response).encode(\"utf-8\")\\n        self.pending_response = None\\n        return response\\n\\n\\ndef test_strategy_survives_250_turns():\\n    sock = FakeSocket()\\n    for turn in range(250):\\n        previous_user = sock.user\\n        sock.moves_this_call = 0\\n       "]
[229.943673, "o", " strategy.STRATEGY(sock)\\n        assert sock.moves_this_call == 1, f\"no move on turn {turn}\"\\n        moved = abs(previous_user[0] - sock.user[0]) + abs(previous_user[1] - sock.user[1])\\n        assert moved == 1, f\"bad user move distance {moved} on turn {turn}\"\\n\\n\\ndef test_initial_state_has_policy_action():\\n    policy = strategy._build_policy()\\n    assert ((0, 0), (9, 9)) in policy\\n    assert policy[((0, 0), (9, 9))] in (0, 1, 2, 3)\\n\\n\\nif __name__ == \"__main__\":\\n    try:\\n        test_initial_state_has_policy_action()\\n        test_strategy_survives_250_turns()\\n    except Exception as exc:  # pragma: no cover - explicit script mode output\\n        print(f\"FAIL: {exc}\", file=sys.stderr)\\n        raise\\n    print(\"strategy tests passed\")\\n'\r\n\u001b[?2004l\r\u001b[?2004h> dir_path = os.path.dirname(path)\r\n\u001b[?2004l\r"]
