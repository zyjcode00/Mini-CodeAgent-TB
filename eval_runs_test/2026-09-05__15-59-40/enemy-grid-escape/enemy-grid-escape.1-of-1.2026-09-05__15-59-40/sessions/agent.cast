[85.346398, "o", "\u001b[?2004hroot@15c12a1e3f04:/app# "]
[105.395847, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\ncd /app && python - <<'PY' > /tmp/run_game_dis.txt\nimport marshal, dis, types\nwith open('run_game.cpython-313.pyc','rb') as f:\n    code=marshal.loads(f.read()[16:])\n\ndef find(c, name):\n    if c.co_name == name:\n        return c\n    for k in c.co_consts:\n        if isinstance(k, types.CodeType):\n            r=find(k,name)\n            if r: return r\nfor name in ['move_enemy','move_user','process_request','survival_loop']:\n    c=find(code,name)\n    print('\\n'+'='*30, name, '='*30)\n    print('varnames=', c.co_varnames)\n    print('consts=', c.co_consts)\n    print('names=', c.co_names)\n    dis.dis(c)\nPY\nwc -l /tmp/run_game_dis.txt\ntrue; tmux wait -S done\r"]
[105.396163, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
[105.396319, "o", "\u001b[?2004hroot@15c12a1e3f04:/app# "]
