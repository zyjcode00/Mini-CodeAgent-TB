[85.289693, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\ncd /app && python - <<'PY'\nimport marshal, dis, types\nwith open('run_game.cpython-313.pyc','rb') as f:\n    code=marshal.loads(f.read()[16:])\n\ndef find(c, name):\n    if c.co_name == name:\n        return c\n    for k in c.co_consts:\n        if isinstance(k, types.CodeType):\n            r=find(k,name)\n            if r: return r\nfor name in ['move_enemy','move_user','process_request','survival_loop']:\n    c=find(code,name)\n    print('\\n'+'='*30, name, '='*30)\n    dis.dis(c)\nPY\ntrue; tmux wait -S done\r"]
[85.290156, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
