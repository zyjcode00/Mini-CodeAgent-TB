[381.5371, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\ncd /app && python - <<'PY'\nimport dis, marshal, types\npath='run_game.cpython-313.pyc'\nwith open(path,'rb') as f:\n    f.read(16)\n    code=marshal.load(f)\n\ndef walk(co):\n    yield co\n    for c in co.co_consts:\n        if isinstance(c, types.CodeType):\n            yield from walk(c)\n\nfor co in walk(code):\n    if co.co_name == 'survival_loop':\n        print('survival_loop constants:', co.co_consts)\n        print('--- sys.exit and nearby instructions ---')\n        instr=list(dis.get_instructions(co))\n        for i, ins in enumerate(instr):\n            if ins.opname in {'LOAD_ATTR','LOAD_METHOD'} and ins.argval == 'exit':\n                for j in range(max(0,i-5), min(len(instr), i+8)):\n                    print(instr[j].offset, instr[j].starts_line, instr[j].opname, instr[j].argrepr)\n                print('---')\nPY\ntrue; tmux wait -S done\r"]
[381.537512, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
[381.537655, "o", "\u001b[?2004hroot@15c12a1e3f04:/app# "]
