          for er in range(GRID_SIZE) for ec in range(GRID_SIZE)\\n              if (ur, uc) != (er, ec)]\\n\\n    # Greatest fixed point: states from which there is a move that remains in\\n    # the safe set forever. The initial state is in this set and the resulting\\n    # policy quickly enters a safe cycle.\\n    winning = set(states)\\n    while True:\\n        new_winning = set()\\n        new_policy = {}\\n        for state in states:\\n            if state not in winning:\\n                continue\\n            for direction in range(4):\\n                nxt = _transition(state, direction)\\n                if nxt in winning:\\n                    new_winning.add(state)\\n                    new_policy[state] = direction\\n                    break\\n        if new_winning == winning:\\n            return new_policy\\n        winning = new_winning\\n\\n\\ndef STRATEGY(client_socket):\\n    """Make exactly one safe move for the current turn."""\\n    global _POLICY\\n    if _POLICY is None:\\n        _POLICY = _build_policy()\\n\\n    user_resp = _request(client_socket, "get_user_pos")\\n    enemy_resp = _request(client_socket, "get_enemy_pos")\\n    user = tuple(user_resp["position"])\\n    enemy = tuple(enemy_resp["position"])\\n    state = (user, enemy)\\n\\n    direction = _POLICY.get(state)\\n    if direction is None:\\n        # Fallback should not be needed for the supplied game, but if reached,\\n        # choose the legal move maximizing post-enemy-move distance.\\n        choices = []\\n        for d in range(4):\\n            nxt = _transition(state, d)\\n            if nxt is not None:\\n                nu, ne = nxt\\n                choices.append((abs(nu[0] - ne[0]) + abs(nu[1] - ne[1]), d))\\n        direction = max(choices)[1]\\n\\n    _request(client_socket, f"move {direction}")\\n\'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, \'w\', encoding=\'utf-8\', newline=\'\\n\'