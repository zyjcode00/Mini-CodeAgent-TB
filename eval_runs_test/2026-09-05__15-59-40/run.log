Sending keys: ["export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\ncd /app && python - <<'PY'\nN=10\nKM=[(-2,-1),(-2,1),(-1,-2),(-1,2),(1,-2),(1,2),(2,-1),(2,1)]\nDM=[(-1,0),(0,1),(1,0),(0,-1)]\ndef valid(p): return 0<=p[0]<N and 0<=p[1]<N\ndef enemy_move(e,u):\n    best=[]; md=999\n    for dr,dc in KM:\n        ne=(e[0]+dr,e[1]+dc)\n        if valid(ne):\n            d=abs(ne[0]-u[0])+abs(ne[1]-u[1])\n            if d<md:\n                md=d; best=[ne]\n            elif d==md:\n                best.append(ne)\n    return best[0]\ndef step(s,a):\n    u,e=s; du=DM[a]; nu=(u[0]+du[0],u[1]+du[1])\n    if not valid(nu) or nu==e: return None\n    ne=enemy_move(e,nu)\n    if ne==nu: return None\n    return (nu,ne)\nstates=[(u,e) for u in [(r,c) for r in range(N) for c in range(N)] for e in [(r,c) for r in range(N) for c in range(N)] if u!=e]\n# winning for finite horizon 200 from initial via backwards DP\nsurvive={s: True for s in states}\npolicy={}\nfor t in range(200,0,-1):\n    new={}\n    pol={}\n    for s in states:\n        opts=[]\n        for a in range(4):\n            ns=step(s,a)\n            if ns is not None and survive.get(ns,False):\n                opts.append((a,ns))\n        new[s]=bool(opts)\n        if opts: pol[s]=opts[0][0]\n    survive=new; policy=pol\ninit=((0,0),(9,9))\nprint('init survivable 200?', survive.get(init), 'action', policy.get(init))\n# greedily follow recomputing from final policy? Let's compute infinite winning set greatest fixed point.\nW=set(states)\nchanged=True; it=0\nwhile changed:\n    it+=1; NW=set(); pol={}\n    for s in W:\n        for a in range(4):\n            ns=step(s,a)\n            if ns in W:\n                NW.add(s); pol[s]=a; break\n    changed=(NW!=W); W=NW\n    print('iter',it,'W',len(W))\nprint('init in W',init in W,'action',pol.get(init))\ns=init\nseen={}\nfor t in range(300):\n    if s in seen:\n        print('cycle at',t,'from',seen[s], 'state',s); break\n    seen[s]=t\n    a=pol.get(s)\n    if a is None:\n        print('dead at',t,s); break\n    ns=step(s,a)\n    print(t,s,'a',a,'->',ns) if t<20 else None\n    s=ns\nelse: print('300 ok',s)\nPY\ntrue", '; tmux wait -S done', 'Enter'] min_timeout_sec: 0.0 max_timeout_sec: inf
