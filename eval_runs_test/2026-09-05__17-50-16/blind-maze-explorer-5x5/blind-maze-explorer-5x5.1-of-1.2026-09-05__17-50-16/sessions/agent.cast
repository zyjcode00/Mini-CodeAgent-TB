[84.000873, "o", "--- 文件: /app/explore_maze.py (第 1 至 215 行，共 215 行) ---\r\n   1 | #!/usr/bin/env python3\r\n   2 | \"\"\"Automated blind maze explorer.\r\n   3 | \r\n   4 | Runs /app/maze_game.sh, explores every reachable open cell via DFS, then exits the\r\n   5 | maze process and writes /app/maze_map.txt.\r\n   6 | \"\"\"\r\n   7 | from __future__ import annotations\r\n   8 | \r\n   9 | import argparse\r\n  10 | import subprocess\r\n  11 | import sys\r\n  12 | import time\r\n  13 | from dataclasses import dataclass, field\r\n  14 | from pathlib import Path\r\n  15 | from typing import Callable, Dict, Iterable, List, Optional, Set, Tuple\r\n  16 | \r\n  17 | Coord = Tuple[int, int]\r\n  18 | \r\n  19 | DIRS: Dict[str, Coord] = {\r\n  20 |     \"N\": (0, -1),\r\n  21 |     \"E\": (1, 0),\r\n  22 |     \"S\": (0, 1),\r\n  23 |     \"W\": (-1, 0),\r\n  24 | }\r\n  25 | OPPOSITE = {\"N\": \"S\", \"S\": \"N\", \"E\": \"W\", \"W\": \"E\"}\r\n  26 | ORDER = [\"N\", \"E\", \"S\", \"W\"]\r\n  27 | \r\n  28 | \r\n  29 | def add(a: Coord, b: Coord) -> Coord:\r\n  30 |     return (a[0] + b[0], a[1] + b[1])\r\n  31 | \r\n"]
[84.001154, "o", "  32 | \r\n  33 | class MazeProcessClient:\r\n  34 |     \"\"\"Line/prompt oriented client for /app/maze_game.sh.\"\"\"\r\n  35 | \r\n  36 |     def __init__(self, cmd: str = \"/app/maze_game.sh\", debug: bool = False):\r\n  37 |         self.debug = debug\r\n  38 |         self.proc = subprocess.Popen(\r\n  39 |             [cmd],\r\n  40 |             stdin=subprocess.PIPE,\r\n  41 |             stdout=subprocess.PIPE,\r\n  42 |             stderr=subprocess.STDOUT,\r\n  43 |             text=True,\r\n  44 |             bufsize=0,\r\n  45 |         )\r\n  46 |         banner = self._read_until_prompt(timeout=10)\r\n  47 |         if self.debug:\r\n  48 |             print(\"[banner]\", repr(banner), file=sys.stderr)\r\n  49 |         if \"Blind Maze Explorer\" not in banner:\r\n  50 |             raise RuntimeError(f\"Unexpected maze banner/output: {banner!r}\")\r\n  51 | \r\n  52 |     def _read_until_prompt(self, timeout: float = 5.0) -> str:\r\n  53 |         assert self.proc.stdout is not None\r\n  54 |         start = time.time()\r\n  55 |         chunks: List["]
[84.00126, "o", "str] = []\r\n  56 |         while True:\r\n  57 |             if time.time() - start > timeout:\r\n  58 |                 raise TimeoutError(f\"Timed out waiting for prompt; got {''.join(chunks)!r}\")\r\n  59 |             ch = self.proc.stdout.read(1)\r\n  60 |             if ch == \"\":\r\n  61 |                 if self.proc.poll() is not None:\r\n  62 |                     break\r\n  63 |                 time.sleep(0.01)\r\n  64 |                 continue\r\n  65 |             chunks.append(ch)\r\n  66 |             if \"\\n> \" in \"\".join(chunks) or \"\".join(chunks).endswith(\"> \"):\r\n  67 |                 break\r\n  68 |         return \"\".join(chunks)\r\n  69 | \r\n  70 |     def move(self, direction: str) -> str:\r\n  71 |         assert direction in DIRS\r\n  72 |         assert self.proc.stdin is not None\r\n  73 |         self.proc.stdin.write(f\"move {direction}\\n\")\r\n  74 |         self.proc.stdin.flush()\r\n  75 |         out = self._read_until_prompt()\r\n  76 |         # Output after a command is usually: \"hit wall\\n> \"\r\n  77 |         cleaned"]
[84.001331, "o", " = out.replace(\"> \", \"\").strip()\r\n  78 |         if self.debug:\r\n  79 |             print(f\"[move {direction}] {cleaned!r}\", file=sys.stderr)\r\n  80 |         if cleaned not in {\"hit wall\", \"moved\", \"reached exit\"}:\r\n  81 |             raise RuntimeError(f\"Unexpected response to move {direction}: {out!r} -> {cleaned!r}\")\r\n  82 |         return cleaned\r\n  83 | \r\n  84 |     def close(self) -> None:\r\n  85 |         if self.proc.poll() is not None:\r\n  86 |             return\r\n  87 |         try:\r\n  88 |             assert self.proc.stdin is not None\r\n  89 |             self.proc.stdin.write(\"exit\\n\")\r\n  90 |             self.proc.stdin.flush()\r\n  91 |             # The process may or may not print a final message; wait briefly.\r\n  92 |             self.proc.wait(timeout=3)\r\n  93 |         except Exception:\r\n  94 |             self.proc.kill()\r\n  95 |             self.proc.wait(timeout=3)\r\n  96 | \r\n  97 | \r\n  98 | @dataclass\r\n  99 | class ExplorationResult:\r\n 100 |     open_cells: Set[Coord] = field(default_factory"]
