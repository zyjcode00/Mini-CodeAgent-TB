[71.272207, "i", " not None\\n            self.proc.stdin.write(\"exit\\\\n\")\\n            self.proc.stdin.flush()\\n            # The process may or may not print a final message; wait briefly.\\n            self.proc.wait(timeout=3)\\n        except Exception:\\n            self.proc.kill()\\n            self.proc.wait(timeout=3)\\n\\n\\n@dataclass\\nclass ExplorationResult:\\n    open_cells: Set[Coord] = field(default_factory=set)\\n    wall_cells: Set[Coord] = field(default_factory=set)\\n    start: Coord = (0, 0)\\n    exit: Optional[Coord] = None\\n\\n\\nclass MazeExplorer:\\n    def __init__(self, move_func: Callable[[str], str], debug: bool = False):\\n        self.move_func = move_func\\n        self.debug = debug\\n        self.result = ExplorationResult(open_cells={(0, 0)}, start=(0, 0))\\n        self.current: Coord = (0, 0)\\n        self.visited: Set[Coord] = set()\\n\\n    def _move(self, direction: str) -> str:\\n        resp = self.move_func(direction)\\n        target = add(self.current, DIRS[direction])\\n        if resp == \"hit wall\":\\n "]
[71.272334, "o", "ted maze banner/output: {banner!r}\")\\n\\n    def _read_until_prompt(self, timeout: float = 5.0) -> str:\\n        assert self.proc.stdout is not None\\n        start = time.time()\\n        chunks: List[str] = []\\n        while True:\\n            if time.time() - start > timeout:\\n                raise TimeoutError(f\"Timed out waiting for prompt; got {\\'\\'.join(chunks)!r}\")\\n            ch = self.proc.stdout.read(1)\\n            if ch == \"\":\\n                if self.proc.poll() is not None:\\n                    break\\n                time.sleep(0.01)\\n                continue\\n            chunks.append(ch)\\n            if \"\\\\n> \" in \"\".join(chunks) or \"\".join(chunks).endswith(\"> \"):\\n                break\\n        return \"\".join(chunks)\\n\\n    def move(self, direction: str) -> str:\\n        assert direction in DIRS\\n        assert self.proc.stdin is not None\\n  "]
[71.272368, "i", "           self.result.wall_cells.add(target)\\n        elif resp in {\"moved\", \"reached exit\"}:\\n            self.current = target\\n            self.result.open_cells.add(target)\\n            if resp == \"reached exit\":\\n                self.result.exit = target\\n        else:\\n            raise RuntimeError(f\"Unknown move response: {resp!r}\")\\n        if self.debug:\\n            print(f\"{direction}: {resp}, now {self.current}\", file=sys.stderr)\\n        return resp\\n\\n    def explore(self) -> ExplorationResult:\\n        self._dfs((0, 0))\\n        assert self.current == (0, 0), f\"DFS should return to start, at {self.current}\"\\n        return self.result\\n\\n    def _dfs(self, coord: Coord) -> None:\\n        self.visited.add(coord)\\n        for direction in ORDER:\\n            nb = add(coord, DIRS[direction])\\n            if nb in self.result.wall_cells:\\n                continue\\n            if nb in self.visited:\\n                continue\\n            # If known open but not visited, move there; if unknown, pro"]
