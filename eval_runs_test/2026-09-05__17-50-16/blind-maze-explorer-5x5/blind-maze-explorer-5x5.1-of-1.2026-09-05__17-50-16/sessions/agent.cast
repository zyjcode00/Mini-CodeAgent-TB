[176.106905, "o", "lines=p.read_text().splitlines()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[176.107042, "o", "h=len(lines); w=len(lines[0])\r\n\u001b[?2004l\r"]
[176.107094, "o", "\u001b[?2004h> "]
