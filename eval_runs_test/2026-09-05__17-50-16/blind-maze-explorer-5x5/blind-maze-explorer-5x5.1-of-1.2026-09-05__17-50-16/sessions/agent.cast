[84.001576, "o", "\n 146 |                 continue\r\n 147 |             # Successfully moved to nb. Recursively explore, then backtrack.\r\n 148 |             self._dfs(nb)\r\n 149 |             back = OPPOSITE[direction]\r\n 150 |             back_resp = self._move(back)\r\n 151 |             if back_resp == \"hit wall\":\r\n 152 |                 raise RuntimeError(f\"Backtrack {back} from {self.current} to {coord} hit a wall\")\r\n 153 |             if self.current != coord:\r\n 154 |                 raise RuntimeError(f\"Backtrack failed: expected {coord}, at {self.current}\")\r\n 155 | \r\n 156 | \r\n 157 | def infer_walls_and_render(result: ExplorationResult) -> str:\r\n 158 |     \"\"\"Render exact rectangular map for a maze whose all open spaces are reachable.\r\n 159 | \r\n 160 |     DFS discovers all reachable open cells and every wall adjacent to them. The outer\r\n 161 |     rectangular border is made of walls. Any still-unknown cell inside the minimal\r\n 162 |     discovered wall/open bounding box cannot be a reachable open cell, so by the\r\n 163 |     "]
[84.001623, "o", "challenge guarantee it must be a wall.\r\n 164 |     \"\"\"\r\n 165 |     cells = set(result.open_cells) | set(result.wall_cells)\r\n 166 |     if not cells:\r\n 167 |         raise ValueError(\"No cells discovered\")\r\n 168 |     min_x = min(x for x, _ in cells)\r\n 169 |     max_x = max(x for x, _ in cells)\r\n 170 |     min_y = min(y for _, y in cells)\r\n 171 |     max_y = max(y for _, y in cells)\r\n 172 | \r\n 173 |     lines: List[str] = []\r\n 174 |     for y in range(min_y, max_y + 1):\r\n 175 |         chars: List[str] = []\r\n 176 |         for x in range(min_x, max_x + 1):\r\n 177 |             c = (x, y)\r\n 178 |             if c == result.start:\r\n 179 |                 chars.append(\"S\")\r\n 180 |             elif result.exit is not None and c == result.exit:\r\n 181 |                 chars.append(\"E\")\r\n 182 |             elif c in result.open_cells:\r\n 183 |                 chars.append(\" \")\r\n 184 |             else:\r\n 185 |                 chars.append(\"#\")\r\n 186 |         lines.append(\"\".join(chars))\r\n 187 |     return \"\\n\".join(l"]
