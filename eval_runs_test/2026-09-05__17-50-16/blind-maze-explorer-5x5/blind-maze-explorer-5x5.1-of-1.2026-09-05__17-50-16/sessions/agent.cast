[176.105696, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - <<'PY'\nfrom pathlib import Path\nfrom collections import deque\np=Path('/app/maze_map.txt')\nlines=p.read_text().splitlines()\nh=len(lines); w=len(lines[0])\nassert all(len(line)==w for line in lines), 'ragged map'\nstarts=[(x,y) for y,row in enumerate(lines) for x,ch in enumerate(row) if ch=='S']\nexits=[(x,y) for y,row in enumerate(lines) for x,ch in enumerate(row) if ch=='E']\nassert len(starts)==1, starts\nassert len(exits)==1, exits\ns=starts[0]; e=exits[0]\nq=deque([s]); seen={s}\nwhile q:\n    x,y=q.popleft()\n    for dx,dy in [(0,-1),(1,0),(0,1),(-1,0)]:\n        nx,ny=x+dx,y+dy\n        if 0<=nx<w and 0<=ny<h and (nx,ny) not in seen and lines[ny][nx] != '#':\n            seen.add((nx,ny)); q.append((nx,ny))\nopen_cells={(x,y) for y,row in enumerate(lines) for x,ch in enumerate(row) if ch!='#'}\nassert seen==open_cells, (seen, open_cells)\nassert e in seen\nprint('map connectivity validation passed')\nprint(p.read_text(), end='')\nPY\ntrue; tmux wait -S done\r"]
[176.106071, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
[176.106202, "o", "\u001b[?2004hroot@af9250e80e29:/app# "]
