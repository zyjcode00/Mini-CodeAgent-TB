[135.002887, "o", "\u001b[?2004h> "]
[135.011734, "o", "content = 'import sys\\n\\nsys.path.insert(0, \"/app\")\\nfrom explore_maze import DIRS, MazeExplorer, add, infer_walls_and_render\\n\\n\\nclass FakeMaze:\\n    def __init__(self, text):\\n        self.lines = text.splitlines()\\n        self.grid = {}\\n        self.pos = None\\n        self.exit = None\\n        for y, line in enumerate(self.lines):\\n            for x, ch in enumerate(line):\\n                self.grid[(x, y)] = ch\\n                if ch == \"S\":\\n                    self.pos = (x, y)\\n                elif ch == \"E\":\\n                    self.exit = (x, y)\\n        assert self.pos is not None\\n        self.start = self.pos\\n\\n    def move(self, direction):\\n        nb = add(self.pos, DIRS[direction])\\n        if self.grid.get(nb, \"#\") == \"#\":\\n            return \"hit wall\"\\n        self.pos = nb\\n        if nb == self.exit:\\n            return \"reached exit\"\\n        return \"moved\"\\n\\n    def normalize_relative_to_start(self):\\n        sx, sy = self.start\\n        rel = set()\\n        walls = set()\\n      "]
[135.011981, "o", "  for (x, y), ch in self.grid.items():\\n            c = (x - sx, y - sy)\\n            if ch == \"#\":\\n                walls.add(c)\\n            else:\\n                rel.add(c)\\n        return rel, walls\\n\\n\\ndef test_explores_cycle_dead_end_and_exit_and_renders_exact_map():\\n    maze_text = \"\"\"#######\\n#S #  #\\n#  # ##\\n##   E#\\n#######\"\"\"\\n    fake = FakeMaze(maze_text)\\n    explorer = MazeExplorer(fake.move)\\n    result = explorer.explore()\\n\\n    assert fake.pos == fake.start\\n    open_rel, _ = fake.normalize_relative_to_start()\\n    assert result.open_cells == open_rel\\n    assert result.exit == (5 - 1, 3 - 1)  # relative to S at (1,1)\\n    assert infer_walls_and_render(result) == maze_text + \"\\\\n\"\\n\\n\\ndef test_renders_start_on_minimal_bounding_box_with_negative_coords():\\n    maze_text = \"\"\"#####\\n#  S#\\n# # #\\n#E  #\\n#####\"\"\"\\n    fake = FakeMaze(maze_text)\\n    result = MazeExplorer(fake.move).explore()\\n    assert infer_walls_and_render(result) == maze_text + \"\\\\n\"\\n\\n\\ndef main():\\n    tests = [\\n "]
[135.012088, "o", "       test_explores_cycle_dead_end_and_exit_and_renders_exact_map,\\n        test_renders_start_on_minimal_bounding_box_with_negative_coords,\\n    ]\\n    for test in tests:\\n        test()\\n        print(f\"PASS {test.__name__}\")\\n    print(f\"{len(tests)} tests passed\")\\n\\n\\nif __name__ == \"__main__\":\\n    main()\\n'\r\n\u001b[?2004l\r\u001b[?2004h> dir_path = os.path.dirname(path)\r\n\u001b[?2004l\r"]
