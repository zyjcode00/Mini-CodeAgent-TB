[71.318158, "o", "content = '#!/usr/bin/env python3\\n\"\"\"Automated blind maze explorer.\\n\\nRuns /app/maze_game.sh, explores every reachable open cell via DFS, then exits the\\nmaze process and writes /app/maze_map.txt.\\n\"\"\"\\nfrom __future__ import annotations\\n\\nimport argparse\\nimport subprocess\\nimport sys\\nimport time\\nfrom dataclasses import dataclass, field\\nfrom pathlib import Path\\nfrom typing import Callable, Dict, Iterable, List, Optional, Set, Tuple\\n\\nCoord = Tuple[int, int]\\n\\nDIRS: Dict[str, Coord] = {\\n    \"N\": (0, -1),\\n    \"E\": (1, 0),\\n    \"S\": (0, 1),\\n    \"W\": (-1, 0),\\n}\\nOPPOSITE = {\"N\": \"S\", \"S\": \"N\", \"E\": \"W\", \"W\": \"E\"}\\nORDER = [\"N\", \"E\", \"S\", \"W\"]\\n\\n\\ndef add(a: Coord, b: Coord) -> Coord:\\n    return (a[0] + b[0], a[1] + b[1])\\n\\n\\nclass MazeProcessClient:\\n    \"\"\"Line/prompt oriented client for /app/maze_game.sh.\"\"\"\\n\\n    def __init__(self, cmd: str = \"/app/maze_game.sh\", debug: bool = False):\\n        self.debug = debug\\n        self.proc = subprocess.Popen(\\n            [cmd],\\n            stdin=sub"]
[71.31823, "o", "process.PIPE,\\n            stdout=subprocess.PIPE,\\n            stderr=subprocess.STDOUT,\\n            text=True,\\n            bufsize=0,\\n        )\\n        banner = self._read_until_prompt(timeout=10)\\n        if self.debug:\\n            print(\"[banner]\", repr(banner), file=sys.stderr)\\n        if \"Blind Maze Explorer\" not in banner:\\n            raise RuntimeError(f\"Unexpected maze banner/output: {banner!r}\")\\n\\n    def _read_until_prompt(self, timeout: float = 5.0) -> str:\\n        assert self.proc.stdout is not None\\n        start = time.time()\\n        chunks: List[str] = []\\n        while True:\\n            if time.time() - start > timeout:\\n                raise TimeoutError(f\"Timed out waiting for prompt; got {\\'\\'.join(chunks)!r}\")\\n            ch = self.proc.stdout.read(1)\\n            if ch == \"\":\\n                if self.proc.poll() is not None:\\n                    break\\n                time.sleep(0.01)\\n                continue\\n            chunks.append(ch)\\n            if \"\\\\n> \" in \"\".join("]
[71.318463, "o", "chunks) or \"\".join(chunks).endswith(\"> \"):\\n                break\\n        return \"\".join(chunks)\\n\\n    def move(self, direction: str) -> str:\\n        assert direction in DIRS\\n        assert self.proc.stdin is not None\\n        self.proc.stdin.write(f\"move {direction}\\\\n\")\\n        self.proc.stdin.flush()\\n        out = self._read_until_prompt()\\n        # Output after a command is usually: \"hit wall\\\\n> \"\\n        cleaned = out.replace(\"> \", \"\").strip()\\n        if self.debug:\\n            print(f\"[move {direction}] {cleaned!r}\", file=sys.stderr)\\n        if cleaned not in {\"hit wall\", \"moved\", \"reached exit\"}:\\n            raise RuntimeError(f\"Unexpected response to move {direction}: {out!r} -> {cleaned!r}\")\\n        return cleaned\\n\\n    def close(self) -> None:\\n        if self.proc.poll() is not None:\\n            return\\n        try:\\n            assert self.proc.stdin is not None\\n            self.proc.stdin.write(\"exit\\\\n\")\\n            self.proc.stdin.flush()\\n            # The process may or may "]
