Sending keys: ['export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/explore_maze.py <<\'PY\'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = \'#!/usr/bin/env python3\\n"""Automated blind maze explorer.\\n\\nRuns /app/maze_game.sh, explores every reachable open cell via DFS, then exits the\\nmaze process and writes /app/maze_map.txt.\\n"""\\nfrom __future__ import annotations\\n\\nimport argparse\\nimport subprocess\\nimport sys\\nimport time\\nfrom dataclasses import dataclass, field\\nfrom pathlib import Path\\nfrom typing import Callable, Dict, Iterable, List, Optional, Set, Tuple\\n\\nCoord = Tuple[int, int]\\n\\nDIRS: Dict[str, Coord] = {\\n    "N": (0, -1),\\n    "E": (1, 0),\\n    "S": (0, 1),\\n    "W": (-1, 0),\\n}\\nOPPOSITE = {"N": "S", "S": "N", "E": "W", "W": "E"}\\nORDER = ["N", "E", "S", "W"]\\n\\n\\ndef add(a: Coord, b: Coord) -> Coord:\\n    return (a[0] + b[0], a[1] + b[1])\\n\\n\\nclass MazeProcessClient:\\n    """Line/prompt oriented client for /app/maze_game.sh."""\\n\\n    def __init__(self, cmd: str = "/app/maze_game.sh", debug: bool = False):\\n        self.debug = debug\\n        self.proc = subprocess.Popen(\\n            [cmd],\\n            stdin=subprocess.PIPE,\\n            stdout=subprocess.PIPE,\\n            stderr=subprocess.STDOUT,\\n            text=True,\\n            bufsize=0,\\n        )\\n        banner = self._read_until_prompt(timeout=10)\\n        if self.debug:\\n            print("[banner]", repr(banner), file=sys.stderr)\\n        if "Blind Maze Explorer" not in banner:\\n            raise RuntimeError(f"Unexpected maze banner/output: {banner!r}")\\n\\n    def _read_until_prompt(self, timeout: float = 5.0) -> str:\\n        assert self.proc.stdout is not None\\n        start = time.time()\\n        chunks: List[str] = []\\n        while True:\\n            if time.time() - start > timeout:\\n                raise TimeoutError(f"Timed out waiting for prompt; got {\\\'\\\'.join(chunks)!r}")\\n            ch = self.proc.stdout.read(1)\\n            if ch == "":\\n                if self.proc.poll() is not None:\\n                    break\\n                time.sleep(0.01)\\n                continue\\n            chunks.append(ch)\\n            if "\\\\n> " in "".join(chunks) or "".join(chunks).endswith("> "):\\n                break\\n        return "".join(chunks)\\n\\n    def move(self, direction: str) -> str:\\n        assert direction in DIRS\\n        assert self.proc.stdin is not None\\n        self.proc.stdin.write(f"move {direction}\\\\n")\\n        self.proc.stdin.flush()\\n        out = self._read_until_prompt()\\n        # Output after a command is usually: "hit wall\\\\n> "\\n        cleaned = out.replace("> ", "").strip()\\n        if self.debug:\\n            print(f"[move {direction}] {cleaned!r}", file=sys.stderr)\\n        if cleaned not in {"hit wall", "moved", "reached exit"}:\\n            raise RuntimeError(f"Unexpected response to move {direction}: {out!r} -> {cleaned!r}")\\n        return cleaned\\n\\n    def close(self) -> None:\\n        if self.proc.poll() is not None:\\n            return\\n        try:\\n            assert self.proc.stdin is not None\\n            self.proc.stdin.write("exit\\\\n")\\n            self.proc.stdin.flush()\\n            # The process may or may not print a final message; wait briefly.\\n            self.proc.wait(timeout=3)\\n        except Exception:\\n            self.proc.kill()\\n            self.proc.wait(timeout=3)\\n\\n\\n@dataclass\\nclass ExplorationResult:\\n    open_cells: Set[Coord] = field(default_factory=set)\\n    wall_cells: Set[Coord] = field(default_factory=set)\\n    start: Coord = (0, 0)\\n    exit: Optional[Coord] = None\\n\\n\\nclass MazeExplorer:\\n    def __init__(self, move_func: Callable[[str], str], debug: bool = False):\\n        self.move_func = move_func\\n        self.debug = debug\\n        self.result = ExplorationResult(open_cells={(0, 0)}, start=(0, 0))\\n        self.current: Coord = (0, 0)\\n        self.visited: Set[Coord] = set()\\n\\n    def _move(self, direction: str) -> str:\\n        resp = self.move_func(direction)\\n        target = add(self.current, DIRS[direction])\\n        if resp == "hit wall":\\n            self.result.wall_cells.add(target)\\n        elif resp in {"moved", "reached exit"}:\\n            self.current = target\\n            self.result.open_cells.add(target)\\n            if resp == "reached exit":\\n                self.result.exit = target\\n        else:\\n            raise RuntimeError(f"Unknown move response: {resp!r}")\\n        if self.debug:\\n            print(f"{direction}: {resp}, now {self.current}", file=sys.stderr)\\n        return resp\\n\\n    def explore(self) -> ExplorationResult:\\n        self._dfs((0, 0))\\n        assert self.current == (0, 0), f"DFS should return to start, at {self.current}"\\n        return self.result\\n\\n    def _dfs(self, coord: Coord) -> None:\\n        self.visited.add(coord)\\n        for direction in ORDER:\\n            nb = add(coord, DIRS[direction])\\n            if nb in self.result.wall_cells:\\n                continue\\n            if nb in self.visited:\\n                continue\\n            # If known open but not visited, move there; if unknown, probe it.\\n            resp = self._move(direction)\\n            if resp == "hit wall":\\n                continue\\n            # Successfully moved to nb. Recursively explore, then backtrack.\\n            self._dfs(nb)\\n            back = OPPOSITE[direction]\\n            back_resp = self._move(back)\\n            if back_resp == "hit wall":\\n                raise RuntimeError(f"Backtrack {back} from {self.current} to {coord} hit a wall")\\n            if self.current != coord:\\n                raise RuntimeError(f"Backtrack failed: expected {coord}, at {self.current}")\\n\\n\\ndef infer_walls_and_render(result: ExplorationResult) -> str:\\n    """Render exact rectangular map for a maze whose all open spaces are reachable.\\n\\n    DFS discovers all reachable open cells and every wall adjacent to them. The outer\\n    rectangular border is made of walls. Any still-unknown cell inside the minimal\\n    discovered wall/open bounding box cannot be a reachable open cell, so by the\\n    challenge guarantee it must be a wall.\\n    """\\n    cells = set(result.open_cells) | set(result.wall_cells)\\n    if not cells:\\n        raise ValueError("No cells discovered")\\n    min_x = min(x for x, _ in cells)\\n    max_x = max(x for x, _ in cells)\\n    min_y = min(y for _, y in cells)\\n    max_y = max(y for _, y in cells)\\n\\n    lines: List[str] = []\\n    for y in range(min_y, max_y + 1):\\n        chars: List[str] = []\\n        for x in range(min_x, max_x + 1):\\n            c = (x, y)\\n            if c == result.start:\\n                chars.append("S")\\n            elif result.exit is not None and c == result.exit:\\n                chars.append("E")\\n            elif c in result.open_cells:\\n                chars.append(" ")\\n            else:\\n                chars.append("#")\\n        lines.append("".join(chars))\\n    return "\\\\n".join(lines) + "\\\\n"\\n\\n\\ndef run_actual(output: Path, debug: bool = False) -> ExplorationResult:\\n    client = MazeProcessClient(debug=debug)\\n    try:\\n        explorer = MazeExplorer(client.move, debug=debug)\\n        result = explorer.explore()\\n    finally:\\n        # The game must be exited before writing the final map file.\\n        client.close()\\n    rendered = infer_walls_and_render(result)\\n    output.write_text(rendered)\\n    return result\\n\\n\\ndef main(argv: Optional[List[str]] = None) -> int:\\n    parser = argparse.ArgumentParser()\\n    parser.add_argument("--output", default="/app/maze_map.txt")\\n    parser.add_argument("--debug", action="store_true")\\n    args = parser.parse_args(argv)\\n    result = run_actual(Path(args.output), debug=args.debug)\\n    print(f"explored open={len(result.open_cells)} walls={len(result.wall_cells)} exit={result.exit}")\\n    print(f"wrote {args.output}")\\n    return 0\\n\\n\\nif __name__ == "__main__":\\n    raise SystemExit(main())\\n\'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, \'w\', encoding=\'utf-8\', newline=\'\\n\') as f:\n        f.write(content)\n    print(f"成功: 已写入 {path}")\nexcept Exception as exc:\n    print(f"写入失败: {exc}")\nPY\ntrue', '; tmux wait -S done', 'Enter'] min_timeout_sec: 0.0 max_timeout_sec: inf
