ive to S at (1,1)\\n    assert infer_walls_and_render(result) == maze_text + "\\\\n"\\n\\n\\ndef test_renders_start_on_minimal_bounding_box_with_negative_coords():\\n    maze_text = """#####\\n#  S#\\n# # #\\n#E  #\\n#####"""\\n    fake = FakeMaze(maze_text)\\n    result = MazeExplorer(fake.move).explore()\\n    assert infer_walls_and_render(result) == maze_text + "\\\\n"\\n\'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, \'w\', encoding=\'utf-8\', newline=\'\\n\') as f:\n        f.write(content)\n    print(f"成功: 已写入 {path}")\nexcept Exception as exc:\n    print(f"写入失败: {exc}")\nPY\ntrue', '; tmux wait -S done', 'Enter'] min_timeout_sec: 0.0 max_timeout_sec: inf
