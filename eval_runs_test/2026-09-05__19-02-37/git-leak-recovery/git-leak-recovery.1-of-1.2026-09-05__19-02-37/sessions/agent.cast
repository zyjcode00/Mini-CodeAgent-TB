[184.178019, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\nset -euo pipefail\ncd /app/repo\nprintf '== verify worktree status ==\\n'\ngit status --short\n\nprintf '== verify refs unchanged ==\\n'\ngit for-each-ref --format='%(refname) %(objectname)' | sort > /tmp/repo_refs_after.txt\ncmp /tmp/repo_refs_before.txt /tmp/repo_refs_after.txt && echo 'refs unchanged'\n\nprintf '== verify commit messages unchanged ==\\n'\ngit log --all --format='%H%x00%B%x00--END-COMMIT--' > /tmp/repo_messages_after.txt\ncmp /tmp/repo_messages_before.txt /tmp/repo_messages_after.txt && echo 'commit messages unchanged'\n\nprintf '== verify reachable history has no secret pattern ==\\n'\nif git rev-list --all | grep -q .; then\n  if git grep -I -n -E 'secret\\[[^]]+\\]' $(git rev-list --all); then\n    echo 'ERROR: secret pattern found in reachable history' >&2\n    exit 1\n  else\n    echo 'no secret pattern in reachable history'\n  fi\nelse\n  echo 'no commits to search'\nfi\n\nprintf '== verify reflogs have no secret pattern ==\\n'\nif git log -g --all -p --no-ext-diff --no-color 2>/dev/null | grep -aoE 'secret\\[[^]]+\\]'; then\n  echo 'ERROR: secret pattern found in reflog' >&2\n  exit 1\nelse\n  echo 'no secret pattern in reflogs'\nfi\n\nprintf '== verify fsck unreachable objects have no secret pattern ==\\n'\nfound=0\nwhile read -r type obj; do\n  [ -n \"${obj:-}\" ] || continue\n  if git cat-file -p \"$obj\" 2>/dev/null | grep -aEq 'secret\\[[^]]+\\]'; then\n    echo \"ERROR: secret pattern found in unreachable $type $obj\" >&2\n    found=1\n  fi\ndone < <(git fsck --no-reflogs --unreachable 2>/dev/null | awk '/unreachable (blob|commit|tree)/ {print $2, $3}')\nif [ \"$found\" -ne 0 ]; then exit 1; fi\necho 'no secret pattern in unreachable objects'\n\nprintf '== verify raw repository directory has no secret pattern ==\\n'\nif grep -RaoE 'secret\\[[^]]+\\]' /app/repo; then\n  echo 'ERROR: secret pattern found in /app/repo' >&2\n  exit 1\nelse\n  echo 'no secret pattern anywhere under /app/repo'\nfi\n\nprintf '== verify recovered secret file ==\\n'\npython3 - <<'PY'\nfrom pathlib import Path\np = Path('/app/secret.txt')\ncontent = p.read_text(encoding='utf-8')\nassert content == 'secret[lost_and_found_in_git]\\n', repr(content)\nprint('/app/secret.txt contains recovered secret')\nPY\ntrue; tmux wait -S done\r"]
