[35.054531, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\nset -euo pipefail\ncd /app/repo\nprintf '== status ==\\n'\ngit status --short\nprintf '== repo files grep ==\\n'\n(grep -RaoE 'secret\\[[^]]+\\]' . --exclude-dir=.git || true) | sort -u\nprintf '== reachable git grep ==\\n'\n(git grep -I -n -E 'secret\\[[^]]+\\]' $(git rev-list --all) || true)\nprintf '== reflog grep ==\\n'\n(git log -g --all -p --no-ext-diff --no-color 2>/dev/null | grep -aoE 'secret\\[[^]]+\\]' || true) | sort -u\nprintf '== fsck unreachable candidates ==\\n'\ngit fsck --no-reflogs --unreachable --lost-found 2>/dev/null | awk '/unreachable (blob|commit|tree)/ {print $3}' | while read -r obj; do\n  if git cat-file -p \"$obj\" 2>/dev/null | grep -aEq 'secret\\[[^]]+\\]'; then\n    printf '%s ' \"$obj\"\n    git cat-file -p \"$obj\" | grep -aoE 'secret\\[[^]]+\\]' | sort -u\n  fi\ndone\ntrue; tmux wait -S done\r"]
