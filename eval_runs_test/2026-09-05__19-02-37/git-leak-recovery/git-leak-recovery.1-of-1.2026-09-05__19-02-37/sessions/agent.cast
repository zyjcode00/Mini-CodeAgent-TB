[169.461471, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\nset -euo pipefail\ncd /app/repo\n# Record reachable refs and commit messages before cleanup so we can verify they remain unchanged.\ngit for-each-ref --format='%(refname) %(objectname)' | sort > /tmp/repo_refs_before.txt\ngit log --all --format='%H%x00%B%x00--END-COMMIT--' > /tmp/repo_messages_before.txt\n\n# Remove reflog entries that can keep rewritten-history commits alive.\ngit reflog expire --expire=now --expire-unreachable=now --all\n\n# Remove fsck --lost-found material, if present; this is generated recovery data, not repository history.\nif [ -d .git/lost-found ]; then\n  rm -rf .git/lost-found\nfi\n\n# Prune unreachable objects and repack reachable history only.\ngit gc --prune=now\n# Run prune explicitly as a belt-and-suspenders cleanup for loose unreachable objects.\ngit prune --expire=now\n\nprintf 'cleanup complete\\n'\nprintf 'status after cleanup:\\n'\ngit status --short\ntrue; tmux wait -S done\r"]
[169.462077, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
