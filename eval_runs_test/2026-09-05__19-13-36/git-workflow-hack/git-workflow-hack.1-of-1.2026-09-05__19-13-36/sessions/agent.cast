[258.311843, "o", "<!doctype html>\r\n<html lang=\"en\">\r\n  <head>\r\n    <meta charset=\"utf-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\r\n    <meta name=\"description\" content=\"Selected publications by Dr. Lydia Moreno in computational neuroscience, connectomics, and single-cell omics.\">\r\n    <title>Publications | Dr. Lydia Moreno</title>\r\n    <link rel=\"stylesheet\" href=\"assets/styles.css\">\r\n  </head>\r\n  <body>\r\n    <a class=\"skip-link\" href=\"#main\">Skip to content</a>\r\n    <header class=\"site-header\">\r\n      <nav class=\"nav container\" aria-label=\"Primary navigation\">\r\n        <a class=\"brand\" href=\"index.html\">Lydia Moreno</a>\r\n        <div class=\"nav-links\">\r\n          <a href=\"index.html\">About Me</a>\r\n          <a href=\"publications.html\" aria-current=\"page\">Publications</a>\r\n          <a href=\"blog.html\">Blog</a>\r\n        </div>\r\n      </nav>\r\n    </header>\r\n\r\n    <main id=\"main\">\r\n      <section class=\"page-hero\">\r\n        <div class=\"container\">\r\n          <p class=\"eyebrow\">Publications</p>\r\n          <h1>Selected research outputs</h1>\r\n          <p class=\"lead\">Peer-reviewed work on neural decoding, graph representation learning for connectomics, integrative single-cell analysis, and explainable AI in neuroscience.</p>\r\n        </div>\r\n      </section>\r\n\r\n      <section class=\"section container\" aria-labelledby=\"selected-publications\">\r\n        <div class=\"section-heading\">\r\n          <h2 id=\"selected-publications\">Selected publications</h2>\r\n        </div>\r\n        <ol class=\"publication-list\">\r\n          <li>\r\n            <article>\r\n              <h3>Temporal Convolutional Networks Decode Visual Stimuli from Two-Photon Signals</h3>\r\n              <p class=\"meta\">Moreno, L., &amp; Patel, A. (2024). <em>Journal of Computational Neuroscience</em>, 45(2), 123–137.</p>\r\n              <p>Introduces temporal convolutional models for interpreting calcium-imaging traces and predicting visual stimulus orientation.</p>\r\n            </article>\r\n          </li>\r\n          <li>\r\n            <article>\r\n              <h3>Graph Embedding Techniques Reveal Synaptic Motifs in EM Datasets</h3>\r\n              <p class=\"meta\">Moreno, L., Zhang, W., &amp; Singh, R. (2023). <em>Neuroinformatics</em>, 21(4), 299–312.</p>\r\n              <p>Demonstrates graph embeddings for classifying synapse types and discovering connectivity motifs in reconstructed neural circuits.</p>\r\n            </article>\r\n          </li>\r\n          <li>\r\n            <article>\r\n              <h3>Integrative Single-Cell Atlas of Human Cerebral Organoids</h3>\r\n              <p class=\"meta\">Moreno, L. et al. (2022). <em>Cell Systems</em>, 9(1), 67–82.</p>\r\n              <p>Presents an integrated atlas combining single-cell RNA-seq, ATAC-seq, and spatial measurements for human cortical organoids.</p>\r\n            </article>\r\n          </li>\r\n          <li>\r\n            <article>\r\n              <h3>Explainable AI Techniques in Neural Decoding</h3>\r\n              <p class=\"meta\">Chen, J., Moreno, L., &amp; Russo, M. (2021). <em>Frontiers in Neuroscience</em>, 15, 756843.</p>\r\n              <p>Reviews attribution and decision-boundary methods for improving trust in neural decoding models.</p>\r\n            </article>\r\n          </li>\r\n        </ol>\r\n      </section>\r\n\r\n      <section class=\"section muted\" aria-labelledby=\"project-publications\">\r\n        <div class=\"container card-grid\">\r\n          <article class=\"card\">\r\n            <p class=\"eyebrow\">DeepVision</p>\r\n            <h2 id=\"project-publications\">High-resolution neural activity mapping</h2>\r\n            <p>Methods emerging from the DeepVision project support real-time processing of two-photon recordings and interpretable decoding of sensory representations.</p>\r\n          </article>\r\n          <article class=\"card\">\r\n            <p class=\"eyebrow\">NeuroGraph</p>\r\n            <h2>Connectomics and graph learning</h2>\r\n            <p>The NeuroGraph toolkit has been adopted by 12 labs worldwide for graph-based analysis of electron-microscopy reconstructions.</p>\r\n          </article>\r\n          <a"]
[258.312065, "o", "rticle class=\"card\">\r\n            <p class=\"eyebrow\">CellMap</p>\r\n            <h2>Multi-modal single-cell atlas</h2>\r\n            <p>CellMap integrates scRNA-seq, ATAC-seq, and spatial FISH data to resolve cell-type hierarchies in human cortical organoids.</p>\r\n          </article>\r\n        </div>\r\n      </section>\r\n    </main>\r\n\r\n    <footer class=\"site-footer\">\r\n      <div class=\"container footer-grid\">\r\n        <p>&copy; 2025 Dr. Lydia Moreno.</p>\r\n        <p><a href=\"index.html\">About</a> · <a href=\"publications.html\">Publications</a> · <a href=\"blog.html\">Blog</a></p>\r\n      </div>\r\n    </footer>\r\n  </body>\r\n</html>\r\n"]
