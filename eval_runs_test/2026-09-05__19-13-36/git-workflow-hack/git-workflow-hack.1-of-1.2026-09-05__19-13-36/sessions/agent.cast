[258.455461, "o", ":root {\r\n  color-scheme: light;\r\n  --bg: #f7f9fc;\r\n  --surface: #ffffff;\r\n  --surface-muted: #eef4f8;\r\n  --ink: #17202a;\r\n  --muted: #5d6d7e;\r\n  --brand: #175676;\r\n  --brand-strong: #0d3b52;\r\n  --accent: #c2843b;\r\n  --border: #d9e2ec;\r\n  --shadow: 0 20px 60px rgba(23, 32, 42, 0.10);\r\n}\r\n\r\n* {\r\n  box-sizing: border-box;\r\n}\r\n\r\nhtml {\r\n  scroll-behavior: smooth;\r\n}\r\n\r\nbody {\r\n  margin: 0;\r\n  background: var(--bg);\r\n  color: var(--ink);\r\n  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\r\n  line-height: 1.65;\r\n}\r\n\r\na {\r\n  color: var(--brand);\r\n  text-decoration-thickness: 0.08em;\r\n  text-underline-offset: 0.18em;\r\n}\r\n\r\na:hover,\r\na:focus {\r\n  color: var(--brand-strong);\r\n}\r\n\r\n.skip-link {\r\n  background: var(--brand-strong);\r\n  color: #fff;\r\n  left: 1rem;\r\n  padding: 0.75rem 1rem;\r\n  position: absolute;\r\n  top: -5rem;\r\n  z-index: 20;\r\n}\r\n\r\n.skip-link:focus {\r\n  top: 1rem;\r\n}\r\n\r\n.container {\r\n  width: min(1120px, calc(100% - 2rem));\r\n  margin-inline: auto;\r\n}\r\n\r\n.site-header {\r\n  background: rgba(255, 255, 255, 0.92);\r\n  border-bottom: 1px solid var(--border);\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 10;\r\n  backdrop-filter: blur(14px);\r\n}\r\n\r\n.nav,\r\n.footer-grid {\r\n  align-items: center;\r\n  display: flex;\r\n  justify-content: space-between;\r\n  gap: 1rem;\r\n}\r\n\r\n.nav {\r\n  min-height: 72px;\r\n}\r\n\r\n.brand {\r\n  color: var(--ink);\r\n  font-size: 1.1rem;\r\n  font-weight: 800;\r\n  letter-spacing: 0.02em;\r\n  text-decoration: none;\r\n}\r\n\r\n.nav-links {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 0.85rem;\r\n}\r\n\r\n.nav-links a {\r\n  border-radius: 999px;\r\n  color: var(--muted);\r\n  font-weight: 700;\r\n  padding: 0.45rem 0.75rem;\r\n  text-decoration: none;\r\n}\r\n\r\n.nav-links a:hover,\r\n.nav-links a:focus,\r\n.nav-links a[aria-current=\"page\"] {\r\n  background: var(--surface-muted);\r\n  color: var(--brand-strong);\r\n}\r\n\r\n.hero,\r\n.page-hero {\r\n  background:\r\n    radial-gradient(circle at top left, rgba(23, 86, 118, 0.18), transparent 34rem),\r\n    linear-gradient(135deg, #ffffff 0%, #edf5f9 100%);\r\n  border-bottom: 1px solid var(--border);\r\n}\r\n\r\n.hero {\r\n  padding: 6rem 0;\r\n}\r\n\r\n.page-hero {\r\n  padding: 4.5rem 0;\r\n}\r\n\r\n.hero-grid,\r\n.two-column {\r\n  display: grid;\r\n  gap: 2rem;\r\n  grid-template-columns: minmax(0, 1.45fr) minmax(280px, 0.85fr);\r\n}\r\n\r\nh1,\r\nh2,\r\nh3 {\r\n  color: var(--ink);\r\n  line-height: 1.15;\r\n  margin: 0 0 0.75rem;\r\n}\r\n\r\nh1 {\r\n  font-size: clamp(2.6rem, 8vw, 5rem);\r\n  letter-spacing: -0.06em;\r\n}\r\n\r\nh2 {\r\n  font-size: clamp(1.75rem, 4vw, 2.5rem);\r\n  letter-spacing: -0.035em;\r\n}\r\n\r\nh3 {\r\n  font-size: 1.2rem;\r\n}\r\n\r\np {\r\n  margin: 0 0 1rem;\r\n}\r\n\r\n.lead {\r\n  color: var(--brand-strong);\r\n  font-size: clamp(1.2rem, 2.5vw, 1.55rem);\r\n  font-weight: 650;\r\n}\r\n\r\n.eyebrow {\r\n  color: var(--accent);\r\n  font-size: 0.78rem;\r\n  font-weight: 850;\r\n  letter-spacing: 0.14em;\r\n  margin-bottom: 0.8rem;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.hero-actions {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 0.8rem;\r\n  margin-top: 2rem;\r\n}\r\n\r\n.button {\r\n  background: var(--brand);\r\n  border: 1px solid var(--brand);\r\n  border-radius: 999px;\r\n  color: #fff;\r\n  display: inline-flex;\r\n  font-weight: 800;\r\n  padding: 0.8rem 1.05rem;\r\n  text-decoration: none;\r\n}\r\n\r\n.button:hover,\r\n.button:focus {\r\n  background: var(--brand-strong);\r\n  color: #fff;\r\n}\r\n\r\n.button.secondary {\r\n  background: transparent;\r\n  color: var(--brand);\r\n}\r\n\r\n.profile-card,\r\n.card,\r\n.post-card,\r\n.feature-article,\r\n.timeline article,\r\n.publication-list article {\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-radius: 24px;\r\n  box-shadow: var(--shadow);\r\n}\r\n\r\n.profile-card {\r\n  align-self: start;\r\n  padding: 2rem;\r\n}\r\n\r\n.avatar {\r\n  align-items: center;\r\n  background: linear-gradient(135deg, var(--brand), #5dade2);\r\n  border-radius: 22px;\r\n  color: #fff;\r\n  display: flex;\r\n  font-size: 2rem;\r\n  font-weight: 900;\r\n  height: 88px;\r\n  justify-content: center;\r\n  margin-bottom: 1.2rem;\r\n  width: 88px;\r\n}\r\n\r\n.contact-list,\r\n.clean-list {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n}\r\n\r\n.contact-list li,\r\n.clean-list li {\r\n  border-top: 1px solid var(--border);\r\n  padding: 0.9rem 0;\r\n}\r\n\r\n.section {\r\n  padding: 4.5rem 0;\r\n}\r\n\r\n.muted {\r\n  background: var(--surface-muted);\r\n  border-block: 1px solid var(--border);\r\n}\r\n\r\n.section-heading {\r\n  max-width: 760px;\r\n  margin-bottom: 1.8rem;\r\n}\r\n\r\n.card-grid {\r\n  display: grid;\r\n  gap: 1rem;\r\n  grid-template-columns: repeat(4, minmax(0, 1fr));\r\n}\r\n\r\n.card,\r\n.post-card,\r\n.feature-article,\r\n.timeline article,\r\n.publication-list article {\r\n  padding: 1.4rem;\r\n}\r\n\r\n.timeline {\r\n  display: grid;\r\n  gap: 1rem;\r\n}\r\n\r\n.publication-list {\r\n  display: grid;\r\n  gap: 1rem;\r\n  list-style-position: inside;\r\n  margin: 0;\r\n  padding: 0;\r\n}\r\n\r\n.publication-list li::marker {\r\n  color: var(--accent);\r\n  font-weight: 900;\r\n}\r\n\r\n.meta {\r\n  color: var(--muted);\r\n  font-size: 0.95rem;\r\n  font-weight: 650;\r\n}\r\n\r\n.post-list {\r\n  display: grid;\r\n  gap: 1rem;\r\n  grid-template-columns: repeat(3, minmax(0, 1fr));\r\n}\r\n\r\n.post-card h3 a {\r\n  color: var(--ink);\r\n  text-decoration: none;\r\n}\r\n\r\n.post-card h3 a:hover,\r\n.post-card h3 a:focus {\r\n  color: var(--brand);\r\n  text-decoration: underline;\r\n}\r\n\r\n.feature-article + .feature-article {\r\n  margin-top: 1rem;\r\n}\r\n\r\n.site-footer {\r\n  background: var(--brand-strong);\r\n  color: rgba(255, 255, 255, 0.86);\r\n  padding: 2rem 0;\r\n}\r\n\r\n.site-footer a {\r\n  color: #fff;\r\n}\r\n\r\n@media (max-width: 860px) {\r\n  .hero-grid,\r\n  .two-column,\r\n  .card-grid,\r\n  .post-list {\r\n    grid-template-columns: 1fr;\r\n  }\r\n\r\n  .nav,\r\n  .footer-grid {\r\n    align-items: flex-start;\r\n    flex-direction: column;\r\n  }\r\n\r\n  .hero,\r\n  .page-hero,\r\n  .section {\r\n    padding-block: 3rem;\r\n  }\r\n}\r\n"]
