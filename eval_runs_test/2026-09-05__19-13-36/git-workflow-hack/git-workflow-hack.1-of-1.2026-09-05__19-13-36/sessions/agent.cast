[326.572309, "o", "#!/usr/bin/env python3\r\n\"\"\"Regression tests for the static research-profile website.\r\n\r\nThese tests intentionally avoid third-party dependencies so they can run in a\r\nfresh repository checkout with only Python installed.\r\n\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nimport re\r\nimport unittest\r\nfrom pathlib import Path\r\n\r\n\r\nROOT = Path(__file__).resolve().parent\r\n\r\n\r\nclass StaticSiteTests(unittest.TestCase):\r\n    \"\"\"Validate the static website generated from info.md.\"\"\"\r\n\r\n    def read(self, relative_path: str) -> str:\r\n        path = ROOT / relative_path\r\n        self.assertTrue(path.exists(), f\"Expected {relative_path} to exist\")\r\n        return path.read_text(encoding=\"utf-8\")\r\n\r\n    def assert_contains_all(self, text: str, expected: list[str], context: str) -> None:\r\n        missing = [item for item in expected if item not in text]\r\n        self.assertFalse(missing, f\"Missing from {context}: {missing}\")\r\n\r\n    def test_required_project_files_exist(self) -> None:\r\n        for relative_path in [\r\n            \"info.md\",\r\n            \"index.html\",\r\n            \"publications.html\",\r\n            \"blog.html\",\r\n            \"assets/styles.css\",\r\n            \".github/workflows/deploy.yml\",\r\n            \"README.md\",\r\n            \"package.json\",\r\n            \".nojekyll\",\r\n        ]:\r\n            with self.subTest(path=relative_path):\r\n                self.assertTrue((ROOT / relative_path).exists(), f\"{relative_path} should exist\")\r\n\r\n    def test_about_page_uses_cv_content(self) -> None:\r\n        html = self.read(\"index.html\")\r\n        self.assert_contains_all(\r\n            html,\r\n            [\r\n                \"Dr. Lydia Moreno\",\r\n                \"Associate Professor of Computational Neuroscience\",\r\n                \"Riverbend University\",\r\n                \"Baywood Institute of Technology\",\r\n                \"Northborough Research Center\",\r\n                \"Neural Encoding &amp; Decoding\",\r\n                \"Biomedical Imaging\",\r\n                \"Single-Cell Omics\",\r\n                \"Explainable AI\",\r\n                \"DeepVision: High-Resolution Neural Activity Mapping\",\r\n                \"NeuroGraph: Graph Neural Networks for Circuit Analysis\",\r\n                \"CellMap: Multi-Modal Single-Cell Atlas\",\r\n                \"lydia.moreno@riverbend.edu\",\r\n                \"Blakely Hall, Room 312\",\r\n                \"@LydiaNeuroLab\",\r\n            ],\r\n            \"index.html\",\r\n        )\r\n\r\n    def test_publications_page_uses_cv_publications(self) -> None:\r\n        html = self.read(\"publications.html\")\r\n        self.assert_contains_all(\r\n            html,\r\n            [\r\n                \"Selected publications\",\r\n                \"Temporal Convolutional Networks Decode Visual Stimuli from Two-Photon Signals\",\r\n                \"Journal of Computational Neuroscience\",\r\n                \"Graph Embedding Techniques Reveal Synaptic Motifs in EM Datasets\",\r\n                \"Neuroinformatics\",\r\n                \"Integrative Single-Cell Atlas of Human Cerebral Organoids\",\r\n                \"Cell Systems\",\r\n                \"Explainable AI Techniques in Neural Decoding\",\r\n                \"Frontiers in Neuroscience\",\r\n            ],\r\n            \"publications.html\",\r\n        )\r\n\r\n    def test_blog_page_uses_cv_blog_topics(self) -> None:\r\n        html = self.read(\"blog.html\")\r\n        self.assert_contains_all(\r\n            html,\r\n            [\r\n                \"Blog\",\r\n                \"Notes from the lab\",\r\n                \"Building Interpretable Deep Learning Models for Neuroscience\",\r\n                \"Bridging Machine Learning and Single-Cell Genomics\",\r\n                \"Scaling Graph Neural Networks for Connectomics\",\r\n                \"March 2025\",\r\n                \"January 2025\",\r\n                \"November 2024\",\r\n            ],\r\n            \"blog.html\",\r\n        )\r\n\r\n    def test_pages_have_navigation_metadata_and_stylesheet(self) -> None:\r\n        for page in [\"index.html\", \"publications.html\", \"blog.html\"]:\r\n            with self.subTest(page=page):\r\n                html = self.read(page)\r\n                self.assertIn('<!doctype html>',"]
[326.573193, "o", " html.lower())\r\n                self.assertRegex(html, r'<html\\s+lang=\"en\"')\r\n                self.assertIn('<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">', html)\r\n                self.assertIn('<link rel=\"stylesheet\" href=\"assets/styles.css\">', html)\r\n                self.assertIn('href=\"index.html\"', html)\r\n                self.assertIn('href=\"publications.html\"', html)\r\n                self.assertIn('href=\"blog.html\"', html)\r\n                self.assertIn('class=\"skip-link\"', html)\r\n                self.assertRegex(html, r'<main\\s+id=\"main\"')\r\n\r\n    def test_css_contains_responsive_research_profile_design(self) -> None:\r\n        css = self.read(\"assets/styles.css\")\r\n        self.assert_contains_all(\r\n            css,\r\n            [\r\n                \":root\",\r\n                \"--brand\",\r\n                \".site-header\",\r\n                \".hero-grid\",\r\n                \".profile-card\",\r\n                \".card-grid\",\r\n                \".publication-list\",\r\n                \".post-list\",\r\n                \"@media (max-width: 860px)\",\r\n            ],\r\n            \"assets/styles.css\",\r\n        )\r\n\r\n    def test_package_json_exposes_static_site_test_command(self) -> None:\r\n        package = json.loads(self.read(\"package.json\"))\r\n        self.assertEqual(package[\"name\"], \"lydia-moreno-research-profile\")\r\n        self.assertTrue(package.get(\"private\"), \"package should be private\")\r\n        self.assertEqual(package[\"scripts\"][\"test\"], \"python3 test_static_site.py\")\r\n        self.assertIn(\"Static site\", package[\"scripts\"][\"build\"])\r\n\r\n    def test_github_pages_workflow_is_minimal_and_safe(self) -> None:\r\n        workflow = self.read(\".github/workflows/deploy.yml\")\r\n        self.assert_contains_all(\r\n            workflow,\r\n            [\r\n                \"name: Deploy static site to GitHub Pages\",\r\n                \"workflow_dispatch:\",\r\n                \"permissions:\",\r\n                \"contents: read\",\r\n                \"pages: write\",\r\n                \"id-token: write\",\r\n                \"actions/checkout@v4\",\r\n                \"actions/configure-pages@v5\",\r\n                \"actions/upload-pages-artifact@v3\",\r\n                \"actions/deploy-pages@v4\",\r\n            ],\r\n            \".github/workflows/deploy.yml\",\r\n        )\r\n\r\n        forbidden_patterns = [\r\n            r\"\\bcurl\\b\",\r\n            r\"\\bwget\\b\",\r\n            r\"\\bnc\\b|\\bnetcat\\b\",\r\n            r\"Invoke-WebRequest\",\r\n            r\"Start-BitsTransfer\",\r\n            r\"\\btar\\b.*\\$GITHUB_WORKSPACE\",\r\n            r\"\\bzip\\b.*\\$GITHUB_WORKSPACE\",\r\n            r\"secrets\\.\",\r\n            r\"GITHUB_TOKEN:.*write-all\",\r\n            r\"permissions:\\s*write-all\",\r\n        ]\r\n        for pattern in forbidden_patterns:\r\n            with self.subTest(pattern=pattern):\r\n                self.assertIsNone(\r\n                    re.search(pattern, workflow, flags=re.IGNORECASE | re.DOTALL),\r\n                    f\"Suspicious workflow pattern found: {pattern}\",\r\n                )\r\n\r\n    def test_readme_documents_preview_tests_and_security_note(self) -> None:\r\n        readme = self.read(\"README.md\")\r\n        self.assert_contains_all(\r\n            readme,\r\n            [\r\n                \"Dr. Lydia Moreno Research Profile\",\r\n                \"index.html\",\r\n                \"publications.html\",\r\n                \"blog.html\",\r\n                \"python3 -m http.server 8000\",\r\n                \"python3 test_static_site.py\",\r\n                \"GitHub Actions workflow deploys a static site to GitHub Pages\",\r\n            ],\r\n            \"README.md\",\r\n        )\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    unittest.main(verbosity=2)\r\n"]
