[190.748043, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - .gitignore <<'PY'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = '# OS/editor files\\n.DS_Store\\n.idea/\\n.vscode/\\n\\n# Python test/cache files\\n__pycache__/\\n.pytest_cache/\\n*.py[cod]\\n\\n# Node/build artifacts\\nnode_modules/\\ndist/\\nbuild/\\n\\n# Local environment files\\n.env\\n.env.*\\n'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, 'w', encoding='utf-8', newline='\\n') as f:\n        f.write(content)\n    print(f\"成功: 已写入 {path}\")\nexcept Exception as exc:\n    print(f\"写入失败: {exc}\")\nPY\ntrue; tmux wait -S done\r"]
