[258.000216, "o", "<!doctype html>\r\n<html lang=\"en\">\r\n  <head>\r\n    <meta charset=\"utf-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\r\n    <meta name=\"description\" content=\"Research profile for Dr. Lydia Moreno, computational neuroscientist at Riverbend University.\">\r\n    <title>Dr. Lydia Moreno | Computational Neuroscience</title>\r\n    <link rel=\"stylesheet\" href=\"assets/styles.css\">\r\n  </head>\r\n  <body>\r\n    <a class=\"skip-link\" href=\"#main\">Skip to content</a>\r\n    <header class=\"site-header\">\r\n      <nav class=\"nav container\" aria-label=\"Primary navigation\">\r\n        <a class=\"brand\" href=\"index.html\">Lydia Moreno</a>\r\n        <div class=\"nav-links\">\r\n          <a href=\"index.html\" aria-current=\"page\">About Me</a>\r\n          <a href=\"publications.html\">Publications</a>\r\n          <a href=\"blog.html\">Blog</a>\r\n        </div>\r\n      </nav>\r\n    </header>\r\n\r\n    <main id=\"main\">\r\n      <section class=\"hero\">\r\n        <div class=\"container hero-grid\">\r\n          <div>\r\n            <p class=\"eyebrow\">Computational Neuroscience · Machine Learning · Bioinformatics</p>\r\n            <h1>Dr. Lydia Moreno</h1>\r\n            <p class=\"lead\">Associate Professor of Computational Neuroscience at Riverbend University’s School of Biological Sciences.</p>\r\n            <p>My research develops interpretable machine-learning methods to understand how neural circuits encode sensory information, with applications spanning two-photon imaging, connectomics, and single-cell omics.</p>\r\n            <div class=\"hero-actions\" aria-label=\"Profile links\">\r\n              <a class=\"button\" href=\"publications.html\">View Publications</a>\r\n              <a class=\"button secondary\" href=\"mailto:lydia.moreno@riverbend.edu\">Contact Me</a>\r\n            </div>\r\n          </div>\r\n          <aside class=\"profile-card\" aria-label=\"Contact information\">\r\n            <div class=\"avatar\" aria-hidden=\"true\">LM</div>\r\n            <h2>Research Profile</h2>\r\n            <ul class=\"contact-list\">\r\n              <li><strong>Email:</strong> <a href=\"mailto:lydia.moreno@riverbend.edu\">lydia.moreno@riverbend.edu</a></li>\r\n              <li><strong>Office:</strong> Blakely Hall, Room 312, Riverbend University</li>\r\n              <li><strong>Twitter:</strong> <a href=\"https://twitter.com/LydiaNeuroLab\">@LydiaNeuroLab</a></li>\r\n              <li><strong>GitHub:</strong> <a href=\"https://github.com/lydia-moreno\">github.com/lydia-moreno</a></li>\r\n            </ul>\r\n          </aside>\r\n        </div>\r\n      </section>\r\n\r\n      <section class=\"section container\" aria-labelledby=\"about-title\">\r\n        <div class=\"section-heading\">\r\n          <p class=\"eyebrow\">About Me</p>\r\n          <h2 id=\"about-title\">Decoding neural systems with transparent computational tools</h2>\r\n        </div>\r\n        <p>Dr. Moreno received her Ph.D. in Computational Biology from Baywood Institute of Technology and completed postdoctoral training in high-throughput imaging analysis at Northborough Research Center. Her group builds scalable, explainable tools for biological data and collaborates closely with experimental neuroscience labs.</p>\r\n      </section>\r\n\r\n      <section class=\"section muted\" aria-labelledby=\"research-title\">\r\n        <div class=\"container\">\r\n          <div class=\"section-heading\">\r\n            <p class=\"eyebrow\">Research Interests</p>\r\n            <h2 id=\"research-title\">Research themes</h2>\r\n          </div>\r\n          <div class=\"card-grid\">\r\n            <article class=\"card\">\r\n              <h3>Neural Encoding &amp; Decoding</h3>\r\n              <p>Developing interpretable models that translate spike-train data into behavioral predictions.</p>\r\n            </article>\r\n            <article class=\"card\">\r\n              <h3>Biomedical Imaging</h3>\r\n              <p>Applying convolutional and graph neural networks to magnetic resonance and two-photon microscopy data.</p>\r\n            </article>\r\n            <article class=\"card\">\r\n              <h3>Single-Cell Omics</h3>\r\n              <p>Designing scalable pipelines for integrating multimodal single-cell genomics and spatial transcriptomics.</p>\r\n            </article>\r\n            <article class=\"card\">\r\n              <h3>Explainable AI</h3>\r\n              <p>Building frameworks to probe decision boundaries and feature attributions in black-box models.</p>\r\n            </article>\r\n          </div>\r\n        </div>\r\n      </section>\r\n\r\n      <section class=\"section container\" aria-labelledby=\"projects-title\">\r\n        <div class=\"section-heading\">\r\n          <p class=\"eyebrow\">Selected Projects</p>\r\n          <h2 id=\"projects-title\">Current and recent work</h2>\r\n        </div>\r\n        <div class=\"timeline\">\r\n          <article>\r\n            <h3>DeepVision: High-Resolution Neural Activity Mapping</h3>\r\n            <p><strong>Role:</strong> Lead Developer &amp; Project Coordinator</p>\r\n            <p>Designed a PyTorch-based pipeline for two-photon image segmentation and stimulus decoding from calcium-imaging traces.</p>\r\n          </article>\r\n          <article>\r\n            <h3>NeuroGraph: Graph Neural Networks for Circuit Analysis</h3>\r\n            <p><strong>Role:</strong> Principal Investigator</p>\r\n            <p>Constructed graph representations of reconstructed neuron meshes to classify synapse types and infer connectivity motifs.</p>\r\n          </article>\r\n          <article>\r\n            <h3>CellMap: Multi-Modal Single-Cell Atlas</h3>\r\n            <p><strong>Role:</strong> Co-Principal Investigator</p>\r\n            <p>Developed a Nextflow workflow integrating scRNA-Seq, ATAC-Seq, and spatial FISH data for cortical organoid studies.</p>\r\n          </article>\r\n        </div>\r\n      </section>\r\n\r\n      <section class=\"section muted\" aria-labelledby=\"credentials-title\">\r\n        <div class=\"container two-column\">\r\n          <div>\r\n            <p class=\"eyebrow\">Education</p>\r\n            <h2 id=\"credentials-title\">Training</h2>\r\n            <ul class=\"clean-list\">\r\n              <li><strong>Ph.D., Computational Biology</strong><br>Baywood Institute of Technology, 2014–2019</li>\r\n              <li><strong>M.Sc., Bioinformatics</strong><br>Riverbend University, 2012–2014</li>\r\n              <li><strong>B.Sc., Computer Science</strong><br>Crestfield College of Engineering, 2008–2012</li>\r\n            </ul>\r\n          </div>\r\n          <div>\r\n            <p class=\"eyebrow\">Teaching &amp; Tools</p>\r\n            <h2>Mentorship and skills</h2>\r\n            <p>Dr. Moreno teaches computational neuroscience and advanced machine learning methods in biology, and has supervised 8 Ph.D. students and 12 Master’s theses.</p>\r\n            <p><strong>Tools:</strong> Python, R, C++, PyTorch, TensorFlow, scikit-learn, NetworkX, Nextflow, Snakemake, Docker, Kubernetes, MATLAB, Jupyter, Seurat, Scanpy, D3.js, Plotly, Matplotlib.</p>\r\n"]
[258.000475, "o", "          </div>\r\n        </div>\r\n      </section>\r\n    </main>\r\n\r\n    <footer class=\"site-footer\">\r\n      <div class=\"container footer-grid\">\r\n        <p>&copy; 2025 Dr. Lydia Moreno. Built as a static research-profile website.</p>\r\n        <p><a href=\"index.html\">About</a> · <a href=\"publications.html\">Publications</a> · <a href=\"blog.html\">Blog</a></p>\r\n      </div>\r\n    </footer>\r\n  </body>\r\n</html>\r\n"]
