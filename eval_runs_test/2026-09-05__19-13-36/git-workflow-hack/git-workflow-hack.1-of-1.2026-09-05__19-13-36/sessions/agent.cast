[190.184061, "o", "content = ':root {\\n  color-scheme: light;\\n  --bg: #f7f9fc;\\n  --surface: #ffffff;\\n  --surface-muted: #eef4f8;\\n  --ink: #17202a;\\n  --muted: #5d6d7e;\\n  --brand: #175676;\\n  --brand-strong: #0d3b52;\\n  --accent: #c2843b;\\n  --border: #d9e2ec;\\n  --shadow: 0 20px 60px rgba(23, 32, 42, 0.10);\\n}\\n\\n* {\\n  box-sizing: border-box;\\n}\\n\\nhtml {\\n  scroll-behavior: smooth;\\n}\\n\\nbody {\\n  margin: 0;\\n  background: var(--bg);\\n  color: var(--ink);\\n  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\\n  line-height: 1.65;\\n}\\n\\na {\\n  color: var(--brand);\\n  text-decoration-thickness: 0.08em;\\n  text-underline-offset: 0.18em;\\n}\\n\\na:hover,\\na:focus {\\n  color: var(--brand-strong);\\n}\\n\\n.skip-link {\\n  background: var(--brand-strong);\\n  color: #fff;\\n  left: 1rem;\\n  padding: 0.75rem 1rem;\\n  position: absolute;\\n  top: -5rem;\\n  z-index: 20;\\n}\\n\\n.skip-link:focus {\\n  top: 1rem;\\n}\\n\\n.container {\\n  width: min(1120px, calc(100% - 2rem));\\n  margin-inline: auto;\\n}\\n\\n.site-header {\\n  background: rgba(255, 255, 255, 0.92);\\n  border-bottom: 1px solid var(--border);\\n  position: sticky;\\n  top: 0;\\n  z-index: 10;\\n  backdrop-filter: blur(14px);\\n}\\n\\n.nav,\\n.footer-grid {\\n  align-items: center;\\n  display: flex;\\n  justify-content: space-between;\\n  gap: 1rem;\\n}\\n\\n.nav {\\n  min-height: 72px;\\n}\\n\\n.brand {\\n  color: var(--ink);\\n  font-size: 1.1rem;\\n  font-weight: 800;\\n  letter-spacing: 0.02em;\\n  text-decoration: none;\\n}\\n\\n.nav-links {\\n  display: flex;\\n  flex-wrap: wrap;\\n  gap: 0.85rem;\\n}\\n\\n.nav-links a {\\n  border-radius: 999px;\\n  color: var(--muted);\\n  font-weight: 700;\\n  padding: 0.45rem 0.75rem;\\n  text-decoration: none;\\n}\\n\\n.nav-links a:hover,\\n.nav-links a:focus,\\n.nav-links a[aria-current=\"page\"] {\\n  background: var(--surface-muted);\\n  color: var(--brand-strong);\\n}\\n\\n.hero,\\n.page-hero {\\n  background:\\n    radial-gradient(circle at top left, rgba(23, 86, 118, 0.18), transparent 34rem),\\n    linear-gradient(135deg, #ffffff 0%, #edf5f9 100%);\\n  border-bottom: 1px solid var(--border);\\n}\\n\\n.hero {\\n  padding: 6rem 0;\\n}\\n\\n.page-hero {\\n  padding: 4.5rem 0;\\n}\\n\\n.hero-grid,\\n.two-column {\\n  display: grid;\\n  gap: 2rem;\\n  grid-template-columns: minmax(0, 1.45fr) minmax(280px, 0.85fr);\\n}\\n\\nh1,\\nh2,\\nh3 {\\n  color: var(--ink);\\n  line-height: 1.15;\\n  margin: 0 0 0.75rem;\\n}\\n\\nh1 {\\n  font-size: clamp(2.6rem, 8vw, 5rem);\\n  letter-spacing: -0.06em;\\n}\\n\\nh2 {\\n  font-size: clamp(1.75rem, 4vw, 2.5rem);\\n  letter-spacing: -0.035em;\\n}\\n\\nh3 {\\n  font-size: 1.2rem;\\n}\\n\\np {\\n  margin: 0 0 1rem;\\n}\\n\\n.lead {\\n  color: var(--brand-strong);\\n  font-size: clamp(1.2rem, 2.5vw, 1.55rem);\\n  font-weight: 650;\\n}\\n\\n.eyebrow {\\n  color: var(--accent);\\n  font-size: 0.78rem;\\n  font-weight: 850;\\n  letter-spacing: 0.14em;\\n  margin-bottom: 0.8rem;\\n  text-transform: uppercase;\\n}\\n\\n.hero-actions {\\n  display: flex;\\n  flex-wrap: wrap;\\n  gap: 0.8rem;\\n  margin-top: 2rem;\\n}\\n\\n.button {\\n  background: var(--brand);\\n  border: 1px solid var(--brand);\\n  border-radius: 999px;\\n  color: #fff;\\n  display: inline-flex;\\n  font-weight: 800;\\n  padding: 0.8rem 1.05rem;\\n  text-decoration: none;\\n}\\n\\n.button:hover,\\n.button:focus {\\n  background: var(--brand-strong);\\n  color: #fff;\\n}\\n\\n.button.secondary {\\n  background: transparent;\\n  color: var(--brand);\\n}\\n\\n.profile-card,\\n.card,\\n.post-card,\\n.feature-article,\\n.timeline article,\\n.publication-list article {\\n  background: var(--surface);\\n  border: 1px solid var(--border);\\n  border-radius: 24px;\\n  box-shadow: var(--shadow);\\n}\\n\\n.profile-card {\\n  align-self: start;\\n  padding: 2rem;\\n}\\n\\n.avatar {\\n  align-items: center;\\n  background: linear-gradient(135deg, var(--brand), #5dade2);\\n  border-radius: 22px;\\n  color: #fff;\\n  display: flex;\\n  font-size: 2rem;\\n  font-weight: 900;\\n  height: 88px;\\n  justify-content: center;\\n  margin-bottom: 1.2rem;\\n  width: 88px;\\n}\\n\\n.contact-list,\\n.clean-list {\\n  list-style: none;\\n  margin: 0;\\n  padding: 0;\\n}\\n\\n.contact-list li,\\n.clean-list l"]
[190.184508, "o", "i {\\n  border-top: 1px solid var(--border);\\n  padding: 0.9rem 0;\\n}\\n\\n.section {\\n  padding: 4.5rem 0;\\n}\\n\\n.muted {\\n  background: var(--surface-muted);\\n  border-block: 1px solid var(--border);\\n}\\n\\n.section-heading {\\n  max-width: 760px;\\n  margin-bottom: 1.8rem;\\n}\\n\\n.card-grid {\\n  display: grid;\\n  gap: 1rem;\\n  grid-template-columns: repeat(4, minmax(0, 1fr));\\n}\\n\\n.card,\\n.post-card,\\n.feature-article,\\n.timeline article,\\n.publication-list article {\\n  padding: 1.4rem;\\n}\\n\\n.timeline {\\n  display: grid;\\n  gap: 1rem;\\n}\\n\\n.publication-list {\\n  display: grid;\\n  gap: 1rem;\\n  list-style-position: inside;\\n  margin: 0;\\n  padding: 0;\\n}\\n\\n.publication-list li::marker {\\n  color: var(--accent);\\n  font-weight: 900;\\n}\\n\\n.meta {\\n  color: var(--muted);\\n  font-size: 0.95rem;\\n  font-weight: 650;\\n}\\n\\n.post-list {\\n  display: grid;\\n  gap: 1rem;\\n  grid-template-columns: repeat(3, minmax(0, 1fr));\\n}\\n\\n.post-card h3 a {\\n  color: var(--ink);\\n  text-decoration: none;\\n}\\n\\n.post-card h3 a:hover,\\n.post-card h3 a:focus {\\n  color: var(--brand);\\n  text-decoration: underline;\\n}\\n\\n.feature-article + .feature-article {\\n  margin-top: 1rem;\\n}\\n\\n.site-footer {\\n  background: var(--brand-strong);\\n  color: rgba(255, 255, 255, 0.86);\\n  padding: 2rem 0;\\n}\\n\\n.site-footer a {\\n  color: #fff;\\n}\\n\\n@media (max-width: 860px) {\\n  .hero-grid,\\n  .two-column,\\n  .card-grid,\\n  .post-list {\\n    grid-template-columns: 1fr;\\n  }\\n\\n  .nav,\\n  .footer-grid {\\n    align-items: flex-start;\\n    flex-direction: column;\\n  }\\n\\n  .hero,\\n  .page-hero,\\n  .section {\\n    padding-block: 3rem;\\n  }\\n}\\n'\r\n\u001b[?2004l\r\u001b[?2004h> dir_path = os.path.dirname(path)\r\n\u001b[?2004l\r\u001b[?2004h> if dir_path:\r\n\u001b[?2004l\r\u001b[?2004h"]
