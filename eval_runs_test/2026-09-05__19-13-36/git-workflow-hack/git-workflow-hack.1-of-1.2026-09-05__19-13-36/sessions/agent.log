[?2004l[?2004h> content = '<!doctype html>\n<html lang="en">\n  <head>\n    <meta charset="utf-8">\n    <meta name="viewport" content="width=device-width, initial-scale=1">\n    <meta name="description" content="Blog posts from Dr. Lydia Moreno on interpretable deep learning, single-cell genomics, and connectomics.">\n    <title>Blog | Dr. Lydia Moreno</title>\n    <link rel="stylesheet" href="assets/styles.css">\n  </head>\n  <body>\n    <a class="skip-link" href="#main">Skip to content</a>\n    <header class="site-header">\n      <nav class="nav container" aria-label="Primary navigation">\n        <a class="brand" href="index.html">Lydia Moreno</a>\n        <div class="nav-links">\n          <a href="index.html">About Me</a>\n          <a href="publications.html">Publications</a>\n          <a href="blog.html" aria-current="page">Blog</a>\n        </div>\n      </nav>\n    </header>\n\n    <main id="main">\n      <section class="page-hero">\n        <div class="container">\n          <p class="eyebrow">Blog</p>\n          <h1>Notes from the lab</h1>\n          <p class="lead">Short essays on transparent machine learning, biological data integration, and the practice of computational neuroscience.</p>\n        </div>\n      </section>\n\n      <section class="section container" aria-labelledby="latest-posts">\n        <div class="section-heading">\n          <h2 id="latest-posts">Latest posts</h2>\n        </div>\n        <div class="post-list">\n          <article class="post-card">\n            <p class="meta">March 2025 · Methods</p>\n            <h3><a href="#interpretable-deep-learning">Building Interpretable Deep Learning Models for Neuroscience</a></h3>\n            <p>How my group combines temporal convolutional networks, attribution checks, and experimental validation to make neural decoders more transparent.</p>\n          </article>\n          <article class="post-card">\n            <p class="meta">January 2025 · Data integration</p>\n            <h3><a href="#single-cell-genomics">Bridging Machine Learning and Single-Cell Genomics</a></h3>\n            <p>Lessons from building scalable pipelines for multimodal single-cell genomics and spatial transcriptomics.</p>\n          </article>\n          <article class="post-card">\n            <p class="meta">November 2024 · Connectomics</p>\n            <h3><a href="#connectomics">Scaling Graph Neural Networks for Connectomics</a></h3>\n            <p>Practical notes on graph construction, motif discovery, and collaboration between model developers and microscopy teams.</p>\n          </article>\n        </div>\n      </section>\n\n      <section class="section muted" aria-label="Blog summaries">\n        <div class="container">\n          <article id="interpretable-deep-learning" class="feature-article">\n            <p class="eyebrow">March 2025</p>\n            <h2>Building Interpretable Deep Learning Models for Neuroscience</h2>\n            <p>Interpretable neural decoders require more than strong predictive performance. Our lab evaluates feature attributions, stability across recording sessions, and alignment with known circuit physiology before using models to generate hypotheses.</p>\n          </article>\n          <article id="single-cell-genomics" class="feature-article">\n            <p class="eyebrow">January 2025</p>\n            <h2>Bridging Machine Learning and Single-Cell Genomics</h2>\n            <p>Single-cell projects succeed when data engineering, statistical modeling, and biological interpretation are designed together. CellMap reflects this by combining reproducible workflows with Bayesian clustering and careful visual review.</p>\n          </article>\n          <article id="connectomics" class="feature-article">\n            <p class="eyebrow">November 2024</p>\n            <h2>Scaling Graph Neural Networks for Connectomics</h2>\n            <p>Connectomics graphs are large, noisy, and richly structured. NeuroGraph focuses on robust graph representations that help researchers classify synapses and compare connectivity motifs across datasets.</p>\n          </article>\n        </div>\n      </section>\n    </main>\n\n    <footer class="site-footer">\n      <div class="container footer-grid">\n        <p>&copy; 2025 Dr. Lydia Moreno.</p>\n        <p><a href="index.html">About</a> · <a href="publications.html">Publications</a> · <a href="blog.html">Blog</a></p>\n      </div>\n    </footer>\n  </body>\n</html>\n'
