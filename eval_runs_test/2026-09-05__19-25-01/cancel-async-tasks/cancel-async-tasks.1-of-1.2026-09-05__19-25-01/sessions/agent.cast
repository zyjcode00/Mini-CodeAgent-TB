[102.771831, "o", "content = 'import asyncio\\nimport unittest\\n\\nfrom run import run_tasks\\n\\n\\nclass RunTasksTests(unittest.IsolatedAsyncioTestCase):\\n    async def test_respects_max_concurrent_and_runs_all_tasks(self) -> None:\\n        active = 0\\n        max_seen = 0\\n        completed: list[int] = []\\n        lock = asyncio.Lock()\\n\\n        def make_task(index: int):\\n            async def job() -> None:\\n                nonlocal active, max_seen\\n                async with lock:\\n                    active += 1\\n                    max_seen = max(max_seen, active)\\n                await asyncio.sleep(0.01)\\n                completed.append(index)\\n                async with lock:\\n                    active -= 1\\n\\n            return job\\n\\n        await run_tasks([make_task(i) for i in range(10)], max_concurrent=3)\\n\\n        self.assertEqual(sorted(completed), list(range(10)))\\n        self.assertLessEqual(max_seen, 3)\\n        self.assertEqual(max_seen, 3)\\n\\n    async def test_rejects_non_positive_max_concurrent(self)"]
[102.772033, "o", " -> None:\\n        with self.assertRaises(ValueError):\\n            await run_tasks([], max_concurrent=0)\\n\\n    async def test_exception_is_propagated_and_other_jobs_are_cancelled_cleanly(self) -> None:\\n        blocker_started = asyncio.Event()\\n        blocker_cleaned_up = asyncio.Event()\\n\\n        async def blocker() -> None:\\n            try:\\n                blocker_started.set()\\n                await asyncio.Event().wait()\\n            finally:\\n                blocker_cleaned_up.set()\\n\\n        async def failing() -> None:\\n            await blocker_started.wait()\\n            await asyncio.sleep(0)\\n            raise RuntimeError(\"boom\")\\n\\n        with self.assertRaisesRegex(RuntimeError, \"boom\"):\\n            await run_tasks([blocker, failing], max_concurrent=2)\\n\\n        self.assertTrue(blocker_cleaned_up.is_set())\\n\\n    async def test_external_cancellation_allows_active_jobs_to_run_cleanup(self) -> None:\\n        started = 0\\n        cleaned_up = 0\\n        all_started = asyncio.Event()\\n   "]
[102.772118, "o", "     cleanup_done = asyncio.Event()\\n        lock = asyncio.Lock()\\n\\n        def make_blocking_job():\\n            async def job() -> None:\\n                nonlocal started, cleaned_up\\n                try:\\n                    async with lock:\\n                        started += 1\\n                        if started == 2:\\n                            all_started.set()\\n                    await asyncio.Event().wait()\\n                finally:\\n                    async with lock:\\n                        cleaned_up += 1\\n                        if cleaned_up == 2:\\n                            cleanup_done.set()\\n\\n            return job\\n\\n        runner = asyncio.create_task(\\n            run_tasks([make_blocking_job(), make_blocking_job()], max_concurrent=2)\\n        )\\n        await asyncio.wait_for(all_started.wait(), timeout=1)\\n\\n        runner.cancel()\\n        with self.assertRaises(asyncio.CancelledError):\\n            await runner\\n\\n        await asyncio.wait_for(cleanup_done.wait(), timeout=1)\\"]
