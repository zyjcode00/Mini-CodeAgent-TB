[74.584131, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - run.py <<'PY'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = 'import asyncio\\nfrom collections.abc import Awaitable, Callable\\nfrom typing import TypeVar\\n\\n_T = TypeVar(\"_T\")\\n\\n\\nasync def run_tasks(\\n    tasks: list[Callable[[], Awaitable[None]]],\\n    max_concurrent: int,\\n) -> None:\\n    \"\"\"Run async task factories with a concurrency limit.\\n\\n    Args:\\n        tasks: A list of zero-argument callables. Each callable must return an\\n            awaitable async job when invoked.\\n        max_concurrent: The maximum number of jobs to run at the same time.\\n\\n    If any job raises, pending worker tasks are cancelled and awaited before the\\n    original exception is re-raised. If this coroutine itself is cancelled (for\\n    example via Ctrl-C when run under ``asyncio.run``), active jobs are also\\n    cancelled and awaited so their ``finally``/cleanup code gets a chance to run.\\n    \"\"\"\\n    if max_concurrent < 1:\\n        raise ValueError(\"max"]
[74.58428, "i", "_concurrent must be at least 1\")\\n\\n    if not tasks:\\n        return\\n\\n    task_iter = iter(tasks)\\n    iterator_lock = asyncio.Lock()\\n    sentinel = object()\\n\\n    async def get_next_task() -> Callable[[], Awaitable[None]] | object:\\n        async with iterator_lock:\\n            return next(task_iter, sentinel)\\n\\n    async def worker() -> None:\\n        while True:\\n            task_factory = await get_next_task()\\n            if task_factory is sentinel:\\n                return\\n            await task_factory()  # type: ignore[operator]\\n\\n    workers = [\\n        asyncio.create_task(worker())\\n        for _ in range(min(max_concurrent, len(tasks)))\\n    ]\\n\\n    try:\\n        await asyncio.gather(*workers)\\n    except BaseException:\\n        for worker_task in workers:\\n            if not worker_task.done():\\n                worker_task.cancel()\\n        await asyncio.gather(*workers, return_exceptions=True)\\n        raise\\n'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exi"]
[74.584465, "i", "st_ok=True)\ntry:\n    with open(path, 'w', encoding='utf-8', newline='\\n') as f:\n        f.write(content)\n    print(f\"成功: 已写入 {path}\")\nexcept Exception as exc:\n    print(f\"写入失败: {exc}\")\nPY\ntrue; tmux wait -S done\r"]
[74.584638, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
[74.584911, "o", "st_ok=True)\r\ntry:\r\n    with open(path, 'w', encoding='utf-8', newline='\\n') as f:\r\n        f.write(content)\r\n    print(f\"成功: 已写入 {path}\")\r\nexcept Exception as exc:\r\n    print(f\"写入失败: {exc}\")\r\nPY\r\ntrue; tmux wait -S done\r\n\u001b[?2004hroot@d07dd5324d1d:/app# "]
[74.585114, "o", "python3 - run.py <<'PY'\r\n\u001b[?2004l\r"]
[74.585302, "o", "\u001b[?2004h> "]
[74.585379, "o", "import os"]
[74.58551, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.585623, "o", "> "]
[74.585723, "o", "import sys\r\n\u001b[?2004l\r"]
[74.585882, "o", "\u001b[?2004h> "]
[74.585985, "o", "path = sys.argv[1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.592215, "o", "content = 'import asyncio\\nfrom collections.abc import Awaitable, Callable\\nfrom typing import TypeVar\\n\\n_T = TypeVar(\"_T\")\\n\\n\\nasync def run_tasks(\\n    tasks: list[Callable[[], Awaitable[None]]],\\n    max_concurrent: int,\\n) -> None:\\n    \"\"\"Run async task factories with a concurrency limit.\\n\\n    Args:\\n        tasks: A list of zero-argument callables. Each callable must return an\\n            awaitable async job when invoked.\\n        max_concurrent: The maximum number of jobs to run at the same time.\\n\\n    If any job raises, pending worker tasks are cancelled and awaited before the\\n    original exception is re-raised. If this coroutine itself is cancelled (for\\n    example via Ctrl-C when run under ``asyncio.run``), active jobs are also\\n    cancelled and awaited so their ``finally``/cleanup code gets a chance to run.\\n    \"\"\"\\n    if max_concurrent < 1:\\n        raise ValueError(\"max_concurrent must be at least 1\")\\n\\n    if not tasks:\\n        return\\n\\n    task_iter = iter(tasks)\\n    iterator_lo"]
[74.592485, "o", "ck = asyncio.Lock()\\n    sentinel = object()\\n\\n    async def get_next_task() -> Callable[[], Awaitable[None]] | object:\\n        async with iterator_lock:\\n            return next(task_iter, sentinel)\\n\\n    async def worker() -> None:\\n        while True:\\n            task_factory = await get_next_task()\\n            if task_factory is sentinel:\\n                return\\n            await task_factory()  # type: ignore[operator]\\n\\n    workers = [\\n        asyncio.create_task(worker())\\n        for _ in range(min(max_concurrent, len(tasks)))\\n    ]\\n\\n    try:\\n        await asyncio.gather(*workers)\\n    except BaseException:\\n        for worker_task in workers:\\n            if not worker_task.done():\\n                worker_task.cancel()\\n        await asyncio.gather(*workers, return_exceptions=True)\\n        raise\\n'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.592593, "o", "dir_path = os.path.dirname(path)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.592705, "o", "if dir_path:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.592849, "o", "    os.makedirs(dir_path, exist_ok=True)\r\n\u001b[?2004l\r"]
[74.592915, "o", "\u001b[?2004h> "]
[74.592974, "o", "try:\r\n"]
[74.593134, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[74.593309, "o", "    with open(path, 'w', encoding='utf-8', newline='\\n') as f:\r\n\u001b[?2004l\r"]
[74.593429, "o", "\u001b[?2004h> "]
[74.593538, "o", "        f.write(content)\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.593644, "o", "> "]
[74.593763, "o", "    print(f\"成功: 已写入 {path}\")\r\n\u001b[?2004l\r"]
[74.593847, "o", "\u001b[?2004h> "]
[74.59396, "o", "except Exception as exc:\r\n\u001b[?2004l\r"]
[74.594054, "o", "\u001b[?2004h"]
[74.594157, "o", ">     print(f\"写入失败: {exc}\")\r\n\u001b[?2004l\r"]
