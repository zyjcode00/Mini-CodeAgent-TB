[102.759629, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - test_run.py <<'PY'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = 'import asyncio\\nimport unittest\\n\\nfrom run import run_tasks\\n\\n\\nclass RunTasksTests(unittest.IsolatedAsyncioTestCase):\\n    async def test_respects_max_concurrent_and_runs_all_tasks(self) -> None:\\n        active = 0\\n        max_seen = 0\\n        completed: list[int] = []\\n        lock = asyncio.Lock()\\n\\n        def make_task(index: int):\\n            async def job() -> None:\\n                nonlocal active, max_seen\\n                async with lock:\\n                    active += 1\\n                    max_seen = max(max_seen, active)\\n                await asyncio.sleep(0.01)\\n                completed.append(index)\\n                async with lock:\\n                    active -= 1\\n\\n            return job\\n\\n        await run_tasks([make_task(i) for i in range(10)], max_concurrent=3)\\n\\n        self.assertEqual(sorted(completed), list(range(10)))\\n        self.assertLes"]
[102.759794, "i", "sEqual(max_seen, 3)\\n        self.assertEqual(max_seen, 3)\\n\\n    async def test_rejects_non_positive_max_concurrent(self) -> None:\\n        with self.assertRaises(ValueError):\\n            await run_tasks([], max_concurrent=0)\\n\\n    async def test_exception_is_propagated_and_other_jobs_are_cancelled_cleanly(self) -> None:\\n        blocker_started = asyncio.Event()\\n        blocker_cleaned_up = asyncio.Event()\\n\\n        async def blocker() -> None:\\n            try:\\n                blocker_started.set()\\n                await asyncio.Event().wait()\\n            finally:\\n                blocker_cleaned_up.set()\\n\\n        async def failing() -> None:\\n            await blocker_started.wait()\\n            await asyncio.sleep(0)\\n            raise RuntimeError(\"boom\")\\n\\n        with self.assertRaisesRegex(RuntimeError, \"boom\"):\\n            await run_tasks([blocker, failing], max_concurrent=2)\\n\\n        self.assertTrue(blocker_cleaned_up.is_set())\\n\\n    async def test_external_cancellation_allows_active_j"]
