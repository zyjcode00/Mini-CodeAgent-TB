[?2004l[?2004h> content = 'import asyncio\nfrom collections.abc import Awaitable, Callable\nfrom typing import TypeVar\n\n_T = TypeVar("_T")\n\n\nasync def run_tasks(\n    tasks: list[Callable[[], Awaitable[None]]],\n    max_concurrent: int,\n) -> None:\n    """Run async task factories with a concurrency limit.\n\n    Args:\n        tasks: A list of zero-argument callables. Each callable must return an\n            awaitable async job when invoked.\n        max_concurrent: The maximum number of jobs to run at the same time.\n\n    If any job raises, pending worker tasks are cancelled and awaited before the\n    original exception is re-raised. If this coroutine itself is cancelled (for\n    example via Ctrl-C when run under ``asyncio.run``), active jobs are also\n    cancelled and awaited so their ``finally``/cleanup code gets a chance to run.\n    """\n    if max_concurrent < 1:\n        raise ValueError("max_concurrent must be at least 1")\n\n    if not tasks:\n        return\n\n    task_iter = iter(tasks)\n    iterator_lock = asyncio.Lock()\n    sentinel = object()\n\n    async def get_next_task() -> Callable[[], Awaitable[None]] | object:\n        async with iterator_lock:\n            return next(task_iter, sentinel)\n\n    async def worker() -> None:\n        while True:\n            task_factory = await get_next_task()\n            if task_factory is sentinel:\n                return\n            await task_factory()  # type: ignore[operator]\n\n    workers = [\n        asyncio.create_task(worker())\n        for _ in range(min(max_concurrent, len(tasks)))\n    ]\n\n    try:\n        await asyncio.gather(*workers)\n    except BaseException:\n        for worker_task in workers:\n            if not worker_task.done():\n                worker_task.cancel()\n        await asyncio.gather(*workers, return_exceptions=True)\n        raise\n'
