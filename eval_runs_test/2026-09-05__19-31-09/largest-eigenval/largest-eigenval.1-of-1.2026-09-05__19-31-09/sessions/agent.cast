[201.480145, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython - <<'PY'\nimport numpy as np, time\nfrom scipy.linalg.lapack import dgeev\n\ndef f_lap(A):\n    wr, wi, vl, vr, info = dgeev(A, compute_vl=0, compute_vr=1, overwrite_a=0)\n    mags = wr*wr + wi*wi\n    i = int(np.argmax(mags))\n    lam = wr[i] + 1j*wi[i]\n    if wi[i] == 0:\n        v = vr[:, i].astype(np.complex128)\n    elif wi[i] > 0:\n        v = vr[:, i].astype(np.complex128) + 1j*vr[:, i+1]\n    else:\n        v = vr[:, i-1].astype(np.complex128) - 1j*vr[:, i]\n    return lam, v\nfor n in range(2,11):\n    As=[np.random.normal(size=(n,n)).astype(np.float64) for _ in range(500)]\n    def bench(f):\n        ts=[]; ok=True\n        for A in As:\n            t=time.perf_counter(); lam,v=f(A); ts.append(time.perf_counter()-t)\n            if not np.allclose(A@v, lam*v): ok=False; break\n        return np.median(ts)*1e6, ok\n    def f_np(A):\n        w,V=np.linalg.eig(A); i=np.argmax(abs(w)); return w[i],V[:,i]\n    print(n, 'lap', bench(f_lap), 'np', bench(f_np)[0])\nPY\ntrue;"]
[201.480272, "i", " tmux wait -S done\r"]
