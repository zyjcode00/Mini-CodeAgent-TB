[223.092209, "o", "content = 'import numpy as np\\n\\ntry:\\n    from scipy.linalg.lapack import dgeev as _dgeev\\nexcept Exception:  # pragma: no cover - fallback for environments without SciPy\\n    _dgeev = None\\n\\n\\ndef find_dominant_eigenvalue_and_eigenvector(A: np.ndarray):\\n    \"\"\"\\n    Find the dominant eigenvalue and eigenvector of a general real square matrix.\\n\\n    Args:\\n        A: Real-valued square matrix (accepts numpy arrays) up to size 10x10,\\n        dtype np.float64.\\n\\n    Returns:\\n        eigenvalue: Dominant eigenvalue (numpy scalar, potentially complex)\\n        eigenvector: Corresponding eigenvector (np.ndarray, potentially complex)\\n    \"\"\"\\n    n = A.shape[0]\\n    if n == 1:\\n        return A[0, 0], np.array([1.0], dtype=np.float64)\\n\\n    if _dgeev is not None:\\n        # Call LAPACK\\'s real nonsymmetric eigensolver directly.  This avoids the\\n        # extra numpy.linalg.eig wrapper work and asks LAPACK for right\\n        # eigenvectors only (no left eigenvectors), which is consistently faster\\n        "]
[223.092377, "o", "# for the tiny matrices used here.\\n        wr, wi, _vl, vr, info = _dgeev(\\n            A, compute_vl=0, compute_vr=1, overwrite_a=0\\n        )\\n        if info == 0:\\n            idx = int(np.argmax(wr * wr + wi * wi))\\n            imag = wi[idx]\\n            if imag == 0.0:\\n                # Real eigenvalue: LAPACK stores the eigenvector directly in\\n                # the corresponding real column.\\n                return wr[idx], vr[:, idx]\\n            if imag > 0.0:\\n                # Complex conjugate pair: for the eigenvalue wr[j] + i*wi[j],\\n                # LAPACK stores Re(v) in column j and Im(v) in column j+1.\\n                return wr[idx] + 1j * imag, vr[:, idx].astype(np.complex128) + 1j * vr[:, idx + 1]\\n            # Negative imaginary part: use the preceding real/imag columns and\\n            # conjugate the positive-imaginary eigenvector.\\n            return wr[idx] + 1j * imag, vr[:, idx - 1].astype(np.complex128) - 1j * vr[:, idx]\\n\\n    # Conservative fallback: exact reference behavi"]
[223.092438, "o", "or if SciPy/LAPACK fast path\\n    # is unavailable or reports a convergence problem.\\n    eigenvalues, eigenvectors = np.linalg.eig(A)\\n    idx = int(np.argmax(np.abs(eigenvalues)))\\n    return eigenvalues[idx], eigenvectors[:, idx]\\n'\r\n\u001b[?2004l\r\u001b[?2004h> "]
