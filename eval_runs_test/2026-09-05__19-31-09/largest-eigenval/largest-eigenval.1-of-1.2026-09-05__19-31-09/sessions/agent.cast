[70.090916, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython - <<'PY'\nimport numpy as np, time\n\ndef vec_svd(A, lam):\n    B = A.astype(np.complex128, copy=True)\n    n=B.shape[0]\n    B.flat[::n+1] -= lam\n    _,_,vh=np.linalg.svd(B)\n    return vh[-1].conj()\n\ndef f_svd(A):\n    vals=np.linalg.eigvals(A)\n    lam=vals[np.argmax(np.abs(vals))]\n    return lam, vec_svd(A, lam)\n\ndef vec_rows(A, lam):\n    B=A.astype(np.complex128,copy=True); n=B.shape[0]; B.flat[::n+1]-=lam\n    # use SVD fallback\n    return vec_svd(A,lam)\n\nfor n in range(2,11):\n    As=[np.random.normal(size=(n,n)).astype(np.float64) for _ in range(300)]\n    def bench(f):\n        ts=[]; ok=True; res=[]\n        for A in As:\n            t=time.perf_counter(); lam,v=f(A); ts.append(time.perf_counter()-t)\n            if not np.allclose(A@v, lam*v): ok=False\n        return np.median(ts)*1e6, ok\n    print(n, 'eig', bench(lambda A: (lambda w,V:(w[np.argmax(abs(w))],V[:,np.argmax(abs(w))]))(*np.linalg.eig(A)))[0], 'eigvals+svd', bench(f_svd))\nPY\ntrue; tmux wait -S"]
[70.091315, "i", " done\r"]
[70.091447, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r done\r\n\u001b[?2004hroot@9004809139ce:/app# python - <<'PY'\r\n\u001b[?2004l\r"]
[70.091548, "o", "\u001b[?2004h> import numpy as np, time\r\n\u001b[?2004l\r"]
[70.091628, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[70.091699, "o", "\u001b[?2004h> "]
[70.091795, "o", "def vec_svd(A, lam):\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.091892, "o", "> "]
[70.091953, "o", "    B = A.astype(np.complex128, copy=True)\r\n\u001b[?2004l\r"]
[70.092025, "o", "\u001b[?2004h> "]
[70.092124, "o", "    n=B.shape[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.092231, "o", "    B.flat[::n+1] -= lam\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.092276, "o", "> "]
[70.092385, "o", "    _,_,vh=np.linalg.svd(B)\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.092452, "o", "> "]
[70.092532, "o", "    return vh[-1].conj()\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.092618, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[70.09268, "o", "> def f_svd(A):\r\n\u001b[?2004l\r"]
[70.092757, "o", "\u001b[?2004h> "]
[70.092873, "o", "    vals=np.linalg.eigvals(A)\r\n\u001b[?2004l\r"]
[70.092917, "o", "\u001b[?2004h> "]
[70.09304, "o", "    lam=vals[np.argmax(np.abs(vals))]\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.093113, "o", "> "]
[70.093203, "o", "    return lam, vec_svd(A, lam)\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.093317, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.093405, "o", "def vec_rows(A, lam):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.093671, "o", "    B=A.astype(np.complex128,copy=True); n=B.shape[0]; B.flat[::n+1]-=lam\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.093792, "o", "> "]
[70.093843, "o", "    # use SVD fallback\r\n\u001b[?2004l\r"]
[70.094092, "o", "\u001b[?2004h> "]
[70.094214, "o", "    return vec_svd(A,lam)\r\n\u001b[?2004l\r"]
[70.094647, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.094882, "o", "for n in range(2,11):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.095168, "o", "    As=[np.random.normal(size=(n,n)).astype(np.float64) for _ in range(300)]\r\n\u001b[?2004l\r"]
[70.095288, "o", "\u001b[?2004h> "]
[70.095406, "o", "    def bench(f):\r\n\u001b[?2004l\r"]
[70.095461, "o", "\u001b[?2004h> "]
[70.095594, "o", "        ts=[]; ok=True; res=[]\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.095713, "o", ">         for A in As:\r\n\u001b[?2004l\r"]
[70.095829, "o", "\u001b[?2004h> "]
[70.096065, "o", "            t=time.perf_counter(); lam,v=f(A); ts.append(time.perf_counter()-t)\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.09619, "o", "> "]
[70.096391, "o", "            if not np.allclose(A@v, lam*v): ok=False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.096547, "o", "        return np.median(ts)*1e6, ok\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.096653, "o", "> "]
[70.097051, "o", "    print(n, 'eig', bench(lambda A: (lambda w,V:(w[np.argmax(abs(w))],V[:,np.argmax(abs(w))]))(*np.linalg.eig(A)))[0], 'eigvals+svd', bench(f_svd))\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.097288, "o", "> PY\r\n\u001b[?2004l\r"]
[70.344095, "o", "2 eig 15.584000720991753 eigvals+svd (np.float64(27.12599962251261), True)\r\n"]
[70.37515, "o", "3 eig 15.644500308553688 eigvals+svd (np.float64(26.204001187579706), True)\r\n"]
[70.406511, "o", "4 eig 16.546000551898032 eigvals+svd (np.float64(27.240999770583585), True)\r\n"]
[70.440376, "o", "5 eig 18.204000298283063 eigvals+svd (np.float64(30.897999749868177), True)\r\n"]
[70.475571, "o", "6 eig 20.93900002364535 eigvals+svd (np.float64(32.95199894637335), True)\r\n"]
[70.513076, "o", "7 eig 22.45699943159707 eigvals+svd (np.float64(36.30799983511679), True)\r\n"]
[70.554332, "o", "8 eig 24.345499696210027 eigvals+svd (np.float64(42.549498175503686), True)\r\n"]
[70.60428, "o", "9 eig 29.599999834317714 eigvals+svd (np.float64(48.64100083068479), True)\r\n"]
[70.65078, "o", "10 eig 31.799501812201925 eigvals+svd (np.float64(48.045001676655374), True)\r\n"]
