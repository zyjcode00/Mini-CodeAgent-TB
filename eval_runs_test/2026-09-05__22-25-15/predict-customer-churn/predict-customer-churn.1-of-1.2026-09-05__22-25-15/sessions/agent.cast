[119.993345, "o", "content = '\"\"\"Train a customer churn Logistic Regression model.\\n\\nThis script intentionally performs no scaling, encoding, or other preprocessing.\\nThe input data is expected to already contain the required numeric feature\\ncolumns and the binary target column ``Churn``.\\n\"\"\"\\n\\nfrom __future__ import annotations\\n\\nimport hashlib\\nimport pickle\\nfrom pathlib import Path\\n\\nimport pandas as pd\\nfrom sklearn.linear_model import LogisticRegression\\n\\n\\nAPP_DIR = Path(__file__).resolve().parent\\nDATA_PATH = APP_DIR / \"data\" / \"training-data.csv\"\\nCHECKSUM_PATH = APP_DIR / \"training_file_checksum.txt\"\\nMODEL_PATH = APP_DIR / \"model.pkl\"\\nCHUNK_SIZE_BYTES = 4096\\n\\nFEATURES = [\\n    \"gender\",\\n    \"SeniorCitizen\",\\n    \"Partner\",\\n    \"Dependents\",\\n    \"tenure\",\\n    \"PhoneService\",\\n    \"MultipleLines\",\\n    \"InternetService\",\\n    \"OnlineSecurity\",\\n    \"OnlineBackup\",\\n    \"DeviceProtection\",\\n    \"TechSupport\",\\n    \"StreamingTV\",\\n    \"StreamingMovies\",\\n    \"Contract\",\\n    \"PaperlessBilling\",\\n    \"Paymen"]
[119.993482, "o", "tMethod\",\\n    \"MonthlyCharges\",\\n    \"TotalCharges\",\\n]\\nTARGET = \"Churn\"\\n\\n\\ndef calculate_sha256(path: Path, chunk_size: int = CHUNK_SIZE_BYTES) -> str:\\n    \"\"\"Return the SHA-256 checksum for *path*, reading in fixed-size chunks.\"\"\"\\n    digest = hashlib.sha256()\\n    with path.open(\"rb\") as file_obj:\\n        for chunk in iter(lambda: file_obj.read(chunk_size), b\"\"):\\n            digest.update(chunk)\\n    return digest.hexdigest()\\n\\n\\ndef write_training_checksum(data_path: Path = DATA_PATH, checksum_path: Path = CHECKSUM_PATH) -> str:\\n    \"\"\"Calculate and persist the training-data checksum.\"\"\"\\n    checksum = calculate_sha256(data_path, CHUNK_SIZE_BYTES)\\n    checksum_path.write_text(checksum + \"\\\\n\", encoding=\"utf-8\")\\n    return checksum\\n\\n\\ndef load_training_data(data_path: Path = DATA_PATH) -> tuple[pd.DataFrame, pd.Series]:\\n    \"\"\"Load the required features and target from the training CSV.\"\"\"\\n    data = pd.read_csv(data_path)\\n    missing_columns = [column for column in FEATURES + [TARGET] if"]
[119.993507, "o", " column not in data.columns]\\n    if missing_columns:\\n        raise ValueError(f\"Training data is missing required columns: {missing_columns}\")\\n    return data[FEATURES], data[TARGET]\\n\\n\\ndef train_model(X: pd.DataFrame, y: pd.Series) -> LogisticRegression:\\n    \"\"\"Train a LogisticRegression directly on the selected raw features.\"\"\"\\n    model = LogisticRegression(max_iter=5000, solver=\"lbfgs\", random_state=42)\\n    model.fit(X, y)\\n    return model\\n\\n\\ndef save_model(model: LogisticRegression, model_path: Path = MODEL_PATH) -> None:\\n    \"\"\"Serialize the trained model as a pickle file.\"\"\"\\n    with model_path.open(\"wb\") as file_obj:\\n        pickle.dump(model, file_obj)\\n\\n\\ndef main() -> LogisticRegression:\\n    \"\"\"Create checksum, train the churn model, save it, and return it.\"\"\"\\n    write_training_checksum(DATA_PATH, CHECKSUM_PATH)\\n    X, y = load_training_data(DATA_PATH)\\n    model = train_model(X, y)\\n    save_model(model, MODEL_PATH)\\n    return model\\n\\n\\nif __name__ == \"__main__\":\\n    trained_"]
