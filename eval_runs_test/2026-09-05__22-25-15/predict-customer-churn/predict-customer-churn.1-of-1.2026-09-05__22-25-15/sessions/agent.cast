[42.101672, "o", "> "]
[42.101867, "o", "e_idx = end_line if end_line is not None else total_lines\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.101911, "o", "> "]
[42.102038, "o", "selected_lines = lines[s_idx:e_idx]\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.102125, "o", "> "]
[42.102173, "o", "if raw_mode:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.102473, "o", "    sys.stdout.write(''.join(selected_lines))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.102596, "o", "else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.102739, "o", "    output = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.102946, "o", "    for i, line in enumerate(selected_lines):\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.103091, "o", "> "]
[42.103278, "o", "        output.append(f\"{s_idx + i + 1:4d} | {line.rstrip()}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.103321, "o", "> "]
[42.103787, "o", "    header = f\"--- 文件: {path} (第 {start_line} 至 {min(e_idx, total_lines)} 行，共 {total_lines} 行) ---\\n\"\r\n\u001b[?2004l\r"]
[42.10392, "o", "\u001b[?2004h> "]
[42.104211, "o", "    sys.stdout.write(header + \"\\n\".join(output) + \"\\n--- 读取完毕 ---\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.104333, "o", "> PY\r\n\u001b[?2004l\r"]
