[87.737722, "i", "n(candidates, key=lambda item: self.score_forward(item[1]))\\n\\n    def apply_stack_update(self, old: Coord, new: Coord) -> None:\\n        if self.stack and self.stack[-1] == new:\\n            self.stack.pop()\\n        else:\\n            self.stack.append(old)\\n\\n    def run(self, max_steps: Optional[int] = None) -> dict:\\n        self.n = self.client.maze_size()\\n        if max_steps is None:\\n            max_steps = 4 * self.n * self.n\\n        self.pos = (1, 1)\\n        self.visits[self.pos] += 1\\n        self.log(f\"maze_size={self.n}, start={self.pos}, exit={(self.n, self.n)}\")\\n\\n        while self.moves_made <= max_steps:\\n            if self.pos == (self.n, self.n):\\n                self.log(f\"at exit {self.pos}; calling finish\")\\n                result = self.client.finish()\\n                self.log(f\"finish -> {result}\")\\n                return result\\n\\n            conn = self.client.sense()\\n            if conn == [0, 0, 0, 0]:\\n                raise RuntimeError(\"sense returned all walls/game-over"]
