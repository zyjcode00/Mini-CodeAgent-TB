[87.801726, "o", "content = '#!/usr/bin/env python3\\n\"\"\"Safe online solver for the interactive maze challenge.\\n\\nThe solver keeps an internal coordinate, senses only the current cell, and never\\nchooses a move that would make a cell\\'s visit count exceed two.  It prioritizes\\nunknown/unvisited neighbours that move toward the exit, and uses bounded\\nbacktracking only when necessary.\\n\"\"\"\\nfrom __future__ import annotations\\n\\nfrom collections import defaultdict, deque\\nfrom dataclasses import dataclass, field\\nimport argparse\\nimport json\\nimport sys\\nimport time\\nfrom typing import Dict, Iterable, List, Optional, Protocol, Tuple\\nfrom urllib import request\\n\\n# Directions: 0=up, 1=down, 2=left, 3=right\\nDIRS: Dict[int, Tuple[int, int]] = {\\n    0: (0, 1),\\n    1: (0, -1),\\n    2: (-1, 0),\\n    3: (1, 0),\\n}\\nOPPOSITE = {0: 1, 1: 0, 2: 3, 3: 2}\\nDIR_NAMES = {0: \"up\", 1: \"down\", 2: \"left\", 3: \"right\"}\\nCoord = Tuple[int, int]\\n\\n\\nclass MazeClient(Protocol):\\n    def maze_size(self) -> int: ...\\n    def sense(self) -> List[int]"]
[87.801943, "o", ": ...\\n    def move(self, direction: int) -> dict: ...\\n    def finish(self) -> dict: ...\\n\\n\\nclass HttpMazeClient:\\n    def __init__(self, base_url: str, timeout: float = 5.0):\\n        self.base_url = base_url.rstrip(\"/\")\\n        self.timeout = timeout\\n\\n    def _json(self, method: str, path: str, payload: Optional[dict] = None) -> dict:\\n        data = None\\n        headers = {}\\n        if payload is not None:\\n            data = json.dumps(payload).encode(\"utf-8\")\\n            headers[\"Content-Type\"] = \"application/json\"\\n        req = request.Request(self.base_url + path, data=data, headers=headers, method=method)\\n        with request.urlopen(req, timeout=self.timeout) as resp:\\n            return json.loads(resp.read().decode(\"utf-8\"))\\n\\n    def maze_size(self) -> int:\\n        return int(self._json(\"GET\", \"/maze_size\")[\"maze_size\"])\\n\\n    def sense(self) -> List[int]:\\n        return list(self._json(\"GET\", \"/sense\")[\"connectivity\"])\\n\\n    def move(self, direction: int) -> dict:\\n        return "]
[87.802083, "o", "self._json(\"POST\", \"/move\", {\"direction\": direction})\\n\\n    def finish(self) -> dict:\\n        return self._json(\"POST\", \"/finish\", {})\\n\\n\\n@dataclass\\nclass OnlineMazeSolver:\\n    client: MazeClient\\n    verbose: bool = True\\n    n: int = 0\\n    pos: Coord = (1, 1)\\n    visits: Dict[Coord, int] = field(default_factory=lambda: defaultdict(int))\\n    known: Dict[Coord, List[int]] = field(default_factory=dict)\\n    stack: List[Coord] = field(default_factory=list)\\n    moves_made: int = 0\\n\\n    def log(self, msg: str) -> None:\\n        if self.verbose:\\n            print(msg, flush=True)\\n\\n    def in_bounds(self, p: Coord) -> bool:\\n        x, y = p\\n        return 1 <= x <= self.n and 1 <= y <= self.n\\n\\n    def neighbor(self, p: Coord, direction: int) -> Coord:\\n        dx, dy = DIRS[direction]\\n        return (p[0] + dx, p[1] + dy)\\n\\n    def open_neighbors(self, p: Coord) -> Iterable[Tuple[int, Coord]]:\\n        conn = self.known[p]\\n        for d, open_ in enumerate(conn):\\n            if open_:\\n      "]
[87.802212, "o", "          q = self.neighbor(p, d)\\n                if self.in_bounds(q):\\n                    yield d, q\\n\\n    def unblocked_candidate_dirs(self, conn: List[int]) -> List[Tuple[int, Coord]]:\\n        out: List[Tuple[int, Coord]] = []\\n        for d, open_ in enumerate(conn):\\n            if not open_:\\n                continue\\n            q = self.neighbor(self.pos, d)\\n            if self.in_bounds(q) and self.visits[q] < 2:\\n                out.append((d, q))\\n        return out\\n\\n    def score_forward(self, q: Coord) -> Tuple[int, int, int, int]:\\n        \"\"\"Lower score is better for exploration toward the top-right exit.\"\"\"\\n        x, y = q\\n        dist = (self.n - x) + (self.n - y)\\n        # Strongly prefer unvisited cells, then progress to exit, then right/up bias.\\n        return (self.visits[q], dist, -x, -y)\\n\\n    def direction_to(self, a: Coord, b: Coord) -> int:\\n        delta = (b[0] - a[0], b[1] - a[1])\\n        for d, step in DIRS.items():\\n            if step == delta:\\n                r"]
[87.80236, "o", "eturn d\\n        raise ValueError(f\"{a} and {b} are not adjacent\")\\n\\n    def choose_next(self, conn: List[int]) -> Optional[Tuple[int, Coord]]:\\n        candidates = self.unblocked_candidate_dirs(conn)\\n        if not candidates:\\n            return None\\n\\n        # 1) Prefer completely unvisited neighbours; this avoids loops and makes progress.\\n        unvisited = [(d, q) for d, q in candidates if self.visits[q] == 0]\\n        if unvisited:\\n            return min(unvisited, key=lambda item: self.score_forward(item[1]))\\n\\n        # 2) If no unvisited neighbour exists, backtrack along the DFS stack if possible.\\n        if self.stack:\\n            parent = self.stack[-1]\\n            for d, q in candidates:\\n                if q == parent:\\n                    return d, q\\n\\n        # 3) Last resort: choose the least-visited move that still trends toward the exit.\\n        return min(candidates, key=lambda item: self.score_forward(item[1]))\\n\\n    def apply_stack_update(self, old: Coord, new: Coord) -> No"]
