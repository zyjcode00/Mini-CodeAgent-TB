[87.737942, "i", "       self.apply_stack_update(old, self.pos)\\n            self.moves_made += 1\\n\\n        raise RuntimeError(f\"Exceeded max_steps={max_steps}; pos={self.pos}; visits={dict(self.visits)}\")\\n\\n\\nclass SimMazeClient:\\n    \"\"\"Small deterministic simulator used by tests.\"\"\"\\n    def __init__(self, n: int, edges: Iterable[Tuple[Coord, Coord]]):\\n        self.n = n\\n        self.pos = (1, 1)\\n        self.adj: Dict[Coord, set[Coord]] = defaultdict(set)\\n        self.visit_counts: Dict[Coord, int] = defaultdict(int)\\n        self.visit_counts[self.pos] = 1\\n        self.finished = False\\n        for a, b in edges:\\n            self.adj[a].add(b)\\n            self.adj[b].add(a)\\n\\n    def maze_size(self) -> int:\\n        return self.n\\n\\n    def sense(self) -> List[int]:\\n        conn = []\\n        for d in range(4):\\n            conn.append(1 if self._neighbor(self.pos, d) in self.adj[self.pos] else 0)\\n        return conn\\n\\n    def _neighbor(self, p: Coord, d: int) -> Coord:\\n        dx, dy = DIRS[d]\\n        retu"]
[87.738045, "i", "rn (p[0] + dx, p[1] + dy)\\n\\n    def move(self, direction: int) -> dict:\\n        q = self._neighbor(self.pos, direction)\\n        if q not in self.adj[self.pos]:\\n            return {\"status\": \"illegal\"}\\n        self.pos = q\\n        self.visit_counts[q] += 1\\n        if self.visit_counts[q] > 2:\\n            return {\"status\": \"illegal\", \"message\": \"overvisit\"}\\n        return {\"status\": \"moved\"}\\n\\n    def finish(self) -> dict:\\n        self.finished = True\\n        if self.pos == (self.n, self.n):\\n            return {\"status\": \"Congratulations, destination reached\"}\\n        return {\"status\": \"illegal\", \"message\": \"Not at destination, game over\"}\\n\\n\\ndef main(argv: Optional[List[str]] = None) -> int:\\n    parser = argparse.ArgumentParser()\\n    parser.add_argument(\"--url\", default=\"http://maze:8088\")\\n    parser.add_argument(\"--quiet\", action=\"store_true\")\\n    parser.add_argument(\"--max-steps\", type=int, default=None)\\n    args = parser.parse_args(argv)\\n    solver = OnlineMazeSolver(HttpMazeClient(arg"]
