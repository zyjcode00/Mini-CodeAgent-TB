[?2004l[?2004h> content = '#!/usr/bin/env python3\n"""Safe online solver for the interactive maze challenge.\n\nThe solver keeps an internal coordinate, senses only the current cell, and never\nchooses a move that would make a cell\'s visit count exceed two.  It prioritizes\nunknown/unvisited neighbours that move toward the exit, and uses bounded\nbacktracking only when necessary.\n"""\nfrom __future__ import annotations\n\nfrom collections import defaultdict, deque\nfrom dataclasses import dataclass, field\nimport argparse\nimport json\nimport sys\nimport time\nfrom typing import Dict, Iterable, List, Optional, Protocol, Tuple\nfrom urllib import request\n\n# Directions: 0=up, 1=down, 2=left, 3=right\nDIRS: Dict[int, Tuple[int, int]] = {\n    0: (0, 1),\n    1: (0, -1),\n    2: (-1, 0),\n    3: (1, 0),\n}\nOPPOSITE = {0: 1, 1: 0, 2: 3, 3: 2}\nDIR_NAMES = {0: "up", 1: "down", 2: "left", 3: "right"}\nCoord = Tuple[int, int]\n\n\nclass MazeClient(Protocol):\n    def maze_size(self) -> int: ...\n    def sense(self) -> List[int]: ...\n    def move(self, direction: int) -> dict: ...\n    def finish(self) -> dict: ...\n\n\nclass HttpMazeClient:\n    def __init__(self, base_url: str, timeout: float = 5.0):\n        self.base_url = base_url.rstrip("/")\n        self.timeout = timeout\n\n    def _json(self, method: str, path: str, payload: Optional[dict] = None) -> dict:\n        data = None\n        headers = {}\n        if payload is not None:\n            data = json.dumps(payload).encode("utf-8")\n            headers["Content-Type"] = "application/json"\n        req = request.Request(self.base_url + path, data=data, headers=headers, method=method)\n        with request.urlopen(req, timeout=self.timeout) as resp:\n            return json.loads(resp.read().decode("utf-8"))\n\n    def maze_size(self) -> int:\n        return int(self._json("GET", "/maze_size")["maze_size"])\n\n    def sense(self) -> List[int]:\n        return list(self._json("GET", "/sense")["connectivity"])\n\n    def move(self, direction: int) -> dict:\n        return self._json("POST", "/move", {"direction": direction})\n\n    def finish(self) -> dict:\n        return self._json("POST", "/finish", {})\n\n\n@dataclass\nclass OnlineMazeSolver:\n    client: MazeClient\n    verbose: bool = True\n    n: int = 0\n    pos: Coord = (1, 1)\n    visits: Dict[Coord, int] = field(default_factory=lambda: defaultdict(int))\n    known: Dict[Coord, List[int]] = field(default_factory=dict)\n    stack: List[Coord] = field(default_factory=list)\n    moves_made: int = 0\n\n    def log(self, msg: str) -> None:\n        if self.verbose:\n            print(msg, flush=True)\n\n    def in_bounds(self, p: Coord) -> bool:\n        x, y = p\n        return 1 <= x <= self.n and 1 <= y <= self.n\n\n    def neighbor(self, p: Coord, direction: int) -> Coord:\n        dx, dy = DIRS[direction]\n        return (p[0] + dx, p[1] + dy)\n\n    def open_neighbors(self, p: Coord) -> Iterable[Tuple[int, Coord]]:\n        conn = self.known[p]\n        for d, open_ in enumerate(conn):\n            if open_:\n                q = self.neighbor(p, d)\n                if self.in_bounds(q):\n                    yield d, q\n\n    def unblocked_candidate_dirs(self, conn: List[int]) -> List[Tuple[int, Coord]]:\n        out: List[Tuple[int, Coord]] = []\n        for d, open_ in enumerate(conn):\n            if not open_:\n                continue\n            q = self.neighbor(self.pos, d)\n            if self.in_bounds(q) and self.visits[q] < 2:\n                out.append((d, q))\n        return out\n\n    def score_forward(self, q: Coord) -> Tuple[int, int, int, int]:\n        """Lower score is better for exploration toward the top-right exit."""\n        x, y = q\n        dist = (self.n - x) + (self.n - y)\n        # Strongly prefer unvisited cells, then progress to exit, then right/up bias.\n        return (self.visits[q], dist, -x, -y)\n\n    def direction_to(self, a: Coord, b: Coord) -> int:\n        delta = (b[0] - a[0], b[1] - a[1])\n        for d, step in DIRS.items():\n            if step == delta:\n                return d\n        raise ValueError(f"{a} and {b} are not adjacent")\n\n    def choose_next(self, conn: List[int]) -> Optional[Tuple[int, Coord]]:\n        candidates = self.unblocked_candidate_dirs(conn)\n        if not candidates:\n            return None\n\n        # 1) Prefer completely unvisited neighbours; this avoids loops and makes progress.\n        unvisited = [(d, q) for d, q in candidates if self.visits[q] == 0]\n        if unvisited:\n            return min(unvisited, key=lambda item: self.score_forward(item[1]))\n\n        # 2) If no unvisited neighbour exists, backtrack along the DFS stack if possible.\n        if self.stack:\n            parent = self.stack[-1]\n            for d, q in candidates:\n                if q == parent:\n                    return d, q\n\n        # 3) Last resort: choose the least-visited move that still trends toward the exit.\n        return min(candidates, key=lambda item: self.score_forward(item[1]))\n\n    def apply_stack_update(self, old: Coord, new: Coord) -> None:\n        if self.stack and self.stack[-1] == new:\n            self.stack.pop()\n        else:\n            self.stack.append(old)\n\n    def run(self, max_steps: Optional[int] = None) -> dict:\n        self.n = self.client.maze_size()\n        if max_steps is None:\n            max_steps = 4 * self.n * self.n\n        self.pos = (1, 1)\n        self.visits[self.pos] += 1\n        self.log(f"maze_size={self.n}, start={self.pos}, exit={(self.n, self.n)}")\n\n        while self.moves_made <= max_steps:\n            if self.pos == (self.n, self.n):\n                self.log(f"at exit {self.pos}; calling finish")\n                result = self.client.finish()\n                self.log(f"finish -> {result}")\n                return result\n\n            conn = self.client.sense()\n            if conn == [0, 0, 0, 0]:\n                raise RuntimeError("sense returned all walls/game-over signal before reaching exit")\n            self.known[self.pos] = conn\n            choice = self.choose_next(conn)\n            if choice is None:\n                raise RuntimeError(f"No legal move from {self.pos}; visits={dict(self.visits)} conn={conn}")\n            direction, nxt = choice\n            if self.visits[nxt] >= 2:\n                raise AssertionError(f"Refusing third visit to {nxt}")\n            self.log(\n                f"step={self.moves_made:03d} pos={self.pos} conn={conn} "\n                f"move={DIR_NAMES[direction]}->{nxt} next_visits={self.visits[nxt] + 1}"\n            )\n            resp = self.client.move(direction)\n            if resp.get("status") != "moved":\n                raise RuntimeError(f"Move {direction} from {self.pos} to {nxt} failed: {resp}")\n            old = self.pos\n            self.pos = nxt\n            self.visits[self.pos] += 1\n            if self.visits[self.pos] > 2:\n                raise AssertionError(f"Visited {self.pos} more than twice")\n            self.apply_stack_update(old, self.pos)\n            self.moves_made += 1\n\n        raise RuntimeError(f"Exceeded max_steps={max_steps}; pos={self.pos}; visits={dict(self.visits)}")\n\n\nclass SimMazeClient:\n    """Small deterministic simulator used by tests."""\n    def __init__(self, n: int, edges: Iterable[Tuple[Coord, Coord]]):\n        self.n = n\n        self.pos = (1, 1)\n        self.adj: Dict[Coord, set[Coord]] = defaultdict(set)\n        self.visit_counts: Dict[Coord, int] = defaultdict(int)\n        self.visit_counts[self.pos] = 1\n        self.finished = False\n        for a, b in edges:\n            self.adj[a].add(b)\n            self.adj[b].add(a)\n\n    def maze_size(self) -> int:\n        return self.n\n\n    def sense(self) -> List[int]:\n        conn = []\n        for d in range(4):\n            conn.append(1 if self._neighbor(self.pos, d) in self.adj[self.pos] else 0)\n        return conn\n\n    def _neighbor(self, p: Coord, d: int) -> Coord:\n        dx, dy = DIRS[d]\n        return (p[0] + dx, p[1] + dy)\n\n    def move(self, direction: int) -> dict:\n        q = self._neighbor(self.pos, direction)\n        if q not in self.adj[self.pos]:\n            return {"status": "illegal"}\n        self.pos = q\n        self.visit_counts[q] += 1\n        if self.visit_counts[q] > 2:\n            return {"status": "illegal", "message": "overvisit"}\n        return {"status": "moved"}\n\n    def finish(self) -> dict:\n        self.finished = True\n        if self.pos == (self.n, self.n):\n            return {"status": "Congratulations, destination reached"}\n        return {"status": "illegal", "message": "Not at destination, game over"}\n\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    parser = argparse.ArgumentParser()\n    parser.add_argument("--url", default="http://maze:8088")\n    parser.add_argument("--quiet", action="store_true")\n    parser.add_argument("--max-steps", type=int, default=None)\n    args = parser.parse_args(argv)\n    solver = OnlineMazeSolver(HttpMazeClient(args.url), verbose=not args.quiet)\n    result = solver.run(max_steps=args.max_steps)\n    ok = result.get("status") == "Congratulations, destination reached"\n    return 0 if ok else 2\n\n\nif __name__ == "__main__":\n    raise SystemExit(main())\n'
