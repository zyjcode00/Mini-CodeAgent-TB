[156.613331, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/test_pipeline.py <<'PY'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = 'import os\\nimport shutil\\nimport subprocess\\nfrom pathlib import Path\\n\\n\\nAPP_DIR = Path(\"/app\")\\nOUTPUT_DIR = Path(\"/data/output\")\\nRAW_DATA = OUTPUT_DIR / \"raw_data.txt\"\\nPROCESSED_DATA = OUTPUT_DIR / \"processed_data.txt\"\\nFINAL_REPORT = OUTPUT_DIR / \"final_report.txt\"\\n\\n\\ndef test_pipeline_runs_successfully_and_generates_expected_outputs():\\n    if OUTPUT_DIR.exists():\\n        shutil.rmtree(OUTPUT_DIR)\\n\\n    scripts = [\\n        APP_DIR / \"run_pipeline.sh\",\\n        APP_DIR / \"collect_data.sh\",\\n        APP_DIR / \"process_data.sh\",\\n        APP_DIR / \"generate_report.sh\",\\n    ]\\n    for script in scripts:\\n        assert script.exists(), f\"Missing script: {script}\"\\n        assert os.access(script, os.X_OK), f\"Script is not executable: {script}\"\\n\\n    result = subprocess.run(\\n        [str(APP_DIR / \"run_pipeline.sh\")],\\n        cwd=\"/tmp\",\\n        text=True,\\n        capture_output=True,\\n        check=False,\\n    )\\n\\n    assert result.returncode == 0, (\\n        \"Pipeline failed\\\\n\"\\n        f\"STDOUT:\\\\n{result.stdout}\\\\n\"\\n        f\"STDERR:\\\\n{result.stderr}\"\\n    )\\n    assert \"Pipeline completed successfully!\" in result.stdout\\n\\n    assert RAW_DATA.read_text() == \"test data\\\\n\"\\n    assert PROCESSED_DATA.read_text() == \"TEST DATA\\\\n\"\\n\\n    report = FINAL_REPORT.read_text()\\n    assert \"=== ANALYSIS REPORT ===\" in report\\n    assert \"Generated on:\" in report\\n    assert \"Data summary: TEST DATA\" in report\\n'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, 'w', encoding='utf-8', newline='\\n') as f:\n        f.write(content)\n    print(f\"成功: 已写入 {path}\")\nexcept Exception as exc:\n    print(f\"写入失败: {exc}\")\nPY\ntrue; tmux wait -S done\r"]
[156.614368, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
[156.614702, "o", "\u001b[?2004hroot@ffb80019aab0:/app# python3 - /app/test_pipeline.py <<'PY'\r\n\u001b[?2004l\r"]
[156.614784, "o", "\u001b[?2004h"]
[156.615179, "o", "> import os\r\n\u001b[?2004l\r"]
