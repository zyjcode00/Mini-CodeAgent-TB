[87.424494, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/generate_report.sh <<'PY'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = '#!/bin/bash\\n# Report generation script\\n\\nset -euo pipefail\\n\\nOUTPUT_DIR=\"/data/output\"\\nPROCESSED_DATA_FILE=\"$OUTPUT_DIR/processed_data.txt\"\\nFINAL_REPORT_FILE=\"$OUTPUT_DIR/final_report.txt\"\\n\\nif [ ! -f \"$PROCESSED_DATA_FILE\" ]; then\\n    echo \"Error: Processed data not found!\"\\n    exit 1\\nfi\\n\\n{\\n    echo \"=== ANALYSIS REPORT ===\"\\n    echo \"Generated on: $(date)\"\\n    echo \"Data summary: $(cat \"$PROCESSED_DATA_FILE\")\"\\n} > \"$FINAL_REPORT_FILE\"\\n\\necho \"Report generated successfully!\"\\n'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, 'w', encoding='utf-8', newline='\\n') as f:\n        f.write(content)\n    print(f\"成功: 已写入 {path}\")\nexcept Exception as exc:\n    print(f\"写入失败: {exc}\")\nPY\ntrue; tmux wait -S done\r"]
