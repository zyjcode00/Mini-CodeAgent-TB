[87.273845, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/process_data.sh <<'PY'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = '#!/bin/bash\\n# Data processing script\\n\\nset -euo pipefail\\n\\nOUTPUT_DIR=\"/data/output\"\\nRAW_DATA_FILE=\"$OUTPUT_DIR/raw_data.txt\"\\nPROCESSED_DATA_FILE=\"$OUTPUT_DIR/processed_data.txt\"\\n\\nif [ ! -f \"$RAW_DATA_FILE\" ]; then\\n    echo \"Error: Input data not found!\"\\n    exit 1\\nfi\\n\\ntr \\'[:lower:]\\' \\'[:upper:]\\' < \"$RAW_DATA_FILE\" > \"$PROCESSED_DATA_FILE\"\\necho \"Data processed successfully!\"\\n'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, 'w', encoding='utf-8', newline='\\n') as f:\n        f.write(content)\n    print(f\"成功: 已写入 {path}\")\nexcept Exception as exc:\n    print(f\"写入失败: {exc}\")\nPY\ntrue; tmux wait -S done\r"]
