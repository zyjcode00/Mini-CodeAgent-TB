[350.267264, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\nset -euo pipefail\nif ! command -v nginx >/dev/null 2>&1; then\n  if command -v apt-get >/dev/null 2>&1; then\n    export DEBIAN_FRONTEND=noninteractive\n    apt-get update -qq\n    apt-get install -y -qq nginx\n  elif command -v apk >/dev/null 2>&1; then\n    apk add --no-cache nginx\n  elif command -v yum >/dev/null 2>&1; then\n    yum install -y nginx\n  else\n    echo 'No supported package manager found to install nginx' >&2\n    exit 1\n  fi\nfi\nmkdir -p /etc/nginx/conf.d /etc/nginx/sites-enabled /var/www/html /var/log/nginx /run/nginx\ncat > /etc/nginx/nginx.conf <<'EOF'\nuser www-data;\nworker_processes auto;\npid /run/nginx.pid;\n\ninclude /etc/nginx/modules-enabled/*.conf;\n\nevents {\n    worker_connections 768;\n}\n\nhttp {\n    sendfile on;\n    tcp_nopush on;\n    types_hash_max_size 2048;\n\n    include /etc/nginx/mime.types;\n    default_type application/octet-stream;\n\n    log_format benchmark '$time_local $request_method $status \"$http_user_agent\"';\n    limit_req_zone $bin"]
[350.267436, "i", "ary_remote_addr zone=benchmark_limit:10m rate=10r/s;\n\n    access_log /var/log/nginx/access.log;\n    error_log /var/log/nginx/error.log;\n\n    gzip on;\n\n    include /etc/nginx/conf.d/*.conf;\n}\nEOF\ncat > /etc/nginx/conf.d/benchmark-site.conf <<'EOF'\nserver {\n    listen 8080 default_server;\n    listen [::]:8080 default_server;\n    server_name _;\n\n    root /var/www/html;\n    index index.html;\n\n    access_log /var/log/nginx/benchmark-access.log benchmark;\n    error_log /var/log/nginx/benchmark-error.log;\n\n    limit_req zone=benchmark_limit burst=10;\n\n    location / {\n        try_files $uri $uri/ =404;\n    }\n\n    error_page 404 /404.html;\n    location = /404.html {\n        internal;\n    }\n}\nEOF\nprintf '%s\\n' 'Welcome to the benchmark webserver' > /var/www/html/index.html\nprintf '%s\\n' 'Page not found - Please check your URL' > /var/www/html/404.html\n: > /var/log/nginx/benchmark-access.log\n: > /var/log/nginx/benchmark-error.log\nrm -f /etc/nginx/sites-enabled/default\nnginx -v 2>&1\nls -l /etc/nginx/nginx.conf /etc/ngin"]
[350.267625, "i", "x/conf.d/benchmark-site.conf /var/www/html/index.html /var/www/html/404.html /var/log/nginx/benchmark-access.log /var/log/nginx/benchmark-error.log\nprintf 'Access log location: /var/log/nginx/benchmark-access.log\\n'\ntrue; tmux wait -S done\r"]
[350.267782, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\rx/conf.d/benchmark-site.c"]
[350.267837, "o", "onf /var/www/html/index.html /var/www/html/404.html /var/log/nginx/benchmark-access.log /var/log/nginx/benchmark-error.log\r\nprintf 'Access log location: /var/log/nginx/benchmark-access.log\\n'\r\ntrue; tmux wait -S done\r\n"]
