[661.131879, "o", "    yum install -y nginx\r\n\u001b[?2004l\r\u001b[?2004h> "]
[661.131928, "o", "  else\r\n\u001b[?2004l\r\u001b[?2004h> "]
[661.132194, "o", "    echo 'No supported package manager found to install nginx' >&2\r\n\u001b[?2004l\r\u001b[?2004h"]
[661.132308, "o", ">     exit 1\r\n\u001b[?2004l\r"]
[661.132446, "o", "\u001b[?2004h>   fi\r\n\u001b[?2004l\r\u001b[?2004h> fi\r\n\u001b[?2004l\r\u001b[?2004hroot@837a45782dc6:/app# "]
[661.132733, "o", "mkdir -p /etc/nginx/conf.d /etc/nginx/sites-enabled /var/www/html /var/log/nginx /run/nginx\r\n\u001b[?2004l\r"]
[661.141881, "o", "\u001b[?2004hroot@837a45782dc6:/app# "]
[661.142144, "o", "rm -f /etc/nginx/sites-enabled/default\r\n\u001b[?2004l\r"]
[661.14535, "o", "\u001b[?2004hroot@837a45782dc6:/app# "]
[661.145581, "o", "cat > /var/www/html/index.html <<'EOF'\r\n\u001b[?2004l\r"]
[661.145709, "o", "\u001b[?2004h> Welcome to the benchmark webserver\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[661.148548, "o", "\u001b[?2004hroot@837a45782dc6:/app# "]
[661.148674, "o", "cat > /var/www/html/404.html <<'EOF'\r\n\u001b[?2004l\r"]
[661.148768, "o", "\u001b[?2004h> "]
[661.148939, "o", "Page not found - Please check your URL\r\n\u001b[?2004l\r\u001b[?2004h"]
[661.149015, "o", "> "]
[661.14909, "o", "EOF\r\n\u001b[?2004l\r"]
[661.155581, "o", "\u001b[?2004hroot@837a45782dc6:/app# "]
[661.155836, "o", "touch /var/log/nginx/benchmark-access.log /var/log/nginx/benchmark-error.log\r\n\u001b[?2004l\r"]
[661.161433, "o", "\u001b[?2004hroot@837a45782dc6:/app# "]
[661.161577, "o", "cat > /etc/nginx/nginx.conf <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
[661.161649, "o", "> "]
[661.161753, "o", "user www-data;\r\n\u001b[?2004l\r"]
[661.161919, "o", "\u001b[?2004h> "]
[661.162033, "o", "worker_processes auto;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[661.16214, "o", "pid /run/nginx.pid;\r\n\u001b[?2004l\r\u001b[?2004h"]
[661.162275, "o", "> "]
[661.162328, "o", "error_log /var/log/nginx/error.log;\r\n\u001b[?2004l\r"]
[661.162537, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[661.162724, "o", "include /etc/nginx/modules-enabled/*.conf;\r\n\u001b[?2004l\r\u001b[?2004h"]
[661.162858, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[661.162994, "o", "events {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[661.163137, "o", "    worker_connections 1024;\r\n\u001b[?2004l\r\u001b[?2004h"]
[661.163271, "o", "> }\r\n\u001b[?2004l\r"]
[661.163315, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[661.163395, "o", "> "]
[661.163471, "o", "http {\r\n\u001b[?2004l\r\u001b[?2004h"]
[661.16356, "o", "> "]
[661.163647, "o", "    sendfile on;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[661.163738, "o", "    tcp_nopush on;\r\n\u001b[?2004l\r"]
[661.163805, "o", "\u001b[?2004h> "]
[661.163954, "o", "    types_hash_max_size 2048;\r\n\u001b[?2004l\r"]
[661.164033, "o", "\u001b[?2004h"]
[661.164107, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[661.164245, "o", "    include /etc/nginx/mime.types;\r\n\u001b[?2004l\r"]
[661.164332, "o", "\u001b[?2004h"]
[661.16439, "o", "> "]
[661.164495, "o", "    default_type application/octet-stream;\r\n\u001b[?2004l\r\u001b[?2004h"]
[661.164591, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[661.164871, "o", "    log_format benchmark '$time_local $request_method $status \"$http_user_agent\"';\r\n\u001b[?2004l\r\u001b[?2004h"]
[661.164966, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[661.165054, "o", "> "]
[661.165273, "o", "    limit_req_zone $binary_remote_addr zone=benchmark_limit:10m rate=10r/s;\r\n\u001b[?2004l\r\u001b[?2004h"]
[661.165311, "o", "> \r\n\u001b[?2004l\r"]
[661.165452, "o", "\u001b[?2004h> "]
[661.165555, "o", "    access_log /var/log/nginx/access.log;\r\n\u001b[?2004l\r"]
[661.165705, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[661.165763, "o", "    gzip on;\r\n\u001b[?2004l\r\u001b[?2004h"]
[661.165828, "o", "> \r\n\u001b[?2004l\r"]
[661.165945, "o", "\u001b[?2004h> "]
[661.166054, "o", "    include /etc/nginx/conf.d/*.conf;\r\n\u001b[?2004l\r"]
[661.166165, "o", "\u001b[?2004h> "]
[661.166593, "o", "    include /etc/nginx/sites-enabled/*;\r\n\u001b[?2004l\r\u001b[?2004h"]
[661.166634, "o", "> "]
[661.166694, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[661.166853, "o", "EOF\r\n\u001b[?2004l\r"]
[661.170983, "o", "\u001b[?2004hroot@837a45782dc6:/app# "]
[661.171389, "o", "cat > /etc/nginx/conf.d/benchmark-site.conf <<'EOF'\r\n\u001b[?2004l\r"]
[661.171441, "o", "\u001b[?2004h> server {"]
[661.171491, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[661.171697, "o", "    listen 8080 default_server;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[661.171789, "o", "    listen [::]:8080 default_server;\r\n\u001b[?2004l\r"]
[661.171877, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[661.172014, "o", "    server_name _;\r\n\u001b[?2004l\r\u001b[?2004h"]
[661.172098, "o", "> "]
[661.1722, "o", "    root /var/www/html;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[661.172303, "o", "    index index.html;\r\n\u001b[?2004l\r"]
[661.172357, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[661.172393, "o", "\u001b[?2004h> "]
[661.172606, "o", "    access_log /var/log/nginx/benchmark-access.log benchmark;\r\n\u001b[?2004l\r\u001b[?2004h"]
[661.172699, "o", "> "]
[661.172809, "o", "    error_log /var/log/nginx/benchmark-error.log;\r\n\u001b[?2004l\r\u001b[?2004h"]
[661.172907, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[661.172977, "o", "> "]
[661.173081, "o", "    limit_req zone=benchmark_limit burst=10;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[661.173166, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[661.173226, "o", "> "]
[661.173309, "o", "    error_page 404 /404.html;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[661.173393, "o", "    location = /404.html {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[661.173508, "o", "        internal;\r\n\u001b[?2004l\r\u001b[?2004h"]
[661.173578, "o", "> "]
[661.173678, "o", "    }\r\n\u001b[?2004l\r"]
[661.173754, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[661.173819, "o", "    location / {\r\n\u001b[?2004l\r\u001b[?2004h"]
[661.173892, "o", "> "]
[661.173993, "o", "        try_files $uri $uri/ =404;\r\n\u001b[?2004l\r\u001b[?2004h"]
[661.174093, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[661.174212, "o", "\u001b[?2004h> "]
[661.174345, "o", "EOF\r\n\u001b[?2004l\r"]
[661.176428, "o", "\u001b[?2004hroot@837a45782dc6:/app# "]
[661.17655, "o", "nginx -v 2>&1\r\n\u001b[?2004l\r"]
[661.188979, "o", "nginx version: nginx/1.22.1\r\n"]
[661.189411, "o", "\u001b[?2004hroot@837a45782dc6:/app# "]
[661.189659, "o", "printf '\\nConfigured files:\\n'\r\n\u001b[?2004l\r\r\nConfigured files:\r\n"]
[661.189783, "o", "\u001b[?2004hroot@837a45782dc6:/app# "]
[661.190456, "o", "ls -l /etc/nginx/nginx.conf /etc/nginx/conf.d/benchmark-site.conf /var/www/html/index.html /var/www/html/404.html /var/log/nginx/benchmark-access.log /var/log/nginx/benchmark-error.log\r\n\u001b[?2004l\r"]
[661.193636, "o", "-rw-r--r-- 1 root root 446 Sep  5 18:51 /etc/nginx/conf.d/benchmark-site.conf\r\n-rw-r--r-- 1 root root 631 Sep  5 18:51 /etc/nginx/nginx.conf\r\n-rw-r--r-- 1 root root   0 Sep  5 18:51 /var/log/nginx/benchmark-access.log\r\n-rw-r--r-- 1 root root   0 Sep  5 18:51 /var/log/nginx/benchmark-error.log\r\n-rw-r--r-- 1 root root  39 Sep  5 18:51 /var/www/html/404.html\r\n-rw-r--r-- 1 root root  35 Sep  5 18:51 /var/www/html/index.html\r\n"]
[661.193941, "o", "\u001b[?2004hroot@837a45782dc6:/app# "]
[661.194115, "o", "true; tmux wait -S done\r\n\u001b[?2004l\r"]
[661.197724, "o", "\u001b[?2004hroot@837a45782dc6:/app# "]
[673.199367, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\nset -euo pipefail\nnginx -t\ntrue; tmux wait -S done\r"]
[673.199814, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
[673.200019, "o", "\u001b[?2004hroot@837a45782dc6:/app# "]
[673.200126, "o", "set -euo pipefail\r\n\u001b[?2004l\r\u001b[?2004hroot@837a45782dc6:/app# "]
[673.200233, "o", "nginx -t\r\n\u001b[?2004l\r"]
[673.206661, "o", "nginx: the configuration file /etc/nginx/nginx.conf syntax is ok\r\n"]
[673.21096, "o", "nginx: configuration file /etc/nginx/nginx.conf test is successful\r\n"]
[673.211784, "o", "\u001b[?2004hroot@837a45782dc6:/app# "]
[673.21206, "o", "true; tmux wait -S done\r\n\u001b[?2004l\r"]
[673.21472, "o", "\u001b[?2004hroot@837a45782dc6:/app# "]
[684.349597, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\nset -euo pipefail\n# Stop any existing nginx master if present, then start with current config.\nif [ -s /run/nginx.pid ] && kill -0 \"$(cat /run/nginx.pid)\" 2>/dev/null; then\n  nginx -s reload\nelse\n  nginx\nfi\nsleep 1\nprintf '--- nginx processes ---\\n'\nps -ef | grep '[n]ginx' || true\nprintf '\\n--- listening sockets on 8080 ---\\n'\n(ss -ltnp 2>/dev/null || netstat -ltnp 2>/dev/null || true) | grep ':8080' || true\nprintf '\\n--- localhost:8080 index ---\\n'\ncurl -sS -i http://localhost:8080/ | sed -n '1,20p'\nprintf '\\n--- localhost:8080 missing page ---\\n'\ncurl -sS -i http://localhost:8080/does-not-exist | sed -n '1,30p'\nprintf '\\n--- access log tail ---\\n'\nsleep 0.2\ntail -n 5 /var/log/nginx/benchmark-access.log || true\nprintf '\\nAccess log location: /var/log/nginx/benchmark-access.log\\n'\nprintf 'Error log location: /var/log/nginx/benchmark-error.log\\n'\ntrue; tmux wait -S done\r"]
[684.34996, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
[684.350111, "o", "\u001b[?2004hroot@837a45782dc6:/app# set -euo pipefail\r\n\u001b[?2004l\r"]
[684.350297, "o", "\u001b[?2004hroot@837a45782dc6:/app# "]
[684.350499, "o", "# Stop any existing nginx master if present, then start with current config.\r\n\u001b[?2004l\r\u001b[?2004h"]
[684.350586, "o", "root@837a45782dc6:/app# "]
[684.350835, "o", "if [ -s /run/nginx.pid ] && kill -0 \"$(cat /run/nginx.pid)\" 2>/dev/null; then\r\n\u001b[?2004l\r\u001b[?2004h"]
[684.350912, "o", ">   nginx -s reload\r\n\u001b[?2004l\r"]
[684.351023, "o", "\u001b[?2004h> "]
[684.351127, "o", "else\r\n\u001b[?2004l\r\u001b[?2004h> "]
[684.35119, "o", "  nginx\r\n\u001b[?2004l\r"]
[684.35125, "o", "\u001b[?2004h> "]
[684.351332, "o", "fi\r\n\u001b[?2004l\r"]
[684.357616, "o", "\u001b[?2004hroot@837a45782dc6:/app# "]
[684.358943, "o", "sleep 1\r\n\u001b[?2004l\r"]
[685.361022, "o", "\u001b[?2004hroot@837a45782dc6:/app# "]
[685.361225, "o", "printf '--- nginx processes ---\\n'"]
[685.361321, "o", "\r\n\u001b[?2004l\rbash: printf: --: invalid option\r\nprintf: usage: printf [-v var] format [arguments]\r\n"]
