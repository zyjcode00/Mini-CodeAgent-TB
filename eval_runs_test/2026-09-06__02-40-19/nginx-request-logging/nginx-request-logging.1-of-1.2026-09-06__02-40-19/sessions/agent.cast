[27.428648, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\nset -e\nprintf 'whoami: '; whoami\nprintf 'nginx path: '; command -v nginx || true\nnginx -v 2>&1 || true\nprintf '\\n--- /etc/nginx tree ---\\n'\nfind /etc/nginx -maxdepth 3 -type f -o -type l 2>/dev/null | sort | sed 's#^#/#' | head -200\nprintf '\\n--- key files ---\\n'\nfor f in /etc/nginx/nginx.conf /etc/nginx/conf.d/benchmark-site.conf /etc/nginx/sites-enabled/default /var/www/html/index.html /var/www/html/404.html; do echo \"### $f\"; if [ -e \"$f\" ] || [ -L \"$f\" ]; then ls -l \"$f\"; sed -n '1,220p' \"$f\" 2>/dev/null || true; else echo 'MISSING'; fi; done\nprintf '\\n--- logs dir ---\\n'; ls -ld /var/log/nginx 2>/dev/null || true; ls -l /var/log/nginx 2>/dev/null || true\ntrue; tmux wait -S done\r"]
