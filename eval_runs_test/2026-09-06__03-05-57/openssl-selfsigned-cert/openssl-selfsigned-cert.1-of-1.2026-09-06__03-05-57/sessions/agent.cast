[104.354686, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/test_cert_requirements.py 1 220 true <<'PY'\nimport sys\npath = sys.argv[1]\nstart_line = int(sys.argv[2])\nend_line = None if sys.argv[3] == 'None' else int(sys.argv[3])\nraw_mode = sys.argv[4].lower() == 'true'\ntry:\n    with open(path, 'r', encoding='utf-8', errors='replace') as f:\n        lines = f.readlines()\nexcept FileNotFoundError:\n    print(f\"错误: 找不到文件 {path}\")\n    raise SystemExit(0)\nexcept Exception as exc:\n    print(f\"读取失败: {exc}\")\n    raise SystemExit(0)\n\ntotal_lines = len(lines)\ns_idx = max(0, start_line - 1)\ne_idx = end_line if end_line is not None else total_lines\nselected_lines = lines[s_idx:e_idx]\nif raw_mode:\n    sys.stdout.write(''.join(selected_lines))\nelse:\n    output = []\n    for i, line in enumerate(selected_lines):\n        output.append(f\"{s_idx + i + 1:4d} | {line.rstrip()}\")\n    header = f\"--- 文件: {path} (第 {start_line} 至 {min(e_idx, total_lines)} 行，共 {total_lines} 行) ---\\n\"\n    sys.s"]
[104.354899, "i", "tdout.write(header + \"\\n\".join(output) + \"\\n--- 读取完毕 ---\")\nPY\ntrue; tmux wait -S done\r"]
[104.3552, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n"]
[104.355342, "o", "\u001b[?2004l\r"]
[104.355442, "o", "\u001b[?2004hroot@57a3bf1b0c09:/app# "]
[104.35569, "o", "python3 - /app/test_cert_requirements.py 1 220 true <<'PY'\r\n\u001b[?2004l\r"]
[104.35577, "o", "\u001b[?2004h> import sys\r\n\u001b[?2004l\r"]
[104.355805, "o", "\u001b[?2004h> "]
[104.355953, "o", "path = sys.argv[1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.356091, "o", "start_line = int(sys.argv[2])\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.35618, "o", "> "]
[104.356371, "o", "end_line = None if sys.argv[3] == 'None' else int(sys.argv[3])\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.356468, "o", "> "]
[104.356722, "o", "raw_mode = sys.argv[4].lower() == 'true'\r\n\u001b[?2004l\r\u001b[?2004h> try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.356996, "o", "    with open(path, 'r', encoding='utf-8', errors='replace') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.357047, "o", "> "]
[104.357204, "o", "        lines = f.readlines()\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.357309, "o", "> "]
[104.357424, "o", "except FileNotFoundError:\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.357536, "o", "> "]
[104.357656, "o", "    print(f\"错误: 找不到文件 {path}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.357743, "o", "> "]
[104.357821, "o", "    raise SystemExit(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.357854, "o", "> "]
[104.357993, "o", "except Exception as exc:\r\n\u001b[?2004l\r"]
[104.358021, "o", "\u001b[?2004h"]
[104.358098, "o", "> "]
[104.358209, "o", "    print(f\"读取失败: {exc}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.358256, "o", "> "]
[104.358332, "o", "    raise SystemExit(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.358379, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[104.358406, "o", "> "]
[104.358552, "o", "total_lines = len(lines)\r\n\u001b[?2004l\r"]
[104.358647, "o", "\u001b[?2004h> "]
[104.358741, "o", "s_idx = max(0, start_line - 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.358903, "o", "e_idx = end_line if end_line is not None else total_lines\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.358985, "o", "> "]
[104.359082, "o", "selected_lines = lines[s_idx:e_idx]\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.359182, "o", "> if raw_mode:\r\n\u001b[?2004l\r"]
[104.359255, "o", "\u001b[?2004h> "]
[104.3594, "o", "    sys.stdout.write(''.join(selected_lines))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.359504, "o", "else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.359615, "o", "    output = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[104.359748, "o", "    for i, line in enumerate(selected_lines):\r\n\u001b[?2004l\r"]
[104.359831, "o", "\u001b[?2004h> "]
[104.359992, "o", "        output.append(f\"{s_idx + i + 1:4d} | {line.rstrip()}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.36004, "o", "> "]
[104.36038, "o", "    header = f\"--- 文件: {path} (第 {start_line} 至 {min(e_idx, total_lines)} 行，共 {total_lines} 行) ---\\n\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.36041, "o", "> "]
[104.360672, "o", "    sys.stdout.write(header + \"\\n\".join(output) + \"\\n--- 读取完毕 ---\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[104.360748, "o", "> PY\r\n\u001b[?2004l\r"]
[104.37106, "o", "#!/usr/bin/env python3\r\n\"\"\"Requirement checks for the self-signed TLS certificate task.\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nimport os\r\nimport re\r\nimport ssl\r\nimport stat\r\nimport subprocess\r\nfrom datetime import datetime, timezone\r\nfrom pathlib import Path\r\n\r\nSSL_DIR = Path(\"/app/ssl\")\r\nKEY = SSL_DIR / \"server.key\"\r\nCRT = SSL_DIR / \"server.crt\"\r\nPEM = SSL_DIR / \"server.pem\"\r\nVERIFICATION = SSL_DIR / \"verification.txt\"\r\nCHECK_SCRIPT = Path(\"/app/check_cert.py\")\r\nEXPECTED_CN = \"dev-internal.company.local\"\r\nEXPECTED_ORG = \"DevOps Team\"\r\n\r\n\r\ndef run(command: list[str]) -> str:\r\n    result = subprocess.run(command, check=True, text=True, capture_output=True)\r\n    return result.stdout.strip()\r\n\r\n\r\ndef parse_openssl_date(value: str) -> datetime:\r\n    return datetime.strptime(value, \"%b %d %H:%M:%S %Y %Z\").replace(tzinfo=timezone.utc)\r\n\r\n\r\ndef test_required_files_exist() -> None:\r\n    assert SSL_DIR.is_dir(), \"/app/ssl directory is missing\"\r\n    for path in (KEY, CRT, PEM, VERIFICATION, CHECK_SCRIPT):\r\n       "]
[104.371289, "o", " assert path.is_file(), f\"missing required file: {path}\"\r\n\r\n\r\ndef test_private_key_is_2048_bit_rsa_and_mode_600() -> None:\r\n    mode = stat.S_IMODE(KEY.stat().st_mode)\r\n    assert mode == 0o600, f\"server.key permissions should be 600, got {oct(mode)}\"\r\n    key_text = run([\"openssl\", \"rsa\", \"-in\", str(KEY), \"-text\", \"-noout\"])\r\n    assert \"Private-Key: (2048 bit\" in key_text\r\n    assert run([\"openssl\", \"rsa\", \"-in\", str(KEY), \"-check\", \"-noout\"]) == \"RSA key ok\"\r\n\r\n\r\ndef test_certificate_subject_and_validity() -> None:\r\n    subject = run([\"openssl\", \"x509\", \"-in\", str(CRT), \"-noout\", \"-subject\"])\r\n    assert f\"O = {EXPECTED_ORG}\" in subject\r\n    assert f\"CN = {EXPECTED_CN}\" in subject\r\n\r\n    dates = run([\"openssl\", \"x509\", \"-in\", str(CRT), \"-noout\", \"-dates\"])\r\n    fields = dict(line.split(\"=\", 1) for line in dates.splitlines())\r\n    not_before = parse_openssl_date(fields[\"notBefore\"])\r\n    not_after = parse_openssl_date(fields[\"notAfter\"])\r\n    assert (not_after - not_before).days == 365\r\n\r\n\r\ndef test_certifi"]
[104.371408, "o", "cate_matches_private_key() -> None:\r\n    key_modulus = run([\"openssl\", \"rsa\", \"-noout\", \"-modulus\", \"-in\", str(KEY)])\r\n    crt_modulus = run([\"openssl\", \"x509\", \"-noout\", \"-modulus\", \"-in\", str(CRT)])\r\n    assert key_modulus.replace(\"Modulus=\", \"\") == crt_modulus.replace(\"Modulus=\", \"\")\r\n\r\n\r\ndef test_pem_contains_key_and_certificate() -> None:\r\n    pem_text = PEM.read_text(encoding=\"utf-8\")\r\n    assert \"-----BEGIN PRIVATE KEY-----\" in pem_text or \"-----BEGIN RSA PRIVATE KEY-----\" in pem_text\r\n    assert \"-----BEGIN CERTIFICATE-----\" in pem_text\r\n    assert \"-----END CERTIFICATE-----\" in pem_text\r\n\r\n\r\ndef test_verification_file_contains_required_details() -> None:\r\n    text = VERIFICATION.read_text(encoding=\"utf-8\")\r\n    assert \"subject=\" in text\r\n    assert f\"O = {EXPECTED_ORG}\" in text\r\n    assert f\"CN = {EXPECTED_CN}\" in text\r\n    assert \"notBefore=\" in text and \"notAfter=\" in text\r\n    assert re.search(r\"sha256 Fingerprint=([0-9A-F]{2}:){31}[0-9A-F]{2}\", text), text\r\n\r\n\r\ndef test_check_cert_script_loads_ce"]
[104.371507, "o", "rtificate_and_reports_success() -> None:\r\n    output = run([\"python3\", str(CHECK_SCRIPT)])\r\n    assert f\"Common Name: {EXPECTED_CN}\" in output\r\n    assert re.search(r\"Expiration Date: \\d{4}-\\d{2}-\\d{2}\", output), output\r\n    assert \"Certificate verification successful\" in output\r\n\r\n\r\ndef main() -> int:\r\n    tests = [\r\n        test_required_files_exist,\r\n        test_private_key_is_2048_bit_rsa_and_mode_600,\r\n        test_certificate_subject_and_validity,\r\n        test_certificate_matches_private_key,\r\n        test_pem_contains_key_and_certificate,\r\n        test_verification_file_contains_required_details,\r\n        test_check_cert_script_loads_certificate_and_reports_success,\r\n    ]\r\n    for test in tests:\r\n        test()\r\n        print(f\"PASS {test.__name__}\")\r\n    print(\"All certificate requirement checks passed\")\r\n    return 0\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    raise SystemExit(main())\r\n"]
[104.373001, "o", "\u001b[?2004hroot@57a3bf1b0c09:/app# "]
[104.373134, "o", "true; tmux wait -S done\r\n\u001b[?2004l\r"]
