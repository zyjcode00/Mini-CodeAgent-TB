[69.247661, "o", "#!/usr/bin/env python3\r\n\"\"\"Load and print details for the internal development TLS certificate.\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nimport ssl\r\nfrom datetime import datetime, timezone\r\nfrom pathlib import Path\r\n\r\nCERT_PATH = Path(\"/app/ssl/server.crt\")\r\nEXPECTED_CN = \"dev-internal.company.local\"\r\n"]
[69.247779, "o", "\r\n\r\ndef _format_as_yyyy_mm_dd(openssl_time: str) -> str:\r\n    \"\"\"Convert an OpenSSL ASN.1 time string into YYYY-MM-DD format.\"\"\"\r\n    parsed = datetime.strptime(openssl_time, \"%b %d %H:%M:%S %Y %Z\")\r\n    return parsed.replace(tzinfo=timezone.utc).strftime(\"%Y-%m-%d\")\r\n\r\n\r\ndef _get_subject_value(cert_info: dict, field_name: str) -> str | None:\r\n    \"\"\"Return a value from ssl._test_decode_cert subject tuples.\"\"\"\r\n    for relative_distinguished_name in cert_info.get(\"subject\", ()):  # tuple of tuples\r\n        for key, value in relative_distinguished_name:\r\n            if key == field_name:\r\n                return value\r\n    return None\r\n\r\n\r\ndef main() -> int:\r\n    if not CERT_PATH.exists():\r\n"]
[69.247871, "o", "        raise FileNotFoundError(f\"Certificate not found: {CERT_PATH}\")\r\n\r\n    cert_info = ssl._ssl._test_decode_cert(str(CERT_PATH))  # type: ignore[attr-defined]\r\n    common_name = _get_subject_value(cert_info, \"commonName\")\r\n    organization = _get_subject_value(cert_info, \"organizationName\")\r\n    not_before = _format_as_yyyy_mm_dd(cert_info[\"notBefore\"])\r\n    not_after = _format_as_yyyy_mm_dd(cert_info[\"notAfter\"])\r\n\r\n    if common_name != EXPECTED_CN:\r\n        raise ValueError(f\"Unexpected Common Name: {common_name!r}\")\r\n\r\n    print(f\"Certificate path: {CERT_PATH}\")\r\n    print(f\"Organization: {organization}\")\r\n    print(f\"Common Name: {common_name}\")\r\n    print(f\"Valid From: {not_before}\")\r\n    print(f\"Expiration Date: {not_after}\")\r\n    print(\"Certificate verification successful\")\r\n    return 0\r\n"]
[69.247954, "o", "\r\n\r\nif __name__ == \"__main__\":\r\n    raise SystemExit(main())\r\n"]
[69.248212, "o", "\u001b[?2004hroot@57a3bf1b0c09:/app# "]
