\\n\' AS txt FROM db_csv\n)\nSELECT\n    (SELECT COUNT(*) FROM customers) AS db_rows,\n    (SELECT COUNT(*) FROM customers WHERE (email IS NULL OR email = \'\') AND (phone IS NULL OR phone = \'\')) AS missing_contact_rows,\n    (SELECT COUNT(*) FROM customers WHERE email IS NOT NULL AND email <> lower(email)) AS non_lowercase_email_rows,\n    (SELECT COUNT(*) FROM customers WHERE phone IS NOT NULL AND phone !~ \'^[0-9]+$\') AS nondigit_phone_rows,\n    (SELECT COUNT(*) FROM (\n        SELECT name, email, phone, city, COUNT(*)\n        FROM customers\n        GROUP BY name, email, phone, city\n        HAVING COUNT(*) > 1\n     ) d) AS duplicate_logical_rows,\n    (SELECT txt = pg_read_file(\'/var/lib/postgresql/data/customers_v1.csv\') FROM ordered_db) AS db_matches_expected_file;\n"""\n# Copy the expected baseline into the database container\'s data volume through SQL-visible path if needed.\n# The PostgreSQL container mounts /app/data at /var/lib/postgresql/data in this task environment; if not,\n# fall back to direct row checks below.\ntry:\n    out = subprocess.check_output(PSQL + ["-At", "-F", "|", "-c", sql_checks], env=DB_ENV, text=True, stderr=subprocess.STDOUT)\nexcept subprocess.CalledProcessError as exc:\n    # Fallback for environments where pg_read_file cannot access the CSV path.\n    db_export = subprocess.check_output(\n        PSQL + ["-At", "-F", ",", "-c", "SELECT id, name, coalesce(email,\'\'), coalesce(phone,\'\'), city FROM customers ORDER BY id"],\n        env=DB_ENV,\n        text=True,\n    )\n    reconstructed = "id,name,email,phone,city\\n" + db_export\n    assert reconstructed == expected_text, "PostgreSQL customers table does not match expected cleaned CSV"\nelse:\n    parts = out.strip().split("|")\n    assert parts == ["17", "0", "0", "0", "0", "t"], f"SQL data-quality checks failed: {out}"\n\nstats = subprocess.check_output(\n    PSQL + ["-At", "-c", "SELECT lower(query) FROM pg_stat_statements WHERE lower(query) LIKE \'%update customers%\' OR lower(query) LIKE \'%delete from customers%\' OR lower(query) LIKE \'%regexp_replace%\' OR lower(query) LIKE \'%copy customers%\' OR lower(query) LIKE \'%copy  customers%\' ORDER BY query"],\n    env=DB_ENV,\n    text=True,\n)\nstats_l = stats.lower()\nassert "update customers" in stats_l, "pg_stat_statements lacks UPDATE customers evidence"\nassert "delete from customers" in stats_l, "pg_stat_statements lacks DELETE customers evidence"\nassert "regexp_replace" in stats_l, "pg_stat_statements lacks regexp_replace phone-cleaning evidence"\nprint("PASS: CSV matches baseline; PostgreSQL table matches cleaned output; SQL quality checks pass; pg_stat_statements shows server-side cleaning statements.")\nPY\npython3 /tmp/test_cleaned_customers.py\ntrue', '; tmux wait -S done', 'Enter'] min_timeout_sec: 0.0 max_timeout_sec: 300.0
