[53.652479, "i", "pt np.linalg.LinAlgError:\\n            # Random continuous matrices are nonsingular almost surely, but this\\n            # fallback handles any singular candidate bases safely.\\n            for combo in combos:\\n                matrix = A[:, combo]\\n                try:\\n                    solution = np.linalg.solve(matrix, b)\\n                except np.linalg.LinAlgError:\\n                    continue\\n                if np.all(solution >= -TOL):\\n                    count += 1\\n    return count\\n\\n\\ndef main() -> None:\\n    indices = instance_indices()\\n    if not indices:\\n        raise FileNotFoundError(\"No /app/A_i.csv and /app/b_i.csv instances found\")\\n\\n    counts: list[int] = []\\n    for i in indices:\\n        A = np.loadtxt(os.path.join(APP_DIR, f\"A_{i}.csv\"), delimiter=\",\")\\n        b = np.loadtxt(os.path.join(APP_DIR, f\"b_{i}.csv\"), delimiter=\",\")\\n        count = count_corners_for_instance(A, b)\\n        counts.append(count)\\n        print(f\"instance {i}: {count}\", flush=True)\\n\\n    output_path"]
