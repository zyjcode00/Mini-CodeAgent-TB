[179.519063, "o", "ounts.txt\")).astype(int)\\n    indices = instance_indices()\\n    assert len(values) == len(indices)\\n    recomputed = []\\n    for i in indices:\\n        A = np.loadtxt(f\"/app/A_{i}.csv\", delimiter=\",\")\\n        b = np.loadtxt(f\"/app/b_{i}.csv\", delimiter=\",\")\\n        recomputed.append(count_corners_for_instance(A, b))\\n    assert values.tolist() == recomputed\\n\\n\\ndef test_count_function_on_known_small_embedded_cases() -> None:\\n    # Build a 6x40 matrix where first 6 variables satisfy x=b>=0.  Other columns\\n    # are zero, so only the first six-column basis is nonsingular and feasible.\\n    A = np.zeros((6, 40), dtype=float)\\n    A[:, :6] = np.eye(6)\\n    b = np.arange(1, 7, dtype=float)\\n    assert count_corners_for_instance(A, b) == 1\\n\\n    # With negative b, that one nonsingular basis is not feasible.\\n    assert count_corners_for_instance(A, -b) == 0\\n'\r\n\u001b[?2004l\r\u001b[?2004h> dir_path = os.path.dirname(path)\r\n\u001b[?2004l\r"]
