[26.371608, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\nfind /app -maxdepth 1 -type f | sed 's#^#/##' | sort | head -200 && echo '--- counts ---' && ls /app/A_*.csv 2>/dev/null | wc -l && ls /app/b_*.csv 2>/dev/null | wc -l && echo '--- sample shapes ---' && python - <<'PY'\nimport glob, numpy as np, os, re\nAs=sorted(glob.glob('/app/A_*.csv'), key=lambda p:int(re.search(r'A_(\\d+)\\.csv$',p).group(1)) if re.search(r'A_(\\d+)\\.csv$',p) else -1)\nbs=sorted(glob.glob('/app/b_*.csv'), key=lambda p:int(re.search(r'b_(\\d+)\\.csv$',p).group(1)) if re.search(r'b_(\\d+)\\.csv$',p) else -1)\nprint('first A:', As[:3])\nprint('last A:', As[-3:])\nprint('first b:', bs[:3])\nprint('last b:', bs[-3:])\nfor p in (As[:1]+bs[:1]):\n    arr=np.loadtxt(p, delimiter=',')\n    print(os.path.basename(p), arr.shape, arr[:2] if arr.ndim>1 else arr[:5])\nprint('indices A', [int(re.search(r'A_(\\d+)\\.csv$',p).group(1)) for p in As[:10]], '...', [int(re.search(r'A_(\\d+)\\.csv$',p).group(1)) for p in As[-10:]])\nprint('indices b', [int(re.search(r'b_(\\d+)\\.cs"]
[26.371749, "i", "v$',p).group(1)) for p in bs[:10]], '...', [int(re.search(r'b_(\\d+)\\.csv$',p).group(1)) for p in bs[-10:]])\nPY\ntrue; tmux wait -S done\r"]
