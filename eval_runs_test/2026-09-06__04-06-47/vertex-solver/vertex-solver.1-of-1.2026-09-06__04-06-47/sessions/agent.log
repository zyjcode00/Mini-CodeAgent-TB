[?2004l[?2004h> content = '#!/usr/bin/env python3\n"""Count basic feasible corner points for LP instances A_i x = b_i, x >= 0.\n\nFor each matching /app/A_i.csv and /app/b_i.csv pair, every 6-column basis is\nexamined.  The number of bases whose basic solution is componentwise\nnonnegative is written to /app/corner_counts.txt, one integer per line.\n"""\n\nfrom __future__ import annotations\n\nimport glob\nimport itertools\nimport os\nimport re\nfrom typing import Iterable, Iterator\n\nimport numpy as np\n\nAPP_DIR = "/app"\nN_ROWS = 6\nN_COLS = 40\nBASIS_SIZE = 6\nBATCH_SIZE = 100_000\nTOL = 1e-9\nDET_TOL = 1e-12\n\n\ndef instance_indices() -> list[int]:\n    """Return sorted indices i for which both A_i.csv and b_i.csv exist."""\n    a_indices: set[int] = set()\n    b_indices: set[int] = set()\n    a_re = re.compile(r"A_(\\d+)\\.csv$")\n    b_re = re.compile(r"b_(\\d+)\\.csv$")\n\n    for path in glob.glob(os.path.join(APP_DIR, "A_*.csv")):\n        match = a_re.search(os.path.basename(path))\n        if match:\n            a_indices.add(int(match.group(1)))\n    for path in glob.glob(os.path.join(APP_DIR, "b_*.csv")):\n        match = b_re.search(os.path.basename(path))\n        if match:\n            b_indices.add(int(match.group(1)))\n\n    if a_indices != b_indices:\n        missing_b = sorted(a_indices - b_indices)\n        missing_a = sorted(b_indices - a_indices)\n        raise FileNotFoundError(\n            f"Mismatched A/b files: missing b for {missing_b}, missing A for {missing_a}"\n        )\n    return sorted(a_indices)\n\n\ndef batched(iterable: Iterable[tuple[int, ...]], batch_size: int) -> Iterator[np.ndarray]:\n    """Yield combinations from iterable as int arrays of shape (<=batch_size, 6)."""\n    iterator = iter(iterable)\n    while True:\n        chunk = list(itertools.islice(iterator, batch_size))\n        if not chunk:\n            return\n        yield np.asarray(chunk, dtype=np.intp)\n\n\ndef count_corners_for_instance(A: np.ndarray, b: np.ndarray) -> int:\n    """Count all 6-variable basic feasible solutions for one instance.\n\n    Singular bases are skipped because they do not define a unique basic\n    solution.  Random continuous input matrices are nonsingular almost surely,\n    but explicitly screening determinants keeps the function robust for tests\n    and any degenerate data.\n    """\n    A = np.asarray(A, dtype=float)\n    b = np.asarray(b, dtype=float).reshape(-1)\n    if A.shape != (N_ROWS, N_COLS):\n        raise ValueError(f"Expected A shape {(N_ROWS, N_COLS)}, got {A.shape}")\n    if b.shape != (N_ROWS,):\n        raise ValueError(f"Expected b shape {(N_ROWS,)}, got {b.shape}")\n\n    count = 0\n    for combos in batched(itertools.combinations(range(N_COLS), BASIS_SIZE), BATCH_SIZE):\n        # A[:, combos] creates shape (6, 6, batch); transpose to a stack of\n        # square matrices with shape (batch, 6, 6).\n        matrices = A[:, combos].transpose(2, 0, 1)\n        nonsingular = np.abs(np.linalg.det(matrices)) > DET_TOL\n        if not np.any(nonsingular):\n            continue\n\n        selected = matrices[nonsingular]\n        rhs = np.broadcast_to(b, (len(selected), N_ROWS))\n        try:\n            solutions = np.linalg.solve(selected, rhs)\n        except np.linalg.LinAlgError:\n            # Very rare numerical fallback for matrices that pass the determinant\n            # threshold but are still rejected by LAPACK.\n            for matrix in selected:\n                try:\n                    solution = np.linalg.solve(matrix, b)\n                except np.linalg.LinAlgError:\n                    continue\n                if np.all(solution >= -TOL):\n                    count += 1\n            continue\n\n        feasible = np.all(solutions >= -TOL, axis=1)\n        count += int(np.count_nonzero(feasible))\n    return count\n\n\ndef main() -> None:\n    indices = instance_indices()\n    if not indices:\n        raise FileNotFoundError("No /app/A_i.csv and /app/b_i.csv instances found")\n\n    counts: list[int] = []\n    for i in indices:\n        A = np.loadtxt(os.path.join(APP_DIR, f"A_{i}.csv"), delimiter=",")\n        b = np.loadtxt(os.path.join(APP_DIR, f"b_{i}.csv"), delimiter=",")\n        count = count_corners_for_instance(A, b)\n        counts.append(count)\n        print(f"instance {i}: {count}", flush=True)\n\n    output_path = os.path.join(APP_DIR, "corner_counts.txt")\n    with open(output_path, "w", encoding="utf-8") as f:\n        for count in counts:\n            f.write(f"{count}\\n")\n\n\nif __name__ == "__main__":\n    main()\n'
