[?2004l[?2004h> content = '#!/usr/bin/env python3\n"""Validation tests for /app/corner_counts.txt."""\n\nfrom __future__ import annotations\n\nimport glob\nimport itertools\nimport math\nimport os\nimport re\n\nimport numpy as np\n\nfrom count_corners import count_corners_for_instance, instance_indices\n\n\ndef test_output_loadable_and_basic_format() -> None:\n    path = "/app/corner_counts.txt"\n    assert os.path.exists(path), "corner_counts.txt was not created"\n\n    with open(path, "r", encoding="utf-8") as f:\n        lines = f.read().splitlines()\n    assert lines, "corner_counts.txt is empty"\n    assert all(re.fullmatch(r"\\d+", line) for line in lines), lines\n\n    values = np.loadtxt(path)\n    values = np.atleast_1d(values)\n    assert values.shape == (len(instance_indices()),)\n    assert np.all(values == np.floor(values))\n    assert np.all(values >= 0)\n    assert np.all(values <= math.comb(40, 6))\n\n\ndef test_counts_match_recomputed_instances() -> None:\n    values = np.atleast_1d(np.loadtxt("/app/corner_counts.txt")).astype(int)\n    indices = instance_indices()\n    assert len(values) == len(indices)\n    recomputed = []\n    for i in indices:\n        A = np.loadtxt(f"/app/A_{i}.csv", delimiter=",")\n        b = np.loadtxt(f"/app/b_{i}.csv", delimiter=",")\n        recomputed.append(count_corners_for_instance(A, b))\n    assert values.tolist() == recomputed\n\n\ndef test_count_function_on_known_small_embedded_cases() -> None:\n    # Build a 6x40 matrix where first 6 variables satisfy x=b>=0.  Other columns\n    # are zero, so only the first six-column basis is nonsingular and feasible.\n    A = np.zeros((6, 40), dtype=float)\n    A[:, :6] = np.eye(6)\n    b = np.arange(1, 7, dtype=float)\n    assert count_corners_for_instance(A, b) == 1\n\n    # With negative b, that one nonsingular basis is not feasible.\n    assert count_corners_for_instance(A, -b) == 0\n'
