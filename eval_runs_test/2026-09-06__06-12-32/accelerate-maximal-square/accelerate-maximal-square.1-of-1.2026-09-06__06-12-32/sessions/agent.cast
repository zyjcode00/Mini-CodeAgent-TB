[88.265426, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/maximal_square.py <<'PY'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = '\"\"\"Fast CPU implementation of maximal square for NumPy arrays.\\n\\nThe public API intentionally matches the reference implementation:\\n\\n    maximal_square(matrix: np.ndarray) -> int\\n\\nFor large inputs this module uses a small C backend compiled on first import and\\ncalled through ctypes.  The one-time compilation cost is acceptable for long\\nruns; the actual computation is the same dynamic-programming recurrence as the\\nreference code, but executed in native code instead of Python loops.\\n\"\"\"\\n\\nimport ctypes\\nimport hashlib\\nimport os\\nimport subprocess\\nimport tempfile\\n\\nimport numpy as np\\n\\n\\n_C_SOURCE = r\\'\\'\\'\\n#include <stdint.h>\\n#include <stdlib.h>\\n\\n#if defined(_WIN32)\\n#  define EXPORT __declspec(dllexport)\\n#else\\n#  define EXPORT __attribute__((visibility(\"default\")))\\n#endif\\n\\nstatic inline int min3_int(int a, int b, int c) {\\n    int m = a < b ? a :"]
[88.266052, "i", " b;\\n    return m < c ? m : c;\\n}\\n\\nEXPORT long long maximal_square_u8(const uint8_t *data, long long rows, long long cols) {\\n    if (data == NULL || rows <= 0 || cols <= 0) return 0;\\n\\n    int *dp = (int *)calloc((size_t)cols + 1u, sizeof(int));\\n    if (dp == NULL) return -1;\\n\\n    int maxsqlen = 0;\\n    for (long long i = 0; i < rows; ++i) {\\n        int prev = 0;\\n        const uint8_t *row = data + i * cols;\\n        for (long long j = 1; j <= cols; ++j) {\\n            int temp = dp[j];\\n            if (row[j - 1] != 0) {\\n                int v = min3_int(dp[j - 1], prev, dp[j]) + 1;\\n                dp[j] = v;\\n                if (v > maxsqlen) maxsqlen = v;\\n            } else {\\n                dp[j] = 0;\\n            }\\n            prev = temp;\\n        }\\n    }\\n\\n    free(dp);\\n    return (long long)maxsqlen * (long long)maxsqlen;\\n}\\n\\'\\'\\'\\n\\n\\n_LIB = None\\n_COMPILE_ERROR = None\\n\\n\\ndef _compile_and_load_backend():\\n    \"\"\"Build and load the tiny C backend, caching it in the temp directory.\""]
[88.266809, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n b;\\n    return m < c ? m : c;\\n}\\n\\nEXPORT long long maximal_square_u8(const uint8_t *data, long long rows, long long cols) {\\n    if (data == NULL || rows <= 0 || cols <= 0) return 0;\\n\\n    int *dp = (int *)calloc((size_t)cols + 1u, sizeof(int));\\n    if (dp == NULL) return -1;\\n\\n    int maxsqlen = 0;\\n    for (long long i = 0; i < rows; ++i) {\\n        int prev = 0;\\n        const uint8_t *row = data + i * cols;\\n        for (long long j = 1; j <= cols; ++j) {\\n            int temp = dp[j];\\n            if (row[j - 1] != 0) {\\n                int v = min3_int(dp[j - 1], prev, dp[j]) + 1;\\n                dp[j] = v;\\n                if (v > maxsqlen) maxsqlen = v;\\n            } else {\\n                dp[j] = 0;\\n            }\\n            prev = temp;\\n        }\\n    }\\n\\n    free(dp);\\n    return (long long)maxsqlen * (long long)maxsqlen;\\n}\\n\\'\\'\\'\\n\\n\\n_LIB = None\\n_COMPILE_ERROR = None\\n\\n\\ndef _compile_and_load_backend():\\n    \"\"\"Build and load "]
[88.266943, "i", "\"\"\\n    global _COMPILE_ERROR\\n\\n    key = hashlib.sha256(_C_SOURCE.encode(\"utf-8\")).hexdigest()[:16]\\n    build_dir = os.path.join(tempfile.gettempdir(), \"maximal_square_c_backend\")\\n    src_path = os.path.join(build_dir, \"maximal_square_%s.c\" % key)\\n    so_path = os.path.join(build_dir, \"maximal_square_%s.so\" % key)\\n\\n    try:\\n        if not os.path.isdir(build_dir):\\n            os.makedirs(build_dir)\\n        if not os.path.exists(so_path):\\n            with open(src_path, \"w\") as f:\\n                f.write(_C_SOURCE)\\n            cmd = [\\n                \"gcc\", \"-O3\", \"-march=native\", \"-std=c99\", \"-shared\", \"-fPIC\",\\n                src_path, \"-o\", so_path,\\n            ]\\n            subprocess.check_call(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\\n\\n        lib = ctypes.CDLL(so_path)\\n        func = lib.maximal_square_u8\\n        func.argtypes = [\\n            ctypes.POINTER(ctypes.c_uint8),\\n            ctypes.c_longlong,\\n            ctypes.c_longlong,\\n        ]\\n        func.res"]
[88.267058, "o", "the tiny C backend, caching it in the temp directory.\"root@1ff060905968:/taichi-dev/taichi# "]
[88.267185, "i", "type = ctypes.c_longlong\\n        return lib\\n    except Exception as exc:  # pragma: no cover - fallback path is environment dependent\\n        _COMPILE_ERROR = exc\\n        return None\\n\\n\\ndef _python_fallback(matrix):\\n    \"\"\"Reference-equivalent fallback used only if a C compiler is unavailable.\"\"\"\\n    rows = len(matrix)\\n    cols = len(matrix[0]) if rows > 0 else 0\\n    dp = [0] * (cols + 1)\\n    maxsqlen = 0\\n    for i in range(1, rows + 1):\\n        prev = 0\\n        for j in range(1, cols + 1):\\n            temp = dp[j]\\n            if matrix[i - 1, j - 1] == 1:\\n                v = min(dp[j - 1], prev, dp[j]) + 1\\n                dp[j] = v\\n                if v > maxsqlen:\\n                    maxsqlen = v\\n            else:\\n                dp[j] = 0\\n            prev = temp\\n    return maxsqlen * maxsqlen\\n\\n\\ndef maximal_square(matrix: np.ndarray) -> int:\\n    \"\"\"Return the area of the largest all-1 square in a binary NumPy array.\\n\\n    Parameters\\n    ----------\\n    matrix : np.ndarray\\n     "]
[88.267301, "o", "python3 - /app/maximal_square.py <<'PY'\r\n> "]
[88.267403, "i", "   Two-dimensional array containing only 0s and 1s.  Non-zero values are\\n        treated as 1 by the accelerated backend, which is equivalent for valid\\n        binary inputs.\\n\\n    Returns\\n    -------\\n    int\\n        Area of the largest square containing only 1s.\\n    \"\"\"\\n    arr = np.asarray(matrix)\\n    if arr.ndim != 2:\\n        raise ValueError(\"matrix must be a 2-dimensional numpy ndarray\")\\n\\n    rows, cols = arr.shape\\n    if rows == 0 or cols == 0:\\n        return 0\\n\\n    # The C kernel is specialized for dense uint8 row-major input.  For the\\n    # expected large binary matrices this copy/conversion is tiny compared with\\n    # eliminating ~1,000,000 Python-loop iterations per call.\\n    arr_u8 = np.ascontiguousarray(arr, dtype=np.uint8)\\n\\n    global _LIB\\n    if _LIB is None:\\n        _LIB = _compile_and_load_backend()\\n\\n    if _LIB is not None:\\n        ptr = arr_u8.ctypes.data_as(ctypes.POINTER(ctypes.c_uint8))\\n        result = _LIB.maximal_square_u8(ptr, int(rows), int(cols))\\n        "]
[88.267498, "o", "import os\r\n> import sys\r\n> "]
