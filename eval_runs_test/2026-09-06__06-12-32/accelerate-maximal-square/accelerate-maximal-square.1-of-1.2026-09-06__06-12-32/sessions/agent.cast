[88.290474, "o", "content = '\"\"\"Fast CPU implementation of maximal square for NumPy arrays.\\n\\nThe public API intentionally matches the reference implementation:\\n\\n    maximal_\r_square(matrix: np.ndarray) -> int\\n\\nFor large inputs this module uses a small C backend compiled on first import and\\ncalled through ctypes.  The one-time comp\rpilation cost is acceptable for long\\nruns; the actual computation is the same dynamic-programming recurrence as the\\nreference code, but executed in native code\re instead of Python loops.\\n\"\"\"\\n\\nimport ctypes\\nimport hashlib\\nimport os\\nimport subprocess\\nimport tempfile\\n\\nimport numpy as np\\n\\n\\n_C_SOURCE = r\\'\\'\\'\\n#\r#include <stdint.h>\\n#include <stdlib.h>\\n\\n#if defined(_WIN32)\\n#  define EXPORT __declspec(dllexport)\\n#else\\n#  define EXPORT __attribute__((visibility(\"defau\rult\")))\\n#endif\\n\\nstatic inline int min3_int(int a, int b, int c) {\\n    int m = a < b ? a : b;\\n    return m < c ? m : c;\\n}\\n\\nEXPORT long long maximal_square\re_u8(const uint8_t *data, long long rows, long long co"]
[88.290775, "o", "ls) {\\n    if (data == NULL || rows <= 0 || cols <= 0) return 0;\\n\\n    int *dp = (int *)calloc((size_t)col\rls + 1u, sizeof(int));\\n    if (dp == NULL) return -1;\\n\\n    int maxsqlen = 0;\\n    for (long long i = 0; i < rows; ++i) {\\n        int prev = 0;\\n        const\rt uint8_t *row = data + i * cols;\\n        for (long long j = 1; j <= cols; ++j) {\\n            int temp = dp[j];\\n            if (row[j - 1] != 0) {\\n          \r       int v = min3_int(dp[j - 1], prev, dp[j]) + 1;\\n                dp[j] = v;\\n                if (v > maxsqlen) maxsqlen = v;\\n            } else {\\n        \r         dp[j] = 0;\\n            }\\n            prev = temp;\\n        }\\n    }\\n\\n    free(dp);\\n    return (long long)maxsqlen * (long long)maxsqlen;\\n}\\n\\'\\'\\'\r'\\n\\n\\n_LIB = None\\n_COMPILE_ERROR = None\\n\\n\\ndef _compile_and_load_backend():\\n    \"\"\"Build and load the tiny C backend, caching it in the temp directory.\"\"\"\\n\rn    global _COMPILE_ERROR\\n\\n    key = hashlib.sha256(_C_SOURCE.encode(\"utf-8\")).hexdigest()[:16]\\n    bu"]
[88.290855, "o", "ild_dir = os.path.join(tempfile.gettempdir(), \"maximal_\r_square_c_backend\")\\n    src_path = os.path.join(build_dir, \"maximal_square_%s.c\" % key)\\n    so_path = os.path.join(build_dir, \"maximal_square_%s.so\" % key)\\n\\n\rn    try:\\n        if not os.path.isdir(build_dir):\\n            os.makedirs(build_dir)\\n        if not os.path.exists(so_path):\\n            with open(src_path,\r, \"w\") as f:\\n                f.write(_C_SOURCE)\\n            cmd = [\\n                \"gcc\", \"-O3\", \"-march=native\", \"-std=c99\", \"-shared\", \"-fPIC\",\\n          \r       src_path, \"-o\", so_path,\\n            ]\\n            subprocess.check_call(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\\n\\n        lib = cty\rypes.CDLL(so_path)\\n        func = lib.maximal_square_u8\\n        func.argtypes = [\\n            ctypes.POINTER(ctypes.c_uint8),\\n            ctypes.c_longlong,\\\r\\n            ctypes.c_longlong,\\n        ]\\n        func.restype = ctypes.c_longlong\\n        return lib\\n    except Exception as exc:  # pragma: no cover - "]
[88.290989, "o", "fal\rllback path is environment dependent\\n        _COMPILE_ERROR = exc\\n        return None\\n\\n\\ndef _python_fallback(matrix):\\n    \"\"\"Reference-equivalent fallback \r used only if a C compiler is unavailable.\"\"\"\\n    rows = len(matrix)\\n    cols = len(matrix[0]) if rows > 0 else 0\\n    dp = [0] * (cols + 1)\\n    maxsqlen = 0\\\r\\n    for i in range(1, rows + 1):\\n        prev = 0\\n        for j in range(1, cols + 1):\\n            temp = dp[j]\\n            if matrix[i - 1, j - 1] == 1:\\n\rn                v = min(dp[j - 1], prev, dp[j]) + 1\\n                dp[j] = v\\n                if v > maxsqlen:\\n                    maxsqlen = v\\n            \r else:\\n                dp[j] = 0\\n            prev = temp\\n    return maxsqlen * maxsqlen\\n\\n\\ndef maximal_square(matrix: np.ndarray) -> int:\\n    \"\"\"Return the\re area of the largest all-1 square in a binary NumPy array.\\n\\n    Parameters\\n    ----------\\n    matrix : np.ndarray\\n        Two-dimensional array containing \r only 0s and 1s.  Non-zero values are\\n        t"]
[88.291141, "o", "reated as 1 by the accelerated backend, which is equivalent for valid\\n        binary inputs.\\n\\n    Returns\\n   \r  -------\\n    int\\n        Area of the largest square containing only 1s.\\n    \"\"\"\\n    arr = np.asarray(matrix)\\n    if arr.ndim != 2:\\n        raise ValueErro\ror(\"matrix must be a 2-dimensional numpy ndarray\")\\n\\n    rows, cols = arr.shape\\n    if rows == 0 or cols == 0:\\n        return 0\\n\\n    # The C kernel is speci\rialized for dense uint8 row-major input.  For the\\n    # expected large binary matrices this copy/conversion is tiny compared with\\n    # eliminating ~1,000,000 \r Python-loop iterations per call.\\n    arr_u8 = np.ascontiguousarray(arr, dtype=np.uint8)\\n\\n    global _LIB\\n    if _LIB is None:\\n        _LIB = _compile_and_l\rload_backend()\\n\\n    if _LIB is not None:\\n        ptr = arr_u8.ctypes.data_as(ctypes.POINTER(ctypes.c_uint8))\\n        result = _LIB.maximal_square_u8(ptr, int\rt(rows), int(cols))\\n        if result >= 0:\\n            return int(result)\\n        # Allocation f"]
[88.291337, "o", "ailure inside the C routine is very unlikely; fall back to\\n \r        # the Python implementation rather than returning an invalid value.\\n\\n    return int(_python_fallback(arr_u8))\\n\\n\\n__all__ = [\"maximal_square\"]\\n'\r\n> dir_path = os.path.dirname(path)\r\n> if dir_path:\r\n>     os.makedirs(dir_path, exist_ok=True)\r\n> try:\r\n> "]
