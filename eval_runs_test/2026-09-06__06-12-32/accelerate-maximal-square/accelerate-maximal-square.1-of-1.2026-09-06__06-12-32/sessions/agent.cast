[201.16801, "i", "rows > 0 else 0\\n    dp = [0] * (cols + 1)\\n    maxsqlen = 0\\n    for i in range(1, rows + 1):\\n        prev = 0\\n        for j in range(1, cols + 1):\\n            temp = dp[j]\\n            if matrix[i - 1, j - 1] == 1:\\n                v = min(dp[j - 1], prev, dp[j]) + 1\\n                dp[j] = v\\n                if v > maxsqlen:\\n                    maxsqlen = v\\n            else:\\n                dp[j] = 0\\n            prev = temp\\n    return maxsqlen * maxsqlen\\n\\n\\ndef maximal_square(matrix: np.ndarray) -> int:\\n    \"\"\"Return the area of the largest all-1 square in a 2-D binary ndarray.\"\"\"\\n    arr = np.asarray(matrix)\\n    if arr.ndim != 2:\\n        raise ValueError(\"matrix must be a 2-dimensional numpy ndarray\")\\n\\n    rows, cols = arr.shape\\n    if rows == 0 or cols == 0:\\n        return 0\\n\\n    lib, dispatch = _get_backend()\\n    if lib is not None and dispatch is not None:\\n        dtype = arr.dtype\\n        entry = dispatch.get(dtype)\\n        if entry is None:\\n            # Unsupported dtypes a"]
