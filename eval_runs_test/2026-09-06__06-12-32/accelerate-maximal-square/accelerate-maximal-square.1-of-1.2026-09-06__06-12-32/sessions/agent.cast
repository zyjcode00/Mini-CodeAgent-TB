[201.166679, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/maximal_square.py <<'PY'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = '\"\"\"Fast CPU implementation of maximal square for NumPy arrays.\\n\\nPublic API:\\n    maximal_square(matrix: np.ndarray) -> int\\n\\nThe implementation keeps the same dynamic-programming recurrence as the\\nreference Python code, but executes the nested loops in a tiny native C shared\\nlibrary loaded through ctypes.  The backend is compiled once on first use and\\ncached under the system temporary directory.  This is intended for large CPU-only\\nworkloads where warmup time is negligible.\\n\"\"\"\\n\\nimport ctypes\\nimport hashlib\\nimport os\\nimport subprocess\\nimport tempfile\\n\\nimport numpy as np\\n\\n\\n_C_SOURCE = r\\'\\'\\'\\n#include <stdint.h>\\n#include <stdlib.h>\\n\\n#if defined(_WIN32)\\n#  define EXPORT __declspec(dllexport)\\n#else\\n#  define EXPORT __attribute__((visibility(\"default\")))\\n#endif\\n\\nstatic inline int min3_int(int a, int b, int c) {\\n    int m = a < b ? a : b;\\n   "]
[201.16693, "i", " return m < c ? m : c;\\n}\\n\\n#define DEFINE_MAXIMAL_SQUARE(NAME, TYPE) \\\\\\nEXPORT long long NAME(const TYPE *data, long long rows, long long cols) { \\\\\\n    if (data == NULL || rows <= 0 || cols <= 0) return 0; \\\\\\n    int *dp = (int *)calloc((size_t)cols + 1u, sizeof(int)); \\\\\\n    if (dp == NULL) return -1; \\\\\\n    int maxsqlen = 0; \\\\\\n    for (long long i = 0; i < rows; ++i) { \\\\\\n        int prev = 0; \\\\\\n        const TYPE *row = data + i * cols; \\\\\\n        for (long long j = 1; j <= cols; ++j) { \\\\\\n            int temp = dp[j]; \\\\\\n            if (row[j - 1] != (TYPE)0) { \\\\\\n                int v = min3_int(dp[j - 1], prev, dp[j]) + 1; \\\\\\n                dp[j] = v; \\\\\\n                if (v > maxsqlen) maxsqlen = v; \\\\\\n            } else { \\\\\\n                dp[j] = 0; \\\\\\n            } \\\\\\n            prev = temp; \\\\\\n        } \\\\\\n    } \\\\\\n    free(dp); \\\\\\n    return (long long)maxsqlen * (long long)maxsqlen; \\\\\\n}\\n\\nDEFINE_MAXIMAL_SQUARE(maximal_square_u8,  uint8_t)\\nDEFINE_MAXIMAL_SQUARE(m"]
[201.167098, "i", "aximal_square_i8,  int8_t)\\nDEFINE_MAXIMAL_SQUARE(maximal_square_u16, uint16_t)\\nDEFINE_MAXIMAL_SQUARE(maximal_square_i16, int16_t)\\nDEFINE_MAXIMAL_SQUARE(maximal_square_u32, uint32_t)\\nDEFINE_MAXIMAL_SQUARE(maximal_square_i32, int32_t)\\nDEFINE_MAXIMAL_SQUARE(maximal_square_u64, uint64_t)\\nDEFINE_MAXIMAL_SQUARE(maximal_square_i64, int64_t)\\nDEFINE_MAXIMAL_SQUARE(maximal_square_f32, float)\\nDEFINE_MAXIMAL_SQUARE(maximal_square_f64, double)\\n\\'\\'\\'\\n\\n\\n_LIB = None\\n_COMPILE_ERROR = None\\n_DISPATCH = None\\n\\n\\ndef _compile_and_load_backend():\\n    \"\"\"Build and load the C backend, caching it in the temp directory.\"\"\"\\n    global _COMPILE_ERROR\\n    key = hashlib.sha256(_C_SOURCE.encode(\"utf-8\")).hexdigest()[:16]\\n    build_dir = os.path.join(tempfile.gettempdir(), \"maximal_square_c_backend\")\\n    src_path = os.path.join(build_dir, \"maximal_square_%s.c\" % key)\\n    so_path = os.path.join(build_dir, \"maximal_square_%s.so\" % key)\\n\\n    try:\\n        if not os.path.isdir(build_dir):\\n            os.makedirs(build_d"]
[201.167263, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n"]
