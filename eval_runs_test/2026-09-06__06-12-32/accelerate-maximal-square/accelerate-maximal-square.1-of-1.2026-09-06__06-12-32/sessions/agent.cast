[201.16814, "i", "re converted to uint8.  For valid binary input\\n            # this preserves the reference result while retaining native speed.\\n            arr2 = np.ascontiguousarray(arr, dtype=np.uint8)\\n            func, ptr_type = dispatch[np.dtype(np.uint8)]\\n        else:\\n            # For already C-contiguous common dtypes (including default int64),\\n            # this is zero-copy and avoids the conversion overhead entirely.\\n            arr2 = np.ascontiguousarray(arr)\\n            func, ptr_type = entry\\n        ptr = arr2.ctypes.data_as(ptr_type)\\n        result = func(ptr, int(rows), int(cols))\\n        if result >= 0:\\n            return int(result)\\n\\n    # Only used if gcc/shared-library loading fails or C allocation fails.\\n    return int(_python_fallback(np.ascontiguousarray(arr)))\\n\\n\\n__all__ = [\"maximal_square\"]\\n'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, 'w', encoding='utf-8', newline='\\n') as f:\n        f.write(content)\n    print(f"]
