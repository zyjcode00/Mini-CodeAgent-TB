[165.278042, "o", "                maxsqlen = max(maxsqlen, dp[j])\r\n> "]
[165.278161, "o", "            else:\r\n"]
[165.27828, "o", ">                 dp[j] = 0\r\n> "]
[165.278399, "o", "            prev = temp\r\n> "]
[165.278519, "o", "    return maxsqlen * maxsqlen\r\n> \r\n> "]
[165.278685, "o", "rng=np.random.RandomState(789)\r\n> "]
[165.278837, "o", "for dtype in [np.uint8, np.int64, np.bool_]:\r\n"]
[165.279, "o", "> "]
[165.279151, "o", "    mat=(rng.rand(1000,1000)<0.6).astype(dtype)\r\n> "]
[165.279277, "o", "    got=mod.maximal_square(mat)  # warmup\r\n> "]
[165.27951, "o", "    t0=time.perf_counter(); expected=ref(mat); tref=time.perf_counter()-t0\r\n> "]
[165.279619, "o", "    best=999\r\n> "]
[165.279743, "o", "    for _ in range(5):\r\n> "]
[165.280104, "o", "        t0=time.perf_counter(); got=mod.maximal_square(mat); best=min(best,time.perf_counter()-t0)\r\n"]
[165.280217, "o", "> "]
[165.280611, "o", "    print(dtype, 'expected', expected, 'got', got, 'ref', tref, 'best', best, 'speedup', tref/best)\r\n"]
[165.280655, "o", "> "]
[165.280771, "o", "PY\r\n"]
