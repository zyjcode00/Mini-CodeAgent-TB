[214.147234, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\nCUDA_VISIBLE_DEVICES=\"\" python3 /app/test_maximal_square.py && CUDA_VISIBLE_DEVICES=\"\" python3 - <<'PY'\nimport importlib.util, time\nimport numpy as np\n\nspec = importlib.util.spec_from_file_location('ms', '/app/maximal_square.py')\nmod = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(mod)\n\ndef ref(matrix):\n    rows = len(matrix)\n    cols = len(matrix[0]) if rows > 0 else 0\n    dp = [0] * (cols + 1)\n    maxsqlen = 0\n    prev = 0\n    for i in range(1, rows + 1):\n        for j in range(1, cols + 1):\n            temp = dp[j]\n            if matrix[i - 1, j - 1] == 1:\n                dp[j] = min(min(dp[j - 1], prev), dp[j]) + 1\n                maxsqlen = max(maxsqlen, dp[j])\n            else:\n                dp[j] = 0\n            prev = temp\n    return maxsqlen * maxsqlen\n\nrng=np.random.RandomState(789)\nfor dtype in [np.uint8, np.int64, np.bool_]:\n    mat=(rng.rand(1000,1000)<0.6).astype(dtype)\n    got=mod.maximal_square(mat)  # warmup / compile\n    "]
[214.147583, "i", "t0=time.perf_counter(); expected=ref(mat); tref=time.perf_counter()-t0\n    best=999\n    for _ in range(7):\n        t0=time.perf_counter(); got=mod.maximal_square(mat); best=min(best,time.perf_counter()-t0)\n    print(dtype, 'expected', expected, 'got', got, 'ref', tref, 'best', best, 'speedup', tref/best)\n    assert got == expected\n    assert tref / best > 100.0\nPY\ntrue; tmux wait -S done\r"]
[214.147906, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n"]
[214.148224, "o", "root@1ff060905968:/taichi-dev/taichi# "]
[214.148785, "o", "CUDA_VISIBLE_DEVICES=\"\" python3 /app/test_maximal_square.py && CUDA_VISIBLE_DEVICES=\"\" python3 - <<'PY'\r\n"]
[214.148956, "o", "> import importlib.util, time\r\n"]
[214.149016, "o", "> "]
[214.149085, "o", "import numpy as np\r\n"]
[214.149152, "o", "> \r\n"]
[214.149225, "o", "> "]
[214.149507, "o", "spec = importlib.util.spec_from_file_location('ms', '/app/maximal_square.py')\r\n"]
[214.149573, "o", "> "]
[214.149691, "o", "mod = importlib.util.module_from_spec(spec)\r\n> "]
[214.149797, "o", "spec.loader.exec_module(mod)\r\n"]
[214.149899, "o", "> \r\n> "]
[214.149996, "o", "def ref(matrix):"]
[214.150089, "o", "\r\n> "]
[214.150195, "o", "    rows = len(matrix)\r\n"]
[214.150299, "o", "> "]
[214.150403, "o", "    cols = len(matrix[0]) if rows > 0 else 0\r\n"]
[214.15048, "o", "> "]
[214.15059, "o", "    dp = [0] * (cols + 1)\r\n> "]
[214.150694, "o", "    maxsqlen = 0\r\n> "]
[214.150825, "o", "    prev = 0\r\n"]
[214.150868, "o", "> "]
[214.150985, "o", "    for i in range(1, rows + 1):\r\n> "]
[214.15133, "o", "        for j in range(1, cols + 1):\r\n> "]
[214.151444, "o", "            temp = dp[j]\r\n> "]
[214.151629, "o", "            if matrix[i - 1, j - 1] == 1:\r\n> "]
[214.151842, "o", "                dp[j] = min(min(dp[j - 1], prev), dp[j]) + 1\r\n> "]
[214.152065, "o", "                maxsqlen = max(maxsqlen, dp[j])\r\n> "]
[214.152202, "o", "            else:\r\n> "]
[214.152294, "o", "                dp[j] = 0\r\n"]
[214.152388, "o", ">             prev = temp\r\n> "]
[214.152525, "o", "    return maxsqlen * maxsqlen\r\n"]
[214.15264, "o", "> \r\n> "]
[214.152712, "o", "rng=np.random.RandomState(789)\r\n> "]
[214.152875, "o", "for dtype in [np.uint8, np.int64, np.bool_]:\r\n> "]
[214.153055, "o", "    mat=(rng.rand(1000,1000)<0.6).astype(dtype)\r\n> "]
[214.153249, "o", "    got=mod.maximal_square(mat)  # warmup / compile\r\n> "]
[214.153504, "o", "    t0=time.perf_counter(); expected=ref(mat); tref=time.perf_counter()-t0\r\n"]
[214.153593, "o", "> "]
[214.153672, "o", "    best=999\r\n> "]
[214.153782, "o", "    for _ in range(7):\r\n> "]
[214.153988, "o", "        t0=time.perf_counter(); got=mod.maximal_square(mat); best=min(best,time.perf_counter()-t0)\r\n"]
[214.154052, "o", "> "]
[214.15433, "o", "    print(dtype, 'expected', expected, 'got', got, 'ref', tref, 'best', best, 'speedup', tref/best)\r\n> "]
[214.154458, "o", "    assert got == expected"]
[214.154525, "o", "\r\n"]
[214.154597, "o", "> "]
[214.154725, "o", "    assert tref / best > 100.0\r\n> PY\r\n"]
