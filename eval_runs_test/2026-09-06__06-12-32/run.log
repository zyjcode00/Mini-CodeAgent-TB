candidate(mat)\\n        assert isinstance(got, (int, np.integer)), "result is not integer-like"\\n        assert int(got) == expected, "case %d: got %r expected %r" % (idx, got, expected)\\n\\n\\ndef test_performance_smoke():\\n    candidate = load_candidate()\\n    rng = np.random.RandomState(456)\\n    mat = (rng.rand(700, 700) < 0.58).astype(np.uint8)\\n\\n    # Warm up import-time C compilation and any dynamic loader work.\\n    assert candidate(mat) == reference_maximal_square(mat)\\n\\n    t0 = time.perf_counter()\\n    ref = reference_maximal_square(mat)\\n    t_ref = time.perf_counter() - t0\\n\\n    best = 1e100\\n    got = None\\n    for _ in range(5):\\n        t0 = time.perf_counter()\\n        got = candidate(mat)\\n        best = min(best, time.perf_counter() - t0)\\n\\n    assert got == ref\\n    speedup = t_ref / best if best > 0 else float("inf")\\n    print("reference %.6fs candidate_best %.6fs speedup %.1fx" % (t_ref, best, speedup))\\n    # Conservative CI/local smoke threshold; the user-facing target is tested on\\n    # larger warm workloads, where call overhead is negligible.\\n    assert speedup > 20.0\\n\\n\\nif __name__ == "__main__":\\n    test_correctness()\\n    test_performance_smoke()\\n    print("OK")\\n\'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, \'w\', encoding=\'utf-8\', newline=\'\\n\') as f:\n        f.write(content)\n    print(f"成功: 已写入 {path}")\nexcept Exception as exc:\n    print(f"写入失败: {exc}")\nPY\ntrue', '; tmux wait -S done', 'Enter'] min_timeout_sec: 0.0 max_timeout_sec: 300.0
