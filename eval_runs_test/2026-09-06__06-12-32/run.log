LIB = None\\n_COMPILE_ERROR = None\\n\\n\\ndef _compile_and_load_backend():\\n    """Build and load the tiny C backend, caching it in the temp directory."""\\n    global _COMPILE_ERROR\\n\\n    key = hashlib.sha256(_C_SOURCE.encode("utf-8")).hexdigest()[:16]\\n    build_dir = os.path.join(tempfile.gettempdir(), "maximal_square_c_backend")\\n    src_path = os.path.join(build_dir, "maximal_square_%s.c" % key)\\n    so_path = os.path.join(build_dir, "maximal_square_%s.so" % key)\\n\\n    try:\\n        if not os.path.isdir(build_dir):\\n            os.makedirs(build_dir)\\n        if not os.path.exists(so_path):\\n            with open(src_path, "w") as f:\\n                f.write(_C_SOURCE)\\n            cmd = [\\n                "gcc", "-O3", "-march=native", "-std=c99", "-shared", "-fPIC",\\n                src_path, "-o", so_path,\\n            ]\\n            subprocess.check_call(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\\n\\n        lib = ctypes.CDLL(so_path)\\n        func = lib.maximal_square_u8\\n        func.argtypes = [\\n            ctypes.POINTER(ctypes.c_uint8),\\n            ctypes.c_longlong,\\n            ctypes.c_longlong,\\n        ]\\n        func.restype = ctypes.c_longlong\\n        return lib\\n    except Exception as exc:  # pragma: no cover - fallback path is environment dependent\\n        _COMPILE_ERROR = exc\\n        return None\\n\\n\\ndef _python_fallback(matrix):\\n    """Reference-equivalent fallback used only if a C compiler is unavailable."""\\n    rows = len(matrix)\\n    cols = len(matrix[0]) if rows > 0 else 0\\n    dp = [0] * (cols + 1)\\n    maxsqlen = 0\\n    for i in range(1, rows + 1):\\n        prev = 0\\n        for j in range(1, cols + 1):\\n            temp = dp[j]\\n            if matrix[i - 1, j - 1] == 1:\\n                v = min(dp[j - 1], prev, dp[j]) + 1\\n                dp[j] = v\\n                if v > maxsqlen:\\n                    maxsqlen = v\\n            else:\\n                dp[j] = 0\\n            prev = temp\\n    return maxsqlen * maxsqlen\\n\\n\\ndef maximal_square(matrix: np.ndarray) -> int:\\n    """Return the area of the largest all-1 square in a binary NumPy array.\\n\\n    Parameters\\n    ----------\\n    matrix : np.ndarray\\n        Two-dimensional array containing only 0s and 1s.  Non-zero values are\\n        treated as 1 by the accelerated backend, which is equivalent for valid\\n        binary inputs.\\n\\n    Returns\\n    -------\\n    int\\n        Area of the largest square containing only 1s.\\n    """\\n    arr = np.asarray(matrix)\\n    if arr.ndim != 2:\\n        raise ValueError("matrix must be a 2-dimensional numpy ndarray")\\n\\n    rows, cols = arr.shape\\n    if rows == 0 or cols == 0:\\n        return 0\\n\\n    # The C kernel is specialized for dense uint8 row-major input.  For the\\n    # expected large binary matrices this copy/conversion is tiny compared with\\n    # eliminating ~1,000,000 Python-loop iterations per call.\\n    arr_u8 = np.ascontiguousarray(arr, dtype=np.uint8)\\n\\n    global _LIB\\n    if _LIB is None:\\n        _LIB = _compile_and_load_backend()\\n\\n    if _LIB is not None:\\n        ptr = arr_u8.ctypes.data_as(ctypes.POINTER(ctypes.c_uint8))\\n        result = _LIB.maximal_square_u8(ptr, int(rows), int(cols))\\n        if result >= 0:\\n            return int(result)\\n        # Allocation failure inside the C routine is very unlikely; fall back to\\n        # the Python implementation rather than returning an invalid value.\\n\\n    return int(_python_fallback(arr_u8))\\n\\n\\n__all__ = ["maximal_square"]\\n\'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, \'w\', encoding=\'utf-8\', newline=\'\\n\') as f:\n        f.write(content)\n    print(f"成功: 已写入 {path}")\nexcept Exception as exc:\n    print(f"写入失败: {exc}")\nPY\ntrue', '; tmux wait -S done', 'Enter'] min_timeout_sec: 0.0 max_timeout_sec: 300.0
