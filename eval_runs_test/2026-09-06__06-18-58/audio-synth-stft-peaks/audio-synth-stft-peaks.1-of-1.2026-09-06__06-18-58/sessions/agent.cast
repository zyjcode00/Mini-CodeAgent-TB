[87.768885, "o", "    with open(path, 'w', encoding='utf-8', newline='\\n') as f:\r\n\u001b[?2004l\r"]
[87.769033, "o", "\u001b[?2004h>         f.write(content)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.769253, "o", "    print(f\"成功: 已写入 {path}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.769451, "o", "> except Exception as exc:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.769565, "o", "    print(f\"写入失败: {exc}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.769711, "o", "PY\r\n\u001b[?2004l\r"]
[87.782239, "o", "成功: 已写入 /app/solution.sh\r\n"]
