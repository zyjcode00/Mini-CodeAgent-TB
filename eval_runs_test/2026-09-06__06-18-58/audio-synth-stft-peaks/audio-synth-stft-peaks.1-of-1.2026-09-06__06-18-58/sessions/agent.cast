[135.776493, "o", "content = 'import csv\\nimport os\\nimport subprocess\\nimport time\\nfrom pathlib import Path\\n\\nimport numpy as np\\nimport pytest\\nfrom scipy.io import wavfile\\nfrom scipy.signal import stft\\n\\nAPP_DIR = Path(\"/app\")\\nDATA_DIR = APP_DIR / \"data\"\\nWAV_PATH = DATA_DIR / \"clip.wav\"\\nMAG_PATH = DATA_DIR / \"mag.csv\"\\nPEAKS_PATH = DATA_DIR / \"peaks.csv\"\\nSOLUTION_PATH = APP_DIR / \"solution.sh\"\\n\\nFS = 16_000\\nN_SAMPLES = 48_000\\nNPERSEG = 1024\\nNOVERLAP = 768\\nNFFT = 1024\\nHOP = NPERSEG - NOVERLAP\\nEXPECTED_FRAMES = 1 + (N_SAMPLES - NPERSEG) // HOP\\nEXPECTED_BINS = NFFT // 2 + 1\\nEXPECTED_MAG_ROWS = EXPECTED_FRAMES * EXPECTED_BINS\\n\\n\\n@pytest.fixture(scope=\"session\", autouse=True)\\ndef run_pipeline_once():\\n    subprocess.run([\"bash\", str(SOLUTION_PATH)], check=True, cwd=str(APP_DIR))\\n\\n\\ndef read_mag_rows():\\n    with MAG_PATH.open(newline=\"\") as f:\\n        reader = csv.DictReader(f)\\n        rows = list(reader)\\n    return rows\\n\\n\\ndef test_solution_script_uses_awk_for_peaks_and_supports_peaks_only():\\n    text = SOLUTION_PATH.read_text()\\n    assert \"PEAKS_ONLY\" in text\\n    assert \"awk\" in text\\n    assert \"/usr/bin/awk\" not in text\\n    assert \"/bin/awk\" not in text\\n    assert \"peaks.csv\" not in (APP_DIR / \"audioproc.py\").read_text()\\n\\n\\ndef test_wav_is_mono_16khz_three_seconds_int16_and_rms_normalized():\\n    sample_rate, data = wavfile.read(WAV_PATH)\\n    assert sample_rate == FS\\n    assert data.dtype == np.int16\\n    assert data.ndim == 1\\n    assert data.shape == (N_SAMPLES,)\\n\\n    as_float = data.astype(np.float64) / 32767.0\\n    rms = float(np.sqrt(np.mean(as_float * as_float)))\\n    assert 0.198 <= rms <= 0.202\\n    assert np.max(np.abs(as_float)) <= 1.0\\n\\n\\ndef test_mag_csv_schema_shape_order_and_values_match_scipy_stft():\\n    rows = read_mag_rows()\\n    assert rows\\n    assert set(rows[0].keys()) == {\"frame\", \"bin\", \"val\"}\\n    assert len(rows) == EXPECTED_MAG_ROWS\\n\\n    frames = np.array([int(r[\"frame\"]) for r in rows], dtype=np.int64)\\n    bins = np.array([int(r[\"bin\"]) for r in rows], dtype=np.int64)\\n    vals = np.array([float(r[\"val\"]) for r in rows], dtype=np.float64)\\n\\n    expected_frames = np.repeat(np.arange(EXPECTED_FRAMES), EXPECTED_BINS)\\n    expected_bins = np.tile(np.arange(EXPECTED_BINS), EXPECTED_FRAMES)\\n    np.testing.assert_array_equal(frames, expected_frames)\\n    np.testing.assert_array_equal(bins, expected_bins)\\n    assert np.all(vals >= 0.0)\\n    assert np.any(vals > 0.0)\\n\\n    _, wav_data = wavfile.read(WAV_PATH)\\n    signal = wav_data.astype(np.float64) / 32767.0\\n    _, _, zxx = stft(\\n        signal,\\n        fs=FS,\\n        nperseg=NPERSEG,\\n        noverlap=NOVERLAP,\\n        nfft=NFFT,\\n        window=\"hann\",\\n        boundary=None,\\n        padded=False,\\n        return_onesided=True,\\n    )\\n    expected = np.abs(zxx).T.reshape(-1)\\n    np.testing.assert_allclose(vals, expected, rtol=1e-12, atol=1e-15)\\n\\n\\ndef expected_peak_rows_from_mag():\\n    rows = read_mag_rows()\\n    by_frame = {}\\n    for r in rows:\\n        frame = int(r[\"frame\"])\\n        by_frame.setdefault(frame, []).append((float(r[\"val\"]), int(r[\"bin\"])))\\n\\n    expected = []\\n    for frame in range(EXPECTED_FRAMES):\\n        top3 = sorted(by_frame[frame], key=lambda item: (-item[0], item[1]))[:3]\\n        expected.append((frame, top3[0][1], top3[1][1], top3[2][1]))\\n    return expected\\n\\n\\ndef read_peak_rows():\\n    with PEAKS_PATH.open(newline=\"\") as f:\\n        reader = csv.DictReader(f)\\n        return [\\n            (int(r[\"frame\"]), int(r[\"f1_bin\"]), int(r[\"f2_bin\"]), int(r[\"f3_bin\"]))\\n            for r in reader\\n        ]\\n\\n\\ndef test_peaks_csv_has_true_top3_bins_per_frame_descending():\\n    with PEAKS_PATH.open(newline=\"\") as f:\\n        header = f.readline().strip()\\n    assert header == \"frame,f1_bin,f2_bin,f3_bin\"\\n\\n    peak_rows = read_peak_rows()\\n    expected_rows = expected_peak_rows_from_mag()\\n    assert peak_rows == expected_rows\\n    assert len(peak_rows) == EXPECTED_FRAMES\\n\\n\\ndef test_peaks_only_regenerates_peaks_without_rebuilding_wav_or_mag():\\n    expected_rows = expected_pea"]
