[?2004l[?2004h> content = '#!/usr/bin/env bash\nset -euo pipefail\n\nAPP_DIR="/app"\nDATA_DIR="$APP_DIR/data"\nMAG_CSV="$DATA_DIR/mag.csv"\nPEAKS_CSV="$DATA_DIR/peaks.csv"\n\nmkdir -p "$DATA_DIR"\n\nmake_peaks() {\n  awk -F, \'\n    BEGIN {\n      OFS=",";\n      print "frame","f1_bin","f2_bin","f3_bin";\n    }\n    NR == 1 {\n      next;\n    }\n    {\n      frame = $1 + 0;\n      bin = $2 + 0;\n      val = $3 + 0.0;\n\n      if (!(frame in seen)) {\n        seen[frame] = 1;\n        order[++nframes] = frame;\n        b1[frame] = b2[frame] = b3[frame] = -1;\n        v1[frame] = v2[frame] = v3[frame] = -1;\n      }\n\n      if (val > v1[frame] || (val == v1[frame] && bin < b1[frame])) {\n        v3[frame] = v2[frame]; b3[frame] = b2[frame];\n        v2[frame] = v1[frame]; b2[frame] = b1[frame];\n        v1[frame] = val;       b1[frame] = bin;\n      } else if (val > v2[frame] || (val == v2[frame] && bin < b2[frame])) {\n        v3[frame] = v2[frame]; b3[frame] = b2[frame];\n        v2[frame] = val;       b2[frame] = bin;\n      } else if (val > v3[frame] || (val == v3[frame] && bin < b3[frame])) {\n        v3[frame] = val;       b3[frame] = bin;\n      }\n    }\n    END {\n      for (i = 1; i <= nframes; i++) {\n        frame = order[i];\n        print frame, b1[frame], b2[frame], b3[frame];\n      }\n    }\n  \' "$MAG_CSV" > "$PEAKS_CSV"\n}\n\nif [[ "${PEAKS_ONLY:-0}" == "1" ]]; then\n  make_peaks\n  exit 0\nfi\n\npython3 "$APP_DIR/audioproc.py"\nmake_peaks\n'
