Sending keys: ['export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/audioproc.py <<\'PY\'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = \'#!/usr/bin/env python3\\n"""Synthesize a short WAV clip and export its STFT magnitudes.\\n\\nOutputs created by this script:\\n  - /app/data/clip.wav   (mono 16 kHz PCM int16, exactly 3 seconds)\\n  - /app/data/mag.csv    (frame,bin,val linear STFT magnitudes)\\n\\nThis script intentionally does not create peaks.csv; that is generated by\\n/app/solution.sh using awk.\\n"""\\n\\nfrom __future__ import annotations\\n\\nimport csv\\nfrom pathlib import Path\\n\\nimport numpy as np\\nfrom scipy.io import wavfile\\nfrom scipy.signal import stft\\n\\nFS = 16_000\\nDURATION_SECONDS = 3.0\\nN_SAMPLES = int(FS * DURATION_SECONDS)\\nFREQUENCIES_HZ = np.array([220, 330, 440, 550, 660], dtype=np.float64)\\nTARGET_RMS = 0.2\\nDATA_DIR = Path("/app/data")\\nWAV_PATH = DATA_DIR / "clip.wav"\\nMAG_PATH = DATA_DIR / "mag.csv"\\n\\n\\ndef synthesize() -> np.ndarray:\\n    """Return the RMS-normalized dithered signal as float64 samples."""\\n    t = np.arange(N_SAMPLES, dtype=np.float64) / FS\\n    signal = np.sin(2.0 * np.pi * FREQUENCIES_HZ[:, None] * t).sum(axis=0)\\n\\n    # Deterministic dither keeps the pipeline reproducible while satisfying the\\n    # required uniform distribution interval.\\n    rng = np.random.default_rng(seed=0)\\n    dither = rng.uniform(-1e-4, 1e-4, size=N_SAMPLES)\\n    signal = signal + dither\\n\\n    rms = float(np.sqrt(np.mean(signal * signal)))\\n    if rms == 0.0:\\n        raise RuntimeError("cannot normalize a silent signal")\\n    return signal * (TARGET_RMS / rms)\\n\\n\\ndef quantize_to_int16(signal: np.ndarray) -> np.ndarray:\\n    """Quantize normalized floating-point samples to PCM int16."""\\n    scaled = np.rint(np.clip(signal, -1.0, 1.0) * 32767.0)\\n    return scaled.astype(np.int16)\\n\\n\\ndef write_stft_magnitude(signal_for_stft: np.ndarray) -> None:\\n    """Compute scipy STFT and write one magnitude row per frame/bin."""\\n    freqs, times, zxx = stft(\\n        signal_for_stft,\\n        fs=FS,\\n        nperseg=1024,\\n        noverlap=768,\\n        nfft=1024,\\n        window="hann",\\n        boundary=None,\\n        padded=False,\\n        return_onesided=True,\\n    )\\n    del freqs, times\\n\\n    magnitudes = np.abs(zxx)\\n    with MAG_PATH.open("w", newline="") as f:\\n        writer = csv.writer(f)\\n        writer.writerow(["frame", "bin", "val"])\\n        for frame_idx in range(magnitudes.shape[1]):\\n            for bin_idx in range(magnitudes.shape[0]):\\n                writer.writerow([frame_idx, bin_idx, f"{magnitudes[bin_idx, frame_idx]:.17g}"])\\n\\n\\ndef main() -> None:\\n    DATA_DIR.mkdir(parents=True, exist_ok=True)\\n    signal = synthesize()\\n    pcm = quantize_to_int16(signal)\\n    wavfile.write(WAV_PATH, FS, pcm)\\n\\n    # Use the quantized waveform for STFT so mag.csv exactly corresponds to the\\n    # saved WAV contents.\\n    signal_for_stft = pcm.astype(np.float64) / 32767.0\\n    write_stft_magnitude(signal_for_stft)\\n\\n\\nif __name__ == "__main__":\\n    main()\\n\'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, \'w\', encoding=\'utf-8\', newline=\'\\n\') as f:\n        f.write(content)\n    print(f"成功: 已写入 {path}")\nexcept Exception as exc:\n    print(f"写入失败: {exc}")\nPY\ntrue', '; tmux wait -S done', 'Enter'] min_timeout_sec: 0.0 max_timeout_sec: 300.0
