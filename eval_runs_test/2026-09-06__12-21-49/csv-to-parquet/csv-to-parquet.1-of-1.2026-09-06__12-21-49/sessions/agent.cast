[565.310555, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/test_data_parquet.py <<'PY'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = 'import csv\\nfrom pathlib import Path\\n\\nimport pyarrow.parquet as pq\\n\\n\\nCSV_PATH = Path(\"/app/data.csv\")\\nPARQUET_PATH = Path(\"/app/data.parquet\")\\nEXPECTED_COLUMNS = [\"name\", \"age\", \"city\"]\\n\\n\\ndef test_parquet_matches_csv() -> None:\\n    assert CSV_PATH.is_file(), f\"Missing source CSV: {CSV_PATH}\"\\n    assert PARQUET_PATH.is_file(), f\"Missing Parquet output: {PARQUET_PATH}\"\\n\\n    with CSV_PATH.open(newline=\"\", encoding=\"utf-8\") as source:\\n        csv_rows = list(csv.DictReader(source))\\n\\n    table = pq.read_table(PARQUET_PATH)\\n    assert table.column_names == EXPECTED_COLUMNS\\n    assert table.num_rows == len(csv_rows)\\n    assert table.schema.field(\"name\").type == \"string\"\\n    assert table.schema.field(\"age\").type == \"int64\"\\n    assert table.schema.field(\"city\").type == \"string\"\\n\\n    expected_rows = [\\n        {\"name\": row[\"name\"], \"age\": int(row[\"age\"]), \"city\": row[\"city\"]}\\n        for row in csv_rows\\n    ]\\n    assert table.to_pylist() == expected_rows\\n'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, 'w', encoding='utf-8', newline='\\n') as f:\n        f.write(content)\n    print(f\"成功: 已写入 {path}\")\nexcept Exception as exc:\n    print(f\"写入失败: {exc}\")\nPY\ntrue; tmux wait -S done\r"]
[565.31127, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
[565.311486, "o", "\u001b[?2004hroot@155e32b73c9d:/app# "]
[565.311696, "o", "python3 - /app/test_data_parquet.py <<'PY'\r\n\u001b[?2004l\r"]
[565.311847, "o", "\u001b[?2004h> "]
[565.311956, "o", "import os\r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r"]
[565.312215, "o", "\u001b[?2004h> path = sys.argv[1]\r\n\u001b[?2004l\r"]
[565.312372, "o", "\u001b[?2004h> "]
[565.316388, "o", "content = 'import csv\\nfrom pathlib import Path\\n\\nimport pyarrow.parquet as pq\\n\\n\\nCSV_PATH = Path(\"/app/data.csv\")\\nPARQUET_PATH = Path(\"/app/data.parquet\")\\nEXPECTED_COLUMNS = [\"name\", \"age\", \"city\"]\\n\\n\\ndef test_parquet_matches_csv() -> None:\\n    assert CSV_PATH.is_file(), f\"Missing source CSV: {CSV_PATH}\"\\n    assert PARQUET_PATH.is_file(), f\"Missing Parquet output: {PARQUET_PATH}\"\\n\\n    with CSV_PATH.open(newline=\"\", encoding=\"utf-8\") as source:\\n        csv_rows = list(csv.DictReader(source))\\n\\n    table = pq.read_table(PARQUET_PATH)\\n    assert table.column_names == EXPECTED_COLUMNS\\n    assert table.num_rows == len(csv_rows)\\n    assert table.schema.field(\"name\").type == \"string\"\\n    assert table.schema.field(\"age\").type == \"int64\"\\n    assert table.schema.field(\"city\").type == \"string\"\\n\\n    expected_rows = [\\n        {\"name\": row[\"name\"], \"age\": int(row[\"age\"]), \"city\": row[\"city\"]}\\n        for row in csv_rows\\n    ]\\n    assert table.to_pylist() == expected_rows\\n'\r\n\u001b[?2004l\r"]
[565.316673, "o", "\u001b[?2004h> dir_path = os.path.dirname(path)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[565.316878, "o", "if dir_path:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[565.317147, "o", "    os.makedirs(dir_path, exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h> try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[565.317314, "o", "    with open(path, 'w', encoding='utf-8', newline='\\n') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[565.317532, "o", "        f.write(content)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[565.317806, "o", "    print(f\"成功: 已写入 {path}\")\r\n\u001b[?2004l\r"]
[565.318001, "o", "\u001b[?2004h> "]
[565.318203, "o", "except Exception as exc:\r\n\u001b[?2004l\r"]
[565.318412, "o", "\u001b[?2004h> "]
[565.318637, "o", "    print(f\"写入失败: {exc}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
