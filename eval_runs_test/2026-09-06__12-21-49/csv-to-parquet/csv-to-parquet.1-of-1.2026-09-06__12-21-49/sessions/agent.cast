[192.698701, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\napt-get update -qq && apt-get install -y -qq python3-pip && python3 -m pip install --quiet --break-system-packages pyarrow && python3 - <<'PY'\nimport csv\nfrom pathlib import Path\nimport pyarrow.csv as pacsv\nimport pyarrow.parquet as pq\nsrc=Path('/app/data.csv')\ndst=Path('/app/data.parquet')\ntable=pacsv.read_csv(src)\npq.write_table(table, dst)\nprint('written', dst)\nprint('schema:', table.schema)\nprint('rows:', table.num_rows, 'columns:', table.num_columns)\nprint('size:', dst.stat().st_size)\nPY\nls -l /app/data.parquet\ntrue; tmux wait -S done\r"]
