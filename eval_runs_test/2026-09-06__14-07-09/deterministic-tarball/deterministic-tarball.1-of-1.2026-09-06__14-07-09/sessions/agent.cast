[847.02597, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\ncd /app && python3 - <<'PY'\nimport hashlib\nimport importlib\nimport os\nfrom pathlib import Path\nm = importlib.import_module('test_build')\nfor name in sorted(n for n in dir(m) if n.startswith('test_')):\n    print(f'RUN {name}', flush=True)\n    getattr(m, name)()\n    print(f'PASS {name}', flush=True)\n\nbuild = Path('/app/build.sh')\nenv = os.environ.copy()\nenv['SOURCE_DATE_EPOCH'] = '1700000000'\nimport subprocess\nsubprocess.run([str(build)], cwd='/app', env=env, check=True)\na = Path('/app/release.tar.zst').read_bytes()\nsubprocess.run([str(build)], cwd='/app', env=env, check=True)\nb = Path('/app/release.tar.zst').read_bytes()\nassert hashlib.sha256(a).digest() == hashlib.sha256(b).digest()\nprint('PASS reproducible sha256', hashlib.sha256(a).hexdigest())\nPY\ntrue; tmux wait -S done\r"]
