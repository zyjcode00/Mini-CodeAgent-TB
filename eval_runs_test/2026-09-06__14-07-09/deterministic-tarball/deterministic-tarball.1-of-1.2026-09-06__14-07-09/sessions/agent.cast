[448.130361, "o", "drwxr-xr-x /app/src/.git/objects -> \r\ndrwxr-xr-x /app/src/assets -> \r\ndrwxr-xr-x /app/src/deeply -> \r\ndrwxr-xr-x /app/src/deeply/nested -> \r\ndrwxr-xr-x /app/src/deeply/nested/nested -> \r\ndrwxr-xr-x /app/src/docs -> \r\ndrwxr-xr-x /app/src/keys -> \r\ndrwxr-xr-x /app/src/node_modules -> \r\ndrwxr-xr-x /app/src/node_modules/package1 -> \r\ndrwxr-xr-x /app/src/secrets -> \r\ndrwxr-xr-x /app/src/src -> \r\ndrwxr-xr-x /app/src/src/__pycache__ -> \r\ndrwxr-xr-x /app/src/tmp -> \r\nlrwxrwxrwx /app/src/src/README -> ../docs/README.txt\r\nlrwxrwxrwx /app/src/src/passwd-link -> /etc/passwd\r\n"]
