[448.267472, "o", "#!/usr/bin/env bash\r\nset -euo pipefail\r\n\r\nSRC_DIR=\"/app/src\"\r\nOUT_FILE=\"/app/release.tar.zst\"\r\n\r\npython3 - \"$SRC_DIR\" \"$OUT_FILE\" <<'PY'\r\nimport os\r\nimport stat\r\nimport subprocess\r\nimport sys\r\nimport tempfile\r\nfrom pathlib import Path\r\n\r\nsrc_dir = Path(sys.argv[1]).resolve()\r\nout_file = Path(sys.argv[2]).resolve()\r\nepoch = int(os.environ.get(\"SOURCE_DATE_EPOCH\", \"946684800\"))\r\n\r\nexcluded_dirs = {\".git\", \"node_modules\", \"tmp\", \".cache\", \"__pycache__\"}\r\nexcluded_suffixes = (\".tmp\", \".pyc\", \".o\")\r\ntext_extensions = {\r\n    \".txt\", \".md\", \".py\", \".sh\", \".c\", \".h\", \".js\",\r\n    \".css\", \".html\", \".xml\", \".json\", \".yaml\", \".yml\",\r\n}\r\n\r\nif not src_dir.is_dir():\r\n    raise SystemExit(f\"source directory not found: {src_dir}\")\r\n\r\n\r\ndef is_excluded_path(rel: Path) -> bool:\r\n    return any(part in excluded_dirs for part in rel.parts)\r\n\r\n\r\ndef is_text_file(path: Path) -> bool:\r\n    suffix = path.suffix.lower()\r\n    if suffix in text_extensions:\r\n        return True\r\n    try:\r\n        mime = subprocess.check_output(\r\n            [\"file\", \"--mime-type\", \"-b\", str(path)],\r\n            text=True,\r\n        ).strip()\r\n    except Exception:\r\n        return False\r\n    return mime.startswith(\"text/\")\r\n\r\n\r\ndef should_exclude_file(src_path: Path, rel: Path, st: os.stat_result) -> bool:\r\n    if is_excluded_path(rel.parent):\r\n        return True\r\n    if rel.name.endswith(excluded_suffixes):\r\n        return True\r\n    if stat.S_ISREG(st.st_mode) and stat.S_IMODE(st.st_mode) == 0o600:\r\n        return True\r\n    return False\r\n\r\n\r\ndef normalize_text(data: bytes) -> bytes:\r\n    return data.replace(b\"\\r\\n\", b\"\\n\").replace(b\"\\r\", b\"\\n\")\r\n\r\n\r\nwith tempfile.TemporaryDirectory(prefix=\"deterministic-build-\") as tmp:\r\n    stage = Path(tmp) / \"stage\"\r\n    stage.mkdir(mode=0o755)\r\n\r\n    # First pass: create directory skeleton in sorted order.\r\n    for root, dirs, files in os.walk(src_dir, topdown=True, followlinks=False):\r\n        root_path = Path(root)\r\n        rel_root = root_path.relative_to(src_dir)\r\n        dirs[:] = sorted(d for d in dirs if d not in excluded_dirs)\r\n        (stage / rel_root).mkdir(parents=True, exist_ok=True)\r\n        os.chmod(stage / rel_root, 0o755)\r\n        for d in dirs:\r\n            (stage / rel_root / d).mkdir(parents=True, exist_ok=True)\r\n            os.chmod(stage / rel_root / d, 0o755)\r\n\r\n    # Second pass: populate files and symlinks.\r\n    for root, dirs, files in os.walk(src_dir, topdown=True, followlinks=False):\r\n        root_path = Path(root)\r\n        rel_root = root_path.relative_to(src_dir)\r\n        dirs[:] = sorted(d for d in dirs if d not in excluded_dirs)\r\n        for name in sorted(files):\r\n            src_path = root_path / name\r\n            rel_path = src_path.relative_to(src_dir)\r\n            st = os.lstat(src_path)\r\n\r\n            if should_exclude_file(src_path, rel_path, st):\r\n                continue\r\n\r\n            dst_path = stage / rel_path\r\n            dst_path.parent.mkdir(parents=True, exist_ok=True)\r\n\r\n            if stat.S_ISLNK(st.st_mode):\r\n                os.symlink(os.readlink(src_path), dst_path)\r\n                continue\r\n\r\n            if not stat.S_ISREG(st.st_mode):\r\n                continue\r\n\r\n            data = src_path.read_bytes()\r\n            mode = 0o755 if (data.startswith(b\"#!\") or (st.st_mode & stat.S_IXUSR)) else 0o644\r\n            if is_text_file(src_path):\r\n                data = normalize_text(data)\r\n            dst_path.write_bytes(data)\r\n            os.chmod(dst_path, mode)\r\n\r\n    # Normalize timestamps and directory modes.\r\n    for path in sorted(stage.rglob(\"*\"), key=lambda p: (len(p.parts), str(p))):\r\n        try:\r\n            os.utime(path, (epoch, epoch), follow_symlinks=False)\r\n        except Exception:\r\n            pass\r\n        if path.is_dir():\r\n            os.chmod(path, 0o755)\r\n        elif path.is_file():\r\n            current = path.stat().st_mode\r\n            os.chmod(path, 0o755 if (current & stat.S_IXUSR) else 0o644)\r\n\r\n    os.utime(stage, (epoch, epoch))\r\n    os.chmod(stage, 0o755)\r\n\r\n    if out_file.exists():\r\n        out_file.unlink()\r\n\r\n    tar_cmd = [\r\n        \"tar\",\r\n        \"--format=gnu\",\r\n        \"--sort=name\",\r\n        \"--numeric-owner\",\r\n        \"--owner=0\",\r\n        \"--group=0\",\r\n        f\"--mtime=@{epoch}\",\r\n        \"-C\",\r\n        str(stage),\r\n        \"-cf\",\r\n        \"-\",\r\n        \".\",\r\n    ]\r\n    zstd_cmd = [\r\n        \"zstd\",\r\n        \"-19\",\r\n        \"--long\",\r\n        \"--no-check\",\r\n        \"--single-thread\",\r\n        \"-c\",\r\n    ]\r\n\r\n    env = os.environ.copy()\r\n    env[\"LC_ALL\"] = \"C\"\r\n    env[\"LANG\"] = \"C\"\r\n    env[\"TZ\"] = \"UTC\"\r\n\r\n    with open(out_file, \"wb\") as fh:\r\n        tar_proc = subprocess.Popen(tar_cmd, stdout=subprocess.PIPE, env=env)\r\n        assert tar_proc.stdout is not None\r\n        try:\r\n            zstd_proc = subprocess.Popen(zstd_cmd, stdin=tar_proc.stdout, stdout=fh, env=env)\r\n        finally:\r\n            tar_proc.stdout.close()\r\n        zstd_rc = zstd_proc.wait()\r\n"]
[448.267711, "o", "        tar_rc = tar_proc.wait()\r\n        if tar_rc != 0:\r\n            raise SystemExit(tar_rc)\r\n        if zstd_rc != 0:\r\n            raise SystemExit(zstd_rc)\r\nPY\r\n"]
[448.269853, "o", "\u001b[?2004hroot@4a96cfd8034b:/app# "]
