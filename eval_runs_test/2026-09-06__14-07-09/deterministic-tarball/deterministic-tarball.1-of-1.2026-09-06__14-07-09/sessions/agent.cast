[467.801083, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/test_build.py <<'PY'\nimport sys\npath = sys.argv[1]\nold_str = \"            assert 'src/src/windows.py' in members\\n            assert 'src/src/readonly.txt' not in members\\n            assert 'src/src/main.o' not in members\\n            assert 'src/tmp/test.tmp' not in members\\n            assert 'src/keys/private.key' not in members\\n            assert 'src/secrets/db.conf' not in members\\n            assert 'src/src/passwd-link' in members\\n\\n            for member in tf.getmembers():\"\nnew_str = \"            assert './src/windows.py' in members\\n            assert './src/readonly.txt' not in members\\n            assert './src/main.o' not in members\\n            assert './tmp/test.tmp' not in members\\n            assert './keys/private.key' not in members\\n            assert './secrets/db.conf' not in members\\n            assert './src/passwd-link' in members\\n\\n            for member in tf.getmembers():\"\n\ndef normalize_text(text: str) -> str:\n    text = text.replace('\\r\\n', '\\n').replace('\\r', '\\n')\n    return '\\n'.join(line.rstrip() for line in text.split('\\n'))\n\ntry:\n    with open(path, 'r', encoding='utf-8', errors='replace') as f:\n        content = f.read()\nexcept FileNotFoundError:\n    print(f\"错误: 找不到文件 {path}\")\n    raise SystemExit(0)\nexcept Exception as exc:\n    print(f\"修改失败: {exc}\")\n    raise SystemExit(0)\n\ncontent = normalize_text(content)\nold_str = normalize_text(old_str)\nnew_str = normalize_text(new_str)\ncount = content.count(old_str)\nif count == 0:\n    print(\"错误: 在文件中找不到 old_str。\\n建议：\\n1. 使用 read_file(raw_mode=True) 获取原始内容\\n2. 检查是否有多余的空格或换行符\\n3. 如果文件较大，考虑使用 write_full_file 全量覆盖\")\n    raise SystemExit(0)\nif count > 1:\n    print(f\"错误: 匹配到 {count} 处相同的代码，请提供更具体的 old_str 以确保唯一性。\")\n    raise SystemExit(0)\nwith open(path, 'w', encoding='utf-8', newline='\\n') as f:\n    f.write(content.replace(old_str, new_str))\nprint(f\"成功: 已更新 {path}。修改已持久化。\")\nPY\ntrue; tmux wait -S done\r"]
