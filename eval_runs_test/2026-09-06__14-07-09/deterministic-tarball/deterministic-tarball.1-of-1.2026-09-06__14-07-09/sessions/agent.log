('/tmp' not in n and '.cache' not in n for n in names)\n            assert all('__pycache__' not in n for n in names)\n            assert all(not n.endswith(('.tmp', '.pyc', '.o')) for n in names)\n\n            members = {m.name: m for m in tf.getmembers()}\n            assert 'src/src/windows.py' in members\n            assert 'src/src/readonly.txt' not in members\n            assert 'src/src/main.o' not in members\n            assert 'src/tmp/test.tmp' not in members\n            assert 'src/keys/private.key' not in members\n            assert 'src/secrets/db.conf' not in members\n            assert 'src/src/passwd-link' in members\n\n            for member in tf.getmembers():\n                assert member.uid == 0 and member.gid == 0\n                assert member.uname == '' and member.gname == ''\n                assert member.mtime == epoch\n                if member.isdir():\n                    assert stat.S_IMODE(member.mode) == 0o755\n                elif member.issym():\n                    continue\n                else:\n                    assert stat.S_IMODE(member.mode) in (0o644, 0o755)\n\n            for name in ['src/src/unix.py', 'src/src/windows.py', 'src/src/file with spaces.txt', 'src/docs/README.txt']:\n                data = tf.extractfile(name).read()\n                assert b'\\r' not in data\n\n            # Binary/mixed content should remain unchanged and not be forced to LF-only.\n            mixed = tf.extractfile('src/src/mixed.dat').read()\n            assert mixed == (ROOT / 'src/src/mixed.dat').read_bytes()\n\n            # Verify symlink preserved as symlink.\n            passwd = members['src/src/passwd-link']\n            assert passwd.issym()\n    finally:\n        if tar_path.exists():\n            tar_path.unlink()\n        if tmp.exists():\n            shutil.rmtree(tmp)\n\n\ndef test_long_path_and_special_names_present():\n    run_build(1700000000)\n    with subprocess.Popen(['zstd', '-d', '--stdout', str(OUT)], stdout=subprocess.PIPE) as p:\n        assert p.stdout is not None\n        tar_bytes = p.stdout.read()\n        p.wait()\n    tar_path = ROOT / '.test_archive.tar'\n    tar_path.write_bytes(tar_bytes)\n    try:\n        with tarfile.open(tar_path, 'r:') as tf:\n            names = tf.getnames()\n            assert any('very_long_filename_that_exceeds_two_hundred_characters' in n for n in names)\n            assert any('file with spaces.txt' in n for n in names)\n            assert any('file$special\\\\!chars.py' in n for n in names)\n    finally:\n        if tar_path.exists():\n            tar_path.unlink()\n"
