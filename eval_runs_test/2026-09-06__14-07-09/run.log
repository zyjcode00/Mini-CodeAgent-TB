55)\\n\\n    # First pass: create directory skeleton in sorted order.\\n    for root, dirs, files in os.walk(src_dir, topdown=True, followlinks=False):\\n        root_path = Path(root)\\n        rel_root = root_path.relative_to(src_dir)\\n        dirs[:] = sorted(d for d in dirs if d not in excluded_dirs)\\n        (stage / rel_root).mkdir(parents=True, exist_ok=True)\\n        os.chmod(stage / rel_root, 0o755)\\n        for d in dirs:\\n            (stage / rel_root / d).mkdir(parents=True, exist_ok=True)\\n            os.chmod(stage / rel_root / d, 0o755)\\n\\n    # Second pass: populate files and symlinks.\\n    for root, dirs, files in os.walk(src_dir, topdown=True, followlinks=False):\\n        root_path = Path(root)\\n        rel_root = root_path.relative_to(src_dir)\\n        dirs[:] = sorted(d for d in dirs if d not in excluded_dirs)\\n        for name in sorted(files):\\n            src_path = root_path / name\\n            rel_path = src_path.relative_to(src_dir)\\n            st = os.lstat(src_path)\\n\\n            if should_exclude_file(src_path, rel_path, st):\\n                continue\\n\\n            dst_path = stage / rel_path\\n            dst_path.parent.mkdir(parents=True, exist_ok=True)\\n\\n            if stat.S_ISLNK(st.st_mode):\\n                os.symlink(os.readlink(src_path), dst_path)\\n                continue\\n\\n            if not stat.S_ISREG(st.st_mode):\\n                continue\\n\\n            data = src_path.read_bytes()\\n            mode = 0o755 if (data.startswith(b"#!") or (st.st_mode & stat.S_IXUSR)) else 0o644\\n            if is_text_file(src_path):\\n                data = normalize_text(data)\\n            dst_path.write_bytes(data)\\n            os.chmod(dst_path, mode)\\n\\n    # Normalize timestamps and directory modes.\\n    for path in sorted(stage.rglob("*"), key=lambda p: (len(p.parts), str(p))):\\n        try:\\n            os.utime(path, (epoch, epoch), follow_symlinks=False)\\n        except Exception:\\n            pass\\n        if path.is_dir():\\n            os.chmod(path, 0o755)\\n        elif path.is_file():\\n            current = path.stat().st_mode\\n            os.chmod(path, 0o755 if (current & stat.S_IXUSR) else 0o644)\\n\\n    os.utime(stage, (epoch, epoch))\\n    os.chmod(stage, 0o755)\\n\\n    if out_file.exists():\\n        out_file.unlink()\\n\\n    tar_cmd = [\\n        "tar",\\n        "--format=gnu",\\n        "--sort=name",\\n        "--numeric-owner",\\n        "--owner=0",\\n        "--group=0",\\n        f"--mtime=@{epoch}",\\n        "-C",\\n        str(stage),\\n        "-cf",\\n        "-",\\n        ".",\\n    ]\\n    zstd_cmd = [\\n        "zstd",\\n        "-19",\\n        "--long",\\n        "--no-check",\\n        "--single-thread",\\n        "-c",\\n    ]\\n\\n    env = os.environ.copy()\\n    env["LC_ALL"] = "C"\\n    env["LANG"] = "C"\\n    env["TZ"] = "UTC"\\n\\n    with open(out_file, "wb") as fh:\\n        tar_proc = subprocess.Popen(tar_cmd, stdout=subprocess.PIPE, env=env)\\n        assert tar_proc.stdout is not None\\n        try:\\n            zstd_proc = subprocess.Popen(zstd_cmd, stdin=tar_proc.stdout, stdout=fh, env=env)\\n        finally:\\n            tar_proc.stdout.close()\\n        zstd_rc = zstd_proc.wait()\\n        tar_rc = tar_proc.wait()\\n        if tar_rc != 0:\\n            raise SystemExit(tar_rc)\\n        if zstd_rc != 0:\\n            raise SystemExit(zstd_rc)\\nPY\\n\'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, \'w\', encoding=\'utf-8\', newline=\'\\n\') as f:\n        f.write(content)\n    print(f"成功: 已写入 {path}")\nexcept Exception as exc:\n    print(f"写入失败: {exc}")\nPY\ntrue', '; tmux wait -S done', 'Enter'] min_timeout_sec: 0.0 max_timeout_sec: 300.0
