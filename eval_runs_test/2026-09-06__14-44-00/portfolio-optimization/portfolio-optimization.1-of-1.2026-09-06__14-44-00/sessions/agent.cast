[568.675756, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/portfolio_optimized.py <<'PY'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = '\"\"\"Python wrapper for the portfolio calculation C extension.\"\"\"\\n\\nimport numpy as np\\n\\nfrom portfolio_optimized_c import (\\n    portfolio_return_c as _portfolio_return_c,\\n    portfolio_risk_c as _portfolio_risk_c,\\n)\\n\\n\\ndef portfolio_risk_c(weights, cov_matrix):\\n    \"\"\"Calculate portfolio risk as ``sqrt(weights.T @ cov_matrix @ weights)``.\"\"\"\\n    weights_array = np.ascontiguousarray(weights, dtype=np.float64)\\n    cov_array = np.ascontiguousarray(cov_matrix, dtype=np.float64)\\n    return _portfolio_risk_c(weights_array, cov_array)\\n\\n\\ndef portfolio_return_c(weights, expected_returns):\\n    \"\"\"Calculate the expected portfolio return.\"\"\"\\n    weights_array = np.ascontiguousarray(weights, dtype=np.float64)\\n    returns_array = np.ascontiguousarray(expected_returns, dtype=np.float64)\\n    return _portfolio_return_c(weights_array, returns_array)\\n\\n\\n__all__ ="]
[568.676079, "i", " [\"portfolio_risk_c\", \"portfolio_return_c\"]\\n'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, 'w', encoding='utf-8', newline='\\n') as f:\n        f.write(content)\n    print(f\"成功: 已写入 {path}\")\nexcept Exception as exc:\n    print(f\"写入失败: {exc}\")\nPY\ntrue; tmux wait -S done\r"]
[568.676262, "o", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\r\n\u001b[?2004l\r"]
