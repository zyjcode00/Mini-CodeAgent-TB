[353.940474, "o", "turn_c\", portfolio_return_c, METH_VARARGS, \"Calculate portfolio return\"},\\n    {NULL, NULL, 0, NULL}\\n};\\n\\nstatic struct PyModuleDef moduledef = {\\n    PyModuleDef_HEAD_INIT,\\n    \"portfolio_optimized_c\",\\n    \"Optimized portfolio calculations\",\\n    -1,\\n    module_methods\\n};\\"]
