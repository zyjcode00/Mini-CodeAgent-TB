[?2004limport math
import unittest

import numpy as np

from portfolio_baseline import portfolio_return_python, portfolio_risk_python
from portfolio_optimized import portfolio_return_c, portfolio_risk_c


class PortfolioOptimizedTests(unittest.TestCase):
    def setUp(self):
        rng = np.random.default_rng(20260906)
        self.weights = rng.random(12)
        self.weights /= self.weights.sum()
        matrix = rng.normal(size=(12, 12))
        self.covariance = (matrix @ matrix.T) / 12.0
        self.expected_returns = rng.normal(0.05, 0.02, size=12)

    def test_risk_matches_baseline(self):
        expected = portfolio_risk_python(self.weights, self.covariance)
        actual = portfolio_risk_c(self.weights, self.covariance)
        self.assertTrue(math.isclose(actual, expected, rel_tol=1e-10, abs_tol=1e-10))

    def test_return_matches_baseline(self):
        expected = portfolio_return_python(self.weights, self.expected_returns)
        actual = portfolio_return_c(self.weights, self.expected_returns)
        self.assertTrue(math.isclose(actual, expected, rel_tol=1e-10, abs_tol=1e-10))

    def test_wrapper_accepts_lists_and_non_contiguous_input(self):
        self.assertTrue(math.isclose(
            portfolio_return_c([0.25, 0.75], [0.02, 0.06]), 0.05,
            rel_tol=0.0, abs_tol=1e-15,
        ))
        weights = np.array([0.2, 0.8, 0.1, 0.9])[::2]
        returns = np.array([0.03, 0.01, 0.07, 0.02])[::2]
        self.assertTrue(math.isclose(
            portfolio_return_c(weights, returns), portfolio_return(weights, returns),
            rel_tol=1e-10, abs_tol=1e-10,
        ))

    def test_invalid_dimensions_raise_value_error(self):
        with self.assertRaises(ValueError):
            portfolio_risk_c([0.5, 0.5], np.eye(3))
        with self.assertRaises(ValueError):
            portfolio_return_c([0.5, 0.5], [0.01])

    def test_large_input(self):
        rng = np.random.default_rng(7)
        n = 5000
        weights = rng.random(n)
        weights /= weights.sum()
        diagonal_covariance = np.diag(rng.uniform(0.01, 0.04, size=n))
        result = portfolio_risk_c(weights, diagonal_covariance)
        self.assertTrue(math.isfinite(result))
        self.assertGreater(result, 0.0)


if __name__ == "__main__":
    unittest.main()
