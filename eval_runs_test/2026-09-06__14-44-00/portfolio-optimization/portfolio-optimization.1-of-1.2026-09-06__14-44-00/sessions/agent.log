[?2004l[?2004h> content = '/* High-performance portfolio calculations using the NumPy C API. */\n#define NPY_NO_DEPRECATED_API NPY_1_7_API_VERSION\n#include <Python.h>\n#include <numpy/arrayobject.h>\n#include <math.h>\n\nstatic int validate_risk_inputs(PyArrayObject *weights, PyArrayObject *cov)\n{\n    npy_intp n;\n\n    if (PyArray_TYPE(weights) != NPY_DOUBLE || PyArray_NDIM(weights) != 1 ||\n        !PyArray_IS_C_CONTIGUOUS(weights)) {\n        PyErr_SetString(PyExc_TypeError,\n                        "weights must be a C-contiguous one-dimensional float64 array");\n        return 0;\n    }\n    if (PyArray_TYPE(cov) != NPY_DOUBLE || PyArray_NDIM(cov) != 2 ||\n        !PyArray_IS_C_CONTIGUOUS(cov)) {\n        PyErr_SetString(PyExc_TypeError,\n                        "cov_matrix must be a C-contiguous two-dimensional float64 array");\n        return 0;\n    }\n    n = PyArray_DIM(weights, 0);\n    if (PyArray_DIM(cov, 0) != n || PyArray_DIM(cov, 1) != n) {\n        PyErr_SetString(PyExc_ValueError,\n                        "cov_matrix must have shape (len(weights), len(weights))");\n        return 0;\n    }\n    return 1;\n}\n\nstatic int validate_return_inputs(PyArrayObject *weights, PyArrayObject *returns)\n{\n    if (PyArray_TYPE(weights) != NPY_DOUBLE || PyArray_NDIM(weights) != 1 ||\n        !PyArray_IS_C_CONTIGUOUS(weights) || PyArray_TYPE(returns) != NPY_DOUBLE ||\n        PyArray_NDIM(returns) != 1 || !PyArray_IS_C_CONTIGUOUS(returns)) {\n        PyErr_SetString(PyExc_TypeError,\n                        "weights and expected_returns must be C-contiguous one-dimensional float64 arrays");\n        return 0;\n    }\n    if (PyArray_DIM(weights, 0) != PyArray_DIM(returns, 0)) {\n        PyErr_SetString(PyExc_ValueError,\n                        "weights and expected_returns must have the same length");\n        return 0;\n    }\n    return 1;\n}\n\nstatic PyObject *portfolio_risk_c(PyObject *self, PyObject *args)\n{\n    PyArrayObject *weights_array, *cov_array;\n    npy_intp i, j, n;\n    const double *weights, *cov;\n    double risk_squared = 0.0;\n\n    if (!PyArg_ParseTuple(args, "O!O!", &PyArray_Type, &weights_array,\n                          &PyArray_Type, &cov_array))\n        return NULL;\n    if (!validate_risk_inputs(weights_array, cov_array))\n        return NULL;\n\n    n = PyArray_DIM(weights_array, 0);\n    weights = (const double *)PyArray_DATA(weights_array);\n    cov = (const double *)PyArray_DATA(cov_array);\n    /* Keep the same row-major and left-to-right accumulation as the baseline. */\n    for (i = 0; i < n; ++i) {\n        const double *row = cov + i * n;\n        double row_sum = 0.0;\n        for (j = 0; j < n; ++j)\n            row_sum += row[j] * weights[j];\n        risk_squared += weights[i] * row_sum;\n    }\n    return PyFloat_FromDouble(sqrt(risk_squared));\n}\n\nstatic PyObject *portfolio_return_c(PyObject *self, PyObject *args)\n{\n    PyArrayObject *weights_array, *returns_array;\n    npy_intp i, n;\n    const double *weights, *returns;\n    double total_return = 0.0;\n\n    if (!PyArg_ParseTuple(args, "O!O!", &PyArray_Type, &weights_array,\n                          &PyArray_Type, &returns_array))\n        return NULL;\n    if (!validate_return_inputs(weights_array, returns_array))\n        return NULL;\n\n    n = PyArray_DIM(weights_array, 0);\n    weights = (const double *)PyArray_DATA(weights_array);\n    returns = (const double *)PyArray_DATA(returns_array);\n    for (i = 0; i < n; ++i)\n        total_return += weights[i] * returns[i];\n    return PyFloat_FromDouble(total_return);\n}\n\nstatic PyMethodDef module_methods[] = {\n    {"portfolio_risk_c", portfolio_risk_c, METH_VARARGS, "Calculate portfolio risk"},\n    {"portfolio_return_c", portfolio_return_c, METH_VARARGS, "Calculate portfolio return"},\n    {NULL, NULL, 0, NULL}\n};\n\nstatic struct PyModuleDef moduledef = {\n    PyModuleDef_HEAD_INIT,\n    "portfolio_optimized_c",\n    "Optimized portfolio calculations",\n  