Sending keys: ['export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\npython3 - /app/test_portfolio_optimized.py <<\'PY\'\nimport os\nimport sys\npath = sys.argv[1]\ncontent = \'import math\\nimport unittest\\n\\nimport numpy as np\\n\\nfrom portfolio_baseline import portfolio_return, portfolio_risk\\nfrom portfolio_optimized import portfolio_return_c, portfolio_risk_c\\n\\n\\nclass PortfolioOptimizedTests(unittest.TestCase):\\n    def setUp(self):\\n        rng = np.random.default_rng(20260906)\\n        self.weights = rng.random(12)\\n        self.weights /= self.weights.sum()\\n        matrix = rng.normal(size=(12, 12))\\n        self.covariance = (matrix @ matrix.T) / 12.0\\n        self.expected_returns = rng.normal(0.05, 0.02, size=12)\\n\\n    def test_risk_matches_baseline(self):\\n        expected = portfolio_risk(self.weights, self.covariance)\\n        actual = portfolio_risk_c(self.weights, self.covariance)\\n        self.assertTrue(math.isclose(actual, expected, rel_tol=1e-10, abs_tol=1e-10))\\n\\n    def test_return_matches_baseline(self):\\n        expected = portfolio_return(self.weights, self.expected_returns)\\n        actual = portfolio_return_c(self.weights, self.expected_returns)\\n        self.assertTrue(math.isclose(actual, expected, rel_tol=1e-10, abs_tol=1e-10))\\n\\n    def test_wrapper_accepts_lists_and_non_contiguous_input(self):\\n        self.assertTrue(math.isclose(\\n            portfolio_return_c([0.25, 0.75], [0.02, 0.06]), 0.05,\\n            rel_tol=0.0, abs_tol=1e-15,\\n        ))\\n        weights = np.array([0.2, 0.8, 0.1, 0.9])[::2]\\n        returns = np.array([0.03, 0.01, 0.07, 0.02])[::2]\\n        self.assertTrue(math.isclose(\\n            portfolio_return_c(weights, returns), portfolio_return(weights, returns),\\n            rel_tol=1e-10, abs_tol=1e-10,\\n        ))\\n\\n    def test_invalid_dimensions_raise_value_error(self):\\n        with self.assertRaises(ValueError):\\n            portfolio_risk_c([0.5, 0.5], np.eye(3))\\n        with self.assertRaises(ValueError):\\n            portfolio_return_c([0.5, 0.5], [0.01])\\n\\n    def test_large_input(self):\\n        rng = np.random.default_rng(7)\\n        n = 5000\\n        weights = rng.random(n)\\n        weights /= weights.sum()\\n        diagonal_covariance = np.diag(rng.uniform(0.01, 0.04, size=n))\\n        result = portfolio_risk_c(weights, diagonal_covariance)\\n        self.assertTrue(math.isfinite(result))\\n        self.assertGreater(result, 0.0)\\n\\n\\nif __name__ == "__main__":\\n    unittest.main()\\n\'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, \'w\', encoding=\'utf-8\', newline=\'\\n\') as f:\n        f.write(content)\n    print(f"成功: 已写入 {path}")\nexcept Exception as exc:\n    print(f"写入失败: {exc}")\nPY\ntrue', '; tmux wait -S done', 'Enter'] min_timeout_sec: 0.0 max_timeout_sec: 300.0
