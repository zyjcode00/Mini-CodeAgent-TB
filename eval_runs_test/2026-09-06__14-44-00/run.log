ust have the same length");\\n        return 0;\\n    }\\n    return 1;\\n}\\n\\nstatic PyObject *portfolio_risk_c(PyObject *self, PyObject *args)\\n{\\n    PyArrayObject *weights_array, *cov_array;\\n    npy_intp i, j, n;\\n    const double *weights, *cov;\\n    double risk_squared = 0.0;\\n\\n    if (!PyArg_ParseTuple(args, "O!O!", &PyArray_Type, &weights_array,\\n                          &PyArray_Type, &cov_array))\\n        return NULL;\\n    if (!validate_risk_inputs(weights_array, cov_array))\\n        return NULL;\\n\\n    n = PyArray_DIM(weights_array, 0);\\n    weights = (const double *)PyArray_DATA(weights_array);\\n    cov = (const double *)PyArray_DATA(cov_array);\\n    /* Keep the same row-major and left-to-right accumulation as the baseline. */\\n    for (i = 0; i < n; ++i) {\\n        const double *row = cov + i * n;\\n        double row_sum = 0.0;\\n        for (j = 0; j < n; ++j)\\n            row_sum += row[j] * weights[j];\\n        risk_squared += weights[i] * row_sum;\\n    }\\n    return PyFloat_FromDouble(sqrt(risk_squared));\\n}\\n\\nstatic PyObject *portfolio_return_c(PyObject *self, PyObject *args)\\n{\\n    PyArrayObject *weights_array, *returns_array;\\n    npy_intp i, n;\\n    const double *weights, *returns;\\n    double total_return = 0.0;\\n\\n    if (!PyArg_ParseTuple(args, "O!O!", &PyArray_Type, &weights_array,\\n                          &PyArray_Type, &returns_array))\\n        return NULL;\\n    if (!validate_return_inputs(weights_array, returns_array))\\n        return NULL;\\n\\n    n = PyArray_DIM(weights_array, 0);\\n    weights = (const double *)PyArray_DATA(weights_array);\\n    returns = (const double *)PyArray_DATA(returns_array);\\n    for (i = 0; i < n; ++i)\\n        total_return += weights[i] * returns[i];\\n    return PyFloat_FromDouble(total_return);\\n}\\n\\nstatic PyMethodDef module_methods[] = {\\n    {"portfolio_risk_c", portfolio_risk_c, METH_VARARGS, "Calculate portfolio risk"},\\n    {"portfolio_return_c", portfolio_return_c, METH_VARARGS, "Calculate portfolio return"},\\n    {NULL, NULL, 0, NULL}\\n};\\n\\nstatic struct PyModuleDef moduledef = {\\n    PyModuleDef_HEAD_INIT,\\n    "portfolio_optimized_c",\\n    "Optimized portfolio calculations",\\n    -1,\\n    module_methods\\n};\\n\\nPyMODINIT_FUNC PyInit_portfolio_optimized_c(void)\\n{\\n    import_array();\\n    return PyModule_Create(&moduledef);\\n}\\n\'\ndir_path = os.path.dirname(path)\nif dir_path:\n    os.makedirs(dir_path, exist_ok=True)\ntry:\n    with open(path, \'w\', encoding=\'utf-8\', newline=\'\\n\') as f:\n        f.write(content)\n    print(f"成功: 已写入 {path}")\nexcept Exception as exc:\n    print(f"写入失败: {exc}")\nPY\ntrue', '; tmux wait -S done', 'Enter'] min_timeout_sec: 0.0 max_timeout_sec: 300.0
