[573.826067, "i", "export GIT_PAGER=cat PAGER=cat GIT_TERMINAL_PROMPT=0\nset -e\nif [ -f /app/kvstore-server.pid ] && kill -0 \"$(cat /app/kvstore-server.pid)\" 2>/dev/null; then\n  pid=$(cat /app/kvstore-server.pid)\nelse\n  nohup python3 /app/server.py >/app/kvstore-server.log 2>&1 </dev/null &\n  pid=$!\n  printf '%s\\n' \"$pid\" >/app/kvstore-server.pid\nfi\nfor i in $(seq 1 40); do\n  if python3 -c 'import socket; s=socket.create_connection((\"127.0.0.1\", 5328), 0.2); s.close()' 2>/dev/null; then break; fi\n  sleep 0.25\ndone\nkill -0 \"$pid\"\nss -ltnp | grep ':5328'\ncat /app/kvstore-server.log\npython3 - <<'PY'\nimport grpc\nimport kv_store_pb2\nimport kv_store_pb2_grpc\nchannel = grpc.insecure_channel('127.0.0.1:5328')\ngrpc.channel_ready_future(channel).result(timeout=3)\nstub = kv_store_pb2_grpc.KVStoreStub(channel)\nassert stub.SetVal(kv_store_pb2.SetValRequest(key='smoke', value=123)).val == 123\nassert stub.GetVal(kv_store_pb2.GetValRequest(key='smoke')).val == 123\nchannel.close()\nprint('background RPC smoke test passed')\nPY\ntrue; tmux wait -S d"]
