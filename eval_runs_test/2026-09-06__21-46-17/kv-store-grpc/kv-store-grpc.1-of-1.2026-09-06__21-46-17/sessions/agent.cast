[282.287281, "o", "python3 - /app/kv-store.proto <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[282.287371, "o", "import os\r\n\u001b[?2004l\r"]
[282.287386, "o", "\u001b[?2004h"]
[282.287442, "o", "> import sys\r\n"]
